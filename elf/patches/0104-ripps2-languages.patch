diff --git a/src/ripps2tr.c b/src/ripps2tr.c
new file mode 100644
index 0000000..180fddd
--- /dev/null
+++ b/src/ripps2tr.c
@@ -0,0 +1,471 @@
+/*
+ RIPPS2 build 104: RIPPS2's own words, and Open PS2 Loader's, in the language the user picked.
+ Licenced under Academic Free License version 3.0
+ Review OpenUsbLd README & LICENSE files for further details.
+ */
+
+#include "include/opl.h"
+#include "include/ioman.h" // LOG
+#include "include/ripps2tr.h"
+#include "include/utf8.h"
+
+typedef struct
+{
+    u32 hash;
+    const char *text;
+    u8 state; // 0: not looked at yet, 1: good, 2: refused (its printf conversions differ from the English's)
+} trEntry_t;
+
+struct ripps2TrCat
+{
+    struct ripps2TrCat *next;
+    char path[256];
+    int size; // the file's, to know it again
+    char *buf;
+    trEntry_t *ent;
+    int count;
+};
+
+// Every catalogue loaded this session. None is freed: _t's answers get kept in pointers (a toast's text, an
+// operation's name), and a language switch must not pull the words out from under them.
+static ripps2TrCat_t *trCats = NULL;
+static ripps2TrCat_t *volatile trCur = NULL;
+
+u32 ripps2TrHash(const char *s)
+{
+    u32 h = 2166136261u;
+    while (*s) {
+        h ^= (u8)*s++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+// The printf conversions in s, in order, written as their stars, length and kind ("s,ld,*d,"). -1 for one this
+// check cannot vouch for (a positional %1$s).
+static int trConv(const char *s, char *out, int size)
+{
+    int n = 0;
+    out[0] = '\0';
+    for (; *s; s++) {
+        if (*s != '%')
+            continue;
+        s++;
+        if (*s == '%')
+            continue;
+        if (*s == '\0') // a lone % at the end ("0%" in a progress line): text, not a conversion
+            break;
+        while (*s && strchr("-+ #0", *s)) // flags
+            s++;
+        while (*s && ((*s >= '0' && *s <= '9') || *s == '*' || *s == '.' || *s == '$')) { // width, precision
+            if (*s == '$')
+                return -1;
+            if (*s == '*' && n < size - 2)
+                out[n++] = '*';
+            s++;
+        }
+        while (*s && strchr("hljztLq", *s)) { // length
+            if (n < size - 2)
+                out[n++] = *s;
+            s++;
+        }
+        if (*s == '\0')
+            return -1;
+        if (n < size - 2) {
+            out[n++] = *s;
+            out[n++] = ',';
+        }
+        out[n] = '\0';
+    }
+    return n;
+}
+
+static int trSameConversions(const char *en, const char *tr)
+{
+    char a[64], b[64];
+    if (trConv(en, a, sizeof(a)) < 0 || trConv(tr, b, sizeof(b)) < 0)
+        return strchr(en, '%') == NULL && strchr(tr, '%') == NULL;
+    return strcmp(a, b) == 0;
+}
+
+static trEntry_t *trFind(ripps2TrCat_t *c, u32 h)
+{
+    int lo = 0, hi = c->count - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (c->ent[mid].hash == h)
+            return &c->ent[mid];
+        if (c->ent[mid].hash < h)
+            lo = mid + 1;
+        else
+            hi = mid - 1;
+    }
+    return NULL;
+}
+
+static const char *trLookup(ripps2TrCat_t *c, const char *en)
+{
+    trEntry_t *e;
+    if (c == NULL || en == NULL || en[0] == '\0')
+        return NULL;
+    e = trFind(c, ripps2TrHash(en));
+    if (e == NULL)
+        return NULL;
+    if (e->state == 0)
+        e->state = trSameConversions(en, e->text) ? 1 : 2;
+    return e->state == 1 ? e->text : NULL;
+}
+
+const char *_t(const char *en)
+{
+    const char *tr = trLookup(trCur, en);
+    return tr != NULL ? tr : en;
+}
+
+const char *ripps2TrLabel(ripps2TrCat_t *cat, const char *en)
+{
+    return trLookup(cat, en);
+}
+
+void ripps2TrUse(ripps2TrCat_t *cat)
+{
+    trCur = cat;
+}
+
+int ripps2TrIsKeyed(const char *buf, int size)
+{
+    // the mark is in the head, among the comment lines
+    static const char mark[] = "#!RIPPS2LANG 1";
+    int i = 0, lines = 0;
+    while (i < size && lines < 64) {
+        int k = 0;
+        while (mark[k] && i + k < size && buf[i + k] == mark[k])
+            k++;
+        if (mark[k] == '\0')
+            return 1;
+        if (buf[i] != '#')
+            return 0; // past the head
+        while (i < size && buf[i] != '\n')
+            i++;
+        i++;
+        lines++;
+    }
+    return 0;
+}
+
+static int trHex(const char *s, u32 *out)
+{
+    u32 v = 0;
+    int i;
+    for (i = 0; i < 8; i++) {
+        char c = s[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9')
+            v |= c - '0';
+        else if (c >= 'a' && c <= 'f')
+            v |= c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F')
+            v |= c - 'A' + 10;
+        else
+            return 0;
+    }
+    *out = v;
+    return 1;
+}
+
+static int trEntryCmp(const void *a, const void *b)
+{
+    u32 x = ((const trEntry_t *)a)->hash, y = ((const trEntry_t *)b)->hash;
+    return x < y ? -1 : x > y ? 1 : 0;
+}
+
+ripps2TrCat_t *ripps2TrParse(char *buf, int size, const char *path)
+{
+    ripps2TrCat_t *c;
+    char *p, *end, *grown;
+    int n = 0, cap = 0;
+
+    for (c = trCats; c != NULL; c = c->next) { // the same file again (a switch back): its catalogue as it was
+        if (c->size == size && strcmp(c->path, path) == 0) {
+            free(buf);
+            return c;
+        }
+    }
+
+    grown = realloc(buf, size + 1);
+    if (grown == NULL) {
+        free(buf);
+        return NULL;
+    }
+    buf = grown;
+    buf[size] = '\0';
+    for (p = buf; *p; p++) // the entries there can be, at most
+        if (*p == '\n')
+            cap++;
+    cap++;
+
+    c = calloc(1, sizeof(*c));
+    if (c != NULL)
+        c->ent = malloc(cap * sizeof(trEntry_t));
+    if (c == NULL || c->ent == NULL) {
+        free(c);
+        free(buf);
+        return NULL;
+    }
+
+    for (p = buf; *p; p = end) {
+        char *src, *dst;
+        u32 h;
+        end = strchr(p, '\n');
+        if (end == NULL)
+            end = p + strlen(p);
+        else
+            *end++ = '\0';
+        if (p[0] == '#' || !trHex(p, &h) || p[8] != '\t')
+            continue;
+        // the line's escapes: \n a new line, \t a tab, \\ a backslash; a CR at its end goes
+        for (src = dst = p + 9; *src; src++) {
+            if (*src == '\\' && src[1] != '\0') {
+                src++;
+                *dst++ = *src == 'n' ? '\n' : *src == 't' ? '\t' : *src;
+            } else if (*src != '\r')
+                *dst++ = *src;
+        }
+        *dst = '\0';
+        if (p[9] == '\0')
+            continue;
+        c->ent[n].hash = h;
+        c->ent[n].text = p + 9;
+        c->ent[n].state = 0;
+        n++;
+    }
+    qsort(c->ent, n, sizeof(trEntry_t), trEntryCmp);
+    c->count = n;
+    c->buf = buf;
+    c->size = size;
+    snprintf(c->path, sizeof(c->path), "%s", path);
+    c->next = trCats;
+    trCats = c;
+    LOG("RIPPS2TR %s: %d strings\n", path, n);
+    return c;
+}
+
+// ---- Letter case ----
+
+u32 ripps2Upper(u32 c)
+{
+    if (c < 0x80)
+        return (c >= 'a' && c <= 'z') ? c - 32 : c;
+    if (c >= 0xE0 && c <= 0xFE && c != 0xF7)
+        return c - 32;
+    if (c == 0xFF)
+        return 0x178;
+    if (c == 0x131) // dotless i
+        return 'I';
+    if (c == 0x17F) // long s
+        return 'S';
+    if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177))
+        return (c & 1) ? c - 1 : c;
+    if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E))
+        return (c & 1) ? c : c - 1;
+    if (c == 0x1A1 || c == 0x1B0 || c == 0x219 || c == 0x21B) // Vietnamese o and u horn, Romanian s and t comma
+        return c - 1;
+    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF))
+        return (c & 1) ? c - 1 : c;
+    if (c >= 0x3B1 && c <= 0x3CB)
+        return c == 0x3C2 ? 0x3A3 : c - 32;
+    if (c == 0x3AC)
+        return 0x386;
+    if (c >= 0x3AD && c <= 0x3AF)
+        return c - 37;
+    if (c == 0x3CC)
+        return 0x38C;
+    if (c == 0x3CD || c == 0x3CE)
+        return c - 63;
+    if (c >= 0x430 && c <= 0x44F)
+        return c - 32;
+    if (c >= 0x450 && c <= 0x45F)
+        return c - 80;
+    if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || (c >= 0x4D0 && c <= 0x52F))
+        return (c & 1) ? c - 1 : c;
+    if (c >= 0x4C1 && c <= 0x4CE)
+        return (c & 1) ? c : c - 1;
+    if (c == 0x4CF)
+        return 0x4C0;
+    return c;
+}
+
+u32 ripps2Lower(u32 c)
+{
+    if (c < 0x80)
+        return (c >= 'A' && c <= 'Z') ? c + 32 : c;
+    if (c >= 0xC0 && c <= 0xDE && c != 0xD7)
+        return c + 32;
+    if (c == 0x178)
+        return 0xFF;
+    if (c == 0x130) // dotted capital I
+        return 'i';
+    if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177))
+        return (c & 1) ? c : c + 1;
+    if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E))
+        return (c & 1) ? c + 1 : c;
+    if (c == 0x1A0 || c == 0x1AF || c == 0x218 || c == 0x21A)
+        return c + 1;
+    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF))
+        return (c & 1) ? c : c + 1;
+    if ((c >= 0x391 && c <= 0x3A1) || (c >= 0x3A3 && c <= 0x3AB))
+        return c + 32;
+    if (c == 0x386)
+        return 0x3AC;
+    if (c >= 0x388 && c <= 0x38A)
+        return c + 37;
+    if (c == 0x38C)
+        return 0x3CC;
+    if (c == 0x38E || c == 0x38F)
+        return c + 63;
+    if (c >= 0x410 && c <= 0x42F)
+        return c + 32;
+    if (c >= 0x400 && c <= 0x40F)
+        return c + 80;
+    if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || (c >= 0x4D0 && c <= 0x52F))
+        return (c & 1) ? c : c + 1;
+    if (c >= 0x4C1 && c <= 0x4CE)
+        return (c & 1) ? c + 1 : c;
+    if (c == 0x4C0)
+        return 0x4CF;
+    return c;
+}
+
+int ripps2Utf8Next(const char *s, u32 *cp)
+{
+    uint32_t state = UTF8_ACCEPT, c = 0;
+    int n = 0;
+    *cp = 0;
+    while (s[n] != '\0') {
+        utf8Decode(&state, &c, s[n++]);
+        if (state == UTF8_ACCEPT) {
+            *cp = c;
+            return n;
+        }
+        if (state == UTF8_REJECT) { // a broken sequence: its first byte alone
+            *cp = (u8)s[0];
+            return 1;
+        }
+    }
+    if (n > 0) // cut short at the end
+        *cp = (u8)s[0];
+    return n > 0 ? 1 : 0;
+}
+
+int ripps2Utf8Put(char *out, int at, int size, u32 c)
+{
+    char b[4];
+    int n, i;
+    if (c < 0x80) {
+        b[0] = c;
+        n = 1;
+    } else if (c < 0x800) {
+        b[0] = 0xC0 | (c >> 6);
+        b[1] = 0x80 | (c & 0x3F);
+        n = 2;
+    } else if (c < 0x10000) {
+        b[0] = 0xE0 | (c >> 12);
+        b[1] = 0x80 | ((c >> 6) & 0x3F);
+        b[2] = 0x80 | (c & 0x3F);
+        n = 3;
+    } else {
+        b[0] = 0xF0 | (c >> 18);
+        b[1] = 0x80 | ((c >> 12) & 0x3F);
+        b[2] = 0x80 | ((c >> 6) & 0x3F);
+        b[3] = 0x80 | (c & 0x3F);
+        n = 4;
+    }
+    if (at + n > size - 1)
+        return -1;
+    for (i = 0; i < n; i++)
+        out[at + i] = b[i];
+    return at + n;
+}
+
+char *ripps2Utf8Upper(const char *in, char *out, int size)
+{
+    uint32_t state = UTF8_ACCEPT, cp = 0;
+    int n = 0;
+    if (size <= 0)
+        return out;
+    for (; *in; in++) {
+        if (utf8Decode(&state, &cp, *in) != UTF8_ACCEPT) {
+            if (state == UTF8_REJECT)
+                state = UTF8_ACCEPT; // a broken sequence: skip it
+            continue;
+        }
+        int at = ripps2Utf8Put(out, n, size, ripps2Upper(cp));
+        if (at < 0)
+            break;
+        n = at;
+    }
+    out[n] = '\0';
+    return out;
+}
+
+char *ripps2Utf8Copy(char *out, int size, const char *in)
+{
+    int n = 0, k;
+    if (size <= 0)
+        return out;
+    while (in[n] && n < size - 1)
+        n++;
+    if (in[n] != '\0') { // cut: back off to the start of the sequence it may have cut into
+        k = n;
+        while (k > 0 && ((u8)in[k] & 0xC0) == 0x80)
+            k--;
+        n = k;
+    }
+    memcpy(out, in, n);
+    out[n] = '\0';
+    return out;
+}
+
+static u32 trDecodeAt(const char *s)
+{
+    uint32_t state = UTF8_ACCEPT, cp = 0;
+    for (; *s; s++) {
+        if (utf8Decode(&state, &cp, *s) == UTF8_ACCEPT)
+            return cp;
+        if (state == UTF8_REJECT)
+            return 0;
+    }
+    return 0;
+}
+
+static int trWide(u32 c)
+{
+    return (c >= 0x2E80 && c <= 0x9FFF) || (c >= 0xAC00 && c <= 0xD7AF) || (c >= 0xF900 && c <= 0xFAFF) ||
+           (c >= 0xFF00 && c <= 0xFFEF) || (c >= 0x20000 && c <= 0x2FFFF);
+}
+
+int ripps2Utf8BreakAt(const char *start, const char *s)
+{
+    // never before closing punctuation or the long-vowel mark, never after an opening bracket
+    static const u16 noBefore[] = {0x3001, 0x3002, 0xFF0C, 0xFF0E, 0xFF01, 0xFF1F, 0xFF09, 0x300D, 0x300F, 0x3011, 0x30FC, 0xFF1A, 0xFF1B, 0x30FB, 0};
+    static const u16 noAfter[] = {0x300C, 0x300E, 0x3010, 0xFF08, 0};
+    const char *p;
+    u32 here, before;
+    int i;
+    if (s <= start || *s == '\0' || ((u8)*s & 0xC0) == 0x80) // never inside a character
+        return 0;
+    p = s - 1;
+    while (p > start && ((u8)*p & 0xC0) == 0x80)
+        p--;
+    here = trDecodeAt(s);
+    before = trDecodeAt(p);
+    if (!trWide(here) && !trWide(before))
+        return 0;
+    for (i = 0; noBefore[i]; i++)
+        if (here == noBefore[i])
+            return 0;
+    for (i = 0; noAfter[i]; i++)
+        if (before == noAfter[i])
+            return 0;
+    return 1;
+}
