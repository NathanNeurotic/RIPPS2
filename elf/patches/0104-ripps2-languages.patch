+// RIPPS2 build 104: a keyed file (ripps2tr.h): every Open PS2 Loader string by its English, and RIPPS2's for _t.
+// 0 when the file is not one (the line-numbered reader takes it), -1 when it is and could not be loaded.
+static int lngLoadKeyed(char *path, ripps2TrCat_t **out)
+{
+    int size = -1;
+    char *buf = readFile(path, -1, &size);
+    *out = NULL;
+    if (buf == NULL)
+        return 0;
+    if (!ripps2TrIsKeyed(buf, size)) {
+        free(buf);
+        return 0;
+    }
+    *out = ripps2TrParse(buf, size, path);
+    return *out != NULL ? 1 : -1;
+}
