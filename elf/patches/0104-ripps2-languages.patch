diff --git a/include/ripps2tr.h b/include/ripps2tr.h
new file mode 100644
index 0000000..dbd66bb
--- /dev/null
+++ b/include/ripps2tr.h
@@ -0,0 +1,48 @@
+#ifndef __RIPPS2_TR_H
+#define __RIPPS2_TR_H
+
+// u32 spelt out: the header also builds in the PC tests, without the PS2 SDK
+/* RIPPS2 build 104: RIPPS2's own words in the language the user picked (Settings > Display > Language).
+
+   _t("English") is that English's translation from the chosen language file, or the English itself (English, a
+   file with no line for it, or a line whose printf conversions differ from the English's, which would misread
+   its arguments). N_("...") marks English kept in a table; it is translated where it is shown, _t(table[i]).
+
+   A RIPPS2 language file (lang_<Name>.lng, "#!RIPPS2LANG 1" in its head) is keyed by the English, not by line
+   number: each line is the FNV-1a hash of an English string, a tab, and its translation. The same file carries
+   Open PS2 Loader's strings, looked up by their English the same way, so a pack made for one build keeps every
+   string that did not change in the next, where a line-numbered file shifts by one label and misreads them all.
+   Older line-numbered files (Open PS2 Loader's own) still load as they always did. */
+// format_arg: a printf format inside _t("...") is still checked against its arguments
+const char *_t(const char *en) __attribute__((format_arg(1)));
+#define N_(s) (s)
+
+unsigned int ripps2TrHash(const char *s);
+
+typedef struct ripps2TrCat ripps2TrCat_t;
+
+// A keyed file's text (size bytes, not terminated)? Then parse it: the catalogue takes buf (and keeps it, as it
+// keeps every catalogue loaded this session, so a pointer _t gave out stays good after a language switch).
+int ripps2TrIsKeyed(const char *buf, int size);
+ripps2TrCat_t *ripps2TrParse(char *buf, int size, const char *path);
+// The translation of an Open PS2 Loader string by its English, or NULL
+const char *ripps2TrLabel(ripps2TrCat_t *cat, const char *en);
+// The catalogue _t reads from (NULL: English)
+void ripps2TrUse(ripps2TrCat_t *cat);
+
+// Letter case beyond ASCII (Latin-1, Latin Extended-A and the Vietnamese and Romanian letters, Greek, Cyrillic):
+// caps fonts, the hints' sentence case and the source toast
+unsigned int ripps2Upper(unsigned int c);
+unsigned int ripps2Lower(unsigned int c);
+// The character at s: its code point in *cp and the bytes it takes (a broken one: its first byte, 1; the end: 0)
+int ripps2Utf8Next(const char *s, unsigned int *cp);
+// c written at out[at] as UTF-8: the new end, or -1 when it does not fit in size bytes with the terminator
+int ripps2Utf8Put(char *out, int at, int size, unsigned int c);
+// UTF-8 in, UTF-8 out (size bytes with the terminator); returns out
+char *ripps2Utf8Upper(const char *in, char *out, int size);
+// Copy at most size - 1 bytes of in, never ending inside a UTF-8 sequence
+char *ripps2Utf8Copy(char *out, int size, const char *in);
+// Could a line break go before the character at s (a CJK ideograph, kana or hangul, or after one)?
+int ripps2Utf8BreakAt(const char *start, const char *s);
+
+#endif
