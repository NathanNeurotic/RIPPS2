+// RIPPS2 build 104: the settings home (mc?:/RIPPS2 first since build 100, else where RIPPS2 started) and its LNG
+// folder hold languages too. lngInit's scan saw only the legacy mc?:OPL, before the config chose the home; this runs
+// once it has (opl.c, beside lngInitFallbackFont).
+void lngAddHomeLanguages(void)
+{
+    const char *home = configGetHomePath();
+    char path[256], base[64];
+    if (home == NULL || home[0] == '\0')
+        return;
+    const size_t len = strlen(home);
+    const char *sep = (home[len - 1] == '/' || home[len - 1] == ':') ? "" : "/";
+    // the legacy folder again would list its languages twice
+    snprintf(base, sizeof(base), "%s", gBaseMCDir);
+    if (base[0] == 'm' && base[1] == 'c' && base[2] == '?')
+        base[2] = home[2];
+    snprintf(path, sizeof(path), "%s", home);
+    if (path[0] && path[strlen(path) - 1] == '/')
+        path[strlen(path) - 1] = '\0';
+    if (strcasecmp(path, base) != 0)
+        lngAddLanguages((char *)home, "/", -1);
+    snprintf(path, sizeof(path), "%s%sLNG", home, sep);
+    lngAddLanguages(path, "/", -1);
+}
