diff --git a/src/ripps2side.c b/src/ripps2side.c
new file mode 100644
index 0000000..1415c7b
--- /dev/null
+++ b/src/ripps2side.c
@@ -0,0 +1,308 @@
+/*
+  RIPPS2 build 113: the category sidebar.
+
+  The user (10/22): the three categories as glyphs down the theme's own side bar instead of words across the top;
+  Left from the games list highlights them (RIPGRID's frame), Up / Down opens each one's drawer, the bar sliding
+  open, with the category's name as its first item and its list under it (Storage: the sources); Cross enters the
+  list and Cross on an item goes there. The game is let go while the sidebar has the focus and the hints are the
+  sidebar's. No page titles: the name lives in the drawer. Launch Disc and Memory Files get the bar as a full strip.
+
+  A theme asks for it with category_layout=sidebar (column means the same now); Colors and More > Category Layout
+  overrides. The bar is Adapt's by default (x 0, 26 wide, #01040F at 88, a #28C5F9 accent at 22 beside it), so on
+  Adapt the glyphs land in the bar Adapt already draws; sidebar_bar=pages leaves Storage's bar to the theme.
+
+  The glyphs are one atlas, ps2-pillars elf/theme/make_sidebar_icons.py (row 0 the lines, row 1 their glow).
+  Coordinates are theme space (640 wide, gTheme->usedHeight tall).
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/menusys.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/iosupport.h"
+#include "include/ripps2.h"
+#include "include/ripps2tr.h"
+
+int gRipps2CatLayout = 0;
+
+#define SB_CELL      32.0f
+#define SB_ICON_DISC 0 // atlas cells, make_sidebar_icons.py's order
+#define SB_ICON_ALL  3
+#define SB_ICON_USB  4
+#define SB_ICON_MMCE 5
+#define SB_ICON_HDD  6
+#define SB_ICON_NET  7
+#define SB_ICON_APPS 8
+#define SB_ICON_STAR 9
+#define SB_ROW       26 // a drawer row
+#define SB_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00) // untextured: 0x80 = opaque
+#define SB_TEX(v, a)        GS_SETREG_RGBA((v), (v), (v), (a))        // textured: 0x80 = the texel as it is
+
+static int sbFocus = 0, sbGlyph = 0, sbItem = 0, sbDirect = 0; // sbDirect: opened straight into a list (Circle)
+static const char *sbNames[RIPPS2_CAT_COUNT] = {N_("LAUNCH DISC"), N_("STORAGE"), N_("MEMORY FILES")};
+
+int ripps2SidebarOn(void)
+{
+    if (ripps2Legacy())
+        return 0; // a legacy theme has no categories to show
+    if (gRipps2CatLayout == 1)
+        return 0;
+    if (gRipps2CatLayout == 2)
+        return 1;
+    return gTheme != NULL && gTheme->catSidebar;
+}
+
+int ripps2SidebarFocused(void)
+{
+    return ripps2SidebarOn() ? sbFocus : 0;
+}
+
+static int sbFont(int title)
+{
+    static int f[2] = {FNT_ERROR, FNT_ERROR};
+    if (f[title] == FNT_ERROR)
+        f[title] = fntLoadFile("builtin:ripflowbold", title ? 22 : 17); // Roboto Condensed Bold: the user's pick
+    return f[title] != FNT_ERROR ? f[title] : gTheme->fonts[0];
+}
+
+static int sbGlyphSize(void)
+{
+    int s = gTheme->sbW - 8;
+    return s < 14 ? 14 : s > 28 ? 28 : s;
+}
+
+static int sbGlyphY(int slot)
+{
+    return gTheme->usedHeight / 2 + (slot - 1) * (sbGlyphSize() + 22);
+}
+
+static void sbIcon(int cell, int cx, int cy, int size, int lit, int alpha)
+{
+    GSTEXTURE *tex = thmGetTexture(RIPPS2_SIDEBAR_ICONS);
+    float u0 = cell * SB_CELL + 0.5f, u1 = (cell + 1) * SB_CELL - 0.5f;
+    if (tex == NULL || tex->Mem == NULL || alpha <= 0)
+        return;
+    if (lit) { // the glow first, additively, so it adds light under the lines
+        rmSetBlendAdditive(1);
+        rmDrawPixmapPart(tex, cx, cy, ALIGN_CENTER, size * 13 / 10, size * 13 / 10, SCALING_RATIO, GS_SETREG_RGBA(0x24, 0x58, 0x80, alpha / 2),
+                         u0, SB_CELL + 0.5f, u1, 2 * SB_CELL - 0.5f);
+        rmSetBlendAdditive(0);
+    }
+    rmDrawPixmapPart(tex, cx, cy, ALIGN_CENTER, size, size, SCALING_RATIO,
+                     lit ? SB_TEX(0x80, alpha) : GS_SETREG_RGBA(0x55, 0x5E, 0x76, alpha * 7 / 8), u0, 0.5f, u1, SB_CELL - 0.5f);
+}
+
+// a source page's glyph: by its theme icon (the page knows its drive), else by its mode
+static int sbSourceIcon(int i)
+{
+    int icon = menuSourceIcon(i), mode = menuSourceMode(i);
+    if (mode == MIX_MODE)
+        return SB_ICON_ALL;
+    if (icon == HDD_ICON || icon == HDD_BD_ICON)
+        return SB_ICON_HDD;
+    if (icon == MMCE_ICON || icon == MX4SIO_ICON)
+        return SB_ICON_MMCE;
+    if (icon == ETH_ICON || icon == UDP_ICON || mode == ETH_MODE || mode == UDPFS_MODE || mode == HTTP_MODE)
+        return SB_ICON_NET;
+    if (icon == APP_ICON || mode == APP_MODE)
+        return SB_ICON_APPS;
+    if (icon == FAV_ICON || mode == FAV_MODE)
+        return SB_ICON_STAR;
+    return SB_ICON_USB;
+}
+
+// a drawer's rows: its name first, then (Storage) the sources
+static int sbRows(int cat)
+{
+    return 1 + (cat == RIPPS2_CAT_STORAGE ? menuSourceCount() : 0);
+}
+
+static void sbBarAt(int x, int w, int accentX)
+{
+    int h = gTheme->usedHeight;
+    ripps2DrawPanelFlat(x, 0, w, h, gTheme->sbColor, gTheme->sbTint, 0);
+    if (gTheme->sbAccentTint > 0)
+        ripps2DrawPanelFlat(accentX, 0, 12, h, gTheme->sbAccent, gTheme->sbAccentTint, 0);
+}
+
+// a source's name in the drawer: the page's own, with the drive's format when two pages share it (the exFAT HDD
+// and the APA HDD are both HDD Games), else its place among them
+static void sbSourceName(int s, char *out, int size)
+{
+    const char *name = menuSourceName(s);
+    int i, same = 0, nth = 0, icon = menuSourceIcon(s);
+    for (i = 0; i < menuSourceCount(); i++)
+        if (!strcmp(menuSourceName(i), name)) {
+            same++;
+            if (i < s)
+                nth++;
+        }
+    if (same < 2)
+        snprintf(out, size, "%s", name);
+    else if (icon == HDD_BD_ICON || icon == HDD_ICON)
+        snprintf(out, size, "%s (%s)", name, icon == HDD_BD_ICON ? "exFAT" : "APA");
+    else
+        snprintf(out, size, "%s %d", name, nth + 1);
+}
+
+static void sbDrawer(int slot)
+{
+    int cat = ripps2CatSlot(slot), x0 = gTheme->sbX + gTheme->sbW, right = gTheme->sbDrawer, n = sbRows(cat), i;
+    int h = n * SB_ROW + (n > 1 ? 10 : 0), top = sbGlyphY(slot) - SB_ROW / 2, cur = menuSourceCurrent();
+    int floor = gTheme->usedHeight - 56; // clear of the hints
+    char name[96];
+    if (right < x0 + 80)
+        right = x0 + 80;
+    // wide enough for its longest name (HDD Games (exFAT) ran past 216 in the lab), up to half the screen
+    for (i = 0; i < n; i++) {
+        int w;
+        if (i == 0)
+            w = 26 + rmUnScaleX(fntCalcDimensions(sbFont(1), _t(sbNames[cat])));
+        else {
+            sbSourceName(i - 1, name, sizeof(name));
+            w = 52 + rmUnScaleX(fntCalcDimensions(sbFont(0), name));
+        }
+        if (x0 + w > right)
+            right = x0 + w > 320 ? 320 : x0 + w;
+    }
+    // the name beside its glyph, the list running down from it, kept on the page
+    if (top + h > floor)
+        top = floor - h;
+    if (top < 16)
+        top = 16;
+    // the bar opened out to the drawer's edge, as the bar is: on Storage the page's frosted backdrop under a
+    // deeper tint (Adapt's bar is frosted glass), the accent along the new edge
+    if (gRipps2Category == RIPPS2_CAT_STORAGE)
+        thmDrawMainFrost(x0, 0, right - x0, gTheme->usedHeight);
+    ripps2DrawPanelFlat(x0, 0, right - x0, gTheme->usedHeight, gTheme->sbColor, gTheme->sbTint + (0x80 - gTheme->sbTint) / 2, 0);
+    if (gTheme->sbAccentTint > 0)
+        ripps2DrawPanelFlat(right + 2, 0, 12, gTheme->usedHeight, gTheme->sbAccent, gTheme->sbAccentTint, 0);
+    for (i = 0; i < n; i++) {
+        int y = top + i * SB_ROW + (i > 0 ? 10 : 0), lit = sbFocus == 2 && i == sbItem;
+        if (lit) {
+            rmDrawRect(x0 + 6, y + 1, right - x0 - 12, SB_ROW - 2, SB_PRIM(0x1E, 0x3C, 0x96, 0x6C));
+            rmDrawRect(x0 + 6, y + 1, 3, SB_ROW - 2, SB_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        }
+        if (i == 0) { // the category's name, the drawer's first item
+            fntRenderStringFit(sbFont(1), x0 + 16, y + SB_ROW / 2, ALIGN_VCENTER, right - x0 - 26, _t(sbNames[cat]),
+                               SB_TEX(lit || sbFocus == 1 ? 0x80 : 0x70, 0x80), 0);
+            continue;
+        }
+        int s = i - 1, here = s == cur && gRipps2Category == RIPPS2_CAT_STORAGE;
+        sbIcon(sbSourceIcon(s), x0 + 26, y + SB_ROW / 2, 16, lit, 0x80);
+        sbSourceName(s, name, sizeof(name));
+        fntRenderStringFit(sbFont(0), x0 + 42, y + SB_ROW / 2, ALIGN_VCENTER, right - x0 - 52, name,
+                           lit ? SB_TEX(0x80, 0x80) : here ? GS_SETREG_RGBA(0x6C, 0x7C, 0x80, 0x80) : GS_SETREG_RGBA(0x55, 0x5E, 0x76, 0x80), 0);
+    }
+}
+
+void ripps2SidebarRender(void)
+{
+    int size = sbGlyphSize(), cx = gTheme->sbX + gTheme->sbW / 2, slot;
+    int alpha = (int)(0x80 * ripps2CatBarAlpha());
+    if (sbFocus)
+        alpha = 0x80; // a sidebar in use never fades
+    if (gTheme->sbBar == 2 || (gTheme->sbBar == 1 && gRipps2Category != RIPPS2_CAT_STORAGE))
+        sbBarAt(gTheme->sbX, gTheme->sbW, gTheme->sbX + gTheme->sbW + 2);
+    if (sbFocus)
+        sbDrawer(sbGlyph);
+    for (slot = 0; slot < RIPPS2_CAT_COUNT; slot++) {
+        int cat = ripps2CatSlot(slot), cy = sbGlyphY(slot), lit = cat == gRipps2Category;
+        if (lit) // the page you are on: a lit tile under its glyph
+            rmDrawRect(gTheme->sbX + 3, cy - size / 2 - 5, gTheme->sbW - 6, size + 10, SB_PRIM(0x1E, 0x3C, 0x96, alpha * 0x6C / 0x80));
+        sbIcon(cat, cx, cy, size, lit, alpha);
+        if (sbFocus && slot == sbGlyph) { // Left's focus: RIPGRID's frame, glowing; dimmer while its drawer has the pad
+            int l = gTheme->sbX + 1, t = cy - size / 2 - 7, w = gTheme->sbW - 2, h = size + 14;
+            u64 c = sbFocus == 1 ? SB_PRIM(0x8F, 0xE3, 0xFF, 0x80) : SB_PRIM(0x5A, 0x8C, 0xB4, 0x60);
+            if (sbFocus == 1) {
+                rmSetBlendAdditive(1);
+                rmDrawRect(l - 2, t - 2, w + 4, h + 4, SB_PRIM(0x18, 0x40, 0x60, 0x50));
+                rmSetBlendAdditive(0);
+            }
+            rmDrawRect(l, t, w, 2, c);
+            rmDrawRect(l, t + h - 2, w, 2, c);
+            rmDrawRect(l, t, 2, h, c);
+            rmDrawRect(l + w - 2, t, 2, h, c);
+        }
+    }
+}
+
+void ripps2SidebarOpen(int list)
+{
+    if (!ripps2SidebarOn())
+        return;
+    sbGlyph = ripps2CatSlot(gRipps2Category);
+    sbDirect = list;
+    if (list) {
+        sbFocus = 2;
+        sbItem = gRipps2Category == RIPPS2_CAT_STORAGE ? 1 + menuSourceCurrent() : 0;
+    } else {
+        sbFocus = 1;
+        sbItem = 0;
+    }
+    sfxPlay(SFX_PAGE_IN);
+}
+
+static void sbClose(void)
+{
+    sbFocus = 0;
+    sbDirect = 0;
+}
+
+void ripps2SidebarInput(void)
+{
+    int cancel = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    int cat = ripps2CatSlot(sbGlyph);
+
+    if (sbFocus == 1) {
+        if (getKey(KEY_UP) && sbGlyph > 0) {
+            sbGlyph--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sbGlyph < RIPPS2_CAT_COUNT - 1) {
+            sbGlyph++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) { // into this drawer's list, on the source in use
+            sbFocus = 2;
+            sbItem = cat == RIPPS2_CAT_STORAGE && gRipps2Category == RIPPS2_CAT_STORAGE ? 1 + menuSourceCurrent() : 0;
+            sfxPlay(SFX_CONFIRM);
+        } else if (getKeyOn(cancel) || getKeyOn(KEY_RIGHT)) {
+            sbClose();
+            sfxPlay(SFX_PAGE_OUT);
+        }
+        return;
+    }
+    if (sbFocus == 2) {
+        int n = sbRows(cat);
+        if (getKey(KEY_UP) && sbItem > 0) {
+            sbItem--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sbItem < n - 1) {
+            sbItem++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) { // go there: the category, and on Storage the source chosen
+            sfxPlay(SFX_CONFIRM);
+            sbClose();
+            if (cat == RIPPS2_CAT_STORAGE && sbItem > 0)
+                menuSourceSelect(sbItem - 1);
+            ripps2SetCategory(cat);
+        } else if (getKeyOn(cancel)) {
+            if (sbDirect)
+                sbClose();
+            else
+                sbFocus = 1;
+            sfxPlay(SFX_CANCEL);
+        } else if (getKeyOn(KEY_RIGHT)) {
+            sbClose();
+            sfxPlay(SFX_PAGE_OUT);
+        }
+    }
+}
