+/*
+  RIPPS2 build 101 (user: "whenever I've set things the sound triggers follow out of the menu and begin to bug
+  out ... make sure there is nothing stray in memory from choosing"). A load of the sound set (sfxInit: a new
+  theme, the theme cycle, an IOP reboot, a rip, the AUDIO folder found late on a drive) keys every voice off,
+  frees the sounds and writes them back one by one on the IO worker, which takes seconds when the rips come
+  from a memory card. The menu went on playing through it: a cursor or a page sound was asked of a half-loaded
+  set, and a confirm caught by the load was kept until its end and sounded seconds later, out of the menu it
+  belonged to; the late AUDIO find loaded with no flag at all. Now, while a load waits or runs (sfxSetBusy) the
+  GUI touches no voice: a cursor tick or a drive sound is dropped, and the newest one-shot is held and plays when
+  the set is in only if it was asked within SFX_HELD_FRESH_MS (else it is dropped: no sound turns up after its
+  moment). Every load also forgets which voice the sounds before it took (the last one-shot and its voice).
+*/
+#define SFX_HELD_FRESH_MS 300
+#define SFX_CLOCKS_PER_MS 147456 // EE cpu_ticks() rate (defined again below, the same)
+static volatile int sfxLoading = 0;   // sfxInit is running (on the IO worker)
+static volatile int sfxHeldId = -1;   // the one-shot asked while the set loads
+static volatile u32 sfxHeldTicks = 0; // when (cpu_ticks)
+static volatile int sfxPendingId = -1; // build 100: a confirm or cancel waiting for the end of its frame
+static volatile u32 sfxLastConfirmTicks = 0;
+static u32 lastCursorTicks = 0, lastOneShotTicks = 0; // sfxPlayNow's memory of the last sounds
+static int lastOneShotId = -1, lastOneShotVoice = -1;
+
+static void sfxForgetPresses(void) // which voice the last sounds took: every voice is about to be keyed off
+{
+    lastCursorTicks = 0;
+    lastOneShotTicks = 0;
+    lastOneShotId = -1;
+    lastOneShotVoice = -1;
+}
