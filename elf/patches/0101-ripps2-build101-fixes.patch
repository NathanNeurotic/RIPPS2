+// build 101: a load is waiting or running: the GUI leaves the voices alone
+static int sfxSetBusy(void)
+{
+    return sfxReloadQueued || sfxReloadBusy || sfxLoading;
+}
+
+// build 101: a one-shot asked while the set loads waits; the newest does, unless an earlier one of the same press
+// outranks it (a page sound over its confirm)
+static void sfxHold(int id)
+{
+    u32 now = cpu_ticks();
+    if (sfxHeldId >= 0 && (now - sfxHeldTicks) / SFX_CLOCKS_PER_MS < SFX_PRESS_MS && sfxPressRank(id) < sfxPressRank(sfxHeldId))
+        return;
+    sfxHeldId = id;
+    sfxHeldTicks = now | 1;
+}
+
+// build 101: the set is in: the held one-shot plays if it is still its moment, else it is dropped
+static void sfxPlayHeld(void)
+{
+    int id = sfxHeldId;
+    u32 at = sfxHeldTicks;
+    sfxHeldId = -1;
+    if (id >= 0 && at != 0 && (cpu_ticks() - at) / SFX_CLOCKS_PER_MS < SFX_HELD_FRESH_MS)
+        sfxPlay(id);
+}
