+#define DIA_RETURN_SLOTS 8
+static struct UIItem *diaReturnUi[DIA_RETURN_SLOTS];
+static int diaReturnId[DIA_RETURN_SLOTS];
+
+static int diaReturnSlot(struct UIItem *ui)
+{
