+            ripps2Diag("mmce: busy for %d ms", (int)((now - busySince) * 1000 / CLOCKS_PER_SEC));
+        busy = 0;
+        busySince = 0;
+        return 0;
+    }
+    if (busySince == 0) {
+        busySince = now;
+        ripps2Diag("mmce: the card says busy; its reads wait");
+    }
+    busy = (now - busySince) < (clock_t)MMCE_BUSY_GIVEUP_S * CLOCKS_PER_SEC;
+    if (!busy)
+        LOG("MMCE: the card has said busy for %d s; reading it anyway\n", MMCE_BUSY_GIVEUP_S);
+    return busy;
