+// RIPPS2 build 115: one picture file of a game's art, whatever it holds. A PNG goes to the streaming loader
+// above; anything it cannot take (a JPG named .png, 16 bits a channel, bigger than a texture may be) and every JPG
+// goes through the decoder that reads both and shrinks: backgrounds to 720 x 512 (a full screen), the rest to 512
+// on a side. ERR_BAD_FILE only when the file is missing or unreadable as either; a short read stays transient.
+static int texLoadArt(GSTEXTURE *texture, const char *filePath)
+{
+    const char *dot = strrchr(filePath, '.');
+    const char *slash = strrchr(filePath, '/');
+    const char *stemEnd = dot != NULL ? dot : filePath + strlen(filePath);
+    int bg = 0, result = ERR_BAD_FILE;
+
+    // a background is <key>_BG or OPL Manager's <key>_BG_00 to _BG_06
+    if (stemEnd - filePath >= 3 && !strncasecmp(stemEnd - 3, "_BG", 3))
+        bg = 1;
+    else if (stemEnd - filePath >= 6 && !strncasecmp(stemEnd - 6, "_BG_0", 5))
+        bg = 1;
+    if (slash != NULL && dot != NULL && dot < slash)
+        dot = NULL; // a dot in a folder name is not an extension
+
+    if (dot != NULL && !strcasecmp(dot, ".png")) {
+        result = texLoad(texture, filePath);
+        if (result >= 0)
+            return 0;
+        if (result == ERR_BAD_FILE || result == ERR_FILE_IO || result == ERR_LOAD_ABORTED)
+            return result;
+        LOG("texLoadArt: %s not taken as a PNG (%d), decoding it as a picture\n", filePath, result);
+    }
+    result = texLoadPicture(texture, filePath, bg ? 720 : 512, 512);
+    return (result >= 0) ? 0 : result;
+}
