+int artIndexFindPicture(const char *stemPath, char *out, int outSize)
+{
+    char dir[ART_INDEX_DIR_MAX];
+    const char *base = NULL;
+
+    if (stemPath == NULL || stemPath[0] == '\0' || out == NULL || outSize <= 0)
+        return -1;
