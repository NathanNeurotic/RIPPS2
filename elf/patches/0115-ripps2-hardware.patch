diff --git a/.github/scripts/test_art_names.py b/.github/scripts/test_art_names.py
new file mode 100644
index 0000000..d32a97c
--- /dev/null
+++ b/.github/scripts/test_art_names.py
@@ -0,0 +1,188 @@
+"""RIPPS2 build 115: a game's art is found under every name it goes by.
+
+Compiles the real src/artindex.c against a real folder of art files, and the real texArtAliases (src/textures.c)
+with the real PS1 ID parser (src/vcdsupport.c), then checks:
+  - a lookup by name without extension finds the picture in any letter case, as .png, .jpg or .jpeg, a PNG first,
+    and hands back the name as the folder lists it (PFS minds case);
+  - a name that is not there is answered "absent" from RAM, and other threads and SMB get "go and look";
+  - OPL Manager's _BG_00 / _SCR_00 / _SCR_01 stand in for _BG / _SCR / _SCR2 and the other way round;
+  - a PS1 game's art is also looked for by its disc ID and by its POPStarter ELF name, only where misses are free.
+"""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+TEXTURES = (ROOT / "src/textures.c").read_text(encoding="utf-8")
+VCD = (ROOT / "src/vcdsupport.c").read_text(encoding="utf-8")
+failures = []
+
+
+def function(source, signature):
+    pos = source.find(signature)
+    if pos < 0:
+        raise AssertionError(f"Missing function: {signature}")
+    start = source.find("{", pos)
+    depth = 0
+    for i in range(start, len(source)):
+        if source[i] == "{":
+            depth += 1
+        elif source[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[pos:i + 1]
+    raise AssertionError(f"Unterminated function: {signature}")
+
+
+def run(label, files, main_src, args=()):
+    with tempfile.TemporaryDirectory() as d:
+        d = Path(d)
+        for name, text in files.items():
+            (d / name).parent.mkdir(parents=True, exist_ok=True)
+            (d / name).write_text(text, encoding="utf-8")
+        (d / "main.c").write_text(main_src, encoding="utf-8")
+        exe = d / "test"
+        srcs = [str(d / "main.c")] + [str(d / n) for n in files if n.endswith(".c")]
+        build = subprocess.run(["cc", "-std=gnu99", "-O0", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
+                                "-Wno-unused-function", "-I", str(d), "-I", str(ROOT), "-o", str(exe)] + srcs,
+                               capture_output=True, text=True, check=False)
+        if build.returncode:
+            failures.append(f"{label}: compile failed\n{build.stderr}")
+            return
+        r = subprocess.run([str(exe)] + list(args), capture_output=True, text=True, check=False)
+        print(r.stdout, end="")
+        if r.returncode:
+            failures.append(f"{label}: {r.stderr or r.stdout}")
+
+
+# ---- the real artindex.c, on a real folder ----
+stubs = {
+    "kernel.h": "#pragma once\nint GetThreadId(void);\n",
+    "include/opl.h": "#pragma once\n#include <string.h>\n#include <strings.h>\n",
+    "include/ioman.h": "#pragma once\n#define LOG(...) ((void)0)\n",
+    "artindex.c": (ROOT / "src/artindex.c").read_text(encoding="utf-8"),
+}
+index_main = r"""
+#include <stdio.h>
+#include <string.h>
+#include "include/artindex.h"
+static int tid = 7;
+int GetThreadId(void) { return tid; }
+static int fails;
+static void expect(const char *stem, int want, const char *wantName)
+{
+    char out[256] = "";
+    int r = artIndexFindPicture(stem, out, sizeof(out));
+    const char *got = strrchr(out, '/');
+    got = got ? got + 1 : out;
+    if (r != want || (wantName && strcmp(got, wantName))) {
+        fprintf(stderr, "%s: got %d '%s', want %d '%s'\n", stem, r, got, want, wantName ? wantName : "");
+        fails++;
+    }
+}
+int main(int argc, char **argv)
+{
+    char art[512], stem[600];
+    snprintf(art, sizeof(art), "%s/ART", argv[1]);
+    artIndexSetOwnerThread(7);
+#define AT(n) (snprintf(stem, sizeof(stem), "%s/%s", art, n), stem)
+    expect(AT("SLUS_210.50_BG"), 1, "slus_210.50_bg.PNG");       /* any case, real name back */
+    expect(AT("SLUS_210.50_COV"), 1, "SLUS_210.50_COV.png");     /* a PNG before a JPG */
+    expect(AT("Tekken 3_COV"), 1, "Tekken 3_COV.JPEG");          /* .jpeg too */
+    expect(AT("SLUS_210.50_ICO"), 1, "SLUS_210.50_ICO.jpg");
+    expect(AT("SLUS_999.99_COV"), 0, NULL);                       /* absent, from RAM */
+    expect(AT("SLUS_210.50_BG.old"), 1, "SLUS_210.50_BG.old.png");
+    expect(AT("README"), 0, NULL);                                /* not a picture */
+    expect("smb0:/ART/SLUS_210.50_COV", -1, NULL);                /* SMB: go and look */
+    tid = 8;
+    expect(AT("SLUS_210.50_COV"), -1, NULL);                      /* another thread: go and look */
+    tid = 7;
+    char full[600];
+    snprintf(full, sizeof(full), "%s/SLUS_210.50_COV.png", art);
+    if (!artIndexMayExist(full)) { fputs("MayExist lost a file\n", stderr); fails++; }
+    snprintf(full, sizeof(full), "%s/SLUS_999.99_COV.png", art);
+    if (artIndexMayExist(full)) { fputs("MayExist kept a missing file\n", stderr); fails++; }
+    if (!fails)
+        puts("ART names: case, .png/.jpg/.jpeg, PNG first, real names, absent from RAM");
+    return fails != 0;
+}
+"""
+with tempfile.TemporaryDirectory() as lib:
+    a = Path(lib) / "ART"
+    a.mkdir()
+    for n in ("slus_210.50_bg.PNG", "SLUS_210.50_COV.jpg", "SLUS_210.50_COV.png", "SLUS_210.50_ICO.jpg",
+              "Tekken 3_COV.JPEG", "README.txt", "SLUS_210.50_BG.old.png"):
+        (a / n).write_bytes(b"x")
+    run("art index", stubs, index_main, [lib.replace("\\", "/")])  # a Windows run: forward slashes, as on the PS2
+
+# ---- texArtAliases with the real PS1 ID parser ----
+aliases = function(TEXTURES, "static int texArtAliases(")
+skip = function(VCD, "static int vcdSkipPopstarterPrefix(")
+extract = function(VCD, "int vcdExtractGameId(")
+if "#define TEX_ART_ALIASES" not in TEXTURES:
+    failures.append("TEX_ART_ALIASES is gone")
+alias_main = r"""
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#define VCD_ID_MAX 16
+#define TEX_ART_ALIASES 7
+static const char *discId; /* what vcdDisplayIdCached knows */
+int vcdDisplayIdCached(const char *name, char *idOut, int idSize)
+{
+    if (!discId) return 0;
+    snprintf(idOut, idSize, "%s", discId);
+    return 1;
+}
+@SKIP@
+@EXTRACT@
+@ALIASES@
+static int fails;
+static void expect(const char *path, int listed, const char *const *want)
+{
+    char out[TEX_ART_ALIASES][256];
+    int n = texArtAliases(path, listed, out), i, w = 0;
+    while (want[w]) w++;
+    if (n != w) { fprintf(stderr, "%s: %d aliases, want %d\n", path, n, w); for (i = 0; i < n; i++) fprintf(stderr, "  %s\n", out[i]); fails++; return; }
+    for (i = 0; i < n; i++)
+        if (strcmp(out[i], want[i])) { fprintf(stderr, "%s [%d]: '%s', want '%s'\n", path, i, out[i], want[i]); fails++; }
+}
+int main(void)
+{
+    const char *bg[] = {"mass0:ART/SLUS_210.50_BG_00", NULL};
+    expect("mass0:ART/SLUS_210.50_BG", 1, bg);                   /* PS2: OPL Manager's name, no PS1 keys */
+    const char *bg00[] = {"mass0:/ART/SLUS_210.50_BG", NULL};
+    expect("mass0:/ART/SLUS_210.50_BG_00", 1, bg00);             /* a theme asking for _BG_00 */
+    const char *scr2[] = {"pfs0:/ART/SLUS_210.50_SCR_01", NULL};
+    expect("pfs0:/ART/SLUS_210.50_SCR2", 1, scr2);
+    const char *cov[] = {NULL};
+    expect("mass0:/ART/SLUS_210.50_COV", 1, cov);                /* a cover has one name */
+    const char *ps1[] = {"mass0:/ART/XX.Tekken 3.ELF_COV", NULL};
+    expect("mass0:/ART/Tekken 3_COV", 1, ps1);
+    discId = "SCUS_944.26";
+    const char *ps1id[] = {"mass0:/ART/SCUS_944.26_COV", "mass0:/ART/XX.Tekken 3.ELF_COV", NULL};
+    expect("mass0:/ART/Tekken 3_COV", 1, ps1id);                 /* the disc's ID once read */
+    discId = NULL;
+    const char *named[] = {"mass0:/ART/SLUS_005.94.Crash_SCR_00", "mass0:/ART/SLUS_005.94_SCR",
+                           "mass0:/ART/SLUS_005.94_SCR_00", "mass0:/ART/XX.SLUS_005.94.Crash.ELF_SCR",
+                           "mass0:/ART/XX.SLUS_005.94.Crash.ELF_SCR_00", NULL};
+    expect("mass0:/ART/SLUS_005.94.Crash_SCR", 1, named);        /* the ID at the front of the file name */
+    const char *unlisted[] = {"mass0:/ART/Tekken 3_BG_00", NULL};
+    expect("mass0:/ART/Tekken 3_BG", 0, unlisted);               /* no listing: only the kind's other name */
+    const char *app[] = {NULL};
+    expect("mass0:/ART/OPNPS2LD.ELF_COV", 1, app);               /* an app keeps its name */
+    expect("mass0:/THM/mine/bg_BG", 1, cov);                     /* theme files keep theirs */
+    expect("mass0:/SMART/x_BG", 1, cov);                         /* a folder merely ending in ART is not ART */
+    if (!fails)
+        puts("ART aliases: OPL Manager kinds both ways, PS1 disc ID and XX.ELF names, nothing for themes");
+    return fails != 0;
+}
+"""
+run("art aliases", {}, alias_main.replace("@SKIP@", skip).replace("@EXTRACT@", extract).replace("@ALIASES@", aliases))
+
+if failures:
+    print("ART name checks FAILED:")
+    for f in failures:
+        print(" - " + f)
+    sys.exit(1)
