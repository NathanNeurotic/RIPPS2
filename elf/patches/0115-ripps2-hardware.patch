+// Fade turns it off; a theme can with hints_fade=0.
+int gRipps2HintFade = 0;
+#define HINT_FADE_SLOTS 32
+
+static int hintFadeOn(void)
+{
+    return gRipps2HintFade == 1 || (gRipps2HintFade == 0 && (gTheme == NULL || gTheme->hintsFade));
+}
+
+float ripps2HintGlyphFade(int iconId, int textId)
+{
+    static struct
+    {
+        int icon, text;
+        double at;
+    } slot[HINT_FADE_SLOTS];
+    static unsigned int frame = ~0u;
+    static int idx = 0;
+    static double lastSeen = 0.0;
+    double now = ripps2Seconds();
+    int i;
+
+    if (!hintFadeOn())
+        return 1.0f;
+    if (frame != gRmFrameNo) {
+        frame = gRmFrameNo;
+        idx = 0;
+        if (now - lastSeen > 0.5) // no hint drawn for a while (a full-screen view, a launch): every one fades in anew
+            for (i = 0; i < HINT_FADE_SLOTS; i++)
+                slot[i].icon = slot[i].text = -2;
+    }
+    lastSeen = now;
+    if (idx >= HINT_FADE_SLOTS)
+        return 1.0f;
+    i = idx++;
+    if (slot[i].icon != iconId || slot[i].text != textId) {
+        slot[i].icon = iconId;
+        slot[i].text = textId;
+        slot[i].at = now;
+    }
+    return smoothUnit((float)((now - slot[i].at) / ART_FADE_S));
+}
+
+// build 115: D-pad Glyphs > Guidance. The glyphs come in once the pad has been left alone GUIDANCE_IDLE_S (showing what
+// to press now), and go at the first press
+#define GUIDANCE_IDLE_S 4.2
+float ripps2GuidanceAlpha(void)
+{
+    static double seen = 0.0;
+    static float a = 0.0f;
+    double now = ripps2Seconds();
+    float dt = (float)(now - seen);
+    if (seen == 0.0 || dt > 0.5f || dt < 0.0f)
+        dt = 0.0f;
+    seen = now;
+    if (glyphsMode() != RIPPS2_GLYPHS_GUIDANCE)
+        return 0.0f;
+    if (now - inputAt >= GUIDANCE_IDLE_S)
+        a = fminf(1.0f, a + dt / ART_FADE_S);
+    else
+        a = 0.0f; // a press: gone at once
+    return smoothUnit(a);
+}
