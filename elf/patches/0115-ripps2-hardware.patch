+// RIPPS2 build 115: a game ON the card waits for its own memory card. The OPL core's launch writes the game into the
+// PS2's play history (sysLaunchLoaderElf), and an sd2psXtd with Game ID on switches cards on that write; the first time
+// for a game it then writes the new 8 MB card to its SD, the SD the game streams from, and only while the card's file
+// access is idle -- which game streaming is. Started that way, Burnout 3 took over 5 minutes to the PS2 logo, hung and
+// went white, and the game's card was left half written (the user's SD2PSXTD, 10/25). So the history goes in here,
+// before the launch, and the launch waits, on screen, while the card says busy. sent: RIPPS2's own Game ID send went
+// out and was not confirmed within its ~3 s.
+static void mmceReadyGameCard(config_set_t *configSet, const char *startup, int sent)
+{
+    char root[sizeof(mmcePrefix)], name[32];
+    clock_t start;
+    int status, waited;
+
+    mmceGetDeviceRoot(root, sizeof(root));
+    if (root[0] == '\0' || fileXioDevctl(root, 0x2, NULL, 0, NULL, 0) < 0)
+        return; // no status to read: launch as before
+    if (!sent) {
+#if (!defined(__DEBUG) && !defined(_DTL_T10000))
+        // the same name the launch writes (sysLaunchLoaderElf), so its own write changes nothing
+        if (configGetStrCopy(configSet, CONFIG_ITEM_ALTSTARTUP, name, sizeof(name)) == 0)
+            snprintf(name, sizeof(name), "%s", startup);
+        AddHistoryRecordUsingFullPath(name);
+        // build 115: the device reads the history only once the write has reached its SD (after 100 ms without card
+        // traffic) and then 2 s more have passed with no card writes (sd2psXtd HISTORY_WRITE_HYST_US): 1.5 s was too short
+        for (waited = 0; waited < MMCE_HISTORY_SWITCH_MS; waited += 100) {
+            status = fileXioDevctl(root, 0x2, NULL, 0, NULL, 0);
+            if (status >= 0 && (status & 1))
+                break;
+            guiRenderTextScreen(_t("Asking the SD2PSX for this game's memory card..."));
+            DelayThread(100 * 1000);
+        }
+        if (waited >= MMCE_HISTORY_SWITCH_MS)
+            return; // the card stayed as it was: Game ID is off on it, or this game's card is in already
+#else
+        return; // these builds write no history at launch
+#endif
+    }
+    start = clock();
+    mmceWaitCardReady(root);
+    LOG("MMCE: the game's memory card is ready after %d s\n", (int)((clock() - start) / CLOCKS_PER_SEC));
+    mmceSettleAfterSwitch();
+}
+
+// build 115: on screen while the card is busy loading or making a game's memory card. 1 when it cleared; 0 when it was
+// still busy after MMCE_CARD_READY_MAX_S; 2 when START was pressed (the game starts anyway, as the user chose)
+static int mmceWaitCardReady(const char *root)
+{
+    char line[256];
+    clock_t start = clock();
+    int status, s;
+
+    while ((status = fileXioDevctl(root, 0x2, NULL, 0, NULL, 0)) >= 0 && (status & 1)) {
+        s = (int)((clock() - start) / CLOCKS_PER_SEC);
+        if (s >= MMCE_CARD_READY_MAX_S) {
+            LOG("MMCE: the game's memory card was still busy after %d s; launching\n", s);
+            ripps2Diag("mmce: the game's card still busy after %d s; launching", s);
+            return 0;
+        }
+        readPads();
+        if (getKeyOn(KEY_START)) {
+            LOG("MMCE: START pressed after %d s of the card's wait; launching\n", s);
+            ripps2Diag("mmce: START after %d s of the card's wait; launching", s);
+            return 2;
+        }
+        snprintf(line, sizeof(line),
+                 _t("The SD2PSX is getting this game's memory card ready (%d s). The game starts when it is done; START starts it now."), s);
+        guiRenderTextScreen(line);
+        DelayThread(250 * 1000);
+    }
+    ripps2Diag("mmce: the game's card ready after %d ms", (int)((clock() - start) * 1000 / CLOCKS_PER_SEC));
+    return 1;
+}
