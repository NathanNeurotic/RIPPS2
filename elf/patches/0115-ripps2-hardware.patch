+// build 115 (the user, 10/25: the sidebar "slides and fades the glyphs off when they switch", "use the slide animation
+// from the coverflow on the sidebars so the default and XL sidebars both slide open"): a value that eases to where it is
+// sent the way RIPFLOW's covers slide, a cubic ease-out over RIPFLOW's own animation time (Layout's, 0: at once); sent
+// somewhere new mid-slide, it goes on from where it is
+typedef struct
+{
+    float from, to;
+    clock_t at;
+    int set;
+} sb_tween_t;
+
+static float sbTweenAt(const sb_tween_t *tw, clock_t now)
+{
+    float dur = gCoverflowAnimSpeed > 0 ? gCoverflowAnimSpeed / 1000.0f : 0.0f, t;
+    if (dur <= 0.0f)
+        return tw->to;
+    t = (float)(now - tw->at) / (float)CLOCKS_PER_SEC / dur;
+    if (t >= 1.0f || t < 0.0f)
+        return tw->to;
+    t = 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t);
+    return tw->from + (tw->to - tw->from) * t;
+}
+
+static float sbTween(sb_tween_t *tw, float target)
+{
+    clock_t now = clock();
+    if (!tw->set) {
+        tw->from = tw->to = target;
+        tw->at = now;
+        tw->set = 1;
+    } else if (target != tw->to) {
+        tw->from = sbTweenAt(tw, now);
+        tw->to = target;
+        tw->at = now;
+    }
+    return sbTweenAt(tw, now);
+}
