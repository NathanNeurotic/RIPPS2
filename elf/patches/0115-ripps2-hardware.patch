+// RIPPS2 build 115: what the Neutrino about to start understands. Neutrino stops at the first option it does not know
+// ("ERROR: unknown argv", then back to the browser: the console seems to reboot), and its options came over the years
+// (its loader's parse, rickgaiser/neutrino tags): -cfg -dbc -logo in 1.2, -bsdfs in 1.3, -cwd and -qb in 1.4, -gsm in
+// 1.5; -dbc is missing again from 1.5 and 1.6. A Neutrino set up for another launcher (XEB+, an older NHDDL kit) may be
+// any of them, and RIPPS2 sent every option it uses. Each version keeps the options it reads as strings in its ELF,
+// so the ELF is read once before the teardown (sysNeutrinoPreflight) and only those options are sent. An ELF that
+// does not show "-dvd=" (packed, or not Neutrino) is taken to know them all, as before.
+#define NF_CFG   0x001
+#define NF_DBC   0x002
+#define NF_LOGO  0x004
+#define NF_BSDFS 0x008
+#define NF_CWD   0x010
+#define NF_QB    0x020
+#define NF_GSM   0x040
+#define NF_MC    0x080
+#define NF_ELF   0x100
+#define NF_GC    0x200
+#define NF_ALL   0x3ff
+static unsigned int sysNeutrinoFlagSet = NF_ALL;
+static char sysNeutrinoFlagsFor[256] = "";
+static char sysNeutrinoVersion[32] = "";
+
+// Where a Neutrino's folder ends: its last '/' or '\\' (sysLastPathSeparator's rule; that one is further down)
+static const char *sysNeutrinoDirEnd(const char *path)
+{
+    const char *slash = strrchr(path, '/'), *backslash = strrchr(path, '\\');
+    return (backslash != NULL && (slash == NULL || backslash > slash)) ? backslash : slash;
+}
+
+// The options of a Neutrino release (its loader's parse, per tag)
+static unsigned int sysNeutrinoFlagsOf(int major, int minor)
+{
+    unsigned int f = NF_ELF | NF_GC;
+    if (major > 1 || minor >= 1)
+        f |= NF_MC;
+    if (major > 1 || minor >= 2)
+        f |= NF_CFG | NF_DBC | NF_LOGO;
+    if (major > 1 || minor >= 3)
+        f |= NF_BSDFS;
+    if (major > 1 || minor >= 4)
+        f |= NF_CWD | NF_QB;
+    if (major > 1 || minor >= 5)
+        f |= NF_GSM;
+    if (major == 1 && (minor == 5 || minor == 6))
+        f &= ~NF_DBC; // not in 1.5's or 1.6's parse
+    return f;
+}
+
+// The ELF's own option strings, for a Neutrino that is not packed. Each literal is taken with the NUL that ends it, so
+// a word in the usage text does not count; the last 16 bytes of a piece are kept in front of the next. 1: readable
+static int sysNeutrinoProbeElf(const char *neutrinoPath, unsigned int *flags)
+{
+    static const struct
+    {
+        const char *lit;
+        unsigned int bit;
+    } opts[] = {{"-cfg=", NF_CFG}, {"-dbc", NF_DBC}, {"-logo", NF_LOGO}, {"-bsdfs=", NF_BSDFS}, {"-cwd=", NF_CWD},
+                {"-qb", NF_QB}, {"-gsm=", NF_GSM}, {"-mc0=", NF_MC}, {"-elf=", NF_ELF}, {"-gc=", NF_GC}};
+    unsigned char *buf;
+    unsigned int found = 0;
+    int fd, got, keep = 0, total = 0, dvd = 0, i, j;
+    const int chunk = 32 * 1024, tail = 16;
+
+    if ((fd = open(neutrinoPath, O_RDONLY)) < 0)
+        return 0;
+    if ((buf = malloc(chunk + tail)) == NULL) {
+        close(fd);
+        return 0;
+    }
+    while (total < 8 * 1024 * 1024 && (got = read(fd, buf + keep, chunk)) > 0) {
+        int len = keep + got;
+        total += got;
+        for (i = 0; i + 4 <= len; i++) {
+            if (buf[i] == 'v') { // a version tag, "v1.8.0", as 1.8 keeps it (GIT_TAG)
+                if (!sysNeutrinoVersion[0] && i > 0 && buf[i - 1] == '\0' && buf[i + 1] >= '0' && buf[i + 1] <= '9' && buf[i + 2] == '.') {
+                    for (j = i + 1; j < len && j - i < 24 && buf[j] > ' ' && buf[j] < 0x7f; j++)
+                        ;
+                    if (j < len && buf[j] == '\0' && j - i >= 5)
+                        snprintf(sysNeutrinoVersion, sizeof(sysNeutrinoVersion), "%.*s", j - i, (const char *)&buf[i]);
+                }
+                continue;
+            }
+            if (buf[i] != '-')
+                continue;
+            if (i + 6 <= len && !memcmp(&buf[i], "-dvd=", 6))
+                dvd = 1;
+            for (j = 0; j < (int)(sizeof(opts) / sizeof(opts[0])); j++) {
+                int n = (int)strlen(opts[j].lit) + 1;
+                if (i + n <= len && !memcmp(&buf[i], opts[j].lit, n))
+                    found |= opts[j].bit;
+            }
+        }
+        keep = len < tail ? len : tail;
+        memmove(buf, buf + len - keep, keep);
+    }
+    free(buf);
+    close(fd);
+    if (dvd)
+        *flags = found;
+    return dvd;
+}
