+    unsigned int want = artIndexHashN(base, baseLen);
+    int lo = 0, hi = slot->picCount;
+
+    while (lo < hi) { // the first picture with this hash
+        int mid = lo + ((hi - lo) >> 1);
+        if (slot->pics[mid].hash < want)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+
+    const char *best = NULL;
