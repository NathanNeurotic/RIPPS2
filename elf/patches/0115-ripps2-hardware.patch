+static void mp3Fill(void) // what is left moved to the front, the rest of the buffer read
+{
+    int n;
+    if (mp3InPos > 0) {
+        memmove(mp3In, mp3In + mp3InPos, mp3InLen - mp3InPos);
+        mp3InLen -= mp3InPos;
+        mp3InPos = 0;
+    }
+    if (mp3Eof || mp3InLen >= MP3_IN_SIZE)
