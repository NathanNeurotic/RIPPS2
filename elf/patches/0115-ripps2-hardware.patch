+        static const struct
+        {
+            const char *file, *name;
+            int minor;
+        } kits[] = {{"bsd-mmce.toml", "1.5", 5}, {"bsdfs-exfat.toml", "1.3 or 1.4", 3}, {"rc-uya.toml", "1.2", 2}, {"bsd-usb.toml", "1.0 or 1.1", 0}};
+        int k;
+        for (k = 0; k < (int)(sizeof(kits) / sizeof(kits[0])); k++) {
+            if (sysNeutrinoHas(dir, *slash, kits[k].file)) {
+                flags = sysNeutrinoFlagsOf(1, kits[k].minor);
+                snprintf(sysNeutrinoVersion, sizeof(sysNeutrinoVersion), "%s", kits[k].name);
+                break;
+            }
+        }
+    }
+    sysNeutrinoFlagSet = flags;
+    LOG("[NEUTRINO] %s: %s, options 0x%03x (its config files)\n", neutrinoPath, sysNeutrinoVersion[0] ? sysNeutrinoVersion : "unknown", flags);
+}
