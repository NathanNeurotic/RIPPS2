+//     _SCR_01, where RIPPS2's themes ask for _BG, _SCR and _SCR2; a theme made for those names asks the other way.
+//   - A PS1 game's other keys (listedKeys: only where the folder's listing makes a miss free): the disc ID at the
+//     front of a file named "SLUS_005.94.Title", the ID RIPPS2 has already read off the disc, and the POPStarter
+//     launcher's name XX.<key>.ELF, which is how OPL draws a PS1 game set up as an app.
+#define TEX_ART_ALIASES 7
+static int texArtAliases(const char *path, int listedKeys, char out[TEX_ART_ALIASES][256])
+{
+    static const char *const kinds[] = {"SCR_00", "SCR_01", "BG_00", "COV2", "SCR2", "COV", "ICO", "LAB", "LGO", "SCR", "BG"};
