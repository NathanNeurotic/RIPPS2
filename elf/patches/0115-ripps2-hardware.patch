+// build 115: an SD2PSX's boot card (MemoryCards/PS2/BOOT/BootCard-N.mcd on its SD) is the card in the device's own memory
+// while RIPPS2 runs from it: the device writes that memory back over the file, so a save written into the file would be
+// lost, or would tear the card. It opens to look at and copy from; never to write
+static int r2IsSd2psxBootCard(const char *image)
+{
+    size_t n = strlen(image);
