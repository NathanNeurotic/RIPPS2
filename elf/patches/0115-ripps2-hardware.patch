+static int mp3InLen = 0, mp3InPos = 0, mp3Eof = 0, mp3PcmN = 0, mp3PcmPos = 0, mp3SrcRate = 44100, mp3SrcCh = 2, mp3Primed = 0;
+static unsigned int mp3Phase = 0;
+static short mp3Prev[2], mp3Cur[2];
