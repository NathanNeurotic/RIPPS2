+            continue;
+        if (best == NULL || !strcasecmp(&name[baseLen], ".png")) // a PNG first, as the probes always went
+            best = name;
+    }
+
+    if (best != NULL) {
+        if (snprintf(out, outSize, "%s/%s", dir, best) >= outSize)
+            return -1;
+        return 1;
+    }
+
+    // As in artIndexMayExist: an invalidation mid-search downgrades "absent" to "go and look".
+    if (gArtIndexGen != genBefore)
+        return -1;
+
+    gArtIndexAbsentAnswered++;
