+/*
+  RIPPS2 build 115: Fast Boot (Game Sources > Cache). The user, 10/26 evening: "host filesystem drive is forced truly
+  auto so maybe read the .lst from there with settings in a combined file that's super lightweight RIPPS2 coded so the gui
+  pops up to navigate the sources from that master cache list". RIPPS2.FB, a few lines of text beside RIPPS2.ELF, names
+  where the settings (and the master list beside them) and the sounds are, so a boot reads RIPPS2's own drive and goes
+  straight there: no memory card scan, no redirect, no AUDIO search over every drive. Written after each settings save
+  while Fast Boot is on; removed when it is turned off.
+*/
+int gRipps2FastBoot = 0;
+
+static int fastBootPath(char *out, int size)
+{
+    char dir[256];
+    if (!oplGetRipps2Dir(dir, sizeof(dir)) || !strncmp(dir, "host", 4))
+        return 0; // PCSX2's host: is no drive a console has
+    return snprintf(out, size, "%sRIPPS2.FB", dir) < size;
+}
+
+static int fastBootRead(char *home, int homeSize, char *audio, int audioSize)
+{
+    char path[300], line[300];
+    FILE *f;
+    int n;
+
+    home[0] = audio[0] = '\0';
+    if (!fastBootPath(path, sizeof(path)) || (f = fopen(path, "r")) == NULL)
+        return 0;
+    while (fgets(line, sizeof(line), f) != NULL) {
+        n = strlen(line);
+        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r' || line[n - 1] == ' '))
+            line[--n] = '\0';
+        if (!strncmp(line, "home=", 5))
+            snprintf(home, homeSize, "%s", line + 5);
+        else if (!strncmp(line, "audio=", 6))
+            snprintf(audio, audioSize, "%s", line + 6);
+    }
+    fclose(f);
+    return home[0] != '\0';
+}
+
+// after a settings save: the gate says where they went (only when it changed: a memory card is not written each save)
+static void fastBootWrite(void)
+{
+    char path[300], text[700], old[700], audio[256];
+    int fd, n;
+
+    if (!fastBootPath(path, sizeof(path)))
+        return;
+    if (!gRipps2FastBoot) {
+        if ((fd = open(path, O_RDONLY)) >= 0) {
+            close(fd);
+            remove(path); // RIPPS2's own small file: off means the boot searches as it always did
+        }
+        return;
+    }
+    if (!ripps2AudioBase(audio, sizeof(audio), 0))
+        audio[0] = '\0';
+    n = snprintf(text, sizeof(text),
+                 "# RIPPS2 Fast Boot (Settings > Game Sources > Cache): where this RIPPS2 reads its settings and sounds first\r\n"
+                 "home=%s\r\naudio=%s\r\n",
+                 configGetHomePath(), audio);
+    if (n <= 0 || n >= (int)sizeof(text))
+        return;
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        int got = read(fd, old, sizeof(old) - 1);
+        close(fd);
+        if (got == n && !memcmp(old, text, n))
+            return;
+    }
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+        int ok = write(fd, text, n) == n;
+        close(fd);
+        ripps2Diag("fast boot: %s %s", path, ok ? "written" : "NOT written");
+    }
+}
