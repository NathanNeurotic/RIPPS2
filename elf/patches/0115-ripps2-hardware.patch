+// build 115 (the user, 10/26 evening: "so the BBL injector can successfully rollback the BBL install"): the newest folder
+// BIBLE moved aside on this card (RIPPS2-OLD-<folder>, -2 ...), or 0
+static int blBackupOf(int port, char *out, int size)
+{
+    char path[48];
+    int i;
+    for (i = 9; i >= 1; i--) {
+        if (i == 1)
+            snprintf(out, size, "RIPPS2-OLD-%.6s", blSysFolder);
+        else
+            snprintf(out, size, "RIPPS2-OLD-%.6s-%d", blSysFolder, i);
+        snprintf(path, sizeof(path), "mc%d:/%s", port, out);
+        if (blDirExists(path))
+            return 1;
+    }
+    return 0;
+}
+
+// BIBLE's folder moves aside (RIPPS2-BIBLE-<folder>; nothing is deleted) and the one it replaced goes back. The KELF the
+// card had is bound to the card, not to a folder name, so it starts again as it did
+static void blRestoreCard(int port)
+{
+    char msg[600], backup[32], aside[32], path[48];
+    int i;
+
+    if (!blBackupOf(port, backup, sizeof(backup)))
+        return;
+    snprintf(msg, sizeof(msg),
+             _t("RIPPS2: Setting up BBL 1.20\nThe memory card in slot %d: BBL 1.20 (mc%d:/%s) moves aside, and what it replaced (mc%d:/%s) goes back in its place. Nothing is deleted. The PS2BBL config stays as it is (BOOT LOCK can turn the lock off)."),
+             port + 1, port, blSysFolder, port, backup);
+    guiMsgBoxSound(SFX_MESSAGE);
+    guiMsgBoxStartOption(_t("RESTORE"));
+    if (guiMsgBox(msg, 0, NULL) != 2)
+        return;
+    for (i = 1; i < 10; i++) {
+        if (i == 1)
+            snprintf(aside, sizeof(aside), "RIPPS2-BIBLE-%.6s", blSysFolder);
+        else
+            snprintf(aside, sizeof(aside), "RIPPS2-BIBLE-%.6s-%d", blSysFolder, i);
+        snprintf(path, sizeof(path), "mc%d:/%s", port, aside);
+        if (!blDirExists(path))
+            break;
+    }
+    guiRenderTextScreen(_t("RIPPS2: Setting up BBL 1.20 (putting back what was there)"));
+    blScan(); // waits for the IO worker's own card work to finish first
+    if (!blMcRename(port, blSysFolder, aside)) {
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), _t("The memory card in slot %d would not move BBL 1.20 aside, so nothing was changed. (DIAG.TXT beside RIPPS2 has what the card said.)"), port + 1);
+        ripps2DiagBeforeLaunch();
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    if (!blMcRename(port, backup, blSysFolder)) {
+        blMcRename(port, aside, blSysFolder); // as it was
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), _t("The memory card in slot %d would not take %s back, so BBL 1.20 stayed. (DIAG.TXT beside RIPPS2 has what the card said.)"), port + 1, backup);
+        ripps2DiagBeforeLaunch();
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    guiMsgBoxSound(SFX_SAVE);
+    snprintf(msg, sizeof(msg), _t("Done: the memory card in slot %d starts what it started before BBL 1.20. BBL 1.20 is kept in mc%d:/%s."), port + 1, port, aside);
+    guiMsgBox(msg, 0, NULL);
+}
