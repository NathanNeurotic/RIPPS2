+// build 115 (the user, 10/26 evening: "we should be able to choose our locations before both rips and suggest the host
+// drive which is read first and fastest"): where a rip's AUDIO folder goes. RIPPS2's own folder first (the drive it
+// started from: the boot looks there before anywhere else), then where the sounds load from now, then each started
+// drive's root. A memory card without needKb free is left out, so the music (megabytes) never lands on one. base gets
+// the folder AUDIO goes in (ending in '/'): 1 picked, 0 backed out, -1 nowhere to offer
+static int rbsPickHome(char *base, int size, int needKb)
+{
+    char cand[6][256], items[6][160], tmp[256], room[48];
+    const char *list[6];
+    int n = 0, k, i, pick, freeKb;
+
+    for (k = 0; k < 7 && n < 6; k++) {
+        if (k == 0 ? !oplGetRipps2Dir(tmp, sizeof(tmp)) : k == 1 ? !ripps2AudioBase(tmp, sizeof(tmp), 0) : !bgmMusicHome(k - 2, tmp, sizeof(tmp)))
+            continue;
+        for (i = 0; i < n && strcmp(cand[i], tmp); i++)
+            ;
+        if (i < n || tmp[0] == '\0')
+            continue; // listed already
+        room[0] = '\0';
+        if (!strncmp(tmp, "mc", 2) && tmp[2] >= '0' && tmp[2] <= '1') {
+            freeKb = ripps2CardFreeKb(tmp[2] - '0');
+            if (freeKb < 0 || freeKb < needKb)
+                continue; // no card there, or no room on it
+            snprintf(room, sizeof(room), _t(" (%d KB free)"), freeKb);
+        } else {
+            ripps2_vol_t v;
+            if (ripps2VolInfo(tmp, &v) && v.freeKb > 0) {
+                if ((int)v.freeKb < needKb)
+                    continue;
+                snprintf(room, sizeof(room), _t(" (%u MB free)"), v.freeKb / 1024);
+            }
+        }
+        snprintf(cand[n], sizeof(cand[n]), "%s", tmp);
+        if (k == 0)
+            snprintf(items[n], sizeof(items[n]), _t("BESIDE RIPPS2: %sAUDIO%s, read first at boot"), tmp, room);
+        else
+            snprintf(items[n], sizeof(items[n]), "%sAUDIO%s", tmp, room);
+        list[n] = items[n];
+        n++;
+    }
+    if (n == 0)
+        return -1;
+    if ((pick = ripps2PickList(list, n)) < 0)
+        return 0;
+    snprintf(base, size, "%s", cand[pick]);
+    return 1;
+}
