+// RIPPS2 build 115: Fast Boot just turned on. RIPPS2's own drive starts at boot (Auto); every other drive on Auto waits on
+// Manual, its list shown from the cache, unless Automatic Refresh is on (which starts them at boot as before); the lists
+// are kept and trusted (Fast Cache, Trust Cache); the sounds go beside RIPPS2
+void ripps2FastBootApply(void)
+{
+    char boot[256], msg[400];
+    int fromMmce, fromHdd, fromMass, sounds;
+
+    if (!ripps2GetBootPath(boot, sizeof(boot)))
+        boot[0] = '\0';
+    fromMmce = !strncmp(boot, "mmce", 4);
+    fromHdd = !strncmp(boot, "hdd", 3) || !strncmp(boot, "pfs", 3) || (!strncmp(boot, "mass", 4) && ripps2GetBootBdmType() == BDM_TYPE_ATA);
+    fromMass = !strncmp(boot, "mass", 4) && !fromHdd;
+    gRipps2FastCache = 1;
+    gRipps2TrustCache = 1;
+    if (!gAutoRefresh) {
+        if (gMMCEStartMode == START_MODE_AUTO && !fromMmce)
+            gMMCEStartMode = START_MODE_MANUAL;
+        if (gHDDStartMode == START_MODE_AUTO && !fromHdd)
+            gHDDStartMode = START_MODE_MANUAL;
+        if (gBDMStartMode == START_MODE_AUTO && !fromMass)
+            gBDMStartMode = START_MODE_MANUAL;
+    }
+    if (fromMmce)
+        gMMCEStartMode = START_MODE_AUTO;
+    if (fromHdd)
+        gHDDStartMode = START_MODE_AUTO;
+    if (fromMass)
+        gBDMStartMode = START_MODE_AUTO;
+    sounds = fastBootSounds();
+    snprintf(msg, sizeof(msg),
+             _t("Fast Boot is on. RIPPS2 boots from its own drive (%s): the settings%s and every list from its cache. The other drives start when you press SELECT on their page, or launch one of their games."),
+             boot[0] ? boot : "?", sounds ? _t(", the sounds") : "");
+    guiMsgBoxSound(SFX_SAVE);
+    guiMsgBox(msg, 0, NULL);
+}
