+// ---- the CD player for files (build 115) ----
+// The user, 10/26 evening: "make this a cd player for marked tracks that get opened together or individual cd player
+// like experience from launch disc". Tracks marked in Memory Files and opened together play as a disc, in Launch
+// Disc's CD player panel, over the towers lit by the music; a track opened alone plays there too. Cross plays the picked
+// track (or stops the one playing), Up / Down pick, Left / Right the track before / after, Square stops, Circle closes.
+// Each track plays to its end and the next follows, to the last. A .wav's length comes from its header; an .ogg's and
+// an .mp3's show as they play.
+#define MP_X     60
+#define MP_Y     316
+#define MP_W     520
+#define MP_H     118
+#define MP_ROWS  4
+#define MP_ROW_H 19
+#define MP_LIT   GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define MP_SOFT  GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define MP_DIM   GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define MP_BLUE  GS_SETREG_RGBA(0x5C, 0x98, 0xFF, 0x80)
+#define MP_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+static unsigned int mpWavMs(const char *path) // a PCM .wav's length in ms from its header; 0 when it is not one
+{
+    unsigned char h[12], ck[8], fmt[16];
+    unsigned int byteRate = 0, size;
+    int fd = open(path, O_RDONLY), n;
+
+    if (fd < 0)
+        return 0;
+    if (read(fd, h, 12) != 12 || memcmp(h, "RIFF", 4) || memcmp(h + 8, "WAVE", 4)) {
+        close(fd);
+        return 0;
+    }
+    for (n = 0; n < 32 && read(fd, ck, 8) == 8; n++) {
+        size = ck[4] | (ck[5] << 8) | (ck[6] << 16) | ((unsigned int)ck[7] << 24);
+        if (!memcmp(ck, "fmt ", 4) && size >= 16) {
+            if (read(fd, fmt, 16) != 16)
+                break;
+            byteRate = fmt[8] | (fmt[9] << 8) | (fmt[10] << 16) | ((unsigned int)fmt[11] << 24);
+            lseek(fd, size - 16 + (size & 1), SEEK_CUR);
+        } else if (!memcmp(ck, "data", 4)) {
+            close(fd);
+            return byteRate > 0 ? (unsigned int)((unsigned long long)size * 1000 / byteRate) : 0;
+        } else
+            lseek(fd, size + (size & 1), SEEK_CUR);
+    }
+    close(fd);
+    return 0;
+}
+
+static void mpTime(unsigned int ms, char *out, int size)
+{
+    snprintf(out, size, "%u:%02u", ms / 60000, (ms / 1000) % 60);
+}
+
+static void mpHints(void)
+{
+    static const char *const texts[] = {N_("PLAY"), N_("STOP"), N_("TRACK"), N_("CLOSE")};
+    int icons[4] = {gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, SQUARE_ICON, RIGHT_ICON,
+                    gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON};
+    int i, w = 0, gap = 18, x;
+    for (i = 0; i < 4; i++)
+        w += 24 + ripps2HintWidth(texts[i]);
+    x = (640 - (w + gap * 3)) / 2;
+    for (i = 0; i < 4; i++) {
+        GSTEXTURE *t = icons[i] == RIGHT_ICON ? NULL : thmGetTexture(icons[i]);
+        if (icons[i] == RIGHT_ICON) { // Left / Right: two arrowheads, as the disc's player draws them
+            u64 c = MP_PRIM(0x80, 0x80, 0x80, 0x80);
+            rmDrawQuadGouraud(x + 1, 448, c, x + 8, 441, c, x + 1, 448, c, x + 8, 455, c);
+            rmDrawQuadGouraud(x + 19, 448, c, x + 12, 441, c, x + 19, 448, c, x + 12, 455, c);
+        } else if (t != NULL)
+            rmDrawPixmap(t, x, 438, ALIGN_NONE, 20, 20, SCALING_RATIO, MP_LIT, 0);
+        x += 24;
+        x = ripps2HintText(x, 448, texts[i], MP_SOFT) + gap;
+    }
+}
+
+void ripps2PlayMusicList(char (*paths)[256], int n, int start)
+{
+    unsigned int *len;
+    int sel = start, top = 0, playing = -1, i, confirm = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS;
+    int rowFont = gTheme->fonts[8], uiFont = gTheme->fonts[4], small = gTheme->fonts[5];
+    char buf[96], tl[16];
+
+    if (n <= 0)
+        return;
+    if ((len = calloc(n, sizeof(unsigned int))) == NULL)
+        return;
+    for (i = 0; i < n; i++)
+        len[i] = mpWavMs(paths[i]);
+    if (sel < 0 || sel >= n)
+        sel = 0;
+    if (bgmPlayFileOnce(paths[sel]) == 0) {
+        playing = sel;
+        ripps2PillarMusic(1);
+    } else {
+        guiMsgBox(_t("This track could not be played. RIPPS2 plays 16-bit PCM .wav files (as RIPDISC and BIOS Music rip "
+                     "them), Ogg Vorbis .ogg files and MP3s."),
+                  0, NULL);
+        bgmPlayFileStop();
+        if (gEnableBGM && !isBgmPlaying())
+            bgmStart();
+        free(len);
+        return;
+    }
+    readPads();
+    for (;;) {
+        unsigned int ms = playing >= 0 ? bgmPlayedMs() : 0;
+        // a track played to its end: the next one, to the last
+        if (playing >= 0 && !isBgmPlaying()) {
+            if (playing + 1 < n && bgmPlayFileOnce(paths[playing + 1]) == 0)
+                sel = ++playing;
+            else {
+                playing = -1;
+                ripps2PillarMusic(0);
+            }
+            ms = 0;
+        }
+
+        guiStartFrame();
+        ripps2DrawPillars();
+        ripps2DrawPanelGlass(MP_X, MP_Y, MP_W, MP_H, 0);
+        fntRenderString(uiFont, MP_X + 18, MP_Y + 18, ALIGN_VCENTER, 0, 0, _t("MUSIC"), MP_LIT);
+        snprintf(buf, sizeof(buf), _t("%d TRACKS"), n);
+        fntRenderString(small, MP_X + 18 + fntCalcDimensions(uiFont, _t("MUSIC")) + 12, MP_Y + 18, ALIGN_VCENTER, 0, 0, buf, MP_DIM);
+        rmDrawLine(MP_X + 14, MP_Y + 32, MP_X + MP_W - 14, MP_Y + 32, MP_PRIM(0x4A, 0x72, 0xDC, 0x60));
+        if (sel < top)
+            top = sel;
+        if (sel >= top + MP_ROWS)
+            top = sel - MP_ROWS + 1;
+        for (i = 0; i < MP_ROWS && top + i < n; i++) {
+            int t = top + i, y = MP_Y + 48 + i * MP_ROW_H;
+            const char *name = strrchr(paths[t], '/');
+            u64 col = t == playing ? MP_BLUE : (t == sel ? MP_LIT : MP_SOFT);
+            name = name != NULL ? name + 1 : paths[t];
+            if (t == sel)
+                rmDrawRect(MP_X + 12, y - 9, 236, 18, MP_PRIM(0x2A, 0x4C, 0xA0, 0x40));
+            snprintf(buf, sizeof(buf), "%02d", t + 1);
+            fntRenderString(rowFont, MP_X + 22, y, ALIGN_VCENTER, 0, 0, buf, col);
+            if (len[t] > 0)
+                mpTime(len[t], tl, sizeof(tl));
+            else
+                snprintf(tl, sizeof(tl), "--:--");
+            int lw = fntCalcDimensions(rowFont, tl);
+            fntRenderStringFit(rowFont, MP_X + 50, y, ALIGN_VCENTER, 190 - lw, name, col, 0);
+            fntRenderString(rowFont, MP_X + 240 - lw, y, ALIGN_VCENTER, 0, 0, tl, col);
+        }
+        // what is playing
+        {
+            int rx = MP_X + 276, track = playing >= 0 ? playing : sel;
+            unsigned int length = len[track];
+            snprintf(buf, sizeof(buf), _t("TRACK %02d"), track + 1);
+            fntRenderString(gTheme->fonts[11], rx, MP_Y + 52, ALIGN_VCENTER, 0, 0, buf, MP_LIT);
+            mpTime(ms, buf, sizeof(buf));
+            if (length > 0)
+                mpTime(length, tl, sizeof(tl));
+            else
+                snprintf(tl, sizeof(tl), "--:--");
+            strcat(buf, " / ");
+            strcat(buf, tl);
+            fntRenderString(uiFont, rx, MP_Y + 76, ALIGN_VCENTER, 0, 0, buf, MP_SOFT);
+            rmDrawRect(rx, MP_Y + 90, 216, 4, MP_PRIM(0x03, 0x08, 0x22, 0x80));
+            if (length > 0 && playing >= 0)
+                rmDrawRect(rx, MP_Y + 90, (int)(216.0f * (ms > length ? 1.0f : (float)ms / (float)length)), 4, MP_PRIM(0x4A, 0x8C, 0xF0, 0x80));
+            fntRenderString(small, rx, MP_Y + 106, ALIGN_VCENTER, 0, 0, playing >= 0 ? _t("PLAYING") : _t("STOPPED"),
+                            playing >= 0 ? MP_BLUE : MP_SOFT);
+        }
+        mpHints();
+        guiEndFrame();
+
+        readPads();
+        if (getKeyOn(guiCancelKey()) || getKeyOn(KEY_START)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+        if (getKeyOn(confirm)) {
+            if (playing == sel) { // the one playing stops
+                if (isBgmPlaying())
+                    bgmStop(); // the track stops; the menu music stays away until the player closes
+                playing = -1;
+                ripps2PillarMusic(0);
+            } else if (bgmPlayFileOnce(paths[sel]) == 0) {
+                playing = sel;
+                ripps2PillarMusic(1);
+            }
+        } else if (getKeyOn(KEY_SQUARE)) {
+            if (playing >= 0) {
+                sfxPlay(SFX_CANCEL);
+                if (isBgmPlaying())
+                    bgmStop(); // the track stops; the menu music stays away until the player closes
+                playing = -1;
+                ripps2PillarMusic(0);
+            }
+        } else if (getKey(KEY_UP)) {
+            if (sel > 0) {
+                sfxPlay(SFX_CURSOR);
+                sel--;
+            }
+        } else if (getKey(KEY_DOWN)) {
+            if (sel < n - 1) {
+                sfxPlay(SFX_CURSOR);
+                sel++;
+            }
+        } else if (getKeyOn(KEY_LEFT) || getKeyOn(KEY_RIGHT)) {
+            int from = playing >= 0 ? playing : sel, to = getKeyOn(KEY_RIGHT) ? from + 1 : (playing >= 0 && ms > 3000 ? from : from - 1);
+            if (to >= 0 && to < n) {
+                sfxPlay(SFX_CURSOR);
+                sel = to;
+                if (playing >= 0 && bgmPlayFileOnce(paths[sel]) == 0)
+                    playing = sel;
+            }
+        }
+    }
+    ripps2PillarMusic(0);
+    bgmPlayFileStop();
+    if (gEnableBGM && !isBgmPlaying())
+        bgmStart();
+    free(len);
+    readPads();
+}
+
+// ---- music (build 115) ----
+// A .wav (16-bit PCM, as RIPDISC and the BIOS Music rip write them), an .ogg or an .mp3 plays in the menu music's place, at full
