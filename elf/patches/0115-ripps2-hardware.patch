+static int sysNeutrinoHas(const char *dir, char sep, const char *file)
+{
+    char path[320];
+    int fd;
+    if (snprintf(path, sizeof(path), "%.256sconfig%c%.40s", dir, sep, file) >= (int)sizeof(path))
+        return 0;
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return 0;
+    close(fd);
+    return 1;
