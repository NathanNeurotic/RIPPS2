diff --git a/.github/scripts/test_neutrino_external.py b/.github/scripts/test_neutrino_external.py
new file mode 100644
index 0000000..258523c
--- /dev/null
+++ b/.github/scripts/test_neutrino_external.py
@@ -0,0 +1,178 @@
+"""RIPPS2 build 115: a Neutrino RIPPS2 did not install (XEB+'s, an older kit) gets only the options it knows, and a
+game opened after Neutrino's own IOP reset is named the way Neutrino names it then.
+
+Compiles the real reader and path rule from src/system.c (the block from the sysLastPathSeparator declaration to the
+-bsdfs helper) and runs them on synthetic Neutrino installs, each a folder with neutrino.elf:
+  - kits with version.txt (every kit since 1.6.1): 1.6.1 (no -dbc), the 1.8.0 development build;
+  - an unpacked ELF, its option strings as each tag's loader parses them (rickgaiser/neutrino ee/loader main.c);
+  - older kits known by their config files (1.5: bsd-mmce.toml, 1.3/1.4: bsdfs-*.toml, 1.2: rc-uya.toml);
+  - a packed ELF with nothing else to go on, and a missing one: every option, as before.
+Then checks the wiring in sysNeutrinoPreflight and sysRunNeutrinoLaunch.
+"""
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'src/system.c').read_text(encoding='utf-8').replace('\r\n', '\n')
+fails = []
+
+probe = source[source.index('#define NF_CFG'):source.index('// The -bsdfs Neutrino will actually run with')]
+
+program = r'''
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#define LOG(...) ((void)0)
+#ifdef _WIN32 /* a Windows run: binary reads (text mode stops at 0x1a); the PS2 has no text mode */
+#define open(p, f) open((p), (f) | O_BINARY)
+#endif
+@PROBE@
+static int fails;
+static char kit[512];
+static const char *at(const char *base, const char *name)
+{
+    snprintf(kit, sizeof(kit), "%s/%s/neutrino.elf", base, name);
+    sysNeutrinoReadFlags(kit);
+    return kit;
+}
+static void takes(unsigned int bit, int want, const char *what)
+{
+    if (sysNeutrinoTakes(kit, bit) != want) { printf("FAIL %s\n", what); fails++; }
+}
+static void version(const char *want, const char *what)
+{
+    if (strcmp(sysNeutrinoVersionOf(kit), want)) { printf("FAIL %s: '%s', want '%s'\n", what, sysNeutrinoVersionOf(kit), want); fails++; }
+}
+static void unit(const char *in, const char *want)
+{
+    char a[96];
+    snprintf(a, sizeof(a), "%s", in);
+    sysNeutrinoUnitZero(a);
+    if (strcmp(a, want)) { printf("FAIL unit zero: %s -> %s, want %s\n", in, a, want); fails++; }
+}
+int main(int argc, char **argv)
+{
+    const char *b = argv[1];
+    (void)argc;
+    at(b, "v161");
+    version("v1.6.1", "1.6.1 from version.txt");
+    takes(NF_GSM | NF_CWD | NF_QB | NF_BSDFS, 1, "1.6.1 has -gsm -cwd -qb -bsdfs");
+    takes(NF_DBC, 0, "1.6.1 has no -dbc");
+    at(b, "dev");
+    version("v1.8.0-61-g7be8de2", "the development build from version.txt");
+    takes(NF_ALL, 1, "the development build takes everything");
+    at(b, "unpacked131");
+    takes(NF_BSDFS | NF_ELF | NF_CFG, 1, "an unpacked 1.3.1 has -bsdfs -elf -cfg");
+    takes(NF_CWD, 0, "an unpacked 1.3.1 has no -cwd");
+    takes(NF_QB, 0, "an unpacked 1.3.1 has no -qb (its usage text naming it does not count)");
+    version("", "an unpacked 1.3.1 has no tag");
+    at(b, "unpacked180");
+    version("v1.8.0", "an unpacked 1.8.0 keeps its tag");
+    at(b, "kit15");
+    version("1.5", "a 1.5 kit by its config files");
+    takes(NF_GSM | NF_QB | NF_CWD, 1, "1.5 has -gsm -qb -cwd");
+    takes(NF_DBC, 0, "1.5 has no -dbc");
+    at(b, "kit13");
+    version("1.3 or 1.4", "a 1.3/1.4 kit by its config files");
+    takes(NF_BSDFS | NF_CFG | NF_LOGO, 1, "1.3 has -bsdfs -cfg -logo");
+    takes(NF_CWD, 0, "1.3 or 1.4 is taken as 1.3: no -cwd");
+    takes(NF_QB, 0, "1.3 or 1.4 is taken as 1.3: no -qb");
+    at(b, "kit12");
+    version("1.2", "a 1.2 kit by its config files");
+    takes(NF_BSDFS, 0, "1.2 has no -bsdfs");
+    takes(NF_LOGO, 1, "1.2 has -logo");
+    at(b, "packed");
+    takes(NF_ALL, 1, "a packed ELF with nothing else to go on is taken to know everything");
+    at(b, "none");
+    takes(NF_ALL, 1, "a missing ELF is taken to know everything");
+    if (sysNeutrinoTakes("mass0:/other/neutrino.elf", NF_GSM) != 1) { puts("FAIL a Neutrino not read is taken to know everything"); fails++; }
+    unit("-dvd=mass1:/DVD/Game.iso", "-dvd=mass:/DVD/Game.iso");
+    unit("-dvd=mass12:DVD/Game.iso", "-dvd=mass:DVD/Game.iso");
+    unit("-mc0=mass3:/VMC/slot.bin", "-mc0=mass:/VMC/slot.bin");
+    unit("-dvd=mass:/DVD/Game.iso", "-dvd=mass:/DVD/Game.iso");
+    unit("-dvd=hdl:Game", "-dvd=hdl:Game");
+    unit("-dvd=mmce0:/DVD/Game.iso", "-dvd=mmce0:/DVD/Game.iso");
+    unit("-dvd=bdfs:ata0p0", "-dvd=bdfs:ata0p0");
+    unit("-dvd=massive:/x", "-dvd=massive:/x");
+    if (!fails) puts("Neutrino by version.txt, its strings or its config files; packed and missing ones; mass: after the IOP reset OK");
+    return fails != 0;
+}
+'''
+
+# What each tag's loader parses (from its main.c), as NUL-ended strings among other bytes
+TAGS = {
+    'v1.3.1': ['-bsd=', '-bsdfs=', '-dvd=', '-ata0=', '-ata0id=', '-ata1=', '-mc0=', '-mc1=', '-elf=', '-gc=', '-mt=',
+               '-cfg=', '-dbc', '-logo'],
+    'v1.8.0': ['-bsd=', '-bsdfs=', '-dvd=', '-ata0=', '-ata0id=', '-ata1=', '-mc0=', '-mc1=', '-elf=', '-gc=', '-gsm=',
+               '-cfg=', '-cwd=', '-dbc', '-logo', '-qb', '- Version: %s\n', 'v1.8.0'],
+}
+PACKED = b'\x7fELF' + bytes((i * 37) & 0xff for i in range(200000))
+
+
+def unpacked(strings, pad=40000):
+    blob = bytearray(b'\x7fELF' + bytes(range(256)) * 10)
+    for i, s in enumerate(strings):
+        blob += b'\0' + s.encode() + b'\0' + bytes([i]) * (pad // max(1, len(strings)))
+    # usage text names options too, without the NUL straight after: it must not count
+    blob += b'\0  -qb               Quick-Boot directly into load environment\n'
+    return bytes(blob)
+
+
+KITS = {  # folder: (neutrino.elf, version.txt or None, config files)
+    'v161': (PACKED, 'v1.6.1\n', ['bsd-mmce.toml', 'bsdfs-exfat.toml']),
+    'dev': (PACKED, 'v1.8.0-61-g7be8de2\r\n', ['bsd-udpfs.toml', 'compat.toml']),
+    'unpacked131': (unpacked(TAGS['v1.3.1']), None, []),
+    'unpacked180': (unpacked(TAGS['v1.8.0']), None, []),
+    'kit15': (PACKED, None, ['bsd-mmce.toml', 'bsdfs-exfat.toml', 'bsd-usb.toml']),
+    'kit13': (PACKED, None, ['bsdfs-exfat.toml', 'bsdfs-hdl.toml', 'bsd-usb.toml', 'rc-uya.toml']),
