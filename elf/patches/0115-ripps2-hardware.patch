+        busy = 0;
+        busySince = 0;
+        return 0;
+    }
+    if (busySince == 0)
+        busySince = now;
+    busy = (now - busySince) < (clock_t)MMCE_BUSY_GIVEUP_S * CLOCKS_PER_SEC;
