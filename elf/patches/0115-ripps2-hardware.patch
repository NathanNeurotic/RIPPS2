+// RIPPS2 build 115: the other names a piece of a game's art goes by, for a path in an ART folder,
+// "<dir>/ART/<key>_<kind>". Writes them to out in the order they are tried and returns how many.
+//   - OPL Manager's kinds: its art database calls a background _BG_00 (to _BG_06) and the screenshots _SCR_00 and
+//     _SCR_01, where RIPPS2's themes ask for _BG, _SCR and _SCR2; a theme made for those names asks the other way.
+//   - A PS1 game's other keys (listedKeys: only where the folder's listing makes a miss free): the disc ID at the
+//     front of a file named "SLUS_005.94.Title", the ID RIPPS2 has already read off the disc, and the POPStarter
+//     launcher's name XX.<key>.ELF, which is how OPL draws a PS1 game set up as an app.
+#define TEX_ART_ALIASES 7
+static int texArtAliases(const char *path, int listedKeys, char out[TEX_ART_ALIASES][256])
+{
+    static const char *const kinds[] = {"SCR_00", "SCR_01", "BG_00", "COV2", "SCR2", "COV", "ICO", "LAB", "LGO", "SCR", "BG"};
+    static const char *const swap[][2] = {{"BG", "BG_00"}, {"SCR", "SCR_00"}, {"SCR2", "SCR_01"}};
+    const char *base = strrchr(path, '/'), *kind = NULL, *altKind = NULL;
+    char key[160], keys[4][160];
+    int i, k, nKeys = 0, n = 0;
+    size_t baseLen, keyLen;
+
+    if (base == NULL || base - path < 3 || strncasecmp(base - 3, "ART", 3) != 0 ||
+        (base - path > 3 && base[-4] != '/' && base[-4] != ':'))
+        return 0; // not an ART folder: theme files keep their one name
+    base++;
+    baseLen = strlen(base);
+    for (i = 0; i < (int)(sizeof(kinds) / sizeof(kinds[0])) && kind == NULL; i++) {
+        size_t kl = strlen(kinds[i]);
+        if (baseLen > kl + 1 && base[baseLen - kl - 1] == '_' && !strcmp(&base[baseLen - kl], kinds[i]))
+            kind = kinds[i];
+    }
+    if (kind == NULL)
+        return 0;
+    keyLen = baseLen - strlen(kind) - 1;
+    if (keyLen >= sizeof(key))
+        return 0;
+    memcpy(key, base, keyLen);
+    key[keyLen] = '\0';
+    for (i = 0; i < (int)(sizeof(swap) / sizeof(swap[0])); i++)
+        for (k = 0; k < 2; k++)
+            if (!strcmp(kind, swap[i][k]))
+                altKind = swap[i][!k];
+
+    memcpy(keys[nKeys++], key, keyLen + 1);
+    if (listedKeys) {
+        char id[VCD_ID_MAX];
+        if (vcdExtractGameId(key, id, sizeof(id)) && strcasecmp(id, key))
+            memcpy(keys[nKeys++], id, strlen(id) + 1);
+        if (vcdDisplayIdCached(key, id, sizeof(id)) && strcasecmp(id, key) && (nKeys < 2 || strcasecmp(id, keys[1])))
+            memcpy(keys[nKeys++], id, strlen(id) + 1);
+        if (!(keyLen == 11 && key[4] == '_' && key[8] == '.') && (keyLen < 4 || strcasecmp(&key[keyLen - 4], ".ELF")) &&
+            snprintf(keys[nKeys], sizeof(keys[0]), "XX.%s.ELF", key) < (int)sizeof(keys[0]))
+            nKeys++;
+    }
+
+    for (i = 0; i < nKeys && n < TEX_ART_ALIASES; i++) {
+        if (i > 0 && snprintf(out[n], 256, "%.*s%s_%s", (int)(base - path), path, keys[i], kind) < 256)
+            n++; // a name too long for a path is skipped, never tried cut short
+        if (altKind != NULL && n < TEX_ART_ALIASES && snprintf(out[n], 256, "%.*s%s_%s", (int)(base - path), path, keys[i], altKind) < 256)
+            n++;
+    }
+    return n;
+}
