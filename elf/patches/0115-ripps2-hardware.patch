+// RIPPS2 build 115: Fast Boot's sounds. Every .adp of the AUDIO folder they load from now (and README.txt) is copied into
+// the AUDIO beside RIPPS2, and the music picked when RIPPS2's drive is not a memory card; from then on they load from
+// there. A memory card without the room keeps them where they are. 1 when they are beside RIPPS2 now
+static int fastBootSounds(void)
+{
+    char own[256], base[256], from[300], to[300], src[400], dst[400], music[320];
+    long long need = 0;
+    struct stat st;
+    struct dirent *e;
+    DIR *d;
+    int copied = 0, n;
+
+    if (!oplGetRipps2Dir(own, sizeof(own) - 8) || !ripps2AudioBase(base, sizeof(base) - 8, 0))
+        return 0;
+    if (!strcmp(own, base))
+        return 1; // there already
+    snprintf(from, sizeof(from), "%sAUDIO", base);
+    snprintf(to, sizeof(to), "%sAUDIO", own);
+    if ((d = opendir(from)) == NULL)
+        return 0;
+    while ((e = readdir(d)) != NULL) { // the room they take
+        n = strlen(e->d_name);
+        if (n > 4 && !strcasecmp(e->d_name + n - 4, ".adp")) {
+            snprintf(src, sizeof(src), "%s/%s", from, e->d_name);
+            if (stat(src, &st) == 0)
+                need += st.st_size;
+        }
+    }
+    closedir(d);
+    if (!strncmp(own, "mc", 2) && own[2] >= '0' && own[2] <= '1') {
+        int freeKb = ripps2CardFreeKb(own[2] - '0');
+        if (freeKb >= 0 && freeKb < (int)(need / 1024) + 64) {
+            char msg[300];
+            snprintf(msg, sizeof(msg), _t("Fast Boot is on. The sounds take %d KB and the memory card RIPPS2 runs from has %d KB free, so they stay in %s."),
+                     (int)(need / 1024), freeKb, from);
+            guiMsgBox(msg, 0, NULL);
+            return 0;
+        }
+    }
+    mkdir(to, 0777);
+    if ((d = opendir(from)) == NULL)
+        return 0;
+    while ((e = readdir(d)) != NULL) {
+        n = strlen(e->d_name);
+        if (n <= 4 || (strcasecmp(e->d_name + n - 4, ".adp") && strcasecmp(e->d_name, "README.txt")))
+            continue;
+        snprintf(src, sizeof(src), "%s/%s", from, e->d_name);
+        snprintf(dst, sizeof(dst), "%s/%s", to, e->d_name);
+        if (ripps2CopyFile != NULL && ripps2CopyFile(src, dst, e->d_name))
+            copied++;
+    }
+    closedir(d);
+    // the picked track too, when RIPPS2's drive is not a memory card
+    if (strncmp(own, "mc", 2) && bgmMusicCurrent(music, sizeof(music)) && strncmp(music, own, strlen(own))) {
+        const char *name = strrchr(music, '/');
+        name = name != NULL ? name + 1 : music;
+        snprintf(dst, sizeof(dst), "%s/%s", to, name);
+        if (ripps2CopyFile != NULL && ripps2CopyFile(music, dst, name)) {
+            ripps2AudioBaseSet(own);
+            bgmMusicPickPath(dst);
+        }
+    }
+    ripps2AudioBaseSet(own);
+    ripps2Diag("fast boot: %d sounds copied from %s to %s", copied, from, to);
+    return copied > 0;
+}
