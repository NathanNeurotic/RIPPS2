+// ---- build 115: the hardware log (include/ripps2diag.h) ----
+#define DIAG_SIZE (24 * 1024)
+static char diagRing[DIAG_SIZE];
+static int diagHead = 0, diagWrapped = 0;
+
+void ripps2Diag(const char *fmt, ...)
+{
+    char line[224];
+    va_list ap;
+    clock_t now = clock();
+    int n, i;
+
+    n = snprintf(line, sizeof(line), "%5d.%02d  ", (int)(now / CLOCKS_PER_SEC), (int)(now % CLOCKS_PER_SEC * 100 / CLOCKS_PER_SEC));
+    va_start(ap, fmt);
+    vsnprintf(line + n, sizeof(line) - n - 2, fmt, ap);
+    va_end(ap);
+    n = strlen(line);
+    line[n++] = '\r';
+    line[n++] = '\n';
+    DI();
+    for (i = 0; i < n; i++) {
+        diagRing[diagHead++] = line[i];
+        if (diagHead == DIAG_SIZE) {
+            diagHead = 0;
+            diagWrapped = 1;
+        }
+    }
+    EI();
+}
+
+int ripps2DiagSave(const char *dir, char *path, int pathSize)
+{
+    static char copy[DIAG_SIZE];
+    char base[256], head[400];
+    u32 notReady = 0, empty = 0;
+    int len, fd, ok, h, w;
+
+    if (dir == NULL) {
+        if (!oplGetRipps2Dir(base, sizeof(base)))
+            snprintf(base, sizeof(base), "mc0:/RIPPS2/");
+        dir = base;
+    }
+    snprintf(path, pathSize, "%sDIAG.TXT", dir);
+    DI();
+    h = diagHead;
+    w = diagWrapped;
+    if (w) {
+        memcpy(copy, diagRing + h, DIAG_SIZE - h);
+        memcpy(copy + DIAG_SIZE - h, diagRing, h);
+        len = DIAG_SIZE;
+    } else {
+        memcpy(copy, diagRing, h);
+        len = h;
+    }
+    EI();
+    padGetFaultCounters(&notReady, &empty);
+    snprintf(head, sizeof(head),
+             "RIPPS2 build %d diagnostics, %d s after boot\r\nlongest run of missed pad reads: %u polls; of empty reads: %u polls\r\n"
+             "MMCE: Game ID %s, slot setting %d\r\n%s\r\n\r\n",
+             RIPPS2_BUILD, (int)(clock() / CLOCKS_PER_SEC), (unsigned)notReady, (unsigned)empty, gMMCEEnableGameID ? "on" : "off",
+             gMMCESlot, w ? "(the oldest lines have rolled out of the log)" : "");
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)
+        return 0;
+    ok = write(fd, head, strlen(head)) == (int)strlen(head) && write(fd, copy, len) == len;
+    close(fd);
+    return ok;
+}
+
+void ripps2DiagBeforeLaunch(void)
+{
+    char base[256], path[300];
+    if (!oplGetRipps2Dir(base, sizeof(base)) || !strncmp(base, "mc", 2))
+        return;
+    ripps2DiagSave(base, path, sizeof(path));
+}
+
+void ripps2StatusFromCache(void)
+{
+    stFromCache = 1;
+    ripps2Status();
+    stFromCache = 0;
+}
