+            best = name;
+    }
+
+    if (best != NULL) {
+        if (snprintf(out, outSize, "%s/%s", dir, best) >= outSize)
+            return -1;
+        return 1;
+    }
+
+    // As in artIndexMayExist: an invalidation mid-search downgrades "absent" to "go and look".
+    if (gArtIndexGen != genBefore)
