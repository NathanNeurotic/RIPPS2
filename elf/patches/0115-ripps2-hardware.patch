+// RIPPS2 build 115: 1 while the card says it is busy: copying a memory card into its RAM (every power-on; 8 MB took ~9 s
+// on the user's SD, in 30 ms slices that hold each MMCE request back) or writing a new one for a game. One short status
+// exchange, asked at most every 250 ms; a card busy past MMCE_BUSY_GIVEUP_S is read anyway, as before this check.
+#define MMCE_BUSY_GIVEUP_S 90
+int mmceCardBusy(void)
+{
+    static clock_t askedAt = 0, busySince = 0;
+    static int busy = 0;
+    char root[sizeof(mmcePrefix)];
+    clock_t now = clock();
+    int status;
+
+    if (!mmceModLoaded)
+        return 0;
+    if (askedAt != 0 && now - askedAt < CLOCKS_PER_SEC / 4)
+        return busy;
+    askedAt = now;
+    mmceGetDeviceRoot(root, sizeof(root));
+    status = root[0] != '\0' ? fileXioDevctl(root, 0x2, NULL, 0, NULL, 0) : -1;
