+/* RIPPS2 build 115 (the user, 10/26: "add mp3 decoder"): an MP3, decoded with minimp3 (lieff, CC0 1.0, unchanged in
+   thirdparty/minimp3) a frame at a time in the decoder thread and handed on as 48 kHz stereo, the .wav way (the same
+   interpolation between the two nearest frames), round and round. An ID3v2 tag at the front (cover pictures and all) is
+   passed over whole; whatever else is not an MP3 frame minimp3 skips by itself. */
+#define MINIMP3_IMPLEMENTATION
+#define MINIMP3_ONLY_MP3
+#define MINIMP3_NO_SIMD
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#pragma GCC diagnostic ignored "-Wunused-function"
+#pragma GCC diagnostic ignored "-Wshadow"
+#pragma GCC diagnostic ignored "-Wdouble-promotion"
+#include "thirdparty/minimp3/minimp3.h"
