diff --git a/include/ripps2diag.h b/include/ripps2diag.h
new file mode 100644
index 0000000..42b838a
--- /dev/null
+++ b/include/ripps2diag.h
@@ -0,0 +1,21 @@
+#ifndef __RIPPS2DIAG_H
+#define __RIPPS2DIAG_H
+
+/*
+  RIPPS2 build 115: the hardware log. A release build has no console output, and a console run cannot be watched from a
+  PC, so what matters on hardware (pad reads that missed, an MMCE card's busy spells, a Game ID switch and its wait, art
+  reads that took long, each launch's steps) goes into a small ring in RAM, time-stamped. STATUS > SAVE DIAGNOSTICS
+  writes it to DIAG.TXT beside RIPPS2, and an MMCE launch writes it there by itself when RIPPS2 is not on a memory card,
+  so a launch that hangs still leaves its steps behind. Safe from any thread.
+*/
+
+void ripps2Diag(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+// DIAG.TXT in dir (RIPPS2's own folder when NULL); 1 when written, the file's path in path
+int ripps2DiagSave(const char *dir, char *path, int pathSize);
+
+// before a launch from an MMCE card: written beside RIPPS2 unless that is a memory card (a card write just before the
+// card switches would be one more thing for the switch to wait on)
+void ripps2DiagBeforeLaunch(void);
+
+#endif
