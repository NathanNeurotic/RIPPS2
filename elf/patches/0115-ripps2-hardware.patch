+                break;
+            }
+        }
+    }
+    sysNeutrinoFlagSet = flags;
+    LOG("[NEUTRINO] %s: %s, options 0x%03x (its config files)\n", neutrinoPath, sysNeutrinoVersion[0] ? sysNeutrinoVersion : "unknown", flags);
+}
