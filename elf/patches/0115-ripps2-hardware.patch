+// RIPPS2 build 115: where the in-game menu's EXIT goes. An empty IGR Path (the default) is back to this RIPPS2, where it
+// was started, when the IGR can reach that (a memory card or USB; ripps2BootLockIgrPath), else the PS2 browser as
+// before; "Browser" typed in is the browser. A memory-card path that names no file is passed over for RIPPS2's own:
+// the user's console kept exit_path=mc1:/APPS/RIPPS2.elf from an older set-up, an EXIT that went nowhere, while RIPPS2
+// itself was at mc0:/RIPPS2/RIPPS2.ELF (10/25). That is checked while the boot card is in (after the settings load,
+// and when the IGR Path is set), never at a launch: an SD2PSX may have switched to the game's own card by then.
+static int exitStale = 0;
+
+void ripps2ExitPathCheck(void)
+{
+    struct stat st;
+    exitStale = (!strncmp(gExitPath, "mc0:", 4) || !strncmp(gExitPath, "mc1:", 4)) && stat(gExitPath, &st) != 0;
+    if (exitStale)
+        LOG("RIPPS2: the IGR Path %s is not there; EXIT goes back to RIPPS2 instead\n", gExitPath);
+}
+
+const char *ripps2ExitPath(char *buf, int size)
+{
+    if (!strcmp(gExitPath, "Browser"))
+        return "Browser";
+    if (gExitPath[0] != '\0' && !exitStale)
+        return gExitPath;
+    if (ripps2BootLockIgrPath(buf, size))
+        return buf;
+    return "Browser";
+}
