+    snprintf(sysNeutrinoFlagsFor, sizeof(sysNeutrinoFlagsFor), "%s", neutrinoPath);
+    sysNeutrinoFlagSet = NF_ALL;
+    sysNeutrinoVersion[0] = '\0';
+    if (slash == NULL || slash - neutrinoPath + 1 >= (int)sizeof(dir) - 16)
+        return;
+    snprintf(dir, sizeof(dir), "%.*s", (int)(slash - neutrinoPath) + 1, neutrinoPath);
+
+    snprintf(path, sizeof(path), "%sversion.txt", dir);
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        n = read(fd, line, sizeof(line) - 1);
+        close(fd);
+        line[n > 0 ? n : 0] = '\0';
+        line[strcspn(line, "\r\n \t")] = '\0';
+        if (sscanf(line[0] == 'v' ? line + 1 : line, "%d.%d", &major, &minor) == 2) {
+            snprintf(sysNeutrinoVersion, sizeof(sysNeutrinoVersion), "%s", line);
+            sysNeutrinoFlagSet = sysNeutrinoFlagsOf(major, minor);
+            LOG("[NEUTRINO] %s: %s (version.txt), options 0x%03x\n", neutrinoPath, line, sysNeutrinoFlagSet);
+            return;
+        }
+    }
+    if (sysNeutrinoProbeElf(neutrinoPath, &flags)) {
+        sysNeutrinoFlagSet = flags;
+        LOG("[NEUTRINO] %s: %s, options 0x%03x (its strings)\n", neutrinoPath, sysNeutrinoVersion[0] ? sysNeutrinoVersion : "no tag", flags);
+        return;
+    }
