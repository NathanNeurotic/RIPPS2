+#define MP3_IN_SIZE 16384 // the file read ahead: several frames at any bitrate
+static FILE *mp3File = NULL;
+static mp3dec_t *mp3Dec = NULL;
+static unsigned char *mp3In = NULL;
+static short *mp3Pcm = NULL; // one frame's samples, as minimp3 gives them
