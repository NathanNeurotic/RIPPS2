diff --git a/src/ripps2ui.c b/src/ripps2ui.c
index 39ca408..a623099 100644
--- a/src/ripps2ui.c
+++ b/src/ripps2ui.c
@@ -1163,6 +1163,8 @@ static u64 withAlpha(u64 c, int a)
 // the game's own disc art (ICO), else RIPPS2's disc (a theme's launch_disc.png). pop: it arrives the way the
 // L3 logos do (a touch large, settling, with a glow), holds and fades. spin: it arrives the same way, then
 // turns, faster and faster up to a cap, and never fades: it is still turning when the game takes the screen.
+// Build 122 (the user, 10/28): zoom: it arrives the same way, holds a moment, then grows (eased in and out) to a size
+// that reads clearly and stays on that last frame, as spin does, until the game takes the screen.
 #define DISC_SIZE   150
 #define DISC_Y      228   // the view word's line
 #define DISC_IN_S   0.40f
@@ -1171,6 +1173,9 @@ static u64 withAlpha(u64 c, int a)
 #define DISC_REV0   0.25f // turns a second as it lands
 #define DISC_RAMP   0.90f // and faster by this, each second
 #define DISC_REVMAX 2.20f // the cap: past this a 50 Hz picture strobes the turn
+#define DISC_ZOOM_AT (DISC_IN_S + 0.35f) // zoom: Pop In's arrival and a short hold, then
+#define DISC_ZOOM_S  0.90f               // the eased zoom up to
+#define DISC_ZOOM_TO 1.85f               // this size, held until the game takes the screen
 #define DISC_ICO_WAIT 500 // art worker ticks to wait for it to let go before the ICO is read
 int gRipps2LaunchDisc = 0;
 static GSTEXTURE launchIco;
@@ -1181,7 +1186,7 @@ int ripps2LaunchDiscMode(void)
 {
     if (gRipps2LaunchDisc == 1)
         return 0;
-    if (gRipps2LaunchDisc >= 2 && gRipps2LaunchDisc <= 3)
+    if (gRipps2LaunchDisc >= 2 && gRipps2LaunchDisc <= 4) // Pop In, Spin, build 122: Zoom
         return gRipps2LaunchDisc - 1;
     return gTheme != NULL ? gTheme->launchDiscDef : 0;
 }
@@ -1257,6 +1262,11 @@ int ripps2DrawLaunchDisc(void)
     }
     float li = t < DISC_IN_S ? t / DISC_IN_S : 1.0f;
     float s = (1.0f + 0.16f * (1.0f - easeOutBack(li))) * (1.0f + 0.10f * out);
+    if (launchMode == 3 && t > DISC_ZOOM_AT) { // build 122: the zoom, eased in and out, then held
+        float u = fminf(1.0f, (t - DISC_ZOOM_AT) / DISC_ZOOM_S);
+        float e = u < 0.5f ? 4.0f * u * u * u : 1.0f - 4.0f * (1.0f - u) * (1.0f - u) * (1.0f - u);
+        s *= 1.0f + (DISC_ZOOM_TO - 1.0f) * e;
+    }
     float flare = sinf(3.14159265f * li);
     int a = (int)(0x80 * fminf(1.0f, li * 1.8f) * keep);
     int h = DISC_SIZE, w = DISC_SIZE * tex->Width / tex->Height;
