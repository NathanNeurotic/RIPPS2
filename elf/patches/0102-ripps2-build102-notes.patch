+void thmPageFontsBegin(void)
+{
+    int i;
+
+    if (thmPageFontsDepth++ > 0)
+        return; // a page opened from the page: its faces are in already
+    for (i = 0; i < THM_PAGE_FACES; i++)
+        thmPageHandle[i] = thmGetGuiValue() == 0 ? FNT_ERROR : fntLoadFile((char *)thmPageFace[i].face, thmPageFace[i].size);
+}
+
+void thmPageFontsEnd(void)
+{
+    int i;
+
+    if (thmPageFontsDepth <= 0 || --thmPageFontsDepth > 0)
+        return;
+    for (i = 0; i < THM_PAGE_FACES; i++) {
+        if (thmPageHandle[i] != FNT_ERROR)
+            fntRelease(thmPageHandle[i]);
+        thmPageHandle[i] = FNT_ERROR;
+    }
+}
