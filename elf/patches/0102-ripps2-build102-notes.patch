+/* RIPPS2 build 102 (user: "ripflow status page font and ripps2 about pages font slots on all themes"). About and
+   STATUS read in RIPPS2's own faces on every theme, as Settings has since build 96: the slots they draw with
+   (thmPageFace) at RIPPS2's sizes. Up to build 101 each theme's own slots drew them, so RIPFLOW's STATUS heading
+   came out in Roboto Bold capitals and a theme without those slots drew About in its one default face. The faces
+   load as the page opens (thmPageFontsBegin) and go as it closes; on RIPPS2's own theme they are its own slots. */
+static const struct
+{
+    int slot;
+    const char *face;
+    int size;
+} thmPageFace[] = {{4, "builtin:ripps2sleekbold", 15}, {5, "builtin:ripps2", 14}, {8, "builtin:ripps2", 16},
+                   {9, "builtin:ripps2sleekcase", 22}, {10, "builtin:ripps2", 12}, {15, "builtin:ripps2sleekcase", 15}};
+#define THM_PAGE_FACES ((int)(sizeof(thmPageFace) / sizeof(thmPageFace[0])))
+static int thmPageFontsDepth = 0, thmPageHandle[THM_PAGE_FACES];
