+void ripps2ShotPrepareMmce(struct cdvdman_settings_mmce *settings, const char *root, const char *id, const char *title)
+{
+    char dir[160], path[192], blank[192];
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int fd, kept, art, media, cardFd;
+
+    if (rsMmceFd >= 0) {
+        fileXioClose(rsMmceFd);
+        rsMmceFd = -1;
+    }
+    settings->roll_fd1 = 0;
+    memset(&rsLaunch, 0, sizeof(rsLaunch));
+    rsLaunch.armed = 1;
+    rsLaunch.state = RIPSHOT_OFF;
+    if (!gRipps2IgrMenu || !gRipps2Ripshot)
+        return;
+    rsLaunch.state = RIPSHOT_NOT_HERE;
+    snprintf(rsLaunch.drive, sizeof(rsLaunch.drive), "MMCE");
+    ripps2ShotFolder(title, id, rsLaunch.title, sizeof(rsLaunch.title));
+
+    snprintf(dir, sizeof(dir), "%sMEDIA/RIPSHOT", root);
+    snprintf(path, sizeof(path), "%s/%s.ROLL", dir, id);
+    if (!rsExists(path)) {
+        snprintf(blank, sizeof(blank), "%s/BLANK.ROLL", dir);
+        rsLaunch.state = RIPSHOT_DRIVE_FULL;
+        if (rsCountRolls(dir) >= RS_ROLLS_MAX)
+            return;
+        if (!(rsExists(blank) && rename(blank, path) == 0) && !rsMake(root, path))
+            return; // no blank and no room for a roll
+        if ((fd = open(path, O_RDWR)) < 0)
+            return;
+        rsStamp(fd, id, title);
+        close(fd);
+    }
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return;
+    if (lseek(fd, 0, SEEK_END) < RS_ROLL_BYTES) { // cut short (or an older layout): a roll of today's size, when nothing is kept
+        rsSlots(fd, hdr);
+        close(fd);
+        ripps2ShotCount(hdr, &kept, &art, &media);
+        rsLaunch.state = RIPSHOT_DRIVE_FULL;
+        if (kept || remove(path) != 0 || !rsMake(root, path))
+            return;
+        if ((fd = open(path, O_RDWR)) < 0)
+            return;
+        rsStamp(fd, id, title);
+        lseek(fd, 0, SEEK_SET);
+    }
+    rsSlots(fd, hdr);
+    close(fd);
+    ripps2ShotCount(hdr, &kept, &art, &media);
+
+    rsLaunch.state = RIPSHOT_NOT_HERE;
+    if ((rsMmceFd = fileXioOpen(path, 0x3, 0666)) < 0) // read and write, as the VMCs are opened
+        return;
+    if ((cardFd = fileXioIoctl2(rsMmceFd, 0x80, NULL, 0, NULL, 0)) < 0) {
+        fileXioClose(rsMmceFd);
+        rsMmceFd = -1;
+        return;
+    }
+    settings->roll_fd1 = cardFd + 1;
+    rsLaunch.kept = kept;
+    rsLaunch.scr = rsFirstScr(root, id) + art;
+    rsLaunch.shot = rsFirstShot(root, rsLaunch.title) + media;
+    rsLaunch.state = RIPSHOT_READY;
+    LOG("RIPSHOT roll %s: card descriptor %d, kept 0x%02x, next SCR%d / SHOT %02d\n", path, cardFd, kept, rsLaunch.scr, rsLaunch.shot);
+}
