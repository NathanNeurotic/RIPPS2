+// build 117: the left stick, as the right one below (RIPFLOW's flowtilt)
+void padGetLeftStick(int *x, int *y)
+{
+    int i;
+    *x = 0;
+    *y = 0;
+    for (i = 0; i < pad_count && i < MAX_PADS; i++) {
+        struct pad_data_t *pad = &pad_data[i];
+        if ((pad->state != PAD_STATE_STABLE && pad->state != PAD_STATE_FINDCTP1) || (pad->buttons.mode >> 4) != 0x07 || pad->missMs)
+            continue;
+        int h = (int)pad->buttons.ljoy_h - 128, v = (int)pad->buttons.ljoy_v - 128;
+        if (h * h + v * v > 24 * 24) {
+            *x = h;
+            *y = v;
+        }
+        return;
+    }
+}
