diff --git a/src/ripps2artpack.c b/src/ripps2artpack.c
new file mode 100644
index 0000000..ca492e0
--- /dev/null
+++ b/src/ripps2artpack.c
@@ -0,0 +1,815 @@
+/*
+  ripps2artpack.c the ART Pack (build 118): every started drive's art in one art.tar
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  The user, 10/27: "add a feature in the cache for .tar compression ART migrate ... compress it to the intended drive
+  (fastest detected shown as default choice like my mmce) make the .tar file read intelligent with the cache features so
+  the PS2 won't call for each games art individually".
+
+  Settings > Game Sources > Cache > ART Pack packs the ART folder of every started drive into one plain tar, art.tar in the
+  ART folder of the drive the user picks. Each drive is measured as it reads a few of its own pictures and the drives are
+  listed fastest first, so X takes the fastest. The pictures go in as they are, under their own names (PNG and JPG are
+  compressed already: the tar bundles them), so a PC opens the pack as any tar. The ART folders are never touched.
+
+  Reading it is RiptOPL's art.tar engine (tar.c, texcache.c) with its toggle on (Artwork > .tar art): one index for the
+  whole pack, written here with the pack (art_cache.bin, so the first boot does not read two thousand headers), looked up
+  in sorted order, the pack's drive swept first. And one thing more: the pack holds RIPPS2ART.LST, the games it was built
+  for. A picture of one of those the pack does not hold is not in the ART folders either, so the art worker neither lists
+  nor opens the folder for it (ripps2ArtPackAnswers): no lookup per game, and no failed open (which on an SD2PSX cost the
+  music its file). Art RIPPS2 writes afterwards (a fetched cover, a developed RIPSHOT) is noted beside the pack
+  (art_new.txt) and its game looked for in its folder again; art copied in on a PC shows after the next build.
+*/
+
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include <stdlib.h>
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <kernel.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/ioman.h"
+#include "include/iosupport.h"
+#include "include/libview.h"
+#include "include/textures.h"
+#include "include/texcache.h"
+#include "include/artindex.h"
+#include "include/tar.h"
+#include "include/ripps2.h"
+#include "include/ripps2diag.h"
+#include "include/ripps2artpack.h"
+#include "include/ripps2tr.h" // _t, RIPPS2's words in the chosen language
+
+char gRipps2ArtPack[160];
+int gRipps2ArtPackCount = 0;
+int gRipps2ArtPackKb = 0;
+
+#define AP_SOURCES   12
+#define AP_KEY       48
+#define AP_NAME      48   // TarEntryArt's filename: 47 characters and the NUL
+#define AP_MAX_FILES 6144
+#define AP_MAX_KEYS  4096
+#define AP_NEW_MAX   512
+#define AP_LIST      "RIPPS2ART.LST" // the pack's own member: the games it was built for, a key a line
+#define AP_NEW       "art_new.txt"   // beside the pack: the games RIPPS2 wrote art for since
+#define AP_HEAD      "RIPPS2 ART PACK 1"
+#define AP_MEASURE_FILES 6
+#define AP_MEASURE_BYTES (384 * 1024)
+
+// ---------------------------------------------------------------- names and keys
+
+// FNV-1a over the name in capitals: FAT and exFAT keep a name's case but ignore it
+static unsigned int apHash(const char *s)
+{
+    unsigned int h = 2166136261u;
+    for (; *s; s++)
+        h = (h ^ (unsigned char)toupper((unsigned char)*s)) * 16777619u;
+    return h;
+}
+
+static int apIsPicture(const char *name)
+{
+    const char *dot = strrchr(name, '.');
+    return dot != NULL && dot != name && (!strcasecmp(dot, ".png") || !strcasecmp(dot, ".jpg") || !strcasecmp(dot, ".jpeg"));
+}
+
+// a piece of a game's art, as the themes ask for it: COV COV2 ICO LAB LGO BG SCR SCR<n>
+static int apIsKind(const char *k)
+{
+    static const char *const kinds[] = {"COV", "COV2", "ICO", "LAB", "LGO", "BG", "SCR"};
+    unsigned int i;
+    for (i = 0; i < sizeof(kinds) / sizeof(kinds[0]); i++)
+        if (!strcasecmp(k, kinds[i]))
+            return 1;
+    if (strncasecmp(k, "SCR", 3) || !k[3])
+        return 0;
+    for (k += 3; *k; k++)
+        if (!isdigit((unsigned char)*k))
+            return 0;
+    return 1;
+}
+
+int ripps2ArtKeyOf(const char *name, char *key, int size)
+{
+    const char *base = strrchr(name, '/'), *dot, *u, *u2;
+    char stem[128];
+    int n;
+
+    base = base != NULL ? base + 1 : name;
+    dot = strrchr(base, '.');
+    n = dot != NULL ? (int)(dot - base) : (int)strlen(base);
+    if (n <= 0 || n >= (int)sizeof(stem))
+        return 0;
+    memcpy(stem, base, n);
+    stem[n] = '\0';
+    if ((u = strrchr(stem, '_')) == NULL || u == stem)
+        return 0;
+    if (isdigit((unsigned char)u[1]) && isdigit((unsigned char)u[2]) && u[3] == '\0') {
+        // OPL Manager's two-part kinds: _BG_00 to _BG_06, _SCR_00 and _SCR_01
+        for (u2 = u - 1; u2 > stem && *u2 != '_'; u2--)
+            ;
+        if (u2 <= stem || (strncasecmp(u2 + 1, "BG_", 3) && strncasecmp(u2 + 1, "SCR_", 4)))
+            return 0;
+        n = (int)(u2 - stem);
+    } else if (apIsKind(u + 1))
+        n = (int)(u - stem);
+    else
+        return 0;
+    if (n <= 0 || n >= size)
+        return 0;
+    memcpy(key, stem, n);
+    key[n] = '\0';
+    return 1;
+}
+
+// two paths to the same file, whether or not a '/' follows the device's ':' ("pfs0:ART/art.tar", "pfs0:/ART/art.tar")
+static int apSamePath(const char *a, const char *b)
+{
+    const char *ca = strchr(a, ':'), *cb = strchr(b, ':');
+    if (ca == NULL || cb == NULL || ca - a != cb - b || strncasecmp(a, b, ca - a))
+        return 0;
+    ca += ca[1] == '/' ? 2 : 1;
+    cb += cb[1] == '/' ? 2 : 1;
+    return !strcasecmp(ca, cb);
+}
+
+// the folder the pack is in ("mmce0:/ART/"), for art_cache.bin and art_new.txt
+static void apPackDir(const char *pack, char *out, int size)
+{
+    const char *slash = strrchr(pack, '/');
+    snprintf(out, size, "%.*s", slash != NULL ? (int)(slash - pack + 1) : 0, pack);
+}
+
+// ---------------------------------------------------------------- what the pack knows (the art worker)
+
+static unsigned int *apCovered;  // the keys' hashes, sorted
+static int apCoveredCount;
+static char apCoveredFor[160];   // the pack they were read from
+static volatile unsigned int apGen = 1, apCoveredGen = 0; // a build or a removal starts over
+static unsigned int apNew[AP_NEW_MAX];
+static volatile int apNewCount;
+
+static int apHashCmp(const void *a, const void *b)
+{
+    unsigned int x = *(const unsigned int *)a, y = *(const unsigned int *)b;
+    return x < y ? -1 : (x > y ? 1 : 0);
+}
+
+static int apNewHas(unsigned int h)
+{
+    int i, n = apNewCount;
+    for (i = 0; i < n; i++)
+        if (apNew[i] == h)
+            return 1;
+    return 0;
+}
+
+static void apNewAdd(unsigned int h)
+{
+    if (!apNewHas(h) && apNewCount < AP_NEW_MAX) {
+        apNew[apNewCount] = h;
+        apNewCount++; // after the hash is in: a reader on another thread never sees an empty slot counted
+    }
+}
+
+// one line of text: its key's hash into apNew (art_new.txt) or into the list (RIPPS2ART.LST)
+static void apReadKeys(char *text, int len, int intoNew, unsigned int *list, int *count, int max)
+{
+    char *line = text, *end = text + len, *nl;
+    while (line < end) {
+        for (nl = line; nl < end && *nl != '\n' && *nl != '\r'; nl++)
+            ;
+        *nl = '\0';
+        if (*line && strcmp(line, AP_HEAD)) {
+            if (intoNew)
+                apNewAdd(apHash(line));
+            else if (*count < max)
+                list[(*count)++] = apHash(line);
+        }
+        line = nl + 1;
+    }
+}
+
+// the art worker: the games the pack held now was built for, and the games RIPPS2 wrote art for since
+static void apLoad(const char *held)
+{
+    char dir[160], path[200];
+    TarEntryBase *e;
+    char *text;
+    int fd, n;
+
+    free(apCovered);
+    apCovered = NULL;
+    apCoveredCount = 0;
+    snprintf(apCoveredFor, sizeof(apCoveredFor), "%s", held);
+    apCoveredGen = apGen;
+    if ((e = tarFindLoaded(TAR_KIND_ART, AP_LIST)) == NULL || e->rawSize == 0 || e->rawSize > AP_MAX_KEYS * AP_KEY ||
+        (text = malloc(e->rawSize + 1)) == NULL)
+        return; // a pack made elsewhere: it answers for what it holds only
+    if (tarRead(TAR_KIND_ART, e, text, e->rawSize) == e->rawSize && !strncmp(text, AP_HEAD, strlen(AP_HEAD)) &&
+        (apCovered = malloc(AP_MAX_KEYS * sizeof(unsigned int))) != NULL) {
+        apReadKeys(text, e->rawSize, 0, apCovered, &apCoveredCount, AP_MAX_KEYS);
+        qsort(apCovered, apCoveredCount, sizeof(unsigned int), apHashCmp);
+    }
+    free(text);
+    // art_new.txt: written empty with the pack, so this open finds it (no failed open on the card)
+    apPackDir(held, dir, sizeof(dir));
+    snprintf(path, sizeof(path), "%s%s", dir, AP_NEW);
+    if ((fd = open(path, O_RDONLY)) >= 0) {
+        n = lseek(fd, 0, SEEK_END);
+        lseek(fd, 0, SEEK_SET);
+        if (n > 0 && n < 64 * 1024 && (text = malloc(n + 1)) != NULL) {
+            if (read(fd, text, n) == n)
+                apReadKeys(text, n, 1, NULL, NULL, 0);
+            free(text);
+        }
+        close(fd);
+    }
+    LOG("ART PACK: %s knows %d games, %d with art written since\n", held, apCoveredCount, apNewCount);
+}
+
+int ripps2ArtPackAnswers(const char *key)
+{
+    char held[200];
+    unsigned int h;
+
+    if (!gEnableArtTar || !gRipps2ArtPack[0] || key == NULL || !key[0])
+        return 0;
+    if (!tarLoadedPath(TAR_KIND_ART, held, sizeof(held)) || !apSamePath(held, gRipps2ArtPack))
+        return 0; // another archive (a pack someone else made, the HDD's own): it answers only for what it holds
+    if (apCoveredGen != apGen || strcmp(apCoveredFor, held))
+        apLoad(held);
+    if (apCovered == NULL || apCoveredCount == 0)
+        return 0;
+    h = apHash(key);
+    if (bsearch(&h, apCovered, apCoveredCount, sizeof(unsigned int), apHashCmp) == NULL)
+        return 0; // a game added since the pack was built: its folder is asked, as before
+    return !apNewHas(h);
+}
+
+void ripps2ArtPackNoteNew(const char *path)
+{
+    char key[AP_KEY], dir[160], file[200], line[AP_KEY + 4];
+    int fd, n;
+    unsigned int h;
+
+    if (!gRipps2ArtPack[0] || path == NULL || !ripps2ArtKeyOf(path, key, sizeof(key)))
+        return;
+    h = apHash(key);
+    if (apNewHas(h))
+        return;
+    apNewAdd(h);
+    apPackDir(gRipps2ArtPack, dir, sizeof(dir));
+    snprintf(file, sizeof(file), "%s%s", dir, AP_NEW);
+    n = snprintf(line, sizeof(line), "%s\r\n", key);
+    if (!ioWriteBegin())
+        return;
+    if ((fd = open(file, O_WRONLY | O_CREAT, 0666)) >= 0) {
+        lseek(fd, 0, SEEK_END);
+        write(fd, line, n);
+        close(fd);
+    }
+    ioWriteEnd();
+}
