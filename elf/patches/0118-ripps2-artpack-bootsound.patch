--- /dev/null
+++ b/include/ripps2artpack.h
@@ -0,0 +1,25 @@
+#ifndef __RIPPS2_ARTPACK_H
+#define __RIPPS2_ARTPACK_H
+
+// RIPPS2 build 118: the ART Pack (Settings > Game Sources > Cache > ART Pack), ripps2artpack.c
+
+extern char gRipps2ArtPack[160]; // the pack in use: "mmce0:/ART/art.tar" ("" none), saved as ripps2_artpack
+extern int gRipps2ArtPackCount;  // its pictures (ripps2_artpack_n), for the Cache page
+extern int gRipps2ArtPackKb;     // and their size in KB (ripps2_artpack_kb)
+
+// the settings just read: the pack's drive is swept first (tar.c)
+void ripps2ArtPackApplySettings(void);
+// the Cache page's line about the pack (in the chosen language)
+void ripps2ArtPackDescribe(char *out, int size);
+// Cache > ART Pack: build the pack on a drive the user picks (the fastest first), or remove it. 1 when the settings changed
+int ripps2ArtPackDialog(void);
+// The art worker, a picture not in the archive held: 1 when that archive is the ART Pack RIPPS2 built and it was built for
+// this game (and no art was written for it since), so the picture is not there and the ART folder need not be asked
+int ripps2ArtPackAnswers(const char *key);
+// RIPPS2 wrote a picture into an ART folder (a fetched cover, a developed RIPSHOT): the pack does not hold it, so that
+// game's art is looked for in its folder again, this session and the next (art_new.txt beside the pack)
+void ripps2ArtPackNoteNew(const char *path);
+// "SLUS_210.50_COV.png" (or a path ending in it) -> "SLUS_210.50": the game a picture belongs to; 0 when not art
+int ripps2ArtKeyOf(const char *name, char *key, int size);
+
+#endif
