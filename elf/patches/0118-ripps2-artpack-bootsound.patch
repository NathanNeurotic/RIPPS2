+// RIPPS2 build 118: a picture of a game's art already in memory (out of an ART Pack), whatever it holds, as texLoadArt
+// does for a file: a PNG through the loader above, anything it refuses (a JPG, 16 bits a channel, too big) through the
+// decoder that reads both and shrinks it (a background to a full screen, the rest to 512 on a side). 0, or ERR_BAD_FILE
+int texLoadArtFromMemory(GSTEXTURE *texture, const void *buf, u32 size, int background)
+{
+    unsigned char *rgba;
+    int w, h, ow, oh;
+
+    if (texLoadAll(texture, NULL, -1, buf, size) >= 0)
+        return 0;
+    if (texLoadAbortRequested())
+        return ERR_LOAD_ABORTED;
+    if (!ripps2DecodePicture((const unsigned char *)buf, (int)size, background ? 720 : 512, 512, &rgba, &w, &h, &ow, &oh, NULL))
+        return ERR_BAD_FILE;
+    texPrepare(texture);
+    texture->Width = w;
+    texture->Height = h;
+    texture->PSM = GS_PSM_CT32;
+    texture->Mem = (u32 *)rgba;
+    if (texSizeValidate(w, h, GS_PSM_CT32) < 0) {
+        texFree(texture);
+        return ERR_BAD_FILE;
+    }
+    return 0;
+}
