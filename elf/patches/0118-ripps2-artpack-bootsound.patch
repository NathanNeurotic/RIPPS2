+}
+
+// ---------------------------------------------------------------- the tar (a plain ustar a PC opens)
+
+// a member's 512-byte header: name, size, a fixed mode and owner, the time, the checksum
+static void apHeader(unsigned char h[512], const char *name, unsigned int size, unsigned int mtime)
+{
+    unsigned int sum = 0;
+    int i;
+
+    memset(h, 0, 512);
+    snprintf((char *)h, 100, "%s", name);
+    memcpy(h + 100, "0000644", 8);
+    memcpy(h + 108, "0000000", 8);
+    memcpy(h + 116, "0000000", 8);
+    snprintf((char *)h + 124, 12, "%011o", size);
+    snprintf((char *)h + 136, 12, "%011o", mtime);
+    memset(h + 148, ' ', 8);
+    h[156] = '0';
+    memcpy(h + 257, "ustar", 6);
+    memcpy(h + 263, "00", 2);
+    for (i = 0; i < 512; i++)
+        sum += h[i];
+    snprintf((char *)h + 148, 8, "%06o", sum);
+    h[155] = ' ';
+}
+
+// ---------------------------------------------------------------- the drives and their pictures
+
+typedef struct
+{
+    char root[24]; // "mmce0:/"
+    char dir[40];  // "mmce0:/ART"
+    int target;    // a drive the sweep looks on (tar.c gDevices), with its ART folder at its root
+    int listed;    // its listing finished
+    int files, kbps;
+} ap_source_t;
+
+typedef struct
+{
+    char name[AP_NAME];
+    unsigned char src;
+} ap_file_t;
+
+typedef struct
+{
+    char key[AP_KEY];
+    unsigned char src, out; // the drive whose list has it; out: one of its pictures could not go in
+} ap_key_t;
+
+static ap_source_t apSrc[AP_SOURCES];
+static int apSrcCount;
+static ap_file_t *apFiles;
+static int apFileCount;
+static ap_key_t *apKeys;
+static int apKeyCount;
+
+static int apKeyCmp(const void *a, const void *b)
+{
+    return strcasecmp(((const ap_key_t *)a)->key, ((const ap_key_t *)b)->key);
+}
+
+// a picture that could not go in: its game is not one the pack answers for
+static void apKeyOut(const char *name)
+{
+    char key[AP_KEY];
+    ap_key_t probe, *k;
+    if (!ripps2ArtKeyOf(name, key, sizeof(key)))
+        return;
+    snprintf(probe.key, sizeof(probe.key), "%s", key);
+    if ((k = bsearch(&probe, apKeys, apKeyCount, sizeof(ap_key_t), apKeyCmp)) != NULL)
+        k->out = 1;
+}
+
+// the drive root of a source's ART folder from the path it would read a cover at ("mass0:ART/SLUS_210.50_COV")
+static int apSourceOf(const char *probe)
+{
+    static const char *const targets[] = {"mass0:/", "mass1:/", "mass2:/", "mass3:/", "mass4:/", "mass5:/", "mass6:/", "mass7:/",
+                                          "mmce0:/", "mmce1:/", "pfs0:/", NULL};
+    const char *colon = strchr(probe, ':'), *slash = strrchr(probe, '/'), *at;
+    char root[24], dir[40];
+    int i, atRoot;
+
+    if (colon == NULL || slash == NULL || strchr(probe, '\\') != NULL || !strncmp(probe, "smb", 3) || colon - probe > 8)
+        return -1; // the network keeps its own art
+    at = colon[1] == '/' ? colon + 2 : colon + 1;
+    if (slash - at < 3 || strncasecmp(slash - 3, "ART", 3) || (slash - 3 > at && slash[-4] != '/'))
+        return -1; // not an ART folder
+    atRoot = slash - 3 == at;
+    snprintf(root, sizeof(root), "%.*s/", (int)(colon - probe + 1), probe);
+    snprintf(dir, sizeof(dir), "%s%.*s", root, (int)(slash - at), at);
+    for (i = 0; i < apSrcCount; i++)
+        if (!strcasecmp(apSrc[i].dir, dir))
+            return i;
+    if (apSrcCount >= AP_SOURCES)
+        return -1;
+    memset(&apSrc[apSrcCount], 0, sizeof(ap_source_t));
+    snprintf(apSrc[apSrcCount].root, sizeof(apSrc[0].root), "%s", root);
+    snprintf(apSrc[apSrcCount].dir, sizeof(apSrc[0].dir), "%s", dir);
+    for (i = 0; targets[i] != NULL && atRoot; i++)
+        if (!strcasecmp(targets[i], root))
+            apSrc[apSrcCount].target = 1;
+    return apSrcCount++;
+}
+
+// every started list's ART folder and its games' keys (no device asked: texSetProbe, as the cover download does)
+static void apCollect(void)
+{
+    GSTEXTURE probeTex;
+    char probe[256];
+    int mode, id, count, s;
+
+    apSrcCount = apKeyCount = 0;
+    for (mode = 0; mode < MODE_COUNT; mode++) {
+        if (mode == APP_MODE || mode == FAV_MODE || MODE_IS_MIX(mode))
+            continue; // apps keep their own names; Favorites and All Games repeat other lists
+        opl_io_module_t *mod = oplGetModule(mode);
+        item_list_t *list = mod != NULL ? mod->support : NULL;
+        if (list == NULL || !list->enabled || list->itemGetCount == NULL || list->itemGetStartup == NULL || list->itemGetImage == NULL)
+            continue;
+        count = list->itemGetCount(list);
+        for (id = 0, s = -2; id < count; id++) {
+            char *startup = list->itemGetStartup(list, id);
+            if (startup == NULL || !startup[0])
+                continue;
+            if (s == -2) { // the list's ART folder, from its first game
+                probe[0] = '\0';
+                memset(&probeTex, 0, sizeof(probeTex));
+                texSetProbe(probe, sizeof(probe));
+                list->itemGetImage(list, "ART", 1, startup, "COV", &probeTex, GS_PSM_CT24);
+                texSetProbe(NULL, 0);
+                s = probe[0] ? apSourceOf(probe) : -1;
+                if (s < 0)
+                    break;
+            }
+            // a PS1 game's art goes by other keys as well (textures.c texArtAliases): its folder keeps answering for it
+            if (libListRowView(list, id) == LIB_VIEW_PS1 || strlen(startup) >= AP_KEY || apKeyCount >= AP_MAX_KEYS)
+                continue;
+            snprintf(apKeys[apKeyCount].key, AP_KEY, "%s", startup);
+            apKeys[apKeyCount].src = (unsigned char)s;
+            apKeys[apKeyCount].out = 0;
+            apKeyCount++;
+        }
+    }
+}
+
+// a source's pictures into apFiles (a name too long for the index stays out, and its game with it); 1 when the listing
+// finished
+static int apList(int s)
+{
+    struct dirent *e;
+    DIR *d = opendir(apSrc[s].dir);
+    int err;
+
+    if (d == NULL)
+        return 0;
+    for (;;) {
+        errno = 0;
+        if ((e = readdir(d)) == NULL) {
+            err = errno;
+            break;
+        }
+        if (e->d_name[0] == '.' || !apIsPicture(e->d_name))
+            continue;
+        if (strlen(e->d_name) >= AP_NAME || apFileCount >= AP_MAX_FILES) {
+            apKeyOut(e->d_name);
+            continue;
+        }
+        snprintf(apFiles[apFileCount].name, AP_NAME, "%s", e->d_name);
+        apFiles[apFileCount].src = (unsigned char)s;
+        apFileCount++;
+        apSrc[s].files++;
+    }
+    closedir(d);
+    return err == 0;
+}
+
+// how fast a drive reads its own art: its first pictures, whole (KB a second; 0 when it has none)
+static int apMeasure(int s)
+{
+    static unsigned char buf[64 * 1024];
+    char path[128];
+    int i, fd, r, files = 0;
+    unsigned int bytes = 0;
+    clock_t start = clock(), ms;
+
+    for (i = 0; i < apFileCount && files < AP_MEASURE_FILES && bytes < AP_MEASURE_BYTES; i++) {
+        if (apFiles[i].src != s)
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", apSrc[s].dir, apFiles[i].name);
+        if ((fd = open(path, O_RDONLY)) < 0)
+            continue;
+        while (bytes < AP_MEASURE_BYTES && (r = read(fd, buf, sizeof(buf))) > 0)
+            bytes += r;
+        close(fd);
+        files++;
+    }
+    ms = (clock() - start) * 1000 / CLOCKS_PER_SEC;
+    if (bytes == 0)
+        return 0;
+    return (int)((unsigned long long)bytes * 1000 / 1024 / (ms > 0 ? ms : 1));
+}
+
+// ---------------------------------------------------------------- the build
+
+static int apStopAsked(void)
+{
+    readPads();
+    return getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE);
+}
+
+static int apWriteZeros(FILE *out, unsigned int n)
+{
+    static const unsigned char zero[512];
+    while (n > 0) {
+        unsigned int k = n < sizeof(zero) ? n : sizeof(zero);
+        if (fwrite(zero, 1, k, out) != k)
+            return 0;
+        n -= k;
+    }
+    return 1;
+}
+
+// 1 built, 0 stopped, -1 not written. *pictures, *kb what went in
+static int apBuild(int target, const char *pack, int *pictures, int *kb, int *games)
+{
+    char path[200], dir[160], msg[300];
+    unsigned char head[512];
+    unsigned int *written = NULL, mtime = (unsigned int)time(NULL);
+    int *writtenFrom = NULL; // which of apFiles each went in from: a hash match is checked by name
+    TarEntryArt *index = NULL;
+    TarCacheHeader ch;
+    unsigned long long pos = 0;
+    FILE *out = NULL;
+    clock_t shown = 0;
+    int pass, i, k, fd, size, n = 0, ok = 0, stopped = 0, total = apFileCount;
+    char *list = NULL;
+    void *buf;
+
+    apPackDir(pack, dir, sizeof(dir));
+    *pictures = *kb = *games = 0;
+    if ((written = malloc((apFileCount + 1) * sizeof(unsigned int))) == NULL ||
+        (writtenFrom = malloc((apFileCount + 1) * sizeof(int))) == NULL ||
+        (index = calloc(apFileCount + 1, sizeof(TarEntryArt))) == NULL || (list = malloc(AP_MAX_KEYS * AP_KEY / 2 + 64)) == NULL)
+        goto done;
+    snprintf(path, sizeof(path), "%sart_cache.bin", dir); // the old index goes first: it could never match this pack
+    remove(path);
+    remove(pack);
+    if ((out = fopen(pack, "wb")) == NULL)
+        goto done;
+    setvbuf(out, NULL, _IOFBF, 256 * 1024); // whole 256 KB writes (exFAT slipped odd-placed ones, RIPSHOT build 114)
+
+    // the picked drive's own pictures first: a name on two drives goes in from the one the pack is on
+    for (pass = 0; pass < 2 && !stopped; pass++)
+        for (i = 0; i < apFileCount && !stopped; i++) {
+            if ((apFiles[i].src == target) != (pass == 0))
+                continue;
+            unsigned int h = apHash(apFiles[i].name);
+            for (k = 0; k < n && (written[k] != h || strcasecmp(apFiles[writtenFrom[k]].name, apFiles[i].name)); k++)
+                ;
+            if (k < n) {
+                total--;
+                continue; // that name is in already
+            }
+            if (clock() - shown > CLOCKS_PER_SEC / 4) {
+                snprintf(msg, sizeof(msg), _t("Packing the art into %s: %d of %d pictures, %d MB. Press the back button to stop."), pack,
+                         n, total, (int)(pos >> 20));
+                guiRenderTextScreen(msg);
+                shown = clock();
+                if (apStopAsked())
+                    stopped = 1;
+            }
+            snprintf(path, sizeof(path), "%s/%s", apSrc[apFiles[i].src].dir, apFiles[i].name);
+            buf = NULL;
+            size = -1;
+            if ((fd = open(path, O_RDONLY)) >= 0) {
+                size = lseek(fd, 0, SEEK_END);
+                lseek(fd, 0, SEEK_SET);
+                if (size > 0 && size <= MAX_FILE_SIZE && (buf = malloc(size)) != NULL) {
+                    int got = 0, r;
+                    while (got < size && (r = read(fd, (char *)buf + got, size - got)) > 0)
+                        got += r;
+                    if (got != size) {
+                        free(buf);
+                        buf = NULL;
+                    }
+                }
+                close(fd);
+            }
+            if (buf == NULL) { // unreadable or too big: it stays out, and its game is asked of its folder
+                apKeyOut(apFiles[i].name);
+                total--;
+                continue;
+            }
+            apHeader(head, apFiles[i].name, size, mtime);
+            k = (512 - size % 512) % 512;
+            if (fwrite(head, 1, 512, out) != 512 || fwrite(buf, 1, size, out) != (size_t)size || !apWriteZeros(out, k)) {
+                free(buf);
+                goto done;
+            }
+            free(buf);
+            index[n].base.offset = pos + 512;
+            index[n].base.rawSize = size;
+            index[n].base.paddedSize = size + k;
+            snprintf(index[n].filename, sizeof(index[n].filename), "%s", apFiles[i].name);
+            writtenFrom[n] = i;
+            written[n++] = h;
+            pos += 512 + size + k;
+        }
+    if (stopped)
+        goto done;
+
+    // the games it was built for: on a drive whose folder was listed whole, every picture of theirs in
+    k = snprintf(list, AP_MAX_KEYS * AP_KEY / 2 + 64, "%s\r\n", AP_HEAD);
+    for (i = 0; i < apKeyCount; i++)
+        if (!apKeys[i].out && apSrc[apKeys[i].src].listed && (i == 0 || strcasecmp(apKeys[i].key, apKeys[i - 1].key)) &&
+            k + (int)strlen(apKeys[i].key) + 3 < AP_MAX_KEYS * AP_KEY / 2 + 64) {
+            k += snprintf(list + k, AP_MAX_KEYS * AP_KEY / 2 + 64 - k, "%s\r\n", apKeys[i].key);
+            (*games)++;
+        }
+    apHeader(head, AP_LIST, k, mtime);
+    i = (512 - k % 512) % 512;
+    if (fwrite(head, 1, 512, out) != 512 || fwrite(list, 1, k, out) != (size_t)k || !apWriteZeros(out, i) || !apWriteZeros(out, 1024))
+        goto done;
+    index[n].base.offset = pos + 512;
+    index[n].base.rawSize = k;
+    index[n].base.paddedSize = k + i;
+    snprintf(index[n].filename, sizeof(index[n].filename), "%s", AP_LIST);
+    pos += 512 + k + i + 1024;
+    if (ferror(out) || fclose(out) != 0) {
+        out = NULL;
+        goto done;
+    }
+    out = NULL;
+
+    // its index, as tar.c would write it after reading every header (art_cache.bin, checked against the pack's size)
+    memset(&ch, 0, sizeof(ch));
+    memcpy(ch.magic, ARC_MAGIC, 4);
+    ch.version = ARC_VERSION;
+    ch.tarSize = pos;
+    ch.entryCount = n + 1;
+    snprintf(path, sizeof(path), "%sart_cache.bin", dir);
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+        if (write(fd, &ch, sizeof(ch)) != (int)sizeof(ch) || write(fd, index, (n + 1) * sizeof(TarEntryArt)) != (int)((n + 1) * sizeof(TarEntryArt))) {
+            close(fd);
+            remove(path); // tar.c reads the headers itself, once
+        } else
+            close(fd);
+    }
+    snprintf(path, sizeof(path), "%s%s", dir, AP_NEW); // empty: nothing written since
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0)
+        close(fd);
+    *pictures = n;
+    *kb = (int)(pos >> 10);
+    ok = 1;
+
+done:
+    if (out != NULL)
+        fclose(out);
+    if (!ok)
+        remove(pack); // never a pack half written
+    free(written);
+    free(writtenFrom);
+    free(index);
+    free(list);
+    return ok ? 1 : (stopped ? 0 : -1);
+}
+
+static int apSpeedCmp(const void *a, const void *b)
+{
+    return apSrc[*(const int *)b].kbps - apSrc[*(const int *)a].kbps;
+}
+
+int ripps2ArtPackDialog(void)
+{
+    char items[AP_SOURCES + 1][160], msg[700], pack[160];
+    const char *list[AP_SOURCES + 1];
+    int order[AP_SOURCES], n = 0, i, pick, target, pictures, kb, games, folders, result, removable = gRipps2ArtPack[0] != '\0';
+    int wasTar = gEnableArtTar; // Artwork > .tar art as it was: put back when a build does not finish
+    clock_t start;
+
+    guiRenderTextScreen(_t("Looking at the ART folders on the started drives"));
+    apFiles = malloc(AP_MAX_FILES * sizeof(ap_file_t));
+    apKeys = malloc(AP_MAX_KEYS * sizeof(ap_key_t));
+    apFileCount = 0;
+    if (apFiles == NULL || apKeys == NULL) {
+        free(apFiles);
+        free(apKeys);
+        return 0;
+    }
+    apCollect();
+    qsort(apKeys, apKeyCount, sizeof(ap_key_t), apKeyCmp);
+    for (i = 0; i < apSrcCount; i++)
+        apSrc[i].listed = apList(i);
+    for (i = 0; i < apSrcCount; i++)
+        if (apSrc[i].target && apSrc[i].files > 0) {
+            snprintf(msg, sizeof(msg), _t("Measuring how fast each drive reads its art: %s"), apSrc[i].root);
+            guiRenderTextScreen(msg);
+            apSrc[i].kbps = apMeasure(i);
+            order[n++] = i;
+        }
+    qsort(order, n, sizeof(int), apSpeedCmp);
+    for (i = 0; i < n; i++) {
+        snprintf(items[i], sizeof(items[i]),
+                 i == 0 ? _t("%sART/art.tar: %d pictures there, reads %d KB/s, the fastest") : _t("%sART/art.tar: %d pictures there, reads %d KB/s"),
+                 apSrc[order[i]].root, apSrc[order[i]].files, apSrc[order[i]].kbps);
+        list[i] = items[i];
+    }
+    if (removable) {
+        snprintf(items[n], sizeof(items[n]), _t("REMOVE the pack in %s (the ART folders stay as they are)"), gRipps2ArtPack);
+        list[n] = items[n];
+    }
+
+    result = 0;
+    if (n == 0 && !removable) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("There is no ART folder with pictures on the started drives. Start the drives your art is on (SELECT on their page), then come back."), 0, NULL);
+        goto out;
+    }
+    if ((pick = ripps2PickList(list, n + removable)) < 0)
+        goto out;
+
+    if (pick == n) { // remove the pack: RIPPS2's own three files, never the ART folders
+        snprintf(msg, sizeof(msg), _t("Remove the ART Pack in %s? The ART folders stay as they are."), gRipps2ArtPack);
+        if (!guiMsgBox(msg, 1, NULL))
+            goto out;
+        apPackDir(gRipps2ArtPack, pack, sizeof(pack));
+        gEnableArtTar = 0;
+        tarInvalidate(TAR_KIND_ART);
+        if (ioWriteBegin()) {
+            remove(gRipps2ArtPack);
+            snprintf(msg, sizeof(msg), "%sart_cache.bin", pack);
+            remove(msg);
+            snprintf(msg, sizeof(msg), "%s%s", pack, AP_NEW);
+            remove(msg);
+            ioWriteEnd();
+        }
+        snprintf(msg, sizeof(msg), _t("The ART Pack in %s is removed. Art loads from the ART folders again."), gRipps2ArtPack);
+        gRipps2ArtPack[0] = '\0';
+        gRipps2ArtPackCount = gRipps2ArtPackKb = 0;
+        ripps2ArtPackApplySettings();
+        artIndexInvalidate();
+        cacheInvalidateFailMemo();
+        guiMsgBoxSound(SFX_SAVE);
+        guiMsgBox(msg, 0, NULL);
+        result = 1;
+        goto out;
+    }
+
+    target = order[pick];
+    snprintf(pack, sizeof(pack), "%sART/art.tar", apSrc[target].root);
+    for (i = 0, folders = 0; i < apSrcCount; i++)
+        folders += apSrc[i].files > 0;
+    snprintf(msg, sizeof(msg),
+             _t("Pictures: %d. ART folders: %d. They go into one file, %s. The ART folders stay as they are: the pack is a copy. You can copy art.tar into another drive's ART folder with Memory Files, but building it on the drive you browse from is quickest, so the fastest drive comes first. Build it now?"),
+             apFileCount, folders, pack);
+    if (!guiMsgBox(msg, 1, NULL))
+        goto out;
+
+    // nothing reads a pack while it is written: the toggle off (the art worker asks it per picture), the IO worker held
+    gEnableArtTar = 0;
+    tarInvalidate(TAR_KIND_ART);
+    ioBlockOps(1);
+    start = clock();
+    if (!ioWriteBegin()) // never once a launch has begun
+        i = -1;
+    else {
+        i = apBuild(target, pack, &pictures, &kb, &games);
+        ioWriteEnd();
+    }
+    ioBlockOps(0);
+    if (i > 0) {
+        snprintf(gRipps2ArtPack, sizeof(gRipps2ArtPack), "%s", pack);
+        gRipps2ArtPackCount = pictures;
+        gRipps2ArtPackKb = kb;
+        gEnableArtTar = 1;
+        ripps2ArtPackApplySettings();
+        tarInvalidate(TAR_KIND_ART);
+        artIndexInvalidate();
+        cacheInvalidateFailMemo();
+        ripps2Diag("art pack: %d pictures, %d KB, %d games in %s, %d s", pictures, kb, games, pack, (int)((clock() - start) / CLOCKS_PER_SEC));
+        snprintf(msg, sizeof(msg),
+                 _t("The ART Pack is built: %d pictures, %d MB, in %s (%d s). Art loads from it from now on, and the games it was built for (%d) never have their ART folder asked one picture at a time. Art RIPPS2 fetches or shoots shows at once; art you copy in on a PC shows after you build the pack again."),
+                 pictures, (kb + 1023) / 1024, pack, (int)((clock() - start) / CLOCKS_PER_SEC), games);
+        guiMsgBoxSound(SFX_SAVE);
+        result = 1;
+    } else {
+        // the pack in use before (if any) was the one just replaced: art loads from the folders until the next build
+        if (gRipps2ArtPack[0] && apSamePath(gRipps2ArtPack, pack)) {
+            gRipps2ArtPack[0] = '\0';
+            gRipps2ArtPackCount = gRipps2ArtPackKb = 0;
+            result = 1;
+        }
+        gEnableArtTar = wasTar;
+        ripps2ArtPackApplySettings();
+        tarInvalidate(TAR_KIND_ART);
+        if (i == 0)
+            snprintf(msg, sizeof(msg), "%s", _t("Stopped. The unfinished pack was removed, and art loads from the ART folders as before."));
+        else
+            snprintf(msg, sizeof(msg), _t("The ART Pack could not be written to %s (is there room on that drive?). Nothing else changed: art loads from the ART folders as before."), pack);
+        guiMsgBoxSound(SFX_ERROR);
+    }
+    guiMsgBox(msg, 0, NULL);
+
+out:
+    free(apFiles);
+    free(apKeys);
+    apFiles = NULL;
+    apKeys = NULL;
+    return result;
+}
