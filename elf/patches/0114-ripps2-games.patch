+LINK = re.compile(r"(!?\[(?:[^\[\]\n]|\[[^\[\]\n]*\])*\]\()([^\s<>]+(?:\([^\n()]*\)[^\s<>]*)?)(\s+\"[^\"\n]*\")?(\))")
+
