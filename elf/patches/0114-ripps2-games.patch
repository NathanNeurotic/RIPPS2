+static void tintHsv(const float c[3], float *h, float *s, float *v)
+{
+    float mx = fmaxf(c[0], fmaxf(c[1], c[2])), mn = fminf(c[0], fminf(c[1], c[2])), d = mx - mn;
+    *v = mx / 255.0f;
+    *s = mx > 0.0f ? d / mx : 0.0f;
+    if (d <= 0.0f)
+        *h = 0.0f;
+    else if (mx == c[0])
+        *h = 60.0f * fmodf((c[1] - c[2]) / d + 6.0f, 6.0f);
+    else if (mx == c[1])
+        *h = 60.0f * ((c[2] - c[0]) / d + 2.0f);
+    else
+        *h = 60.0f * ((c[0] - c[1]) / d + 4.0f);
+}
