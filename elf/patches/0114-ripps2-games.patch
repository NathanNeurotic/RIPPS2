+static int mixLiveHas(const char *text, int kind)
+{
+    int i, found = 0;
+    mixLock();
+    for (i = 0; i < mixCount && !found; i++)
+        found = mixArray[i].owner != NULL && mixArray[i].kind == kind && !strcmp(mixArray[i].text, text);
