+    while (n > 0) {
+        u32 take = rdStageSize - rdFill < n ? rdStageSize - rdFill : n;
+        memcpy(rdStage + rdFill, p, take);
+        rdFill += take;
+        p += take;
+        n -= take;
+        if (rdFill == rdStageSize) {
