+// Cross on a waiting row (opl.c, before the config is read): its source started if it waits for a start, its list
+// waited for (the GUI's deferred updates run, so the cursor follows the game by its startup onto the real row), then
+// the launch goes on as usual. 0: the back button, the source did not answer, or the game is no longer on it
+int mixWaitForRow(struct menu_item *menu)
+{
+    char name[256], startup[64], line[300];
+    int kind, fam, id, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    double since;
+
+    if (menu == NULL || menu->current == NULL)
+        return 0;
+    id = menu->current->item.id;
+    mixLock();
+    if (!mixValidIndex(id) || mixArray[id].owner != NULL) {
+        mixUnlock();
+        return 1;
+    }
+    snprintf(name, sizeof(name), "%s", mixArray[id].text);
+    snprintf(startup, sizeof(startup), "%s", mixArray[id].startup);
+    kind = mixArray[id].kind;
+    fam = mixArray[id].family;
+    mixUnlock();
+    if (fam < 0 || fam >= MIX_FAM_COUNT)
+        fam = MIX_FAM_BDM;
+
+    ripps2StartSources(); // a source on Manual starts as All Games' own Start starts it
+    since = ripps2Seconds();
+    readPads();
+    while (1) {
+        guiExecDeferredOps(); // the rebuilt list reaches the menu
+        if (menu->current != NULL && !mixIsWaiting(menu->current->item.id) && mixLiveHas(name, kind)) {
+            const char *now = menu->current->item.text;
+            if (now != NULL && !strcmp(now, name))
+                return 1;
+        }
+        if (mixAnswered[fam] && !mixLiveHas(name, kind)) {
+            snprintf(line, sizeof(line), _t("%s is not on %s any more, so it has left All Games."), name, _t(mixFamName[fam]));
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(line, 0, NULL);
+            return 0;
+        }
+        if (ripps2Seconds() - since > 30.0) {
+            snprintf(line, sizeof(line), _t("%s did not answer, so %s cannot start. Is it connected?"), _t(mixFamName[fam]), name);
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(line, 0, NULL);
+            return 0;
+        }
+        rmStartFrame();
+        ripps2DrawBackground();
+        ripps2DrawPagePanel();
+        snprintf(line, sizeof(line), _t("STARTING %s"), _t(mixFamName[fam]));
+        fntRenderStringFit(gTheme->fonts[4], 320, 200, ALIGN_CENTER, 540, line, GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80), 0);
+        fntRenderStringFit(gTheme->fonts[5], 320, 228, ALIGN_CENTER, 540, name, GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80), 0);
+        {
+            GSTEXTURE *t = thmGetTexture(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON);
+            int x = 320 - (24 + ripps2HintWidth(_t("CANCEL"))) / 2;
+            if (t != NULL)
+                rmDrawPixmap(t, x, 430, ALIGN_NONE, 20, 20, SCALING_RATIO, GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80), 0);
+            ripps2HintText(x + 24, 440, _t("CANCEL"), GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80));
+        }
+        rmEndFrame();
+        readPads();
+        if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            return 0;
+        }
+    }
+}
