+// build 114 (the user, 10/24): the three built-in themes together at the top of every theme list (the hold-SELECT panel,
+// Interface's Theme row, Cycle), then the themes found on the drives. The themes keep their ids (0 <RIPPS2>, 1..n the
+// drives', then <RIPFLOW> and <RIPGRID>); only what is shown is reordered: guiThemeOrder[shown] is the theme's id
+static int *guiThemeOrder = NULL, guiThemeOrderN = 0;
+
+// the theme names in the order shown; the caller holds guiLock, as for guiCopyNameList. On a failed copy NULL (and the
+// order is the ids' own)
+static const char **guiCopyThemeNames(void)
+{
+    const char **copy = guiCopyNameList((const char **)thmGetGuiList()), **shown;
+    int n = 0, i, k = 0, *order;
+
+    free(guiThemeOrder);
+    guiThemeOrder = NULL;
+    guiThemeOrderN = 0;
+    if (copy == NULL)
+        return NULL;
+    while (copy[n] != NULL)
+        n++;
+    shown = (const char **)malloc((n + 1) * sizeof(char *));
+    order = (int *)malloc((n > 0 ? n : 1) * sizeof(int));
+    if (shown == NULL || order == NULL) {
+        free((void *)shown);
+        free(order);
+        return copy; // the ids' own order
+    }
+    for (i = 0; i < n; i++)
+        if (copy[i][0] == '<') {
+            order[k] = i;
+            shown[k++] = copy[i];
+        }
+    for (i = 0; i < n; i++)
+        if (copy[i][0] != '<') {
+            order[k] = i;
+            shown[k++] = copy[i];
+        }
+    shown[n] = NULL;
+    free((void *)copy); // its strings now belong to shown
+    guiThemeOrder = order;
+    guiThemeOrderN = n;
+    return shown;
+}
+
+// a theme's place in the list shown, and back
+static int guiThemeShown(int id)
+{
+    int i;
+    for (i = 0; guiThemeOrder != NULL && i < guiThemeOrderN; i++)
+        if (guiThemeOrder[i] == id)
+            return i;
+    return id;
+}
+
+static int guiThemeId(int shown)
+{
+    return guiThemeOrder != NULL && shown >= 0 && shown < guiThemeOrderN ? guiThemeOrder[shown] : shown;
+}
