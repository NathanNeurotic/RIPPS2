at mass<slot>:, -2 when nothing is\n+ const char *bdmSlotDriveName(int slot);\n++void bdmSlotGamesPrefix(int slot, char *out, int size); // RIPPS2 build 105: where mass<slot>:'s CD/DVD folders and ul.cfg are\n+ // RIPPS2 build 100: start the ISO/ZSO at path (on this BDM drive) where it sits, as Storage starts a game; returns only if\n+ // the launch did not happen\n+ void bdmLaunchIsoAt(item_list_t *itemList, const char *path, const char *startup, int dvd, config_set_t *configSet); // RIPPS2 build 99: USB, HDD, iLINK, MX4SIO, UDPBD or DRIVE by its driver; NULL: none\n+diff --git a/include/ripps2.h b/include/ripps2.h\n+index 3f34be2..06ed9f3 100644\n+--- a/include/ripps2.h\n++++ b/include/ripps2.h\n+@@ -19,6 +19,20 @@ void ripps2CdStart(void); // START LASER on an audio CD: reads its TOC and plays\n+ int ripps2CdAudioTracks(void); // the CD in the drive's sound tracks (its TOC read); 0 when none\n+ void ripps2CdRender(void);\n+ void ripps2CdInput(void);\n++// build 105: RIPDISC reads the CD through the player's own TOC and sound reads\n++int ripps2CdTracks(unsigned int *start, unsigned char *audio, int max); // tracks 1..n (start[n + 1]: the lead-out); 0 when none\n++int ripps2CdReadAudio(unsigned int lsn, unsigned int n, void *buf);     // n sectors of sound, 2352 bytes each; 0 when refused\n++\n++// ---- RIPDISC (ripps2disc.c, build 105): the disc in the drive copied to storage or files, from LAUNCH DISC ----\n++enum { RIPPS2_DISC_NONE = 0, RIPPS2_DISC_PS1, RIPPS2_DISC_PS2CD, RIPPS2_DISC_PS2DVD, RIPPS2_DISC_ESR, RIPPS2_DISC_VIDEO,\n++       RIPPS2_DISC_AUDIO, RIPPS2_DISC_OTHER };\n++int ripps2DiscInfo(char *id, int idSize, char *title, int titleSize); // ripps2ui.c: what the disc watcher found (RIPPS2_DISC_*)\n++void ripps2DiscWaitIdle(void);  // ripps2ui.c: the watcher's read finished, so the drive is the caller's\n++void ripps2DiscRipRender(void); // LAUNCH DISC: the RIPDISC panel over the page\n++int ripps2DiscRipInput(void);   // ...SELECT held on it; 1 when it