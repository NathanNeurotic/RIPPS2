+
+def fetch(name):
+    repo, ref, path, digest = SOURCES[name]
+    if args.source:
+        data = (args.source / repo / path).read_bytes()
+    else:
+        url = 'https://raw.githubusercontent.com/{}/{}/{}'.format(repo, ref, path)
+        with urllib.request.urlopen(url, timeout=60) as response:
+            data = response.read()
