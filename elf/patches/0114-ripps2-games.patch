diff --git a/src/ripps2seance.c b/src/ripps2seance.c
new file mode 100644
index 0000000..aeaa17a
--- /dev/null
+++ b/src/ripps2seance.c
@@ -0,0 +1,609 @@
+/*
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  RIPPS2 build 114: SEANCE, the launchers RIPPS2 does not carry, called up from wherever they are kept. The user
+  (10/22): "cant our file browser search function be used for the ember and popstarter files and add it to the cache
+  so if it knows where one is it can reuse the drivers from the correct location every time".
+
+  What it looks for: POPSTARTER.ELF; POPS.ELF with POPS_IOX.PAK (Sony's PS1 emulator, from the user's own console);
+  ember.elf and the bios.bin it reads; a whole Neutrino (neutrino.elf with config/system.toml). Where each was found
+  is kept in launchers.txt beside the settings, by the drive's kind (usb:/POPS/POPSTARTER.ELF) and not its slot, so a
+  stick that comes up as mass1: next time is still found. RiptOPL's typed paths (sbResolveCustomLoaderPath) read it
+  back the way a path typed in Settings is read.
+
+  How a launch uses it, after the places it always looked:
+    POPSTARTER  Settings' path, the game's drive, then where SEANCE found it, then the memory cards.
+    POPS files  RIPPOPS copies them to the game's drive from where SEANCE found them (it looked only at the top of a
+                few drives before).
+    Ember       ember.elf has to sit in the game drive's EMBER folder, beside the games, so one found elsewhere is
+                offered to be copied there; its bios.bin the same way.
+    Neutrino    Settings' path, the game's drive, the memory cards, then where SEANCE found it. Only when there is
+                none anywhere is RIPPS2's own copy offered, to install once.
+  A launch that finds one the usual way notes where, so the file fills itself in. A search runs only when asked for
+  (Settings > Game Sources > Cache, STATUS) or when a launch finds nothing and the user says yes; it walks only the
+  drives already started (it loads nothing to look), and the back button stops it.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/stat.h>
+
+#include "include/opl.h"
+#include "include/gui.h"
+#include "include/renderman.h"
+#include "include/fntsys.h"
+#include "include/themes.h"
+#include "include/textures.h"
+#include "include/pad.h"
+#include "include/sound.h"
+#include "include/config.h"
+#include "include/supportbase.h"
+#include "include/bdmsupport.h"
+#include "include/iosupport.h"
+#include "include/ioman.h" // build 114: ioWriteBegin, no write once a launch has begun
+#include "include/libview.h"
+#include "include/favsupport.h"
+#include "include/mixsupport.h"
+#include "include/cuesupport.h"
+#include "include/ripps2.h"
+#include "include/ripps2seance.h"
+#include "include/ripps2tint.h" // RIPPSettings Color Theme: last, so every colour below goes through it
+#include "include/ripps2tr.h"   // _t, RIPPS2's words in the chosen language
+
+#define SE_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define SE_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define SE_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define SE_GOLD GS_SETREG_RGBA(0x7A, 0x66, 0x30, 0x80)
+#define SE_OK   GS_SETREG_RGBA(0x50, 0x7A, 0x5A, 0x80)
+
+#define SE_DEPTH      5 // folders below a drive's top
+#define SE_CARD_DEPTH 2 // a memory card is flat
+#define SE_QUEUE      400
+#define SE_PATH       200
+
+int gSeanceLaunching = 0;
+
+static const char *const seKey[SEANCE_COUNT] = {"POPSTARTER", "POPS", "EMBER", "EMBER_BIOS", "NEUTRINO"};
+static const char *const seNames[SEANCE_COUNT] = {"POPSTARTER", N_("The POPS files"), "Ember", N_("Ember's BIOS"), "Neutrino"};
+static char seWhere[SEANCE_COUNT][160]; // as remembered: "usb:/POPS/POPSTARTER.ELF"; the POPS folder ends in '/'
+static int seLoaded = 0, seLooked = 0;
+
+const char *seanceName(int what)
+{
+    return what >= 0 && what < SEANCE_COUNT ? _t(seNames[what]) : "";
+}
+
+// launchers.txt in the folder the settings are kept in (mc0:/RIPPS2 unless Save Settings To chose another)
+static void sePath(char *out, int size)
+{
+    config_set_t *cfg = configGetByType(CONFIG_OPL);
+    const char *fn = (cfg != NULL && cfg->filename != NULL) ? cfg->filename : NULL;
+    const char *cut = fn != NULL ? strrchr(fn, '/') : NULL;
+
+    if (fn != NULL && cut == NULL)
+        cut = strrchr(fn, ':');
+    if (cut == NULL)
+        snprintf(out, size, "mc0:/RIPPS2/launchers.txt");
+    else
+        snprintf(out, size, "%.*slaunchers.txt", (int)(cut - fn + 1), fn);
+}
+
+static void seLoad(void)
+{
+    char path[256], line[220];
+    FILE *f;
+    int i;
+
+    if (seLoaded)
+        return;
+    seLoaded = 1;
+    sePath(path, sizeof(path));
+    if ((f = fopen(path, "r")) == NULL)
+        return;
+    while (fgets(line, sizeof(line), f) != NULL) {
+        char *eq = strchr(line, '='), *end;
+        if (line[0] == '#' || eq == NULL)
+            continue;
+        *eq++ = '\0';
+        end = eq + strlen(eq);
+        while (end > eq && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' '))
+            *--end = '\0';
+        if (!strcmp(line, "LOOKED")) {
+            seLooked = atoi(eq) != 0;
+            continue;
+        }
+        for (i = 0; i < SEANCE_COUNT; i++)
+            if (!strcmp(line, seKey[i]))
+                snprintf(seWhere[i], sizeof(seWhere[i]), "%s", eq);
+    }
+    fclose(f);
+}
+
+static void seSave(void)
+{
+    char path[256];
+    FILE *f;
+    int i;
+
+    if (!gEnableWrite || !ioWriteBegin()) // build 114: never once a launch has begun
+        return;
+    sePath(path, sizeof(path));
+    if ((f = fopen(path, "w")) == NULL) {
+        ioWriteEnd();
+        return;
+    }
+    fprintf(f, "# RIPPS2 (build 114): where each launcher RIPPS2 does not carry was found. RIPPS2 keeps this file.\n"
+               "# A path names its drive by kind (usb:, ata:, mx4sio:, ilink:, mmce:, pfs:, mc:), so any slot finds it.\n");
+    for (i = 0; i < SEANCE_COUNT; i++)
+        if (seWhere[i][0])
+            fprintf(f, "%s=%s\n", seKey[i], seWhere[i]);
+    fprintf(f, "LOOKED=%d\n", seLooked);
+    fclose(f);
+    ioWriteEnd();
+}
+
+// "mass1:/POPS/POPSTARTER.ELF" -> "usb:/POPS/POPSTARTER.ELF": the drive by its kind. 0 for what is not kept (a share)
+static int seAlias(const char *path, char *out, int size)
+{
+    const char *colon = path != NULL ? strchr(path, ':') : NULL;
+    const char *kind = NULL;
+
+    if (colon == NULL)
+        return 0;
+    if (!strncmp(path, "mass", 4) && path[4] >= '0' && path[4] <= '9' && colon == path + 5) {
+        int t = bdmSlotDeviceType(path[4] - '0');
+        kind = t == BDM_TYPE_USB ? "usb" : t == BDM_TYPE_ATA ? "ata" : t == BDM_TYPE_SDC ? "mx4sio" : t == BDM_TYPE_ILINK ? "ilink" : NULL;
+        if (kind == NULL) { // a drive of another kind keeps its slot
+            snprintf(out, size, "%s", path);
+            return 1;
+        }
+    } else if (!strncmp(path, "mmce", 4))
+        kind = "mmce";
+    else if (!strncmp(path, "pfs", 3))
+        kind = "pfs";
+    else if (!strncmp(path, "mc", 2) && colon == path + 3)
+        kind = "mc";
+    else
+        return 0;
+    snprintf(out, size, "%s:%s%s", kind, colon[1] == '/' ? "" : "/", colon + 1);
+    return 1;
+}
+
+void seanceNote(int what, const char *path)
+{
+    char alias[160];
+
+    if (what < 0 || what >= SEANCE_COUNT || !seAlias(path, alias, sizeof(alias)))
+        return;
+    seLoad();
+    if (!strcmp(seWhere[what], alias))
+        return;
+    snprintf(seWhere[what], sizeof(seWhere[what]), "%s", alias);
+    seSave();
+}
+
+int seanceState(int what, char *where, int whereSize)
+{
+    if (what < 0 || what >= SEANCE_COUNT)
+        return -1;
+    seLoad();
+    if (where != NULL && whereSize > 0)
+        snprintf(where, whereSize, "%s", seWhere[what]);
+    return seWhere[what][0] ? 1 : seLooked ? 0 : -1;
+}
+
+// Where it was found, there now. The POPS folder is read back by its POPS.ELF. A launch may bring the drive's
+// transport up for it, as a path typed in Settings does.
+int seanceGet(int what, char *out, int outSize)
+{
+    char probe[200];
+
+    if (what < 0 || what >= SEANCE_COUNT || out == NULL || outSize <= 0)
+        return 0;
+    seLoad();
+    out[0] = '\0';
+    if (!seWhere[what][0])
+        return 0;
+    if (what == SEANCE_POPS) {
+        char *slash;
+        snprintf(probe, sizeof(probe), "%sPOPS.ELF", seWhere[what]);
+        if (!sbResolveCustomLoaderPath(probe, out, outSize))
+            return 0;
+        if ((slash = strrchr(out, '/')) != NULL)
+            slash[1] = '\0';
+        return 1;
+    }
+    return sbResolveCustomLoaderPath(seWhere[what], out, outSize);
+}
+
+// ---- the search ----
+
+static const char *const seSkip[] = {"CD", "DVD", "ART", "CFG", "VMC", "CHT", "THM", "LNG", "MEDIA", "AUDIO", "games",
+                                     "System Volume Information", "$RECYCLE.BIN", NULL};
+
+static int seSkipDir(const char *name)
+{
+    int i;
+    for (i = 0; seSkip[i] != NULL; i++)
+        if (!strcasecmp(name, seSkip[i]))
+            return 1;
+    return 0;
+}
+
+static int seIsDir(const char *dir, const char *name)
+{
+    char path[SE_PATH + 64];
+    struct stat st;
+    snprintf(path, sizeof(path), "%s%s", dir, name);
+    return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static int seExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+// The started drives, the quick ones first: the internal drive, USB, MX4SIO, iLink, then MMCE, the HDD's OPL home and
+// the memory cards. Nothing is loaded to look: a drive whose driver is not up is not there.
+static int seRoots(char roots[][16], int max)
+{
+    static const int order[] = {BDM_TYPE_ATA, BDM_TYPE_USB, BDM_TYPE_SDC, BDM_TYPE_ILINK};
+    static const char *const more[] = {"mmce0:/", "mmce1:/", "pfs0:/", "mc0:/", "mc1:/"};
+    int n = 0, k, i;
+    DIR *d;
+
+    for (k = 0; k <= 4; k++)
+        for (i = 0; i < 8 && n < max; i++) {
+            int t = bdmSlotDeviceType(i);
+            if (t < -1 || t == BDM_TYPE_UDPBD)
+                continue;
+            if (k < 4 ? t != order[k] : (t == BDM_TYPE_ATA || t == BDM_TYPE_USB || t == BDM_TYPE_SDC || t == BDM_TYPE_ILINK))
+                continue;
+            snprintf(roots[n++], 16, "mass%d:/", i);
+        }
+    for (k = 0; k < (int)(sizeof(more) / sizeof(more[0])) && n < max; k++) {
+        if (!strncmp(more[k], "pfs", 3) && gHDDPrefix == NULL)
+            continue; // the HDD's OPL home is not mounted
+        if ((d = opendir(more[k])) == NULL)
+            continue;
+        closedir(d);
+        snprintf(roots[n++], 16, "%s", more[k]);
+    }
+    return n;
+}
+
+static int seFoundNow[SEANCE_COUNT];
+
+static void seHint(int icon, const char *text, int *x, int y)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    if (t != NULL) {
+        rmDrawPixmap(t, *x, y - 10, ALIGN_NONE, 20, 20, SCALING_RATIO, SE_LIT, 0);
+        *x += 24;
+    }
+    *x = ripps2HintText(*x, y, text, SE_SOFT) + 18;
+}
+
+static void seFrame(const char *where, int dirs)
+{
+    char line[64];
+    int i, y = 168, x;
+
+    rmStartFrame();
+    ripps2DrawBackground();
+    ripps2DrawPagePanel();
+    fntRenderString(gTheme->fonts[4], 320, 110, ALIGN_CENTER, 0, 0, _t("LOOKING FOR YOUR LAUNCHERS"), SE_LIT);
+    snprintf(line, sizeof(line), _t("%d FOLDERS"), dirs);
+    fntRenderString(gTheme->fonts[5], 320, 134, ALIGN_CENTER, 0, 0, line, SE_SOFT);
+    for (i = 0; i < SEANCE_COUNT; i++, y += 26) {
+        fntRenderStringFit(gTheme->fonts[5], 120, y, ALIGN_VCENTER, 170, seanceName(i), SE_GOLD, 0);
+        fntRenderStringFit(gTheme->fonts[5], 300, y, ALIGN_VCENTER, 240, seFoundNow[i] ? seWhere[i] : "...", seFoundNow[i] ? SE_OK : SE_DIM, 0);
+    }
+    fntRenderStringFit(gTheme->fonts[5], 320, y + 14, ALIGN_CENTER, 520, where, SE_DIM, 0);
+    x = 320 - (24 + ripps2HintWidth(_t("STOP"))) / 2;
+    seHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, _t("STOP"), &x, 440);
+    rmEndFrame();
+}
+
+typedef struct
+{
+    char dir[SE_PATH];
+    unsigned char depth, card;
+} se_node_t;
+
+// What one folder holds, by the names it really has (the HDD's PFS minds case)
+static void seLookIn(const char *dir, const char names[][64], const unsigned char *has, int hasConfig)
+{
+    char path[SE_PATH + 80];
+
+    if (has[0] && !seFoundNow[SEANCE_POPSTARTER]) {
+        snprintf(path, sizeof(path), "%s%s", dir, names[0]);
+        seanceNote(SEANCE_POPSTARTER, path);
+        seFoundNow[SEANCE_POPSTARTER] = 1;
+    }
+    if (has[1] && has[2] && !seFoundNow[SEANCE_POPS]) {
+        seanceNote(SEANCE_POPS, dir);
+        seFoundNow[SEANCE_POPS] = 1;
+    }
+    if (has[3] && !seFoundNow[SEANCE_EMBER]) {
+        snprintf(path, sizeof(path), "%s%s", dir, names[3]);
+        seanceNote(SEANCE_EMBER, path);
+        seFoundNow[SEANCE_EMBER] = 1;
+    }
+    // a bios.bin is Ember's only beside an ember.elf or in an EMBER folder (other emulators keep theirs too)
+    if (has[4] && !seFoundNow[SEANCE_EMBER_BIOS]) {
+        int n = strlen(dir);
+        if (has[3] || (n >= 6 && !strncasecmp(dir + n - 6, "EMBER/", 6))) {
+            snprintf(path, sizeof(path), "%s%s", dir, names[4]);
+            seanceNote(SEANCE_EMBER_BIOS, path);
+            seFoundNow[SEANCE_EMBER_BIOS] = 1;
+        }
+    }
+    if (has[5] && !seFoundNow[SEANCE_NEUTRINO]) {
+        snprintf(path, sizeof(path), "%sconfig/system.toml", dir);
+        if (has[6] || (hasConfig && seExists(path))) {
+            snprintf(path, sizeof(path), "%s%s", dir, names[5]);
+            seanceNote(SEANCE_NEUTRINO, path);
+            seFoundNow[SEANCE_NEUTRINO] = 1;
+        }
+    }
+}
+
+// The walk, breadth first, every started drive in turn; 0 when the back button stopped it
+static int seWalk(void)
+{
+    static const char *const files[] = {"POPSTARTER.ELF", "POPS.ELF", "POPS_IOX.PAK", "ember.elf", "bios.bin", "neutrino.elf", "system.toml"};
+    se_node_t *q = malloc(SE_QUEUE * sizeof(se_node_t));
+    char roots[16][16];
+    int nRoots, head = 0, tail = 0, i, k, stopped = 0, dirs = 0, all;
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    double drawn = 0;
+
+    if (q == NULL)
+        return 1;
+    nRoots = seRoots(roots, 16);
+    for (i = 0; i < nRoots; i++) {
+        snprintf(q[tail].dir, SE_PATH, "%s", roots[i]);
+        q[tail].depth = 0;
+        q[tail++].card = !strncmp(roots[i], "mc", 2);
+    }
+    seFrame("", 0);
+    while (head < tail) {
+        se_node_t n = q[head++ % SE_QUEUE];
+        char names[7][64];
+        unsigned char has[7] = {0, 0, 0, 0, 0, 0, 0};
+        int hasConfig = 0;
+        DIR *d;
+        struct dirent *e;
+
+        for (all = 1, k = 0; k < SEANCE_COUNT; k++)
+            all &= seFoundNow[k];
+        if (all)
+            break;
+        if (ripps2Seconds() - drawn > 0.15) {
+            drawn = ripps2Seconds();
+            seFrame(n.dir, dirs);
+            readPads();
+            if (getKeyOn(backKey)) {
+                stopped = 1;
+                break;
+            }
+        }
+        if ((d = opendir(n.dir)) == NULL)
+            continue;
+        dirs++;
+        while ((e = readdir(d)) != NULL) {
+            int isDir;
+            if (e->d_name[0] == '.')
+                continue;
+#ifdef DT_REG
+            isDir = e->d_type == DT_DIR ? 1 : e->d_type == DT_REG ? 0 : seIsDir(n.dir, e->d_name); // a stat only when the driver did not say
+#else
+            isDir = seIsDir(n.dir, e->d_name);
+#endif
+            if (!isDir) {
+                for (k = 0; k < 7; k++)
+                    if (!has[k] && !strcasecmp(e->d_name, files[k])) {
+                        has[k] = 1;
+                        snprintf(names[k], sizeof(names[k]), "%s", e->d_name);
+                    }
+                continue;
+            }
+            if (!strcasecmp(e->d_name, "config"))
+                hasConfig = 1;
+            if (n.depth + 1 > (n.card ? SE_CARD_DEPTH : SE_DEPTH) || seSkipDir(e->d_name) || tail - head >= SE_QUEUE - 1 ||
+                strlen(n.dir) + strlen(e->d_name) + 2 >= SE_PATH)
+                continue;
+            snprintf(q[tail % SE_QUEUE].dir, SE_PATH, "%s%s/", n.dir, e->d_name);
+            q[tail % SE_QUEUE].depth = n.depth + 1;
+            q[tail % SE_QUEUE].card = n.card;
+            tail++;
+        }
+        closedir(d);
+        seLookIn(n.dir, (const char(*)[64])names, has, hasConfig);
+    }
+    free(q);
+    return !stopped;
+}
+
+// Is the drive a remembered path names started now? 1 when one of its kind is up (nothing is loaded to ask)
+static int seDriveUp(const char *alias)
+{
+    static const struct
+    {
+        const char *kind;
+        int type;
+    } bdm[] = {{"usb:", BDM_TYPE_USB}, {"ata:", BDM_TYPE_ATA}, {"mx4sio:", BDM_TYPE_SDC}, {"ilink:", BDM_TYPE_ILINK}};
+    static const char *const roots[] = {"mmce0:/", "mmce1:/", "mc0:/", "mc1:/"};
+    int i, k;
+    DIR *d;
+
+    for (k = 0; k < 4; k++)
+        if (!strncmp(alias, bdm[k].kind, strlen(bdm[k].kind))) {
+            for (i = 0; i < 8; i++)
+                if (bdmSlotDeviceType(i) == bdm[k].type)
+                    return 1;
+            return 0;
+        }
+    if (!strncmp(alias, "mass", 4))
+        return alias[4] >= '0' && alias[4] <= '9' && bdmSlotDeviceType(alias[4] - '0') >= -1;
+    if (!strncmp(alias, "pfs", 3))
+        return gHDDPrefix != NULL;
+    for (k = 0; k < 4; k++)
+        if (!strncmp(alias, roots[k], 2) && !strncmp(alias, k < 2 ? "mmce" : "mc:", k < 2 ? 4 : 3)) {
+            if ((d = opendir(roots[k])) != NULL) {
+                closedir(d);
+                return 1;
+            }
+        }
+    return 0;
+}
+
+int seanceSearch(void)
+{
+    int i, known = 0, whole;
+
+    seLoad();
+    for (i = 0; i < SEANCE_COUNT; i++)
+        seFoundNow[i] = 0;
+    whole = seWalk();
+    if (whole) {
+        // a whole walk that did not meet one: forgotten, unless it was kept on a drive that is not started now (the walk
+        // could not look there)
+        for (i = 0; i < SEANCE_COUNT; i++) {
+            if (seFoundNow[i] || !seWhere[i][0] || !seDriveUp(seWhere[i]))
+                continue;
+            seWhere[i][0] = '\0';
+        }
+        seLooked = 1;
+        seSave();
+    }
+    for (i = 0; i < SEANCE_COUNT; i++)
+        known += seWhere[i][0] != '\0';
+    return known;
+}
+
+int seanceOffer(int what)
+{
+    static unsigned char asked[SEANCE_COUNT];
+    char msg[320];
+
+    if (what < 0 || what >= SEANCE_COUNT || !guiIsActive() || asked[what])
+        return 0;
+    asked[what] = 1; // once a session: a no, or a search that found nothing, is not asked again
+    snprintf(msg, sizeof(msg), _t("%s is not where RIPPS2 looks. Search the drives RIPPS2 has started for it? Where it is found is remembered for every launch after."),
+             seanceName(what));
+    guiMsgBoxSound(SFX_MESSAGE);
+    if (guiMsgBox(msg, 1, NULL) != 1)
+        return 0;
+    seanceSearch();
+    return seWhere[what][0] != '\0';
+}
+
+// ---- Ember has to be beside its games: one found elsewhere is copied there, when the user says so ----
+
+static int seBring(int what, char *dest)
+{
+    char src[256], dir[256], msg[420];
+    char *slash;
+    int kb;
+    struct stat st;
+
+    if (!seanceGet(what, src, sizeof(src)) && !(seanceOffer(what) && seanceGet(what, src, sizeof(src))))
+        return 0;
+    if (!strcasecmp(src, dest))
+        return 1; // it is there after all
+    snprintf(dir, sizeof(dir), "%s", dest);
+    if ((slash = strrchr(dir, '/')) != NULL)
+        slash[1] = '\0';
+    kb = stat(src, &st) == 0 ? (int)(st.st_size / 1024) : 0;
+    snprintf(msg, sizeof(msg),
+             what == SEANCE_EMBER ? _t("Ember is not in %s, beside the games, and it has to be. RIPPS2 found it at %s: START copies it there (%d KB) and starts the game.") :
+                                    _t("Ember's BIOS (bios.bin) is not in %s, beside Ember. RIPPS2 found one at %s: START copies it there (%d KB) and starts the game."),
+             dir, src, kb);
+    guiMsgBoxSound(SFX_MESSAGE);
+    guiMsgBoxStartOption(_t("COPY AND START"));
+    if (guiMsgBox(msg, 0, NULL) != 2)
+        return 0;
+    if (slash != NULL) {
+        slash[0] = '\0'; // the folder itself: an EMBER folder may not be there yet
+        mkdir(dir, 0777);
+    }
+    snprintf(msg, sizeof(msg), _t("Copying %s"), what == SEANCE_EMBER ? "ember.elf" : "bios.bin");
+    guiRenderTextScreen(msg);
+    if (!ripps2CopyFile(src, dest, what == SEANCE_EMBER ? "ember.elf" : "bios.bin")) { // the progress bar as it copies
+        snprintf(msg, sizeof(msg), _t("%s could not be copied to %s. Is the drive full or write-protected?"), what == SEANCE_EMBER ? "ember.elf" : "bios.bin", dest);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(msg, 0, NULL);
+        return 0;
+    }
+    return 1;
+}
+
+// Just before a launch (opl.c): an Ember game on a BDM drive (USB, the exFAT HDD, MX4SIO, iLink) whose EMBER folder lacks
+// ember.elf or bios.bin is offered the ones SEANCE found on another drive, copied there first. RiptOPL's launch legs then
+// find them where they always look; they are not touched (their host harnesses copy them word for word). A no, or none
+// found, and the launch goes on and says what is missing, as it always has.
+void seancePreLaunch(item_list_t *support, int id)
+{
+    static const struct
+    {
+        int what;
+        const char *file;
+    } need[2] = {{SEANCE_EMBER, EMBER_ELF_NAME}, {SEANCE_EMBER_BIOS, EMBER_BIOS_NAME}};
+    char path[64];
+    int mode, kind = -1, i;
+
+    if (support == NULL)
+        return;
+    mode = support->mode;
+    if (mode == MIX_MODE) {
+        kind = mixGetItemKind(id);
+        mode = mixGetItemSourceMode(id);
+    } else if (mode == FAV_MODE) {
+        kind = favGetItemKind(id);
+        mode = favGetItemSourceMode(id);
+    } else if (support->itemGet != NULL) {
+        int view = support->itemGetView != NULL ? support->itemGetView(support, id) : libListViewActive(support);
+        const base_game_info_t *game = view == LIB_VIEW_PS1 ? (const base_game_info_t *)support->itemGet(support, id) : NULL;
+        if (game != NULL && cueIsCueEntry(game))
+            kind = FAV_KIND_CUE;
+    }
+    if (kind != FAV_KIND_CUE || mode < BDM_MODE || mode > BDM_MODE_LAST)
+        return;
+    for (i = 0; i < 2; i++) {
+        snprintf(path, sizeof(path), "mass%d:/%s/%s", mode - BDM_MODE, cueEmberFolder(), need[i].file);
+        if (!seExists(path) && !seBring(need[i].what, path))
+            return;
+    }
+}
+
+int seanceHook(int what, int mode, const char *devPrefix, char *path, int pathSize)
+{
+    (void)devPrefix;
+    if (!gSeanceLaunching || what < 0 || what >= SEANCE_COUNT || path == NULL)
+        return 0;
+    switch (mode) {
+        case SEANCE_MODE_LOOKUP:
+            return seanceGet(what, path, pathSize);
+        case SEANCE_MODE_LAST:
+            return seanceOffer(what) && seanceGet(what, path, pathSize);
+        case SEANCE_MODE_NOTE:
+            seanceNote(what, path);
+            return 1;
+        case SEANCE_MODE_BRING:
+            return (what == SEANCE_EMBER || what == SEANCE_EMBER_BIOS) && seBring(what, path);
+    }
+    return 0;
+}
