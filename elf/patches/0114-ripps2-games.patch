+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Fpatches%2F0107-ripps2-search.patch",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Fpatches%2F0107-ripps2-search.patch?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -0,0 +1,286 @@\n+diff --git a/src/ripps2disc.c b/src/ripps2disc.c\n+index c32550b..27c17d3 100644\n+--- a/src/ripps2disc.c\n++++ b/src/ripps2disc.c\n+@@ -132,6 +132,8 @@ static const unsigned short rdGuessKbs[RD_DEST_COUNT][2] = {{800, 800}, {1400, 2\n+ static int rdDest = RD_DEST_OTHER;\n+ static char rdEstBase[200]; // where media is to go, before its folder is picked (MEDIA's drive)\n+ \n++static void rdMinutes(int mins, int left, char *out, int size); // \"ABOUT 12 MIN\", below with the estimate\n++\n+ // progress\n+ static u64 rdDone = 0;\n+ static double rdBegan = 0, rdDrawnAt = 0;\n+diff --git a/src/ripps2files.c b/src/ripps2files.c\n+index c650dec..39e41c1 100644\n+--- a/src/ripps2files.c\n++++ b/src/ripps2files.c\n+@@ -2025,9 +2025,10 @@ static void fbHint(int icon, const char *text, int *x, int y); // drawn with the\n+ static void fbHintLayout(void);\n+ static int fbHintX = 34, fbHintGap = 18; // where every hint row starts, and its gap (fbHintLayout)\n+ // build 69: ORBITS took HDD MANAGER's tile (the HDD MANAGER is Square on an internal APA drive now)\n+-enum { FB_TILE_BROWSER = 0, FB_TILE_EDITOR, FB_TILE_ORBITS, FB_TILE_EXPLOIT, FB_TILE_POWER, FB_TILE_EXIT, FB_TILE_COUNT };\n+-static const char *const fbTileLine1[FB_TILE_COUNT] = {N_(\"FILE\"), N_(\"TEXT\"), \"ORBIT\", N_(\"MC EXPLOIT\"), N_(\"POWER\"), N_(\"EXIT\")};\n+-static const char *const fbTileLine2[FB_TILE_COUNT] = {N_(\"BROWSER\"), N_(\"EDITOR\"), N_(\"SETTINGS\"), N_(\"INSTALLER\"), N_(\"OFF\"), N_(\"BROWSER\")};\n++// build 107: SEARCH took MC EXPLOIT INSTALLER's tile (the user's request)\n++enum { FB_TILE_BROWSER = 0, FB_TILE_EDITOR, FB_TILE_ORBITS, FB_TILE_SEARCH, FB_TILE_POWER, FB_TILE_EXIT, FB_TILE_COUNT };\n++static const char *const fbTileLine1[FB_TILE_COUNT] = {N_(\"FILE\"), N_(\"TEXT\"), \"ORBIT\", N_(\"SEARCH\"), N_(\"POWER\"), N_(\"EXIT\")};\n++static const char *const fbTileLine2[FB_TILE_COUNT] = {N_(\"BROWSER\"), N_(\"EDITOR\"), N_(\"SETTINGS\"), N_(\"FILES\"), N_(\"OFF\"), N_(\"BROWSER\")};\n+ #define FB_TILE_W   172\n+ #define FB_TILE_H   150\n+ #define FB_TILE_GAP 14\n+@@ -2048,61 +2049,198 @@ static void fbGridShow(int open)\n+     fbGridAt = clock();\n+ }\n+ \n+-// An installer the user keeps for their memory cards (FreeMcBoot, OpenTuna, wLaunchELF R3Z...)\n+-static int fbFindInstallers(char found[][96], int max)\n++// ---- SEARCH (build 107): any file or folder by name, on every drive the browser lists ----\n++// Folders are walked breadth first from each drive's top (a queue on the heap, one folder open at a time, so a memory\n++// card's or an MMCE's driver never holds more than one), up to 10 levels down; a name containing what was typed\n++// (any case) is a result, 150 at most. The screen says how far it has got; back stops it, keeping what it found.\n++// Results open in the tree where they are, the cursor on them.\n++static int fbHeldStep(int key); // below, with the tree's input\n++static void fbGlyph(int kind, int x, int y, u64 col); // below, with its drawing\n++#define FB_FIND_MAX   150\n++#define FB_FIND_DEPTH 10\n++#define FB_FIND_QUEUE 600\n++#define FB_FIND_PATH  200\n++static char fbFindTerm[48];\n++static char (*fbFound)[FB_FIND_PATH] = NULL; // full paths; a folder's ends in '/'\n++static int fbFoundCount = 0, fbFindDirs = 0;\n++\n++static int fbNameHas(const char *name, const char *term)\n++{\n++    int n = strlen(term), i;\n++    for (i = 0; name[i]; i++)\n++        if (!strncasecmp(name + i, term, n))\n++            return 1;\n++    return 0;\n++}\n++\n++static void fbFindFrame(const char *where)\n+ {\n+-    static const char *const folders[] = {\"mc0:/APPS/\", \"mc1:/APPS/\", \"mc0:/BOOT/\", \"mc1:/BOOT/\", \"mass0:/\", \"mass0:/APPS/\", NULL};\n+-    static const char *const keys[] = {\"fmcb\", \"install\", \"tuna\", \"r3z\", \"booter\", NULL};\n+-    int i, n = 0;\n+-    for (i = 0; folders[i] != NULL && n < max; i++) {\n+-        DIR *d = opendir(folders[i]);\n+-        struct dirent *de;\n+-        if (d == NULL)\n++    char line[64];\n++    int x;\n++    rmStartFrame();\n++    ripps2DrawBackground();\n++    ripps2DrawPagePanel();\n++    fntRenderString(gTheme->fonts[4], 320, 196, ALIGN_CENTER, 0, 0, _t(\"SEARCHING\"), FB_LIT);\n++    snprintf(line, sizeof(line), _t(\"%d FOLDERS, %d FOUND\"), fbFindDirs, fbFoundCount);\n++    fntRenderString(gTheme->fonts[5], 320, 224, ALIGN_CENTER, 0, 0, line, FB_SOFT);\n++    fntRenderStringFit(gTheme->fonts[5], 320, 248, ALIGN_CENTER, 540, where, FB_DIM, 0);\n++    x = 320 - (24 + ripps2HintWidth(_t(\"STOP\"))) / 2;\n++    fbHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, _t(\"STOP\"), &x, 440);\n++    rmEndFrame();\n++}\n++\n++// 1 when it ran to the end, 0 when back stopped it\n++static int fbFindWalk(void)\n++{\n++    char(*queue)[FB_FIND_PATH] = malloc(FB_FIND_QUEUE * FB_FIND_PATH);\n++    unsigned char *depth = malloc(FB_FIND_QUEUE);\n++    int head = 0, tail = 0, i, stopped = 0, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;\n++    double drawn = 0;\n++\n++    if (queue == NULL || depth == NULL) {\n++        free(queue);\n++        free(depth);\n++        return 1;\n++    }\n++    for (i = 0; i < fbDevCacheCount && tail < FB_FIND_QUEUE; i++) // the drives the browser lists (its last look)\n++        if (fbDevCache[i].kind == FB_KIND_DEVICE && strcmp(fbDevCache[i].name, \"hdd0:\") != 0) {\n++            snprintf(queue[tail], FB_FIND_PATH, \"%s\", fbDevCache[i].name);\n++            depth[tail++] = 0;\n++        }\n++    while (head < tail && fbFoundCount < FB_FIND_MAX && !stopped) {\n++        char dir[FB_FIND_PATH]; // its own copy: the queue it came from takes the folders found in it\n++        int level = depth[head % FB_FIND_QUEUE];\n++        DIR *d;\n++        struct dirent *e;\n++        memcpy(dir, queue[head % FB_FIND_QUEUE], FB_FIND_PATH);\n++        head++;\n++        if (ripps2Seconds() - drawn > 0.15) {\n++            drawn = ripps2Seconds();\n++            fbFindFrame(dir);\n++            readPads();\n++            if (getKeyOn(backKey)) {\n++                stopped = 1;\n++                break;\n++            }\n++        }\n++        if ((d = opendir(dir)) == NULL)\n+             continue;\n+-        while (n < max && (de = readdir(d)) != NULL) {\n+-            char low[FB_NAME];\n+-            int k, j;\n+-            if (!fbHasSuffix(de->d_name, \".elf\"))\n++        fbFindDirs++;\n++        while (fbFoundCount < FB_FIND_MAX && (e = readdir(d)) != NULL) {\n++            int isDir, len = strlen(dir) + strlen(e->d_name);\n++            if (e->d_name[0] == '.' || len + 2 >= FB_FIND_PATH)\n+                 continue;\n+-            for (j = 0; de->d_name[j] && j < FB_NAME - 1; j++)\n+-                low[j] = (de->d_name[j] >= 'A' && de->d_name[j] <= 'Z') ? de->d_name[j] + 32 : de->d_name[j];\n+-            low[j] = '\\0';\n+-            for (k = 0; keys[k] != NULL; k++)\n+-                if (strstr(low, keys[k]) != NULL) {\n+-                    snprintf(found[n++], 96, \"%s%s\", folders[i], de->d_name);\n+-                    break;\n+-                }\n++#ifdef DT_REG\n++            isDir = e->d_type == DT_DIR ? 1 : e->d_type == DT_REG ? 0 : fbIsDirEntry(dir, e); // a stat only when the driver did not say\n++#else\n++            isDir = fbIsDirEntry(dir, e);\n++#endif\n++            if (fbNameHas(e->d_name, fbFindTerm))\n++                snprintf(fbFound[fbFoundCount++], FB_FIND_PATH, \"%s%s%s\", dir, e->d_name, isDir ? \"/\" : \"\");\n++            if (isDir && level < FB_FIND_DEPTH && tail - head < FB_FIND_QUEUE - 1) {\n++                snprintf(queue[tail % FB_FIND_QUEUE], FB_FIND_PATH, \"%s%s/\", dir, e->d_name);\n++                depth[tail % FB_FIND_QUEUE] = level + 1;\n++                tail++;\n++            }\n+         }\n+         closedir(d);\n+     }\n+-    return n;\n++    free(queue);\n++    free(depth);\n++    return !stopped;\n+ }\n+ \n+-static void fbRunInstaller(void)\n++// The results, a page of them at a time: a name, the folder it is in under it. 1 when one was opened\n++static int fbFindResults(void)\n+ {\n+-    static char found[6][96];\n+-    const char *items[6];\n+-    int n = fbFindInstallers(found, 6), pick = 0, i;\n+-    if (n == 0) {\n+-        guiMsgBox(_t(\"No installer found. Put your memory card exploit installer ELF (FreeMcBoot, OpenTuna, wLaunchELF R3Z...) in APPS on a memory card or USB drive, then choose this again.\"), 0, NULL);\n+-        return;\n+-    }\n+-    if (n > 1) {\n+-        for (i = 0; i < n; i++)\n+-            items[i] = found[i];\n+-        pick = ripps2PickList(items, n);\n+-        if (pick < 0)\n+-            return;\n++    char head[96], name[FB_NAME], parent[256];\n++    int sel = 0, top = 0, rows = 8, i, okKey = gSelectButton, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;\n++    int okIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;\n++\n++    readPads();\n++    while (1) {\n++        int x, y = FB_LIST_Y + 8;\n++        rmStartFrame();\n++        ripps2DrawBackground();\n++        ripps2DrawPagePanel();\n++        snprintf(head, sizeof(head), _t(\"SEARCH: %s   %d FOUND\"), fbFindTerm, fbFoundCount);\n++        fntRenderStringFit(gTheme->fonts[4], FB_X, 30, ALIGN_VCENTER, FB_RIGHT - FB_X, head, FB_LIT, 0);\n++        rmDrawLine(FB_X, 46, FB_RIGHT, 46, FB_PRIM(0x4A, 0x72, 0xDC, 0x60));\n++        for (i = top; i < fbFoundCount && i < top + rows; i++, y += 42) {\n++            const char *p = fbFound[i];\n++            int len = strlen(p), isDir = len > 0 && p[len - 1] == '/', k = len - 1 - isDir;\n++            while (k > 0 && p[k - 1] != '/')\n++                k--;\n++            snprintf(name, sizeof(name), \"%.*s\", len - k - isDir, p + k);\n++            snprintf(parent, sizeof(parent), \"%.*s\", k, p);\n++            if (i == sel) {\n++                rmDrawRect(FB_X - 4, y - 4, FB_RIGHT - FB_X + 8, 40, FB_PRIM(0x1E, 0x3C, 0x96, 0x60));\n++                rmDrawRect(FB_X - 4, y - 4, 3, 40, FB_PRIM(0x6A, 0x9A, 0xFF, 0x80));\n++            }\n++            fbGlyph(isDir ? FB_KIND_DIR : FB_KIND_FILE, FB_X + 4, y + 8, i == sel ? FB_LIT : FB_SOFT);\n++            fntRenderStringFit(gTheme->fonts[8], FB_X + 26, y + 8, ALIGN_VCENTER, FB_RIGHT - FB_X - 30, name, i == sel ? FB_LIT : FB_SOFT, i == sel);\n++            fntRenderStringFit(gTheme->fonts[5], FB_X + 26, y + 26, ALIGN_VCENTER, FB_RIGHT - FB_X - 30, parent, FB_DIM, 0);\n++        }\n++        x = fbHintX;\n++        fbHint(okIcon, _t(\"OPEN\"), &x, 448);\n++        fbHint(backIcon, _t(\"BACK\"), &x, 448);\n++        rmEndFrame();\n++\n++        readPads();\n++        if (fbHeldStep(KEY_UP) && sel > 0) {\n++            sel--;\n++            sfxPlay(SFX_CURSOR);\n++        } else if (fbHeldStep(KEY_DOWN) && sel < fbFoundCount - 1) {\n++            sel++;\n++            sfxPlay(SFX_CURSOR);\n++        } else if (getKeyOn(KEY_L1)) {\n++            sel = sel > rows ? sel - rows : 0;\n++            sfxPlay(SFX_CURSOR);\n++        } else if (getKeyOn(KEY_R1)) {\n++            sel = sel + rows < fbFoundCount ? sel + rows : fbFoundCount - 1;\n++            sfxPlay(SFX_CURSOR);\n++        } else if (getKeyOn(okKey)) { // the tree, in the folder it is in, the cursor on it\n++            const char *p = fbFound[sel];\n++            int len = strlen(p), isDir = len > 0 && p[len - 1] == '/', k = len - 1 - isDir;\n++            while (k > 0 && p[k - 1] != '/')\n++                k--;\n++            snprintf(name, sizeof(name), \"%.*s\", len - k - isDir, p + k);\n++            snprintf(parent, sizeof(parent), \"%.*s\", k, p);\n++            sfxPlay(SFX_CONFIRM);\n++            fbGridOpen = 0;\n++            fbOpenPath(parent, name);\n++            return 1;\n++        } else if (getKeyOn(backKey)) {\n++            sfxPlay(SFX_CANCEL);\n++            return 0;\n++        }\n++        if (sel < top)\n++            top = sel;\n++        if (sel >= top + rows)\n++            top = sel - rows + 1;\n+     }\n+-    char ask[160];\n+-    snprintf(ask, sizeof(ask), _t(\"Run %s?\"), found[pick]);\n+-    if (!guiMsgBox(ask, 1, NULL))\n++}\n++\n++static void fbSearch(void)\n++{\n++    char term[48], msg[200];\n++    int done;\n++\n++    snprintf(term, sizeof(term), \"%s\", fbFindTerm);\n++    if (!guiShowKeyboard(term, sizeof(term)) || term[0] == '\\0')\n+         return;\n+-    char *argv[1] = {found[pick]};\n+-    ripps2PlayLaunchSequence();\n+-    deinit(UNMOUNT_EXCEPTION, IO_MODE_SELECTED_ALL_SPARE);\n+-    sysLoadELFApp(found[pick], NULL, 1, argv, 1, 0);\n+-    ripps2LaunchAborted();\n++    if (fbFound == NULL && (fbFound = malloc(FB_FIND_MAX * FB_FIND_PATH)) == NULL)\n++        return;\n++    snprintf(fbFindTerm, sizeof(fbFindTerm), \"%s\", term);\n++    fbFoundCount = fbFindDirs = 0;\n++    done = fbFindWalk();\n++    if (fbFoundCount == 0) {\n++        snprintf(msg, sizeof(msg), done ? _t(\"Nothing named \\\"%s\\\" on the drives listed. START DRIVES in the drive list starts the rest.\") :\n++                                          _t(\"Stopped before anything named \\\"%s\\\" was found.\"), fbFindTerm);\n++        guiMsgBox(msg, 0, NULL);\n++        return;\n++    }\n++    fbFindResults();\n+ }\n+ \n+ // ---- ORBIT SETTINGS: over the orbs themselves, every change seen as it is made ----\n+@@ -2237,9 +2375,9 @@ static void fbTile(int t)\n+             sfxPlay(SFX_CONFIRM);\n+             fbOrbitsPage();\n+             break;\n+-        case FB_TILE_EXPLOIT:\n++        case FB_TILE_SEARCH: // build 107\n+             sfxPlay(SFX_CONFIRM);\n+-            fbRunInstaller();\n++            fbSearch();\n+             break;\n+         case FB_TILE_POWER:\n+             sfxPlay(SFX_CONFIRM);"
