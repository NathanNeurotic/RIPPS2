+// build 114: the RIPPS2 progress bar, for any long job that has nothing else on screen: the page under a glass panel on
+// the notch panels' frame (580 wide at y 134), what is happening, the name, the bar, how much, how long is left when
+// known, and CANCEL when the job can stop
+void ripps2DrawProgress(const char *head, const char *name, long long done, long long total, const char *left, int cancel)
+{
+    char a[24], b[24], line[96];
+    float p = total > 0 ? (float)((double)done / (double)total) : 0.0f;
+
+    if (p > 1.0f)
+        p = 1.0f;
+    lrSize(done, a, sizeof(a));
+    lrSize(total, b, sizeof(b));
+    snprintf(line, sizeof(line), _t("%s OF %s   %d%%"), a, b, (int)(p * 100.0f));
+    rmStartFrame();
+    zpPage();
+    ripps2DrawPanelGlass(30, 134, 580, 170, 0);
+    fntRenderString(gTheme->fonts[5], 320, 162, ALIGN_CENTER, 0, 0, head, LG_SOFT);
+    fntRenderStringFit(gTheme->fonts[4], 320, 190, ALIGN_CENTER, 520, name, LG_LIT, 1);
+    rmDrawRect(150, 216, 340, 6, GS_SETREG_RGBA(0x03, 0x08, 0x22, 0x80));
+    rmDrawRect(150, 216, (int)(340 * p), 6, GS_SETREG_RGBA(0x4A, 0x8C, 0xF0, 0x80));
+    fntRenderString(gTheme->fonts[5], 320, 246, ALIGN_CENTER, 0, 0, line, LG_SOFT);
+    if (left != NULL && left[0])
+        fntRenderString(gTheme->fonts[5], 320, 270, ALIGN_CENTER, 0, 0, left, lgAlpha(LG_SOFT, 0x50));
+    if (cancel)
+        ripps2HintOneA(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, _t("CANCEL"), 448, 0x80);
+    rmEndFrame();
+}
