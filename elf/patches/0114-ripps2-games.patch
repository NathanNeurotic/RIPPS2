R_CUSTOM_SETTINGS_PATH}}},\n+     {UI_SPACER},\n+     {UI_STRING, CFG_CUSTOMCFGPATH, 1, 1, _STR_HINT_CUSTOM_SETTINGS_PATH, 0, 0, {.stringvalue = {\"\", \"\", NULL}}},\n+     {UI_BREAK},\n+diff --git a/src/gui.c b/src/gui.c\n+index dde4821..c6fb44f 100644\n+--- a/src/gui.c\n++++ b/src/gui.c\n+@@ -600,6 +600,7 @@ static int guiUpdater(int modified)\n+         diaSetVisible(diaConfig, CFG_LBL_AUTOSTARTLAST, showAutoStartLast);\n+         diaSetVisible(diaConfig, CFG_AUTOSTARTLAST, showAutoStartLast);\n+         guiBootLockAutofill(diaConfig); // RIPPS2\n++        ripps2SettingsHomeShow(diaConfig); // RIPPS2 build 109\n+     }\n+     return 0;\n+ }\n+@@ -714,6 +715,7 @@ void guiShowConfig()\n+     // \"Default\" placeholder treatment rather than \"<not set>\".\n+     diaSetShowDefaultWhenEmpty(diaConfig, CFG_CUSTOMCFGPATH, 1);\n+     diaSetString(diaConfig, CFG_CUSTOMCFGPATH, gCustomSettingsPath);\n++    ripps2SettingsHomeBegin(diaConfig); // RIPPS2 build 109: Save Settings To\n+ \n+     diaSetInt(diaConfig, CFG_LASTPLAYED, gRememberLastPlayed);\n+     diaSetInt(diaConfig, CFG_FOLDERNAV, gEnableFolderNav);\n+@@ -747,6 +749,7 @@ reshow_config:\n+         diaGetInt(diaConfig, UICFG_LANG, &langID);\n+         snprintf(gExitPath, sizeof(gExitPath), \"%s\", exitPathEdit);\n+         diaGetString(diaConfig, CFG_CUSTOMCFGPATH, gCustomSettingsPath, sizeof(gCustomSettingsPath));\n++        ripps2SettingsHomeEnd(diaConfig); // RIPPS2 build 109\n+         diaGetInt(diaConfig, CFG_LASTPLAYED, &gRememberLastPlayed);\n+         diaGetInt(diaConfig, CFG_FOLDERNAV, &gEnableFolderNav);\n+         diaGetInt(diaConfig, CFG_AUTOSTARTLAST, &gAutoStartLastPlayed);\n+@@ -3232,6 +3235,7 @@ static int guiSettingsGeneralUpdater(int modified)\n+         diaSetVisible(guiSettingsActiveDialog, CFG_LBL_AUTOSTARTLAST, showAutoStartLast);\n+         diaSetVisible(guiSettingsActiveDialog, CFG_AUTOSTARTLAST, showAutoStartLast);\n+         guiBootLockAutofill(guiSettingsActiveDialog);\n++        ripps2SettingsHomeShow(guiSettingsActiveDialog); // RIPPS2 build 109\n+     }\n+     return 0;\n+ }\n+@@ -3260,6 +3264,7 @@ static int guiSettingsShowGeneral(void)\n+     guiBootLockBegin(ui); // RIPPS2\n+     diaSetShowDefaultWhenEmpty(ui, CFG_CUSTOMCFGPATH, 1);\n+     diaSetString(ui, CFG_CUSTOMCFGPATH, gCustomSettingsPath);\n++    ripps2SettingsHomeBegin(ui); // RIPPS2 build 109: Save Settings To\n+     diaSetInt(ui, CFG_LASTPLAYED, gRememberLastPlayed);\n+     diaSetInt(ui, CFG_FOLDERNAV, gEnableFolderNav);\n+     diaSetInt(ui, CFG_AUTOSTARTLAST, gAutoStartLastPlayed);\n+@@ -3293,6 +3298,7 @@ reshow_general:\n+         diaGetInt(ui, UICFG_LANG, &langID);\n+         snprintf(gExitPath, sizeof(gExitPath), \"%s\", exitPathEdit);\n+         diaGetString(ui, CFG_CUSTOMCFGPATH, gCustomSettingsPath, sizeof(gCustomSettingsPath));\n++        ripps2SettingsHomeEnd(ui); // RIPPS2 build 109\n+         diaGetInt(ui, CFG_LASTPLAYED, &gRememberLastPlayed);\n+         diaGetInt(ui, CFG_FOLDERNAV, &gEnableFolderNav);\n+         diaGetInt(ui, CFG_AUTOSTARTLAST, &gAutoStartLastPlayed);\n+diff --git a/src/mmcesupport.c b/src/mmcesupport.c\n+index 15b0cdb..cbd5a09 100644\n+--- a/src/mmcesupport.c\n++++ b/src/mmcesupport.c\n+@@ -29,6 +29,8 @@\n+ #define NEWLIB_PORT_AWARE\n+ #include <fileXio_rpc.h> // fileXioIoctl, fileXioDevctl\n+ #include <delaythread.h> // DelayThread() -- real-sleep gap in the MMCE card-switch wait\n++#include <unistd.h>\n++#include <fcntl.h>\n+ \n+ static char mmcePrefix[40]; // Contains the full path to the folder where all the games are.\n+ static char mmceArtPrimary[40];\n+@@ -101,6 +103,89 @@ static unsigned char mmceEverResolved = 0;\n+ // forward declaration\n+ static item_list_t mmceGameList;\n+ static void mmceGetDeviceRoot(char *root, size_t size);\n++\n++// RIPPS2 build 109: a fast MMCE boot. The card's game list is kept on the card (RIPPS2.LST beside its CD and DVD\n++// folders): at boot the games show from it at once, then the card is read again in the background (sbReadList, which\n++// now pauses between games for the pads) and the list follows whatever changed. A tester's 180 games took about 5\n++// minutes to list on every boot, with nothing to press until then.\n++#define MMCE_LIST_FILE  \"RIPPS2.LST\"\n++#define MMCE_LIST_MAGIC \"RIPLST01\"\n++#define MMCE_LIST_MAX   4096\n++typedef struct\n++{\n++    char magic[8];\n++    int count, ulsize, itemSize, reserved[3];\n++} mmce_list_hdr_t;\n++static unsigned char mmceListTried; // this card's list was looked for\n++static unsigned char mmceListShown; // the games on screen came from it; the card is still to be read again\n++static unsigned int mmceListSum;    // what the list on the card holds (FNV-1a), so an unchanged list is not written\n++\n++static unsigned int mmceListHash(const base_game_info_t *games, int count, int ulsize)\n++{\n++    const unsigned char *b = (const unsigned char *)games;\n++    unsigned int h = 2166136261u ^ (unsigned int)ulsize;\n++    size_t i, n = (size_t)count * sizeof(base_game_info_t);\n++    for (i = 0; i < n; i++)\n++        h = (h ^ b[i]) * 16777619u;\n++    return h;\n++}\n++\n++// The card's last list, into mmceGames: 1 when it was there and whole\n++static int mmceListLoad(void)\n++{\n++    char path[sizeof(mmcePrefix) + 16];\n++    mmce_list_hdr_t h;\n++    base_game_info_t *games;\n++    int fd, bytes, ok = 0;\n++\n++    snprintf(path, sizeof(path), \"%s%s\", mmcePrefix, MMCE_LIST_FILE);\n++    if ((fd = open(path, O_RDONLY)) < 0)\n++        return 0;\n++    if (read(fd, &h, sizeof(h)) == (int)sizeof(h) && !memcmp(h.magic, MMCE_LIST_MAGIC, 8) && h.itemSize == (int)sizeof(base_game_info_t) &&\n++        h.count > 0 && h.count <= MMCE_LIST_MAX) {\n++        bytes = h.count * (int)sizeof(base_game_info_t);\n++        if ((games = malloc(bytes)) != NULL) {\n++            if (read(fd, games, bytes) == bytes) {\n++                free(mmceGames);\n++                mmceGames = games;\n++                mmceGameCount = h.count;\n++                mmceULSizePrev = h.ulsize;\n++                mmceListSum = mmceListHash(games, h.count, h.ulsize);\n++                ok = 1;\n++            } else\n++                free(games);\n++        }\n++    }\n++    close(fd);\n++    return ok;\n++}\n++\n++// The list just read from the card, kept there for the next boot (only when it changed)\n++static void mmceListSave(void)\n++{\n++    char path[sizeof(mmcePrefix) + 16];\n++    mmce_list_hdr_t h;\n++    unsigned int sum;\n++    int fd, bytes;\n++\n++    if (mmceGames == NULL || mmceGameCount <= 0 || mmceGameCount > MMCE_LIST_MAX)\n++        return;\n++    sum = mmceListHash(mmceGames, mmceGameCount, mmceULSizePrev);\n++    if (sum == mmceListSum)\n++        return;\n++    snprintf(path, sizeof(path), \"%s%s\", mmcePrefix, MMCE_LIST_FILE);\n++    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)\n++        return;\n++    memset(&h, 0, sizeof(h));\n++    memcpy(h.magic, MMCE_LIST_MAGIC, 8);\n++    h.count = mmceGameCount;\n++    h.ulsize = mmceULSizePrev;\n++    h.itemSize = (int)sizeof(base_game_info_t);\n++    bytes = mmceGameCount * (int)sizeof(base_game_info_t);\n++    if (write(fd, &h, sizeof(h)) == (int)sizeof(h) && write(fd, mmceGames, bytes) == bytes)\n++        mmceListSum = sum;\n++    close(fd);\n++}\n+ // The card ROOT (\"mmceN:/\") is where the PS1 library folders live -- POPS/ and EMBER/ alike, exactly\n+ // as on every other device. mmcePrefix is NOT the root: it carries the user's configurable games\n+ // prefix (gMMCEPrefix), which is right for OPL's own data (CD/ DVD/ ART/ CFG/ VMC/) and wrong for a\n+@@ -603,6 +688,11 @@ static int mmceNeedsUpdate(item_list_t *itemList)\n+             return result;\n+     }\n+ \n++    if (mmceListShown) { // build 109: the games on screen came from the card's list: read the card once, in the background\n++        mmceGameList.updateDelay = MMCE_MODE_UPDATE_DELAY;\n++        result = 1;\n++    }\n++\n+     if (mmceULSizePrev == -2) {\n+         // First scan not yet successful. If it wedges on a contended SIO2 bus, sbReadList leaves\n+         // mmceULSizePrev at its -2 sentinel and the tab stays empty; the NOUPDATE latch above would\n+@@ -701,6 +791,8 @@ static int mmceUpdateGameList(item_list_t *itemList)\n+         mmceGameCount = 0;\n+         mmcePs1GameCount = 0;\n+         mmceULSizePrev = -2; // force a fresh scan when a card returns\n++        mmceListTried = mmceListShown = 0; // build 109: and its list is looked for again\n++        mmceListSum = 0;\n+         mmcePs1Scanned = 0;\n+         mmcePs1ScanFailed = 0;\n+         mmcePs1ScanRetries = 0;\n+@@ -726,7 +818,21 @@ static int mmceUpdateGameList(item_list_t *itemList)\n+         result += mmcePs1GameCount;\n+     }\n+     if (view == LIB_VIEW_ISO || view == LIB_VIEW_MIXED) {\n+-        sbReadList(&mmceGames, mmcePrefix, folderGetSub(itemList->mode), &mmceULSizePrev, &mmceGameCount);\n++        const char *sub = folderGetSub(itemList->mode);\n++        int atRoot = sub == NULL || sub[0] == '\\0';\n++        if (atRoot && !mmceListTried) { // build 109: the card's last list, at once; the card is read on the next pass\n++            mmceListTried = 1;\n++            if (mmceListLoad()) {\n++                mmceListShown = 1;\n++                mmceGameList.updateDelay = MMCE_MODE_UPDATE_DELAY;\n++                return result + mmceGameCount;\n++            }\n++        }\n++        sbReadList(&mmceGames, mmcePrefix, sub, &mmceULSizePrev, &mmceGameCount);\n++        if (atRoot && (sbGetReadListError() == 0 || mmceGameCount > 0)) { // the card was read: keep its list for next time\n++            mmceListShown = 0;\n++            mmceListSave();\n++        }\n+         result += mmceGameCount;\n+     }\n+     return result;\n+diff --git a/src/opl.c b/src/opl.c\n+index db164cb..57d7082 100644\n+--- a/src/opl.c\n++++ b/src/opl.c\n+@@ -2581,6 +2581,13 @@ static int createMcSettingsFolder(const char *path)\n+     return 0;\n+ }\n+ \n++// RIPPS2 build 109: a BDM settings path that names its device's type (ata0:/RIPPS2) rather than a mass slot\n++static int isTypedBdmSettingsPath(const char *path)\n++{\n++    return !strncmp(path, \"ata\", 3) || !strncmp(path, \"usb\", 3) || !strncmp(path, \"mx4sio\", 6) || !strncmp(path, \"sd\", 2) ||\n++           !strncmp(path, \"ilink\", 5);\n++}\n++\n+ static int prepareCustomSettingsPath(char *path, int pathLen)\n+ {\n+     int bdmType = BDM_TYPE_UNKNOWN;\n+@@ -4642,7 +4649,11 @@ static void _saveConfig()\n+     // target owns the whole save attempt: whether it succeeds or fails, do not retry onto the boot\n+     // device or an alternate device behind the user's back.\n+     if (customSettingsExplicit) {\n+-        if (lscret > 0 && !writeConfigPathRedirect(customSettingsTarget)) {\n++        // RIPPS2 build 109: a typed BDM path (ata0:, usb0:, mx4sio0:, ...) keeps its own spelling in config.path. The\n++        // massN: it resolved to is only the order the drives came up in this time; the next boot resolves the type\n++        // again and loads that one transport, where an untyped massN: walks every transport first.\n++        const char *redirect = isTypedBdmSettingsPath(gCustomSettingsPath) ? gCustomSettingsPath : customSettingsTarget;\n++        if (lscret > 0 && !writeConfigPathRedirect(redirect)) {\n+             LOG(\"CONFIG could not persist settings redirect for %s\\n\", customSettingsTarget);\n+             gLastSaveErrno = EIO;\n+             lscret = 0;\n+diff --git a/src/ripps2ui.c b/src/ripps2ui.c\n+index 8462384..b1cbf97 100644\n+--- a/src/ripps2ui.c\n++++ b/src/ripps2ui.c\n+@@ -35,6 +35,10 @@\n+ #include \"include/metadb.h\"\n+ #include \"include/iosupport.h\" // build 91: the launch disc reads a game's ICO through its source\n+ #include \"include/texcache.h\"\n++#include \"include/bdmsupport.h\" // build 109: bdmSlotDeviceType, BDM_TYPE_ATA\n++#include \"include/dia.h\"\n++#include \"include/dialogs.h\"    // build 109: Save Settings To\n++#include <sys/stat.h>              // build 109: mkdir, the internal HDD's RIPPS2 folder\n+ #include <libcdvd.h>\n+ #include <fcntl.h>\n+ #include <unistd.h>\n+@@ -1260,6 +1264,85 @@ void ripps2DiscWatch(void)\n+ }\n+ \n+ // The disc watcher's job is all the IO worker has: not worth the loading breath\n++// ---- build 109: Settings > General > Save Settings To ----\n++// Testers asked for the settings on the internal HDD before the memory cards. Internal HDD fills the Custom Settings\n++// Path (config.path, which the load reads first and the save honours) with a RIPPS2 folder on that drive: the exFAT\n++// HDD on BDM ATA, else the APA HDD's OPL partition (pfs:, OPL's own mounted home there).\n++enum { RIPPS2_HOME_CARD = 0, RIPPS2_HOME_HDD, RIPPS2_HOME_CUSTOM };\n++static const char *ripps2HomeNames[] = {N_(\"Memory Card\"), N_(\"Internal HDD\"), N_(\"Custom Path\"), NULL};\n++static const char *ripps2HomeHints[] = {N_(\"Settings go in RIPPS2's own save on a memory card (the one RIPPS2 started from first), as before.\"),\n++                                        N_(\"Settings go in a RIPPS2 folder on the internal HDD (exFAT, or the APA HDD's OPL partition) and are read from there first.\"),\n++                                        N_(\"Settings go in the folder typed below, e.g. mass0:/OPL.\"), NULL};\n++\n++// The exFAT HDD is named by its TYPE, ata0:/RIPPS2, never by its mass slot: a slot number is only the order the drives\n++// came up in (a USB stick can take mass0), and an untyped massN: at boot walks every transport (USB, MX4SIO, then iLink\n++// and ATA) before the HDD answers. ata0: loads the ATA stack alone and is found by its RIPPS2 folder, so the folder is\n++// made here, before Save Changes looks for it.\n++int ripps2SettingsHddHome(char *out, int size)\n++{\n++    char dir[24];\n++    int i;\n++    for (i = 0; i < 8; i++)\n++        if (bdmSlotDeviceType(i) == BDM_TYPE_ATA) { // the internal exFAT HDD\n++            snprintf(dir, sizeof(dir), \"mass%d:/RIPPS2\", i);\n++            mkdir(dir, 0777); // there already after the first save\n++            snprintf(out, size, \"ata0:/RIPPS2\");\n++            return 1;\n++        }\n++    if (gHDDPrefix != NULL && gHDDPrefix[0] != '\\0') { // the APA HDD, OPL's partition mounted\n++        snprintf(out, size, \"pfs:/RIPPS2\");\n++        return 1;\n++    }\n++    return 0;\n++}\n++\n++// Which choice a Custom Settings Path amounts to\n++static int ripps2SettingsHomeOf(const char *path)\n++{\n++    if (path == NULL || path[0] == '\\0')\n++        return RIPPS2_HOME_CARD;\n++    if (!strcmp(path, \"pfs:/RIPPS2\") || !strcmp(path, \"ata0:/RIPPS2\"))\n++        return RIPPS2_HOME_HDD;\n++    // build 109's first spelling: still the internal HDD, written as ata0: on the next save\n++    if (!strncmp(path, \"mass\", 4) && path[4] >= '0' && path[4] <= '9' && !strcmp(path + 5, \":/RIPPS2\"))\n++        return RIPPS2_HOME_HDD;\n++    return RIPPS2_HOME_CUSTOM;\n++}\n++\n++void ripps2SettingsHomeShow(struct UIItem *ui)\n++{\n++    int mode;\n++    diaGetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, &mode);\n++    diaSetVisible(ui, CFG_LBL_CUSTOMCFGPATH, mode == RIPPS2_HOME_CUSTOM);\n++    diaSetVisible(ui, CFG_CUSTOMCFGPATH, mode == RIPPS2_HOME_CUSTOM);\n++}\n++\n++void ripps2SettingsHomeBegin(struct UIItem *ui)\n++{\n++    diaSetEnum(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2HomeNames);\n++    diaSetEnumHints(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2HomeHints);\n++    diaSetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2SettingsHomeOf(gCustomSettingsPath));\n++    ripps2SettingsHomeShow(ui);\n++}\n++\n++// After the dialog read CFG_CUSTOMCFGPATH into gCustomSettingsPath: the choice decides what it holds\n++void ripps2SettingsHomeEnd(struct UIItem *ui)\n++{\n++    char hdd[sizeof(gCustomSettingsPath)];\n++    int mode = RIPPS2_HOME_CUSTOM;\n++\n++    diaGetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, &mode);\n++    if (mode == RIPPS2_HOME_CARD)\n++        gCustomSettingsPath[0] = '\\0';\n++    else if (mode == RIPPS2_HOME_HDD) {\n++        if (ripps2SettingsHddHome(hdd, sizeof(hdd)))\n++            snprintf(gCustomSettingsPath, sizeof(gCustomSettingsPath), \"%s\", hdd);\n++        else if (ripps2SettingsHomeOf(gCustomSettingsPath) != RIPPS2_HOME_HDD)\n++            guiShowToast(_t(\"NO INTERNAL HDD FOUND: SETTINGS STAY WHERE THEY ARE\"));\n++    } else if (ripps2SettingsHomeOf(gCustomSettingsPath) == RIPPS2_HOME_CARD) // Custom Path left blank: as before\n++        diaSetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, RIPPS2_HOME_CARD);\n++}\n++\n+ int ripps2DiscQuiet(void)\n+ {\n+     int t, n = 0, mine = discPollBusy + ripps2ShotBusy(); // build 108: RIPSHOT's blank roll is quiet work too\n+diff --git a/src/supportbase.c b/src/supportbase.c\n+index f1bfc8d..1179eb5 100644\n+--- a/src/supportbase.c\n++++ b/src/supportbase.c\n+@@ -30,6 +30,7 @@\n+ #include \"include/hddsupport.h\"\n+ #include \"include/mmcesupport.h\"\n+ #include \"include/metadb.h\" // RIPPS2: the metadata database\n++#include <delaythread.h>    // RIPPS2 build 109: sbPadBreath\n+ #include \"include/ripps2.h\" // RIPPS2 build 77: ripps2NeutrinoOffer\n+ \n+ #define NEWLIB_PORT_AWARE\n+@@ -333,6 +334,15 @@ static int queryISOGameListCache(const struct game_cache_list *cache, base_game_\n+ \n+ static int sbReadListErrno; // see sbGetReadListError\n+ \n++// RIPPS2 build 109: an MMCE card shares SIO2 with the pads. Its list scan kept the bus busy from the first game to the\n++// last, so on a big library nothing could be pressed until it ended (a tester: 180 games, about 5 minutes). A short\n++// pause after each entry, and a frame after each game whose disc had to be read, hands the bus back to the pads.\n++static void sbPadBreath(const char *path, int us)\n++{\n++    if (!strncmp(path, \"mmce\", 4))\n++        DelayThread(us);\n++}\n++\n+ int sbGetReadListError(void)\n+ {\n+     return sbReadListErrno;\n+@@ -367,6 +377,8 @@ static int scanForISO(char *path, char type, struct game_list_t **glist, struct\n+             int NameLen;\n+             int format = isValidIsoName(dirent->d_name, &NameLen);\n+ \n++            sbPadBreath(path, 1000); // build 109\n++\n+             if (format <= 0 || NameLen > ISO_GAME_NAME_MAX) {\n+                 // Not a launchable ISO. With folder browsing on, a subdirectory here becomes a\n+                 // GAME_FORMAT_FOLDER row. d_type is untrustworthy on MMCE clone firmware (mmceman\n+@@ -445,6 +457,7 @@ static int scanForISO(char *path, char type, struct game_list_t **glist, struct\n+                 game->extension[sizeof(game->extension) - 1] = '\\0';\n+ \n+                 fileXioUmount(\"iso:\");\n++                sbPadBreath(path, 17000); // build 109: a frame for the pads after a disc read\n+             }\n+ \n+             game->parts = 1;"
+      },
