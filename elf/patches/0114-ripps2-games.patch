orator)\n+ {\n+     char elemProp[64];\n++    const char *value = NULL;\n+ \n+     items_list_t *itemsList = (items_list_t *)malloc(sizeof(items_list_t));\n+ \n+@@ -3948,8 +4009,22 @@ static void initItemsList(const char *themePath, config_set_t *themeConfig, them\n+     itemsList->hidden = 0;\n+     snprintf(elemProp, sizeof(elemProp), \"%s_hidden\", name);\n+     configGetInt(themeConfig, elemProp, &itemsList->hidden);\n++    // build 106: the star, the highlight and the row icons\n++    itemsList->starSide = THM_STAR_LEFT;\n++    snprintf(elemProp, sizeof(elemProp), \"%s_star\", name);\n++    if (configGetStr(themeConfig, elemProp, &value) && value != NULL)\n++        itemsList->starSide = !strcasecmp(value, \"right\") ? THM_STAR_RIGHT : !strcasecmp(value, \"hidden\") ? THM_STAR_HIDDEN : THM_STAR_LEFT;\n++    itemsList->highlight = THM_HL_BAR;\n++    snprintf(elemProp, sizeof(elemProp), \"%s_highlight\", name);\n++    if (configGetStr(themeConfig, elemProp, &value) && value != NULL)\n++        itemsList->highlight = !strcasecmp(value, \"line\") ? THM_HL_LINE : !strcasecmp(value, \"none\") ? THM_HL_NONE : THM_HL_BAR;\n++    itemsList->starImage = thmListImage(themePath, themeConfig, name, \"star_image\");\n++    itemsList->decoAll = thmListImage(themePath, themeConfig, name, \"decorator_all\");\n++    itemsList->decoKind[0] = thmListImage(themePath, themeConfig, name, \"decorator_ps2\");\n++    itemsList->decoKind[1] = thmListImage(themePath, themeConfig, name, \"decorator_ps1\");\n++    itemsList->decoKind[2] = thmListImage(themePath, themeConfig, name, \"decorator_app\");\n+     elem->extended = itemsList;\n+-    // elem->endElem = &endBasic; does the job\n++    elem->endElem = &endItemsList;\n+ \n+     elem->drawElem = &drawItemsList;\n+ }"
