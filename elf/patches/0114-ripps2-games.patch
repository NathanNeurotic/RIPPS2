+// build 114: a file copied with the progress bar (a launcher brought beside its games: Ember, its BIOS, the POPS
+// files); 1 copied, 0 failed and what was written removed
+int ripps2CopyFile(const char *src, const char *dst, const char *name)
+{
+    int in = open(src, O_RDONLY), out, r, ok = 1;
+    long long total, done = 0;
+    double drawnAt = 0.0;
+    unsigned char *buf;
+
+    if (in < 0)
+        return 0;
+    total = lseek64(in, 0, SEEK_END);
+    if (total < 0 || lseek64(in, 0, SEEK_SET) != 0 || (buf = malloc(64 * 1024)) == NULL) {
+        close(in);
+        return 0;
+    }
+    if ((out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0) {
+        free(buf);
+        close(in);
+        return 0;
+    }
+    ripps2DrawProgress(_t("COPYING"), name, 0, total, NULL, 0);
+    while ((r = read(in, buf, 64 * 1024)) > 0) {
+        if (write(out, buf, r) != r) {
+            ok = 0;
+            break;
+        }
+        done += r;
+        if (ripps2Seconds() - drawnAt >= 0.2) {
+            drawnAt = ripps2Seconds();
+            ripps2DrawProgress(_t("COPYING"), name, done, total, NULL, 0);
+        }
+    }
+    if (r < 0)
+        ok = 0;
+    if (close(out) < 0)
+        ok = 0;
+    close(in);
+    free(buf);
+    if (!ok)
+        unlink(dst);
+    return ok;
+}
+
+// the progress bar, as RIPDISC's rip shows it; 0 when the user asked to stop (and said yes)
+static int zpTick(zp_job_t *j)
+{
+    char left[64];
+    double now = ripps2Seconds();
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    float p = j->work > 0 ? (float)((double)j->done / (double)j->work) : 0.0f;
+
+    readPads();
+    if (getKeyOn(backKey)) {
+        guiMsgBoxSound(SFX_ERROR);
+        if (guiMsgBox(_t("Stop? What it has written so far is removed; the game stays as it was."), 1, NULL))
+            return 0;
+        j->drawnAt = 0.0;
+    }
+    if (now - j->drawnAt < 0.2)
+        return 1;
+    j->drawnAt = now;
+    left[0] = '\0';
+    if (now - j->began > 8.0 && p > 0.005f) {
+        int mins = (int)(((now - j->began) / p - (now - j->began)) / 60.0 + 0.5);
+        if (mins < 1)
+            snprintf(left, sizeof(left), "%s", _t("LESS THAN A MINUTE LEFT"));
+        else
+            snprintf(left, sizeof(left), _t("ABOUT %d MIN"), mins);
+    }
+    ripps2DrawProgress(j->phase == 1 ? _t("CHECKING EVERY PIECE") : j->phase == 2 ? _t("COMPRESSING 1 OF 2") : j->pack ? _t("COMPRESSING 2 OF 2") : _t("UNCOMPRESSING"),
+                       j->name, j->done, j->work, left, 1);
+    return 1;
+}
+
+// build 114 hotfix (the user, 10/24): compression's last step renames the checked .part into the game's place, and an
+// MMCE card renames only from sd2psXtd 1.4.0 on. The card is asked first, with a tiny file beside the game, so older
+// firmware is told in a second rather than after the whole work. 0 only when the rename itself is refused; a card that
+// cannot even take the file is left to the work, which says so in its own words
+static int zpCanRename(const char *dst)
+{
+    char a[310], b[310];
+    int fd, ok;
+
+    snprintf(a, sizeof(a), "%s.rn1", dst);
+    snprintf(b, sizeof(b), "%s.rn2", dst);
+    if ((fd = open(a, O_WRONLY | O_CREAT | O_TRUNC, 0644)) < 0)
+        return 1;
+    ok = write(fd, "R", 1) == 1;
+    close(fd);
+    if (!ok) {
+        unlink(a);
+        return 1;
+    }
+    ok = rename(a, b) == 0;
+    unlink(ok ? b : a);
+    return ok;
+}
+
+static int zpReadAll(int fd, void *buf, int n)
+{
+    unsigned char *p = buf;
+    while (n > 0) { // a read may give back less than asked: carry on
+        int r = read(fd, p, n);
+        if (r <= 0)
+            return 0;
+        p += r;
+        n -= r;
+    }
+    return 1;
+}
+
+static int zpWriteAll(int fd, const void *buf, int n)
+{
+    const unsigned char *p = buf;
+    while (n > 0) {
+        int r = write(fd, p, n);
+        if (r <= 0)
+            return 0;
+        p += r;
+        n -= r;
+    }
+    return 1;
+}
+
+// The new image goes to the drive in whole ZP_STAGE pieces, from a 64-byte-aligned buffer, at positions that are
+// multiples of it; the rest is the last write (zpOutFlush). The lab, 10/23 (SCPS_150.13.POINIES POIN.zso.part, studied on
+// the PC): written as packed, in writes of any length, the drive layer now and then put a cluster's data over the one
+// before it, inside a single write, and every cluster after landed one further back. RIPPS2's aligned writers (RIPDISC's
+// rips, Memory Files' copies) never did.
+static int zpOut(zp_job_t *j, const void *data, int n)
+{
+    const unsigned char *p = data;
+    while (n > 0) {
+        int take = j->stageSize - j->fill < n ? j->stageSize - j->fill : n;
+        memcpy(j->stage + j->fill, p, take);
+        j->fill += take;
+        p += take;
+        n -= take;
+        if (j->fill == j->stageSize) {
+            if (!zpWriteAll(j->fdOut, j->stage, j->stageSize))
+                return 0;
+            j->fill = 0;
+        }
+    }
+    return 1;
+}
+
+static int zpOutFlush(zp_job_t *j)
+{
+    int n = j->fill;
+    j->fill = 0;
+    return n == 0 || zpWriteAll(j->fdOut, j->stage, n);
+}
+
+// a ZSO read straight through, two handles on it: the index from just after the header, the data from where it starts
+// (no seek after the first: the lab found a read-back that seeked about between them going wrong on exFAT)
+typedef struct
+{
+    int fdI, fdD, align;
+    u32 next; // the entry after the last piece's, carried to the next piece (its first)
+} zp_reader_t;
+
+static int zpOpenRead(zp_reader_t *zr, const char *path, int align)
+{
+    u32 first;
+    s64 start;
+    zr->align = align;
+    zr->fdI = open(path, O_RDONLY);
+    zr->fdD = open(path, O_RDONLY);
+    if (zr->fdI < 0 || zr->fdD < 0 || lseek64(zr->fdI, ZP_HEAD, SEEK_SET) != ZP_HEAD || !zpReadAll(zr->fdI, &first, 4))
+        return 0;
+    zr->next = first;
+    start = (s64)(first & 0x7FFFFFFF) << align;
+    return lseek64(zr->fdD, start, SEEK_SET) == start;
+}
+
+static void zpCloseRead(zp_reader_t *zr)
+{
+    if (zr->fdI >= 0)
+        close(zr->fdI);
+    if (zr->fdD >= 0)
+        close(zr->fdD);
+    zr->fdI = zr->fdD = -1;
+}
+
+// ISO to ZSO, written straight through. The lab (10/23): ps2sdk's exFAT driver lost whole 32 KB clusters of a file that
+// was written at two places, or that grew beside another file. So: first every block's packed size, into a side file
+// (<name>.zso.idx, the only file growing then; the top bit says a block is kept raw); then the header, the index worked
+// out from those sizes, and the data, packed again (LZ4 gives the same bytes, and each block is held to its size), all
+// one stream. 1 done, 0 failed, -1 stopped
+static int zpPack(zp_job_t *j, const char *sizesPath, unsigned char *in, unsigned char *out, unsigned char *blk, u32 *idx)
+{
+    unsigned short *sz = (unsigned short *)idx; // ZP_IDX * 2 sizes at a time
+    unsigned char head[ZP_HEAD];
+    u32 b, k, unit, nSz, *ent = (u32 *)out;
+    s64 pos, worst;
+    int cnt, n, o, fdS, got;
+
+    // pass one: the sizes
+    if ((fdS = open(sizesPath, O_WRONLY | O_CREAT | O_TRUNC, 0644)) < 0) {
+        zpWhy(j, "making the sizes file", 0);
+        return 0;
+    }
+    j->phase = 2;
+    for (b = 0, nSz = 0; b < j->blocks; b += cnt) {
+        cnt = j->blocks - b > ZP_RUN ? ZP_RUN : (int)(j->blocks - b);
+        if (!zpReadAll(j->fdIn, in, cnt * 2048)) {
+            zpWhy(j, "reading the ISO", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+        j->crcs[b / ZP_RUN] = crc32(0L, in, cnt * 2048);
+        for (k = 0; k < (u32)cnt; k++) {
+            n = zpLz4(in + k * 2048, 2048, blk, 2048 + 64);
+            sz[nSz++] = (unsigned short)(n <= 0 || n >= 2048 ? 0x8000 | 2048 : n); // a block LZ4 cannot shrink: kept raw
+            if (nSz == ZP_IDX * 2) {
+                if (!zpWriteAll(fdS, sz, nSz * 2)) {
+                    zpWhy(j, "writing the sizes", (s64)(b + k) * 2048);
+                    close(fdS);
+                    return 0;
+                }
+                nSz = 0;
+            }
+        }
+        j->done += cnt * 2048;
+        if (!zpTick(j)) {
+            close(fdS);
+            return -1;
+        }
+    }
+    if ((nSz && !zpWriteAll(fdS, sz, nSz * 2)) || close(fdS) < 0) {
+        zpWhy(j, "writing the sizes", j->inBytes);
+        return 0;
+    }
+
+    // the header
+    worst = ZP_HEAD + (s64)(j->blocks + 1) * 4 + (s64)j->blocks * 2048;
+    for (j->align = 0; ((worst + (s64)j->blocks * ((1 << j->align) - 1)) >> j->align) >= 0x7FFFFFFF; j->align++)
+        ;
+    unit = 1u << j->align;
+    memset(head, 0, sizeof(head));
+    *(u32 *)(head + 0) = ZP_MAGIC;
+    *(u32 *)(head + 4) = ZP_HEAD;
+    *(u32 *)(head + 8) = (u32)(j->inBytes & 0xFFFFFFFF);
+    *(u32 *)(head + 12) = (u32)(j->inBytes >> 32);
+    *(u32 *)(head + 16) = 2048;
+    head[20] = 1;
+    head[21] = (unsigned char)j->align;
+    if (!zpOut(j, head, ZP_HEAD)) {
+        zpWhy(j, "writing the header", 0);
+        return 0;
+    }
+
+    // the index, from the sizes: where each block starts (on the alignment's boundary), then where the last ends
+    if ((fdS = open(sizesPath, O_RDONLY)) < 0) {
+        zpWhy(j, "reading the sizes", 0);
+        return 0;
+    }
+    pos = ZP_HEAD + (s64)(j->blocks + 1) * 4;
+    pos += (unit - (pos & (unit - 1))) & (unit - 1);
+    for (b = 0; b < j->blocks; b += got) {
+        got = j->blocks - b > ZP_IDX ? ZP_IDX : (int)(j->blocks - b);
+        if (!zpReadAll(fdS, sz, got * 2)) {
+            zpWhy(j, "reading the sizes", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+        for (k = 0; k < (u32)got; k++) {
+            ent[k] = (u32)(pos >> j->align) | (sz[k] & 0x8000 ? 0x80000000u : 0);
+            pos += sz[k] & 0x7FFF;
+            pos += (unit - (pos & (unit - 1))) & (unit - 1);
+        }
+        if (!zpOut(j, ent, got * 4)) {
+            zpWhy(j, "writing the index", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+    }
+    close(fdS);
+    ent[0] = (u32)(pos >> j->align); // where the last block ends
+    j->outBytes = pos;
+    pos = ZP_HEAD + (s64)(j->blocks + 1) * 4;
+    n = (int)((unit - (pos & (unit - 1))) & (unit - 1));
+    memset(ent + 1, 0, 16);
+    if (!zpOut(j, ent, 4) || (n && !zpOut(j, ent + 1, n))) {
+        zpWhy(j, "writing the index", j->inBytes);
+        return 0;
+    }
+
+    // pass two: the data, packed again and held to the sizes, straight on
+    if (lseek64(j->fdIn, 0, SEEK_SET) != 0 || (fdS = open(sizesPath, O_RDONLY)) < 0) {
+        zpWhy(j, "reading the ISO again", 0);
+        return 0;
+    }
+    j->phase = 0;
+    for (b = 0; b < j->blocks; b += cnt) {
+        cnt = j->blocks - b > ZP_RUN ? ZP_RUN : (int)(j->blocks - b);
+        if (!zpReadAll(j->fdIn, in, cnt * 2048) || !zpReadAll(fdS, sz, cnt * 2)) {
+            zpWhy(j, "reading the ISO again", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+        if (crc32(0L, in, cnt * 2048) != j->crcs[b / ZP_RUN]) {
+            zpWhy(j, "the ISO read differently the second time", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+        for (k = 0, o = 0; k < (u32)cnt; k++) {
+            int raw, len, pad;
+            n = zpLz4(in + k * 2048, 2048, blk, 2048 + 64);
+            raw = n <= 0 || n >= 2048;
+            len = raw ? 2048 : n;
+            if ((raw ? 0x8000 | 2048 : n) != sz[k]) {
+                zpWhy(j, "a block packed differently the second time", (s64)(b + k) * 2048);
+                close(fdS);
+                return 0;
+            }
+            memcpy(out + o, raw ? in + k * 2048 : blk, len);
+            o += len;
+            pad = (int)((unit - ((u32)o & (unit - 1))) & (unit - 1)); // o starts each run on a boundary, as pos does
+            memset(out + o, 0, pad);
+            o += pad;
+        }
+        if (!zpOut(j, out, o)) {
+            zpWhy(j, "writing the ZSO", (s64)b * 2048);
+            close(fdS);
+            return 0;
+        }
+        j->done += cnt * 2048;
+        if (!zpTick(j)) {
+            close(fdS);
+            return -1;
+        }
+    }
+    close(fdS);
+    return 1;
+}
+
+// the next cnt blocks of a ZSO into out, as OPL's own reader does it (LZ4_decompress_fast, 2048 bytes a block)
+static int zpUnzip(zp_reader_t *zr, int cnt, unsigned char *cbuf, int cap, unsigned char *out)
+{
+    u32 ent[ZP_RUN + 1];
+    s64 o0, o1;
+    int k, align = zr->align;
+    ent[0] = zr->next;
+    if (!zpReadAll(zr->fdI, ent + 1, cnt * 4))
+        return 0;
+    zr->next = ent[cnt];
+    o0 = (s64)(ent[0] & 0x7FFFFFFF) << align;
+    o1 = (s64)(ent[cnt] & 0x7FFFFFFF) << align;
+    if (o1 < o0 || o1 - o0 > cap || !zpReadAll(zr->fdD, cbuf, (int)(o1 - o0)))
+        return 0;
+    for (k = 0; k < cnt; k++) {
+        s64 s = ((s64)(ent[k] & 0x7FFFFFFF) << align) - o0, e = ((s64)(ent[k + 1] & 0x7FFFFFFF) << align) - o0;
+        if (e < s || e - s > 2048 + (1 << align))
+            return 0;
+        if (ent[k] & 0x80000000u)
+            memcpy(out + k * 2048, cbuf + s, 2048);
+        else {
+            int used = LZ4_decompress_fast((const char *)cbuf + s, (char *)out + k * 2048, 2048);
+            if (used <= 0 || used > e - s)
+                return 0;
+        }
+    }
+    return 1;
+}
+
+// build 114: what a BDM drive says of itself (see ripps2.h); 0 when it cannot say. Only "mass" drives are asked: their
+// driver is the one RIPPS2 builds; MMCE, the cards and the network keep their own
+int ripps2VolInfo(const char *path, ripps2_vol_t *v)
+{
+    char dev[16];
+    const char *c = path != NULL ? strchr(path, ':') : NULL;
+    unsigned int o[4] = {0, 0, 0, 0};
+    if (c == NULL || strncmp(path, "mass", 4) != 0 || c - path + 1 >= (int)sizeof(dev))
+        return 0;
+    snprintf(dev, sizeof(dev), "%.*s", (int)(c - path + 1), path);
+    if (fileXioDevctl(dev, RIPPS2_DEVCTL_VOLINFO, NULL, 0, o, sizeof(o)) != 0 || o[2] == 0 || o[3] < RIPPS2_FS_FAT12 || o[3] > RIPPS2_FS_EXFAT)
+        return 0;
+    v->freeKb = o[0];
+    v->totalKb = o[1];
+    v->clusterBytes = o[2];
+    v->fsType = o[3];
+    return 1;
+}
+
+const char *ripps2FsName(int fsType)
+{
+    return fsType == RIPPS2_FS_EXFAT ? "exFAT" : fsType == RIPPS2_FS_FAT32 ? "FAT32" : fsType == RIPPS2_FS_FAT16 ? "FAT16" : "FAT12";
+}
+
+void ripps2SizeText(long long bytes, char *out, int size)
+{
+    lrSize(bytes, out, size);
+}
+
+// whole clusters, at least floor bytes and at most 4 MB (a drive formatted with huge clusters still gets aligned pieces)
+int ripps2StageFor(unsigned int clusterBytes, int floor)
+{
+    int n;
+    if (clusterBytes < 512 || clusterBytes > 4 * 1024 * 1024)
+        return floor;
+    n = (int)((floor + clusterBytes - 1) / clusterBytes * clusterBytes);
+    return n > 4 * 1024 * 1024 ? (int)clusterBytes : n;
+}
+
+// ZSO to ISO: 1 done, 0 failed, -1 stopped
+static int zpUnpack(zp_job_t *j, const char *src, unsigned char *in, unsigned char *cbuf, int cap)
+{
+    zp_reader_t zr;
+    u32 b;
+    int cnt, rv = 1;
+    if (!zpOpenRead(&zr, src, j->align)) {
+        zpCloseRead(&zr);
+        zpWhy(j, "opening the ZSO", 0);
+        return 0;
+    }
+    for (b = 0; rv == 1 && b < j->blocks; b += cnt) {
+        cnt = j->blocks - b > ZP_RUN ? ZP_RUN : (int)(j->blocks - b);
+        if (!zpUnzip(&zr, cnt, cbuf, cap, in)) {
+            zpWhy(j, "reading the ZSO", (s64)b * 2048);
+            rv = 0;
+            break;
+        }
+        j->crcs[b / ZP_RUN] = crc32(0L, in, cnt * 2048);
+        if (!zpOut(j, in, cnt * 2048)) {
+            zpWhy(j, "writing the ISO", (s64)b * 2048);
+            rv = 0;
+            break;
+        }
+        j->done += cnt * 2048;
+        if (!zpTick(j))
+            rv = -1;
+    }
+    zpCloseRead(&zr);
+    j->outBytes = j->inBytes;
+    return rv;
+}
+
+#ifdef RIPPS2_GUARD_TEST
+// a test build: which block of a piece that did not match, and how it was stored (the .part is kept to study)
+static char zpSrcPath[300];
+static void zpWhichBlock(zp_job_t *j, u32 b, int cnt, const unsigned char *got)
+{
+    unsigned char *want = malloc(cnt * 2048);
+    int fd = open(zpSrcPath, O_RDONLY), k, i;
+    if (want == NULL || fd < 0 || lseek64(fd, (s64)b * 2048, SEEK_SET) < 0 || read(fd, want, cnt * 2048) != cnt * 2048) {
+        printf("RIPPS2 compression test: could not read the original again\n");
+    } else
+        for (k = 0; k < cnt; k++)
+            if (memcmp(want + k * 2048, got + k * 2048, 2048)) {
+                for (i = 0; i < 2048 && want[k * 2048 + i] == got[k * 2048 + i]; i++)
+                    ;
+                printf("RIPPS2 compression test: block %u differs from byte %d (want %02x got %02x)\n", (unsigned)(b + k), i,
+                       want[k * 2048 + i], got[k * 2048 + i]);
+            }
+    if (fd >= 0)
+        close(fd);
+    free(want);
+}
+#endif
+
+// the check: what was written, read back, piece by piece against the crc taken from the original
+static int zpCheck(zp_job_t *j, const char *path, unsigned char *in, unsigned char *cbuf, int cap)
+{
+    unsigned char head[ZP_HEAD];
+    zp_reader_t zr = {-1, -1, 0, 0};
+    u32 b;
+    int cnt, fd, ok = 1;
+    if ((fd = open(path, O_RDONLY)) < 0) {
+        zpWhy(j, "opening it to check", 0);
+        return 0;
+    }
+    if (j->pack && (!zpReadAll(fd, head, ZP_HEAD) || *(u32 *)head != ZP_MAGIC || head[21] != j->align || !zpOpenRead(&zr, path, j->align))) {
+        zpWhy(j, "checking the header", 0);
+        ok = 0;
+    }
+    for (b = 0; ok == 1 && b < j->blocks; b += cnt) {
+        cnt = j->blocks - b > ZP_RUN ? ZP_RUN : (int)(j->blocks - b);
+        if (!(j->pack ? zpUnzip(&zr, cnt, cbuf, cap, in) : zpReadAll(fd, in, cnt * 2048))) {
+            zpWhy(j, "reading it back", (s64)b * 2048);
+            ok = 0;
+        } else if (crc32(0L, in, cnt * 2048) != j->crcs[b / ZP_RUN]) {
+            zpWhy(j, "a piece read back did not match", (s64)b * 2048);
+            ok = 0;
+#ifdef RIPPS2_GUARD_TEST
+            zpWhichBlock(j, b, cnt, in);
+#endif
+        }
+        j->done += cnt * 2048;
+        if (ok == 1 && !zpTick(j))
+            ok = -1; // stopped: the loop ends here
+    }
+    zpCloseRead(&zr);
+    close(fd);
+    return ok;
+}
