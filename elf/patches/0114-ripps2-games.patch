+        p = 0;
+    tintApplyF(paletteDef[p].hue, paletteDef[p].sat, paletteDef[p].lift, tintBase, o);
+    for (i = 0; i < 3; i++)
+        out[i] = (unsigned char)(o[i] + 0.5f);
+}
