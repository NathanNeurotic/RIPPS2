+          "contents_url": "https://api.github.com/repos/hacan359/Open-PS2-Loader/contents/modules%2Fnetwork%2Frapull%2FMakefile?ref=a9f973974a5fd61707d069961ec0031be19399f7",
+          "patch": "@@ -0,0 +1,8 @@\n+IOP_BIN  = rapull.irx\n+IOP_OBJS = rapull.o imports.o\n+\n+IOP_INCS += -I../common -I../../iopcore/common\n+\n+include $(PS2SDK)/Defs.make\n+include ../../Rules.bin.make\n+include $(PS2SDK)/samples/Makefile.iopglobal"
