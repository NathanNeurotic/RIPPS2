+        "patch": "@@ -284,6 +284,24 @@ jobs:\n           echo \"Staged ps2dev-latest rolling assets:\"\n           ls -la rolling\n \n+      - name: Stage the patched i.LINK driver for the Neutrino bundle (#1018)\n+        # The same IEEE1394_bd_mini.irx the ELF embeds, built from modules/ilink/IEEE1394_bd. Kept out of\n+        # rolling/ (everything there is published as a release asset) and staged before the DS5 build's\n+        # make clean removes it. publish-rolling puts it in neutrino/modules/.\n+        run: |\n+          set -eu\n+          mkdir -p neutrino-ilink\n+          cp -f modules/ilink/IEEE1394_bd/IEEE1394_bd_mini.irx neutrino-ilink/IEEE1394_bd_mini.irx\n+          ls -la neutrino-ilink\n+\n+      - name: Upload the patched i.LINK driver\n+        uses: actions/upload-artifact@v6\n+        with:\n+          name: neutrino-ilink-driver\n+          path: neutrino-ilink\n+          if-no-files-found: error\n+          retention-days: 14\n+\n       - name: Build + stage DualSense (DS5) loader (PS2DEVROLLING)\n         # Named DUALSENSE=1 loader on the ps2dev:latest toolchain. Like the plain PS2DEVROLLING\n         # build this rides the moving SDK tag (may not boot -- issue #102); DS5 owners who want a\n@@ -535,6 +553,14 @@ jobs:\n           name: rolling-assets-ps2dev-latest\n           path: rolling\n \n+      - name: Download the patched i.LINK driver for the Neutrino bundle\n+        # Required, like the ps2dev-latest build that produces it: the bundle must not silently fall\n+        # back to upstream's driver, which loses its login after an IOP reset (#1018).\n+        uses: actions/download-artifact@v8\n+        with:\n+          name: neutrino-ilink-driver\n+          path: neutrino-ilink\n+\n       - name: Download pinned rolling assets\n         # Optional: the pinned fallback build may have failed; publish what we have.\n         continue-on-error: true\n@@ -833,7 +859,9 @@ jobs:\n           # EXTRACTED into a plain folder so the user just drag-and-drops it onto the card (no\n           # zip-in-zip). Both installable ZIPs require it; a failed fetch fails packaging. The archive\n           # root holds neutrino.elf + config/ + modules/, so the neutrino/ folder copies straight to\n-          # mc?:/neutrino/. RiptOPL adds ONLY config/bsd-udpfsbd.toml (UDPFS); else the official build.\n+          # mc?:/neutrino/. RiptOPL adds config/bsd-udpfsbd.toml (UDPFS) and replaces ONE module,\n+          # modules/IEEE1394_bd_mini.irx, with its own build of the same ps2sdk driver (#1018: upstream's\n+          # loses its i.LINK login after an IOP reset); everything else is the official build.\n           # This file is fork-private -- upstream Neutrino will not supply it -- so fail loudly if a\n           # refactor ever drops the source payload instead of publishing an IMG-mode-broken package.\n           if [ ! -s neutrino/bsd-udpfsbd.toml ]; then\n@@ -871,6 +899,20 @@ jobs:\n                 echo \"ERROR: fork-private bsd-udpfsbd.toml did not reach the staged Neutrino config unchanged.\" >&2\n                 exit 1\n               fi\n+              # i.LINK (#1018): replace upstream's driver with RiptOPL's build, which keeps asking for a\n+              # login until the drive releases the one held across the IOP reset. Upstream must still\n+              # ship the file under this name (bsd-ilink.toml loads it); refuse to package otherwise.\n+              ILINK_DST=\"$PKG/neutrino/modules/IEEE1394_bd_mini.irx\"\n+              if [ ! -s \"$ILINK_DST\" ] || [ ! -s neutrino-ilink/IEEE1394_bd_mini.irx ]; then\n+                echo \"ERROR: cannot replace neutrino/modules/IEEE1394_bd_mini.irx (upstream file or RiptOPL build missing).\" >&2\n+                exit 1\n+              fi\n+              cp -f neutrino-ilink/IEEE1394_bd_mini.irx \"$ILINK_DST\"\n+              if ! cmp -s neutrino-ilink/IEEE1394_bd_mini.irx \"$ILINK_DST\"; then\n+                echo \"ERROR: RiptOPL's IEEE1394_bd_mini.irx did not reach the staged Neutrino modules unchanged.\" >&2\n+                exit 1\n+              fi\n+              echo \"Replaced neutrino/modules/IEEE1394_bd_mini.irx with RiptOPL's build ($(wc -c < \"$ILINK_DST\") bytes).\"\n               rm -f \"$NEUT_ABS\"\n               echo \"Extracted Neutrino into $PKG/neutrino (added config/bsd-udpfsbd.toml for UDPFS).\"\n               # UDPFS Files mode launches with stock -bsd=udpfs, which needs Neutrino's own"
