out, int size)\n++// A BDM drive is named by its TYPE (ata0:/RIPPS2, usb0:/RIPPS2, ...), never by its mass slot: a slot number is only the\n++// order the drives came up in (a USB stick can take mass0), and an untyped massN: at boot walks every transport (USB,\n++// MX4SIO, then iLink and ATA) before the drive answers. A typed path loads its one transport and is found by its RIPPS2\n++// folder, so the folder is made here, before Save Changes looks for it.\n++static int ripps2SettingsBdmHome(int type, const char *typed, char *out, int size)\n+ {\n+     char dir[24];\n+     int i;\n+     for (i = 0; i < 8; i++)\n+-        if (bdmSlotDeviceType(i) == BDM_TYPE_ATA) { // the internal exFAT HDD\n++        if (bdmSlotDeviceType(i) == type) {\n+             snprintf(dir, sizeof(dir), \"mass%d:/RIPPS2\", i);\n+             mkdir(dir, 0777); // there already after the first save\n+-            snprintf(out, size, \"ata0:/RIPPS2\");\n++            snprintf(out, size, \"%s:/RIPPS2\", typed);\n+             return 1;\n+         }\n++    return 0;\n++}\n++\n++int ripps2SettingsHddHome(char *out, int size)\n++{\n++    if (ripps2SettingsBdmHome(BDM_TYPE_ATA, \"ata0\", out, size)) // the internal exFAT HDD\n++        return 1;\n+     if (gHDDPrefix != NULL && gHDDPrefix[0] != '\\0') { // the APA HDD, OPL's partition mounted\n+         snprintf(out, size, \"pfs:/RIPPS2\");\n+         return 1;\n+@@ -1296,6 +1308,42 @@ int ripps2SettingsHddHome(char *out, int size)\n+     return 0;\n+ }\n+ \n++// build 110: the MMCE card in either slot\n++static int ripps2SettingsMmceHome(char *out, int size)\n++{\n++    char root[8], dir[16];\n++    int slot;\n++    for (slot = 0; slot < 2; slot++) {\n++        DIR *d;\n++        snprintf(root, sizeof(root), \"mmce%d:\", slot);\n++        if ((d = opendir(root)) == NULL)\n++            continue;\n++        closedir(d);\n++        snprintf(dir, sizeof(dir), \"mmce%d:/RIPPS2\", slot);\n++        mkdir(dir, 0777);\n++        snprintf(out, size, \"%s\", dir);\n++        return 1;\n++    }\n++    return 0;\n++}\n++\n++static int ripps2SettingsDriveHome(int mode, char *out, int size)\n++{\n++    switch (mode) {\n++        case RIPPS2_HOME_HDD:\n++            return ripps2SettingsHddHome(out, size);\n++        case RIPPS2_HOME_USB:\n++            return ripps2SettingsBdmHome(BDM_TYPE_USB, \"usb0\", out, size);\n++        case RIPPS2_HOME_MX4SIO:\n++            return ripps2SettingsBdmHome(BDM_TYPE_SDC, \"mx4sio0\", out, size);\n++        case RIPPS2_HOME_ILINK:\n++            return ripps2SettingsBdmHome(BDM_TYPE_ILINK, \"ilink0\", out, size);\n++        case RIPPS2_HOME_MMCE:\n++            return ripps2SettingsMmceHome(out, size);\n++    }\n++    return 0;\n++}\n++\n+ // Which choice a Custom Settings Path amounts to\n+ static int ripps2SettingsHomeOf(const char *path)\n+ {\n+@@ -1306,6 +1354,14 @@ static int ripps2SettingsHomeOf(const char *path)\n+     // build 109's first spelling: still the internal HDD, written as ata0: on the next save\n+     if (!strncmp(path, \"mass\", 4) && path[4] >= '0' && path[4] <= '9' && !strcmp(path + 5, \":/RIPPS2\"))\n+         return RIPPS2_HOME_HDD;\n++    if (!strcmp(path, \"usb0:/RIPPS2\"))\n++        return RIPPS2_HOME_USB;\n++    if (!strcmp(path, \"mx4sio0:/RIPPS2\"))\n++        return RIPPS2_HOME_MX4SIO;\n++    if (!strcmp(path, \"ilink0:/RIPPS2\"))\n++        return RIPPS2_HOME_ILINK;\n++    if (!strcmp(path, \"mmce0:/RIPPS2\") || !strcmp(path, \"mmce1:/RIPPS2\"))\n++        return RIPPS2_HOME_MMCE;\n+     return RIPPS2_HOME_CUSTOM;\n+ }\n+ \n+@@ -1325,20 +1381,28 @@ void ripps2SettingsHomeBegin(struct UIItem *ui)\n+     ripps2SettingsHomeShow(ui);\n+ }\n+ \n++// build 110: a message box. Settings pages run their own dialog loop, which draws neither toasts nor notices (neither\n++// showed in the lab), so the message is a dialog, as SETTINGS SAVED is.\n++static void ripps2HomeNotice(const char *text)\n++{\n++    guiMsgBox(text, 0, NULL);\n++}\n++\n+ // After the dialog read CFG_CUSTOMCFGPATH into gCustomSettingsPath: the choice decides what it holds\n+ void ripps2SettingsHomeEnd(struct UIItem *ui)\n+ {\n+-    char hdd[sizeof(gCustomSettingsPath)];\n++    char drive[sizeof(gCustomSettingsPath)];\n+     int mode = RIPPS2_HOME_CUSTOM;\n+ \n+     diaGetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, &mode);\n+     if (mode == RIPPS2_HOME_CARD)\n+         gCustomSettingsPath[0] = '\\0';\n+-    else if (mode == RIPPS2_HOME_HDD) {\n+-        if (ripps2SettingsHddHome(hdd, sizeof(hdd)))\n+-            snprintf(gCustomSettingsPath, sizeof(gCustomSettingsPath), \"%s\", hdd);\n+-        else if (ripps2SettingsHomeOf(gCustomSettingsPath) != RIPPS2_HOME_HDD)\n+-            guiShowToast(_t(\"NO INTERNAL HDD FOUND: SETTINGS STAY WHERE THEY ARE\"));\n++    else if (mode != RIPPS2_HOME_CUSTOM) {\n++        if (ripps2SettingsDriveHome(mode, drive, sizeof(drive)))\n++            snprintf(gCustomSettingsPath, sizeof(gCustomSettingsPath), \"%s\", drive);\n++        else if (ripps2SettingsHomeOf(gCustomSettingsPath) != mode)\n++            ripps2HomeNotice(mode == RIPPS2_HOME_HDD ? _t(\"NO INTERNAL HDD FOUND: SETTINGS STAY WHERE THEY ARE\") :\n++                                                       _t(\"THAT DRIVE IS NOT CONNECTED: SETTINGS STAY WHERE THEY ARE\"));\n+     } else if (ripps2SettingsHomeOf(gCustomSettingsPath) == RIPPS2_HOME_CARD) // Custom Path left blank: as before\n+         diaSetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, RIPPS2_HOME_CARD);\n+ }\n+diff --git a/src/supportbase.c b/src/supportbase.c\n+index 1179eb5..5751e75 100644\n+--- a/src/supportbase.c\n++++ b/src/supportbase.c\n+@@ -337,12 +337,18 @@ static int sbReadListErrno; // see sbGetReadListError\n+ // RIPPS2 build 109: an MMCE card shares SIO2 with the pads. Its list scan kept the bus busy from the first game to the\n+ // last, so on a big library nothing could be pressed until it ended (a tester: 180 games, about 5 minutes). A short\n+ // pause after each entry, and a frame after each game whose disc had to be read, hands the bus back to the pads.\n++static int sbBreathAll; // build 110: set while an MX4SIO drive is read (sbSetPadBreath)\n+ static void sbPadBreath(const char *path, int us)\n+ {\n+-    if (!strncmp(path, \"mmce\", 4))\n++    if (sbBreathAll || !strncmp(path, \"mmce\", 4))\n+         DelayThread(us);\n+ }\n+ \n++void sbSetPadBreath(int on)\n++{\n++    sbBreathAll = on;\n++}\n++\n+ int sbGetReadListError(void)\n+ {\n+     return sbReadListErrno;\n+@@ -706,6 +712,102 @@ int sbReadList(base_game_info_t **list, const char *prefix, const char *sub, int\n+     return published;\n+ }\n+ \n++// ---- RIPPS2 build 110: every source's last list ----\n++// Build 109 kept an MMCE card's game list on the card, so a 180-game library listed at once instead of after about 5\n++// minutes. Every source does it now: the list read last time is kept on the source, shown the moment the source\n++// answers, and the source is read again on its next pass, the list following whatever changed.\n++#define SB_SNAP_FILE  \"RIPPS2.LST\"\n++#define SB_SNAP_MAGIC \"RIPLST01\"\n++#define SB_SNAP_MAX   4096\n++typedef struct\n++{\n++    char magic[8];\n++    int count, fsize, itemSize, reserved[3];\n++} sb_snap_hdr_t;\n++\n++static unsigned int sbSnapHash(const base_game_info_t *games, int count, int fsize)\n++{\n++    const unsigned char *b = (const unsigned char *)games;\n++    unsigned int h = 2166136261u ^ (unsigned int)fsize;\n++    size_t i, n = (size_t)count * sizeof(base_game_info_t);\n++    for (i = 0; i < n; i++)\n++        h = (h ^ b[i]) * 16777619u;\n++    return h;\n++}\n++\n++int sbSnapShow(sb_snap_t *snap, const char *prefix, base_game_info_t **list, int *gamecount, int *fsize)\n++{\n++    char path[256];\n++    sb_snap_hdr_t h;\n++    base_game_info_t *games;\n++    int fd, bytes, ok = 0;\n++\n++    if (snap->tried)\n++        return 0;\n++    snap->tried = 1;\n++    snprintf(path, sizeof(path), \"%s%s\", prefix, SB_SNAP_FILE);\n++    if ((fd = open(path, O_RDONLY)) < 0)\n++        return 0;\n++    if (read(fd, &h, sizeof(h)) == (int)sizeof(h) && !memcmp(h.magic, SB_SNAP_MAGIC, 8) && h.itemSize == (int)sizeof(base_game_info_t) &&\n++        h.count > 0 && h.count <= SB_SNAP_MAX) {\n++        bytes = h.count * (int)sizeof(base_game_info_t);\n++        if ((games = malloc(bytes)) != NULL) {\n++            if (read(fd, games, bytes) == bytes) {\n++                free(*list); // as sbReadList publishes a new list\n++                *list = games;\n++                *gamecount = h.count;\n++                if (fsize != NULL)\n++                    *fsize = h.fsize;\n++                snap->sum = sbSnapHash(games, h.count, h.fsize);\n++                snap->shown = ok = 1;\n++            } else\n++                free(games);\n++        }\n++    }\n++    close(fd);\n++    return ok;\n++}\n++\n++void sbSnapScanned(sb_snap_t *snap, const char *prefix, const base_game_info_t *list, int gamecount, int fsize, int readOk)\n++{\n++    char path[256];\n++    sb_snap_hdr_t h;\n++    unsigned int sum;\n++    int fd, bytes;\n++\n++    snap->tried = 1;\n++    snap->shown = 0;\n++    if (!readOk || !gEnableWrite || gamecount > SB_SNAP_MAX)\n++        return;\n++    snprintf(path, sizeof(path), \"%s%s\", prefix, SB_SNAP_FILE);\n++    if (gamecount <= 0 || list == NULL) { // nothing there now: no list to show next time\n++        if (snap->sum != 0)\n++            remove(path);\n++        snap->sum = 0;\n++        return;\n++    }\n++    sum = sbSnapHash(list, gamecount, fsize);\n++    if (sum == snap->sum)\n++        return;\n++    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)\n++        return;\n++    memset(&h, 0, sizeof(h));\n++    memcpy(h.magic, SB_SNAP_MAGIC, 8);\n++    h.count = gamecount;\n++    h.fsize = fsize;\n++    h.itemSize = (int)sizeof(base_game_info_t);\n++    bytes = gamecount * (int)sizeof(base_game_info_t);\n++    if (write(fd, &h, sizeof(h)) == (int)sizeof(h) && write(fd, list, bytes) == bytes)\n++        snap->sum = sum;\n++    close(fd);\n++}\n++\n++void sbSnapForget(sb_snap_t *snap)\n++{\n++    snap->tried = snap->shown = 0;\n++    snap->sum = 0;\n++}\n++\n+ extern int probed_fd;\n+ extern u32 probed_lba;\n+ extern u8 IOBuffer[2048];"
