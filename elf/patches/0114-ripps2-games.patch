 || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'));\n++    return (c >= 0xA0 && c <= 0xBF) || c == 0xD7 || c == 0xF7 || (c >= 0x2000 && c <= 0x206F);\n++}\n++\n++static int trDigit(u32 c)\n++{\n++    return (c >= '0' && c <= '9') || (c >= 0x0660 && c <= 0x0669) || (c >= 0x06F0 && c <= 0x06F9);\n++}\n++\n++static u32 trMirror(u32 c)\n++{\n++    static const u32 pairs[] = {'(', ')', '[', ']', '{', '}', '<', '>', 0xAB, 0xBB, 0};\n++    int i;\n++    for (i = 0; pairs[i]; i += 2) {\n++        if (c == pairs[i])\n++            return pairs[i + 1];\n++        if (c == pairs[i + 1])\n++            return pairs[i];\n++    }\n++    return c;\n++}\n++\n++static void trRtlReverse(int a, int b) // trRtlOut and trRtlDir [a, b) backwards\n++{\n++    for (b--; a < b; a++, b--) {\n++        u32 c = trRtlOut[a];\n++        u8 d = trRtlDir[a];\n++        trRtlOut[a] = trRtlOut[b];\n++        trRtlDir[a] = trRtlDir[b];\n++        trRtlOut[b] = c;\n++        trRtlDir[b] = d;\n++    }\n++}\n++\n++// One line [s, e) of trRtlOut, laid out right to left: the line reads from the right, a run of Latin letters and\n++// numbers keeps its own order inside it, a neutral between two of those goes with them (else with the line), and a\n++// bracket on the right-to-left side turns round\n++static void trRtlLine(int s, int e)\n++{\n++    int i, j;\n++    u8 d;\n++    for (i = s; i < e; i++)\n++        trRtlDir[i] = ripps2RtlChar(trRtlOut[i]) ? 1 : (trNeutral(trRtlOut[i]) ? 2 : 0);\n++    for (i = s; i < e; i++) { // a number keeps its signs: 50% (by a digit), 1.5, 12:00, 3/4 (between two digits)\n++        u32 c = trRtlOut[i];\n++        int before = i > s && trDigit(trRtlOut[i - 1]), after = i + 1 < e && trDigit(trRtlOut[i + 1]);\n++        if (trRtlDir[i] == 2 && ((c == '%' && (before || after)) ||\n++                                 ((c == '.' || c == ',' || c == ':' || c == '/' || c == '+' || c == '-') && before && after)))\n++            trRtlDir[i] = 0; // a full stop after \"PRO2\" ends the sentence: it stays with the line\n++    }\n++    for (i = s; i < e;) {\n++        if (trRtlDir[i] != 2) {\n++            i++;\n++            continue;\n++        }\n++        for (j = i; j < e && trRtlDir[j] == 2; j++)\n++            ;\n++        d = (i > s && trRtlDir[i - 1] == 0 && j < e && trRtlDir[j] == 0) ? 0 : 1;\n++        for (; i < j; i++)\n++            trRtlDir[i] = d;\n++    }\n++    for (i = s; i < e; i++)\n++        if (trRtlDir[i] == 1)\n++            trRtlOut[i] = trMirror(trRtlOut[i]);\n++    // a letter keeps its marks after it, where they are drawn back over it: turned here, put right by the turn below\n++    for (i = s; i < e; i++) {\n++        for (j = i + 1; j < e && trArabMark(trRtlOut[j]); j++)\n++            ;\n++        if (j > i + 1)\n++            trRtlReverse(i, j);\n++        i = j - 1;\n++    }\n++    trRtlReverse(s, e);\n++    for (i = s; i < e;) { // each left-to-right run forwards again\n++        if (trRtlDir[i] != 0) {\n++            i++;\n++            continue;\n++        }\n++        for (j = i; j < e && trRtlDir[j] == 0; j++)\n++            ;\n++        trRtlReverse(i, j);\n++        i = j;\n++    }\n++}\n++\n++const char *ripps2Rtl(const char *in, char *out, int size, int reorder)\n++{\n++    int n = 0, m = 0, i, j, k, a, at = 0, any = 0, prev, next;\n++    u32 c, form;\n++    const u16 *f;\n++    const char *s;\n++\n++    if (in == NULL)\n++        return NULL;\n++    for (s = in; *s;) {\n++        int b = ripps2Utf8Next(s, &c);\n++        if (b <= 0)\n++            break;\n++        if (n == TR_RTL_MAX)\n++            return NULL;\n++        any |= ripps2RtlChar(c);\n++        trRtlIn[n++] = c;\n++        s += b;\n++    }\n++    if (!any)\n++        return NULL;\n++\n++    // 1. joined, in reading order. ZWNJ (Persian) stops a join and goes; ZWJ goes too.\n++    for (i = 0; i < n; i++) {\n++        c = trRtlIn[i];\n++        if (c == 0x200C || c == 0x200D)\n++            continue;\n++        f = trArabForms(c);\n++        if (f == NULL) {\n++            trRtlOut[m++] = c;\n++            continue;\n++        }\n++        for (j = i - 1; j >= 0 && trArabMark(trRtlIn[j]); j--)\n++            ;\n++        prev = j >= 0 && f[2] != 0 && trJoinsNext(trRtlIn[j]);\n++        for (k = i + 1; k < n && trArabMark(trRtlIn[k]); k++)\n++            ;\n++        if (c == 0x0644 && k == i + 1 && k < n) {\n++            for (a = 0; a < 4; a++)\n++                if (trRtlIn[k] == trLamAlef[a][0])\n++                    break;\n++            if (a < 4) {\n++                trRtlOut[m++] = prev ? trLamAlef[a][2] : trLamAlef[a][1];\n++                i = k; // the alef is in it\n++                continue;\n++            }\n++        }\n++        next = k < n && f[3] != 0 && trJoinsPrev(trRtlIn[k]);\n++        form = prev && next ? f[4] : (prev ? f[2] : (next ? f[3] : f[1]));\n++        trRtlOut[m++] = form ? form : c;\n++    }\n++\n++    // 2. each line right to left\n++    if (reorder) {\n++        for (i = 0; i < m;) {\n++            int e, rtl = 0;\n++            for (e = i; e < m && trRtlOut[e] != '\\n'; e++)\n++                rtl |= ripps2RtlChar(trRtlOut[e]);\n++            if (rtl)\n++                trRtlLine(i, e);\n++            i = e + 1;\n++        }\n++    }\n++\n++    for (i = 0; i < m; i++) {\n++        at = ripps2Utf8Put(out, at, size, trRtlOut[i]);\n++        if (at < 0)\n++            return NULL;\n++    }\n++    out[at] = '\\0';\n++    return out;\n++}\n diff --git a/src/ripps2ui.c b/src/ripps2ui.c\n index 88e8159..4c43dd2 100644\n --- a/src/ripps2ui.c"
