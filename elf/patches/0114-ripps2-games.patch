+// The game's id in its source's own list (forced view), by name; -1 when it is not there
+static int hgFind(int mode, int ps1, const char *name)
+{
+    opl_io_module_t *mod = oplGetModule(mode);
+    item_list_t view;
+    int i, count;
+    if (mod == NULL || mod->support == NULL)
+        return -1;
+    view = *mod->support;
+    view.viewOverride = ps1 ? ITEM_VIEW_FORCE_PS1 : ITEM_VIEW_FORCE_ISO;
+    count = view.itemGetCount != NULL ? view.itemGetCount(&view) : 0;
+    for (i = 0; i < count; i++) {
+        const char *n = view.itemGetName(&view, i);
+        if (n != NULL && !strcmp(n, name))
+            return i;
+    }
+    return -1;
+}
+
+static void hgShow(int k)
+{
+    hg_row_t *h = &hgRows[k];
+    int i;
+    ioBlockOps(1); // as Hide Game: nothing else on the drive while its hidden list is written
+    shLock();
+    shLoad(h->mode, 1);
+    for (i = 0; i < shList[h->mode].count; i++)
+        if (shList[h->mode].ps1[i] == h->ps1 && !strcmp(shList[h->mode].names[i], h->name)) {
+            memmove(&shList[h->mode].names[i], &shList[h->mode].names[i + 1], (shList[h->mode].count - i - 1) * sizeof(shList[h->mode].names[0]));
+            memmove(&shList[h->mode].ps1[i], &shList[h->mode].ps1[i + 1], shList[h->mode].count - i - 1);
+            shList[h->mode].count--;
+            shSave(h->mode);
+            break;
+        }
+    shUnlock();
+    ioBlockOps(0);
+    shRefresh(h->mode);
+}
