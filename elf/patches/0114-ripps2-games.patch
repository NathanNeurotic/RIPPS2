+// RIPPS2 build 114 (the font audit's B): a face drawn at a weight. A variable face (a wght axis) takes it as designed,
+// within its range; a face asked to be heavier than it can be (a static face, or past a variable one's range) has its
+// outlines grown in code, about 1 px at 18 px for 300 weight units. Lock held for the slot ones.
+static int fntFaceOwnWeight(FT_Face face)
+{
+    TT_OS2 *os2 = face != NULL ? (TT_OS2 *)FT_Get_Sfnt_Table(face, FT_SFNT_OS2) : NULL;
+    return os2 != NULL && os2->usWeightClass >= 100 && os2->usWeightClass <= 1000 ? os2->usWeightClass : 400;
+}
+
+static int fntFaceSetWeight(FT_Face face, int weight) // the weight the face now draws at
+{
+    FT_MM_Var *mm = NULL;
+    FT_Fixed coords[8];
+    unsigned i, n;
+    int drawn = fntFaceOwnWeight(face);
+
+    if (face == NULL || !FT_HAS_MULTIPLE_MASTERS(face) || FT_Get_MM_Var(face, &mm) != 0)
+        return drawn;
+    n = mm->num_axis < 8 ? mm->num_axis : 8;
+    for (i = 0; i < n; i++) {
+        coords[i] = mm->axis[i].def;
+        if (mm->axis[i].tag == FT_MAKE_TAG('w', 'g', 'h', 't')) {
+            FT_Fixed w = weight > 0 ? (FT_Fixed)weight << 16 : mm->axis[i].def;
+            if (w < mm->axis[i].minimum)
+                w = mm->axis[i].minimum;
+            if (w > mm->axis[i].maximum)
+                w = mm->axis[i].maximum;
+            coords[i] = w;
+            drawn = (int)(w >> 16);
+        }
+    }
+    if (FT_Set_Var_Design_Coordinates(face, n, coords) != 0)
+        drawn = fntFaceOwnWeight(face);
+    FT_Done_MM_Var(font_library, mm);
+    return drawn;
+}
+
+static void fntApplyWeightLocked(font_t *font)
+{
+    int drawn, k;
+
+    font->embolden = 0;
+    if (font->face == NULL)
+        return;
+    drawn = fntFaceSetWeight(font->face, font->weight);
+    for (k = 0; k < 2; k++) // the faces it borrows letters from: a variable one at the same weight
+        if (font->altFace[k] != NULL)
+            fntFaceSetWeight(font->altFace[k], font->weight);
+    if (font->weight > drawn)
+        font->embolden = (font->weight - drawn) * 64 / 300;
+    if (font->embolden > 96)
+        font->embolden = 96;
+    fntCacheFlush(font);
+}
+
+void fntSetWeight(int id, int weight)
+{
+    if (id < 0 || id >= FNT_MAX_COUNT)
+        return;
+    fntLock();
+    if (fonts[id].isValid && fonts[id].weight != weight) {
+        fonts[id].weight = weight;
+        fntApplyWeightLocked(&fonts[id]);
+    }
+    fntUnlock();
+}
+
+int fntGetOwnWeight(int id)
+{
+    int w = 400;
+    if (id < 0 || id >= FNT_MAX_COUNT)
+        return w;
+    fntLock();
+    if (fonts[id].isValid)
+        w = fntFaceOwnWeight(fonts[id].face);
+    fntUnlock();
+    return w;
+}
