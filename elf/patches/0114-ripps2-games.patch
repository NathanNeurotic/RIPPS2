+static int vcdSourceFileSize(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return -1;
+    int sz = lseek(fd, 0, SEEK_END);
+    if (sz < 0) {
+        char *buf = (char *)malloc(VCD_COPY_CHUNK);
+        int r = -1;
+        sz = 0;
+        if (buf != NULL) {
+            while ((r = read(fd, buf, VCD_COPY_CHUNK)) > 0)
+                sz += r;
+            free(buf);
+        }
+        if (r < 0)
+            sz = -1;
+    }
+    close(fd);
+    return sz;
+}
