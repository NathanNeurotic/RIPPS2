+// ---- the screens and the work ----
+
+static int lrAsk(const char *name, const char *where, int hasSaves)
+{
+    char msg[600], goes[260], kept[160], size[24];
+    long long image = 0;
+    int cfg = 0, art = 0, cht = 0, saves = 0, shots = 0, shared = 0, i, folder = 0;
+
+    for (i = 0; i < lrCount; i++) {
+        lr_item_t *it = &lrItems[i];
+        if (it->what == LR_IMAGE || it->what == LR_PARTITION || it->what == LR_FOLDER) {
+            image += it->bytes;
+            folder |= it->what == LR_FOLDER;
+        } else if (it->shared)
+            shared = 1;
+        else if (it->what == LR_CFG)
+            cfg++;
+        else if (it->what == LR_ART)
+            art++;
+        else if (it->what == LR_CHT)
+            cht++;
+        else if (it->what == LR_VMC || it->what == LR_POPSAVE)
+            saves++;
+        else if (it->what == LR_SHOTS)
+            shots++;
+    }
+    lrSize(image, size, sizeof(size));
+    snprintf(goes, sizeof(goes), folder ? _t("the game's folder and everything in it (%s)") : _t("the game (%s)"), size);
+    if (cfg)
+        snprintf(goes + strlen(goes), sizeof(goes) - strlen(goes), "%s", _t(", its settings"));
+    if (art)
+        snprintf(goes + strlen(goes), sizeof(goes) - strlen(goes), _t(", %d art images"), art);
+    if (cht)
+        snprintf(goes + strlen(goes), sizeof(goes) - strlen(goes), "%s", _t(", its cheats"));
+    kept[0] = '\0';
+    if (saves)
+        snprintf(kept, sizeof(kept), "%s", _t("its saves"));
+    if (shots)
+        snprintf(kept + strlen(kept), sizeof(kept) - strlen(kept), "%s%s", kept[0] ? _t(" and ") : "", _t("its RIPSHOT pictures"));
+    if (shared)
+        snprintf(kept + strlen(kept), sizeof(kept) - strlen(kept), "%s%s", kept[0] ? _t(", and ") : "", _t("the settings and art another copy of it uses"));
+    snprintf(msg, sizeof(msg), kept[0] ? _t("Delete %s from %s? Goes: %s. Kept: %s.") : _t("Delete %s from %s? Goes: %s."), name, where, goes, kept);
+    guiMsgBoxSound(SFX_MESSAGE);
+    if (guiMsgBox(msg, 1, NULL) != 1)
+        return 0;
+    if (hasSaves) {
+        guiMsgBoxSound(SFX_MESSAGE);
+        if (guiMsgBox(_t("Delete its saves and RIPSHOT pictures too? No keeps them."), 1, NULL) == 1)
+            for (i = 0; i < lrCount; i++)
+                if (lrItems[i].what == LR_VMC || lrItems[i].what == LR_SHOTS || lrItems[i].what == LR_POPSAVE)
+                    lrItems[i].keep = 0;
+    }
+    snprintf(msg, sizeof(msg), _t("Last check. %s is deleted for good, and nothing can bring it back. Press START to delete it."), name);
+    guiMsgBoxSound(SFX_ERROR);
+    guiMsgBoxStartOption(_t("DELETE FOR GOOD"));
+    return guiMsgBox(msg, 0, NULL) == 2;
+}
+
+static const char *lrWhere(int mode)
+{
+    if (mode == HDD_MODE)
+        return _t("the internal HDD (APA)");
+    if (mode >= BDM_MODE && mode <= BDM_MODE_LAST) {
+        int t = bdmSlotDeviceType(mode - BDM_MODE);
+        const char *n = bdmSlotDriveName(mode - BDM_MODE);
+        if (t == BDM_TYPE_ATA)
+            return _t("the internal HDD (exFAT)");
+        if (t == BDM_TYPE_USB)
+            return _t("the USB drive");
+        return n != NULL ? n : _t("the drive");
+    }
+    if (mode == MMCE_MODE)
+        return "MMCE";
+    if (mode == ETH_MODE)
+        return _t("the SMB share");
+    if (mode == MIX_MODE)
+        return _l(_STR_RIPPS2_ALL_GAMES); // the guard: All Games put together again after a refresh
+    return _t("its drive");
+}
+
+// ---- the launch guard (build 114) ----
+// The user (10/23): a launch never runs into RIPPS2's own work, and the guard is a safety net that hands the launch over
+// at the end of the queue. A job on the IO worker (a drive's list read, a save, a sound reload) or a write still open:
+// a short one finishes unseen. A longer one: a glass panel fades in over the page as RIPDISC's does, says what RIPPS2
+// is finishing, and RIPDISC's notches fill toward the estimated start (each source's last list read was timed; a trail
+// goes round when it is not known). When the queue is empty the launch goes on by itself. Cross stops the work safely
+// and starts now; Circle backs out to the page the launch began on, unchanged. Music streams on its own threads (sound.c)
+// and plays on: the guard never waits for it.
+
+#define LG_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define LG_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+
+static u64 lgAlpha(u64 c, int a)
+{
+    return (c & ~(0xFFULL << 24)) | ((u64)(a & 0xFF) << 24);
+}
+
+static int lgBusy(void)
+{
+    return ioWorkPending() || ioWritesOpen();
+}
+
+static void lgWhat(char *out, int size)
+{
+    int type = 0, secs = 0;
+    void *data = NULL;
+    const char *name;
+
+    if (!ioRunningJob(&type, &data, &secs))
+        snprintf(out, size, "%s", ioWritesOpen() ? _t("SAVING A LIST") : _t("THE LAST OF THE QUEUE"));
+    else if (type == IO_MENU_UPDATE_DEFFERED && data != NULL)
+        snprintf(out, size, _t("READING THE GAME LIST OF %s"), lrWhere(*(short *)data));
+    else if ((name = ioRunningName()) != NULL)
+        snprintf(out, size, "%s", name);
+    else
+        snprintf(out, size, "%s", _t("A TASK IN THE BACKGROUND"));
+}
+
+static void lgDraw(float a, float p, const char *head, const char *line, const char *left, int hints)
+{
+    int w = 580, h = 156, x = (640 - w) / 2, y = 134, ia = (int)(0x80 * a), hx; // room for "the internal HDD (exFAT)"
+    int confirmIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON;
+    int backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+
+    rmStartFrame();
+    ripps2DrawBackground(); // the page the launch began on: the towers, or Memory Files' orbs
+    thmDrawBackdrop();
+    ripps2RenderCategoryBar();
+    ripps2DrawHintBoxA(x, y, w, h, a);
+    fntRenderString(gTheme->fonts[4], 320, y + 26, ALIGN_CENTER, 0, 0, head, lgAlpha(LG_LIT, ia));
+    fntRenderStringFit(gTheme->fonts[5], 320, y + 54, ALIGN_CENTER, w - 40, line, lgAlpha(LG_SOFT, ia), 1);
+    hx = 320 - (38 + 6 + ripps2HintWidth(left)) / 2; // the ring in its own room, the time after it, the pair centred
+    ripps2NotchRing(hx + 19, y + 90, p, ia);
+    ripps2HintText(hx + 44, y + 90, left, lgAlpha(LG_SOFT, ia));
+    if (hints)
+        ripps2HintPairA(confirmIcon, _t("START NOW"), backIcon, _t("BACK"), y + 130, ia);
+    rmEndFrame();
+}
+
+// a short wait: the page and the loading mark breathing in its bar, no panel to read
+static void lgDrawQuiet(void)
+{
+    rmStartFrame();
+    ripps2DrawBackground();
+    thmDrawBackdrop();
+    ripps2RenderCategoryBar();
+    ripps2DrawBusy(0x80);
+    rmEndFrame();
+}
+
+// a list read is all that is left: START NOW need not wait for it (the teardown's own bounded drain and the launch's IOP
+// reset end it; a read cut short harms nothing), unlike a write
+static int lgOnlyReads(void)
+{
+    int type = 0, secs = 0;
+    void *data = NULL;
+    return !ioWritesOpen() && (!ioRunningJob(&type, &data, &secs) || type == IO_MENU_UPDATE_DEFFERED);
+}
+
+int ripps2LaunchGuard(void)
+{
+    char line[160], left[64];
+    double t0, now, quiet, done = 0.0, stopAt = 0.0;
+    int est, stopping = 0, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+
+    // the launch is picked: no background write of RIPPS2's starts from here to the handoff (FifthFox: a list or cache
+    // written as the MMCE switched cards or the IOP reset). Back, or a launch that comes back, gives them back
+    ioLaunchBegin();
+    if (!lgBusy())
+        return 1;
+    // the user (10/23): graceful. A wait of a second or two shows only the loading mark; the panel is for a wait worth
+    // reading (a known long one at once, an unknown one after 2 s)
+    est = ioQueueEstimateMs();
+    quiet = est > 0 && est <= 2500 ? est / 1000.0 + 0.8 : est > 2500 ? 0.3 : 2.0;
+    t0 = ripps2Seconds();
+    while (lgBusy() && ripps2Seconds() - t0 < quiet)
+        lgDrawQuiet();
+    if (!lgBusy())
+        return 1;
+    guiMsgBoxSound(SFX_MESSAGE);
+    t0 = ripps2Seconds();
+    est = ioQueueEstimateMs();
+#ifdef RIPPS2_GUARD_TEST
+    {
+        int ty = 0, se = 0;
+        void *da = NULL;
+        if (ioRunningJob(&ty, &da, &se))
+            printf("RIPPS2_GUARD_TEST: the guard waits on job type %d, mode %d; estimate %d ms\n", ty, da != NULL ? *(short *)da : -1, est);
+    }
+#endif
+    for (;;) {
+        float a, p;
+        now = ripps2Seconds();
+        if (done == 0.0 && !lgBusy())
+            done = now;
+        if (done > 0.0 && now - done > 0.35) // the queue is done: the full ring a moment, then the launch goes on
+            return 1;
+        if (stopping && now - stopAt > 30.0)
+            return 1; // a job that never ends: the teardown's own bounded wait takes it from here
+        if (stopping && now - stopAt > 1.0 && lgOnlyReads())
+            return 1; // only reads left: go (never while a write is open: that is what the guard is for)
+        readPads();
+        if (!stopping && done == 0.0) {
+            if (getKeyOn(gSelectButton)) {
+                // stop: no write starts (since the pick), a list read gives up at its next entry, the worker skips the
+                // queued ones; an open write ends. (Never ioRemoveRequests here: the worker holds its lock for the whole
+                // drain, so the panel froze until the work was done.)
+                sfxPlay(SFX_CONFIRM);
+                stopping = 1;
+                stopAt = now;
+                ioCancelScans();
+            } else if (getKeyOn(backKey)) {
+                sfxPlay(SFX_CANCEL);
+                ioLaunchCancel(); // back where the launch began: RIPPS2 writes its lists again
+                return 0;
+            }
+        }
+        a = (float)((now - t0) / 0.6);
+        a = a >= 1.0f ? 1.0f : a * a * (3.0f - 2.0f * a);
+        lgWhat(line, sizeof(line));
+        if (done > 0.0) {
+            p = 1.0f;
+            snprintf(left, sizeof(left), "%s", _t("STARTING"));
+        } else if (stopping) {
+            p = -1.0f;
+            snprintf(left, sizeof(left), "%s", _t("A MOMENT"));
+        } else if (est > 0) {
+            int ms = est - (int)((now - t0) * 1000.0);
+            p = (float)((now - t0) * 1000.0 / est);
+            if (p > 0.92f)
+                p = 0.92f; // the last notch fills when it is really done
+            if (ms < 1000)
+                snprintf(left, sizeof(left), "%s", _t("ANY MOMENT"));
+            else if (ms < 90 * 1000)
+                snprintf(left, sizeof(left), _t("ABOUT %d S"), (ms + 999) / 1000);
+            else
+                snprintf(left, sizeof(left), _t("ABOUT %d MIN"), (ms + 30000) / 60000);
+        } else {
+            p = -1.0f;
+            snprintf(left, sizeof(left), "%s", _t("WHEN IT FINISHES"));
+        }
+        lgDraw(a, p, stopping ? _t("STOPPING IT SAFELY") : _t("STARTS NEXT"), line, left, !stopping && done == 0.0);
+    }
+}
+
+void ripps2LastRites(item_list_t *support, int id)
+{
+    char prefix[160], path[256], apaWhy[200] = "", toast[160], size[24];
+    const char *where, *pfx;
+    opl_io_module_t *mod;
+    item_list_t view;
+    sh_row_t r;
+    long long freed = 0;
+    int i, hasSaves = 0, shared = 0, ok = 1;
+    char sep;
+
+    if (!gEnableWrite || !shResolve(support, id, &r))
+        return;
+    if (r.mode == HTTP_MODE || r.mode == UDPFS_MODE) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("A network catalogue's games are deleted on the PC that serves them."), 0, NULL);
+        return;
+    }
+    mod = oplGetModule(r.mode);
+    if (mod == NULL || mod->support == NULL)
+        return;
+    view = *mod->support;
+    view.viewOverride = shKindIsPs1(r.kind) ? ITEM_VIEW_FORCE_PS1 : ITEM_VIEW_FORCE_ISO;
+    where = lrWhere(r.mode);
+    lrCount = 0;
+
+    if (r.kind == FAV_KIND_ISO && r.mode == HDD_MODE) {
+        // the APA HDD: the game's partition, then its files in the OPL home
+        const hdl_game_info_t *g = view.itemGet != NULL ? (const hdl_game_info_t *)view.itemGet(&view, r.id) : NULL;
+        if (g == NULL || g->partition_name[0] == '\0' || (g->partition_name[0] == '_' && g->partition_name[1] == '_') ||
+            (gOPLPart[0] && !strcmp(gOPLPart + (strncmp(gOPLPart, "hdd0:", 5) ? 0 : 5), g->partition_name))) {
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(_t("This game's partition is one RIPPS2 does not remove (a system partition, or the one its settings are on)."), 0, NULL);
+            return;
+        }
+        if (!ripps2ApaCheck(apaWhy, sizeof(apaWhy))) {
+            char msg[400];
+            snprintf(msg, sizeof(msg), _t("Nothing was deleted: this drive's partition table does not fit this disk (%s). It may have been written from an image of a disk of another size. Repair it on a PC first."), apaWhy);
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+        snprintf(path, sizeof(path), "hdd0:%s", g->partition_name);
+        lrAdd(LR_PARTITION, path, (long long)g->total_size_in_kb * 1024, 0);
+        if (gHDDPrefix != NULL)
+            lrPlanExtras(&view, r.id, gHDDPrefix, '/', g->startup, r.name, 0);
+    } else if (r.kind == FAV_KIND_ISO) {
+        const base_game_info_t *g = view.itemGet != NULL ? (const base_game_info_t *)view.itemGet(&view, r.id) : NULL;
+        int p, count;
+        pfx = view.itemGetPrefix != NULL ? view.itemGetPrefix(&view) : NULL;
+        if (g == NULL || pfx == NULL) {
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(_t("RIPPS2 cannot delete a game from this page."), 0, NULL);
+            return;
+        }
+        snprintf(prefix, sizeof(prefix), "%s", pfx);
+        sep = prefix[0] && prefix[strlen(prefix) - 1] == '\\' ? '\\' : '/';
+        for (p = 0; p < g->parts; p++) {
+            char sepStr[2] = {sep, '\0'};
+            sbCreatePath(g, path, prefix, sepStr, p);
+            lrAddFile(LR_IMAGE, path, 0);
+        }
+        count = view.itemGetCount != NULL ? view.itemGetCount(&view) : 0;
+        for (i = 0; i < count && !shared; i++) {
+            const char *st = view.itemGetStartup != NULL && i != r.id ? view.itemGetStartup(&view, i) : NULL;
+            shared = st != NULL && !strcmp(st, g->startup);
+        }
+        lrPlanExtras(&view, r.id, prefix, sep, g->startup, r.name, shared);
+    } else if (r.mode >= BDM_MODE && r.mode <= BDM_MODE_LAST) {
+        // PS1 on a BDM drive: its VCD (POPSTARTER, the saves in POPS/<name>/ kept unless asked) or its Ember folder
+        const base_game_info_t *g = view.itemGet != NULL ? (const base_game_info_t *)view.itemGet(&view, r.id) : NULL;
+        if (r.kind == FAV_KIND_CUE) {
+            snprintf(path, sizeof(path), "mass%d:/EMBER/games/%s", r.mode - BDM_MODE, r.name);
+            lrAdd(LR_FOLDER, path, lrTreeSize(path), 0);
+        } else {
+            snprintf(path, sizeof(path), "mass%d:/POPS/%s%s", r.mode - BDM_MODE, r.name, g != NULL && g->extension[0] ? g->extension : ".VCD");
+            lrAddFile(LR_IMAGE, path, 0);
+            snprintf(path, sizeof(path), "mass%d:/POPS/%s", r.mode - BDM_MODE, r.name);
+            lrAdd(LR_POPSAVE, path, lrTreeSize(path), 1);
+        }
+    } else {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("A PS1 game here is deleted in Memory Files, where it is a file of its own."), 0, NULL);
+        return;
+    }
+    if (lrCount == 0 || (lrItems[0].what != LR_PARTITION && lrItems[0].what != LR_IMAGE && lrItems[0].what != LR_FOLDER)) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("RIPPS2 could not find this game's files on its drive."), 0, NULL);
+        return;
+    }
+    for (i = 0; i < lrCount; i++)
+        hasSaves |= (lrItems[i].what == LR_VMC || lrItems[i].what == LR_SHOTS || lrItems[i].what == LR_POPSAVE);
+    if (!lrAsk(r.name, where, hasSaves))
+        return;
+
+    // the image first: a delete cut short leaves stray settings or art, never half a game on the list
+    guiRenderTextScreen(_t("DELETING"));
+    if (lrItems[0].what == LR_PARTITION) {
+        int rv;
+        ioBlockOps(1); // nothing else reads the drive while its table changes
+        rv = fileXioRemove(lrItems[0].path);
+        ioBlockOps(0);
+        if (rv < 0) {
+            char msg[300];
+            snprintf(msg, sizeof(msg), _t("The partition could not be removed (%d). Nothing was deleted."), rv);
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(msg, 0, NULL);
+            return;
+        }
+        hddPartitionsChanged();
+        if (!ripps2ApaCheck(apaWhy, sizeof(apaWhy)))
+            LOG("LAST RITES: the APA table after the remove: %s\n", apaWhy);
+        freed += lrItems[0].bytes;
+    } else if (lrItems[0].what == LR_FOLDER) {
+        ok = lrRemoveTree(lrItems[0].path);
+        freed += lrItems[0].bytes;
+    } else if (r.kind == FAV_KIND_ISO && mod->support->itemDelete != NULL) {
+        mod->support->itemDelete(&view, r.id); // the source's own: every part, and a UL game's ul.cfg made again
+        for (i = 0; i < lrCount; i++)
+            if (lrItems[i].what == LR_IMAGE)
+                freed += lrItems[i].bytes;
+    } else
+        for (i = 0; i < lrCount; i++)
+            if (lrItems[i].what == LR_IMAGE) {
+                ok &= unlink(lrItems[i].path) == 0;
+                freed += lrItems[i].bytes;
+            }
+    for (i = 1; i < lrCount; i++) {
+        lr_item_t *it = &lrItems[i];
+        if (it->keep || it->shared || it->what == LR_IMAGE)
+            continue;
+        if (it->what == LR_SHOTS || it->what == LR_POPSAVE)
+            lrRemoveTree(it->path);
+        else
+            unlink(it->path);
+        freed += it->bytes;
+    }
+    // its star and its place on the hidden list go with it
+    removeFavouriteByIdAndText(r.mode, r.id, r.name, r.kind);
+    ioBlockOps(1); // as Hide Game: nothing else on the drive while its hidden list is written
+    shLock();
+    shLoad(r.mode, 1);
+    for (i = 0; i < shList[r.mode].count; i++)
+        if (shList[r.mode].ps1[i] == shKindIsPs1(r.kind) && !strcmp(shList[r.mode].names[i], r.name)) {
+            memmove(&shList[r.mode].names[i], &shList[r.mode].names[i + 1], (shList[r.mode].count - i - 1) * sizeof(shList[r.mode].names[0]));
+            memmove(&shList[r.mode].ps1[i], &shList[r.mode].ps1[i + 1], shList[r.mode].count - i - 1);
+            shList[r.mode].count--;
+            shSave(r.mode);
+            break;
+        }
+    shUnlock();
+    ioBlockOps(0);
+    lrReceipt(r.name, where, freed, apaWhy);
+    shRefresh(r.mode);
+    lrSize(freed, size, sizeof(size));
+    snprintf(toast, sizeof(toast), ok ? _t("DELETED %s: %s FREED") : _t("%s: SOME FILES COULD NOT BE DELETED"), r.name, size);
+    guiShowToast(toast);
+}
+
+// ---- Settings > Game Sources > Hidden Games ----
+
+typedef struct
+{
+    int mode, ps1, pack; // pack: 1 an ISO that can be compressed, 2 a ZSO that can be made an ISO (ripps2PackKind)
+    char name[164];
+} hg_row_t;
+
+#define HG_ROWS 256
+static hg_row_t hgRows[HG_ROWS];
+static int hgCount, hgSel, hgTop;
+
+// build 114: the page a compression was asked from when it is not a game list (Hidden Games), drawn under its panels
+static void (*zpUnder)(void) = NULL;
+
+static int hgFind(int mode, int ps1, const char *name);
+
+static void hgGather(void)
+{
+    int mode, i;
+    hgCount = 0;
+    shLock();
+    for (mode = 0; mode < MODE_COUNT; mode++) {
+        opl_io_module_t *mod = oplGetModule(mode);
+        if (mode == APP_MODE || mode == FAV_MODE || mode == MIX_MODE || mod == NULL || mod->support == NULL || !mod->support->enabled)
+            continue;
+        shLoad(mode, 1);
+        for (i = 0; i < shList[mode].count && hgCount < HG_ROWS; i++) {
+            hgRows[hgCount].mode = mode;
+            hgRows[hgCount].ps1 = shList[mode].ps1[i];
+            hgRows[hgCount].pack = 0;
+            snprintf(hgRows[hgCount++].name, sizeof(hgRows[0].name), "%s", shList[mode].names[i]);
+        }
+    }
+    shUnlock();
+    for (i = 0; i < hgCount; i++) { // build 114: which can be compressed or made an ISO again
+        opl_io_module_t *mod = oplGetModule(hgRows[i].mode);
+        int id = hgRows[i].ps1 ? -1 : hgFind(hgRows[i].mode, 0, hgRows[i].name);
+        if (id >= 0 && mod != NULL && mod->support != NULL) {
+            item_list_t view = *mod->support;
+            view.viewOverride = ITEM_VIEW_FORCE_ISO;
+            hgRows[i].pack = ripps2PackKind(&view, id);
+        }
+    }
+}
