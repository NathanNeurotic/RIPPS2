rNO || rdOne[0] != 1 || memcmp(rdOne + 1, \"CD001\", 5) != 0)\n++        return 0;\n++    return rdLe32(rdOne + 80);\n++}\n++\n++// The entries of the ISO 9660 folder at lba (size bytes); . and .. left out\n++static int rdDir(u32 lba, u32 size, rd_file_t *out, int max, int audioTs)\n++{\n++    u32 s, sectors = (size + RD_DATA - 1) / RD_DATA;\n++    int count = 0;\n++    for (s = 0; s < sectors && s < 16; s++) {\n++        int o = 0;\n++        if (!rdRead(lba + s, 1, rdOne, SCECdSecS2048))\n++            return -1;\n++        while (o + 34 <= RD_DATA) {\n++            int len = rdOne[o], nl = rdOne[o + 32], i;\n++            const char *nm = (const char *)rdOne + o + 33;\n++            if (len == 0)\n++                break; // the rest of the sector is padding\n++            if (len < 34 || o + len > RD_DATA)\n++                break;\n++            if (!(nl == 1 && (nm[0] == 0 || nm[0] == 1)) && count < max) {\n++                rd_file_t *f = &out[count++];\n++                for (i = 0; i < nl && i < (int)sizeof(f->name) - 1 && nm[i] != ';'; i++)\n++                    f->name[i] = nm[i];\n++                while (i > 0 && f->name[i - 1] == '.') // \"VIDEO_TS.\" for a name with no extension\n++                    i--;\n++                f->name[i] = '\\0';\n++                f->lba = rdLe32(rdOne + o + 2);\n++                f->size = rdLe32(rdOne + o + 10);\n++                f->isDir = (rdOne[o + 25] & 0x02) != 0;\n++                f->inAudioTs = audioTs;\n++            }\n++            o += len;\n++        }\n++    }\n++    return count;\n++}\n++\n++// A DVD video's VIDEO_TS (and AUDIO_TS) files, and their size\n++static int rdVideoScan(void)\n++{\n++    rd_file_t root[24];\n++    int n, i, k;\n++    u32 rootLba, rootSize;\n++\n++    rdFileCount = 0;\n++    rdBytes = 0;\n++    if (!rdRead(16, 1, rdOne, SCECdSecS2048) || rdOne[0] != 1 || memcmp(rdOne + 1, \"CD001\", 5) != 0)\n++        return 0;\n++    memcpy(rdLabel, rdOne + 40, 32);\n++    rdLabel[32] = '\\