+          "contents_url": "https://api.github.com/repos/MiguelQueiroz010/OPL-DS4RTBT/contents/tools%2Ftest_pademu_route.c?ref=2cf308511b187f8a0b209140f71936dca0bb0bae",
+          "patch": "@@ -0,0 +1,100 @@\n+/*\n+ * Host test of the PADEMU routing rules (modules/pademu/pademu_route.h).\n+ *   gcc -Wall -Wextra -o test_pademu_route tools/test_pademu_route.c && ./test_pademu_route\n+ */\n+#include <stdio.h>\n+#include \"../modules/pademu/pademu_route.h\"\n+\n+static int failures;\n+static int checks;\n+\n+static void expect(const char *what, int got, int want)\n+{\n+    checks++;\n+    if (got != want) {\n+        failures++;\n+        printf(\"FAIL: %s: got %d, want %d\\n\", what, got, want);\n+    }\n+}\n+\n+/* the decision the module had before the multitap work, for the setups that do not use the multitap */\n+static int legacy_plain(unsigned char enabled, int port)\n+{\n+    return ((enabled >> port) & 1) ? port : PADEMU_ROUTE_REAL;\n+}\n+\n+int main(void)\n+{\n+    pademu_route_t r;\n+    int en, port, slot, mport, inited;\n+\n+    /* 1. multitap off: the same as the original behaviour, for every combination */\n+    for (en = 0; en < 16; en++)\n+        for (port = 0; port < 2; port++) {\n+            r = (pademu_route_t) {.enabled = (unsigned char)en, .mtap_enabled = 0};\n+            expect(\"plain\", pademu_route_port(&r, port), legacy_plain((unsigned char)en, port));\n+        }\n+\n+    /* 2. ports above 1 are never pad ports */\n+    r = (pademu_route_t) {.enabled = 0x0F, .mtap_enabled = 0};\n+    expect(\"port 2\", pademu_route_port(&r, 2), PADEMU_ROUTE_REAL);\n+    expect(\"port 3\", pademu_route_port(&r, 3), PADEMU_ROUTE_REAL);\n+    r.mtap_enabled = 1;\n+    expect(\"mtap port 2\", pademu_route_port(&r, 2), PADEMU_ROUTE_REAL);\n+\n+    /* 3. multitap on, for both ports and all enabled masks */\n+    for (mport = 0; mport < 2; mport++)\n+        for (en = 0; en < 16; en++)\n+            for (inited = 0; inited < 2; inited++)\n+                for (slot = 0; slot < 4; slot++) {\n+                    int other = 1 - mport;\n+\n+                    r = (pademu_route_t) {.enabled = (unsigned char)en, .mtap_enabled = 1, .mtap_port = (unsigned char)mport, .mtap_inited = (unsigned char)inited, .mtap_slot = (unsigned char)slot};\n+\n+                    /* the other port always stays with the real DS2, whatever the slot bits say */\n+                    expect(\"other port is real\", pademu_route_port(&r, other), PADEMU_ROUTE_REAL);\n+\n+                    int s = inited ? slot : 0;\n+                    int got = pademu_route_port(&r, mport);\n+\n+                    if (s == 0)\n+                        expect(\"slot A\", got, (en & 1) ? 0 : PADEMU_ROUTE_REAL);\n+                    else\n+                        expect(\"slot B-D always emulated\", got, s);\n+                }\n+\n+    /* 4. the case of the report: multitap on port 1, slot A not emulated, B-D wireless */\n+    r = (pademu_route_t) {.enabled = 0x0E, .mtap_enabled = 1, .mtap_port = 0, .mtap_inited = 1, .mtap_slot = 0};\n+    expect(\"A real DS2\", pademu_route_port(&r, 0), PADEMU_ROUTE_REAL);\n+    expect(\"2P real DS2\", pademu_route_port(&r, 1), PADEMU_ROUTE_REAL);\n+    r.mtap_slot = 1;\n+    expect(\"B wireless\", pademu_route_port(&r, 0), 1);\n+    r.mtap_slot = 3;\n+    expect(\"D wireless\", pademu_route_port(&r, 0), 3);\n+    r.mtap_slot = 0;\n+\n+    /* same on port 2: the DS2 of 1P must not be affected (the old code neutralised the wrong command of a two-port poll) */\n+    r = (pademu_route_t) {.enabled = 0x0E, .mtap_enabled = 1, .mtap_port = 1, .mtap_inited = 1, .mtap_slot = 2};\n+    expect(\"mtap on 2P: 1P real\", pademu_route_port(&r, 0), PADEMU_ROUTE_REAL);\n+    expect(\"mtap on 2P: slot C\", pademu_route_port(&r, 1), 2);\n+\n+    /* 5. game that never asks for the multitap: slot A is a plain pad, the other port is real */\n+    r = (pademu_route_t) {.enabled = 0x0F, .mtap_enabled = 1, .mtap_port = 0, .mtap_inited = 0, .mtap_slot = 2};\n+    expect(\"no mtap game: 1P is slot A\", pademu_route_port(&r, 0), 0);\n+    expect(\"no mtap game: 2P real\", pademu_route_port(&r, 1), PADEMU_ROUTE_REAL);\n+\n+    /* 6. multitap commands: only the emulated multitap port is intercepted, the other port reaches the real SIO2 */\n+    r = (pademu_route_t) {.mtap_enabled = 0, .mtap_port = 0};\n+    expect(\"mtap off: no interception p0\", pademu_route_is_mtap_port(&r, 0), 0);\n+    expect(\"mtap off: no interception p1\", pademu_route_is_mtap_port(&r, 1), 0);\n+    for (mport = 0; mport < 2; mport++) {\n+        r = (pademu_route_t) {.mtap_enabled = 1, .mtap_port = (unsigned char)mport};\n+        expect(\"mtap port intercepted\", pademu_route_is_mtap_port(&r, mport), 1);\n+        expect(\"other port passes through\", pademu_route_is_mtap_port(&r, 1 - mport), 0);\n+        expect(\"port 2 passes through\", pademu_route_is_mtap_port(&r, 2), 0);\n+        expect(\"port 3 passes through\", pademu_route_is_mtap_port(&r, 3), 0);\n+    }\n+\n+    printf(\"%d checks, %d failures\\n\", checks, failures);\n+    return failures ? 1 : 0;\n+}"
+        },
+        {
+          "sha": "ab63f8a2bfd10541c65bbb920b7056669e58f7f6",
+          "filename": "tools/test_pademu_split.c",
+          "status": "added",
+          "additions": 114,
+          "deletions": 0,
+          "changes": 114,
+          "blob_url": "https://github.com/MiguelQueiroz010/OPL-DS4RTBT/blob/2cf308511b187f8a0b209140f71936dca0bb0bae/tools%2Ftest_pademu_split.c",
+          "raw_url": "https://github.com/MiguelQueiroz010/OPL-DS4RTBT/raw/2cf308511b187f8a0b209140f71936dca0bb0bae/tools%2Ftest_pademu_split.c",
+          "contents_url": "https://api.github.com/repos/MiguelQueiroz010/OPL-DS4RTBT/contents/tools%2Ftest_pademu_split.c?ref=2cf308511b187f8a0b209140f71936dca0bb0bae",
+          "patch": "@@ -0,0 +1,114 @@\n+/*\n+ * Host test of the 2 port poll layout and split (modules/pademu/pademu_split.h).\n+ *   gcc -Wall -Wextra -o test_pademu_split tools/test_pademu_split.c && ./test_pademu_split\n+ */\n+#include <stdio.h>\n+#include <string.h>\n+#include \"../modules/pademu/pademu_split.h\"\n+\n+static int failures, checks;\n+\n+static void expect(const char *what, long got, long want)\n+{\n+    checks++;\n+    if (got != want) {\n+        failures++;\n+        printf(\"FAIL: %s: got %ld, want %ld\\n\", what, got, want);\n+    }\n+}\n+\n+#define REG(port, len) ((unsigned)(port) | ((unsigned)(len) << 8) | ((unsigned)(len) << 18) | 0x40)\n+\n+/* A model of the console's SIO2: walks the queue, every command is answered 0xA0 + port, and the walk stops at length 0 */\n+typedef struct\n+{\n+    unsigned regdata[16];\n+    unsigned in_size;\n+    unsigned char *in, *out;\n+} fake_td;\n+\n+static int hw_commands;\n+static int hw_ports_seen[4];\n+\n+static void fake_sio2(fake_td *td)\n+{\n+    unsigned pos = 0, i;\n+\n+    for (i = 0; i < 16 && pademu_cmd_len(td->regdata[i]); i++) {\n+        unsigned len = pademu_cmd_len(td->regdata[i]), b;\n+\n+        hw_commands++;\n+        hw_ports_seen[td->regdata[i] & 3]++;\n+        for (b = 0; b < len; b++)\n+            td->out[pos + b] = (unsigned char)(0xA0 + (td->regdata[i] & 3));\n+        pos += len;\n+    }\n+}\n+\n+int main(void)\n+{\n+    pademu_layout_t l;\n+    unsigned reg[16], out_reg[16];\n+    unsigned char in[64], out[64];\n+    static const unsigned lens[] = {5, 9, 21};\n+    int a, b, keep, i;\n+\n+    /* 1. layout of the usual polls: every length pair that adds up */\n+    for (a = 0; a < 3; a++)\n+        for (b = 0; b < 3; b++) {\n+            memset(reg, 0, sizeof(reg));\n+            reg[0] = REG(0, lens[a]);\n+            reg[1] = REG(1, lens[b]);\n+            expect(\"layout found\", pademu_layout_two(reg, lens[a] + lens[b], &l), 1);\n+            expect(\"cmd 0 offset\", l.off[0], 0);\n+            expect(\"cmd 1 offset\", l.off[1], lens[a]);\n+            expect(\"cmd 1 length\", l.len[1], lens[b]);\n+            expect(\"cmd 0 port\", l.port[0], 0);\n+            expect(\"cmd 1 port\", l.port[1], 1);\n+        }\n+\n+    /* 2. transfers that are not a plain 2 port poll are not split */\n+    memset(reg, 0, sizeof(reg));\n+    reg[0] = REG(0, 9);\n+    expect(\"one command only\", pademu_layout_two(reg, 9, &l), 0);\n+    reg[1] = REG(1, 9);\n+    expect(\"size mismatch\", pademu_layout_two(reg, 20, &l), 0);\n+    reg[2] = REG(0, 9);\n+    expect(\"three commands\", pademu_layout_two(reg, 27, &l), 0);\n+\n+    /* 3. the real command goes alone, in its own region of the buffers, and the other one is never sent */\n+    for (keep = 0; keep < 2; keep++) {\n+        fake_td real;\n+\n+        memset(reg, 0, sizeof(reg));\n+        reg[0] = REG(0, 9);\n+        reg[1] = REG(1, 21);\n+        memset(out, 0x11, sizeof(out));\n+        memset(in, 0x22, sizeof(in));\n+        expect(\"layout for split\", pademu_layout_two(reg, 30, &l), 1);\n+\n+        pademu_split_regdata(reg, keep, out_reg);\n+        expect(\"kept command is first\", out_reg[0], (long)reg[keep]);\n+        for (i = 1; i < 16; i++)\n+            expect(\"queue ends\", out_reg[i], 0);\n+\n+        memcpy(real.regdata, out_reg, sizeof(out_reg));\n+        real.in_size = l.len[keep];\n+        real.in = in + l.off[keep];\n+        real.out = out + l.off[keep];\n+\n+        hw_commands = 0;\n+        memset(hw_ports_seen, 0, sizeof(hw_ports_seen));\n+        fake_sio2(&real);\n+\n+        expect(\"hardware runs one command\", hw_commands, 1);\n+        expect(\"only the real port is used\", hw_ports_seen[keep], 1);\n+        expect(\"the emulated port is not touched\", hw_ports_seen[1 - keep], 0);\n+        expect(\"answer of the real pad\", out[l.off[keep]], 0xA0 + keep);\n+        expect(\"answer lands in its own region\", out[l.off[keep] + l.len[keep] - 1], 0xA0 + keep);\n+        expect(\"emulated answer area untouched\", out[l.off[1 - keep]], 0x11);\n+    }\n+\n+    printf(\"%d checks, %d failures\\n\", checks, failures);\n+    return failures != 0;\n+}"
+        }
+      ]
+    },
