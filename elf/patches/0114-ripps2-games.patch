+// where a sweep is now: the colour it is on, easing into the next
+static void sweepAt(const ripps2_sweep_t *sw, float *hue, float *sat, float *lift)
+{
+    int k, i, j, sp = sw->speed >= 0 && sw->speed <= 2 ? sw->speed : 1;
+    double pos;
+    float f, ha, hb, dh;
