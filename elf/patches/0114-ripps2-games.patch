+static FT_Error fntNewLibrary(FT_Library *library)
+{
+    static const FT_Module_Class *const modules[] = {
+        &autofit_module_class, &tt_driver_class,
+        &cff_driver_class, &psaux_module_class, &psnames_module_class, &pshinter_module_class,
+        &sfnt_module_class, &ft_smooth_renderer_class};
+    FT_Memory memory = font_memory = FT_New_Memory();
+    FT_Error error;
+    unsigned i;
+
+    if (memory == NULL)
+        return FT_Err_Out_Of_Memory;
+    if ((error = FT_New_Library(memory, library)) != 0)
+        return error;
+    for (i = 0; i < sizeof(modules) / sizeof(modules[0]); i++)
+        if ((error = FT_Add_Module(*library, modules[i])) != 0)
+            return error;
+    // no FT_Set_Default_Properties: it sits in ftinit.c with the table of every module, and links them all back in;
+    // it only reads a FREETYPE_PROPERTIES environment variable, which a PS2 never has
+    return 0;
+}
 
