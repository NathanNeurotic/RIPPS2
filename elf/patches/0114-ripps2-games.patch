+          "patch": "@@ -30,6 +30,13 @@\n //#define DPRINTF(x...) printf(x)\n #define DPRINTF(x...)\n \n+// Rare Bluetooth link events (a pad connecting, being refused or leaving), sent to the UDP log in debug builds only\n+#ifdef PADEMU_DEBUG\n+#define BTLOG(x...) printf(x)\n+#else\n+#define BTLOG(x...)\n+#endif\n+\n static int bt_probe(int devId);\n static int bt_connect(int devId);\n static int bt_disconnect(int devId);\n@@ -351,10 +358,16 @@ static u8 GenuineMacAddress[][3] =\n static padsetup_t g_setup;\n static u8 g_remap_active;\n \n-// Lightbar colour of a slot: the one chosen in the OPL menu (Controller Setup), otherwise the default pattern of the slot.\n+static int led_pad_index(int slot); // colour saved for the pad itself (defined once the pad table exists)\n+\n+// Lightbar colour of a pad: the one saved with that controller (follows its Bluetooth address, so it does not change\n+// when the pad lands in another slot), else the one of the slot in Controller Setup, else the default pattern of the slot.\n static void led_slot_color(int slot, int bright, u8 *rgb)\n {\n-    int idx = padsetup_get_led(&g_setup, slot); // out of range = default\n+    int idx = led_pad_index(slot);\n+\n+    if (!idx)\n+        idx = padsetup_get_led(&g_setup, slot); // out of range = default\n \n     if (idx) {\n         rgb[0] = padsetup_led_rgb(idx)[0];\n@@ -596,6 +609,16 @@ static int HCI_Command(int nbytes, u8 *dataptr);\n static bt_link_key_t bt_keys[BTKEYS_MAX];\n static int bt_keys_count = 0;\n \n+static int led_pad_index(int slot)\n+{\n+    int idx;\n+\n+    if (slot < 0 || slot >= MAX_PADS || bt_keys_count <= 0)\n+        return 0;\n+    idx = btkeys_get_led(bt_keys, bt_keys_count, ds34pad[slot].bdaddr);\n+    return idx < PADSETUP_LED_COUNT ? idx : 0;\n+}\n+\n // Case-insensitive prefix compare for remote names (clone pads don't always use the exact same capitalization)\n static int bt_name_starts(const u8 *name, const char *prefix)\n {\n@@ -1072,9 +1095,11 @@ static void HCI_event_task(int result)\n                     if (i >= MAX_PADS) {\n                         break;\n                     }\n+                    BTLOG(\"PADEMU BT: link up for pad %d\\n\", i);\n                     pad_status_set(DS34BT_STATE_CONNECTED, i);\n                     hci_remote_name(ds34pad[i].bdaddr);\n                 } else {\n+                    BTLOG(\"PADEMU BT: connection failed, status 0x%02X\\n\", hci_buf[2]);\n                     DPRINTF(\"\\t Error 0x%02X \\n\", hci_buf[2]);\n                 }\n                 break;\n@@ -1100,6 +1125,7 @@ static void HCI_event_task(int result)\n                         break;\n                     }\n                 }\n+                BTLOG(\"PADEMU BT: disconnect, reason 0x%02X, pad %d\\n\", hci_buf[5], i < MAX_PADS ? i : -1);\n                 ds34pad_clear(i);\n                 bt_update_page_scan(); // a pad left: listen for connections again\n                 break;\n@@ -1141,6 +1167,7 @@ static void HCI_event_task(int result)\n                         ds34pad[i].type = DS3;\n                         DPRINTF(\"\\t Type: Dualshock 3 \\n\");\n                     }\n+                    BTLOG(\"PADEMU BT: pad %d is a %s\\n\", i, ds34pad[i].type == DS5 ? \"DualSense\" : ds34pad[i].type == DS4 ? \"DualShock 4\" : \"DualShock 3\");\n                     hci_change_connection_type(ds34pad[i].hci_handle);\n                     if (IS_DS4_LIKE(ds34pad[i].type)) {\n                         identifier++;\n@@ -1176,6 +1203,8 @@ static void HCI_event_task(int result)\n                         break;\n                     }\n                 }\n+                BTLOG(\"PADEMU BT: connection request from %02X:%02X:%02X:%02X:%02X:%02X -> %s\\n\", hci_buf[7], hci_buf[6], hci_buf[5], hci_buf[4],\n+                      hci_buf[3], hci_buf[2], i >= MAX_PADS ? \"no free pad slot, rejected\" : \"pad slot assigned\");\n                 if (i >= MAX_PADS) { // no free slot\n                     hci_reject_connection(hci_buf + 2);\n                     break;\n@@ -1585,6 +1614,7 @@ static int L2CAP_event_task(int result, int bytes)\n                             DelayThread(CMD_DELAY);\n                             hid_LEDRumbleCommand(ds34pad[pad].oldled, 0, 0, pad);\n                             pad_status_set(DS34BT_STATE_RUNNING, pad);\n+                            BTLOG(\"PADEMU BT: pad %d running\\n\", pad);\n                             bt_update_page_scan(); // all enabled pads connected: stop listening for new ones\n                         }\n                         ds34pad[pad].btn_delay = 0xFF;"
