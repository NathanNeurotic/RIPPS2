+#define O_RDONLY 0
+#define open host_open
+#define close(fd) ((void)(fd))
+#define opendir host_opendir
+#define readdir host_readdir
+#define closedir host_closedir
+#define stat(...) host_stat(__VA_ARGS__)
+#define DIR host_DIR
+#define dirent sdk_dirent
