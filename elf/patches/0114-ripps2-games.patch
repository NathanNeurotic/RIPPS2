+        "sha": "7da86ed450c17d3b43c391ba20483ba8eabecc9e",
+        "filename": "elf/lang/make_arabic_forms.py",
+        "status": "added",
+        "additions": 45,
+        "deletions": 0,
+        "changes": 45,
+        "blob_url": "https://github.com/akilluminati47/RIPPS2/blob/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fmake_arabic_forms.py",
+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fmake_arabic_forms.py",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Flang%2Fmake_arabic_forms.py?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -0,0 +1,45 @@\n+\"\"\"The Arabic joining-forms table in RiptOPL's src/ripps2tr.c (RIPPS2 build 104), made from Unicode's own data.\n+\n+Each Arabic letter that has presentation forms (U+FB50..U+FDFF, U+FE70..U+FEFF) gets its isolated, final, initial\n+and medial forms; a letter with no initial or medial form joins to the letter before it only (alef, dal, reh, waw,\n+...). Lam with alef is a ligature of its own, kept apart in ripps2tr.c. Run it and paste the output between the\n+GENERATED markers:\n+\n+    python3 elf/lang/make_arabic_forms.py\n+\"\"\"\n+import unicodedata\n+\n+FORMS = ('isolated', 'final', 'initial', 'medial')\n+\n+\n+def table():\n+    found = {}\n+    # forms B first: the standard letters' main forms; forms A then adds the Persian and Urdu letters\n+    for c in list(range(0xFE70, 0xFF00)) + list(range(0xFB50, 0xFE00)):\n+        d = unicodedata.decomposition(chr(c)).split()\n+        if len(d) != 2 or d[0].strip('<>') not in FORMS:\n+            continue\n+        base = int(d[1], 16)\n+        if not 0x0620 <= base <= 0x06FF:\n+            continue\n+        slot = found.setdefault(base, [0, 0, 0, 0])\n+        k = FORMS.index(d[0].strip('<>'))\n+        if slot[k] == 0:\n+            slot[k] = c\n+    return found\n+\n+\n+def main():\n+    rows = table()\n+    print('// GENERATED by ps2-pillars elf/lang/make_arabic_forms.py (Unicode %s): base, isolated, final, initial, '\n+          'medial' % unicodedata.unidata_version)\n+    print('static const u16 trArab[][5] = {')\n+    for base in sorted(rows):\n+        iso, fin, ini, med = rows[base]\n+        print('    {0x%04X, 0x%04X, 0x%04X, 0x%04X, 0x%04X}, // %s' % (base, iso, fin, ini, med, unicodedata.name(chr(base))))\n+    print('};')\n+    print('// GENERATED END')\n+\n+\n+if __name__ == '__main__':\n+    main()"
+      },
+      {
+        "sha": "e3e6c40951d17ada4effb14b398fe2fa178e985d",
+        "filename": "elf/lang/make_lang_fonts.py",
+        "status": "added",
+        "additions": 55,
+        "deletions": 0,
+        "changes": 55,
+        "blob_url": "https://github.com/akilluminati47/RIPPS2/blob/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fmake_lang_fonts.py",
+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fmake_lang_fonts.py",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Flang%2Fmake_lang_fonts.py?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -0,0 +1,55 @@\n+\"\"\"The language fonts RIPPS2 ships beside Open PS2 Loader's (RIPPS2 build 104), in elf/lang/fonts:\n+\n+- DejaVuSans-Arabic.ttf: DejaVu Sans 2.37 cut to Latin-1, the Arabic block and both presentation-form blocks. RIPPS2\n+  joins Arabic and Persian letters itself (ripps2Rtl in RiptOPL's src/ripps2tr.c) into those presentation forms, so\n+  the font must carry all of them; upstream's font_Arabic is a cut without them.\n+- NotoSansLao-Regular.ttf: Noto Sans Lao 2.003 (hinted), as released.\n+\n+Both come from their projects' own GitHub releases (downloaded once by hand; the user approved the sources on\n+2026-10-19): github.com/dejavu-fonts/dejavu-fonts (dejavu-sans-ttf-2.37.zip) and github.com/notofonts/lao\n+(NotoSansLao-v2.003.zip). Their licences go beside them and into the language pack.\n+\n+    python3 elf/lang/make_lang_fonts.py <dejavu-sans-ttf-2.37.zip> <NotoSansLao-v2.003.zip>\n+\"\"\"\n+import io\n+import os\n+import sys\n+import zipfile\n+\n+from fontTools import subset\n+from fontTools.ttLib import TTFont\n+\n+HERE = os.path.dirname(os.path.abspath(__file__))\n+OUT = os.path.join(HERE, 'fonts')\n+ARABIC = (list(range(0x20, 0x100)) + list(range(0x0600, 0x0700)) + list(range(0xFB50, 0xFE00)) +\n+          list(range(0xFE70, 0xFF00)) + list(range(0x2010, 0x2028)) + [0x200C, 0x200D])\n+\n+\n+def main(dejavu_zip, lao_zip):\n+    os.makedirs(OUT, exist_ok=True)\n+    z = zipfile.ZipFile(dejavu_zip)\n+    font = TTFont(io.BytesIO(z.read('dejavu-sans-ttf-2.37/ttf/DejaVuSans.ttf')))\n+    opts = subset.Options()\n+    opts.layout_features = []  # RIPPS2 draws the presentation forms themselves, no GSUB/GPOS\n+    opts.name_IDs = ['*']\n+    opts.name_languages = ['*']\n+    opts.notdef_outline = True\n+    opts.hinting = False\n+    sub = subset.Subsetter(opts)\n+    sub.populate(unicodes=ARABIC)\n+    sub.subset(font)\n+    font.save(os.path.join(OUT, 'DejaVuSans-Arabic.ttf'))\n+    with open(os.path.join(OUT, 'LICENSE-DejaVu.txt'), 'wb') as f:\n+        f.write(z.read('dejavu-sans-ttf-2.37/LICENSE'))\n+\n+    z = zipfile.ZipFile(lao_zip)\n+    with open(os.path.join(OUT, 'NotoSansLao-Regular.ttf'), 'wb') as f:\n+        f.write(z.read('NotoSansLao/hinted/ttf/NotoSansLao-Regular.ttf'))\n+    with open(os.path.join(OUT, 'OFL-NotoSansLao.txt'), 'wb') as f:\n+        f.write(z.read('OFL.txt'))\n+    for name in sorted(os.listdir(OUT)):\n+        print('%-28s %7d bytes' % (name, os.path.getsize(os.path.join(OUT, name))))\n+\n+\n+if __name__ == '__main__':\n+    main(sys.argv[1], sys.argv[2])"
+      },
+      {
+        "sha": "e947d91aad71fa3d8dd49b248b42017fddd50194",
+        "filename": "elf/lang/ripps2lang.py",
+        "status": "modified",
+        "additions": 55,
+        "deletions": 3,
+        "changes": 58,
+        "blob_url": "https://github.com/akilluminati47/RIPPS2/blob/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fripps2lang.py",
+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Flang%2Fripps2lang.py",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Flang%2Fripps2lang.py?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -261,7 +261,14 @@ def font_names(data):\n     'Roboto Condensed': 'Apache License 2.0 (github.com/googlefonts/roboto)',\n     'Droid Sans Fallback': 'Apache License 2.0 (Android Open Source Project)',\n     'Open Sans': 'Apache License 2.0 / SIL Open Font License 1.1 (github.com/googlefonts/opensans)',\n+    'Noto Sans Lao': 'SIL Open Font License 1.1 (github.com/notofonts/lao)',\n }\n+# RIPPS2's own language fonts (elf/lang/fonts, made by make_lang_fonts.py), ahead of upstream's: Arabic and Persian\n+# need every presentation form RIPPS2 joins their letters into, and upstream has no free Lao font. Each one's licence\n+# text goes into the pack beside it.\n+OWN_FONTS = {'Arabic': ('DejaVuSans-Arabic.ttf', 'LICENSE-DejaVu.txt'),\n+             'Persian': ('DejaVuSans-Arabic.ttf', 'LICENSE-DejaVu.txt'),\n+             'Laotian': ('NotoSansLao-Regular.ttf', 'OFL-NotoSansLao.txt')}\n # where a language's own font is not a free one, or it has none, the font of another language that covers it\n FONT_FROM = {'Persian': 'Arabic', 'Romana': 'Croatian', 'Japanese': 'SChinese', 'Korean': 'SChinese',\n              'Ryukyuan': 'SChinese', 'Serbian': 'Bulgarian', 'Albanian': 'Croatian', 'Galician': 'Croatian',\n@@ -314,6 +321,16 @@ def pick_font(tree, lang, need):\n     \"\"\"(file name in the pack, bytes, family, licence note, letters it still lacks) for a language, or None.\"\"\"\n     tried = [lang, FONT_FROM.get(lang)] + list(FONT_ANY)\n     best = None\n+    if lang in OWN_FONTS:\n+        p = os.path.join(HERE, 'fonts', OWN_FONTS[lang][0])\n+        data = open(p, 'rb').read()\n+        why = font_free(data)\n+        if why is not None:\n+            have = font_cmap(data)\n+            lack = [c for c in need if ord(c) not in have]\n+            best = ('font_%s.ttf' % lang, data, font_family(data), why, lack)\n+            if not lack:\n+                return best\n     for src in tried:\n         if src is None:\n             continue\n@@ -348,9 +365,32 @@ def ripps2_translations(lang):\n     return dict(data.get('strings') or {}), dict(data.get('labels') or {})\n \n \n+def prejoined(text):\n+    \"\"\"An upstream line stored already joined (Arabic presentation forms, in an order made for a renderer that only\n+    flipped runs): RIPPS2 now joins and lays out right-to-left text itself, so such a line would come out scrambled.\"\"\"\n+    return any(0xFB50 <= ord(c) <= 0xFDFF or 0xFE70 <= ord(c) <= 0xFEFF for c in text)\n+\n+\n+FOREIGN_SCRIPTS = {'Laotian': (0x0E00, 0x0E7F)}  # Thai\n+\n+\n+def other_script(lang, text):\n+    \"\"\"A line written partly in a script the language does not use (and its font does not carry).\"\"\"\n+    span = FOREIGN_SCRIPTS.get(lang)\n+    return span is not None and any(span[0] <= ord(c) <= span[1] for c in text)\n+\n+\n def build_language(tree, lang, base, english_template, report):\n     \"\"\"(the .lng text, every character it uses) for one language.\"\"\"\n     opl = opl_translations(os.path.join(tree, 'lng_src', lang + '.yml'))\n+    dropped = [k for k, v in opl.items() if prejoined(v)]\n+    if dropped:  # Persian's older half: elf/lang/Persian.yml has these labels written plain\n+        report.append('%s: %d upstream lines stored pre-joined left out (RIPPS2 joins the letters itself)' % (lang, len(dropped)))\n+        opl = {k: v for k, v in opl.items() if not prejoined(v)}\n+    foreign = [k for k, v in opl.items() if other_script(lang, v)]\n+    if foreign:  # RiptOPL's Lao overlay: 9 lines half in Thai, which font_Laotian has no letters for\n+        report.append('%s: %d upstream lines in another script left out (elf/lang has them)' % (lang, len(foreign)))\n+        opl = {k: v for k, v in opl.items() if not other_script(lang, v)}\n     mine, label_fill = ripps2_translations(lang)\n     via = STRINGS_FROM.get(lang)\n     if via:\n@@ -406,6 +446,7 @@ def pack(tree, out):\n     langs = sorted(f[:-4] for f in os.listdir(os.path.join(tree, 'lng_src')) if f.endswith('.yml') and f != 'English.yml')\n     builtin = font_cmap(open(os.path.join(tree, 'thirdparty', 'PoeVeticaNew.ttf'), 'rb').read())\n     report, notes, licences = [], [], []\n+    written = set()  # licence texts already in the pack\n     os.makedirs(out, exist_ok=True)\n     zpath = os.path.join(out, 'RIPPS2-languages.zip')\n     with zipfile.ZipFile(zpath, 'w', zipfile.ZIP_DEFLATED) as z:\n@@ -431,14 +472,25 @@ def pack(tree, out):\n                     font_note = '%s: %s, %d KB%s%s' % (name, family, len(data) // 1024,\n                                                       ' (cut from %d KB)' % (size // 1024) if len(data) < size else '',\n                                                       ', lacks %d: %s' % (len(lack), ''.join(lack[:20])) if lack else '')\n-                    licences.append('%s: %s\\n  %s\\n  the font says: %s\\n' % (name, family, why, (names.get(0, '') or '').strip()[:200]))\n+                    licence_file = ''\n+                    own = OWN_FONTS.get(lang)\n+                    if own is not None and data == open(os.path.join(HERE, 'fonts', own[0]), 'rb').read():\n+                        licence_file = own[1]  # RIPPS2's own: its licence text goes beside it, once\n+                        if licence_file not in written:\n+                            z.writestr('LNG/' + licence_file, open(os.path.join(HERE, 'fonts', licence_file), 'rb').read())\n+                            written.add(licence_file)\n+                    licences.append('%s: %s\\n  %s\\n  the font says: %s\\n%s' % (\n+                        name, family, why, (names.get(0, '') or '').strip()[:200],\n+                        '  from RIPPS2 (elf/lang/fonts); its licence in full: %s\\n' % licence_file if licence_file else ''))\n             notes.append('%-14s %4d strings (%3d of RIPPS2\\'s %d%s), %s' % (\n                 lang, n, n_mine, n_tmpl, ', gaps from %s' % STRINGS_FROM[lang] if lang in STRINGS_FROM else '', font_note))\n         z.writestr('LNG/README.txt', README_PACK.encode('utf-8'))\n         if licences:\n             z.writestr('LNG/FONTS.txt', ('The fonts in this folder come from Open PS2 Loader\\'s language pack\\n'\n-                                         '(github.com/ps2homebrew/Open-PS2-Loader-lang, thirdparty/); a big one is cut to the\\n'\n-                                         'letters its language uses. Each is free to pass on under its own licence:\\n\\n'\n+                                         '(github.com/ps2homebrew/Open-PS2-Loader-lang, thirdparty/), except Arabic, Persian and\\n'\n+                                         'Laotian\\'s, which RIPPS2 carries (DejaVu Sans with every joined Arabic letter, Noto Sans\\n'\n+                                         'Lao); a big one is cut to the letters its language uses. Each is free to pass on under\\n'\n+                                         'its own licence:\\n\\n'\n                                          + '\\n'.join(licences)).encode('utf-8'))\n     for line in licences:\n         print('lang font: ' + line.replace('\\n', ' | ').strip(' |'))"
+      },
+      {
+        "sha": "2837b7c9b332d25eaa81f7d87dd6e3ffb34f778d",
+        "filename": "elf/patches/0104-ripps2-languages.patch",
+        "status": "modified",
+        "additions": 434,
+        "deletions": 16,
+        "changes": 450,
+        "blob_url": "https://github.com/akilluminati47/RIPPS2/blob/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Fpatches%2F0104-ripps2-languages.patch",
+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Fpatches%2F0104-ripps2-languages.patch",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Fpatches%2F0104-ripps2-languages.patch?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -39,10 +39,10 @@ index fddcebb..3f34be2 100644\n  // in Memory Files (the file, its size and CRC, its argv, Sony's POPS files or Ember's BIOS beside it, the\n diff --git a/include/ripps2tr.h b/include/ripps2tr.h\n new file mode 100644\n-index 0000000..dbd66bb\n+index 0000000..f362d13\n --- /dev/null\n +++ b/include/ripps2tr.h\n-@@ -0,0 +1,48 @@\n+@@ -0,0 +1,55 @@\n +#ifndef __RIPPS2_TR_H\n +#define __RIPPS2_TR_H\n +\n@@ -89,10 +89,17 @@ index 0000000..dbd66bb\n +char *ripps2Utf8Copy(char *out, int size, const char *in);\n +// Could a line break go before the character at s (a CJK ideograph, kana or hangul, or after one)?\n +int ripps2Utf8BreakAt(const char *start, const char *s);\n++// Arabic and Persian: in with its Arabic letters joined (their presentation forms, lam-alef as one) and, with\n++// reorder, each line laid out right to left for drawing from the left (Latin words and numbers keep their order,\n++// brackets turn round), in out (size bytes). NULL when in has no right-to-left letters (draw it as it is) or the\n++// result does not fit. One caller at a time: fntsys calls it under its lock.\n++const char *ripps2Rtl(const char *in, char *out, int size, int reorder);\n++// A right-to-left letter (Hebrew, Arabic and their presentation forms; not the Arabic digits)?\n++int ripps2RtlChar(unsigned int c);\n +\n +#endif\n diff --git a/src/dia.c b/src/dia.c\n-index f0cd46c..9dd5d24 100644\n+index f0cd46c..f682d77 100644\n --- a/src/dia.c\n +++ b/src/dia.c\n @@ -15,6 +15,7 @@\n@@ -123,14 +130,15 @@ index f0cd46c..9dd5d24 100644\n  }\n  \n  /// returns true if the item is controllable (e.g. a value can be changed on it)\n-@@ -756,6 +757,23 @@ static float diaTipAlpha(const struct UIItem *item)\n+@@ -756,6 +757,26 @@ static float diaTipAlpha(const struct UIItem *item)\n      return diaTipEase(t / DIA_TIP_IN_S) * (1.0f - diaTipEase((t - DIA_TIP_HOLD_S) / DIA_TIP_OUT_S));\n  }\n  \n +// RIPPS2 build 104: Chinese, Japanese and Korean put no spaces between words, so a \"word\" here can be a whole\n +// clause. One with such letters fills the line it starts on and breaks between characters; a Latin word, a path or a\n +// URL still moves to the next line whole. UTF-8 lead bytes E3..ED are U+3000..U+DFFF (CJK punctuation, kana,\n-+// ideographs, Hangul); EF BC..BF is U+FF00..U+FFFF (fullwidth forms). A continuation byte is never one of these.\n++// ideographs, Hangul); EF BC..BF is U+FF00..U+FFFF (fullwidth forms); E0 B8..BB is U+0E00..U+0EFF, Thai and Lao,\n++// which write no spaces between words either. A continuation byte is never a lead byte.\n +static int diaHintHasCjk(const char *s, int len)\n +{\n +    const unsigned char *q = (const unsigned char *)s, *end = q + len;\n@@ -140,22 +148,24 @@ index f0cd46c..9dd5d24 100644\n +            return 1;\n +        if (*q == 0xEF && q + 1 < end && q[1] >= 0xBC)\n +            return 1;\n++        if (*q == 0xE0 && q + 1 < end && q[1] >= 0xB8 && q[1] <= 0xBB)\n++            return 1;\n +    }\n +    return 0;\n +}\n +\n  static int diaHintUtf8CharLen(const char *p)\n  {\n      unsigned char c;\n-@@ -869,6 +887,7 @@ static void diaDrawHint(const struct UIItem *item)\n+@@ -869,6 +890,7 @@ static void diaDrawHint(const struct UIItem *item)\n          const char *wordStart;\n          int wordLen;\n          int wordW;\n +        int cjk;\n  \n          // Explicit line breaks in translated strings remain line breaks.\n          if (*p == '\\r' || *p == '\\n') {\n-@@ -899,9 +918,10 @@ static void diaDrawHint(const struct UIItem *item)\n+@@ -899,9 +921,10 @@ static void diaDrawHint(const struct UIItem *item)\n          while (*p != '\\0' && *p != ' ' && *p != '\\t' && *p != '\\r' && *p != '\\n')\n              p++;\n          wordLen = (int)(p - wordStart);\n@@ -167,7 +177,7 @@ index f0cd46c..9dd5d24 100644\n              char word[256];\n  \n              memcpy(word, wordStart, wordLen);\n-@@ -940,8 +960,16 @@ static void diaDrawHint(const struct UIItem *item)\n+@@ -9