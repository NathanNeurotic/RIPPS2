+        "patch": "@@ -0,0 +1,483 @@\n+diff --git a/.github/scripts/test_bdm_scan_retry.py b/.github/scripts/test_bdm_scan_retry.py\n+index 0eea0f0..81626f4 100644\n+--- a/.github/scripts/test_bdm_scan_retry.py\n++++ b/.github/scripts/test_bdm_scan_retry.py\n+@@ -406,6 +406,7 @@ SCAN_HARNESS = r'''\n+ #include <strings.h>\n+ \n+ #define LOG(...) ((void)0)\n++#define DelayThread(us) ((void)(us)) /* RIPPS2 build 109: sbPadBreath's pause */\n+ #define O_RDONLY 0\n+ #define FOLDER_SUB_MAX 128\n+ #define ISO_GAME_NAME_MAX 160\n+diff --git a/include/dialogs.h b/include/dialogs.h\n+index e551546..d4213a7 100644\n+--- a/include/dialogs.h\n++++ b/include/dialogs.h\n+@@ -41,6 +41,8 @@ enum UI_ITEMS {\n+     CFG_RIPPS2_IGRMENU,  // RIPPS2 build 87: In-Game Menu (build 108: a row of Settings > General > In-Game Menu)\n+     UICFG_RIPPS2_RIPSHOT, // RIPPS2 build 108: RIPSHOT and Develop Shots, on the same page\n+     UICFG_RIPPS2_DEVELOP,\n++    UICFG_RIPPS2_SETTINGS_HOME, // RIPPS2 build 109: Save Settings To (Memory Card, Internal HDD, Custom Path)\n++    CFG_LBL_CUSTOMCFGPATH,      // and the Custom Settings Path row's label, shown with Custom Path\n+     UICFG_RIPPS2_MUSIC,  // RIPPS2: Music (a track from MUSIC/ beside RIPPS2)\n+     UICFG_RIPPS2_GLYPHS,  // RIPPS2 build 70: Colors and More's RIPPS2 rows\n+     UICFG_RIPPS2_PALETTE,\n+diff --git a/include/ripps2.h b/include/ripps2.h\n+index 06ed9f3..35ac388 100644\n+--- a/include/ripps2.h\n++++ b/include/ripps2.h\n+@@ -138,7 +138,12 @@ void ripps2StepCategory(int dir);   // -1 / +1, clamped at the ends\n+ void ripps2RenderCategoryBar(void); // the three labels plus the mark\n+ void ripps2DrawBusy(int alpha);     // loading: the mark breathes (in place, or small in the corner)\n+ void ripps2DiscWatch(void);         // every frame: the drive read after boot and after the tray closes\n+-int ripps2DiscQuiet(void);          // 1 while the disc watcher is all the IO worker is doing\n++int ripps2DiscQuiet(void);\n++struct UIItem;\n++int ripps2SettingsHddHome(char *out, int size);       // build 109: a RIPPS2 folder on the internal HDD, 0 when none\n++void ripps2SettingsHomeBegin(struct UIItem *ui);      // Save Settings To: set from the Custom Settings Path\n++void ripps2SettingsHomeShow(struct UIItem *ui);       // the Custom Settings Path row with Custom Path only\n++void ripps2SettingsHomeEnd(struct UIItem *ui);        // after the path was read back: the choice decides it          // 1 while the disc watcher is all the IO worker is doing\n+ void ripps2UiEnter(void);           // the menu's first frame: the bar fades in, the mark pops in\n+ void ripps2ShowViewWord(const char *word, int logo, const char *caption); // L3: name the new list, large (a word, or a texture id)\n+ void ripps2DrawViewWord(void);      // drawn over the Storage page while it plays\n+diff --git a/lng_tmpl/_base.yml b/lng_tmpl/_base.yml\n+index c41e86c..d1e72ef 100644\n+--- a/lng_tmpl/_base.yml\n++++ b/lng_tmpl/_base.yml\n+@@ -1075,6 +1075,10 @@ gui_strings:\n+   string: Are you sure? This applies forced-progressive 1080p to this game.\n+ - label: CUSTOM_SETTINGS_PATH\n+   string: Custom Settings Path\n++- label: RIPPS2_SETTINGS_HOME\n++  string: Save Settings To\n++- label: HINT_RIPPS2_SETTINGS_HOME\n++  string: \"Where RIPPS2 keeps its settings: RIPPS2's own save on a memory card, a RIPPS2 folder on the internal HDD, or a folder you type.\"\n+ - label: HINT_CUSTOM_SETTINGS_PATH\n+   string: \"Save settings to a folder you choose, e.g. mass0:/OPL. Leave blank to use the folder OPL booted from. The device is loaded on demand, so it need not be mounted when you type it.\"\n+ - label: PERGAME_MIXED_SETTINGS\n+diff --git a/src/dia.c b/src/dia.c\n+index 63f4271..0c7bbc9 100644\n+--- a/src/dia.c\n++++ b/src/dia.c\n+@@ -1058,6 +1058,9 @@ static void diaDrawHint(const struct UIItem *item)\n+ // any non-zero fixedHeight overrides upward (negative = percent of screenHeight). *h never depends on\n+ // x/y or the text, so this is