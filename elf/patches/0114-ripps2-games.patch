+// the settings: Custom's colour, the sweep chosen and the user's own sweeps ("name;RRGGBB,...x5;speed")
+static int sweepParse(const char *v, ripps2_sweep_t *out)
+{
+    const char *semi = strchr(v, ';');
+    unsigned int c[5];
+    int k, speed = 1, n;
+    if (semi == NULL || semi == v || semi - v >= (int)sizeof(out->name))
+        return 0;
+    memset(out, 0, sizeof(*out));
+    memcpy(out->name, v, semi - v);
+    n = sscanf(semi + 1, "%6x,%6x,%6x,%6x,%6x;%d", &c[0], &c[1], &c[2], &c[3], &c[4], &speed);
+    if (n < 5)
+        return 0;
+    for (k = 0; k < 5; k++) {
+        out->c[k][0] = (c[k] >> 16) & 0xFF;
+        out->c[k][1] = (c[k] >> 8) & 0xFF;
+        out->c[k][2] = c[k] & 0xFF;
+    }
+    out->speed = speed >= 0 && speed <= 2 ? speed : 1;
+    return 1;
+}
