+void ripps2PackGame(item_list_t *support, int id, int hideAfter)
+{
+    char prefix[160], src[300], dst[300], tmp[310], idxPath[310], info[200], msg[400], a[24], b[64], *dot;
+    sh_row_t r;
+    item_list_t view;
+    const base_game_info_t *g;
+    zp_job_t j;
+    unsigned char *in = NULL, *out = NULL, *blk = NULL;
+    u32 *idx = NULL;
+    int kind, rv = 0, cap, mins, sep, known;
+    long long need;
+    ripps2_vol_t vol;
+    const char *pfx, *where;
+
+    if (!zpRow(support, id, &r, &view, &g) || (kind = ripps2PackKind(support, id)) == 0)
+        return;
+    pfx = view.itemGetPrefix(&view);
+    snprintf(prefix, sizeof(prefix), "%s", pfx != NULL ? pfx : "");
+    sep = prefix[0] && prefix[strlen(prefix) - 1] == '\\' ? '\\' : '/';
+    {
+        char sepStr[2] = {(char)sep, 0};
+        sbCreatePath(g, src, prefix, sepStr, 0);
+    }
+    snprintf(dst, sizeof(dst), "%s", src);
+    if ((dot = strrchr(dst, '.')) == NULL)
+        return;
+    strcpy(dot, kind == 1 ? ".zso" : ".iso");
+    snprintf(tmp, sizeof(tmp), "%s.part", dst);
+    snprintf(idxPath, sizeof(idxPath), "%s.idx", dst);
+    where = lrWhere(r.mode);
+#ifdef RIPPS2_GUARD_TEST
+    snprintf(zpSrcPath, sizeof(zpSrcPath), "%s", src);
+#endif
+
+    memset(&j, 0, sizeof(j));
+    j.pack = kind == 1;
+    snprintf(j.name, sizeof(j.name), "%s", r.name);
+    j.fdIn = j.fdOut = -1;
+    if ((j.fdIn = open(dst, O_RDONLY)) >= 0) {
+        close(j.fdIn);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(j.pack ? _t("A ZSO of this game is already beside it. Remove one of the two first.") : _t("An ISO of this game is already beside it. Remove one of the two first."), 0, NULL);
+        return;
+    }
+    if ((j.fdIn = open(src, O_RDONLY)) < 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("RIPPS2 could not find this game's files on its drive."), 0, NULL);
+        return;
+    }
+    if (j.pack) {
+        j.inBytes = lseek64(j.fdIn, 0, SEEK_END);
+        lseek64(j.fdIn, 0, SEEK_SET);
+    } else {
+        unsigned char head[ZP_HEAD];
+        if (!zpReadAll(j.fdIn, head, ZP_HEAD) || *(u32 *)head != ZP_MAGIC || *(u32 *)(head + 16) != 2048)
+            j.inBytes = -1;
+        else {
+            j.inBytes = (s64)*(u32 *)(head + 8) | ((s64)*(u32 *)(head + 12) << 32);
+            j.align = head[21];
+        }
+    }
+    if (j.inBytes <= 0 || (j.inBytes & 2047)) {
+        close(j.fdIn);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("This image is not one RIPPS2 can compress or uncompress (its size is not whole 2 KB blocks)."), 0, NULL);
+        return;
+    }
+    j.blocks = (u32)(j.inBytes / 2048);
+    // build 114 (the user, 10/23): room for the new image before anything starts, the original staying to the end. A ZSO
+    // can come out a little bigger than its ISO (a block LZ4 cannot shrink is kept whole, and the index comes first), and
+    // packing keeps a side file of sizes beside it; a few MB more for the lists and art written after. Where the drive
+    // cannot say, the work goes on and stops cleanly if it fills
+    need = (j.pack ? j.inBytes + (long long)(j.blocks + 1) * 6 + ZP_HEAD : j.inBytes) + 8LL * 1048576;
+    known = ripps2VolInfo(prefix, &vol);
+    // (the user, 10/23: the drive's format detected): FAT keeps no file of 4 GB or more
+    if (known && vol.fsType != RIPPS2_FS_EXFAT && (j.pack ? j.inBytes + (long long)(j.blocks + 1) * 4 + ZP_HEAD : j.inBytes) > 0xFFFFFFFFLL) {
+        close(j.fdIn);
+        lrSize(j.inBytes, a, sizeof(a));
+        snprintf(msg, sizeof(msg), _t("This drive is %s, which keeps no file of 4 GB or more, and the new image would be %s."), ripps2FsName(vol.fsType), a);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    if (known && (long long)vol.freeKb * 1024 < need) {
+        close(j.fdIn);
+        lrSize(need, a, sizeof(a));
+        lrSize((long long)vol.freeKb * 1024, b, sizeof(b));
+        snprintf(msg, sizeof(msg), _t("%s needs about %s free on its drive while it works (the original stays until the end), and the drive has %s free."),
+                 r.name, a, b);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(msg, 0, NULL);
+        return;
+    }
+    if (r.mode == MMCE_MODE && !zpCanRename(dst)) {
+        close(j.fdIn);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("This MMCE card cannot rename a file, which compression needs for its last step. Update its sd2psXtd firmware to 1.4.0 or newer (sd2psxtd.github.io/download), then try again. Nothing was changed."), 0, NULL);
+        return;
+    }
+    // packing reads the ISO twice (its sizes, then its data) and writes about two thirds of it; the check reads that again.
+    // Unpacking reads the ZSO, writes the ISO and reads it back (the lab, 10/23: 2.4 said 5 min for 11; 10/24: packing
+    // Poinie's Poin, 1.2 GB on the internal HDD, at 3.4 said 7 min and took 10.5, the bar's own estimate right from 8%)
+    mins = (int)((double)j.inBytes * (j.pack ? 4.8 : 2.7) / (zpSpeed(r.mode) * 1048576.0) / 60.0 + 0.5);
+    lrSize(j.inBytes, a, sizeof(a));
+    snprintf(info, sizeof(info), _t("%s on %s"), a, where);
+    if (mins < 1)
+        snprintf(b, sizeof(b), "%s", _t("Under a minute, then checked"));
+    else
+        snprintf(b, sizeof(b), _t("About %d min, then checked"), mins);
+    if (!zpAsk(j.pack ? _t("COMPRESS TO ZSO") : _t("UNCOMPRESS TO ISO"), r.name, info, b)) {
+        close(j.fdIn);
+        return;
+    }
+    snprintf(msg, sizeof(msg),
+             j.pack ? _t("Compress %s? The ISO stays until the ZSO has been read back and checked, then RIPPS2 asks before it removes the ISO. The drive needs room for both while it works; leave the console on until it finishes. A ZSO starts with the OPL core only (not Neutrino); its saves, settings, art and cheats stay with it, and it can be made an ISO again at any time.")
+                    : _t("Make %s an ISO again? The ZSO stays until the ISO has been read back and checked, then RIPPS2 asks before it removes the ZSO. The drive needs room for both while it works; leave the console on until it finishes. Its saves, settings, art and cheats stay with it."),
+             r.name);
+    if (!guiMsgBox(msg, 1, NULL)) {
+        close(j.fdIn);
+        return;
+    }
+
+    cap = ZP_RUN * (2048 + (1 << (j.align > 4 ? j.align : 4)));
+    in = malloc(ZP_RUN * 2048);
+    out = malloc(cap);
+    blk = malloc(2048 + 64);
+    idx = malloc(ZP_IDX * 4);
+    j.crcs = malloc((j.blocks / ZP_RUN + 1) * 4);
+    j.stageSize = ripps2StageFor(known ? vol.clusterBytes : 0, ZP_STAGE);
+    if ((j.stage = memalign(64, j.stageSize)) == NULL && j.stageSize > ZP_STAGE)
+        j.stage = memalign(64, j.stageSize = ZP_STAGE);
+    if (in == NULL || out == NULL || blk == NULL || idx == NULL || j.crcs == NULL || j.stage == NULL) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("There is not enough memory for this just now."), 0, NULL);
+        goto end;
+    }
+    ioBlockOps(1); // nothing else reads or writes the drive while the image is made
+    ioLaunchBegin(); // and no background write of RIPPS2's starts (a file growing beside the image loses it clusters)
+    j.fdOut = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    j.began = ripps2Seconds();
+    j.work = j.inBytes * (j.pack ? 3 : 2); // packing: the sizes, the data, the check; unpacking: the data, the check
+    if (!j.pack) { // the ZSO is read through two handles of its own (zpOpenRead)
+        close(j.fdIn);
+        j.fdIn = -1;
+    }
+    if (j.fdOut < 0)
+        zpWhy(&j, "making the new file", 0);
+    else
+        rv = j.pack ? zpPack(&j, idxPath, in, out, blk, idx) : zpUnpack(&j, src, in, out, cap);
+    if (rv == 1 && !zpOutFlush(&j)) { // the last piece of the stage
+        zpWhy(&j, "writing the last piece", j.inBytes);
+        rv = 0;
+    }
+    unlink(idxPath); // the index's side file, made by packing
+    if (j.fdOut >= 0 && close(j.fdOut) < 0 && rv == 1)
+        rv = 0;
+    j.fdOut = -1;
+    if (j.fdIn >= 0)
+        close(j.fdIn);
+    j.fdIn = -1;
+    if (rv == 1) {
+        j.phase = 1;
+        j.done = j.inBytes * (j.pack ? 2 : 1);
+        rv = zpCheck(&j, tmp, in, out, cap);
+    }
+    if (rv == 1 && rename(tmp, dst) != 0) {
+        // an MMCE card renames from sd2psXtd 1.4.0 on (its MMCEMAN rename command)
+        zpWhy(&j, r.mode == MMCE_MODE ? "giving it its name; MMCE firmware 1.4.0 or newer renames" : "giving it its name", j.outBytes);
+        rv = 0;
+    }
+#ifdef RIPPS2_GUARD_TEST
+    if (rv == 0 && j.phase == 1)
+        printf("RIPPS2 compression test: %s kept to study\n", tmp);
+    else
+#endif
+        if (rv != 1)
+        unlink(tmp);
+    ioLaunchCancel();
+    ioBlockOps(0);
+    if (rv == 0) {
+        guiMsgBoxSound(SFX_ERROR);
+        snprintf(msg, sizeof(msg), _t("It could not be finished (%s). What it wrote was removed; the game is as it was."), j.why[0] ? j.why : "?");
+        guiMsgBox(msg, 0, NULL);
+        goto end;
+    }
+    if (rv < 0)
+        goto end;
+    lrSize(j.inBytes, a, sizeof(a));
+    lrSize(j.outBytes, b, sizeof(b));
+    snprintf(msg, sizeof(msg),
+             j.pack ? _t("%s: %s made %s (%d%%), every piece checked. Remove the ISO and keep the ZSO?")
+                    : _t("%s: %s made %s again, every piece checked. Remove the ZSO and keep the ISO?"),
+             r.name, j.pack ? a : b, j.pack ? b : a, (int)(j.outBytes * 100 / (j.inBytes > 0 ? j.inBytes : 1)));
+    guiMsgBoxSound(SFX_SAVE);
+    guiMsgBoxBackLabel(_t("Back (keeps both)")); // the user, 10/24: say what Back does here
+    if (guiMsgBox(msg, 1, NULL) && unlink(src) == 0) {
+        lrSize(j.pack ? j.inBytes - j.outBytes : 0, a, sizeof(a));
+        snprintf(msg, sizeof(msg), j.pack ? _t("COMPRESSED %s: %s FREED") : _t("UNCOMPRESSED %s"), r.name, a);
+        guiShowToast(msg);
+    }
+    // build 114 (the user, 10/23): Hide and Compress hides it once the work is done and checked; Compress alone keeps it
+    // visible (the hidden list goes by the game's name, which a ZSO keeps)
+    if (hideAfter && shAdd(&r) == 1) {
+        snprintf(msg, sizeof(msg), _t("COMPRESSED AND HIDDEN: %s"), r.name);
+        guiShowToast(msg);
+    }
+    shRefresh(r.mode);
+end:
+    if (j.fdIn >= 0)
+        close(j.fdIn);
+    free(in);
+    free(out);
+    free(blk);
+    free(idx);
+    free(j.crcs);
+    free(j.stage);
+}
