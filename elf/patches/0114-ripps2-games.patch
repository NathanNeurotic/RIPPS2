 it from this job's\n+  # artifact, or build it locally in the same image.\n+  popstarter-ilink-driver:\n+    runs-on: ubuntu-24.04\n+    container: ghcr.io/ps2dev/ps2dev@sha256:8fba50ecc2229acd7f8da63d34302f12939b7d4fa6848dda1e6a0ce083321a11\n+    steps:\n+      - name: Install make\n+        run: apk add --no-cache make\n+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0\n+        with:\n+          persist-credentials: false\n+      - name: Build ilink_bd_assault.irx with its Makefile\n+        run: |\n+          make -C modules/bdmassault/ilink_bd_assault clean\n+          make -C modules/bdmassault/ilink_bd_assault\n+          mipsel-none-elf-gcc --version | head -1\n+      - name: Require the checked-in usbhdfsd.irx.ilink copies to be this build\n+        run: |\n+          built=modules/bdmassault/ilink_bd_assault/ilink_bd_assault.irx\n+          echo \"built: $(wc -c < \"$built\") bytes, $(sha256sum \"$built\" | cut -d' ' -f1)\"\n+          status=0\n+          for copy in modules/bdmassault/usbhdfsd.irx.ilink POPS/usbhdfsd.irx.ilink \\\n+                      Example/APP_RIPTOPL-OFFICIALROLLING-VERSION.ZIP/usbhdfsd.irx.ilink; do\n+            if cmp -s \"$built\" \"$copy\"; then\n+              echo \"OK   $copy\"\n+            else\n+              echo \"DIFF $copy: $(wc -c < \"$copy\") bytes, $(sha256sum \"$copy\" | cut -d' ' -f1)\" >&2\n+              status=1\n+            fi\n+          done\n+          if [ \"$status\" != 0 ]; then\n+            echo \"Checked-in usbhdfsd.irx.ilink is not the output of modules/bdmassault/ilink_bd_assault.\" >&2\n+            echo \"Replace every copy with this job's artifact and update the pinned size/sha256\" >&2\n+            echo \"(src/vcdsupport.c, modules/bdmassault/PROVENANCE.md, docs/VCD.md).\" >&2\n+          fi\n+          exit $status\n+      - name: Upload the built driver\n+        if: ${{ always() }}\n+        uses: actions/upload-artifact@v6\n+        with:\n+          name: popstarter-usbhdfsd-irx-ilink\n+          path: modules/bdmassault/ilink_bd_assault/ilink_bd_assault.irx\n+          if-no-files-found: ignore\n+\n   build-flavour:\n     strategy:\n       fail-fast: false"
