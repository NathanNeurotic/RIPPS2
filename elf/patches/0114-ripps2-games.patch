+// ---- SHROUD ----
+
+#define SH_FILE "RIPPS2.HID"
+#define SH_MAX  512
+
+typedef struct
+{
+    char prefix[160]; // the drive's prefix the list was read from
+    int loaded, count;
+    char (*names)[164];
+    unsigned char *ps1;
+} shroud_t;
+
+static shroud_t shList[MODE_COUNT];
+static int shSema = -1;
+
+static void shLock(void)
+{
+    if (shSema < 0) {
+        ee_sema_t s;
+        s.init_count = 1;
+        s.max_count = 1;
+        s.option = 0;
+        s.attr = 0;
+        shSema = CreateSema(&s);
+    }
+    if (shSema >= 0)
+        WaitSema(shSema);
+}
+
+static void shUnlock(void)
+{
+    if (shSema >= 0)
+        SignalSema(shSema);
+}
+
+// The prefix of a source's page (RIPPS2.LST's folder); NULL when it has none to keep a list in
+static const char *shPrefix(int mode, char *out, int size)
+{
+    opl_io_module_t *mod = mode >= 0 && mode < MODE_COUNT ? oplGetModule(mode) : NULL;
+    char *p;
+    if (mod == NULL || mod->support == NULL || mod->support->itemGetPrefix == NULL || mode == HTTP_MODE)
+        return NULL;
+    p = mod->support->itemGetPrefix(mod->support);
+    if (p == NULL || p[0] == '\0')
+        return NULL;
+    snprintf(out, size, "%s", p);
+    return out;
+}
+
+static void shFree(shroud_t *s)
+{
+    free(s->names);
+    free(s->ps1);
+    s->names = NULL;
+    s->ps1 = NULL;
+    s->count = 0;
+}
+
+// (with shLock held)
+static void shLoad(int mode, int force)
+{
+    char prefix[160], path[200], line[200];
+    shroud_t *s = &shList[mode];
+    FILE *f;
+
+    if (shPrefix(mode, prefix, sizeof(prefix)) == NULL) {
+        shFree(s);
+        s->loaded = 0;
+        return;
+    }
+    if (s->loaded && !force && !strcmp(s->prefix, prefix))
+        return;
+    shFree(s);
+    snprintf(s->prefix, sizeof(s->prefix), "%s", prefix);
+    s->loaded = 1;
+    snprintf(path, sizeof(path), "%s%s", prefix, SH_FILE);
+    if ((f = fopen(path, "r")) == NULL)
+        return;
+    s->names = malloc(SH_MAX * sizeof(*s->names));
+    s->ps1 = malloc(SH_MAX);
+    if (s->names == NULL || s->ps1 == NULL) {
+        shFree(s);
+        fclose(f);
+        return;
+    }
+    while (s->count < SH_MAX && fgets(line, sizeof(line), f) != NULL) {
+        char *end = line + strlen(line);
+        while (end > line && (end[-1] == '\n' || end[-1] == '\r'))
+            *--end = '\0';
+        if ((line[0] != '0' && line[0] != '1') || line[1] != '\t' || line[2] == '\0')
+            continue;
+        s->ps1[s->count] = line[0] == '1';
+        snprintf(s->names[s->count++], sizeof(s->names[0]), "%s", line + 2);
+    }
+    fclose(f);
+}
+
+static int shSave(int mode)
+{
+    char path[200];
+    shroud_t *s = &shList[mode];
+    FILE *f;
+    int i;
+
+    if (!gEnableWrite || !s->loaded || s->prefix[0] == '\0')
+        return 0;
+    snprintf(path, sizeof(path), "%s%s", s->prefix, SH_FILE);
+    if (!ioWriteBegin()) // build 114: never once a launch has begun
+        return 0;
+    if (s->count == 0) {
+        remove(path);
+        ioWriteEnd();
+        return 1;
+    }
+    if ((f = fopen(path, "w")) == NULL) {
+        ioWriteEnd();
+        return 0;
+    }
+    for (i = 0; i < s->count; i++)
+        fprintf(f, "%d\t%s\n", s->ps1[i], s->names[i]);
+    i = fclose(f) == 0;
+    ioWriteEnd();
+    return i;
+}
+
+void ripps2ShroudReload(int mode)
+{
+    if (mode < 0 || mode >= MODE_COUNT || mode == APP_MODE || mode == FAV_MODE || mode == MIX_MODE)
+        return;
+    shLock();
+    shLoad(mode, 1);
+    shUnlock();
+}
+
+int ripps2ShroudHas(int mode, int ps1, const char *name)
+{
+    int i, has = 0;
+    if (mode < 0 || mode >= MODE_COUNT || name == NULL)
+        return 0;
+    shLock();
+    shLoad(mode, 0);
+    for (i = 0; i < shList[mode].count && !has; i++)
+        has = shList[mode].ps1[i] == (ps1 != 0) && !strcmp(shList[mode].names[i], name);
+    shUnlock();
+    return has;
+}
+
+static int shKindIsPs1(int kind)
+{
+    return kind == FAV_KIND_VCD || kind == FAV_KIND_CUE;
+}
+
+int ripps2ShroudRow(item_list_t *support, int id)
+{
+    int mode, ps1;
+    const char *name;
+
+    if (support == NULL || support->mode == APP_MODE || support->mode == MIX_MODE) // All Games leaves them out as it gathers
+        return 0;
+    name = support->itemGetName != NULL ? support->itemGetName(support, id) : NULL;
+    if (support->mode == FAV_MODE) {
+        mode = favGetItemSourceMode(id);
+        ps1 = shKindIsPs1(favGetItemKind(id));
+    } else {
+        mode = support->mode;
+        ps1 = (support->itemGetView != NULL ? support->itemGetView(support, id) : libListViewActive(support)) == LIB_VIEW_PS1;
+    }
+    return mode >= 0 && ripps2ShroudHas(mode, ps1, name);
+}
+
+// Every page that could list it is read again: its drive's, All Games, Starred Games
+static void shRefresh(int mode)
+{
+    opl_io_module_t *mod = oplGetModule(mode);
+    if (mod != NULL && mod->support != NULL && mod->support->enabled) {
+        libViewMarkDirty(mode);
+        ioPutRequest(IO_MENU_UPDATE_DEFFERED, &mod->support->mode);
+    }
+    mixRequestUpdate();
+    loadFavourites();
+}
+
+// The source row behind a row of any page: its mode, its id in the source's own (forced) list, its kind, its name
+typedef struct
+{
+    int mode, id, kind;
+    char name[256];
+} sh_row_t;
+
+static int shResolve(item_list_t *support, int id, sh_row_t *r)
+{
+    const char *n;
+    int tries;
+    if (support == NULL)
+        return 0;
+    if (support->mode == MIX_MODE || support->mode == FAV_MODE) {
+        int mix = support->mode == MIX_MODE;
+        if (mix && mixIsWaiting(id)) {
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(_t("This game's drive has not answered yet. Wait for it, then try again."), 0, NULL);
+            return 0;
+        }
+        r->mode = mix ? mixGetItemSourceMode(id) : favGetItemSourceMode(id);
+        r->kind = mix ? mixGetItemKind(id) : favGetItemKind(id);
+        // the lab, 10/22: a drive reads its list again behind the saved one (Fast Cache), and while it does the
+        // game is not in that list for a moment, so Hide Game and Delete did nothing at all. Wait for it a little,
+        // then say so rather than stay silent.
+        for (tries = 0; tries < 15; tries++) {
+            r->id = mix ? mixGetItemSourceId(id) : favGetItemSourceId(id);
+            if (r->id >= 0 || r->mode < 0)
+                break;
+            DelayThread(100 * 1000);
+        }
+        if (r->mode >= 0 && r->id < 0) {
+            LOG("SHROUD: row %d (mode %d) not in its drive's list after %d tries\n", id, r->mode, tries);
+            guiMsgBoxSound(SFX_ERROR);
+            guiMsgBox(_t("This game's drive has not answered yet. Wait for it, then try again."), 0, NULL);
+            return 0;
+        }
+    } else {
+        int view = support->itemGetView != NULL ? support->itemGetView(support, id) : libListViewActive(support);
+        r->mode = support->mode;
+        r->id = id;
+        r->kind = FAV_KIND_ISO;
+        if (view == LIB_VIEW_PS1) {
+            const base_game_info_t *g = support->itemGet != NULL ? (const base_game_info_t *)support->itemGet(support, id) : NULL;
+            r->kind = (support->mode != HDD_MODE && g != NULL && cueIsCueEntry(g)) ? FAV_KIND_CUE : FAV_KIND_VCD;
+        }
+    }
+    n = support->itemGetName != NULL ? support->itemGetName(support, id) : NULL;
+    if (r->mode < 0 || r->id < 0 || n == NULL || n[0] == '\0')
+        return 0;
+    snprintf(r->name, sizeof(r->name), "%s", n);
+    return 1;
+}
+
+// a game onto its drive's hidden list: 1 done, 0 failed (said), -1 the drive keeps no list (said). Hide Game and
+// Hide and Compress (build 114) share it
+static int shAdd(const sh_row_t *rr)
+{
+    sh_row_t r = *rr;
+    shroud_t *s;
+    int ok;
+    // the lab, 10/22: written while the IO worker was reading the drive again, RIPPS2.HID was made and its data never
+    // landed. Hold the worker off first (before the lock, which the worker's own scan takes), as LAST RITES does.
+    ioBlockOps(1);
+    shLock();
+    shLoad(r.mode, 1);
+    s = &shList[r.mode];
+    if (!s->loaded) {
+        shUnlock();
+        ioBlockOps(0);
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("This drive cannot keep a hidden list (a network catalogue)."), 0, NULL);
+        return -1;
+    }
+    if (s->names == NULL) {
+        s->names = malloc(SH_MAX * sizeof(*s->names));
+        s->ps1 = malloc(SH_MAX);
+    }
+    ok = s->names != NULL && s->ps1 != NULL && s->count < SH_MAX;
+    if (ok) {
+        s->ps1[s->count] = shKindIsPs1(r.kind);
+        snprintf(s->names[s->count++], sizeof(s->names[0]), "%s", r.name);
+        ok = shSave(r.mode);
+        if (!ok)
+            s->count--;
+    }
+    shUnlock();
+    ioBlockOps(0);
+    if (!ok) {
+        guiMsgBoxSound(SFX_ERROR);
+        guiMsgBox(_t("The hidden list could not be written to the game's drive. Is it write-protected, or are Write Operations off?"), 0, NULL);
+        return 0;
+    }
+    shRefresh(r.mode);
+    return 1;
+}
+
+void ripps2ShroudHide(item_list_t *support, int id)
+{
+    char msg[400];
+    sh_row_t r;
+
+    if (!shResolve(support, id, &r))
+        return;
+    snprintf(msg, sizeof(msg), _t("Hide %s? It leaves every list, All Games and Starred Games too. Settings > Game Sources > Hidden Games shows it again."), r.name);
+    guiMsgBoxSound(SFX_MESSAGE);
+    if (guiMsgBox(msg, 1, NULL) != 1)
+        return;
+    if (shAdd(&r) != 1)
+        return;
+    snprintf(msg, sizeof(msg), _t("HIDDEN: %s"), r.name);
+    guiShowToast(msg);
+}
+
+// ---- LAST RITES ----
+
+enum { LR_IMAGE = 0, LR_PARTITION, LR_CFG, LR_ART, LR_CHT, LR_VMC, LR_SHOTS, LR_FOLDER, LR_POPSAVE };
+#define LR_MAX 48
+
+typedef struct
+{
+    char path[256];
+    int what, keep, shared;
+    long long bytes;
+} lr_item_t;
+
+static lr_item_t lrItems[LR_MAX];
+static int lrCount;
+
+static long long lrFileSize(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 ? (long long)st.st_size : -1;
+}
+
+static long long lrTreeSize(const char *dir)
+{
+    char path[320];
+    long long total = 0;
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    if (d == NULL)
+        return -1;
+    while ((e = readdir(d)) != NULL) {
+        struct stat st;
+        if (e->d_name[0] == '.')
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        if (stat(path, &st) != 0)
+            continue;
+        if (S_ISDIR(st.st_mode)) {
+            long long sub = lrTreeSize(path);
+            total += sub > 0 ? sub : 0;
+        } else
+            total += st.st_size;
+    }
+    closedir(d);
+    return total;
+}
+
+static int lrRemoveTree(const char *dir)
+{
+    char path[320];
+    int ok = 1;
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    if (d == NULL)
+        return 0;
+    while ((e = readdir(d)) != NULL) {
+        struct stat st;
+        if (e->d_name[0] == '.')
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
+        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode))
+            ok &= lrRemoveTree(path);
+        else
+            ok &= unlink(path) == 0;
+    }
+    closedir(d);
+    return ok && rmdir(dir) == 0;
+}
+
+static void lrAdd(int what, const char *path, long long bytes, int keep)
+{
+    if (lrCount >= LR_MAX || bytes < 0)
+        return;
+    snprintf(lrItems[lrCount].path, sizeof(lrItems[lrCount].path), "%s", path);
+    lrItems[lrCount].what = what;
+    lrItems[lrCount].keep = keep;
+    lrItems[lrCount].shared = 0;
+    lrItems[lrCount++].bytes = bytes;
+}
+
+static void lrAddFile(int what, const char *path, int keep)
+{
+    lrAdd(what, path, lrFileSize(path), keep);
+}
+
+// "3.1 GB" / "640 MB" / "12 KB"
+static void lrSize(long long bytes, char *out, int size)
+{
+    if (bytes >= 1024LL * 1024 * 1024)
+        snprintf(out, size, "%d.%d GB", (int)(bytes / (1024LL * 1024 * 1024)), (int)(bytes % (1024LL * 1024 * 1024) * 10 / (1024LL * 1024 * 1024)));
+    else if (bytes >= 1024 * 1024)
+        snprintf(out, size, "%d MB", (int)(bytes / (1024 * 1024)));
+    else
+        snprintf(out, size, "%d KB", (int)((bytes + 1023) / 1024));
+}
+
+// A game's extras in its drive's folders: CFG, art, cheats, then its VMCs and full-size shots (kept unless asked).
+// shared: another copy of the game on this drive keeps the CFG, art and cheats.
+static void lrPlanExtras(item_list_t *view, int id, const char *prefix, char sep, const char *startup, const char *name, int shared)
+{
+    static const char *const art[] = {"COV", "COV2", "ICO", "LAB", "LGO", "BG", "SCR", "SCR2", "SCR3", "SCR4", "SCR5", "SCR6", "SCR7", "SCR8", "SCR9"};
+    char path[256];
+    const char *vmc = NULL;
+    int i, k;
+    config_set_t *cfg;
+
+    snprintf(path, sizeof(path), "%sCFG%c%s.cfg", prefix, sep, startup);
+    lrAddFile(LR_CFG, path, shared);
+    for (i = 0; i < (int)(sizeof(art) / sizeof(art[0])); i++)
+        for (k = 0; k < 2; k++) {
+            snprintf(path, sizeof(path), "%sART%c%s_%s.%s", prefix, sep, startup, art[i], k ? "jpg" : "png");
+            lrAddFile(LR_ART, path, shared);
+        }
+    snprintf(path, sizeof(path), "%sCHT%c%s.cht", prefix, sep, startup);
+    lrAddFile(LR_CHT, path, shared);
+    for (i = 0; i < lrCount; i++)
+        if (lrItems[i].what == LR_CFG || lrItems[i].what == LR_ART || lrItems[i].what == LR_CHT)
+            lrItems[i].shared = shared;
+    cfg = view->itemGetConfig != NULL ? view->itemGetConfig(view, id) : NULL;
+    for (i = 0; cfg != NULL && i < 2; i++) {
+        char key[16];
+        snprintf(key, sizeof(key), CONFIG_ITEM_VMC "_%d", i);
+        if (configGetStr(cfg, key, &vmc) && vmc != NULL && vmc[0]) {
+            snprintf(path, sizeof(path), "%sVMC%c%s.bin", prefix, sep, vmc);
+            lrAddFile(LR_VMC, path, 1);
+        }
+    }
+    if (cfg != NULL)
+        configFree(cfg);
+    snprintf(path, sizeof(path), "%sMEDIA%c%s", prefix, sep, name);
+    lrAdd(LR_SHOTS, path, lrTreeSize(path), 1);
+}
+
+// ---- the APA check ----
+
+#define LR_APA_MAGIC 0x00415041 // 'APA\0'
+
+static u32 lrLe32(const u8 *p)
+{
+    return p[0] | p[1] << 8 | p[2] << 16 | (u32)p[3] << 24;
+}
+
+// The largest partition this disk takes, as the driver works it out (apaGetPartitionMax, with its under-40 GB rule)
+static u32 lrApaMax(u32 total)
+{
+    u32 size;
+    int i;
+    if (total < 0x04ffffff)
+        total = 0x04ffffff;
+    total >>= 6;
+    for (i = 31; i != 0; i--) {
+        size = (u32)1 << i;
+        if (size & total)
+            break;
+    }
+    if (((u32)1 << i) < total)
+        i++;
+    return (u32)1 << i;
+}
+
+int ripps2ApaCheck(char *why, int whySize)
+{
+    static u8 hdr[1024] __attribute__((aligned(64)));
+    u32 total = hddGetTotalSectors(), max, lba = 0, lastStart = 0, n = 0;
+
+    if (total == 0) {
+        snprintf(why, whySize, _t("the drive's size could not be read"));
+        return 0;
+    }
+    max = lrApaMax(total);
+    do {
+        u32 sum = 0, sum1 = 0, start, length, next, prev, i;
+        if (hddReadSectors(lba, 2, hdr) != 0) {
+            snprintf(why, whySize, _t("the header at sector %u could not be read"), (unsigned)lba);
+            return 0;
+        }
+        for (i = 1; i < 256; i++) {
+            sum += lrLe32(hdr + i * 4);
+            if (i < 128)
+                sum1 += lrLe32(hdr + i * 4);
+        }
+        start = lrLe32(hdr + 64);
+        length = lrLe32(hdr + 68);
+        next = lrLe32(hdr + 8);
+        prev = lrLe32(hdr + 12);
+        if (lrLe32(hdr + 4) != LR_APA_MAGIC) {
+            snprintf(why, whySize, _t("sector %u holds no partition header"), (unsigned)lba);
+            return 0;
+        }
+        if (lrLe32(hdr) != sum && lrLe32(hdr) != sum1) {
+            snprintf(why, whySize, _t("the header at sector %u fails its checksum"), (unsigned)lba);
+            return 0;
+        }
+        if (start != lba || length == 0 || (length & (length - 1)) || (lba != 0 && start % length)) {
+            snprintf(why, whySize, _t("the partition at sector %u is not where or as large as APA puts one"), (unsigned)lba);
+            return 0;
+        }
+        if ((unsigned long long)start + length > total) {
+            snprintf(why, whySize, _t("a partition runs past the end of this disk (sector %u of %u): the table was made for a bigger disk"), (unsigned)(start + length), (unsigned)total);
+            return 0;
+        }
+        if (lba != 0 && length > max) {
+            snprintf(why, whySize, _t("a partition is larger than this disk allows: the table was made for a disk of another size"));
+            return 0;
+        }
+        if (n > 0 && prev != lastStart) {
+            snprintf(why, whySize, _t("the chain's links disagree at sector %u"), (unsigned)lba);
+            return 0;
+        }
+        if (next != 0 && next != start + length) {
+            snprintf(why, whySize, _t("the chain skips from sector %u"), (unsigned)lba);
+            return 0;
+        }
+        lastStart = start;
+        lba = next;
+        n++;
+    } while (lba != 0 && n < 65536);
+    if (n >= 65536 || hddReadSectors(0, 2, hdr) != 0 || lrLe32(hdr + 12) != lastStart) {
+        snprintf(why, whySize, _t("the chain does not close at __mbr"));
+        return 0;
+    }
+    snprintf(why, whySize, _t("%u partitions, all in order"), (unsigned)n);
+    return 1;
+}
