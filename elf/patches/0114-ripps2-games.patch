+        "patch": "@@ -7,6 +7,26 @@\n  * interrupt state and guest cycle accounting are untouched. */\n     .set noreorder\n     .set noat\n+#ifndef NP_GP0_EMPTY_FLUSH_FASTPATH\n+#define NP_GP0_EMPTY_FLUSH_FASTPATH 1\n+#endif\n+#if NP_GP0_EMPTY_FLUSH_FASTPATH < 0 || NP_GP0_EMPTY_FLUSH_FASTPATH > 1\n+#error \"GP0 empty flush accepts a boolean build flag only\"\n+#endif\n+#ifndef NP_GP0_PUBLISH_TWO_TEMPS\n+#define NP_GP0_PUBLISH_TWO_TEMPS 1\n+#endif\n+#if NP_GP0_PUBLISH_TWO_TEMPS < 0 || NP_GP0_PUBLISH_TWO_TEMPS > 1\n+#error \"GP0 publish temporary selection accepts a boolean build flag only\"\n+#endif\n+#if NP_GP0_PUBLISH_TWO_TEMPS\n+/* Both exits replace v0: deferred returns a0; native PollSema supplies v0.\n+ * Scalar operations preserve its upper half. Retain the original frame and\n+ * native producer offsets while leaving temporary $10 untouched. */\n+#define NP_GP0_PUBLISH_TMP $v0\n+#else\n+#define NP_GP0_PUBLISH_TMP $10\n+#endif\n #if NP_GP0_PACKET_COALESCE < 0 || NP_GP0_PACKET_COALESCE > 1 || NP_GP0_SCALAR_WRITE < 0 || NP_GP0_SCALAR_WRITE > 1\n #error \"GP0 adapters accept boolean build flags only\"\n #endif\n@@ -23,7 +43,9 @@ np_gp0_publish:\n     addiu $sp,$sp,-48\n     sq $8,0($sp)\n     sq $9,16($sp)\n+#if !NP_GP0_PUBLISH_TWO_TEMPS\n     sq $10,32($sp)\n+#endif\n     la $8,np_gp0_records\n #if NP_GP0_PACKET_TRACE\n     lw $9,4($8)\n@@ -40,15 +62,15 @@ np_gp0_publish:\n     beqz $9,np_gp0_native\n     nop\n     ld $9,88($sp)\n-    li $10,0x20b510\n-    bne $9,$10,np_gp0_native\n+    li NP_GP0_PUBLISH_TMP,0x20b510\n+    bne $9,NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n     li $9,1\n     bne $s2,$9,np_gp0_native\n     nop\n     lw $9,0x2270($s0)\n-    li $10,0xffffff\n-    bne $9,$10,np_gp0_native\n+    li NP_GP0_PUBLISH_TMP,0xffffff\n+    bne $9,NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n     lw $9,0x227c($s0)\n     bnez $9,np_gp0_native\n@@ -57,52 +79,52 @@ np_gp0_publish:\n     bnez $9,np_gp0_native\n     nop\n     lw $9,0x22bc($s0)\n-    li $10,-1\n-    bne $9,$10,np_gp0_native\n+    li NP_GP0_PUBLISH_TMP,-1\n+    bne $9,NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n     lw $9,0x228c($s0)\n     bnez $9,np_gp0_native\n     nop\n     lw $9,0x2140($s0)\n-    addiu $10,$s0,0x20c0\n-    bne $9,$10,np_gp0_native\n+    addiu NP_GP0_PUBLISH_TMP,$s0,0x20c0\n+    bne $9,NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n     lw $9,0($9)\n     srl $9,$9,24\n     /* A0 has a fixed three-word header in the pinned native table. Once its\n      * third word is present, publish immediately: the native worker owns all\n      * pixel acquisition, transfer completion and buffer reuse. This also\n      * excludes data words while the worker's active-command field is set. */\n-    addiu $10,$9,-0xa0\n-    beqz $10,np_gp0_fixed\n+    addiu NP_GP0_PUBLISH_TMP,$9,-0xa0\n+    beqz NP_GP0_PUBLISH_TMP,np_gp0_fixed\n     nop\n     /* Fixed polygons 20..3f, lines 40..47/50..57, rectangles 60..7f.\n      * Exclude variable polylines despite their table's fixed initial length. */\n-    addiu $10,$9,-0x20\n-    sltiu $10,$10,0x28\n-    bnez $10,np_gp0_fixed\n+    addiu NP_GP0_PUBLISH_TMP,$9,-0x20\n+    sltiu NP_GP0_PUBLISH_TMP,NP_GP0_PUBLISH_TMP,0x28\n+    bnez NP_GP0_PUBLISH_TMP,np_gp0_fixed\n     nop\n-    addiu $10,$9,-0x50\n-    sltiu $10,$10,8\n-    bnez $10,np_gp0_fixed\n+    addiu NP_GP0_PUBLISH_TMP,$9,-0x50\n+    sltiu NP_GP0_PUBLISH_TMP,NP_GP0_PUBLISH_TMP,8\n+    bnez NP_GP0_PUBLISH_TMP,np_gp0_fixed\n     nop\n-    addiu $10,$9,-0x60\n-    sltiu $10,$10,0x20\n-    beqz $10,np_gp0_native\n+    addiu NP_GP0_PUBLISH_TMP,$9,-0x60\n+    sltiu NP_GP0_PUBLISH_TMP,NP_GP0_PUBLISH_TMP,0x20\n+    beqz NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n np_gp0_fixed:\n     sll $9,$9,3\n-    li $10,0x4ff5c0\n-    addu $9,$9,$10\n+    li NP_GP0_PUBLISH_TMP,0x4ff5c0\n+    addu $9,$9,NP_GP0_PUBLISH_TMP\n     lw $9,0($9)\n-    addiu $10,$9,-2\n-    sltiu $10,$10,11\n-    beqz $10,np_gp0_native\n+    addiu NP_GP0_PUBLISH_TMP,$9,-2\n+    sltiu NP_GP0_PUBLISH_TMP,NP_GP0_PUBLISH_TMP,11\n+    beqz NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n-    lw $10,0x2288($s0)\n-    beqz $10,np_gp0_native\n+    lw NP_GP0_PUBLISH_TMP,0x2288($s0)\n+    beqz NP_GP0_PUBLISH_TMP,np_gp0_native\n     nop\n-    sltu $9,$10,$9\n+    sltu $9,NP_GP0_PUBLISH_TMP,$9\n     beqz $9,np_gp0_native\n     nop\n np_gp0_defer:\n@@ -120,7 +142,9 @@ np_gp0_defer:\n #endif\n     lq $8,0($sp)\n     lq $9,16($sp)\n+#if !NP_GP0_PUBLISH_TWO_TEMPS\n     lq $10,32($sp)\n+#endif\n     addiu $sp,$sp,48\n     move $v0,$a0\n     ld $s1,8($sp)\n@@ -137,13 +161,24 @@ np_gp0_native:\n     sw $zero,0($8)\n     lq $8,0($sp)\n     lq $9,16($sp)\n+#if !NP_GP0_PUBLISH_TWO_TEMPS\n     lq $10,32($sp)\n+#endif\n     addiu $sp,$sp,48\n     /* Replay PollSema, then the intact native epilogue and SignalSema. */\n     li $ra,0x21a97c\n     j 0x22e870\n     nop\n \n+#if NP_GP0_PUBLISH_TWO_TEMPS\n+    /* Replace the removed SQ and native LQ in unused, unreachable space.\n+     * The coalescing path also loses its deferred LQ. Keep later entries fixed. */\n+    .space 8\n+#if NP_GP0_PACKET_COALESCE\n+    .space 4\n+#endif\n+#endif\n+\n #if NP_GP0_SCALAR_WRITE\n     .globl np_gp0_scalar_write\n np_gp0_scalar_write:\n@@ -253,26 +288,47 @@ np_gp0_video_barrier:\n     j 0x21aeb8\n     nop\n np_gp0_flush:\n-    /* Inspect the deferred flag using only two saved wide temporaries. Keep\n-     * the original frame layout; an empty flush needs no syscall context. */\n+    /* Keep the original frame layout. An empty flush needs no syscall context;\n+     * the optional path also avoids preserving a second wide temporary. */\n     addiu $sp,$sp,-96\n     sq $8,64($sp)\n+#if NP_GP0_EMPTY_FLUSH_FASTPATH\n+    /* The empty path needs one temporary. Relocated displacements retain\n+     * the original code size and leave the pending path's work unchanged. */\n+    lui $8,%hi(np_gp0_records)\n+    lw $8,%lo(np_gp0_records)($8)\n+    beqz $8,np_gp0_flush_done\n+    nop\n+    sq $9,80($sp)\n+#else\n     sq $9,80($sp)\n     la $8,np_gp0_records\n     lw $9,0($8)\n     beqz $9,np_gp0_flush_done\n     nop\n+#endif\n     /* Native syscalls may change v0/v1. Save them, their argument and RA only\n      * for a pending flush, before any clear, trace update or semaphore call. */\n     sq $ra,0($sp)\n     sq $v0,16($sp)\n     sq $v1,32($sp)\n     sq $a0,48($sp)\n+#if NP_GP0_EMPTY_FLUSH_FASTPATH\n+    lui $8,%hi(np_gp0_records)\n+    sw $zero,%lo(np_gp0_records)($8)\n+#else\n     sw $zero,0($8)\n+#endif\n #if NP_GP0_PACKET_TRACE\n+#if NP_GP0_EMPTY_FLUSH_FASTPATH\n+    lw $9,%lo(np_gp0_records+12)($8)\n+    addiu $9,$9,1\n+    sw $9,%lo(np_gp0_records+12)($8)\n+#else\n     lw $9,12($8)\n     addiu $9,$9,1\n     sw $9,12($8)\n+#endif\n #else\n     .space 12\n #endif\n@@ -286,9 +342,14 @@ np_gp0_flush:\n     lq $v0,16($sp)\n     lq $v1,32($sp)\n     lq $a0,48($sp)\n+#if NP_GP0_EMPTY_FLUSH_FASTPATH\n+    lq $9,80($sp)\n+#endif\n np_gp0_flush_done:\n     lq $8,64($sp)\n+#if !NP_GP0_EMPTY_FLUSH_FASTPATH\n     lq $9,80($sp)\n+#endif\n     jr $ra\n     addiu $sp,$sp,96\n     .balign 16"
