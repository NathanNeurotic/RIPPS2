 into display pixels as the string is placed) and cut at the\n     sides of a window (fntClipX0..fntClipX1, display pixels; equal: no window), a glyph that crosses its edge drawn\n-@@ -769,7 +852,9 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+@@ -719,6 +802,7 @@ void fntSetLineHeight(int height)\n+ #ifndef __RTL\n+ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t height, const char *string, u64 colour)\n+ {\n++    static char rtlDraw[2048]; // build 104: under the font lock\n+     if (string == NULL)\n+         return 0;\n+     fntLock();\n+@@ -750,6 +834,12 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+ \n+     quad.color = colour;\n+ \n++    // build 104: Arabic and Persian, their letters joined and each line laid out right to left, then drawn from the\n++    // left like any other text (measured above from the same joined letters, so a centred line stays centred)\n++    const char *visual = ripps2Rtl(string, rtlDraw, sizeof(rtlDraw), 1);\n++    if (visual != NULL)\n++        string = visual;\n++\n+     int pen_x = x;\n+     int xmax = x + width;\n+     int ymax = y + height;\n+@@ -765,11 +855,16 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+     // we should instead have a dynamic layout routine that'll replace spaces with newlines as appropriate\n+     // because that'll make the code run only once per N frames, not every frame\n+ \n++    // build 104: the letter a mark goes over (where it was drawn, its advance) and the top of the last mark put above it\n++    int markBaseX = 0, markBaseAdv = 0, markAbove = 0;\n++\n+     // cache glyphs and render as we go\n      for (; *string; ++string) {\n          if (utf8Decode(&state, &codepoint, *string)) // accumulate the codepoint value\n              continue;\n@@ -413,7 +462,40 @@ index 06870fe..ca069ed 100644\n  \n          glyph = fntCacheGlyph(font, codepoint);\n          if (!glyph)\n-@@ -830,7 +915,9 @@ static void fntRenderSubRTL(font_t *font, const char *startRTL, const char *stri\n+@@ -788,6 +883,7 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+         if (width) {\n+             if (codepoint == '\\n') {\n+                 pen_x = x;\n++                markBaseAdv = 0;\n+                 y += rmScaleY(fntLineStep > 0 ? fntLineStep : MENU_ITEM_HEIGHT); // hmax is too tight and unordered, generally\n+                 continue;\n+             }\n+@@ -801,6 +897,24 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+             }\n+         }\n+ \n++        // build 104: a mark with no advance that its font draws to the right of the pen (Noto Sans Lao's vowels and tone\n++        // marks, DejaVu's Arabic vowel marks: placed by OpenType positioning, which fntsys does not read) is centred\n++        // over the letter before it, and a second mark above that letter stacks over the first. A Latin combining\n++        // mark, drawn to the left of the pen, is left as it is.\n++        if (glyph->shx == 0 && glyph->width > 0 && glyph->ox >= 0 && markBaseAdv > 0) {\n++            int my = y, bottom = glyph->oy + (int)glyph->height; // from the baseline, up is negative\n++            if (bottom <= 0) {\n++                if (markAbove < 0 && bottom > markAbove - 1)\n++                    my -= bottom - (markAbove - 1);\n++                markAbove = glyph->oy + (my - y);\n++            }\n++            fntRenderGlyph(glyph, markBaseX + (markBaseAdv - (int)glyph->width) / 2 - glyph->ox, my);\n++            continue;\n++        }\n++        markBaseX = pen_x;\n++        markBaseAdv = glyph->shx >> 6;\n++        markAbove = 0;\n++\n+         fntRenderGlyph(glyph, pen_x, y);\n+         pen_x += glyph->shx >> 6;\n+     }\n+@@ -830,7 +944,9 @@ static void fntRenderSubRTL(font_t *font, const char *startRTL, const char *stri\n      for (; startRTL != string; ++startRTL) {\n          if (utf8Decode(&state, &codepoint, *startRTL))\n              continue;\n@@ -424,7 +506,7 @@ index 06870fe..ca069ed 100644\n  \n          glyph = fntCacheGlyph(font, codepoint);\n          if (!glyph)\n-@@ -900,7 +987,9 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n+@@ -900,7 +1016,9 @@ int fntRenderString(int id, int x, int y, short aligned, size_t width, size_t he\n      for (; *string; ++string) {\n          if (utf8Decode(&state, &codepoint, *string)) // accumulate the codepoint value\n              continue;\n@@ -435,7 +517,22 @@ index 06870fe..ca069ed 100644\n  \n          glyph = fntCacheGlyph(font, codepoint);\n          if (!glyph)\n-@@ -1155,7 +1244,9 @@ static int fntCalcDimensionsLocked(font_t *font, const char *str)\n+@@ -1141,9 +1259,14 @@ int fntCalcDimensions(int id, const char *str)\n+ static int fntCalcDimensionsLocked(font_t *font, const char *str)\n+ {\n+     int w = 0;\n++    static char rtlMeasure[2048]; // build 104: under the font lock, like every caller of this\n+ \n+     if (str == NULL)\n+         return 0;\n++    // build 104: Arabic and Persian are measured as drawn, their letters joined (a joined letter is narrower)\n++    const char *joined = ripps2Rtl(str, rtlMeasure, sizeof(rtlMeasure), 0);\n++    if (joined != NULL)\n++        str = joined;\n+ \n+     uint32_t codepoint;\n+     uint32_t state = UTF8_ACCEPT;\n+@@ -1155,7 +1278,9 @@ static int fntCalcDimensionsLocked(font_t *font, const char *str)\n      for (; *str; ++str) {\n          if (utf8Decode(&state, &codepoint, *str)) // accumulate the codepoint value\n              continue;\n@@ -4992,10 +5089,10 @@ index d1f66e5..34e4410 100644\n  \n diff --git a/src/ripps2tr.c b/src/ripps2tr.c\n new file mode 100644\n-index 0000000..180fddd\n+index 0000000..7007c12\n --- /dev/null\n +++ b/src/ripps2tr.c\n-@@ -0,0 +1,471 @@\n+@@ -0,0 +1,792 @@\n +/*\n + RIPPS2 build 104: RIPPS2's own words, and Open PS2 Loader's, in the language the u