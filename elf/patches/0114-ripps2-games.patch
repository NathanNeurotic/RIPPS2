+        "patch": "@@ -103,6 +103,10 @@ jobs:\n         run: python3 .github/scripts/test_ps1_save_icons.py\n       - name: Check packaged BDMA pairs against both production validators\n         run: python3 .github/scripts/test_bdma_shipped_pairs.py\n+      - name: Check a launch names an older release's device BDMA pair instead of copying it\n+        run: python3 .github/scripts/test_bdma_stale_pair.py\n+      - name: Check POPSTARTER's i.LINK driver logs back in after an IOP reset\n+        run: python3 .github/scripts/test_ilink_bd_assault_reset.py\n       - name: Check POPS UDPFS config validation and USB save rollback\n         run: python3 .github/scripts/test_pops_udpfs.py\n       - name: Check unsupported MMCE ioctls cannot report VMC fragmentation\n@@ -119,6 +123,10 @@ jobs:\n         run: |\n           python3 .github/scripts/test_vmc_pfs_reserve.py\n           python3 .github/scripts/test_pfs_vmc_inode.py\n+      - name: Check rebuilding a fragmented VMC keeps the card through every fault, and fixes a real image\n+        run: |\n+          python3 .github/scripts/test_vmc_rebuild.py\n+          python3 .github/scripts/test_vmc_rebuild_fatfs.py\n       - name: Check Back on a Settings page keeps its edits and only a real change reconnects SMB\n         run: python3 .github/scripts/test_settings_back_keeps_edits.py\n       - name: Check a memory-card settings path saves and POPSTARTER is made only when needed, with icons\n@@ -129,6 +137,10 @@ jobs:\n         run: python3 .github/scripts/test_confirm_button.py\n       - name: Check language changes refresh menus when returning to English\n         run: python3 .github/scripts/test_language_switch.py\n+      - name: Check CWD language precedence, file filtering and dynamic language count\n+        run: python3 .github/scripts/test_language_discovery.py\n+      - name: Check translations that would misread their printf arguments fall back to English\n+        run: python3 .github/scripts/test_lang_format_gu