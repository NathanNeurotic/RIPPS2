+        "patch": "@@ -0,0 +1,449 @@\n+diff --git a/ee_core/src/igrmenu.c b/ee_core/src/igrmenu.c\n+index 1018b9f..d319b56 100644\n+--- a/ee_core/src/igrmenu.c\n++++ b/ee_core/src/igrmenu.c\n+@@ -11,6 +11,10 @@\n+   loader or the browser, as before). No animation: the panel is drawn when it opens and when the\n+   choice moves, and nothing in between.\n+ \n++  Build 106: POWER OFF, the last choice, turns the console off from the game (the user's request), confirmed as\n++  EXIT GAME is, on a second press. A disc game keeps the ROM's power button instead (its CDVDMAN has no OPL\n++  shutdown call), and the item says so.\n++\n+   Build 94: when the launch brought a hunt list (RA/<serial>.ach, packed in module storage), the\n+   confirm button on ACHIEVEMENTS opens LEFT TO HUNT: one locked achievement at a time, its title, its\n+   points and how it is earned, Up / Down (or confirm) for the next, back to return.\n+@@ -37,17 +41,18 @@\n+ #endif\n+ #include \"igrmenu.h\"\n+ \n+-// ---- the panel, in its own units (one font pixel at scale 1): 160 x 106, or 320 x 212 at scale 2\n++// ---- the panel, in its own units (one font pixel at scale 1): 160 x 116, or 320 x 232 at scale 2\n+ #define PW         160\n+-#define PH         106\n++#define PH         116\n+ #define ROW_TITLE  4\n+ #define ROW_SEP1   14\n+ #define ROW_ITEM0  18\n+ #define ITEM_STEP  10\n+-#define ROW_SEP2   49\n+-#define ROW_INFO0  53\n++#define ROW_SEP2   59\n++#define ROW_INFO0  63\n+ #define INFO_STEP  10\n+-#define ROW_HINT   95\n++#define ROW_HINT   105\n++#define IGRM_ITEMS 4 // RESUME, ACHIEVEMENTS, EXIT GAME, POWER OFF (build 106)\n+ #define TEXT_X     8\n+ #define ITEM_X     20\n+ #define TEXT_CHARS 24 // (PW - 2 * TEXT_X) / 6\n+@@ -157,6 +162,7 @@ typedef struct\n+     int unlocks;  // unlocks the PC reported this session\n+     const u8 *hunt; // build 94: LEFT TO HUNT, raHuntBlob's entries (NULL: none)\n+     int huntCount;\n++    int canPowerOff; // build 106: not a disc game (the ROM's CDVDMA