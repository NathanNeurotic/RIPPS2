+    if (!sweepSolvedValid || memcmp(sw, &sweepSolved, sizeof(*sw)) != 0) {
+        sweepSolved = *sw;
+        sweepSolvedValid = 1;
+        for (k = 0; k < 5; k++)
+            tintSolve(sw->c[k], &sweepP[k][0], &sweepP[k][1], &sweepP[k][2]);
+    }
+    pos = fmod(ripps2Seconds() / sweepSecs[sp], 5.0);
+    i = (int)pos;
+    if (i < 0 || i > 4)
+        i = 0;
+    j = (i + 1) % 5;
+    f = sweepEase((float)(pos - i));
+    ha = sweepP[i][0];
+    hb = sweepP[j][0];
+    if (sweepP[i][1] < 0.08f) // a grey colour has no hue of its own: it takes its neighbour's
+        ha = hb;
+    if (sweepP[j][1] < 0.08f)
+        hb = ha;
+    dh = hb - ha;
+    while (dh > 180.0f)
+        dh -= 360.0f;
+    while (dh < -180.0f)
+        dh += 360.0f;
+    *hue = ha + dh * f;
+    *sat = sweepP[i][1] + (sweepP[j][1] - sweepP[i][1]) * f;
+    *lift = sweepP[i][2] + (sweepP[j][2] - sweepP[i][2]) * f;
+}
