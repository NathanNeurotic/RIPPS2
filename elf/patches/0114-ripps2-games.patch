+        "patch": "@@ -340,6 +340,22 @@\n .chip.sm { padding: 4px 9px; font-size: 10px; letter-spacing: 0.06em; }\n .eyebrow .chip { text-transform: none; }\n \n+/* ---- LIVE sub-navigation and the badge grid ---- */\n+.subnav { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 4px 0 12px; }\n+.subnav .sp { flex: 1; }\n+.tiles { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 16px; }\n+.tile { width: 52px; height: 52px; border-radius: 8px; background: var(--bg-sunken); object-fit: cover; }\n+.tile.done { box-shadow: 0 0 0 2px rgba(95, 211, 138, 0.6); }\n+.tile.near { box-shadow: 0 0 0 2px var(--accent); }\n+.tile.locked, .tile.na { filter: saturate(0.4) brightness(0.65); }\n+.tile.na { opacity: 0.6; }\n+/* The ring says where an unlock was earned: blue softcore, gold hardcore, half and half both. */\n+.tile.done.m1, .row.done.m1 .badge { box-shadow: 0 0 0 2px var(--blue); }\n+.tile.done.m2, .row.done.m2 .badge { box-shadow: 0 0 0 2px var(--gold); }\n+.tile.done.m3, .row.done.m3 .badge { box-shadow: -2px -2px 0 0 var(--gold), -2px 2px 0 0 var(--gold), 2px -2px 0 0 var(--blue), 2px 2px 0 0 var(--blue); }\n+.filters .sp { flex: 1; }\n+\n+\n /* ---- Library cards ---- */\n .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }\n .card {\n@@ -634,6 +650,11 @@\n     \"UP NEXT &middot; BY MEDIAN UNLOCK TIME\": \"LO SIGUIENTE &middot; POR TIEMPO MEDIANO DE DESBLOQUEO\",\n     \"TRACKING NOW\": \"RASTREANDO AHORA\",\n     \"ALL ACHIEVEMENTS\": \"TODOS LOS LOGROS\",\n+    \"LEADERBOARDS\": \"TABLAS\",\n+    \"LIST\": \"LISTA\",\n+    \"GRID\": \"CUADRÍCULA\",\n+    \"softcore\": \"softcore\",\n+    \"hardcore and softcore\": \"hardcore y softcore\",\n     \"unlocked\": \"desbloqueado\",\n     \"not on hardware\": \"no disponible en hardware\",\n     \"locked\": \"bloqueado\",\n@@ -682,6 +703,12 @@\n     \"CLOSE TO THIS PC\": \"CERRAR A ESTE PC\",\n     \"the page is reachable from this PC only. Open it to