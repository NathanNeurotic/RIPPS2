+// RIPPS2 build 114: see ioman.h. The flag test and the count move together with interrupts off, so a write can never
+// start after the launch has looked at the count (one core: no thread switch without an interrupt).
+static volatile int gIoLaunching = 0, gIoWrites = 0;
+
+// build 114 (the lab, 10/23): ps2sdk's exFAT driver loses whole clusters of a file that grows beside another, so RIPPS2's
+// background writes (a list, the master list, art, a RIPSHOT developed, the hidden list) go one at a time: a write waits
+// up to about 3 s for the one before it, else it is skipped (each is kept again next time). A holder never waits on
+// another writer, so this cannot deadlock. (gIoWriteSema is made in ioInit.)
+
+int ioWriteBegin(void)
+{
+    int ok, tries;
+    for (tries = 0; gIoWriteSema >= 0 && PollSema(gIoWriteSema) < 0; tries++) {
+        if (tries >= 150 || gIoLaunching)
+            return 0;
+        DelayThread(20 * 1000);
+    }
+    DIntr();
+    ok = !gIoLaunching;
+    if (ok)
+        gIoWrites++;
+    EIntr();
+    if (!ok && gIoWriteSema >= 0)
+        SignalSema(gIoWriteSema);
+    return ok;
+}
+
+void ioWriteEnd(void)
+{
+    DIntr();
+    if (gIoWrites > 0)
+        gIoWrites--;
+    EIntr();
+    if (gIoWriteSema >= 0)
+        SignalSema(gIoWriteSema);
+}
+
+void ioLaunchBegin(void)
+{
+    DIntr();
+    gIoLaunching = 1;
+    EIntr();
+}
+
+// RIPPS2 build 114: a launch that came back (it failed, or the menu was started again): RIPPS2 writes and reads its
+// lists again (the launch guard's START NOW stops both before the launch)
+void ioLaunchCancel(void)
+{
+    DIntr();
+    gIoLaunching = 0;
+    EIntr();
+    gIoCancelScans = 0;
+}
+
+int ioWritesOpen(void)
+{
+    return gIoWrites;
+}
+
+int ioWaitWrites(int timeoutTicks)
+{
+    clock_t from = clock(), budget = (clock_t)timeoutTicks * (CLOCKS_PER_SEC / 4);
+    while (gIoWrites > 0 && clock() - from < budget) {
+        if (ioWaitPump != NULL)
+            ioWaitPump();
+        else
+            delay(1);
+    }
+    if (gIoWrites > 0)
+        LOG("ioWaitWrites: %d write(s) still open after the wait\n", gIoWrites);
+    return gIoWrites == 0;
+}
