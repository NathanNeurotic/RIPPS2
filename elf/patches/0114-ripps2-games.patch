+
+int ioQueueEstimateMs(void)
+{
+    int type = gRunType, total = 0, known;
+    void *data = gRunData;
+    clock_t since = gRunSince;
+    struct io_request_t *r;
+
+    if (type != 0) {
+        int ran = (int)(((u64)(clock() - since)) * 1000 / CLOCKS_PER_SEC);
+        if (type == IO_MENU_UPDATE_DEFFERED) {
+            if ((known = ioListMs(data)) <= 0)
+                return -1;
+            total += known > ran ? known - ran : 1000;
+        } else
+            total += 1000;
+    }
+    WaitSema(gEndSemaId);
+    for (r = gReqList; r != NULL; r = r->next) {
+        if (r == gReqRunning)
+            continue;
+        if (r->type == IO_MENU_UPDATE_DEFFERED) {
+            // one waiting behind that was never timed (a page rebuilt after a source, mostly quick) is a guess, not a
+            // reason to give up the estimate; only the running job's unknown time does that
+            known = ioListMs(r->data);
+            total += known > 0 ? known : 500;
+        } else
+            total += r->type == IO_CACHE_LOAD_ART ? 50 : 500;
+    }
+    SignalSema(gEndSemaId);
+    if (total >= 0 && ioWritesOpen() > 0)
+        total += 500;
+    return total;
+}
