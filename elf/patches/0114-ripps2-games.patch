+void ripps2ColorsLoadConfig(config_set_t *config)
+{
+    char key[24];
+    const char *v;
+    int i, value;
+    configGetColor(config, "ripps2_palette_custom", gRipps2CustomColor);
+    sweepUserCount = 0;
+    for (i = 0; i < RIPPS2_SWEEP_USER; i++) {
+        snprintf(key, sizeof(key), "ripps2_sweep%d", i + 1);
+        if (configGetStr(config, key, &v) && v != NULL && sweepParse(v, &sweepUser[sweepUserCount]))
+            sweepUserCount++;
+    }
+    if (configGetInt(config, "ripps2_sweep", &value) && value >= 0 && value <= ripps2SweepCount())
+        gRipps2Sweep = value;
+    // build 114: the speeds picked for RIPPS2's own sweeps ("1,-1,2,..." in their order)
+    for (i = 0; i < RIPPS2_SWEEP_BUILTIN; i++)
+        sweepBuiltinSpeed[i] = -1;
+    if (configGetStr(config, "ripps2_sweep_speeds", &v) && v != NULL)
+        for (i = 0; i < RIPPS2_SWEEP_BUILTIN && *v; i++) {
+            int s = atoi(v);
+            sweepBuiltinSpeed[i] = (signed char)(s >= 0 && s <= 2 ? s : -1);
+            while (*v && *v != ',')
+                v++;
+            if (*v == ',')
+                v++;
+        }
+}
+
+void ripps2ColorsSaveConfig(config_set_t *config)
+{
+    char key[24], line[96];
+    int i, k;
+    configSetColor(config, "ripps2_palette_custom", gRipps2CustomColor);
+    configSetInt(config, "ripps2_sweep", gRipps2Sweep);
+    {
+        int n = 0, any = 0;
+        for (i = 0; i < RIPPS2_SWEEP_BUILTIN && n < (int)sizeof(line); i++) {
+            n += snprintf(line + n, sizeof(line) - n, "%s%d", i ? "," : "", sweepBuiltinSpeed[i]);
+            any |= sweepBuiltinSpeed[i] >= 0;
+        }
+        if (any)
+            configSetStr(config, "ripps2_sweep_speeds", line);
+        else
+            configRemoveKey(config, "ripps2_sweep_speeds");
+    }
+    for (i = 0; i < RIPPS2_SWEEP_USER; i++) {
+        snprintf(key, sizeof(key), "ripps2_sweep%d", i + 1);
+        if (i >= sweepUserCount) {
+            configRemoveKey(config, key);
+            continue;
+        }
+        int n = snprintf(line, sizeof(line), "%s;", sweepUser[i].name);
+        for (k = 0; k < 5 && n < (int)sizeof(line); k++)
+            n += snprintf(line + n, sizeof(line) - n, "%02X%02X%02X%s", sweepUser[i].c[k][0], sweepUser[i].c[k][1],
+                          sweepUser[i].c[k][2], k < 4 ? "," : "");
+        if (n < (int)sizeof(line))
+            snprintf(line + n, sizeof(line) - n, ";%d", sweepUser[i].speed);
+        configSetStr(config, key, line);
+    }
+}
