+// The tint that turns RIPPS2's blue into colour t (Custom, a sweep's colours): its hue and saturation found by a few
+// corrections from a first guess, then the white a pale colour needs as lift. A colour darker than the blue keeps the
+// blue's brightness (the tint never darkens a grey).
+static void tintSolve(const unsigned char t[3], float *hue, float *sat, float *lift)
+{
+    float tc[3] = {t[0], t[1], t[2]}, o[3], th, ts, tv, oh, os, ov, h, s;
+    int k;
+    tintHsv(tc, &th, &ts, &tv);
+    h = th - 216.0f;
+    s = ts / 0.69f;
+    for (k = 0; k < 4; k++) {
+        float dh;
+        tintApplyF(h, s, 0.0f, tintBase, o);
+        tintHsv(o, &oh, &os, &ov);
+        dh = th - oh;
+        while (dh > 180.0f)
+            dh -= 360.0f;
+        while (dh < -180.0f)
+            dh += 360.0f;
+        if (ts > 0.08f && os > 0.02f)
+            h += dh;
+        if (os > 0.01f)
+            s *= ts / os;
+        s = s < 0.0f ? 0.0f : s > 2.5f ? 2.5f : s;
+    }
+    tintApplyF(h, s, 0.0f, tintBase, o);
+    ov = fmaxf(o[0], fmaxf(o[1], o[2]));
+    *lift = tv * 255.0f > ov ? (tv * 255.0f - ov) / 166.0f : 0.0f; // 166: the blue's own strength (max - min)
+    if (*lift > 1.0f)
+        *lift = 1.0f;
+    *hue = fmodf(h + 720.0f, 360.0f);
+    *sat = s;
+}
