 program = r'''
 #include <assert.h>
 #include <stddef.h>
@@ -17,7 +19,10 @@ typedef unsigned long long u64;
 #define USBMASS_IOCTL_GET_LBA 1
 #define USBMASS_IOCTL_GET_FRAGLIST 2
 #define LOG(...) ((void)0)
