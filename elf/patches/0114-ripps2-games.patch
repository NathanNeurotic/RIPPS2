@@ -0,0 +1,37 @@
+#ifndef __RIPPS2_SEANCE_H
+#define __RIPPS2_SEANCE_H
+
+// RIPPS2 build 114: SEANCE (ripps2seance.c). The launchers RIPPS2 does not carry, found where they are kept and
+// remembered by the drive's kind, so every launch after reads them from there.
+enum {
+    SEANCE_POPSTARTER = 0, // POPSTARTER.ELF
+    SEANCE_POPS,           // the folder holding POPS.ELF and POPS_IOX.PAK (Sony's PS1 emulator, from the user's console)
+    SEANCE_EMBER,          // ember.elf
+    SEANCE_EMBER_BIOS,     // the bios.bin Ember reads beside it
+    SEANCE_NEUTRINO,       // neutrino.elf of a whole install (config/system.toml beside it)
+    SEANCE_COUNT
+};
+
+enum {
+    SEANCE_MODE_LOOKUP = 0, // where it was found, read back now (path out)
+    SEANCE_MODE_LAST,       // nothing anywhere: offer the search, then read it back (path out)
+    SEANCE_MODE_NOTE,       // a launch found it the usual way: remember where (path in)
+    SEANCE_MODE_BRING,      // it has to be on the game's drive (Ember): copy it there from where it was found (path in and out)
+};
+
+// The launch code's one way in. Weak: RiptOPL's host harnesses build vcdsupport.c, cuesupport.c and supportbase.c
+// without RIPPS2's pages, and there it is NULL, so every call site checks it first. It does nothing unless a launch
+// is under way (gSeanceLaunching): list scans and Settings' own lookups never search or ask.
+int seanceHook(int what, int mode, const char *devPrefix, char *path, int pathSize) __attribute__((weak));
+
+extern int gSeanceLaunching;                           // opl.c and Memory Files, around the launch call
+int seanceGet(int what, char *out, int outSize);       // 1: where it was found, there now (out: a path to open; POPS: the folder)
+int seanceState(int what, char *where, int whereSize); // 1 found (where: as remembered), 0 looked and not found, -1 never looked for
+void seanceNote(int what, const char *path);           // remember where it is (massN:/... is kept as usb:/... and so on)
+int seanceSearch(void);                                // walk the started drives for all of them, with its screen; how many are known after
+int seanceOffer(int what);                             // a launch found none: ask, then search; 1 when it is known now
+const char *seanceName(int what);
+struct _item_list_t;
+void seancePreLaunch(struct _item_list_t *support, int id); // opl.c, just before itemLaunch: Ember's files beside an Ember game
+
+#endif
