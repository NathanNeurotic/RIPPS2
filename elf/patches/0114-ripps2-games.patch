diff --git a/modules/ilink/IEEE1394_bd/src/main.c b/modules/ilink/IEEE1394_bd/src/main.c
new file mode 100644
index 0000000..4090616
--- /dev/null
+++ b/modules/ilink/IEEE1394_bd/src/main.c
@@ -0,0 +1,32 @@
+#define MAJOR_VER 1
+#define MINOR_VER 1
+#define MODNAME   "IEEE1394_bd"
+
+#include "sbp2_disk.h"
+#include "scsi.h"
+#include <irx.h>
+#include <loadcore.h>
+#include <stdio.h>
+
+#include "module_debug.h"
+
+IRX_ID(MODNAME, MAJOR_VER, MINOR_VER);
+
+int _start(int argc, char *argv[])
+{
+    (void)argc;
+    (void)argv;
+
+    M_PRINTF("IEEE1394 Driver v%d.%d\n", MAJOR_VER, MINOR_VER);
+
+    // initialize the SCSI driver
+    if (scsi_init() != 0) {
+        M_PRINTF("ERROR: initializing SCSI driver!\n");
+        return MODULE_NO_RESIDENT_END;
+    }
+
+    // initialize the IEEE1394 driver
+    init_ieee1394DiskDriver();
+
+    return MODULE_RESIDENT_END;
+}
