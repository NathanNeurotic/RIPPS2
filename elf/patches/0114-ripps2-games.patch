+// ---- the receipt ----
+
+static void lrReceipt(const char *name, const char *where, long long freed, const char *apa)
+{
+    char line[400], size[24];
+    FILE *f;
+    int i;
+    DIR *d = opendir("mc0:/RIPPS2");
+
+    if (d == NULL)
+        return; // no RIPPS2 save on the first card: nothing is made for this
+    closedir(d);
+    if ((f = fopen("mc0:/RIPPS2/REMOVED.TXT", "a")) == NULL)
+        return;
+    lrSize(freed, size, sizeof(size));
+    snprintf(line, sizeof(line), "RIPPS2 deleted %s from %s (%s freed)%s%s\r\n", name, where, size, apa[0] ? ". APA: " : "", apa);
+    fputs(line, f);
+    for (i = 0; i < lrCount; i++)
+        if (!lrItems[i].keep)
+            fprintf(f, "  %s\r\n", lrItems[i].path);
+    fputs("\r\n", f);
+    fclose(f);
+}
