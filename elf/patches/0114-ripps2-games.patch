+// the panel: what it will do, SELECT held to go on (1), Circle to back out (0)
+static int zpAsk(const char *head, const char *name, const char *info, const char *when)
+{
+    double t0 = ripps2Seconds(), heldSince = 0.0, now;
+    int backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    int backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+    const char *hold = _t("HOLD");
+    for (;;) {
+        int w = 580, h = 204, x = (640 - w) / 2, y = 134, ia, hx;
+        float a, p = 0.0f;
+        GSTEXTURE *sel = thmGetTexture(SELECT_ICON);
+        now = ripps2Seconds();
+        readPads();
+        if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            return 0;
+        }
+        if (getKeyPressed(KEY_SELECT)) {
+            if (heldSince == 0.0)
+                heldSince = now;
+            p = (float)((now - heldSince) / ZP_HOLD);
+            if (p >= 1.0f) {
+                sfxPlay(SFX_CONFIRM);
+                return 1;
+            }
+        } else
+            heldSince = 0.0;
+        a = (float)((now - t0) / 0.6);
+        a = a >= 1.0f ? 1.0f : a * a * (3.0f - 2.0f * a);
+        ia = (int)(0x80 * a);
+        rmStartFrame();
+        zpPage();
+        ripps2DrawHintBoxA(x, y, w, h, a);
+        fntRenderString(gTheme->fonts[4], 320, y + 26, ALIGN_CENTER, 0, 0, head, lgAlpha(LG_LIT, ia));
+        fntRenderStringFit(gTheme->fonts[5], 320, y + 54, ALIGN_CENTER, w - 40, name, lgAlpha(LG_SOFT, ia), 1);
+        // the wheel where RIPDISC's and the guard's are: SELECT at its centre, HOLD after it
+        hx = 320 - (38 + 6 + ripps2HintWidth(hold)) / 2;
+        ripps2NotchRing(hx + 19, y + 90, p, ia);
+        if (sel != NULL)
+            rmDrawPixmap(sel, hx + 9, y + 80, ALIGN_NONE, 20, 20, SCALING_RATIO, lgAlpha(LG_LIT, ia), 0);
+        ripps2HintText(hx + 44, y + 90, hold, lgAlpha(LG_SOFT, ia));
+        fntRenderStringFit(gTheme->fonts[5], 320, y + 120, ALIGN_CENTER, w - 40, info, lgAlpha(LG_SOFT, ia), 1);
+        fntRenderStringFit(gTheme->fonts[5], 320, y + 140, ALIGN_CENTER, w - 40, when, lgAlpha(LG_SOFT, ia), 1);
+        fntRenderStringFit(gTheme->fonts[5], 320, y + 160, ALIGN_CENTER, w - 40, _t("Experimental: OPL core only (not Neutrino)"), lgAlpha(LG_SOFT, ia / 2), 1);
+        ripps2HintOneA(backIcon, _t("BACK"), y + 184, ia);
+        rmEndFrame();
+    }
+}
