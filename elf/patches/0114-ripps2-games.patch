+            return ETH_MODE;
+        case MIX_FAM_UDPFS:
+            return UDPFS_MODE;
+        case MIX_FAM_HTTP:
+            return HTTP_MODE;
+        case MIX_FAM_COUNT:
+            return -1;
+        default:
+            return BDM_MODE;
+    }
+}
+
+// 1 when a family's saved games go: its source is off, or started and silent past MIX_WAIT_S. A source left on Manual
+// keeps them (they are what it holds; Cross on one starts it). *settling: a started source still has time to answer
+static int mixFamilyGone(int fam, int *settling)
+{
+    int mode = mixFamilyMode(fam);
+    opl_io_module_t *mod;
+
+    if (mode < 0 || ripps2ModeStartMode(mode) == START_MODE_DISABLED)
+        return 1;
+    if ((fam == MIX_FAM_USB && !gEnableUSB) || (fam == MIX_FAM_ATA && !gEnableBdmHDD) || (fam == MIX_FAM_MX4SIO && !gEnableMX4SIO) ||
+        (fam == MIX_FAM_ILINK && !gEnableILK))
+        return 1;
+    mod = oplGetModule(mode);
+    if (mod == NULL || mod->support == NULL || !mod->support->enabled)
+        return 0;
+    if (mixWaitSince[fam] <= 0.0)
+        mixWaitSince[fam] = ripps2Seconds();
+    if (ripps2Seconds() - mixWaitSince[fam] > MIX_WAIT_S)
+        return 1;
+    *settling = 1;
+    return 0;
+}
