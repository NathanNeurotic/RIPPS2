+typedef struct {int fd; struct sdk_dirent entry;} host_DIR;
+static int openDirs;
+static const char *local(const char *path) {const char *c = strchr(path, ':'); assert(c); return c + 1;}
+static host_DIR *host_opendir(const char *path) {
