+// allgames.bin in the folder the settings are kept in
+static void mixMasterPath(char *out, int size)
+{
+    config_set_t *cfg = configGetByType(CONFIG_OPL);
+    const char *fn = (cfg != NULL && cfg->filename != NULL) ? cfg->filename : NULL;
+    const char *cut = fn != NULL ? strrchr(fn, '/') : NULL;
+
+    if (fn != NULL && cut == NULL)
+        cut = strrchr(fn, ':');
+    if (cut == NULL)
+        snprintf(out, size, "mc0:/RIPPS2/" MIX_MASTER_FILE);
+    else
+        snprintf(out, size, "%.*s" MIX_MASTER_FILE, (int)(cut - fn + 1), fn);
+}
+
+static unsigned int mixLe32(const unsigned char *p)
+{
+    return p[0] | p[1] << 8 | p[2] << 16 | (unsigned int)p[3] << 24;
+}
+
+static void mixPutLe32(unsigned char *p, unsigned int v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+static unsigned int mixFnv(const unsigned char *p, int n)
+{
+    unsigned int h = 2166136261u;
+    int i;
+    for (i = 0; i < n; i++)
+        h = (h ^ p[i]) * 16777619u;
+    return h;
+}
+
+// Header: magic, count, FNV-1a of the records, a spare word. A record: kind, family, the startup's and the name's
+// lengths, then the startup and the name. A file that does not add up is not read at all.
+static void mixMasterLoad(void)
+{
+    char path[256];
+    unsigned char *buf = NULL;
+    int fd, size, pos, i, count;
+
+    mixMasterLoaded = 1;
+    if (!gRipps2FastCache)
+        return;
+    mixMasterPath(path, sizeof(path));
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return;
+    size = lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (size >= 16 && size <= 2 * 1024 * 1024 && (buf = malloc(size)) != NULL && read(fd, buf, size) != size) {
+        free(buf);
+        buf = NULL;
+    }
+    close(fd);
+    if (buf == NULL)
+        return;
+    count = (int)mixLe32(buf + 8);
+    if (memcmp(buf, MIX_MASTER_MAGIC, 8) != 0 || count <= 0 || count > MIX_MASTER_MAX || mixLe32(buf + 12) != mixFnv(buf + 16, size - 16) ||
+        (mixMaster = calloc(count, sizeof(mix_master_t))) == NULL) {
+        free(buf);
+        return;
+    }
+    for (i = 0, pos = 16; i < count; i++) {
+        int sl, nl;
+        if (pos + 4 > size)
+            break;
+        sl = buf[pos + 2];
+        nl = buf[pos + 3];
+        if (pos + 4 + sl + nl > size || nl == 0 || buf[pos + 1] >= MIX_FAM_COUNT)
+            break;
+        mixMaster[i].kind = buf[pos];
+        mixMaster[i].family = buf[pos + 1];
+        mixMaster[i].startup = malloc(sl + 1);
+        mixMaster[i].text = malloc(nl + 1);
+        if (mixMaster[i].startup == NULL || mixMaster[i].text == NULL)
+            break;
+        memcpy(mixMaster[i].startup, buf + pos + 4, sl);
+        mixMaster[i].startup[sl] = '\0';
+        memcpy(mixMaster[i].text, buf + pos + 4 + sl, nl);
+        mixMaster[i].text[nl] = '\0';
+        pos += 4 + sl + nl;
+    }
+    if (i < count) { // short or damaged: none of it
+        for (count = i, i = 0; i <= count && i < (int)mixLe32(buf + 8); i++) {
+            free(mixMaster[i].startup);
+            free(mixMaster[i].text);
+        }
+        free(mixMaster);
+        mixMaster = NULL;
+        free(buf);
+        return;
+    }
+    mixMasterCount = count;
+    mixMasterSum = mixLe32(buf + 12);
+    mixMasterSaved = count;
+    free(buf);
+    LOG("mixMasterLoad: %d games from %s" "\n", count, path);
+}
+
+// The list as it stands, when it differs from the one kept
+static void mixMasterSave(const mix_rec_t *arr, int count)
+{
+    char path[256];
+    unsigned char *buf, *p;
+    unsigned int sum;
+    int i, len = 16, fd, ok;
+
+    if (!gRipps2FastCache || !gEnableWrite || count <= 0 || count > MIX_MASTER_MAX)
+        return;
+    for (i = 0; i < count; i++)
+        len += 4 + (strlen(arr[i].startup) < 255 ? strlen(arr[i].startup) : 255) + (strlen(arr[i].text) < 255 ? strlen(arr[i].text) : 255);
+    if ((buf = malloc(len)) == NULL)
+        return;
+    for (i = 0, p = buf + 16; i < count; i++) {
+        int sl = strlen(arr[i].startup) < 255 ? strlen(arr[i].startup) : 255, nl = strlen(arr[i].text) < 255 ? strlen(arr[i].text) : 255;
+        p[0] = arr[i].kind;
+        p[1] = arr[i].family >= 0 ? arr[i].family : MIX_FAM_BDM;
+        p[2] = sl;
+        p[3] = nl;
+        memcpy(p + 4, arr[i].startup, sl);
+        memcpy(p + 4 + sl, arr[i].text, nl);
+        p += 4 + sl + nl;
+    }
+    sum = mixFnv(buf + 16, len - 16);
+    if (mixMasterSaved == count && sum == mixMasterSum) {
+        free(buf);
+        return;
+    }
+    memcpy(buf, MIX_MASTER_MAGIC, 8);
+    mixPutLe32(buf + 8, count);
+    mixPutLe32(buf + 12, sum);
+    // written in place, as favourites.bin is: a memory card has no rename to put a staged copy in place (the lab found
+    // allgames.bin.new left behind), and a file cut short fails its sum and is not read
+    mixMasterPath(path, sizeof(path));
+    if (!ioWriteBegin()) { // build 114: the IO worker writes this; never once a launch has begun
+        free(buf);
+        return;
+    }
+    ok = (fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0;
+    if (ok) {
+        ok = write(fd, buf, len) == len;
+        close(fd);
+    }
+    ioWriteEnd();
+    free(buf);
+    if (ok) {
+        mixMasterSum = sum;
+        mixMasterSaved = count;
+        LOG("mixMasterSave: %d games to %s" "\n", count, path);
+    }
+}
