diff --git a/.github/scripts/test_lang_format_guard.py b/.github/scripts/test_lang_format_guard.py
new file mode 100644
index 0000000..b91bc11
--- /dev/null
+++ b/.github/scripts/test_lang_format_guard.py
@@ -0,0 +1,104 @@
+"""A translated string must not read arguments its English string is not given.
+
+RiptOPL hands each translation to printf with the English string's arguments. Several upstream
+translations do not match them: French AUTO_START_IN_N_SECS has %s where English has %i (the
+Auto Start countdown then reads its int as a string pointer and crashes), Persian strings swap or
+add conversions. lngLoadFromFile now checks every loaded string with lngFormatFits and shows the
+English string instead of one that would misread its arguments.
+
+This compiles the real lngFormatArgs/lngFormatFits from src/lang.c and checks them against the
+upstream cases and the printf forms RiptOPL's strings use, and that lngLoadFromFile applies them.
+"""
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/lang.c").read_text(encoding="utf-8").replace("\r\n", "\n")
+failures = []
+
+start = source.find("static int lngFormatArgs(")
+end = source.find("static int lngLoadFromFile(", start)
+if start < 0 or end < 0:
+    print("src/lang.c: lngFormatArgs/lngFormatFits not found before lngLoadFromFile")
+    sys.exit(1)
+guard = source[start:end]
+
+load = source[end:source.find("\n}\n", end) + 3]
+if not re.search(r"lngFormatFits\(newL\[i\], internalEnglish\[i\]\)", load):
+    failures.append("lngLoadFromFile does not check each loaded string with lngFormatFits")
+
+# (translation, English, fits)
+CASES = [
+    ("Lancement automatique dans %s...", "Auto start in %i s...", 0),  # upstream French: crash
+    ("Auto %i s", "Auto start in %i s...", 1),
+    ("% s ... % d", "%s ... %d", 1),  # upstream Cebuano: a space flag reads the same argument
+    ("no conversions", "%s %d", 1),  # upstream Japanese: fewer arguments are never misread
+    ("%s %d %d", "%s %d", 0),  # upstream TChinese: an argument that is not passed
+    ("%d %s", "%s %d", 0),  # upstream Persian: swapped
+    ("%s %s", "%s", 0),  # upstream Persian GAME_SETTINGS_REMOVED
+    ("100%% done %s", "%s", 1),
+    ("%1$s", "%s", 0),  # positional arguments are not understood: English is safer
+    ("%-10s|%5.2f", "%s|%f", 1),
+    ("%lu", "%u", 0),
+    ("%lu", "%lu", 1),
+    ("%lld", "%d", 0),
+    ("%hhd %hu %c %x", "%d %d %d %d", 1),
+    ("%d", "%*d", 1),
+    ("%*d", "%d", 0),
+    ("%p", "%s", 0),
+    ("%n", "%d", 0),
+    ("trailing %", "%d", 0),
+    ("%s", "not a format %", 1),  # English this check does not understand: left alone
+    ("", "", 1),
+]
+
+harness = r"""
+#include <stdio.h>
+#include <string.h>
+""" + guard + r"""
+struct test_case { const char *translated, *english; int fits; };
+static const struct test_case cases[] = {
+@CASES@
+};
+int main(void)
+{
+    int failures = 0;
+    for (unsigned int i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        int fits = lngFormatFits(cases[i].translated, cases[i].english);
+        if (fits != cases[i].fits) {
+            printf("\"%s\" for English \"%s\": %s, want %s\n", cases[i].translated, cases[i].english,
+                   fits ? "kept" : "replaced", cases[i].fits ? "kept" : "replaced");
+            failures++;
+        }
+    }
+    return failures != 0;
+}
+"""
+
+
+def c_string(text):
+    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+rows = ",\n".join("    {%s, %s, %d}" % (c_string(t), c_string(e), f) for t, e, f in CASES)
+with tempfile.TemporaryDirectory() as tmp:
+    tmp = Path(tmp)
+    program = tmp / "guard.c"
+    exe = tmp / ("guard.exe" if sys.platform == "win32" else "guard")
+    program.write_text(harness.replace("@CASES@", rows), encoding="utf-8")
+    build = subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-format-security",
+                            str(program), "-o", str(exe)], capture_output=True, text=True, check=False)
+    if build.returncode != 0:
+        failures.append("did not compile:\n" + build.stderr)
+    else:
+        run = subprocess.run([str(exe)], capture_output=True, text=True, check=False, timeout=20)
+        if run.returncode != 0:
+            failures += run.stdout.strip().splitlines() or ["exited %d" % run.returncode]
+
+if failures:
+    print("\n".join(failures))
+    sys.exit(1)
+print("Language format guard: translations that misread their arguments fall back to English")
diff --git a/.github/scripts/test_language_discovery.py b/.github/scripts/test_language_discovery.py
new file mode 100644
index 0000000..cba8ab8
--- /dev/null
+++ b/.github/scripts/test_language_discovery.py
@@ -0,0 +1,124 @@
+"""Run the actual language registration code on the host.
+
+Covers dynamic growth, strict file names, case-insensitive deduplication,
+CWD precedence, and slash/colon handling without requiring a PS2 SDK.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/lang.c").read_text(encoding="utf-8")
+start = source.index("static int lngEnsureCapacity(int count)\n{")
+end = source.index("static void lngRebuildLangNames(void)", start)
+registration = source[start:end]
+
+harness = r"""
+#include <assert.h>
+#include <limits.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#define DT_DIR 4
+#define DT_REG 8
+typedef struct {
+    char *filePath;
+    char *name;
+    unsigned char sourcePriority;
+} language_t;
+static int nLanguages, languageCapacity, scanFoundFiles;
+static unsigned char scanPriority;
+static language_t *languages;
+/* The GUI lock: the GUI thread reads the registry while the IO worker adds to it, so the array may
+   only move while the lock is held, and taking it twice would deadlock the PS2. */
+static int guiLockDepth, guiLockTaken;
+static void guiLock(void)
+{
+    assert(guiLockDepth == 0);
+    guiLockDepth++;
+    guiLockTaken++;
+}
+static void guiUnlock(void)
+{
+    assert(guiLockDepth == 1);
+    guiLockDepth--;
+}
+static void *lockedRealloc(void *block, size_t size)
+{
+    assert(guiLockDepth == 1);
+    return realloc(block, size);
+}
+#define realloc(block, size) lockedRealloc(block, size)
+""" + registration + r"""
+static int scan(int priority, const char *path, const char *separator,
+                const char *const *names, int count)
+{
+    int added = 0;
+    scanFoundFiles = 0;
+    scanPriority = priority;
+    for (int i = 0; i < count; i++)
+        added = lngReadEntry(added, path, separator, names[i], DT_REG);
+    nLanguages += added;
+    return scanFoundFiles;
+}
+int main(void)
+{
+    const char *legacy[] = {"lang_French.lng", "lang_German.lng",
+                            "bad_French.lng", "lang_.lng", "lang_French.lng.bak"};
+    assert(scan(0, "mass0:/LNG", "/", legacy, 5) == 2);
+    assert(nLanguages == 2);
+    assert(strcmp(languages[0].filePath, "mass0:/LNG/lang_French.lng") == 0);
+
+    const char *cwd[] = {"lang_French.lng", "LANG_SPANISH.LNG"};
+    assert(scan(2, "mass1:/APPS/RIPTOPL/", "/", cwd, 2) == 2);
+    assert(nLanguages == 3);
+    assert(strcmp(languages[0].filePath, "mass1:/APPS/RIPTOPL/lang_French.lng") == 0);
+    assert(languages[0].sourcePriority == 2);
+
+    const char *cwdLangs[] = {"lang_French.lng", "lang_German.lng"};
+    assert(scan(1, "mass1:/APPS/RIPTOPL/LNG", "/", cwdLangs, 2) == 2);
+    assert(nLanguages == 3);
+    assert(strcmp(languages[0].filePath, "mass1:/APPS/RIPTOPL/lang_French.lng") == 0);
+    assert(strcmp(languages[1].filePath, "mass1:/APPS/RIPTOPL/LNG/lang_German.lng") == 0);
+
+    // Colon-relative legacy MC paths and case-insensitive duplicate names.
+    const char *card[] = {"lang_german.lng", "lang_Italian.lng"};
+    assert(scan(0, "mc0:OPL", "/", card, 2) == 2);
+    assert(nLanguages == 4);
+    assert(strcmp(languages[1].filePath, "mass1:/APPS/RIPTOPL/LNG/lang_German.lng") == 0);
+    assert(strcmp(languages[3].filePath, "mc0:OPL/lang_Italian.lng") == 0);
+
+    // More than 15, including more than 32, without displacing existing names.
+    for (int i = 0; i < 64; i++) {
+        char file[40];
+        snprintf(file, sizeof(file), "lang_Extra%02d.lng", i);
+        const char *files[] = {file};
+        assert(scan(0, "mass2:/LNG", "/", files, 1) == 1);
+    }
+    assert(nLanguages == 68);
+    assert(languageCapacity >= nLanguages);
+    assert(strcmp(languages[0].filePath, "mass1:/APPS/RIPTOPL/lang_French.lng") == 0);
+    assert(guiLockDepth == 0 && guiLockTaken > 0);
+
+    for (int i = 0; i < nLanguages; i++) {
+        free(languages[i].name);
+        free(languages[i].filePath);
+    }
+    free(languages);
+    return 0;
+}
+"""
+
+with tempfile.TemporaryDirectory() as directory:
+    path = Path(directory)
+    program = path / "test.c"
+    exe = path / "test"
+    program.write_text(harness, encoding="utf-8")
+    subprocess.run(
+        ["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", str(program), "-o", str(exe)],
+        check=True,
+    )
+    subprocess.run([str(exe)], check=True)
+print("Language discovery tests passed")
