+        "patch": "@@ -68,14 +68,17 @@ jobs:\n           if-no-files-found: error\n           retention-days: 30\n \n-      # the link map and the unstripped ELF of exactly this build: a lab save state's PC and stack read against them\n+      # the link map and the unstripped ELF of exactly this build: a lab save state's PC and stack read against them.\n+      # Build 108: ee_core's map too, and even when the link fails (ee_core's room is checked at link time)\n       - name: Upload symbols\n+        if: ${{ !cancelled() }}\n         uses: actions/upload-artifact@v6\n         with:\n           name: RIPPS2-symbols${{ inputs.debug && '-debug' || '' }}${{ inputs.flags && '-test' || '' }}\n           path: |\n             riptopl/opl.map\n             riptopl/opl.elf\n+            riptopl/ee_core/ee_core.map\n           if-no-files-found: warn\n           retention-days: 30\n "
