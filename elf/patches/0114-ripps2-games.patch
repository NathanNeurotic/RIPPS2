\"<base>AUDIO\" -> \"<base>\", for AUDIO's README.txt\n++    ripps2WriteReadme(path, 0);\n+     snprintf(path, sizeof(path), \"%s%s\", dirs[pick - 1], RBS_MUSIC_FILE);\n+     wasPlaying = isBgmPlaying();\n+     if (wasPlaying)\n+diff --git a/src/ripps2cd.c b/src/ripps2cd.c\n+index 79b05c2..5a2f8e2 100644\n+--- a/src/ripps2cd.c\n++++ b/src/ripps2cd.c\n+@@ -222,6 +222,19 @@ int ripps2CdAudioTracks(void)\n+     return n;\n+ }\n+ \n++// RIPPS2 build 105: the tracks for RIPDISC, read from the TOC as the player reads them\n++int ripps2CdTracks(unsigned int *start, unsigned char *audio, int max)\n++{\n++    int t;\n++    if (cdOpen || !cdReadToc() || cdCount + 2 > max)\n++        return 0;\n++    for (t = 1; t <= cdCount + 1; t++) {\n++        start[t] = cdStart[t];\n++        audio[t] = t <= cdCount ? cdAudio[t] : 0;\n++    }\n++    return cdCount;\n++}\n++\n+ static int cdTrackAt(u32 lsn)\n+ {\n+     int t;\n+@@ -270,6 +283,16 @@ static int cdReadSectors(u32 lsn, u32 n, u8 *buf, sceCdRMode *m)\n+ #endif\n+ }\n+ \n++int ripps2CdReadAudio(unsigned int lsn, unsigned int n, void *buf) // build 105: RIPDISC's sound\n++{\n++    sceCdRMode m;\n++    m.trycount = 5;\n++    m.spindlctrl = SCECdSpinNom;\n++    m.datapattern = SCECdSecS2352;\n++    m.pad = 0;\n++    return cdReadSectors(lsn, n, (u8 *)buf, &m);\n++}\n++\n+ static int cdSlow = 0; // this play reads at 2x: the drive refused its own speed\n+ \n+ static int cdStreamRead(char *buf, int size)\n+@@ -564,8 +587,10 @@ static void cdCopy(int track)\n+     if (cdState != CD_STOPPED)\n+         cdHalt(CD_STOPPED);\n+ \n++    snprintf(path, sizeof(path), \"%s\", dir);\n+     strcat(dir, \"AUDIO\");\n+     mkdir(dir, 0777);\n++    ripps2WriteReadme(path, 0); // build 105: what the folder is for, beside the track\n+     snprintf(path, sizeof(path), \"%s/bgm %s.wav\", dir, name); // music in AUDIO is bgm*: the picker lists it\n+     if ((f = fopen(path, \"wb\")) == NULL) {\n+         guiMsgBoxSound(SFX_ERROR);\n+diff --git a/src/ripps2disc.c b/src/ripps2disc.c\n+new file mode 100644\n+index 0000000..c32550b\n+--- /dev/null\n++++ b/src/ripps2disc.c\n+@@ -0,0 +1,1469 @@\n++/*\n++  Copyright 2026, RIPPS2 contributors\n++  Licenced under Academic Free License version 3.0\n++  Review OpenUsbLd README & LICENSE files for further details.\n++\n++  RIPDISC (RIPPS2 build 105): the disc in the drive, copied to storage or to files, from LAUNCH DISC.\n++\n++  After 4.2 s on the page, when the disc can be ripped, a glass panel fades in at the centre: RIPDISC, one line\n++  (add this game to your storage / add this media to your files) and SELECT, Hold. SELECT held 4.2 s (a ring fills\n++  round it) opens the confirm step: what the disc is, its size and where it goes. Confirm, then START rips.\n++\n++  - A PS2 game (CD, DVD, or an ESR disc): an ISO in a drive's CD or DVD folder, <ID>.<Title>.iso, where the games\n++    list finds it. Left / Right picks the drive (USB, the exFAT HDD, MX4SIO, iLink). A game over 4 GB on a drive\n++    that may be FAT32 (anything but the internal HDD: the PS2 cannot tell FAT32 from exFAT on a stick) goes in\n++    Open PS2 Loader's split format instead, which every drive takes: 1 GB parts (ul.<crc>.<ID>.00, .01 ...) and\n++    its entry in the drive's ul.cfg.\n++  - A PS1 game: a BIN and a CUE (every track, 2352 bytes a sector) in the drive's EMBER/games/<Title>/, as Ember\n++    plays them.\n++  - Media (an audio CD, a CD's sound tracks, a DVD video): confirm, then Memory Files opens on MEDIA (beside\n++    AUDIO) with the disc on its clipboard, RIPPED where it would say COPIED. PASTE in the folder chosen, confirm,\n++    START. An audio CD lands as a folder of WAVs (Track 01.wav ...), whose name the keyboard then asks for; a DVD\n++    video as its VIDEO_TS files (1 GB at most each, so FAT32 takes them). A bought DVD film is copy protected:\n++    the drive will not read its video, and the rip stops saying so.\n++\n++  The reads are libcdvd's, on the GUI thread as the CD player's copy is (the disc watcher waited out first):\n++  2048-byte sectors with retries, sound through the CD player's CDDA reads, and a PS1 data track in 2340-byte\n++  reads with each sector's 12 sync bytes put back. The screen is drawn a few times a second while it runs, with\n++  what is done and what is left. A cancel (asked first) or a failure removes everything the rip wrote.\n++\n++  How long: the confirm step says it before START, so a long rip is no surprise. A rip runs at the slower of the\n++  drive and the storage it goes to, which is mostly the storage: the PS2's USB (1.1) takes about 1 MB/s at best (a\n++  4.4 GB DVD to a stick is over an hour), while the internal exFAT HDD keeps up with the drive (a DVD at up to 4x,\n++  2 to 5 MB/s, faster at the disc's edge; a CD at up to 24x). Until a rip has measured this console, a careful\n++  guess for that kind of storage and disc; after one, what it really did, kept in the settings\n++  (ripdisc_kbs_<storage>_<cd|dvd>). While it runs, the time left comes from its own progress.\n++\n++  Both AUDIO and MEDIA get a README.txt (ripps2WriteReadme) saying what goes in them.\n++*/\n++\n++#include <stdio.h>\n++#include <stdlib.h>\n++#include <string.h>\n++#include <ctype.h>\n++#include <fcntl.h>\n++#include <unistd.h>\n++#include <sys/stat.h>\n++#include <time.h>\n++#include <math.h>\n++#include <malloc.h>\n++#include <kernel.h>\n++#include <delaythread.h>\n++#include <libcdvd.h>\n++\n++#include \"include/opl.h\"\n++#include \"include/gui.h\"\n++#include \"include/renderman.h\"\n++#include \"include/fntsys.h\"\n++#include \"include/themes.h\"\n++#include \"include/textures.h\"\n++#include \"include/pad.h\"\n++#include \"include/system.h\" // USBA_crc32: a split game's part names\n++#include \"include/ioman.h\"  // LOG\n++#include \"include/iosupport.h\"\n++#include \"include/sound.h\"\n++#include \"include/ripps2.h\"\n++#include \"include/bdmsupport.h\"  // the drives a game can go to\n++#include \"include/supportbase.h\" // USBExtreme_game_entry_t: ul.cfg's records\n++#include \"include/cuesupport.h\"  // Ember's folders\n++#include \"include/ripps2tint.h\"  // RIPPSettings Color Theme: last, so every colour below goes through it\n++#include \"include/ripps2tr.h\"    // _t, RIPPS2's words in the chosen language\n++\n++#define RD_HOLD_S    4.2f // on the page before the panel shows, and SELECT held to open it\n++#define RD_FADE_S    0.6f\n++#define RD_DATA      2048\n++#define RD_RAW       2352\n++#define RD_XA        2340 // a CD sector without its 12 sync bytes\n++#define RD_READ      32   // data sectors a read: 64 KB\n++#define RD_RAW_READ  16   // raw sectors a read, as the CD player's\n++#define RD_BUF_SECS  96   // sectors written at a time (the buffer holds 96 raw ones)\n++#define RD_UL_PART   0x40000000u // Open PS2 Loader's split games: 1 GB parts\n++#define RD_FAT32_MAX 0xFFFFFFFFull\n++#define RD_SLOTS     8\n++#define RD_TRACKS    99\n++#define RD_FILES     64\n++#define RD_MADE      110 // files and folders a rip makes (99 tracks, a DVD's VIDEO_TS)\n++\n++#define RD_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)\n++#define RD_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)\n++#define RD_DIM  GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)\n++#define RD_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)\n++\n++enum { RD_OK = 1, RD_READ_FAIL = 0, RD_WRITE_FAIL = -1, RD_CANCEL = -2 };\n++\n++// the disc being ripped\n++static int rdKind = RIPPS2_DISC_NONE;\n++static char rdId[16], rdTitle[48], rdLabel[33];\n++static u32 rdSectors;  // the data a game's ISO holds (2048-byte sectors)\n++static u64 rdBytes;    // what the rip writes\n++static int rdTracks;\n++static u32 rdStart[RD_TRACKS + 2]; // a CD's tracks: start[1..n], start[n + 1] the lead-out\n++static unsigned char rdAudio[RD_TRACKS + 2];\n++static u8 *rdBuf = NULL;\n++static u8 rdOne[RD_RAW + 64] __attribute__((aligned(64))); // one sector read again on its own\n++\n++// a DVD video's files\n++typedef struct\n++{\n++    char name[32];\n++    u32 lba, size;\n++    unsigned char isDir, inAudioTs;\n++} rd_file_t;\n++static rd_file_t rdFiles[RD_FILES];\n++static int rdFileCount = 0;\n++\n++// the drives a game can go to\n++static int rdSlot[RD_SLOTS], rdSlotType[RD_SLOTS], rdSlotCount = 0, rdSlotSel = 0;\n++\n++// what the rip made, removed again if it does not finish\n++static char rdMade[RD_MADE][160];\n++static unsigned char rdMadeDir[RD_MADE];\n++static int rdMadeCount = 0;\n++\n++// the file being written; a split game's part\n++static int rdFd = -1, rdPart = 0, rdSplit = 0;\n++static u32 rdPartLeft = 0;\n++static char rdPartBase[200];\n++\n++// how long: the kind of storage a rip goes to, and what each takes in KB/s, a CD's and a DVD's\n++enum { RD_DEST_USB = 0, RD_DEST_HDD, RD_DEST_MX4SIO, RD_DEST_ILINK, RD_DEST_MMCE, RD_DEST_OTHER, RD_DEST_COUNT };\n++static const char *const rdDestKey[RD_DEST_COUNT] = {\"usb\", \"hdd\", \"mx4sio\", \"ilink\", \"mmce\", \"other\"};\n++static const unsigned short rdGuessKbs[RD_DEST_COUNT][2] = {{800, 800}, {1400, 2400}, {600, 600}, {1400, 1600}, {400, 400}, {700, 700}};\n++static int rdDest = RD_DEST_OTHER;\n++static char rdEstBase[200]; // where media is to go, before its folder is picked (MEDIA's drive)\n++\n++// progress\n++static u64 rdDone = 0;\n++static double rdBegan = 0, rdDrawnAt = 0;\n++static const char *rdWhat = \"\";\n++\n++// the panel on LAUNCH DISC\n++static double rdPageSince = 0, rdLastFrame = 0, rdHoldSince = 0;\n++static int rdPageKind = -1, rdHolding = 0;\n++static float rdShown = 0.0f;\n++\n++static int rdIsGame(int kind)\n++{\n++    return kind == RIPPS2_DISC_PS2CD || kind == RIPPS2_DISC_PS2DVD || kind == RIPPS2_DISC_ESR || kind == RIPPS2_DISC_PS1;\n++}\n++\n++static int rdIsMedia(int kind)\n++{\n++    return kind == RIPPS2_DISC_AUDIO || kind == RIPPS2_DISC_VIDEO;\n++}\n++\n++static u64 rdAlpha(u64 c, int a)\n++{\n++    return (c & ~(0xFFULL << 24)) | ((u64)(a < 0 ? 0 : a > 0x80 ? 0x80 : a) << 24);\n++}\n++\n++static u32 rdLe32(const u8 *p)\n++{\n++    return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);\n++}\n++\n++static void rdPut32(u8 *p, u32 v)\n++{\n++    p[0] = v;\n++    p[1] = v >> 8;\n++    p[2] = v >> 16;\n++    p[3] = v >> 24;\n++}\n++\n++// \"4.38 GB\", \"612 MB\"\n++static void rdSize(u64 bytes, char *out, int size)\n++{\n++    if (bytes >= 1000000000ULL)\n++        snprintf(out, size, _t(\"%u.%02u GB\"), (unsigned)(bytes / 1000000000ULL), (unsigned)(bytes % 1000000000ULL / 10000000ULL));\n++    else\n++        snprintf(out, size, _t(\"%u MB\"), (unsigned)((bytes + 999999ULL) / 1000000ULL));\n++}\n++\n++// A name a FAT drive and Ember take: no \\ / : * ? \" < > |, no control codes, no dots or spaces at the ends\n++static void rdSafeName(const char *in, char *out, int size)\n++{\n++    int i, n = 0;\n++    for (i = 0; in[i] && n < size - 1; i++) {\n++        unsigned char c = in[i];\n++        out[n++] = (c < 0x20 || strchr(\"\\\\/:*?\\\"<>|\", c) != NULL) ? ' ' : c;\n++    }\n++    out[n] = '\\0';\n++    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '.'))\n++        out[--n] = '\\0';\n++    for (i = 0; out[i] == ' ' || out[i] == '.'; i++)\n++        ;\n++    if (i > 0)\n++        memmove(out, out + i, strlen(out + i) + 1);\n++}\n++\n++// ---- reading ----\n++\n++// n sectors from lsn in one of libcdvd's sector forms (as RiptOPL's own RetroAchievements hash reads them)\n++static int rdRead(u32 lsn, u32 n, void *buf, int pattern)\n++{\n++    sceCdRMode m;\n++    int attempt;\n++\n++    m.trycount = 32;\n++    m.datapattern = pattern;\n++    m.pad = 0;\n++    for (attempt = 0; attempt < 6; attempt++) {\n++        m.spindlctrl = attempt < 3 ? SCECdSpinNom : SCECdSpinStm;\n++        sceCdDiskReady(0);\n++        if (!sceCdRead(lsn, n, buf, &m))\n++            continue; // refused before it started: the drive was not ready\n++        sceCdSync(0);\n++        if (sceCdGetError() == SCECdErNO)\n++            return 1;\n++    }\n++    LOG(\"RIPDISC: sector %u (+