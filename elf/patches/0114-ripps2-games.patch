+        if (++bytes > 8192 || c == '\0')
+            goto invalid;
+        if (c == '\n') {
+            line[length] = '\0';
+            if (!cueAppendDiscLine(list, line, first, folder))
+                goto invalid;
+            length = 0;
+            first = 0;
+        } else {
+            if (length >= sizeof(line) - 1)
+                goto invalid;
+            line[length++] = c;
+        }
+    }
+    line[length] = '\0';
+    if (ferror(file) || !cueAppendDiscLine(list, line, first, folder) || list->count == 0)
+        goto invalid;
+    fclose(file);
+    *outList = list;
+    return list->count;
+
+invalid:
+    LOG("[CUE] invalid or unreadable disc list: %s\n", path);
+    fclose(file);
+    free(list);
+    return -1;
