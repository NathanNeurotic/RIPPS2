+// ---- build 114: the theme list (the user, 10/23) ----
+// SELECT held 4.2 s on a list with Settings > Interface > Hold SELECT on List (the default; Cycle loads the next theme as
+// before, Off leaves SELECT to refresh): a glass panel on the launch guard's frame fades in over the page with the themes,
+// eight to a page, in the Settings face. Up and Down pick, Left and Right (or L1 and R1) turn the page, Cross picks and
+// the panel fades out, Circle closes it. Returns the theme picked (the one in use as well: the caller refreshes the list
+// then instead of loading it again), or -1.
+#define TP_ROWS 8
+#define TP_LIT  GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define TP_SOFT GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+
+static u64 tpAlpha(u64 c, int a)
+{
+    return (c & ~(0xFFULL << 24)) | ((u64)(a & 0xFF) << 24);
+}
+
+static void tpDraw(const char **names, int n, int cur, int sel, float a)
+{
+    char pg[16];
+    int page = sel / TP_ROWS, first = page * TP_ROWS, pages = (n + TP_ROWS - 1) / TP_ROWS, rows = n < TP_ROWS ? n : TP_ROWS;
+    int w = 580, h = 84 + rows * 24, x = (640 - w) / 2, y = 134, ia = (int)(0x80 * a), i;
+    int confirmIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON;
+    int backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+
+    rmStartFrame();
+    guiRenderPage(); // the page as it is, under the glass
+    ripps2DrawHintBoxA(x, y, w, h, a);
+    fntRenderString(gTheme->fonts[4], 320, y + 26, ALIGN_CENTER, 0, 0, _t("THEMES"), tpAlpha(TP_LIT, ia));
+    if (pages > 1) {
+        snprintf(pg, sizeof(pg), "%d / %d", page + 1, pages);
+        fntRenderString(RIPPS2_DIA_FONT, x + w - 22 - rmUnScaleX(fntCalcDimensions(RIPPS2_DIA_FONT, pg)), y + 26, ALIGN_VCENTER, 0, 0, pg,
+                        tpAlpha(TP_SOFT, ia));
+    }
+    for (i = 0; i < TP_ROWS && first + i < n; i++) {
+        int k = first + i, ry = y + 56 + i * 24;
+        if (k == sel)
+            rmDrawRect(x + 16, ry - 11, w - 32, 22, GS_SETREG_RGBA(0x4A, 0x8C, 0xF0, ia / 4));
+        fntRenderString(RIPPS2_DIA_FONT, x + 30, ry, ALIGN_VCENTER | ALIGN_LEFT, 0, 0, names[k], tpAlpha(k == sel ? TP_LIT : TP_SOFT, ia));
+        if (k == cur) // measured: the font's own right alignment is not one fntRenderString takes
+            fntRenderString(RIPPS2_DIA_FONT, x + w - 30 - rmUnScaleX(fntCalcDimensions(RIPPS2_DIA_FONT, _t("IN USE"))), ry, ALIGN_VCENTER, 0, 0,
+                            _t("IN USE"), tpAlpha(TP_SOFT, ia));
+    }
+    ripps2HintPairA(confirmIcon, _t("CHOOSE"), backIcon, _t("BACK"), y + h - 20, ia);
+    rmEndFrame();
+}
+
+int ripps2ThemePanel(const char **names, int cur)
+{
+    int n = 0, sel = cur, picked = -1, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+    double t0, outAt = 0.0, now;
+    float a;
+
+    while (names != NULL && names[n] != NULL)
+        n++;
+    if (n < 1)
+        return -1;
+    if (sel < 0 || sel >= n)
+        sel = 0;
+    sfxPlay(SFX_TRANSITION);
+    t0 = ripps2Seconds();
+    for (;;) {
+        now = ripps2Seconds();
+        readPads();
+        if (outAt == 0.0) {
+            if (getKeyOn(KEY_UP)) {
+                sel = (sel + n - 1) % n;
+                sfxPlay(SFX_CURSOR);
+            } else if (getKeyOn(KEY_DOWN)) {
+                sel = (sel + 1) % n;
+                sfxPlay(SFX_CURSOR);
+            } else if ((getKeyOn(KEY_RIGHT) || getKeyOn(KEY_R1)) && n > TP_ROWS) {
+                sel = (sel / TP_ROWS + 1) * TP_ROWS < n ? (sel / TP_ROWS + 1) * TP_ROWS : 0; // the next page's first
+                sfxPlay(SFX_CURSOR);
+            } else if ((getKeyOn(KEY_LEFT) || getKeyOn(KEY_L1)) && n > TP_ROWS) {
+                sel = sel >= TP_ROWS ? (sel / TP_ROWS - 1) * TP_ROWS : ((n - 1) / TP_ROWS) * TP_ROWS;
+                sfxPlay(SFX_CURSOR);
+            } else if (getKeyOn(gSelectButton)) {
+                sfxPlay(SFX_CONFIRM);
+                picked = sel;
+                outAt = now;
+            } else if (getKeyOn(backKey)) {
+                sfxPlay(SFX_CANCEL);
+                outAt = now;
+            }
+        }
+        a = (float)((now - t0) / 0.35);
+        if (outAt > 0.0)
+            a = 1.0f - (float)((now - outAt) / 0.3);
+        if (outAt > 0.0 && a <= 0.0f)
+            return picked;
+        a = a >= 1.0f ? 1.0f : a * a * (3.0f - 2.0f * a);
+        tpDraw(names, n, cur, sel, a);
+    }
+}
