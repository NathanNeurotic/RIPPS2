+// ---- build 114: compression (the user, 10/23) ----
+// Game options > Hide Game and Compression: a PS2 game's ISO on a BDM drive or an MMCE card made a ZSO (OPL's own
+// compressed image: LZ4, 2 KB blocks, the index right after a 24-byte header), or a ZSO made an ISO again. Experimental,
+// and said so: a ZSO starts with the OPL core only (Neutrino reads no ZSO). The game's settings, art, cheats and saves
+// are kept by its ID and name, so they stay with it either way. A panel on the launch guard's frame says what it will do;
+// SELECT held fills the notches, then a last word to go ahead or back out (asked twice). The work shows the progress bar;
+// what was written is read back and checked piece by piece before anything else, and the original goes only when that
+// is asked too. The new image is <name>.zso.part (no list shows it) until it is checked; a cancel or a failure removes it.
+
+#define ZP_MAGIC 0x4F53495A // "ZISO"
+#define ZP_HEAD  24         // the header; the index (one entry a block, and the end) follows it
+#define ZP_RUN   64         // blocks read, packed and checked at a time (128 KB)
+#define ZP_IDX   16384      // index entries held before they are written back in place
+#define ZP_HOLD  4.2        // SELECT held to go on, as RIPDISC's
+#define ZP_STAGE (256 * 1024) // the new image is given to the drive this much at a time (zpOut)
+
+typedef struct
+{
+    int fdIn, fdOut, align, pack, phase; // pack: ISO to ZSO; phase: 0 the work, 1 the check
+    u32 blocks, *crcs;
+    s64 inBytes, outBytes, done, work; // work: every byte read on the way, for the bar
+    double began, drawnAt;
+    char name[160], why[96]; // why: where it stopped, for the message and a tester's report
+    unsigned char *stage;    // the new image's next piece (zpOut), 64-byte aligned
+    int fill, stageSize;     // stageSize: whole clusters of the drive, at least ZP_STAGE (ripps2StageFor)
+} zp_job_t;
+
+static void zpWhy(zp_job_t *j, const char *what, s64 at)
+{
+    char sz[24];
+    lrSize(at, sz, sizeof(sz));
+    snprintf(j->why, sizeof(j->why), "%s, %s", what, sz);
+    printf("RIPPS2 compression: %s at %s\n", what, sz);
+}
+
+// one 2 KB block in LZ4's block format (the EE's lz4.c only decodes): greedy, a 12-bit hash of 4 bytes, the format's end
+// rules kept (the last 5 bytes literals, no match starting in the last 12). Its Python twin round-trips through the
+// reference decoder; on the console every piece is read back through OPL's own LZ4_decompress_fast before anything else.
+static int zpLz4Emit(unsigned char *out, int op, int cap, const unsigned char *lit, int litLen, int offset, int ml)
+{
+    int r;
+    if (op + 1 + litLen / 255 + 1 + litLen + 2 + (ml > 0 ? ml / 255 + 1 : 0) > cap)
+        return -1;
+    out[op++] = (unsigned char)(((litLen >= 15 ? 15 : litLen) << 4) | (ml < 0 ? 0 : ml >= 15 ? 15 : ml));
+    if (litLen >= 15) {
+        for (r = litLen - 15; r >= 255; r -= 255)
+            out[op++] = 255;
+        out[op++] = (unsigned char)r;
+    }
+    memcpy(out + op, lit, litLen);
+    op += litLen;
+    if (ml >= 0) {
+        out[op++] = (unsigned char)(offset & 255);
+        out[op++] = (unsigned char)(offset >> 8);
+        if (ml >= 15) {
+            for (r = ml - 15; r >= 255; r -= 255)
+                out[op++] = 255;
+            out[op++] = (unsigned char)r;
+        }
+    }
+    return op;
+}
+
+static int zpLz4(const unsigned char *src, int n, unsigned char *out, int cap)
+{
+    static unsigned short table[4096];
+    int ip = 0, anchor = 0, op = 0, mflimit = n - 12, matchlimit = n - 5;
+    memset(table, 0, sizeof(table));
+    if (n >= 13)
+        while (ip < mflimit) {
+            u32 seq = src[ip] | src[ip + 1] << 8 | src[ip + 2] << 16 | (u32)src[ip + 3] << 24;
+            u32 h = (seq * 2654435761u) >> 20;
+            int ref = (int)table[h] - 1, len = 4;
+            table[h] = (unsigned short)(ip + 1);
+            if (ref < 0 || ip - ref > 65535 || memcmp(src + ref, src + ip, 4)) {
+                ip++;
+                continue;
+            }
+            while (ip + len < matchlimit && src[ref + len] == src[ip + len])
+                len++;
+            if ((op = zpLz4Emit(out, op, cap, src + anchor, ip - anchor, ip - ref, len - 4)) < 0)
+                return 0;
+            ip += len;
+            anchor = ip;
+        }
+    op = zpLz4Emit(out, op, cap, src + anchor, n - anchor, 0, -1);
+    return op < 0 ? 0 : op;
+}
+
+static int zpRow(item_list_t *support, int id, sh_row_t *r, item_list_t *view, const base_game_info_t **g)
+{
+    opl_io_module_t *mod;
+    if (support == NULL || !gEnableWrite)
+        return 0;
+    if (support->mode == MIX_MODE || support->mode == FAV_MODE) {
+        int mix = support->mode == MIX_MODE;
+        if (mix && mixIsWaiting(id))
+            return 0;
+        r->mode = mix ? mixGetItemSourceMode(id) : favGetItemSourceMode(id);
+        r->id = mix ? mixGetItemSourceId(id) : favGetItemSourceId(id);
+        r->kind = mix ? mixGetItemKind(id) : favGetItemKind(id);
+    } else {
+        int v = support->itemGetView != NULL ? support->itemGetView(support, id) : libListViewActive(support);
+        r->mode = support->mode;
+        r->id = id;
+        r->kind = v == LIB_VIEW_PS1 ? FAV_KIND_VCD : FAV_KIND_ISO;
+    }
+    if (r->kind != FAV_KIND_ISO || r->id < 0 || !((r->mode >= BDM_MODE && r->mode <= BDM_MODE_LAST) || r->mode == MMCE_MODE))
+        return 0;
+    mod = oplGetModule(r->mode);
+    if (mod == NULL || mod->support == NULL || mod->support->itemGet == NULL || mod->support->itemGetPrefix == NULL)
+        return 0;
+    *view = *mod->support;
+    view->viewOverride = ITEM_VIEW_FORCE_ISO;
+    *g = (const base_game_info_t *)view->itemGet(view, r->id);
+    // a plain Name.iso and the old SCUS_XXX.XX.Name.iso naming (OPL Manager's, most libraries') alike: OPL reads either as
+    // .iso or .zso (the lab, 10/23: SCPS_150.13.POINIES POIN.iso offered no compression)
+    if (*g == NULL || ((*g)->format != GAME_FORMAT_ISO && (*g)->format != GAME_FORMAT_OLD_ISO) || (*g)->parts != 1)
+        return 0;
+    snprintf(r->name, sizeof(r->name), "%s", (*g)->name);
+    return 1;
+}
+
+int ripps2PackKind(item_list_t *support, int id)
+{
+    sh_row_t r;
+    item_list_t view;
+    const base_game_info_t *g;
+    if (!zpRow(support, id, &r, &view, &g))
+        return 0;
+    if (!strcasecmp(g->extension, ".iso"))
+        return 1;
+    if (!strcasecmp(g->extension, ".zso"))
+        return 2;
+    return 0;
+}
+
+// how many MB a second the drive moves, read and written together (USB 1.1 on a PS2 is slow), for the time said first
+static double zpSpeed(int mode)
+{
+    if (mode == MMCE_MODE)
+        return 1.0;
+    switch (bdmSlotDeviceType(mode - BDM_MODE)) {
+        case BDM_TYPE_ATA:
+            return 9.0;
+        case BDM_TYPE_ILINK:
+            return 2.5;
+        case BDM_TYPE_SDC:
+            return 1.4;
+        default:
+            return 0.8; // USB
+    }
+}
