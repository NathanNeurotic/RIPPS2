+void ripps2HiddenGames(void)
+{
+    int sel = 0, top = 0, rows = HG_PAGE_ROWS, okKey = gSelectButton, backKey = gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE;
+
+    if (menuCheckParentalLock() != 0)
+        return;
+    guiRenderTextScreen(_t("Reading the hidden lists"));
+    hgGather();
+    readPads();
+    while (1) {
+        hgSel = sel;
+        hgTop = top;
+        rmStartFrame();
+        hgDrawPage(1);
+        rmEndFrame();
+
+        readPads();
+        if (getKey(KEY_UP) && sel > 0) {
+            sel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sel < hgCount - 1) {
+            sel++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(okKey) && hgCount > 0) {
+            // build 114: an ISO can be compressed here and a ZSO made an ISO again, as from a game's options
+            const char *choices[3] = {_t("SHOW IT AGAIN"), _t("DELETE IT"), hgRows[sel].pack == 2 ? _t("UNCOMPRESS TO ISO") : _t("COMPRESS TO ZSO")};
+            int pick;
+            sfxPlay(SFX_CONFIRM);
+            pick = ripps2PickList(choices, !gEnableWrite ? 1 : hgRows[sel].pack ? 3 : 2);
+            if (pick == 0)
+                hgShow(sel);
+            else if (pick == 2) {
+                opl_io_module_t *mod = oplGetModule(hgRows[sel].mode);
+                int id = hgFind(hgRows[sel].mode, 0, hgRows[sel].name);
+                if (mod == NULL || mod->support == NULL || id < 0) {
+                    guiMsgBoxSound(SFX_ERROR);
+                    guiMsgBox(_t("That game is not on its drive any more."), 0, NULL);
+                } else {
+                    item_list_t view = *mod->support;
+                    view.viewOverride = ITEM_VIEW_FORCE_ISO;
+                    zpUnder = hgDrawUnder; // the page stays under the panel and the bar
+                    ripps2PackGame(&view, id, 0);
+                    zpUnder = NULL;
+                }
+            } else if (pick == 1) {
+                opl_io_module_t *mod = oplGetModule(hgRows[sel].mode);
+                int id = hgFind(hgRows[sel].mode, hgRows[sel].ps1, hgRows[sel].name);
+                if (mod == NULL || mod->support == NULL || id < 0) {
+                    guiMsgBoxSound(SFX_ERROR);
+                    guiMsgBox(_t("That game is not on its drive any more."), 0, NULL);
+                } else {
+                    item_list_t view = *mod->support;
+                    view.viewOverride = hgRows[sel].ps1 ? ITEM_VIEW_FORCE_PS1 : ITEM_VIEW_FORCE_ISO;
+                    ripps2LastRites(&view, id);
+                }
+            }
+            if (pick >= 0) {
+                hgGather();
+                if (sel >= hgCount)
+                    sel = hgCount > 0 ? hgCount - 1 : 0;
+            }
+            readPads();
+        } else if (getKeyOn(backKey)) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+        if (sel < top)
+            top = sel;
+        if (sel >= top + rows)
+            top = sel - rows + 1;
+    }
+    readPads();
+}
