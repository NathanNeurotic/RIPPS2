+}
+DOCS = {
+    "docs/GAME-FORMATS.md": ("Game-Formats-Reference", "Game image formats reference"),
+    "docs/README.md": ("Documentation-Index", "Documentation index"),
+    "docs/TEST-BUILDS.md": ("Test-Builds", "Test builds and diagnostics"),
