+        "blob_url": "https://github.com/akilluminati47/RIPPS2/blob/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Fpatches%2F0110-ripps2-quicklists.patch",
+        "raw_url": "https://github.com/akilluminati47/RIPPS2/raw/e6b3fc9a5ad0bce0c08e30df84b697519aa9c803/elf%2Fpatches%2F0110-ripps2-quicklists.patch",
+        "contents_url": "https://api.github.com/repos/akilluminati47/RIPPS2/contents/elf%2Fpatches%2F0110-ripps2-quicklists.patch?ref=e6b3fc9a5ad0bce0c08e30df84b697519aa9c803",
+        "patch": "@@ -0,0 +1,797 @@\n+diff --git a/.github/scripts/test_bdm_private_allocation.py b/.github/scripts/test_bdm_private_allocation.py\n+index a09a6b5..4d363a1 100644\n+--- a/.github/scripts/test_bdm_private_allocation.py\n++++ b/.github/scripts/test_bdm_private_allocation.py\n+@@ -54,7 +54,10 @@ typedef struct {\n+ typedef struct {\n+     menu_item_t menuItem;\n+ } opl_io_module_t;\n++typedef struct { unsigned char tried, shown; unsigned int sum; } sb_snap_t; /* RIPPS2 build 110: a drive's last list */\n++static void sbSnapForget(sb_snap_t *s) { s->tried = s->shown = 0; s->sum = 0; }\n+ typedef struct {\n++    sb_snap_t bdmSnap;\n+     int bdmULSizePrev, bdmModifiedCDPrev, bdmModifiedDVDPrev;\n+     int bdmGameCount, bdmPs1GameCount, FoldersCreated, bdmDeviceType;\n+     int bdmHddIsLBA48, ataHighestUDMAMode, bdmDeviceTick;\n+diff --git a/.github/scripts/test_bdm_scan_retry.py b/.github/scripts/test_bdm_scan_retry.py\n+index 81626f4..ec32183 100644\n+--- a/.github/scripts/test_bdm_scan_retry.py\n++++ b/.github/scripts/test_bdm_scan_retry.py\n+@@ -68,6 +68,7 @@ HARNESS = r'''\n+ #define SFX_BD_CONNECT 1\n+ #define SFX_BD_DISCONNECT 2\n+ #define BDM_TYPE_USB 1\n++#define BDM_TYPE_SDC 2 /* RIPPS2 build 110: MX4SIO, whose scan pauses for the pads */\n+ #define BDM_TYPE_ATA 3\n+ #define BDM_TYPE_UDPBD 5\n+ #define BDM_TYPE_PCCF 6\n+@@ -91,6 +92,13 @@ typedef struct\n+     } menuItem;\n+ } opl_io_module_t;\n+ \n++/* RIPPS2 build 110: every source's last list (supportbase.c); no list is ever found here, so the scans are as before */\n++typedef struct { unsigned char tried, shown; unsigned int sum; } sb_snap_t;\n++static int sbSnapShow(sb_snap_t *s, const char *p, base_game_info_t **l, int *c, int *f) { (void)p; (void)l; (void)c; (void)f; s->tried = 1; return 0; }\n++static void sbSnapScanned(sb_snap_t *s, const char *p, const base_game_info_t *l, int c, int f, int ok) { (void)p; (void)l; (void)c; (void)f; (void)ok; s->tried = 1; s->shown = 0; }\n++static void sbSnapForget(sb_snap_t *s) { s->tried = s->shown = 0; s->sum = 0; }\n++static void sbSetPadBreath(int on) { (void)on; }\n++\n+ typedef struct\n+ {\n+     int ForceRefresh;\n+@@ -110,6 +118,7 @@ typedef struct\n+     base_game_info_t *bdmPs1Games;\n+     int bdmPs1GameCount;\n+     unsigned char bdmPs1RetryCount, bdmPs1RetryPending;\n++    sb_snap_t bdmSnap; /* RIPPS2 build 110: the drive's last list (none here: every pass scans) */\n+ } bdm_device_data_t;\n+ \n+ static int bdmDeviceModeStarted;\n+diff --git a/include/bdmsupport.h b/include/bdmsupport.h\n+index 1948878..40f6197 100644\n+--- a/include/bdmsupport.h\n++++ b/include/bdmsupport.h\n+@@ -6,6 +6,7 @@\n+ #define BDM_MODE_UPDATE_DELAY MENU_UPD_DELAY_GENREFRESH\n+ \n+ #include \"include/mcemu.h\"\n++#include \"include/supportbase.h\" // RIPPS2 build 110: sb_snap_t\n+ \n+ #define BDM_DEVICE_ROOT_MAX 32\n+ #define BDM_PREFIX_MAX      96\n+@@ -70,6 +71,7 @@ typedef struct\n+     // identity succeeds, so a mounted-but-unidentified slot would read as \"never connected\" and be\n+     // demoted to the slow empty-slot probe rotation -- exactly the slot that needs the full cadence.\n+     unsigned char bdmSeenMounted;\n++    sb_snap_t bdmSnap; // RIPPS2 build 110: the drive's last list (RIPPS2.LST), shown the moment the drive answers\n+ } bdm_device_data_t;\n+ \n+ void bdmLoadModules(void);\n+diff --git a/include/supportbase.h b/include/supportbase.h\n+index f767956..2574003 100644\n+--- a/include/supportbase.h\n++++ b/include/supportbase.h\n+@@ -51,6 +51,20 @@ int sbCreateSemaphore(void);\n+ // inside subfolders. Pass fsize=NULL for ISO-only scanning: never probe ul.cfg and\n+ // do not write a UL-size cache value (used by UDPFS, whose Neutrino backend cannot launch UL).\n+ int sbReadList(base_game_info_t **list, const char *prefix, const char *sub, int *fsize, int *gamecount);\n++// RIPPS2 build 110: a source's last game list, kept on the source (RIPPS2.LST beside its CD and DVD folders), so a\n++// big library shows the moment the source answers and is read again on the source's next pass.\n++typedef struct\n++{\n++    unsigned char tried; // this source's list was looked for\n++    unsigned char shown; // the games on screen came from it; the source is still to be read again\n++    unsigned int sum;    // what the list on the source holds (FNV-1a), so an unchanged list is not written\n++} sb_snap_t;\n++// The source's last list into *list (once a source): 1 when it was there and whole, 0 to scan as before\n++int sbSnapShow(sb_snap_t *snap, const char *prefix, base_game_info_t **list, int *gamecount, int *fsize);\n++// After a root scan: the list kept for next time (only when it changed); readOk 0 keeps the last one\n++void sbSnapScanned(sb_snap_t *snap, const char *prefix, const base_game_info_t *list, int gamecount, int fsize, int readOk);\n++void sbSnapForget(sb_snap_t *snap); // a source gone or changed: its list is looked for again\n++void sbSetPadBreath(int on);        // build 110: pause every scan (an MX4SIO drive shares SIO2 with the pads, as MMCE does)\n+ // errno of the last CD/DVD folder the latest sbReadList could not open (0 = both opened).\n+ int sbGetReadListError(void);\n+ // Folder browsing: set the active subpath the path composers inject (see sbBrowseSub in supportbase.c).\n+diff --git a/lng_tmpl/_base.yml b/lng_tmpl/_base.yml\n+index d1e72ef..d8a1ed9 100644\n+--- a/lng_tmpl/_base.yml\n++++ b/lng_tmpl/_base.yml\n+@@ -1078,7 +1078,7 @@ gui_strings:\n+ - label: RIPPS2_SETTINGS_HOME\n+   string: Save Settings To\n+ - label: HINT_RIPPS2_SETTINGS_HOME\n+-  string: \"Where RIPPS2 keeps its settings: RIPPS2's own save on a memory card, a RIPPS2 folder on the internal HDD, or a folder you type.\"\n++  string: \"Where RIPPS2 keeps its settings: RIPPS2's own save on a memory card, a RIPPS2 folder on a drive (the internal HDD, USB, MX4SIO, iLink or MMCE), or a folder you type.\"\n+ - label: HINT_CUSTOM_SETTINGS_PATH\n+   string: \"Save settings to a folder you choose, e.g. mass0:/OPL. Leave blank to use the folder OPL booted from. The device is loaded on demand, so it need not be mounted when you type it.\"\n+ - label: PERGAME_MIXED_SETTINGS\n+diff --git a/src/bdmsupport.c b/src/bdmsupport.c\n+index 1039df2..9a2174b 100644\n+--- a/src/bdmsupport.c\n++++ b/src/bdmsupport.c\n+@@ -1535,6 +1535,7 @@ static void bdmInit(item_list_t *itemList)\n+     pDeviceData->bdmModifiedDVDPrev = 0;\n+     pDeviceData->bdmGameCount = 0;\n+     pDeviceData->bdmGames = NULL;\n++    sbSnapForget(&pDeviceData->bdmSnap); // RIPPS2 build 110\n+     pDeviceData->bdmPs1GameCount = 0; // #120: separate VCD store (see bdm_device_data_t)\n+     pDeviceData->bdmPs1Games = NULL;\n+     pDeviceData->FoldersCreated = 0;\n+@@ -1618,6 +1619,7 @@ static int bdmRefreshGamePrefix(item_list_t *itemList)\n+     // detaches them. Publish zero games now; sbReadList releases it after detachment.\n+     device->bdmGameCount = 0;\n+     device->bdmULSizePrev = -2;\n++    sbSnapForget(&device->bdmSnap); // RIPPS2 build 110: another folder, another list\n+     device->bdmModifiedCDPrev = device->bdmModifiedDVDPrev = 0;\n+     device->FoldersCreated = device->ThemesLoaded = device->LanguagesLoaded = 0;\n+     folderReset(itemList->mode);\n+@@ -1652,6 +1654,13 @@ static int bdmNeedsUpdate(item_list_t *itemList)\n+         return 1;\n+     }\n+ \n++    // RIPPS2 build 110: the games on screen came from the drive's last list: read the drive once (this pass comes on the\n++    // next idle poll, which every connected drive gets)\n++    if (pDeviceData->bdmSnap.shown) {\n++        pDeviceData->bdmSnap.shown = 0;\n++        return 1;\n++    }\n++\n+     // If the device menu is visible double check the device type and if support for this device type is enabled. If the user switches device support\n+     // to off for a bdm device we want to hide the menu even though the drivers are still loaded and the device is being detected by bdm.\n+     opl_io_module_t *pOwner = (opl_io_module_t *)itemList->owner;\n+@@ -1748,6 +1757,7 @@ static int bdmNeedsUpdate(item_list_t *itemList)\n+     // If a device was added or removed play the appropriate UI sound.\n+     if (result == -1) {\n+         sfxPlay(SFX_BD_DISCONNECT);\n++        sbSnapForget(&pDeviceData->bdmSnap); // RIPPS2 build 110: the next drive here shows its own list\n+         return result;\n+     } else if (result == 1)\n+         sfxPlay(SFX_BD_CONNECT);\n+@@ -1836,7 +1846,16 @@ static int bdmUpdateGameList(item_list_t *itemList)\n+     }\n+     if (view == LIB_VIEW_ISO || view == LIB_VIEW_MIXED) {\n+         const char *sub = folderGetSub(itemList->mode);\n++        // RIPPS2 build 110: the drive's last list, at once; the drive is read on its next pass\n++        if (sub[0] == '\\0' && sbSnapShow(&pDeviceData->bdmSnap, pDeviceData->bdmPrefix, &pDeviceData->bdmGames, &pDeviceData->bdmGameCount,\n++                                          &pDeviceData->bdmULSizePrev))\n++            return result + pDeviceData->bdmGameCount;\n++        sbSetPadBreath(pDeviceData->bdmDeviceType == BDM_TYPE_SDC); // build 110: MX4SIO shares SIO2 with the pads\n+         sbReadList(&pDeviceData->bdmGames, pDeviceData->bdmPrefix, sub, &pDeviceData->bdmULSizePrev, &pDeviceData->bdmGameCount);\n++        sbSetPadBreath(0);\n++        if (sub[0] == '\\0')\n++            sbSnapScanned(&pDeviceData->bdmSnap, pDeviceData->bdmPrefix, pDeviceData->bdmGames, pDeviceData->bdmGameCount,\n++                          pDeviceData->bdmULSizePrev, sbGetReadListError() == 0 || pDeviceData->bdmGameCount > 0);\n+         // Still -2 after a root scan = neither CD nor DVD would open and there is no ul.cfg. Say where\n+         // it looked rather than leave a silently empty page. Only a connect, SELECT, L3 or\n+         // delete/rename pass scans, so this cannot repeat on its own.\n+diff --git a/src/ethsupport.c b/src/ethsupport.c\n+index 6fc7a59..a1d3d0a 100644\n+--- a/src/ethsupport.c\n++++ b/src/ethsupport.c\n+@@ -34,6 +34,