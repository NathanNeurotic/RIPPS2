+/* Build 112: which piece BIOS Music rips (user: "make it so you can select one other or both ripped ... make the
+   osdsys one the default"). THE MENU (the clock's, first and chosen), THE RED SCREEN, BOTH, drawn as Memory Files'
+   replace question is. A bit per piece (1 << RIPPS2_BIOSMUSIC_*), 0 when backed out. */
+static int rbsPickMusic(const int *len)
+{
+    static const char *const opts[3] = {N_("THE MENU MUSIC (THE CLOCK)"), N_("THE RED SCREEN MUSIC (DISC WARNING)"), N_("BOTH")};
+    static const int bits[3] = {1 << RIPPS2_BIOSMUSIC_MENU, 1 << RIPPS2_BIOSMUSIC_RED,
+                                (1 << RIPPS2_BIOSMUSIC_MENU) | (1 << RIPPS2_BIOSMUSIC_RED)};
+    int sel = 0, i, smallFont = gTheme->fonts[5], uiFont = gTheme->fonts[4];
+    int selIcon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON, backIcon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+    char line[64];
+
+    sfxPlay(SFX_MESSAGE);
+    while (1) {
+        readPads();
+        rmStartFrame();
+        ripps2DrawBackground();
+        ripps2DrawPagePanel();
+        int w = 460, h = 70 + 3 * 26, x = (640 - w) / 2, y = 150;
+        rmDrawRect(x, y, w, h, RBS_PICK_PRIM(0x03, 0x08, 0x22, 0x78));
+        rmDrawLine(x, y, x + w, y, RBS_PICK_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y + h, x + w, y + h, RBS_PICK_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x, y, x, y + h, RBS_PICK_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        rmDrawLine(x + w, y, x + w, y + h, RBS_PICK_PRIM(0x4A, 0x72, 0xDC, 0x80));
+        fntRenderString(uiFont, x + 16, y + 20, ALIGN_VCENTER, 0, 0, _t("WHICH MUSIC?"), RBS_PICK_LIT);
+        for (i = 0; i < 3; i++) {
+            int ry = y + 40 + i * 26, k = i == 2 ? -1 : (i == 0 ? RIPPS2_BIOSMUSIC_MENU : RIPPS2_BIOSMUSIC_RED);
+            if (i == sel) {
+                rmDrawRect(x + 8, ry, w - 16, 24, RBS_PICK_PRIM(0x1E, 0x3C, 0x96, 0x60));
+                rmDrawRect(x + 8, ry, 3, 24, RBS_PICK_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+            }
+            fntRenderStringFit(uiFont, x + 22, ry + 12, ALIGN_VCENTER, w - 100, _t(opts[i]), i == sel ? RBS_PICK_LIT : RBS_PICK_SOFT, 0);
+            if (k >= 0 && len[k] > 0) { // its length, at the right
+                snprintf(line, sizeof(line), "%d:%02d", len[k] / RBS_MUSIC_RATE / 60, len[k] / RBS_MUSIC_RATE % 60);
+                // hotfix (still build 112): fntRenderString has no right alignment (ALIGN_RIGHT is not read), so
+                // the length began at the box's edge and ran out of it; it ends 16 px inside now, measured
+                fntRenderString(smallFont, x + w - 16 - rmUnScaleX(fntCalcDimensions(smallFont, line)), ry + 12, ALIGN_VCENTER, 0, 0,
+                                line, RBS_PICK_SOFT);
+            }
+        }
+        int hx = x + 16;
+        rbsPickHint(selIcon, _t("CHOOSE"), &hx, y + h + 22);
+        rbsPickHint(backIcon, _t("BACK"), &hx, y + h + 22);
+        rmEndFrame();
+        if (getKey(KEY_UP) && sel > 0) {
+            sel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sel < 2) {
+            sel++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            return bits[sel];
+        } else if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+            sfxPlay(SFX_CANCEL);
+            return 0;
+        }
+    }
+}
