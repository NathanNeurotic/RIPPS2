+// One piece into dir (with its trailing slash): 1 written, 0 not (msg says why)
+static int rbsRipPiece(const unsigned char *img, int imgSize, int piece, int samples, const char *dir, char *msg, int msgSize)
+{
+    unsigned char h[44] = {'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ', 16, 0, 0, 0, 1, 0, 1, 0};
+    const char *file = piece == RIPPS2_BIOSMUSIC_MENU ? RBS_MUSIC_FILE : RBS_RED_FILE;
+    unsigned int bytes = 44 + (unsigned int)samples * 2;
+    char path[320], mb[16], start[64];
+    rbs_wav_t w;
+    int r, ok;
+
+    snprintf(mb, sizeof(mb), _t("%u.%u MB"), bytes / 1048576, bytes % 1048576 * 10 / 1048576);
+    snprintf(path, sizeof(path), "%s%s", dir, file);
+    if ((w.f = fopen(path, "wb")) == NULL) {
+        snprintf(msg, msgSize, _t("%s could not be made. Is the drive write-protected?"), path);
+        return 0;
+    }
+    rbsPut32(h + 4, bytes - 8);
+    rbsPut32(h + 24, RBS_MUSIC_RATE);
+    rbsPut32(h + 28, RBS_MUSIC_RATE * 2);
+    h[32] = 2;
+    h[34] = 16;
+    memcpy(h + 36, "data", 4);
+    rbsPut32(h + 40, (unsigned int)samples * 2);
+    w.pct = -1;
+    w.fmt = piece == RIPPS2_BIOSMUSIC_MENU ? _t("Ripping this console's menu music: %d%%") : _t("Ripping this console's red screen music: %d%%");
+    snprintf(start, sizeof(start), w.fmt, 0);
+    guiRenderTextScreen(start);
+    ok = fwrite(h, 1, sizeof(h), w.f) == sizeof(h);
+    r = ok ? ripps2BiosMusicFromImageOf(img, imgSize, piece, rbsWavPut, &w) : -2;
+    ok = fclose(w.f) == 0 && r == samples;
+    if (!ok) {
+        remove(path); // never a short WAV left behind
+        snprintf(msg, msgSize, _t("The menu music could not be written to %s (%s). Is the drive full?"), dir, mb);
+        return 0;
+    }
+    if (piece == RIPPS2_BIOSMUSIC_MENU)
+        snprintf(msg, msgSize, _t("The menu music (%s) is in %s as %s. Audio settings > Music lists it as Menu; it plays when no other track is picked."),
+                 mb, dir, file);
+    else
+        snprintf(msg, msgSize, _t("The red screen music (%s) is in %s as %s. Audio settings > Music lists it as Red Screen."), mb, dir, file);
+    return 1;
+}
 
