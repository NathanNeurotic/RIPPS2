diff --git a/lng_tmpl/_base.yml b/lng_tmpl/_base.yml
index 99d66fa..e551ed2 100644
--- a/lng_tmpl/_base.yml
+++ b/lng_tmpl/_base.yml
@@ -305,7 +305,7 @@ gui_strings:
 - label: BDM_PREFIX
   string: BDM Prefix Path
 - label: HINT_EXITPATH
-  string: "Where EXIT in the In-Game Menu goes. Best left empty with BOOT LOCK on (PS2BBL, FMCB or OSDMenu, or BIBLE set up): EXIT then goes through the browser, which starts your boot loader and RIPPS2 as at power on, the safest way back. Empty without the lock: RIPPS2's own ELF on a memory card or a FAT32 USB drive, loaded straight after the reset, which not every game leaves the console ready for. Browser: the PS2 browser. An ELF on MMCE can't be reached then at all."
+  string: "Where EXIT in the In-Game Menu goes. Best left empty: EXIT goes to the browser, which starts your boot loader (FreeMcBoot, PS2BBL, OSDMenu or BIBLE) when one is installed, and RIPPS2 again with BOOT LOCK on, as at power on; with none, the PS2 browser. An ELF typed here is used only when the reset can load it (on a memory card or a FAT32 USB drive) and it is not RIPPS2 itself; anything else goes to the browser."
 - label: HINT_SPINDOWN
   string: Value in minute(s), 0 to disable spin down.
 - label: HDD_SPINDOWN
