+            case BDM_TYPE_ATA:
+                return 2400;
+            case BDM_TYPE_ILINK:
+                return 1400;
+            case BDM_TYPE_SDC:
+                return 600;
+            default:
+                break;
+        }
+    return 800; // USB 1.1
