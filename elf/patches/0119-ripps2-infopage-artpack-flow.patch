+// build 119: the RIPPS2 progress bar (as COPYING and COMPRESSING draw it): how much of how much, which picture, how long
+// is left once that can be told; the back key asks to stop (1 = stop)
+static int apProgress(const char *pack, long long done, int n, int total, clock_t began, int force)
+{
+    static clock_t shown = 0;
+    char left[96], when[48];
+    double secs = (double)(clock() - began) / CLOCKS_PER_SEC;
+    float p = apTotal > 0 ? (float)((double)done / (double)apTotal) : 0.0f;
+
+    readPads();
+    if (getKeyOn(gSelectButton == KEY_CIRCLE ? KEY_CROSS : KEY_CIRCLE)) {
+        guiMsgBoxSound(SFX_ERROR);
+        if (guiMsgBox(_t("Stop? The unfinished pack is removed; the ART folders stay as they are."), 1, NULL))
+            return 1;
+        force = 1;
+    }
+    if (!force && clock() - shown < CLOCKS_PER_SEC / 5)
+        return 0;
+    shown = clock();
+    when[0] = '\0';
+    if (secs > 5.0 && p > 0.02f) {
+        int mins = (int)((secs / p - secs) / 60.0 + 0.5);
+        if (mins < 1)
+            snprintf(when, sizeof(when), "%s", _t("LESS THAN A MINUTE LEFT"));
+        else
+            snprintf(when, sizeof(when), _t("ABOUT %d MIN"), mins);
+    }
+    snprintf(left, sizeof(left), _t("PICTURE %d OF %d"), n, total);
+    if (when[0])
+        snprintf(left + strlen(left), sizeof(left) - strlen(left), "   %s", when);
+    ripps2DrawProgress(_t("PACKING THE ART"), pack, done, apTotal, left, 1);
+    return 0;
+}
