diff --git a/include/ripps2.h b/include/ripps2.h
index 2a89b58..c09b774 100644
--- a/include/ripps2.h
+++ b/include/ripps2.h
@@ -40,7 +40,8 @@ int ripps2BootLockState(void);              // 1 when the config of the loader t
 void ripps2BootLockApply(int on);           // writes it into (or out of) every PS2BBL, FMCB and OSDMenu config found; says how it went
 int ripps2BootLockIgrPath(char *out, int size); // RIPPS2's path in the IGR Path's own form; 0 when the IGR cannot reach it
 void ripps2ExitPathCheck(void);                  // build 115: is a memory-card IGR Path there (the boot card in)
-const char *ripps2ExitPath(char *buf, int size); // build 115: where EXIT goes: the IGR Path, else RIPPS2, else Browser
+const char *ripps2ExitPath(char *buf, int size); // where EXIT goes: the IGR Path when the reset can load it, else Browser (build 119)
+int ripps2ExitPathIgnored(void);                  // build 119: an IGR Path is set that EXIT passes over for the browser
 void ripps2BibleManage(void);               // BOOT LOADER > MANAGE: what each card starts; BIBLE (PS2BBL 1.2.0) to install or repair
 int ripps2RebootIopWith(const void *ioprp, int size); // opl.c: the IOP rebooted from an IOPRP image, the menu taken down and back
 int ripps2GetBootPath(char *out, int size); // opl.c: the path RIPPS2 was started from; 0 when unknown
@@ -180,6 +181,8 @@ void ripps2SizeText(long long bytes, char *out, int size);
 int ripps2StageFor(unsigned int clusterBytes, int floor); // a write stage of whole clusters, at least floor
 // build 114: the RIPPS2 progress bar (ripps2games.c) for a long job with nothing else on screen, and a file copied with it
 void ripps2DrawProgress(const char *head, const char *name, long long done, long long total, const char *left, int cancel);
+// build 119: the long-job panel (what, sizes, how long; SELECT held to go on: 1, back: 0)
+int ripps2AskHold(const char *head, const char *name, const char *info, const char *when, const char *note);
 int ripps2CopyFile(const char *src, const char *dst, const char *name) __attribute__((weak));
 void ripps2DiscWatch(void);         // every frame: the drive read after boot and after the tray closes
 int ripps2DiscQuiet(void);
