index f0dbae8..4af1c08 100644
--- a/include/menusys.h
+++ b/include/menusys.h
@@ -151,6 +151,8 @@ void menuRequestInfoSize(void);
 void menuRenderMain();
 void menuRenderMenu();
 void menuRenderInfo();
+int menuInfoSidebar(void);      // build 119: the sidebar drawn on the info page all the time (the theme's info_sidebar=1)
