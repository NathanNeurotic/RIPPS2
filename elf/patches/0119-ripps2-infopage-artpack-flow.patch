-// ---------------------------------------------------------------- the build
+// build 119: how fast a drive takes one long file (KB a second): RIPDISC's figures for the kinds of storage
+static int apWriteKbs(const char *root)
+{
+    if (!strncmp(root, "mmce", 4))
+        return 400;
+    if (!strncmp(root, "pfs", 3))
+        return 2400;
+    if (!strncmp(root, "mass", 4) && root[4] >= '0' && root[4] <= '7')
