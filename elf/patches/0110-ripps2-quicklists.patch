+// ---- RIPPS2 build 110: every source's last list ----
+// Build 109 kept an MMCE card's game list on the card, so a 180-game library listed at once instead of after about 5
+// minutes. Every source does it now: the list read last time is kept on the source, shown the moment the source
+// answers, and the source is read again on its next pass, the list following whatever changed.
+#define SB_SNAP_FILE  "RIPPS2.LST"
+#define SB_SNAP_MAGIC "RIPLST01"
+#define SB_SNAP_MAX   4096
+typedef struct
+{
+    char magic[8];
+    int count, fsize, itemSize, reserved[3];
+} sb_snap_hdr_t;
+
+static unsigned int sbSnapHash(const base_game_info_t *games, int count, int fsize)
+{
+    const unsigned char *b = (const unsigned char *)games;
+    unsigned int h = 2166136261u ^ (unsigned int)fsize;
+    size_t i, n = (size_t)count * sizeof(base_game_info_t);
+    for (i = 0; i < n; i++)
+        h = (h ^ b[i]) * 16777619u;
+    return h;
+}
+
+int sbSnapShow(sb_snap_t *snap, const char *prefix, base_game_info_t **list, int *gamecount, int *fsize)
+{
+    char path[256];
+    sb_snap_hdr_t h;
+    base_game_info_t *games;
+    int fd, bytes, ok = 0;
+
+    if (snap->tried)
+        return 0;
+    snap->tried = 1;
+    snprintf(path, sizeof(path), "%s%s", prefix, SB_SNAP_FILE);
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return 0;
+    if (read(fd, &h, sizeof(h)) == (int)sizeof(h) && !memcmp(h.magic, SB_SNAP_MAGIC, 8) && h.itemSize == (int)sizeof(base_game_info_t) &&
+        h.count > 0 && h.count <= SB_SNAP_MAX) {
+        bytes = h.count * (int)sizeof(base_game_info_t);
+        if ((games = malloc(bytes)) != NULL) {
+            if (read(fd, games, bytes) == bytes) {
+                free(*list); // as sbReadList publishes a new list
+                *list = games;
+                *gamecount = h.count;
+                if (fsize != NULL)
+                    *fsize = h.fsize;
+                snap->sum = sbSnapHash(games, h.count, h.fsize);
+                snap->shown = ok = 1;
+            } else
+                free(games);
+        }
+    }
+    close(fd);
+    return ok;
+}
+
+void sbSnapScanned(sb_snap_t *snap, const char *prefix, const base_game_info_t *list, int gamecount, int fsize, int readOk)
+{
+    char path[256];
+    sb_snap_hdr_t h;
+    unsigned int sum;
+    int fd, bytes;
+
+    snap->tried = 1;
+    snap->shown = 0;
+    if (!readOk || !gEnableWrite || gamecount > SB_SNAP_MAX)
+        return;
+    snprintf(path, sizeof(path), "%s%s", prefix, SB_SNAP_FILE);
+    if (gamecount <= 0 || list == NULL) { // nothing there now: no list to show next time
+        if (snap->sum != 0)
+            remove(path);
+        snap->sum = 0;
+        return;
+    }
+    sum = sbSnapHash(list, gamecount, fsize);
+    if (sum == snap->sum)
+        return;
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)
+        return;
+    memset(&h, 0, sizeof(h));
+    memcpy(h.magic, SB_SNAP_MAGIC, 8);
+    h.count = gamecount;
+    h.fsize = fsize;
+    h.itemSize = (int)sizeof(base_game_info_t);
+    bytes = gamecount * (int)sizeof(base_game_info_t);
+    if (write(fd, &h, sizeof(h)) == (int)sizeof(h) && write(fd, list, bytes) == bytes)
+        snap->sum = sum;
+    close(fd);
+}
+
+void sbSnapForget(sb_snap_t *snap)
+{
+    snap->tried = snap->shown = 0;
+    snap->sum = 0;
+}
