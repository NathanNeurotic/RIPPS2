+// RIPPS2 build 110: an MMCE card as the settings home (Save Settings To > MMCE). Its driver is not loaded at boot unless
+// RIPPS2 started from the card, so load it and give the card the short wait an MMCE boot gets.
+static int prepareMmceSettingsPath(const char *path)
+{
+    char root[8];
+    const char *colon = strchr(path, ':');
+    size_t n = colon ? (size_t)(colon - path) + 1 : 0;
+    int tries;
+
+    if (n == 0 || n >= sizeof(root))
+        return -1;
+    memcpy(root, path, n);
+    root[n] = '\0';
+    mmceLoadModules();
+    for (tries = 0; tries < 10; tries++) { // ~2 s, as an MMCE boot waits
+        DIR *dir = opendir(root);
+        if (dir != NULL) {
+            closedir(dir);
+            return 1;
+        }
+        delay(1);
+    }
+    return -1;
+}
