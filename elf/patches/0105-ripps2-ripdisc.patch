+// "KEY = value" from SYSTEM.CNF text: BOOT2 on a PS2 disc, BOOT on a PS1 one (BOOT2 is not BOOT: its "2" is no "=")
+static int discCnfValue(const char *cnf, const char *key, char *out, int size)
+{
+    const char *p = cnf;
+    int k = strlen(key);
+    while ((p = strstr(p, key)) != NULL) {
+        const char *q = p + k;
+        while (*q == ' ' || *q == '\t')
+            q++;
+        if (*q == '=' && (p == cnf || p[-1] == '\n' || p[-1] == '\r' || p[-1] == ' ')) {
+            int i = 0;
+            q++;
+            while (*q == ' ' || *q == '\t')
+                q++;
+            while (*q && *q != '\r' && *q != '\n' && *q != ' ' && *q != '\t' && i < size - 1)
+                out[i++] = *q++;
+            out[i] = '\0';
+            return i > 0;
+        }
+        p += k;
+    }
+    return 0;
+}
+
+// A game's ID from its SYSTEM.CNF ("cdrom0:\SLUS_200.62;1" -> "SLUS_200.62")
+static int discBootId(int ps1, char *id, int size)
+{
+    char cnf[512], path[64];
+    const char *s;
+    int fd = open("cdrom0:\\SYSTEM.CNF;1", O_RDONLY), n, i;
+
+    id[0] = '\0';
+    if (fd < 0)
+        return 0;
+    n = read(fd, cnf, sizeof(cnf) - 1);
+    close(fd);
+    if (n <= 0)
+        return 0;
+    cnf[n] = '\0';
+    if (!discCnfValue(cnf, ps1 ? "BOOT" : "BOOT2", path, sizeof(path)))
+        return 0;
+    s = strrchr(path, '\\');
+    s = s ? s + 1 : path;
+    if (strchr(s, ':') != NULL)
+        s = strchr(s, ':') + 1;
+    for (i = 0; s[i] && s[i] != ';' && i < size - 1; i++)
+        id[i] = s[i];
+    id[i] = '\0';
+    return i > 0;
+}
