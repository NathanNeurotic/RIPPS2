+        int slot = k ? 1 - boot : boot, fd;
+        DIR *d;
+        snprintf(path, sizeof(path), "mc%d:/", slot);
+        if ((d = opendir(path)) == NULL)
+            continue;
+        closedir(d);
+        snprintf(out, size, "mc%d:/RIPPS2", slot);
+        if (haveSettings) {
+            snprintf(path, sizeof(path), "%s/%s", out, CONFIG_OPL_FILENAME);
+            if ((fd = open(path, O_RDONLY)) < 0)
