+static int rbsWavPut(const short *pcm, int n, int done, int total, void *ctx)
+{
+    rbs_wav_t *w = (rbs_wav_t *)ctx;
+    int pct = total > 0 ? (int)((long long)done * 100 / total) : 0;
+    char msg[80];
