+    if ((int)fwrite(pcm, 2, n, w->f) != n) // the EE is little-endian, as a WAV is
+        return -1;
+    if (pct != w->pct) {
+        w->pct = pct;
+        snprintf(msg, sizeof(msg), "Ripping this console's menu music: %d%%", pct);
+        guiRenderTextScreen(msg);
+    }
+    return 0;
+}
