+// RIPPS2 build 100: a game started from Memory Files where it sits (not in CD or DVD). While set, every path of an ISO or
+// ZSO game is this file, so the launch, its layer probe and its fragment list all read it. Set only around that launch.
+static char sbPathOverride[256] = "";
+
+void sbSetPathOverride(const char *path)
+{
+    snprintf(sbPathOverride, sizeof(sbPathOverride), "%s", path != NULL ? path : "");
+}
+
+// RIPPS2 build 100: an image's boot file ("SLUS_200.62") from its SYSTEM.CNF, as the scan reads it; 1 = found
+int sbIsoStartup(const char *path, char *startup, int size)
+{
+    char st[GAME_STARTUP_MAX];
+    int ok, fd = fileXioMount("iso:", path, FIO_MT_RDONLY);
+
+    ok = fd >= 0 && GetStartupExecName("iso:/SYSTEM.CNF;1", st, GAME_STARTUP_MAX - 1) == 0;
+    fileXioUmount("iso:");
+    if (ok)
+        snprintf(startup, size, "%s", st);
+    return ok;
+}
