+#ifdef RIPPS2_BIOSSND_HOST_TEST
+// The PC's measure of the two fixed levels: the dry piece's peak, the raw hall's, and the result's at those levels
+int ripps2BiosMusicMeasure(const unsigned char *img, int size, float *dryPeak, float *wetPeak, float *outPeak, float wetScale)
+{
+    rbs_music_t *m = rbsMusicOpen(img, size), *w;
+    static float out[RBS_MUSIC_SLICE], dry[RBS_MUSIC_SLICE];
+    int n, k;
+
+    if (m == NULL)
+        return -1;
+    *dryPeak = *wetPeak = *outPeak = 0;
+    while ((n = rbsMusicNext(m, out, 0)) > 0)
+        for (k = 0; k < n; k++)
+            if (fabsf(out[k]) > *dryPeak)
+                *dryPeak = fabsf(out[k]);
+    rbsMusicClose(m);
+    if ((m = rbsMusicOpen(img, size)) == NULL || (w = rbsMusicOpen(img, size)) == NULL)
+        return -1;
+    while ((n = rbsMusicNext(m, out, wetScale)) > 0) {
+        rbsMusicNext(w, dry, 0);
+        for (k = 0; k < n; k++) {
+            if (fabsf(out[k]) > *outPeak)
+                *outPeak = fabsf(out[k]);
+            if (wetScale > 0 && fabsf((out[k] - dry[k]) / wetScale) > *wetPeak)
+                *wetPeak = fabsf((out[k] - dry[k]) / wetScale);
+        }
+    }
+    rbsMusicClose(m);
+    rbsMusicClose(w);
+    return 0;
+}
+#endif
