+/*
+  Build 100: the menu music (user: the BGM rip apart from the sounds, its size said first, and the user picks where
+  it goes). The browser's ambient piece, SNDWARNS (5 min 27 s on the SNDBOOT bank: its spectrum is the PS2's "Menu"
+  recording's), rendered a 0.2 s slice at a time straight at 24 kHz mono 16-bit (each voice read at every other
+  48 kHz step: the piece has next to nothing over 8 kHz) and through the same hall as the sounds, into a WAV the
+  music player loops.
+
+  The hall's level and the final gain need the whole piece's peaks, which a slice at a time cannot know in advance
+  without rendering it twice; SNDIMAGE is the same on every BIOS from 1.60 (checked on the PC from SCPH-30004 to
+  SCPH-77001), so they were measured once on the PC (ripps2BiosMusicMeasure) and are fixed here, with a soft limit
+  as a safety on a BIOS that would differ.
+*/
+#define RBS_MUSIC_SEQ     "SNDWARNS"
+#define RBS_MUSIC_RATE    24000
+#define RBS_MUSIC_SLICE   4800 // 24 kHz samples rendered at a time
+#define RBS_MUSIC_FADE    1.0f // seconds faded out at the end, so the loop starts again from silence
+#define RBS_MUSIC_WET     0.0807f // the hall at 0.4 of the dry piece's peak (dry 0.5335, raw hall 2.6455)
+#define RBS_MUSIC_GAIN    1.3875f // the result's peak (0.5766) to 0.8, as the sounds
+
+typedef struct
+{
+    rbs_seq_t q;
+    rbs_hall_t hall;
+    int at, out, outTotal; // at: the song's 48 kHz sample; out: 24 kHz samples made
+} rbs_music_t;
+
+static void rbsMusicClose(rbs_music_t *m)
+{
+    rbsHallFree(&m->hall);
+    rbsSeqFree(&m->q);
+    free(m);
+}
+
+static rbs_music_t *rbsMusicOpen(const unsigned char *img, int size)
+{
+    rbs_music_t *m = calloc(1, sizeof(rbs_music_t));
+    rbs_u8 *hd = NULL, *bd = NULL, *sq = NULL;
+    int ho, hl, bo, bl, so, sl, hdLen, bdLen, sqLen, ok = 0;
+
+    if (m == NULL)
+        return NULL;
+    if (!ripps2RomdirFind(img, size, "SNDBOOTH", &ho, &hl) && !ripps2RomdirFind(img, size, "SNDBOOTB", &bo, &bl) &&
+        !ripps2RomdirFind(img, size, RBS_MUSIC_SEQ, &so, &sl) && (hd = rbsUnlz(img + ho, hl, &hdLen)) != NULL &&
+        (bd = rbsUnlz(img + bo, bl, &bdLen)) != NULL && (sq = rbsUnlz(img + so, sl, &sqLen)) != NULL &&
+        !rbsSeqOpen(&m->q, sq, sqLen, hd, hdLen, bd, bdLen, 600) && !rbsHallInit(&m->hall, RBS_MUSIC_RATE, 3.0f))
+        ok = 1;
+    free(hd);
+    free(bd);
+    free(sq);
+    if (!ok) {
+        rbsMusicClose(m);
+        return NULL;
+    }
+    m->outTotal = m->q.total / 2;
+    return m;
+}
+
+// The next slice as 24 kHz mono samples (-1..1) in out (RBS_MUSIC_SLICE at most): how many, 0 at the end.
+// wetScale: the hall's level against the dry piece's; the samples are not yet gained
+static int rbsMusicNext(rbs_music_t *m, float *out, float wetScale)
+{
+    int n = m->outTotal - m->out, k;
+
+    if (n <= 0)
+        return 0;
+    if (n > RBS_MUSIC_SLICE)
+        n = RBS_MUSIC_SLICE;
+    memset(out, 0, sizeof(float) * n);
+    for (k = 0; k < m->q.nv && m->q.voices[k].i0 < m->at + 2 * n; k++) // the voices are in start order
+        rbsVoiceRun(&m->q.voices[k], out, m->at, n, 2);
+    for (k = 0; k < n; k++) {
+        float d = out[k] * (m->q.headVol / 127.0f);
+        out[k] = d + rbsHallStep(&m->hall, d) * wetScale;
+    }
+    m->at += 2 * n;
+    m->out += n;
+    return n;
+}
+
+int ripps2BiosMusicSamples(const unsigned char *img, int size)
+{
+    rbs_music_t *m = rbsMusicOpen(img, size);
+    int n;
+
+    if (m == NULL)
+        return -1;
+    n = m->outTotal;
+    rbsMusicClose(m);
+    return n;
+}
+
+int ripps2BiosMusicFromImage(const unsigned char *img, int size, ripps2_biosmusic_put_t put, void *ctx)
+{
+    rbs_music_t *m = rbsMusicOpen(img, size);
+    static short pcm[RBS_MUSIC_SLICE];
+    static float out[RBS_MUSIC_SLICE]; // static: 19 KB is too much for the GUI thread's stack
+    int n, k, fade0, r = 0;
+
+    if (m == NULL)
+        return -1;
+    fade0 = m->outTotal - (int)(RBS_MUSIC_FADE * RBS_MUSIC_RATE);
+    while ((n = rbsMusicNext(m, out, RBS_MUSIC_WET)) > 0) {
+        for (k = 0; k < n; k++) {
+            int at = m->out - n + k;
+            float v = out[k] * RBS_MUSIC_GAIN;
+            if (at >= fade0)
+                v *= 0.5f * (1.0f + cosf(3.14159265f * (float)(at - fade0) / (RBS_MUSIC_FADE * RBS_MUSIC_RATE)));
+            if (v > 0.9f || v < -0.9f) // a soft limit, only on a BIOS whose piece is louder than the one measured
+                v = (v > 0 ? 1.0f : -1.0f) * (0.9f + 0.1f * tanhf((fabsf(v) - 0.9f) * 10.0f));
+            pcm[k] = (short)lrintf(v * 32767.0f);
+        }
+        if ((r = put(pcm, n, m->out, m->outTotal, ctx)) != 0)
+            break;
+    }
+    n = m->out;
+    rbsMusicClose(m);
+    return r != 0 ? -2 : n;
+}
