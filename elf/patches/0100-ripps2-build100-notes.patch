+// RIPPS2 build 100: Memory Files starts an ISO or ZSO where it sits, not only in the drive's CD or DVD folder: a game of
+// its own for this one launch, every path of it the file (sbSetPathOverride), the normal teardown after
+static base_game_info_t bdmPathGame;
+static int bdmPathLaunch = 0;
+
+void bdmLaunchIsoAt(item_list_t *itemList, const char *path, const char *startup, int dvd, config_set_t *configSet)
+{
+    const char *name = strrchr(path, '/'), *dot;
+
+    if (itemList == NULL || itemList->priv == NULL || path == NULL || startup == NULL)
+        return;
+    name = name != NULL ? name + 1 : path;
+    dot = strrchr(name, '.');
+    memset(&bdmPathGame, 0, sizeof(bdmPathGame));
+    snprintf(bdmPathGame.name, sizeof(bdmPathGame.name), "%.*s", dot != NULL ? (int)(dot - name) : (int)strlen(name), name);
+    snprintf(bdmPathGame.extension, sizeof(bdmPathGame.extension), "%s", dot != NULL ? dot : ".iso");
+    snprintf(bdmPathGame.startup, sizeof(bdmPathGame.startup), "%s", startup);
+    bdmPathGame.parts = 1;
+    bdmPathGame.media = dvd ? SCECdPS2DVD : SCECdPS2CD;
+    bdmPathGame.format = GAME_FORMAT_ISO;
+    bdmPathLaunch = 1;
+    sbSetPathOverride(path);
+    bdmLaunchGame(itemList, 0, configSet);
+    bdmPathLaunch = 0; // back here: the launch did not happen
+    sbSetPathOverride(NULL);
+}
