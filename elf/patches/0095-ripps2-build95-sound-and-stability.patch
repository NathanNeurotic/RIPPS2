+// RIPPS2 build 95: game art as JPG. RiptOPL reads PNG only, and old OPL art packs are JPG, so every theme showed
+// those games as text (FifthFox on RIPgrid). Tried only when the PNG is not there; read whole, then decoded at
+// most 512 on a side (ripps2media.c).
+#define TEX_JPG_MAX_FILE (4 * 1024 * 1024)
+static int texLoadJpg(GSTEXTURE *texture, const char *filePath)
+{
+    unsigned char *buf, *rgba;
+    int fd, size, got = 0, r, w, h, ow, oh;
+
+    if ((fd = open(filePath, O_RDONLY)) < 0)
+        return ERR_BAD_FILE;
+    size = lseek(fd, 0, SEEK_END);
+    lseek(fd, 0, SEEK_SET);
+    if (size <= 0 || size > TEX_JPG_MAX_FILE || (buf = malloc(size)) == NULL) {
+        close(fd);
+        return ERR_BAD_FILE;
+    }
+    while (got < size && (r = read(fd, buf + got, size - got)) > 0)
+        got += r;
+    close(fd);
+    if (got != size || !ripps2DecodePicture(buf, size, 512, 512, &rgba, &w, &h, &ow, &oh, NULL)) {
+        free(buf);
+        return ERR_BAD_FILE;
+    }
+    free(buf);
+    texPrepare(texture);
+    texture->Width = w;
+    texture->Height = h;
+    texture->PSM = GS_PSM_CT32;
+    texture->Mem = (u32 *)rgba;
+    if (texSizeValidate(w, h, GS_PSM_CT32) < 0) {
+        texFree(texture);
+        return ERR_BAD_FILE;
+    }
+    return 0;
+}
