+// ---- sounds (build 95) ----
+// An .adp plays as RIPPS2 would play it: the confirm button plays it again, back closes. While it is open the
+// menu's own sounds are let go (audsrv cannot stop one sound alone) and they load again on the way out.
+static void ripps2PlaySound(const char *path)
+{
+    const char *name = strrchr(path, '/');
+    int ms = sfxPreviewStart(path), scrW, scrH, again = gSelectButton == KEY_CIRCLE ? KEY_CIRCLE : KEY_CROSS;
+    clock_t started = clock();
+    char line[200];
+
+    if (ms < 0) {
+        sfxPreviewStop();
+        guiMsgBox("This sound could not be played. RIPPS2 plays .adp sounds with their APCM header, up to 1 MB, as "
+                  "BIOS Sounds > Rip and RIPPS2 Audio Studio make them.",
+                  0, NULL);
+        return;
+    }
+    name = name != NULL ? name + 1 : path;
+    rmGetScreenExtents(&scrW, &scrH);
+    readPads();
+    for (;;) {
+        float t = (float)(clock() - started) / (float)CLOCKS_PER_SEC, len = ms / 1000.0f;
+        int done = t >= len, barW = (int)(400.0f * (done ? 1.0f : t / len));
+
+        guiStartFrame();
+        rmDrawRect(0, 0, scrW, scrH, GS_SETREG_RGBA(0x02, 0x03, 0x0A, 0x70));
+        fntRenderString(gTheme->fonts[0], 320, 190, ALIGN_CENTER, 0, 0, name, GS_SETREG_RGBA(0xE0, 0xE8, 0xFF, 0x80));
+        snprintf(line, sizeof(line), done ? "%.2f s" : "%.2f of %.2f s", done ? len : t, len);
+        fntRenderString(gTheme->fonts[0], 320, 222, ALIGN_CENTER, 0, 0, line, GS_SETREG_RGBA(0xA0, 0xB0, 0xE0, 0x80));
+        rmDrawRect(120, 246, 400, 4, GS_SETREG_RGBAQ(0x10, 0x16, 0x2C, 0x60, 0x00));
+        rmDrawRect(120, 246, barW, 4, GS_SETREG_RGBAQ(0x6A, 0x9A, 0xFF, 0x80, 0x00));
+        fntRenderString(gTheme->fonts[0], 320, 458, ALIGN_CENTER, 0, 0,
+                        gSelectButton == KEY_CIRCLE ? "Circle play again   Cross close" : "Cross play again   Circle close",
+                        GS_SETREG_RGBA(0xA0, 0xB0, 0xE0, 0x80));
+        guiEndFrame();
+
+        readPads();
+        if (getKeyOn(guiCancelKey()) || getKeyOn(KEY_START))
+            break;
+        if (getKeyOn(again)) {
+            ms = sfxPreviewStart(path);
+            started = clock();
+            if (ms < 0)
+                break;
+        }
+    }
+    sfxPreviewStop();
+    readPads();
+}
