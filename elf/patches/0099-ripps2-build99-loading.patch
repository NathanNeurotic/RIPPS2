+        int waitedMs;
+
+        ilinkProbeDone = 1;
+        for (waitedMs = 0; waitedMs < 3000 && !bdmGetDeviceRootByType(BDM_TYPE_ILINK, ilkRoot, sizeof(ilkRoot)); waitedMs += 250)
+            DelayThread(250 * 1000);
+        if (waitedMs > 0)
+            LOG("[BDM] iLink root %s after ~%d ms\n", waitedMs < 3000 ? "appeared" : "not found", waitedMs);
