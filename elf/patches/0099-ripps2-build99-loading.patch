+// RIPPS2 build 99: the music's own read path. vorbisfile asks for 2 KB at a time; straight from the drive that was a
+// device request every few hundred milliseconds of music, each one queued behind whatever art or list read held the
+// drive, and under a storm of those the decoder fell behind (the stutter on hardware). The file is now read into RAM
+// in big pieces -- 64 KB, growing to 256 KB while the music plays straight on (about 16 s of a 128 kbit/s track in
+// one request) -- and a track up to 512 KB is held whole, so its loop never touches the drive again. A seek starts
+// small again. Without the memory for it, reads go to the drive as they used to.
+#define BGM_CACHE_FIRST (64 * 1024)
+#define BGM_CACHE_BLOCK (256 * 1024)
+#define BGM_CACHE_WHOLE (512 * 1024)
+#define BGM_CACHE_KEEP  4096 // a piece read straight on starts this much before the last one ended (bgmFixedRead looks back)
+
+// 1 = the piece holding `at` is in RAM, 0 = the end of the file or a drive that will not answer, -1 = no memory
+static int bgmCacheFill(bgm_source_t *src, long at)
+{
+    long start = at, want, cap;
+    int tries = 0;
+
+    if (src->size >= 0 && src->size <= BGM_CACHE_WHOLE) {
+        start = 0;
+        want = cap = src->size;
+    } else {
+        // reading on from the end of the last piece: a bigger piece, starting a little before that end so a read that
+        // looks back over a page header still finds it in RAM; anywhere else (a seek): a small one
+        int straight = src->cacheLen > 0 && at == src->cacheBase + src->cacheLen;
+        long next = straight ? src->cacheNext * 2 : BGM_CACHE_FIRST;
+        src->cacheNext = next < BGM_CACHE_FIRST ? BGM_CACHE_FIRST : next > BGM_CACHE_BLOCK ? BGM_CACHE_BLOCK : next;
+        if (straight)
+            start = at > BGM_CACHE_KEEP ? at - BGM_CACHE_KEEP : 0;
+        want = src->cacheNext;
+        cap = BGM_CACHE_BLOCK;
+        if (src->size >= 0 && start + want > src->size)
+            want = src->size - start;
+    }
+    if (want <= 0)
+        return 0;
+    if (src->cache == NULL || src->cacheCap < cap) {
+        free(src->cache);
+        src->cacheLen = src->cacheCap = 0;
+        if ((src->cache = malloc((size_t)cap)) == NULL)
+            return -1;
+        src->cacheCap = cap;
+    }
+    for (;;) {
+        size_t got = 0;
+        if (fseek(src->f, start, SEEK_SET) == 0)
+            got = fread(src->cache, 1, (size_t)want, src->f);
+        if (got > 0) {
+            src->cacheBase = start;
+            src->cacheLen = (long)got;
+            return 1;
+        }
+        src->cacheLen = 0;
+        // nothing read before the end: the descriptor is gone -- reopen and read again
+        if (tries++ >= BGM_REOPEN_TRIES || !bgmSourceReopen(src))
+            return 0;
+    }
+}
+
+// n bytes of the file from off into buf, from RAM; a piece not there is read in first. The bytes it could give.
+static size_t bgmCacheRead(bgm_source_t *src, long off, unsigned char *buf, size_t n)
+{
+    size_t done = 0;
+    int tries = 0;
+
+    while (done < n) {
+        long at = off + (long)done;
+        if (src->cacheLen > 0 && at >= src->cacheBase && at < src->cacheBase + src->cacheLen) {
+            size_t k = (size_t)(src->cacheBase + src->cacheLen - at);
+            if (k > n - done)
+                k = n - done;
+            memcpy(buf + done, src->cache + (at - src->cacheBase), k);
+            done += k;
+            continue;
+        }
+        if (src->size >= 0 && at >= src->size)
+            break; // the end of the file
+        int r = src->noCache ? -1 : bgmCacheFill(src, at);
+        if (r > 0)
+            continue;
+        if (r == 0)
+            break;
+        src->noCache = 1; // no memory for it: straight from the drive, as before
+        size_t got = 0;
+        if (fseek(src->f, at, SEEK_SET) == 0)
+            got = fread(buf + done, 1, n - done, src->f);
+        if (got > 0) {
+            done += got;
+            continue;
+        }
+        if (tries++ >= BGM_REOPEN_TRIES || !bgmSourceReopen(src))
+            break;
+    }
+    return done;
+}
