+
+// RIPPS2 build 109: a fast MMCE boot. The card's game list is kept on the card (RIPPS2.LST beside its CD and DVD
+// folders): at boot the games show from it at once, then the card is read again in the background (sbReadList, which
+// now pauses between games for the pads) and the list follows whatever changed. A tester's 180 games took about 5
+// minutes to list on every boot, with nothing to press until then.
+#define MMCE_LIST_FILE  "RIPPS2.LST"
+#define MMCE_LIST_MAGIC "RIPLST01"
+#define MMCE_LIST_MAX   4096
+typedef struct
+{
+    char magic[8];
+    int count, ulsize, itemSize, reserved[3];
+} mmce_list_hdr_t;
+static unsigned char mmceListTried; // this card's list was looked for
+static unsigned char mmceListShown; // the games on screen came from it; the card is still to be read again
+static unsigned int mmceListSum;    // what the list on the card holds (FNV-1a), so an unchanged list is not written
+
+static unsigned int mmceListHash(const base_game_info_t *games, int count, int ulsize)
+{
+    const unsigned char *b = (const unsigned char *)games;
+    unsigned int h = 2166136261u ^ (unsigned int)ulsize;
+    size_t i, n = (size_t)count * sizeof(base_game_info_t);
+    for (i = 0; i < n; i++)
+        h = (h ^ b[i]) * 16777619u;
+    return h;
+}
+
+// The card's last list, into mmceGames: 1 when it was there and whole
+static int mmceListLoad(void)
+{
+    char path[sizeof(mmcePrefix) + 16];
+    mmce_list_hdr_t h;
+    base_game_info_t *games;
+    int fd, bytes, ok = 0;
+
+    snprintf(path, sizeof(path), "%s%s", mmcePrefix, MMCE_LIST_FILE);
+    if ((fd = open(path, O_RDONLY)) < 0)
+        return 0;
+    if (read(fd, &h, sizeof(h)) == (int)sizeof(h) && !memcmp(h.magic, MMCE_LIST_MAGIC, 8) && h.itemSize == (int)sizeof(base_game_info_t) &&
+        h.count > 0 && h.count <= MMCE_LIST_MAX) {
+        bytes = h.count * (int)sizeof(base_game_info_t);
+        if ((games = malloc(bytes)) != NULL) {
+            if (read(fd, games, bytes) == bytes) {
+                free(mmceGames);
+                mmceGames = games;
+                mmceGameCount = h.count;
+                mmceULSizePrev = h.ulsize;
+                mmceListSum = mmceListHash(games, h.count, h.ulsize);
+                ok = 1;
+            } else
+                free(games);
+        }
+    }
+    close(fd);
+    return ok;
+}
+
+// The list just read from the card, kept there for the next boot (only when it changed)
+static void mmceListSave(void)
+{
+    char path[sizeof(mmcePrefix) + 16];
+    mmce_list_hdr_t h;
+    unsigned int sum;
+    int fd, bytes;
+
+    if (mmceGames == NULL || mmceGameCount <= 0 || mmceGameCount > MMCE_LIST_MAX)
+        return;
+    sum = mmceListHash(mmceGames, mmceGameCount, mmceULSizePrev);
+    if (sum == mmceListSum)
+        return;
+    snprintf(path, sizeof(path), "%s%s", mmcePrefix, MMCE_LIST_FILE);
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666)) < 0)
+        return;
+    memset(&h, 0, sizeof(h));
+    memcpy(h.magic, MMCE_LIST_MAGIC, 8);
+    h.count = mmceGameCount;
+    h.ulsize = mmceULSizePrev;
+    h.itemSize = (int)sizeof(base_game_info_t);
+    bytes = mmceGameCount * (int)sizeof(base_game_info_t);
+    if (write(fd, &h, sizeof(h)) == (int)sizeof(h) && write(fd, mmceGames, bytes) == bytes)
+        mmceListSum = sum;
+    close(fd);
+}
