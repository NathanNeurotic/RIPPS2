 // The disc watcher's job is all the IO worker has: not worth the loading breath
+// ---- build 109: Settings > General > Save Settings To ----
+// Testers asked for the settings on the internal HDD before the memory cards. Internal HDD fills the Custom Settings
+// Path (config.path, which the load reads first and the save honours) with a RIPPS2 folder on that drive: the exFAT
+// HDD on BDM ATA, else the APA HDD's OPL partition (pfs:, OPL's own mounted home there).
+enum { RIPPS2_HOME_CARD = 0, RIPPS2_HOME_HDD, RIPPS2_HOME_CUSTOM };
+static const char *ripps2HomeNames[] = {N_("Memory Card"), N_("Internal HDD"), N_("Custom Path"), NULL};
+static const char *ripps2HomeHints[] = {N_("Settings go in RIPPS2's own save on a memory card (the one RIPPS2 started from first), as before."),
+                                        N_("Settings go in a RIPPS2 folder on the internal HDD (exFAT, or the APA HDD's OPL partition) and are read from there first."),
+                                        N_("Settings go in the folder typed below, e.g. mass0:/OPL."), NULL};
+
+// The exFAT HDD is named by its TYPE, ata0:/RIPPS2, never by its mass slot: a slot number is only the order the drives
+// came up in (a USB stick can take mass0), and an untyped massN: at boot walks every transport (USB, MX4SIO, then iLink
+// and ATA) before the HDD answers. ata0: loads the ATA stack alone and is found by its RIPPS2 folder, so the folder is
+// made here, before Save Changes looks for it.
+int ripps2SettingsHddHome(char *out, int size)
+{
+    char dir[24];
+    int i;
+    for (i = 0; i < 8; i++)
+        if (bdmSlotDeviceType(i) == BDM_TYPE_ATA) { // the internal exFAT HDD
+            snprintf(dir, sizeof(dir), "mass%d:/RIPPS2", i);
+            mkdir(dir, 0777); // there already after the first save
+            snprintf(out, size, "ata0:/RIPPS2");
+            return 1;
+        }
+    if (gHDDPrefix != NULL && gHDDPrefix[0] != '\0') { // the APA HDD, OPL's partition mounted
+        snprintf(out, size, "pfs:/RIPPS2");
+        return 1;
+    }
+    return 0;
+}
+
+// Which choice a Custom Settings Path amounts to
+static int ripps2SettingsHomeOf(const char *path)
+{
+    if (path == NULL || path[0] == '\0')
+        return RIPPS2_HOME_CARD;
+    if (!strcmp(path, "pfs:/RIPPS2") || !strcmp(path, "ata0:/RIPPS2"))
+        return RIPPS2_HOME_HDD;
+    // build 109's first spelling: still the internal HDD, written as ata0: on the next save
+    if (!strncmp(path, "mass", 4) && path[4] >= '0' && path[4] <= '9' && !strcmp(path + 5, ":/RIPPS2"))
+        return RIPPS2_HOME_HDD;
+    return RIPPS2_HOME_CUSTOM;
+}
+
+void ripps2SettingsHomeShow(struct UIItem *ui)
+{
+    int mode;
+    diaGetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, &mode);
+    diaSetVisible(ui, CFG_LBL_CUSTOMCFGPATH, mode == RIPPS2_HOME_CUSTOM);
+    diaSetVisible(ui, CFG_CUSTOMCFGPATH, mode == RIPPS2_HOME_CUSTOM);
+}
+
+void ripps2SettingsHomeBegin(struct UIItem *ui)
+{
+    diaSetEnum(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2HomeNames);
+    diaSetEnumHints(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2HomeHints);
+    diaSetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, ripps2SettingsHomeOf(gCustomSettingsPath));
+    ripps2SettingsHomeShow(ui);
+}
+
+// After the dialog read CFG_CUSTOMCFGPATH into gCustomSettingsPath: the choice decides what it holds
+void ripps2SettingsHomeEnd(struct UIItem *ui)
+{
+    char hdd[sizeof(gCustomSettingsPath)];
+    int mode = RIPPS2_HOME_CUSTOM;
+
+    diaGetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, &mode);
+    if (mode == RIPPS2_HOME_CARD)
+        gCustomSettingsPath[0] = '\0';
+    else if (mode == RIPPS2_HOME_HDD) {
+        if (ripps2SettingsHddHome(hdd, sizeof(hdd)))
+            snprintf(gCustomSettingsPath, sizeof(gCustomSettingsPath), "%s", hdd);
+        else if (ripps2SettingsHomeOf(gCustomSettingsPath) != RIPPS2_HOME_HDD)
+            guiShowToast(_t("NO INTERNAL HDD FOUND: SETTINGS STAY WHERE THEY ARE"));
+    } else if (ripps2SettingsHomeOf(gCustomSettingsPath) == RIPPS2_HOME_CARD) // Custom Path left blank: as before
+        diaSetInt(ui, UICFG_RIPPS2_SETTINGS_HOME, RIPPS2_HOME_CARD);
+}
+
