+// RIPPS2 build 106: a picture a list key names (<name>_<key>=file.png in the theme's folder); NULL when none
+static image_texture_t *thmListImage(const char *themePath, config_set_t *themeConfig, const char *name, const char *key)
+{
+    char prop[64];
+    const char *file = NULL;
+    snprintf(prop, sizeof(prop), "%s_%s", name, key);
+    if (!configGetStr(themeConfig, prop, &file) || file == NULL || file[0] == '\0')
+        return NULL;
+    return initImageTexture(themePath, themeConfig, name, file, 0);
+}
