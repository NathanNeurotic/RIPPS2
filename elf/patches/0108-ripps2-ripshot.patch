@@ -0,0 +1,47 @@
+#ifndef __RIPPS2SHOT_H
+#define __RIPPS2SHOT_H
+
+// RIPSHOT, screenshots from the in-game menu (build 108): RIPPS2's half. src/ripps2shot.c.
+
+extern int gRipps2Ripshot;        // Settings > General > In-Game Menu > RIPSHOT (ripps2_ripshot), on by default
+extern int gRipps2RipshotDevelop; // Develop Shots (ripps2_ripshot_develop): 0 Manual, 1 Auto
+
+// The game's title as a folder name: no \ / : * ? " < > |, no spaces or dots at the ends, out up to size - 1
+void ripps2ShotFolder(const char *title, const char *id, char *out, int size);
+
+// What a roll holds: its kept slots (a bit each), and how many of them wait for an ART or a MEDIA name.
+// hdr: RS_SLOTS slot headers
+void ripps2ShotCount(const void *hdr, int *kept, int *art, int *media);
+
+// Developing: n pixels at 16 bits (the GS's CT16) to at most 256 colours, no dither (median cut on the 15-bit colours,
+// refined once): idx a byte a pixel, pal 3 bytes a colour; returns the colours, 0 when out of memory
+int ripps2ShotQuantize(const unsigned short *px, int n, unsigned char *idx, unsigned char *pal);
+// The frame (w x h, a field frame line-doubled) boxed down to ow x oh, at 16 bits
+void ripps2ShotShrink(const unsigned short *src, int w, int h, int field, unsigned short *out, int ow, int oh);
+
+#ifndef RIPPS2_SHOT_HOST_TEST
