diff --git a/ee_core/include/ripshot.h b/ee_core/include/ripshot.h
new file mode 100644
index 0000000..2bf9750
--- /dev/null
+++ b/ee_core/include/ripshot.h
@@ -0,0 +1,62 @@
+/*
+  ripshot.h RIPSHOT, screenshots from the in-game menu (RIPPS2 build 108); see src/ripshot.c.
+*/
+
+#ifndef RIPSHOT_H
+#define RIPSHOT_H
+
+#include <tamtypes.h>
+
+// The frame the PCRTC shows, from the game's own PMODE, SMODE2, DISPFB and DISPLAY writes
+typedef struct
+{
+    u32 bp;    // BITBLTBUF base: FBP in 64-word blocks
+    u32 bw;    // buffer width in 64-pixel units
+    u32 psm;   // 0 CT32, 1 CT24, 2 CT16, 10 CT16S
+    u32 bpp;   // bytes per pixel
+    u32 x, y;  // the shown rectangle's corner in the buffer (DISPFB DBX, DBY)
+    u32 w, h;  // the shown size, in buffer pixels (h is one field's lines when field is set)
+    u32 field; // interlaced FRAME mode: the buffer holds one field, half the shown height
+} rs_frame_t;
+
+// regs: GSM's GSMSourceGSRegs (index 0 PMODE, 2 SMODE2, 7 DISPFB1, 8 DISPLAY1, 9 DISPFB2, 10 DISPLAY2).
+// Returns 0 when no frame was seen or its format cannot be read.
+int rsFrame(const u64 *regs, rs_frame_t *f);
+
+// Transfers move whole quadwords: a width rounded up to 16 pixels is one for every format
+#define RS_READ_W(w) (((w) + 15) & ~15u)
+
+// n pixels of one line in the frame's format to the roll's 16 bits (the GS's CT16: R low, then G, B, A set)
+void rsToRgb555(const u8 *src, u32 psm, u16 *dst, u32 n);
+
+#ifndef RIPSHOT_HOST_TEST
+// w x h pixels of the frame from (x, y) into buf (64-byte aligned, w * h * bpp bytes, a multiple of 16):
+// a GS local -> host transfer read through the VIF1 FIFO. The game must be paused with its DMA idle.
+// Returns 0 when the GS did not deliver (buf is then incomplete).
+int rsRead(void *buf, const rs_frame_t *f, u32 x, u32 y, u32 w, u32 h);
+
+// The roll (ripshot_io.h). rsLinkIop at an IOP reset, with ee_core's own SIF RPC live; the rest while paused.
+// The IOP's 8 KB buffer stages both ways: Stage lines into it then Write; Read then Fetch lines out of it.
+// Write / Read: roll offsets and sizes in whole 512-byte sectors. Stage / Fetch: buffer offsets and sizes in
+// multiples of 16, data 64-byte aligned.
+void rsLinkIop(void);
+u32 rsRollBytes(void);                                       // 0: no roll (or no link)
+int rsRollBegin(void);                                       // 1: the IOP buffer is ours until rsRollEnd
+int rsRollStage(u32 bufOff, const void *data, u32 size);     // 0, or < 0
+int rsRollWrite(u32 offset, u32 size);                       // size, or < 0
+int rsRollRead(u32 offset, u32 size);                        // size, or < 0
+int rsRollFetch(u32 bufOff, void *data, u32 size);           // size, or < 0
+void rsRollEnd(void);
+void rsHush(void); // the menu opened: the SPU2 silent and its voices held (ripshot_io.h RS_OP_HUSH)
+void rsWake(void); // RESUME: the sound goes on where it stopped
+
+// The frame's pixels from (x, y), w x h, to the roll at `at`, a line at a time through `line` (w * bpp bytes,
+// 64-byte aligned): the hold, before the panel covers them. Returns 0 when the GS or the drive failed.
+int rsHoldSave(const rs_frame_t *f, u32 x, u32 y, u32 w, u32 h, u8 *line, u32 at);
+#endif
+
+// Lines a staged write takes: as many as fit the IOP buffer while landing on whole 512-byte sectors (the last
+// write of a hold is padded up to a sector). lb: one line's bytes.
+u32 rsLinesPerWrite(u32 lb);
+
+#endif
