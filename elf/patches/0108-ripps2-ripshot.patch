+// RIPPS2 build 108: pattern=SCRn. A GameImage on SCRn shows the game's _SCR, _SCR2 .. _SCR9 in turn (scrShow, below)
+#define SCRN_MAX   9
+#define SCRN_BOXES 4 // SCRn boxes on one page that each show their own shot; more show their default
+
+// The theme's SCRn caches when an element already has them (every SCRn box shares one set)
+static image_cache_t **thmFindShotCaches(theme_elems_t *elems)
+{
+    for (theme_element_t *e = elems->first; e != NULL; e = e->next)
+        if (e->type == ELEM_TYPE_GAME_IMAGE && e->extended != NULL && ((mutable_image_t *)e->extended)->shots != NULL)
+            return ((mutable_image_t *)e->extended)->shots;
+    return NULL;
+}
+
+static image_cache_t **thmShotCaches(theme_t *theme, int count, int *linked)
+{
+    theme_elems_t *families[] = {&theme->mainElems, &theme->infoElems, &theme->appsMainElems, &theme->appsInfoElems,
+                                 &theme->favsMainElems, &theme->favsInfoElems, &theme->vcdMainElems, &theme->vcdInfoElems,
+                                 &theme->favsVcdMainElems, &theme->favsVcdInfoElems, &theme->favsAppsMainElems, &theme->favsAppsInfoElems};
+    image_cache_t **shots;
+    char suffix[16];
+    int i;
+
+    for (i = 0; i < (int)(sizeof(families) / sizeof(families[0])); i++)
+        if ((shots = thmFindShotCaches(families[i])) != NULL) {
+            *linked = 1;
+            return shots;
+        }
+    shots = (image_cache_t **)calloc(SCRN_MAX, sizeof(image_cache_t *));
+    if (shots == NULL)
+        return NULL;
+    for (i = 0; i < SCRN_MAX; i++) {
+        if (i == 0)
+            strcpy(suffix, "SCR");
+        else
+            snprintf(suffix, sizeof(suffix), "SCR%d", i + 1);
+        shots[i] = cacheInitCache(theme->gameCacheCount++, "ART", 1, suffix, count);
+        if (shots[i] == NULL) {
+            while (i-- > 0)
+                cacheDestroyCache(shots[i]);
+            free(shots);
+            return NULL;
+        }
+    }
+    *linked = 0;
+    return shots;
+}
