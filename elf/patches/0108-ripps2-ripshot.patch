+/*
+  ripps2shot.c RIPSHOT, screenshots from the in-game menu (build 108): RIPPS2's half
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  The plan is ps2-pillars docs/plans/ripshot.md; the roll's layout is modules/iopcore/common/ripshot_roll.h.
+  Here: the roll at launch (find the game's, else rename the drive's BLANK.ROLL to it, else make one), its handover
+  to CDVDMAN (BDM: its fragments as fragfile[1], the way the ISO's go), the names and counts the in-game menu
+  shows (ee_core's config), and the background job that keeps a blank roll on each started drive and turns rolls
+  with nothing kept back into blanks; developing (a kept shot to an 8-bit palette PNG: MEDIA at full size, ART at
+  250 x 188), by hand from Memory Files' roll pages or by itself in the background (Develop Shots: Auto).
+
+  RIPPS2_SHOT_HOST_TEST builds only the folder name, the slot count, the quantizer and the shrink, for elf/tests.
+*/
+
+#include <string.h>
+#include <stdlib.h>
+#include <tamtypes.h>
+#include "include/ripps2shot.h"
+#include "ripshot_roll.h"
+
+int gRipps2Ripshot = 1;
+int gRipps2RipshotDevelop = 0;
+
+void ripps2ShotFolder(const char *title, const char *id, char *out, int size)
+{
+    int n = 0, i;
+    const char *s = (title != NULL && title[0]) ? title : id;
+
+    if (size <= 0)
+        return;
+    for (i = 0; s != NULL && s[i] && n < size - 1; i++) {
+        unsigned char c = (unsigned char)s[i];
+        if (c < 0x20 || c > 0x7e || strchr("\\/:*?\"<>|", c) != NULL)
+            continue;
+        if (n == 0 && (c == ' ' || c == '.'))
+            continue;
+        out[n++] = c;
+    }
+    while (n > 0 && (out[n - 1] == ' ' || out[n - 1] == '.'))
+        n--;
+    out[n] = '\0';
+    if (n == 0 && s != id && id != NULL)
+        ripps2ShotFolder(id, NULL, out, size);
+}
+
+void ripps2ShotCount(const void *hdr, int *kept, int *art, int *media)
+{
+    const rs_slot_hdr_t *h = (const rs_slot_hdr_t *)hdr;
+    int i;
+
+    *kept = *art = *media = 0;
+    for (i = 0; i < RS_SLOTS; i++, h++) {
+        if (memcmp(h->magic, RS_SLOT_MAGIC, 8) != 0 || h->state != 1)
+            continue;
+        *kept |= 1 << i;
+        if (h->path & RS_PATH_ART)
+            (*art)++;
+        if (h->path & RS_PATH_MEDIA)
+            (*media)++;
+    }
+}
+
+// ---- developing (step 5), the half the host tests build too
+
+typedef struct
+{
+    u32 n;
+    u16 c, pad;
+} rs_cc_t;
+
+typedef struct
+{
+    int lo, hi, chan, range;
+    u32 pop;
+} rs_box_t;
+
+static int rsQChan;
+
+static int rsQCmp(const void *a, const void *b)
+{
+    int ca = (((const rs_cc_t *)a)->c >> (rsQChan * 5)) & 31, cb = (((const rs_cc_t *)b)->c >> (rsQChan * 5)) & 31;
+    return ca - cb;
+}
+
+static int rsX8(int v5) // 5 bits to 8
+{
+    return (v5 << 3) | (v5 >> 2);
+}
+
+static void rsBoxMeasure(const rs_cc_t *cc, rs_box_t *b)
+{
+    int lo[3] = {31, 31, 31}, hi[3] = {0, 0, 0}, i, k;
+
+    b->pop = 0;
+    for (i = b->lo; i < b->hi; i++) {
+        b->pop += cc[i].n;
+        for (k = 0; k < 3; k++) {
+            int v = (cc[i].c >> (k * 5)) & 31;
+            lo[k] = v < lo[k] ? v : lo[k];
+            hi[k] = v > hi[k] ? v : hi[k];
+        }
+    }
+    b->range = -1;
+    for (k = 0; k < 3; k++)
+        if (hi[k] - lo[k] > b->range) {
+            b->range = hi[k] - lo[k];
+            b->chan = k;
+        }
+}
+
+static int rsNearest(const u8 *pal, int nb, int r, int g, int b)
+{
+    int k, best = 0, bd = 0x7fffffff;
+
+    for (k = 0; k < nb; k++) {
+        int dr = r - pal[k * 3], dg = g - pal[k * 3 + 1], db = b - pal[k * 3 + 2];
+        int d = dr * dr * 3 + dg * dg * 4 + db * db * 2; // green counts most to the eye
+        if (d < bd) {
+            bd = d;
+            best = k;
+        }
+    }
+    return best;
+}
+
+// sum, cnt and box are static: 9 KB the IO worker's stack need not hold (one quantize at a time: the roll pages hold
+// the IO worker while they develop)
+static u32 rsQSum[256][3], rsQCnt[256];
+static rs_box_t rsQBox[256];
+
+int ripps2ShotQuantize(const u16 *px, int n, u8 *idx, u8 *pal)
+{
+    u32 *hist = calloc(32768, sizeof(u32)), (*sum)[3] = rsQSum, *cnt = rsQCnt;
+    u8 *map = malloc(32768);
+    rs_cc_t *cc = malloc(32768 * sizeof(rs_cc_t));
+    rs_box_t *box = rsQBox;
+    int k = 0, nb, i, b, c;
+
+    if (hist == NULL || map == NULL || cc == NULL) {
+        free(hist);
+        free(map);
+        free(cc);
+        return 0;
+    }
+    for (i = 0; i < n; i++)
+        hist[px[i] & 0x7fff]++;
+    for (i = 0; i < 32768; i++)
+        if (hist[i]) {
+            cc[k].c = i;
+            cc[k].n = hist[i];
+            k++;
+        }
+    if (k <= 256) { // every colour as it is
+        for (i = 0; i < k; i++) {
+            for (c = 0; c < 3; c++)
+                pal[i * 3 + c] = rsX8((cc[i].c >> (c * 5)) & 31);
+            map[cc[i].c] = i;
+        }
+        nb = k;
+    } else { // median cut: the box with the most pixels times the widest spread, halved by pixels along it
+        box[0].lo = 0;
+        box[0].hi = k;
+        rsBoxMeasure(cc, &box[0]);
+        nb = 1;
+        while (nb < 256) {
+            u32 best = 0, acc = 0;
+            int m;
+            for (b = -1, i = 0; i < nb; i++)
+                if (box[i].range > 0 && (u32)box[i].range * box[i].pop >= best) {
+                    best = (u32)box[i].range * box[i].pop;
+                    b = i;
+                }
+            if (b < 0)
+                break;
+            rsQChan = box[b].chan;
+            qsort(cc + box[b].lo, box[b].hi - box[b].lo, sizeof(rs_cc_t), rsQCmp);
+            for (m = box[b].lo; m < box[b].hi - 2; m++) {
+                acc += cc[m].n;
+                if (acc * 2 >= box[b].pop)
+                    break;
+            }
+            m++; // the upper half's first colour: both halves keep at least one
+            box[nb].lo = m;
+            box[nb].hi = box[b].hi;
+            box[b].hi = m;
+            rsBoxMeasure(cc, &box[b]);
+            rsBoxMeasure(cc, &box[nb]);
+            nb++;
+        }
+        for (b = 0; b < nb; b++) { // each box's colour: its pixels' average
+            memset(sum[b], 0, sizeof(sum[b]));
+            for (i = box[b].lo; i < box[b].hi; i++)
+                for (c = 0; c < 3; c++)
+                    sum[b][c] += rsX8((cc[i].c >> (c * 5)) & 31) * cc[i].n;
+            for (c = 0; c < 3; c++)
+                pal[b * 3 + c] = (sum[b][c] + box[b].pop / 2) / box[b].pop;
+        }
+        // refined once: every colour to its nearest, the averages again; then the map
+        memset(rsQSum, 0, sizeof(rsQSum));
+        memset(rsQCnt, 0, sizeof(rsQCnt));
+        for (i = 0; i < k; i++) {
+            int r = rsX8(cc[i].c & 31), g = rsX8((cc[i].c >> 5) & 31), bl = rsX8((cc[i].c >> 10) & 31);
+            int p = rsNearest(pal, nb, r, g, bl);
+            sum[p][0] += r * cc[i].n;
+            sum[p][1] += g * cc[i].n;
+            sum[p][2] += bl * cc[i].n;
+            cnt[p] += cc[i].n;
+        }
+        for (b = 0; b < nb; b++)
+            if (cnt[b])
+                for (c = 0; c < 3; c++)
+                    pal[b * 3 + c] = (sum[b][c] + cnt[b] / 2) / cnt[b];
+        for (i = 0; i < k; i++)
+            map[cc[i].c] = rsNearest(pal, nb, rsX8(cc[i].c & 31), rsX8((cc[i].c >> 5) & 31), rsX8((cc[i].c >> 10) & 31));
+    }
+    for (i = 0; i < n; i++)
+        idx[i] = map[px[i] & 0x7fff];
+    free(hist);
+    free(map);
+    free(cc);
+    return nb;
+}
+
+void ripps2ShotShrink(const u16 *src, int w, int h, int field, u16 *out, int ow, int oh)
+{
+    int hd = field ? h * 2 : h, ox, oy, x, y;
+
+    for (oy = 0; oy < oh; oy++) {
+        int y0 = oy * hd / oh, y1 = (oy + 1) * hd / oh;
+        if (y1 <= y0)
+            y1 = y0 + 1;
+        for (ox = 0; ox < ow; ox++) {
+            int x0 = ox * w / ow, x1 = (ox + 1) * w / ow;
+            u32 s[3] = {0, 0, 0}, n = 0;
+            if (x1 <= x0)
+                x1 = x0 + 1;
+            for (y = y0; y < y1; y++) {
+                const u16 *row = src + (field ? y / 2 : y) * w;
+                for (x = x0; x < x1; x++, n++) {
+                    s[0] += row[x] & 31;
+                    s[1] += (row[x] >> 5) & 31;
+                    s[2] += (row[x] >> 10) & 31;
+                }
+            }
+            out[oy * ow + ox] = ((s[0] + n / 2) / n) | ((s[1] + n / 2) / n) << 5 | ((s[2] + n / 2) / n) << 10 | 0x8000;
+        }
+    }
+}
