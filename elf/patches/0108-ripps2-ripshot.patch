+// One page's frame: heading left, a count right, rows (left text, right text), the cursor, a toast and the hints
+static void rpDraw(const char *head, const char *right, const char *const *left, const char *const *rtext, int count, int cursor,
+                   int top, const char *toast, const char *okWord, const char *triWord)
+{
+    int i, hx = 44;
+
+    rmStartFrame();
+    guiDrawBGPlasma();
+    fntRenderString(gTheme->fonts[4], RP_X, 30, ALIGN_VCENTER, 0, 0, head, RP_LIT);
+    fntRenderString(gTheme->fonts[4], RP_RIGHT - fntCalcDimensions(gTheme->fonts[4], right), 30, ALIGN_VCENTER, 0, 0, right, RP_SOFT);
+    rmDrawLine(RP_X, 46, RP_RIGHT, 46, RP_PRIM(0x4A, 0x72, 0xDC, 0x60));
+    for (i = 0; i < RP_ROWS && top + i < count; i++) {
+        int y = RP_Y + i * RP_ROW_H, cur = top + i == cursor;
+        if (cur) {
+            rmDrawRect(RP_X - 6, y - 1, RP_RIGHT - RP_X + 12, RP_ROW_H - 2, RP_PRIM(0x1E, 0x3C, 0x96, 0x58));
+            rmDrawRect(RP_X - 6, y - 1, 3, RP_ROW_H - 2, RP_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+        }
+        fntRenderString(gTheme->fonts[8], RP_X + 6, y + 9, ALIGN_VCENTER, 420, 0, left[top + i], cur ? RP_LIT : RP_SOFT);
+        fntRenderString(gTheme->fonts[5], RP_RIGHT - fntCalcDimensions(gTheme->fonts[5], rtext[top + i]), y + 9, ALIGN_VCENTER, 0, 0,
+                        rtext[top + i], RP_DIM);
+    }
+    if (count == 0)
+        fntRenderString(gTheme->fonts[4], 320, 200, ALIGN_CENTER, 0, 0, _t("NO SHOTS WAITING"), RP_DIM);
+    if (toast != NULL && toast[0])
+        fntRenderString(gTheme->fonts[5], RP_RIGHT - fntCalcDimensions(gTheme->fonts[5], toast), 432, ALIGN_VCENTER, 0, 0, toast, RP_SOFT);
+    if (count > 0) {
+        rpHint(rpOkIcon(), okWord, &hx, 448);
+        rpHint(TRIANGLE_ICON, triWord, &hx, 448);
+    }
+    rpHint(rpBackIcon(), _t("BACK"), &hx, 448);
+    rmEndFrame();
+}
