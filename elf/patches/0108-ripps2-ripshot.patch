+static void rpMove(int *cursor, int *top, int count)
+{
+    if (getKey(KEY_UP) && *cursor > 0) {
+        (*cursor)--;
+        sfxPlay(SFX_CURSOR);
+    } else if (getKey(KEY_DOWN) && *cursor < count - 1) {
+        (*cursor)++;
+        sfxPlay(SFX_CURSOR);
+    }
+    if (*cursor >= count)
+        *cursor = count - 1;
+    if (*cursor < 0)
+        *cursor = 0;
+    if (*cursor < *top)
+        *top = *cursor;
+    if (*cursor >= *top + RP_ROWS)
+        *top = *cursor - RP_ROWS + 1;
+}
+
+// Develop slots (mask) of a roll, with the count on screen; the roll goes when it is empty. Returns shots saved.
+static int rpDevelop(const char *dir, const char *file, int mask, int *failed)
+{
+    char roll[192], root[16], prefix[64], msg[64];
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int i, n = rsCount(mask), done = 0, saved = 0;
+
+    snprintf(roll, sizeof(roll), "%s%s", dir, file);
+    rsRootOf(dir, root, sizeof(root), prefix, sizeof(prefix));
+    *failed = 0;
+    ioBlockOps(1); // nothing else reads the roll meanwhile (the background job)
+    for (i = 0; i < RS_SLOTS; i++)
+        if (mask & (1 << i)) {
+            snprintf(msg, sizeof(msg), _t("DEVELOPING %d OF %d"), ++done, n);
+            guiRenderTextScreen(msg);
+            if (rsDevelopSlot(roll, i, root, prefix))
+                saved++;
+            else
+                (*failed)++;
+        }
+    if (rsRollKept(roll, hdr) == 0)
+        rsRecycle(dir, roll);
+    ioBlockOps(0);
+    return saved;
+}
+
+static void rpSavedToast(char *toast, int size, int saved, int failed)
+{
+    if (failed)
+        snprintf(toast, size, _t("%d NOT SAVED: DRIVE FULL"), failed);
+    else if (saved == 1)
+        snprintf(toast, size, "%s", _t("1 SHOT SAVED"));
+    else
+        snprintf(toast, size, _t("%d SHOTS SAVED"), saved);
+}
+
+// The shot full screen, straight from the roll (a 16-bit texture): 1 when it asks for ACTIONS
+static int rpView(const char *roll, int slot)
+{
+    rs_slot_hdr_t h;
+    GSTEXTURE tex;
+    u16 *px = NULL;
+    int fd = open(roll, O_RDONLY), r = 0, hx;
+
+    if (fd < 0)
+        return 0;
+    if (!rsSlotHeader(fd, slot, &h) || (px = rsSlotPixels(fd, slot, &h)) == NULL) {
+        close(fd);
+        return 0;
+    }
+    close(fd);
+    memset(&tex, 0, sizeof(tex));
+    tex.Width = h.w;
+    tex.Height = h.h;
+    tex.PSM = GS_PSM_CT16;
+    tex.Mem = (u32 *)px;
+    tex.Filter = GS_FILTER_LINEAR;
+    float shown = h.field ? h.h * 2.0f : (float)h.h, fitH = 420.0f, fitW = fitH * h.w / shown, squeeze = rmWideScale(1000) / 1000.0f;
+    if (fitW * squeeze > 600.0f) {
+        fitW = 600.0f / squeeze;
+        fitH = fitW * shown / h.w;
+    }
+    for (;;) {
+        readPads();
+        rmStartFrame();
+        rmDrawRect(0, 0, 640, 480, RP_PRIM(0x02, 0x03, 0x0A, 0x80));
+        rmDrawPixmap(&tex, (int)(320 - fitW * squeeze / 2), (int)(232 - fitH / 2), ALIGN_NONE, (int)(fitW * squeeze), (int)fitH,
+                     SCALING_NONE, RP_LIT, 0);
+        hx = 44;
+        rpHint(TRIANGLE_ICON, _t("ACTIONS"), &hx, 458);
+        rpHint(rpBackIcon(), _t("BACK"), &hx, 458);
+        rmEndFrame();
+        if (getKeyOn(KEY_TRIANGLE)) {
+            r = 1;
+            break;
+        }
+        if (getKeyOn(rpBackKey())) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+    }
+    texFree(&tex); // the pixels go with it
+    readPads();
+    return r;
+}
+
+// ACTIONS: DEVELOP, DEVELOP ALL, DELETE; -1 for back
+static int rpActions(void)
+{
+    const char *items[3] = {_t("DEVELOP"), _t("DEVELOP ALL"), _t("DELETE")};
+    int sel = 0, i, hx;
+
+    for (;;) {
+        readPads();
+        rmStartFrame();
+        guiDrawBGPlasma();
+        fntRenderString(gTheme->fonts[4], RP_X, 30, ALIGN_VCENTER, 0, 0, _t("ACTIONS"), RP_LIT);
+        rmDrawLine(RP_X, 46, RP_RIGHT, 46, RP_PRIM(0x4A, 0x72, 0xDC, 0x60));
+        for (i = 0; i < 3; i++) {
+            int y = RP_Y + i * RP_ROW_H;
+            if (i == sel) {
+                rmDrawRect(RP_X - 6, y - 1, RP_RIGHT - RP_X + 12, RP_ROW_H - 2, RP_PRIM(0x1E, 0x3C, 0x96, 0x58));
+                rmDrawRect(RP_X - 6, y - 1, 3, RP_ROW_H - 2, RP_PRIM(0x6A, 0x9A, 0xFF, 0x80));
+            }
+            fntRenderString(gTheme->fonts[8], RP_X + 6, y + 9, ALIGN_VCENTER, 420, 0, items[i], i == sel ? RP_LIT : RP_SOFT);
+        }
+        hx = 44;
+        rpHint(rpOkIcon(), _t("SELECT"), &hx, 448);
+        rpHint(rpBackIcon(), _t("BACK"), &hx, 448);
+        rmEndFrame();
+        if (getKey(KEY_UP) && sel > 0) {
+            sel--;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKey(KEY_DOWN) && sel < 2) {
+            sel++;
+            sfxPlay(SFX_CURSOR);
+        } else if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            readPads();
+            return sel;
+        } else if (getKeyOn(rpBackKey())) {
+            sfxPlay(SFX_CANCEL);
+            readPads();
+            return -1;
+        }
+    }
+}
+
+// Inside a roll: SHOT 1.. with where each goes. Returns when it is left (or its last shot went)
+static void rpRoll(const char *dir, rs_roll_t *r, char *toast, int tsize)
+{
+    static const char *const where[4] = {"", N_("ART"), N_("MEDIA"), N_("BOTH")};
+    char roll[192], names[RS_SLOTS][16], right[24];
+    const char *left[RS_SLOTS], *rtext[RS_SLOTS];
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int slots[RS_SLOTS], count, cursor = 0, top = 0, i, failed;
+
+    snprintf(roll, sizeof(roll), "%s%s", dir, r->file);
+    for (;;) {
+        r->kept = rsRollKept(roll, hdr);
+        for (count = 0, i = 0; i < RS_SLOTS; i++)
+            if (r->kept & (1 << i)) {
+                snprintf(names[count], sizeof(names[count]), _t("SHOT %d"), count + 1);
+                left[count] = names[count];
+                rtext[count] = _t(where[hdr[i].path & 3]);
+                slots[count++] = i;
+            }
+        if (count == 0)
+            return;
+        snprintf(right, sizeof(right), _t("%d OF 6"), count);
+        readPads();
+        rpMove(&cursor, &top, count);
+        rpDraw(r->title, right, left, rtext, count, cursor, top, toast, _t("VIEW"), _t("ACTIONS"));
+        int act = -2;
+        if (getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            act = rpView(roll, slots[cursor]) ? -3 : -2;
+        } else if (getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CONFIRM);
+            act = -3;
+        } else if (getKeyOn(rpBackKey())) {
+            sfxPlay(SFX_CANCEL);
+            return;
+        }
+        if (act == -3) {
+            act = rpActions();
+            if (act == 0 || act == 1) {
+                int saved = rpDevelop(dir, r->file, act == 0 ? 1 << slots[cursor] : r->kept, &failed);
+                rpSavedToast(toast, tsize, saved, failed);
+                sfxPlay(failed ? SFX_ERROR : SFX_SAVE);
+            } else if (act == 2) {
+                guiMsgBoxSound(SFX_MESSAGE);
+                if (guiMsgBox(_t("Delete this shot?"), 1, NULL) == 1) {
+                    int fd;
+                    ioBlockOps(1);
+                    if ((fd = open(roll, O_RDWR)) >= 0) {
+                        rsEmptySlot(fd, slots[cursor]);
+                        close(fd);
+                    }
+                    if (rsRollKept(roll, hdr) == 0)
+                        rsRecycle(dir, roll);
+                    ioBlockOps(0);
+                    snprintf(toast, tsize, "%s", _t("DELETED"));
+                    sfxPlay(SFX_SAVE);
+                }
+            }
+        }
+    }
+}
+
+void ripps2ShotRolls(const char *dir)
+{
+    rs_roll_t *rolls = NULL;
+    char toast[64] = "", right[24], (*counts)[16] = NULL;
+    const char **left = NULL, **rtext = NULL;
+    int count, cursor = 0, top = 0, i, failed, reread = 1;
+
+    for (;;) {
+        if (reread) {
+            free(rolls);
+            free(left);
+            free(rtext);
+            free(counts);
+            count = rsListRolls(dir, &rolls);
+            left = malloc((count + 1) * sizeof(char *));
+            rtext = malloc((count + 1) * sizeof(char *));
+            counts = malloc((count + 1) * 16);
+            if (left == NULL || rtext == NULL || counts == NULL)
+                count = 0;
+            for (i = 0; i < count; i++) {
+                int n = rsCount(rolls[i].kept);
+                if (n == 1)
+                    snprintf(counts[i], 16, "%s", _t("1 SHOT"));
+                else
+                    snprintf(counts[i], 16, _t("%d SHOTS"), n);
+                left[i] = rolls[i].title;
+                rtext[i] = counts[i];
+            }
+            reread = 0;
+        }
+        if (count == 1)
+            snprintf(right, sizeof(right), "%s", _t("1 ROLL"));
+        else
+            snprintf(right, sizeof(right), _t("%d ROLLS"), count);
+        readPads();
+        rpMove(&cursor, &top, count);
+        rpDraw("RIPSHOT", right, left, rtext, count, cursor, top, toast, _t("OPEN"), _t("DEVELOP"));
+        if (count > 0 && getKeyOn(gSelectButton)) {
+            sfxPlay(SFX_CONFIRM);
+            rpRoll(dir, &rolls[cursor], toast, sizeof(toast));
+            reread = 1;
+        } else if (count > 0 && getKeyOn(KEY_TRIANGLE)) {
+            sfxPlay(SFX_CONFIRM);
+            int saved = rpDevelop(dir, rolls[cursor].file, rolls[cursor].kept, &failed);
+            rpSavedToast(toast, sizeof(toast), saved, failed);
+            sfxPlay(failed ? SFX_ERROR : SFX_SAVE);
+            reread = 1;
+        } else if (getKeyOn(rpBackKey())) {
+            sfxPlay(SFX_CANCEL);
+            break;
+        }
+    }
+    free(rolls);
+    free(left);
+    free(rtext);
+    free(counts);
+    readPads();
+}
