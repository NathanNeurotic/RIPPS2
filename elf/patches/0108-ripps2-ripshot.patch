diff --git a/modules/iopcore/common/ripshot_io.h b/modules/iopcore/common/ripshot_io.h
new file mode 100644
index 0000000..c0eca1f
--- /dev/null
+++ b/modules/iopcore/common/ripshot_io.h
@@ -0,0 +1,54 @@
+/*
+  ripshot_io.h RIPSHOT's roll I/O between ee_core and CDVDMAN (RIPPS2 build 108)
+
+  While the game is paused under the in-game menu, ee_core cannot use SIF RPC: the game owns the SIF command
+  table, so a reply would land in the game's handlers. So the roll is read and written over plain SIF DMA:
+
+  - At every IOP reset ee_core still drives the SIF (iopmgr.c ResetIopSpecial), and there it calls the IGR RPC
+    (0x80000598) once with RIPSHOT_RPC_FNO and the EE address of its rs_ack_t. CDVDMAN starts a small thread and
+    answers with the IOP address of its rs_req_t.
+  - In the menu, ee_core DMAs a request into that rs_req_t. The IOP buffer RS_OP_BEGIN returns is the staging
+    area both ways, so the EE never needs more than a line of its own: it DMAs lines into the buffer and asks for
+    a WRITE, or asks for a READ and then SENDs lines back out of it. The thread sees seq move, does it (a SEND
+    DMAs to ee_data), then DMAs its rs_ack_t.
+  - The same thread silences the SPU2 while the in-game menu is open (RS_OP_HUSH / RS_OP_WAKE), so ee_core links
+    the mailbox for every game CDVDMAN serves with In-Game Menu on, not only for RIPSHOT.
+  - seq is each struct's LAST word: a SIF DMA writes in address order, so a new seq means the rest has landed.
+
+  WRITE and READ: offset and size in bytes of the roll, whole sectors of its drive, at most RIPSHOT_IOP_BUF.
+  SEND: offset and size in the buffer, multiples of 16 (a SIF DMA moves quadwords).
+*/
+
+#ifndef RIPSHOT_IO_H
+#define RIPSHOT_IO_H
+
+#define RIPSHOT_RPC_FNO   2
+#define CDSC_RIPSHOT_INIT 0xFFFFFFEE // param: the EE address of rs_ack_t; returns the IOP address of rs_req_t
+#define RIPSHOT_IOP_BUF   8192
+
+enum {
+    RS_OP_BEGIN = 1, // take the IOP buffer (result: its address in iop_buf), poll quickly until END
+    RS_OP_WRITE,     // the buffer's first size bytes to the roll at offset
+    RS_OP_READ,      // size bytes of the roll at offset into the buffer
+    RS_OP_SEND,      // size bytes of the buffer from offset to ee_data
+    RS_OP_END,       // give the buffer back
+    RS_OP_HUSH,      // the menu opened: the SPU2's master volumes to 0 and every voice held (pitch 0), all saved
+    RS_OP_WAKE,      // RESUME: the voices' pitches back (where the game did not set a new one), then the volumes
+};
+
+typedef struct
+{
+    u32 op, offset, size, ee_data;
+    u32 pad[3];
+    u32 seq;
+} __attribute__((aligned(16))) rs_req_t;
+
+typedef struct
+{
+    u32 iop_buf;    // RS_OP_BEGIN's buffer, 0 when none
+    u32 roll_bytes; // the roll's size, 0 when this launch has none
+    s32 result;     // bytes moved, or < 0
+    u32 seq;        // the request answered
+} __attribute__((aligned(16))) rs_ack_t;
+
+#endif
diff --git a/modules/iopcore/common/ripshot_roll.h b/modules/iopcore/common/ripshot_roll.h
new file mode 100644
index 0000000..bf9a9b5
--- /dev/null
+++ b/modules/iopcore/common/ripshot_roll.h
@@ -0,0 +1,71 @@
+/*
+  ripshot_roll.h RIPSHOT's roll on the drive (RIPPS2 build 108): RIPPS2 makes and develops rolls, ee_core fills them
+
+  One file a game, <drive top>MEDIA/RIPSHOT/<ID>.ROLL, and one blank a drive, BLANK.ROLL, renamed to a game's at
+  its launch. Every piece starts on a 4 KB boundary, so a drive with 4 KB sectors can take it too:
+
+    0                 the roll's header (rs_roll_hdr_t, the rest zero)
+    RS_SLOT_AT(i)     6 slots: a header (rs_slot_hdr_t), then the frame at 16 bits (GS CT16), up to 640 x 512
+    RS_HOLD_AT        the hold: the frame's pixels under the panel (up to 320 x 256 at 32 bits), then under the
+                      KEEP strip (up to 320 x 32 at 32 bits), in the frame's own format so they go back exactly
+
+  A blank roll's slot headers are written as zeros, so clusters a deleted roll left behind never read as shots.
+*/
+
+#ifndef RIPSHOT_ROLL_H
+#define RIPSHOT_ROLL_H
+
+#include <tamtypes.h>
+
+#define RS_ROLL_MAGIC  "RIPROLL1"
+#define RS_SLOT_MAGIC  "RIPSHOT1"
+#define RS_SLOTS       6
+#define RS_PIECE       4096
+#define RS_FRAME_W     640
+#define RS_FRAME_H     512
+#define RS_SLOT_BYTES  (RS_PIECE + RS_FRAME_W * RS_FRAME_H * 2)
+#define RS_SLOT_AT(i)  (RS_PIECE + (i) * RS_SLOT_BYTES)
+#define RS_HOLD_AT     RS_SLOT_AT(RS_SLOTS)
+#define RS_HOLD_PANEL  327680 // 320 x 256 x 4 (the panel is 320 x 252 at scale 2)
+#define RS_HOLD_STRIP  40960  // 320 x 32 x 4 (the KEEP strip)
+#define RS_STRIP_AT    (RS_HOLD_AT + RS_HOLD_PANEL)
+#define RS_ROLL_BYTES  (RS_STRIP_AT + RS_HOLD_STRIP)
+#define RS_ROLLS_MAX   2000 // a drive's rolls at most: the year the PS2 came out (the user, 10/19-20)
+
+// ee_core's config->Ripshot (coreconfig.h)
+#define RIPSHOT_OFF        0 // RIPSHOT or the in-game menu is off: no SCREENSHOT item
+#define RIPSHOT_READY      1 // the launch handed CDVDMAN a roll
+#define RIPSHOT_DRIVE_FULL 2 // no blank roll and no room for one, or RS_ROLLS_MAX rolls
+#define RIPSHOT_NOT_HERE   3 // a source RIPSHOT cannot write to
+
+enum {
+    RS_PATH_ART = 1,
+    RS_PATH_MEDIA = 2,
+    RS_PATH_BOTH = 3,
+};
+
+typedef struct
+{
+    char magic[8];  // RS_ROLL_MAGIC
+    u32 version;    // 1
+    u32 bytes;      // RS_ROLL_BYTES
+    char id[16];    // the game's ID; empty on BLANK.ROLL
+    char title[32]; // the game's title as the launch had it
+} rs_roll_hdr_t;    // 64 bytes
+
+typedef struct
+{
+    char magic[8];  // RS_SLOT_MAGIC
+    u32 state;      // 1 kept; anything else is an empty slot
+    u32 path;       // RS_PATH_*
+    char id[16];
+    char title[32];
+    char art[32];   // the ART name the menu showed ("SLUS_209.46_SCR3.PNG")
+    char media[32]; // the MEDIA name ("SHOT 03.PNG")
+    u16 w, h;       // the stored frame's size (h is one field's lines when field is set)
+    u8 psm;         // the frame's GS format when it was taken
+    u8 field;       // interlaced FRAME mode: line-double when developing
+    u8 pad[2];
+} rs_slot_hdr_t;    // 136 bytes
+
+#endif
