+
+static u8 rsPiece[RS_PIECE] __attribute__((aligned(64))); // a roll's header, or a zero slot header
+
+static struct
+{
+    int armed, state, kept, scr, shot;
+    char drive[8], title[32];
+} rsLaunch;
+
+static int rsExists(const char *path)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+// A file's size on the drive, -1 when it is not there
+static int rsSize(const char *path)
+{
+    int fd = open(path, O_RDONLY), size;
+    if (fd < 0)
+        return -1;
+    size = lseek(fd, 0, SEEK_END);
+    close(fd);
+    return size;
+}
+
+// A developed shot's name is taken by a file with something in it; an empty one (a write that failed) is written over
+static int rsTaken(const char *path)
+{
+    return rsSize(path) > 0;
+}
+
+// The roll's header piece at 0: magic, size, and whose it is (an empty id on BLANK.ROLL)
+static int rsStamp(int fd, const char *id, const char *title)
+{
+    rs_roll_hdr_t *h = (rs_roll_hdr_t *)rsPiece;
+
+    memset(rsPiece, 0, sizeof(rsPiece));
+    memcpy(h->magic, RS_ROLL_MAGIC, 8);
+    h->version = 1;
+    h->bytes = RS_ROLL_BYTES;
+    if (id != NULL)
+        strncpy(h->id, id, sizeof(h->id) - 1);
+    if (title != NULL)
+        strncpy(h->title, title, sizeof(h->title) - 1);
+    return lseek(fd, 0, SEEK_SET) == 0 && write(fd, rsPiece, RS_PIECE) == RS_PIECE;
+}
+
+// A blank roll at path: its header, six zero slot headers, and room for all of it (a seek past the end and one byte,
+// so the clusters are taken without writing 4 MB). 0 when the drive had no room.
+static int rsMake(const char *root, const char *path)
+{
+    char dir[160];
+    int fd, i, ok;
+
+    snprintf(dir, sizeof(dir), "%sMEDIA", root);
+    mkdir(dir, 0777);
+    snprintf(dir, sizeof(dir), "%sMEDIA/RIPSHOT", root);
+    mkdir(dir, 0777);
+    ripps2WriteReadme(root, 1); // MEDIA's README.txt says what RIPSHOT is
+    fd = open(path, O_RDWR | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0)
+        return 0;
+    ok = rsStamp(fd, NULL, NULL);
+    memset(rsPiece, 0, sizeof(rsPiece));
+    for (i = 0; ok && i < RS_SLOTS; i++)
+        ok = lseek(fd, RS_SLOT_AT(i), SEEK_SET) == RS_SLOT_AT(i) && write(fd, rsPiece, RS_PIECE) == RS_PIECE;
+    if (ok)
+        ok = lseek(fd, RS_ROLL_BYTES - 1, SEEK_SET) == RS_ROLL_BYTES - 1 && write(fd, rsPiece, 1) == 1;
+    close(fd);
+    if (!ok)
+        remove(path);
+    return ok;
+}
+
+static void rsSlots(int fd, rs_slot_hdr_t *h)
+{
+    int i;
+    for (i = 0; i < RS_SLOTS; i++)
+        if (lseek(fd, RS_SLOT_AT(i), SEEK_SET) != RS_SLOT_AT(i) || read(fd, &h[i], sizeof(h[i])) != (int)sizeof(h[i]))
+            memset(&h[i], 0, sizeof(h[i]));
+}
+
+static int rsIsRoll(const char *name, int withBlank)
+{
+    int n = strlen(name);
+    if (n < 6 || strcasecmp(name + n - 5, ".ROLL") != 0)
+        return 0;
+    return withBlank || strcasecmp(name, "BLANK.ROLL") != 0;
+}
+
+// A drive's game rolls, counted up to the cap
+static int rsCountRolls(const char *dir)
+{
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    int n = 0;
+
+    if (d == NULL)
+        return 0;
+    while (n < RS_ROLLS_MAX && (e = readdir(d)) != NULL)
+        if (rsIsRoll(e->d_name, 0))
+            n++;
+    closedir(d);
+    return n;
+}
+
+// The first free ART number for a game: 1 is plain _SCR, then _SCR2, _SCR3...
+static int rsFirstScr(const char *prefix, const char *id)
+{
+    char path[192];
+    int n;
+    for (n = 1; n < 100; n++) {
+        if (n == 1)
+            snprintf(path, sizeof(path), "%sART/%s_SCR.png", prefix, id);
+        else
+            snprintf(path, sizeof(path), "%sART/%s_SCR%d.png", prefix, id, n);
+        if (!rsTaken(path))
+            break;
+    }
+    return n;
+}
+
+static int rsFirstShot(const char *root, const char *folder)
+{
+    char path[192];
+    int n;
+    for (n = 1; n < 100; n++) {
+        snprintf(path, sizeof(path), "%sMEDIA/%s/SHOT %02d.png", root, folder, n);
+        if (!rsTaken(path))
+            break;
+    }
+    return n;
+}
+
+void ripps2ShotPrepareBdm(struct cdvdman_settings_bdm *settings, unsigned char *fragCount, const char *root,
+                          const char *prefix, const char *id, const char *title)
+{
+    char dir[160], path[192], blank[192];
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int fd, n, kept, art, media, slot, i;
+
+    memset(&rsLaunch, 0, sizeof(rsLaunch));
+    rsLaunch.armed = 1;
+    rsLaunch.state = RIPSHOT_OFF;
+    if (!gRipps2IgrMenu || !gRipps2Ripshot)
+        return;
+    rsLaunch.state = RIPSHOT_NOT_HERE;
+    slot = (!strncmp(root, "mass", 4) && isdigit((unsigned char)root[4])) ? root[4] - '0' : -1;
+    snprintf(rsLaunch.drive, sizeof(rsLaunch.drive), "%s", slot >= 0 ? bdmSlotDriveName(slot) : "USB");
+    for (i = 0; rsLaunch.drive[i]; i++)
+        rsLaunch.drive[i] = toupper((unsigned char)rsLaunch.drive[i]);
+    ripps2ShotFolder(title, id, rsLaunch.title, sizeof(rsLaunch.title));
+
+    snprintf(dir, sizeof(dir), "%sMEDIA/RIPSHOT", root);
+    snprintf(path, sizeof(path), "%s/%s.ROLL", dir, id);
+    if (!rsExists(path)) {
+        snprintf(blank, sizeof(blank), "%s/BLANK.ROLL", dir);
+        rsLaunch.state = RIPSHOT_DRIVE_FULL;
+        if (rsCountRolls(dir) >= RS_ROLLS_MAX)
+            return;
+        if (!(rsExists(blank) && rename(blank, path) == 0) && !rsMake(root, path))
+            return; // no blank yet and no room for a roll
+        fd = open(path, O_RDWR);
+        if (fd < 0)
+            return;
+        rsStamp(fd, id, title);
+        close(fd);
+    }
+
+    fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return;
+    if (lseek(fd, 0, SEEK_END) < RS_ROLL_BYTES) { // a roll cut short (or an older layout): never hand over less
+        rsSlots(fd, hdr);
+        close(fd);
+        ripps2ShotCount(hdr, &kept, &art, &media);
+        rsLaunch.state = RIPSHOT_DRIVE_FULL;
+        if (kept || remove(path) != 0 || !rsMake(root, path)) // nothing kept on it: a roll of today's size instead
+            return;
+        if ((fd = open(path, O_RDWR)) < 0)
+            return;
+        rsStamp(fd, id, title);
+        lseek(fd, 0, SEEK_SET);
+    }
+    rsLaunch.state = RIPSHOT_NOT_HERE;
+    n = fileXioIoctl2(ps2sdk_get_iop_fd(fd), USBMASS_IOCTL_GET_FRAGLIST, NULL, 0, (void *)&settings->frags[*fragCount],
+                      sizeof(bd_fragment_t) * (BDM_MAX_FRAGS - *fragCount));
+    if (n <= 0 || n > BDM_MAX_FRAGS - *fragCount) { // too scattered to hand over beside the ISO
+        close(fd);
+        LOG("RIPSHOT roll %s: %d fragments, not handed over\n", path, n);
+        return;
+    }
+    rsSlots(fd, hdr);
+    close(fd);
+    ripps2ShotCount(hdr, &kept, &art, &media);
+
+    settings->fragfile[1].frag_start = *fragCount;
+    settings->fragfile[1].frag_count = n;
+    *fragCount += n;
+    rsLaunch.kept = kept;
+    rsLaunch.scr = rsFirstScr(prefix, id) + art;
+    rsLaunch.shot = rsFirstShot(root, rsLaunch.title) + media;
+    rsLaunch.state = RIPSHOT_READY;
+    LOG("RIPSHOT roll %s: %d fragments, kept 0x%02x, next SCR%d / SHOT %02d\n", path, n, kept, rsLaunch.scr, rsLaunch.shot);
+}
+
+void ripps2ShotFillConfig(struct EECoreConfig_t *config, const char *mode)
+{
+    config->Ripshot = (config->IgrMenu && gRipps2Ripshot) ? RIPSHOT_NOT_HERE : RIPSHOT_OFF; // IgrMenu: set just before
+    config->RipshotKept = 0;
+    config->RipshotScrNext = 1;
+    config->RipshotShotNext = 1;
+    config->RipshotFreeMB = -1; // BDM's file systems do not say; the APA HDD will
+    config->RipshotDrive[0] = '\0';
+    config->RipshotTitle[0] = '\0';
+    if (mode != NULL && !strncmp(mode, "BDM_", 4) && rsLaunch.armed && config->Ripshot != RIPSHOT_OFF) {
+        config->Ripshot = rsLaunch.state;
+        config->RipshotKept = rsLaunch.kept;
+        config->RipshotScrNext = rsLaunch.scr;
+        config->RipshotShotNext = rsLaunch.shot;
+        memcpy(config->RipshotDrive, rsLaunch.drive, sizeof(config->RipshotDrive));
+        memcpy(config->RipshotTitle, rsLaunch.title, sizeof(config->RipshotTitle));
+    }
+    memset(&rsLaunch, 0, sizeof(rsLaunch));
+}
+
+// ---- developing (step 5): a kept shot to its PNGs
+
+// idx (w x h, each row twice when twice) as an 8-bit palette PNG at path
+static int rsPng(const char *path, const u8 *idx, int w, int h, int twice, const u8 *pal, int n)
+{
+    FILE *f = fopen(path, "wb");
+    png_structp png;
+    png_infop info;
+    png_color pc[256];
+    int y, k;
+    long want;
+
+    if (f == NULL)
+        return 0;
+    png = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
+    info = png != NULL ? png_create_info_struct(png) : NULL;
+    if (png == NULL || info == NULL || setjmp(png_jmpbuf(png))) {
+        png_destroy_write_struct(&png, &info);
+        fclose(f);
+        remove(path);
+        return 0;
+    }
+    for (k = 0; k < n; k++) {
+        pc[k].red = pal[k * 3];
+        pc[k].green = pal[k * 3 + 1];
+        pc[k].blue = pal[k * 3 + 2];
+    }
+    png_init_io(png, f);
+    png_set_IHDR(png, info, w, h * twice, 8, PNG_COLOR_TYPE_PALETTE, PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT,
+                 PNG_FILTER_TYPE_DEFAULT);
+    png_set_PLTE(png, info, pc, n);
+    png_write_info(png, info);
+    for (y = 0; y < h * twice; y++)
+        png_write_row(png, (png_bytep)(idx + (y / twice) * w));
+    png_write_end(png, info);
+    png_destroy_write_struct(&png, &info);
+    fflush(f);
+    want = ftell(f);
+    if (fclose(f) != 0 || want <= 0 || rsSize(path) != want) { // the drive filled up under the last bytes, or the file
+        remove(path);                                          // did not keep them (seen once: an empty file)
+        return 0;
+    }
+    return 1;
+}
+
+// A developed shot, written once more when the first try did not hold
+static int rsPngSure(const char *path, const u8 *idx, int w, int h, int twice, const u8 *pal, int n)
+{
+    return rsPng(path, idx, w, h, twice, pal, n) || rsPng(path, idx, w, h, twice, pal, n);
+}
+
+static int rsSlotHeader(int fd, int slot, rs_slot_hdr_t *h)
+{
+    return lseek(fd, RS_SLOT_AT(slot), SEEK_SET) == RS_SLOT_AT(slot) && read(fd, h, sizeof(*h)) == (int)sizeof(*h) &&
+           memcmp(h->magic, RS_SLOT_MAGIC, 8) == 0 && h->state == 1 && h->w > 0 && h->h > 0 && h->w <= RS_FRAME_W &&
+           h->h <= RS_FRAME_H;
+}
+
+// The slot's frame, w x h at 16 bits (malloc'd), or NULL
+static u16 *rsSlotPixels(int fd, int slot, const rs_slot_hdr_t *h)
+{
+    int bytes = h->w * h->h * 2;
+    u16 *px = malloc(bytes);
+
+    if (px != NULL && (lseek(fd, RS_SLOT_AT(slot) + RS_PIECE, SEEK_SET) != RS_SLOT_AT(slot) + RS_PIECE || read(fd, px, bytes) != bytes)) {
+        free(px);
+        px = NULL;
+    }
+    return px;
+}
+
+static int rsEmptySlot(int fd, int slot)
+{
+    memset(rsPiece, 0, 512);
+    return lseek(fd, RS_SLOT_AT(slot), SEEK_SET) == RS_SLOT_AT(slot) && write(fd, rsPiece, 512) == 512;
+}
+
+// The number in a name the menu showed ("SHOT 03.PNG" after "SHOT ", "SLUS_209.46_SCR3.PNG" after "_SCR"; a plain _SCR is
+// 1), or 0 when there is none
+static int rsShownNumber(const char *name, int len, const char *after)
+{
+    char s[40];
+    const char *p;
+
+    snprintf(s, sizeof(s), "%.*s", len, name);
+    if ((p = strstr(s, after)) == NULL)
+        return 0;
+    p += strlen(after);
+    if (*p == '.')
+        return 1;
+    return isdigit((unsigned char)*p) ? atoi(p) : 0;
+}
+
+// The roll's slot to its PNGs: MEDIA/<title>/SHOT nn.png at full size, ART/<ID>_SCR<n>.png at 250 x 188, under the names
+// the menu showed when they are still free (else the next free ones); then the slot is empty. 0 when nothing could be
+// written (the shot stays).
+static int rsDevelopSlot(const char *roll, int slot, const char *root, const char *prefix)
+{
+    rs_slot_hdr_t h;
+    u16 *px = NULL, *small = NULL;
+    u8 *idx = NULL, pal[768];
+    char id[17], title[33], folder[32], dir[200], file[240];
+    int fd, ok = 0, nc, n;
+
+    if ((fd = open(roll, O_RDWR)) < 0)
+        return 0;
+    if (!rsSlotHeader(fd, slot, &h) || (px = rsSlotPixels(fd, slot, &h)) == NULL ||
+        (idx = malloc(h.w * h.h > 250 * 188 ? h.w * h.h : 250 * 188)) == NULL)
+        goto out;
+    memcpy(id, h.id, 16);
+    id[16] = '\0';
+    memcpy(title, h.title, 32);
+    title[32] = '\0';
+    ok = 1;
+    if (h.path & RS_PATH_MEDIA) {
+        ripps2ShotFolder(title, id, folder, sizeof(folder));
+        snprintf(dir, sizeof(dir), "%sMEDIA", root);
+        mkdir(dir, 0777);
+        snprintf(dir, sizeof(dir), "%sMEDIA/%s", root, folder);
+        mkdir(dir, 0777);
+        n = rsShownNumber(h.media, sizeof(h.media), "SHOT ");
+        snprintf(file, sizeof(file), "%s/SHOT %02d.png", dir, n);
+        if (n <= 0 || rsTaken(file)) {
+            n = rsFirstShot(root, folder);
+            snprintf(file, sizeof(file), "%s/SHOT %02d.png", dir, n);
+        }
+        nc = ripps2ShotQuantize(px, h.w * h.h, idx, pal);
+        ok = nc > 0 && rsPngSure(file, idx, h.w, h.h, h.field ? 2 : 1, pal, nc);
+    }
+    if (ok && (h.path & RS_PATH_ART)) {
+        ok = (small = malloc(250 * 188 * 2)) != NULL;
+        if (ok) {
+            ripps2ShotShrink(px, h.w, h.h, h.field, small, 250, 188);
+            snprintf(dir, sizeof(dir), "%sART", prefix);
+            mkdir(dir, 0777);
+            n = rsShownNumber(h.art, sizeof(h.art), "_SCR");
+            if (n == 1)
+                snprintf(file, sizeof(file), "%sART/%s_SCR.png", prefix, id);
+            else
+                snprintf(file, sizeof(file), "%sART/%s_SCR%d.png", prefix, id, n);
+            if (n <= 0 || rsTaken(file))
+                n = rsFirstScr(prefix, id);
+            if (n == 1)
+                snprintf(file, sizeof(file), "%sART/%s_SCR.png", prefix, id);
+            else
+                snprintf(file, sizeof(file), "%sART/%s_SCR%d.png", prefix, id, n);
+            nc = ripps2ShotQuantize(small, 250 * 188, idx, pal);
+            ok = nc > 0 && rsPngSure(file, idx, 250, 188, 1, pal, nc);
+        }
+    }
+    if (ok)
+        ok = rsEmptySlot(fd, slot);
+    if (ok && (h.path & RS_PATH_ART))
+        cacheInvalidateFailMemo(); // new ART: a theme that asked for this _SCR before (answered absent) asks again
+out:
+    close(fd);
+    free(px);
+    free(small);
+    free(idx);
+    return ok;
+}
+
+static int rsRollKept(const char *roll, rs_slot_hdr_t *hdr)
+{
+    int fd = open(roll, O_RDONLY), kept, art, media;
+
+    if (fd < 0)
+        return 0;
+    rsSlots(fd, hdr);
+    close(fd);
+    ripps2ShotCount(hdr, &kept, &art, &media);
+    return kept;
+}
+
+// A roll with nothing kept: the drive's next blank (nothing to allocate), or gone when there is a blank already
+static void rsRecycle(const char *dir, const char *roll)
+{
+    char blank[192];
+    int fd;
+
+    snprintf(blank, sizeof(blank), "%sBLANK.ROLL", dir);
+    if (!rsExists(blank) && (fd = open(roll, O_RDWR)) >= 0) {
+        int ok = lseek(fd, 0, SEEK_END) >= RS_ROLL_BYTES && rsStamp(fd, NULL, NULL);
+        close(fd);
+        if (ok && rename(roll, blank) == 0)
+            return;
+    }
+    remove(roll);
+}
+
+// "massN:/" and the game library folder ART lives under, from a path on the drive
+static void rsRootOf(const char *path, char *root, int size, char *prefix, int psize)
+{
+    const char *c = strchr(path, ':');
+    int n = c != NULL ? (int)(c - path) + 1 : 0;
+
+    if (c != NULL && c[1] == '/')
+        n++;
+    snprintf(root, size, "%.*s", n, path);
+    if (gBDMPrefix[0] != '\0')
+        snprintf(prefix, psize, "%s%s/", root, gBDMPrefix);
+    else
+        snprintf(prefix, psize, "%s", root);
+}
+
+static void rsNotice(const char *text)
+{
+#ifdef RETROACHIEVEMENTS
+    guiShowRANotice(text, NULL); // safe from the IO worker: it sets the text, the render loop draws it
+#else
+    (void)text;
+#endif
+}
+
+// ---- the background job: a blank roll on every started drive, rolls with nothing kept recycled, and with Develop
+// Shots on Auto the shots developed, one at a time, once the game lists are up (a launch stops it between shots)
+
+#define RS_WORK_MAX 64
+static struct
+{
+    char roll[96];
+    u8 slot;
+} rsWork[RS_WORK_MAX];
+static int rsWorkCount, rsWorkAt, rsWorkSaved, rsWorkFailed, rsWaiting, rsToldWaiting;
+static volatile int rsBusy;
+static int rsJobSlot;
+
+static void rsJob(void)
+{
+    char dir[64], path[160], blank[160], root[16];
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    DIR *d;
+    struct dirent *e;
+    int haveBlank, kept, i;
+
+    snprintf(root, sizeof(root), "mass%d:/", rsJobSlot);
+    snprintf(dir, sizeof(dir), "mass%d:/MEDIA/RIPSHOT/", rsJobSlot);
+    snprintf(blank, sizeof(blank), "%sBLANK.ROLL", dir);
+    haveBlank = rsExists(blank);
+    if ((d = opendir(dir)) != NULL) {
+        while ((e = readdir(d)) != NULL) {
+            if (!rsIsRoll(e->d_name, 0))
+                continue;
+            snprintf(path, sizeof(path), "%s%s", dir, e->d_name);
+            if ((kept = rsRollKept(path, hdr)) == 0) { // a launch renamed a blank that took no shot
+                if (!haveBlank) {
+                    rsRecycle(dir, path);
+                    haveBlank = rsExists(blank);
+                } else
+                    remove(path);
+                continue;
+            }
+            for (i = 0; i < RS_SLOTS; i++)
+                if (kept & (1 << i)) {
+                    rsWaiting++;
+                    if (gRipps2RipshotDevelop == 1 && rsWorkCount < RS_WORK_MAX) {
+                        snprintf(rsWork[rsWorkCount].roll, sizeof(rsWork[0].roll), "%s", path);
+                        rsWork[rsWorkCount++].slot = i;
+                    }
+                }
+        }
+        closedir(d);
+        ripps2WriteReadme(root, 1); // a drive RIPSHOT already uses gets MEDIA's README with RIPSHOT in it (build 108)
+    }
+    if (!haveBlank) {
+        if (rsMake(root, blank))
+            LOG("RIPSHOT made %s\n", blank);
+    }
+    rsBusy = 0;
+}
+
+static void rsDevelopJob(void)
+{
+    char root[16], prefix[64], dir[96], msg[64], *slash;
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int at = rsWorkAt;
+
+    snprintf(msg, sizeof(msg), _t("DEVELOPING %d OF %d"), at + 1, rsWorkCount);
+    rsNotice(msg);
+    rsRootOf(rsWork[at].roll, root, sizeof(root), prefix, sizeof(prefix));
+    if (rsDevelopSlot(rsWork[at].roll, rsWork[at].slot, root, prefix))
+        rsWorkSaved++;
+    else
+        rsWorkFailed++;
+    rsWorkAt = ++at;
+    if (at >= rsWorkCount || strcmp(rsWork[at].roll, rsWork[at - 1].roll) != 0) { // that roll is done: empty, it goes
+        snprintf(dir, sizeof(dir), "%s", rsWork[at - 1].roll);
+        if ((slash = strrchr(dir, '/')) != NULL)
+            slash[1] = '\0';
+        if (rsRollKept(rsWork[at - 1].roll, hdr) == 0)
+            rsRecycle(dir, rsWork[at - 1].roll);
+    }
+    if (at >= rsWorkCount) {
+        if (rsWorkFailed)
+            snprintf(msg, sizeof(msg), _t("%d NOT SAVED: DRIVE FULL"), rsWorkFailed);
+        else if (rsWorkSaved == 1)
+            snprintf(msg, sizeof(msg), "%s", _t("1 SHOT SAVED"));
+        else
+            snprintf(msg, sizeof(msg), _t("%d SHOTS SAVED"), rsWorkSaved);
+        rsNotice(msg);
+    }
+    rsBusy = 0;
+}
+
+int ripps2ShotBusy(void)
+{
+    return rsBusy;
+}
+
+void ripps2ShotTick(void)
+{
+    static clock_t start = 0, tried = 0;
+    static int done = 0; // the slots handled this boot
+    clock_t now = clock();
+    int i, t;
+
+    if (rsBusy || !gRipps2IgrMenu || !gRipps2Ripshot)
+        return;
+    if (start == 0)
+        start = tried = now ? now : 1;
+    if ((now - start) < 10 * CLOCKS_PER_SEC || (now - tried) < (rsWorkAt < rsWorkCount ? CLOCKS_PER_SEC / 4 : 2 * CLOCKS_PER_SEC))
+        return; // the boot settles first: the game lists, the disc read
+    tried = now;
+    for (t = 1; t < IO_REQ_TYPE_COUNT; t++)
+        if (ioGetPending(t) > 0)
+            return; // only when the IO worker has nothing else
+    if (rsWorkAt < rsWorkCount) { // Auto: the next shot
+        rsBusy = 1;
+        if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &rsDevelopJob) != IO_OK)
+            rsBusy = 0;
+        return;
+    }
+    for (i = 0; i < 8; i++) {
+        if ((done & (1 << i)) || !bdmSlotEverConnected(BDM_MODE + i))
+            continue;
+        t = bdmSlotDeviceType(i);
+        if (t == -2 || t == BDM_TYPE_UDPBD)
+            continue; // nothing mounted there now, or a network block device (Neutrino's only)
+        done |= 1 << i;
+        rsJobSlot = i;
+        rsBusy = 1;
+        if (ioPutRequest(IO_CUSTOM_SIMPLEACTION, &rsJob) != IO_OK)
+            rsBusy = 0;
+        return;
+    }
+    if (!rsToldWaiting && rsWaiting > 0 && gRipps2RipshotDevelop != 1) { // Manual: say so once, after every drive
+        char msg[64];
+        rsToldWaiting = 1;
+        if (rsWaiting == 1)
+            snprintf(msg, sizeof(msg), "%s", _t("1 SHOT ON THE ROLL"));
+        else
+            snprintf(msg, sizeof(msg), _t("%d SHOTS ON THE ROLL"), rsWaiting);
+        rsNotice(msg);
+    }
+}
+
+// ---- Memory Files: the rolls (opening MEDIA/RIPSHOT)
+
+#define RP_ROWS  14
+#define RP_ROW_H 22
+#define RP_Y     84
+#define RP_X     30
+#define RP_RIGHT 610
+#define RP_LIT   GS_SETREG_RGBA(0x80, 0x80, 0x80, 0x80)
+#define RP_DIM   GS_SETREG_RGBA(0x4C, 0x52, 0x64, 0x80)
+#define RP_SOFT  GS_SETREG_RGBA(0x67, 0x6C, 0x7A, 0x80)
+#define RP_PRIM(r, g, b, a) GS_SETREG_RGBAQ((r), (g), (b), (a), 0x00)
+
+typedef struct
+{
+    char file[48];
+    char title[33];
+    int kept;
+} rs_roll_t;
+
+int ripps2ShotIsRollDir(const char *path)
+{
+    const char *c = strchr(path, ':');
+    if (c == NULL)
+        return 0;
+    c += c[1] == '/' ? 2 : 1;
+    return strcasecmp(c, "MEDIA/RIPSHOT/") == 0;
+}
+
+static int rsListRolls(const char *dir, rs_roll_t **out)
+{
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    rs_roll_t *list = NULL;
+    rs_slot_hdr_t hdr[RS_SLOTS];
+    int n = 0, cap = 0, fd;
+    char path[192];
+
+    *out = NULL;
+    if (d == NULL)
+        return 0;
+    while ((e = readdir(d)) != NULL && n < RS_ROLLS_MAX) {
+        rs_roll_hdr_t rh;
+        if (!rsIsRoll(e->d_name, 0))
+            continue;
+        snprintf(path, sizeof(path), "%s%s", dir, e->d_name);
+        if ((fd = open(path, O_RDONLY)) < 0)
+            continue;
+        memset(&rh, 0, sizeof(rh));
+        if (read(fd, &rh, sizeof(rh)) != (int)sizeof(rh))
+            memset(&rh, 0, sizeof(rh));
+        rsSlots(fd, hdr);
+        close(fd);
+        int kept, art, media;
+        ripps2ShotCount(hdr, &kept, &art, &media);
+        if (kept == 0)
+            continue; // empty rolls never show
+        if (n == cap) {
+            rs_roll_t *grown = realloc(list, (cap += 32) * sizeof(rs_roll_t));
+            if (grown == NULL)
+                break;
+            list = grown;
+        }
+        snprintf(list[n].file, sizeof(list[n].file), "%s", e->d_name);
+        memcpy(list[n].title, rh.title, 32);
+        list[n].title[32] = '\0';
+        if (list[n].title[0] == '\0')
+            snprintf(list[n].title, sizeof(list[n].title), "%.*s", (int)strlen(e->d_name) - 5, e->d_name);
+        list[n++].kept = kept;
+    }
+    closedir(d);
+    *out = list;
+    return n;
+}
+
+static int rsCount(int kept)
+{
+    int n = 0, i;
+    for (i = 0; i < RS_SLOTS; i++)
+        n += (kept >> i) & 1;
+    return n;
+}
