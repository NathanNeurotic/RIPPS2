diff --git a/ee_core/src/ripshot.c b/ee_core/src/ripshot.c
new file mode 100644
index 0000000..72ababc
--- /dev/null
+++ b/ee_core/src/ripshot.c
@@ -0,0 +1,336 @@
+/*
+  ripshot.c RIPSHOT, screenshots from the in-game menu (RIPPS2 build 108)
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review OpenUsbLd README & LICENSE files for further details.
+
+  The plan is ps2-pillars docs/plans/ripshot.md. This file reads the frame back: which frame the PCRTC
+  shows (rsFrame, from the writes GSM recorded), its pixels out of GS memory (rsRead) and the roll's
+  16-bit form of them (rsToRgb555).
+
+  rsRead is a GS local -> host transfer, written from the GS manual's steps and ps2sdk's ee/debug
+  screenshot.c (AFL): BITBLTBUF, TRXPOS, TRXREG and TRXDIR = 1 through VIF1 DIRECT behind a FINISH, the VIF1
+  FIFO turned towards the EE (VIF1_STAT FDR) with the GS bus reversed (BUSDIR), and DMA channel 1 into
+  memory. OPL's IGS (igs_api.c) does the same job but is GPL-3, so nothing here comes from it.
+
+  The game is paused (padhook.c) with its GS interrupt held; even so its GS state is left as found: FINISH
+  is masked in IMR while ours is raised, and the FINISH flag is cleared again unless the game had it set.
+
+  RIPSHOT_HOST_TEST builds only rsFrame and rsToRgb555, for elf/tests.
+*/
+
+#ifndef RIPSHOT_HOST_TEST
+#include "ee_core.h"
+#endif
+#include "ripshot.h"
+
+#define SRC_PMODE    0
+#define SRC_SMODE2   2
+#define SRC_DISPFB1  7
+#define SRC_DISPLAY1 8
+#define SRC_DISPFB2  9
+#define SRC_DISPLAY2 10
+
+int rsFrame(const u64 *regs, rs_frame_t *f)
+{
+    u64 pmode = regs[SRC_PMODE], fb1 = regs[SRC_DISPFB1], fb2 = regs[SRC_DISPFB2];
+    int c1 = (pmode & 1) || (!(pmode & 2) && fb1 != 0); // circuit 1 is on top
+    u64 fb = c1 ? fb1 : fb2, disp = regs[c1 ? SRC_DISPLAY1 : SRC_DISPLAY2];
+    u32 psm, w, h;
+
+    if (fb == 0)
+        return 0; // GSM saw no DISPFB write (the game turned the breakpoint off, or wrote it some other way)
+    psm = (fb >> 15) & 0x1f;
+    f->psm = psm;
+    f->bpp = psm == 0 ? 4 : psm == 1 ? 3 : (psm == 2 || psm == 10) ? 2 : 0;
+    f->bw = (fb >> 9) & 0x3f;
+    if (!f->bpp || !f->bw)
+        return 0;
+    f->bp = (fb & 0x1ff) * 32; // pages of 2048 words, in BITBLTBUF's 64-word blocks
+    w = f->bw * 64;
+    h = 224;
+    if (disp) { // shown size: DW over MAGH, DH over MAGV (u32: a u64 divide pulls in libgcc)
+        u32 dw = (((u32)(disp >> 32) & 0xfff) + 1) / (((u32)(disp >> 23) & 0xf) + 1);
+        u32 dh = (((u32)(disp >> 44) & 0x7ff) + 1) / (((u32)(disp >> 27) & 3) + 1);
+        if (dw > 0 && dw < w)
+            w = dw;
+        // interlaced, the TV shows its raster and no more, whatever DH asks (a game writing DH 959 shows 480 lines on
+        // NTSC); a PAL picture starts lower (DY 72 against NTSC's 50)
+        if ((regs[SRC_SMODE2] & 1) && dh > ((((u32)(disp >> 12) & 0x7ff) >= 64) ? 576u : 480u))
+            dh = (((u32)(disp >> 12) & 0x7ff) >= 64) ? 576 : 480;
+        if (dh > 0 && dh <= 1024)
+            h = dh;
+    }
+    f->field = (regs[SRC_SMODE2] & 3) == 3; // interlaced FRAME mode: the buffer holds one field
+    if (f->field)
+        h /= 2;
+    f->x = (fb >> 32) & 0x7ff;
+    f->y = (fb >> 43) & 0x7ff;
+    f->w = w;
+    f->h = h;
+    return 1;
+}
+
+void rsToRgb555(const u8 *src, u32 psm, u16 *dst, u32 n)
+{
+    u32 i;
+
+    if (psm == 2 || psm == 10) { // CT16 / CT16S are the roll's own layout (A1 B5 G5 R5), little endian
+        for (i = 0; i < n; i++, src += 2)
+            dst[i] = (src[0] | src[1] << 8) | 0x8000;
+        return;
+    }
+    for (i = 0; i < n; i++, src += psm == 1 ? 3 : 4) // CT32: R G B A, CT24: R G B
+        dst[i] = (src[0] >> 3) | (src[1] >> 3) << 5 | (src[2] >> 3) << 10 | 0x8000;
+}
+
+u32 rsLinesPerWrite(u32 lb)
+{
+    u32 g = 512, a = lb, per;
+
+    if (lb == 0 || lb > 8192)
+        return 0;
+    while (a) { // gcd(lb, 512): lines in a group that ends on a sector
+        u32 t = g % a;
+        g = a;
+        a = t;
+    }
+    per = 8192 / lb / (512 / g) * (512 / g);
+    return per ? per : 8192 / lb; // a line too odd to group: write what fits, padded
+}
+
+#ifndef RIPSHOT_HOST_TEST
+
+#define RS_D1_CHCR   ((vu32 *)0x10009000)
+#define RS_D1_MADR   ((vu32 *)0x10009010)
+#define RS_D1_QWC    ((vu32 *)0x10009020)
+#define RS_VIF1_STAT ((vu32 *)0x10003c00)
+#define RS_GS_CSR    ((vu64 *)0x12001000)
+#define RS_GS_BUSDIR ((vu64 *)0x12001040)
+#define CHCR_STR     0x100
+#define VIF_FQC      0x1f000000
+#define VIF_FDR      0x00800000
+#define CSR_FINISH   2
+#define IMR_FINISH   0x200
+
+#define GIFTAG(nloop, eop, flg, nreg) ((u64)(nloop) | (u64)(eop) << 15 | (u64)(flg) << 58 | (u64)(nreg) << 60)
+
+static int rsWait(vu32 *reg, u32 bits, u32 want) // bounded: a GS that never answers must not hold the pause
+{
+    int i;
+    for (i = 0; i < 10000000; i++)
+        if ((*reg & bits) == want)
+            return 1;
+    return 0;
+}
+
+int rsRead(void *buf, const rs_frame_t *f, u32 x, u32 y, u32 w, u32 h)
+{
+    u32 pkt[28] __attribute__((aligned(64)));
+    u64 *q = (u64 *)(pkt + 4);
+    u32 finishWas, ok;
+    u64 imr;
+
+    if (*RS_D1_CHCR & CHCR_STR)
+        return 0;
+    pkt[0] = 0;
+    pkt[1] = 0;
+    pkt[2] = 0x13 << 24;            // FLUSHA: the game's PATH3 is idle and stays masked as it was
+    pkt[3] = (0x50 << 24) | 6;      // DIRECT, 6 quadwords
+    q[0] = GIFTAG(5, 1, 0, 1);
+    q[1] = 0xe;                     // A+D
+    q[2] = (u64)f->bp | (u64)f->bw << 16 | (u64)f->psm << 24;
+    q[3] = 0x50;                    // BITBLTBUF: the source
+    q[4] = (u64)x | (u64)y << 16;
+    q[5] = 0x51;                    // TRXPOS
+    q[6] = (u64)w | (u64)h << 32;
+    q[7] = 0x52;                    // TRXREG
+    q[8] = 0;
+    q[9] = 0x61;                    // FINISH: everything the game drew is in memory before the read
+    q[10] = 1;
+    q[11] = 0x53;                   // TRXDIR: local -> host
+
+    finishWas = *(vu32 *)RS_GS_CSR & CSR_FINISH;
+    imr = GsPutIMR(GsGetIMR() | IMR_FINISH);
+    *RS_GS_CSR = CSR_FINISH;
+
+    FlushCache(0); // the packet out to memory, and no dirty line of buf left to land on the DMA's data
+    *RS_D1_QWC = 7;
+    *RS_D1_MADR = (u32)pkt;
+    *RS_D1_CHCR = 0x101; // from memory, normal mode, start
+    asm volatile("sync.l");
+    ok = rsWait(RS_D1_CHCR, CHCR_STR, 0) && rsWait((vu32 *)RS_GS_CSR, CSR_FINISH, CSR_FINISH) &&
+         rsWait(RS_VIF1_STAT, VIF_FQC, 0);
+
+    if (ok) {
+        *RS_VIF1_STAT = VIF_FDR; // the FIFO towards the EE
+        *RS_GS_BUSDIR = 1;       // and the GS bus towards the host
+        *RS_D1_QWC = w * h * f->bpp / 16;
+        *RS_D1_MADR = (u32)buf;
+        *RS_D1_CHCR = 0x100; // to memory, normal mode, start
+        asm volatile("sync.l");
+        ok = rsWait(RS_D1_CHCR, CHCR_STR, 0);
+        if (!ok)
+            *RS_D1_CHCR = 0;
+        *RS_VIF1_STAT = 0;
+        *RS_GS_BUSDIR = 0;
+    } else
+        *RS_D1_CHCR = 0;
+
+    if (!finishWas)
+        *RS_GS_CSR = CSR_FINISH; // ours: the game's handler must not see it when the pause ends
+    GsPutIMR(imr);
+    asm volatile("sync.l");
+    FlushCache(0); // nothing cached of buf: the caller reads what the DMA wrote
+    return ok;
+}
+
+// ---- the roll, over SIF DMA (ripshot_io.h)
+
+#include <sifrpc.h>
+#include "util.h" // CopyToIop
+#include "../../modules/iopcore/common/ripshot_io.h"
+
+#define RS_SECOND 294912000u // COP0 Count ticks
+
+static rs_ack_t rsAck __attribute__((aligned(64))); // a cache line of its own: the IOP DMAs into it
+static u32 rsIopReq, rsIopBuf, rsSeq;
+
+#define RS_ACK ((volatile rs_ack_t *)UNCACHED_SEG(&rsAck))
+
+static inline u32 rsCount(void)
+{
+    u32 c;
+    __asm__ __volatile__("mfc0 %0, $9" : "=r"(c));
+    return c;
+}
+
+static SifRpcClientData_t rsCd __attribute__((aligned(64)));
+static s32 rsRpcData[4] __attribute__((aligned(64)));
+
+void rsLinkIop(void) // its buffers are static: the first IOP reset runs on ee_core's main stack, near its 3 KB floor
+{
+    SifRpcClientData_t *cd = &rsCd;
+    s32 *data = rsRpcData;
+    int r, tries = 0;
+
+    rsIopReq = rsIopBuf = rsSeq = 0; // a new CDVDMAN: nothing of the old one holds
+    cd->server = NULL;
+    while ((r = SifBindRpc(cd, 0x80000598, 0)) >= 0 && !cd->server && ++tries < 100000)
+        nopdelay();
+    if (r < 0 || !cd->server)
+        return;
+    RS_ACK->roll_bytes = 0;
+    RS_ACK->seq = 0;
+    data[0] = (s32)&rsAck;
+    if (SifCallRpc(cd, RIPSHOT_RPC_FNO, 0, data, sizeof(rsRpcData), data, sizeof(rsRpcData), NULL, NULL) < 0)
+        return;
+    rsIopReq = *(volatile u32 *)UNCACHED_SEG(&data[0]);
+}
+
+u32 rsRollBytes(void)
+{
+    return rsIopReq ? RS_ACK->roll_bytes : 0;
+}
+
+static int rsPost(u32 op, u32 offset, u32 size, void *ee)
+{
+    rs_req_t r __attribute__((aligned(64)));
+    u32 t;
+
+    if (!rsIopReq)
+        return -1;
+    r.op = op;
+    r.offset = offset;
+    r.size = size;
+    r.ee_data = (u32)ee & 0x0fffffff; // a physical address for the IOP's DMA
+    r.pad[0] = r.pad[1] = r.pad[2] = 0;
+    r.seq = ++rsSeq;
+    FlushCache(0);
+    CopyToIop(&r, sizeof(r), (void *)rsIopReq);
+    t = rsCount();
+    while (RS_ACK->seq != rsSeq)
+        if (rsCount() - t > 3 * RS_SECOND)
+            return -1; // CDVDMAN's thread did not answer
+    return RS_ACK->result;
+}
+
+int rsRollBegin(void)
+{
+    if (rsPost(RS_OP_BEGIN, 0, 0, NULL) != 0 || RS_ACK->iop_buf == 0)
+        return 0;
+    rsIopBuf = RS_ACK->iop_buf;
+    return 1;
+}
+
+int rsRollStage(u32 bufOff, const void *data, u32 size)
+{
+    if (!rsIopBuf || size == 0 || (size & 15) || (bufOff & 15) || bufOff + size > RIPSHOT_IOP_BUF)
+        return -1;
+    FlushCache(0); // CopyToIop DMAs from memory, not from the cache
+    CopyToIop((void *)data, size, (void *)(rsIopBuf + bufOff));
+    return 0;
+}
+
+int rsRollWrite(u32 offset, u32 size)
+{
+    if (!rsIopBuf || size == 0 || size > RIPSHOT_IOP_BUF)
+        return -1;
+    return rsPost(RS_OP_WRITE, offset, size, NULL);
+}
+
+int rsRollRead(u32 offset, u32 size)
+{
+    if (!rsIopBuf || size == 0 || size > RIPSHOT_IOP_BUF)
+        return -1;
+    return rsPost(RS_OP_READ, offset, size, NULL);
+}
+
+int rsRollFetch(u32 bufOff, void *data, u32 size)
+{
+    int r;
+
+    if (!rsIopBuf)
+        return -1;
+    r = rsPost(RS_OP_SEND, bufOff, size, data); // rsPost flushed: no dirty line of data to land on the DMA
+    FlushCache(0);                              // and none cached from before it
+    return r;
+}
+
+int rsHoldSave(const rs_frame_t *f, u32 x, u32 y, u32 w, u32 h, u8 *line, u32 at)
+{
+    u32 lb = w * f->bpp, per = rsLinesPerWrite(lb), n = 0, i;
+
+    for (i = 0; i < h; i++) {
+        if (!rsRead(line, f, x, y + i, w, 1) || rsRollStage(n * lb, line, lb) < 0)
+            return 0;
+        if (++n == per || i == h - 1) {
+            u32 bytes = (n * lb + 511) & ~511u;
+            if (rsRollWrite(at, bytes) != (int)bytes)
+                return 0;
+            at += bytes;
+            n = 0;
+        }
+    }
+    return 1;
+}
+
+void rsRollEnd(void)
+{
+    if (rsIopBuf)
+        rsPost(RS_OP_END, 0, 0, NULL);
+    rsIopBuf = 0;
+}
+
+void rsHush(void)
+{
+    rsPost(RS_OP_HUSH, 0, 0, NULL);
+}
+
+void rsWake(void)
+{
+    rsPost(RS_OP_WAKE, 0, 0, NULL);
+}
+
+#endif
