+// ---- Settings > General > In-Game Menu (step 6): every choice says what it does
+
+static const char *rsOnOff[] = {N_("On"), N_("Off"), NULL};
+static const char *rsManualAuto[] = {N_("Manual"), N_("Auto"), NULL};
+static const char *rsIgrHints[] = {N_("L1+L2+R1+R2+SELECT+START pauses the game: resume, exit, take a screenshot, check achievements or power off."),
+                                   N_("The combo leaves the game at once, as before."), NULL};
+static const char *rsShotHints[] = {N_("Screenshots from the in-game menu, to ART for your themes or to MEDIA. 6 per game; each game with shots waiting holds 4 MB."),
+                                    N_("No SCREENSHOT in the in-game menu, and no space kept for it."), NULL};
+static const char *rsDevHints[] = {N_("Shots wait on each game's roll in Memory Files (MEDIA/RIPSHOT) until you develop them. Nothing runs on its own."),
+                                   N_("Shots turn into PNGs by themselves once you are back in RIPPS2, in the background while you browse."), NULL};
+
+static int rsIgrUpdater(int modified)
+{
+    int igr = 0, shot = 0;
+
+    (void)modified;
+    diaGetInt(diaIgrConfig, CFG_RIPPS2_IGRMENU, &igr);
+    diaGetInt(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, &shot);
+    diaSetEnabled(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, igr == 0);              // greyed while the menu is off
+    diaSetEnabled(diaIgrConfig, UICFG_RIPPS2_DEVELOP, igr == 0 && shot == 0); // ...and while RIPSHOT is
+    return 0;
+}
+
+int ripps2ShowIgrConfig(void)
+{
+    int keepIgr = gRipps2IgrMenu, keepShot = gRipps2Ripshot, keepDev = gRipps2RipshotDevelop, v;
+
+    diaSetEnum(diaIgrConfig, CFG_RIPPS2_IGRMENU, rsOnOff); // the first choice is the default: On, On, Manual
+    diaSetEnum(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, rsOnOff);
+    diaSetEnum(diaIgrConfig, UICFG_RIPPS2_DEVELOP, rsManualAuto);
+    diaSetEnumHints(diaIgrConfig, CFG_RIPPS2_IGRMENU, rsIgrHints);
+    diaSetEnumHints(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, rsShotHints);
+    diaSetEnumHints(diaIgrConfig, UICFG_RIPPS2_DEVELOP, rsDevHints);
+    diaSetInt(diaIgrConfig, CFG_RIPPS2_IGRMENU, gRipps2IgrMenu ? 0 : 1);
+    diaSetInt(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, gRipps2Ripshot ? 0 : 1);
+    diaSetInt(diaIgrConfig, UICFG_RIPPS2_DEVELOP, gRipps2RipshotDevelop == 1 ? 1 : 0);
+    rsIgrUpdater(1);
+    if (diaExecuteDialog(diaIgrConfig, -1, 1, &rsIgrUpdater)) {
+        if (diaGetInt(diaIgrConfig, CFG_RIPPS2_IGRMENU, &v))
+            gRipps2IgrMenu = v == 0;
+        if (diaGetInt(diaIgrConfig, UICFG_RIPPS2_RIPSHOT, &v))
+            gRipps2Ripshot = v == 0;
+        if (diaGetInt(diaIgrConfig, UICFG_RIPPS2_DEVELOP, &v))
+            gRipps2RipshotDevelop = v == 1;
+    }
+    return gRipps2IgrMenu != keepIgr || gRipps2Ripshot != keepShot || gRipps2RipshotDevelop != keepDev;
+}
