index 74b0643..e79dc38 100644
--- a/modules/iopcore/cdvdman/device-bdm.c
+++ b/modules/iopcore/cdvdman/device-bdm.c
@@ -281,3 +281,57 @@ void bdm_writeSector(u64 lba, unsigned short int nsectors, const unsigned char *
 #endif
     SignalSema(bdm_io_sema);
 }
+
+//
+// RIPPS2 build 108: RIPSHOT's roll, handed over by the launch as fragfile[1], the way the ISO is
+//
+
+u32 DeviceRollBytes(void)
+{
+    const struct cdvdman_fragfile *ff = &cdvdman_settings.fragfile[1];
+    u32 i, sectors = 0;
+
+    if (g_bd == NULL)
+        return 0;
+    for (i = 0; i < ff->frag_count; i++)
+        sectors += cdvdman_settings.frags[ff->frag_start + i].count;
+    return sectors * g_bd->sectorSize;
+}
+
+int DeviceRollIo(int write, u32 offset, void *buf, u32 size)
+{
+    const struct cdvdman_fragfile *ff = &cdvdman_settings.fragfile[1];
+    const bd_fragment_t *f = &cdvdman_settings.frags[ff->frag_start];
+    u32 ss, sector, left, base = 0, i;
+    int rv = size;
+
+    if (g_bd == NULL || ff->frag_count == 0)
+        return -1;
+    ss = g_bd->sectorSize;
+    if (offset % ss || size % ss)
+        return -1;
+    sector = offset / ss;
+    left = size / ss;
+
+    WaitSema(bdm_io_sema);
+    for (i = 0; i < ff->frag_count && left > 0; base += f[i].count, i++) {
+        u32 n;
+        int done;
+
+        if (sector >= base + f[i].count)
+            continue;
+        n = base + f[i].count - sector;
+        if (n > left)
+            n = left;
+        done = write ? g_bd->write(g_bd, f[i].sector + (sector - base), buf, n) : g_bd->read(g_bd, f[i].sector + (sector - base), buf, n);
+        if (done != (int)n)
+            break;
+        buf = (u8 *)buf + n * ss;
+        sector += n;
+        left -= n;
+    }
+    if (left)
+        rv = -1; // a failed transfer, or past the roll's end
+    SignalSema(bdm_io_sema);
+    return rv;
+}
