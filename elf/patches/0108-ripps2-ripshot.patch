diff --git a/modules/iopcore/cdvdman/ripshot_iop.c b/modules/iopcore/cdvdman/ripshot_iop.c
new file mode 100644
index 0000000..d33af3b
--- /dev/null
+++ b/modules/iopcore/cdvdman/ripshot_iop.c
@@ -0,0 +1,168 @@
+/*
+  ripshot_iop.c RIPSHOT's roll I/O on the IOP (RIPPS2 build 108)
+
+  Copyright 2026, RIPPS2 contributors
+  Licenced under Academic Free License version 3.0
+  Review Open PS2 Loader README & LICENSE files for further details.
+
+  The mailbox side of ripshot_io.h: ee_core posts requests into rsReq over SIF DMA while the game is paused,
+  this thread does them on the device that launched the game (DeviceRollBytes / DeviceRollIo in device-*.c)
+  and DMAs the answers back. It looks every 20 ms, and every 0.5 ms between RS_OP_BEGIN and RS_OP_END (a hold is
+  a few hundred requests), sleeping in between, so it costs a game nothing worth measuring. Started only when
+  ee_core asks (In-Game Menu on), once per IOP boot.
+
+  The silent menu (the user, 10/20): while the game is paused its IOP side still runs, so the SPU2 went on playing,
+  a stalled stream looping or running ahead. RS_OP_HUSH saves both cores' master volumes and all 48 voices' pitches
+  and sets them to 0: nothing is heard, and a voice with pitch 0 does not move, so a sound (or a stream played
+  through a voice ring, whose refill interrupt then never comes) starts again where it stopped. RS_OP_WAKE puts the
+  pitches back first, leaving any voice the game keyed with a new pitch during the pause as the game set it, then
+  the volumes. What it cannot hold: AutoDMA input (a PCM stream fed straight to the cores) and envelopes keep
+  going, silently.
+*/
+
+#include "internal.h"
+#include "ripshot_io.h"
+#include <spu2regs.h>
+
+static rs_req_t rsReq;
+static rs_ack_t rsAck;
+static u32 rsEeAck;
+static u8 *rsBuf;
+static int rsThreadId = -1;
+static u16 rsMvol[2][2], rsPitch[2][24];
+static int rsHushed;
+
+static void rsHush(void)
+{
+    int c, v;
+
+    if (rsHushed)
+        return;
+    for (c = 0; c < 2; c++) {
+        rsMvol[c][0] = *SD_P_MVOLL(c);
+        rsMvol[c][1] = *SD_P_MVOLR(c);
+        *SD_P_MVOLL(c) = 0;
+        *SD_P_MVOLR(c) = 0;
+    }
+    for (c = 0; c < 2; c++)
+        for (v = 0; v < 24; v++) {
+            rsPitch[c][v] = *SD_VP_PITCH(c, v);
+            *SD_VP_PITCH(c, v) = 0;
+        }
+    rsHushed = 1;
+}
+
+static void rsWake(void)
+{
+    int c, v;
+
+    if (!rsHushed)
+        return;
+    for (c = 0; c < 2; c++)
+        for (v = 0; v < 24; v++)
+            if (*SD_VP_PITCH(c, v) == 0) // still ours: a voice the game keyed meanwhile keeps the game's pitch
+                *SD_VP_PITCH(c, v) = rsPitch[c][v];
+    for (c = 0; c < 2; c++) {
+        *SD_P_MVOLL(c) = rsMvol[c][0];
+        *SD_P_MVOLR(c) = rsMvol[c][1];
+    }
+    rsHushed = 0;
+}
+
+static void rsSendEE(void *buf, u32 ee_addr, u32 size)
+{
+    SifDmaTransfer_t dmat;
+    int oldstate, id;
+
+    dmat.dest = (void *)ee_addr;
+    dmat.size = size;
+    dmat.src = buf;
+    dmat.attr = 0;
+    do {
+        CpuSuspendIntr(&oldstate);
+        id = sceSifSetDma(&dmat, 1);
+        CpuResumeIntr(oldstate);
+    } while (!id);
+    while (sceSifDmaStat(id) >= 0)
+        ;
+}
+
+static s32 rsDo(const rs_req_t *r)
+{
+    switch (r->op) {
+        case RS_OP_BEGIN:
+            if (rsBuf == NULL)
+                rsBuf = AllocSysMemory(ALLOC_FIRST, RIPSHOT_IOP_BUF, NULL);
+            rsAck.iop_buf = (u32)rsBuf;
+            return rsBuf != NULL ? 0 : -1;
+        case RS_OP_WRITE:
+        case RS_OP_READ:
+            if (rsBuf == NULL || r->size == 0 || r->size > RIPSHOT_IOP_BUF || (r->size & 15))
+                return -1;
+            if (DeviceRollIo(r->op == RS_OP_WRITE, r->offset, rsBuf, r->size) != (int)r->size)
+                return -1;
+            return r->size;
+        case RS_OP_SEND:
+            if (rsBuf == NULL || r->size == 0 || (r->size & 15) || (r->offset & 15) || r->offset + r->size > RIPSHOT_IOP_BUF)
+                return -1;
+            rsSendEE(rsBuf + r->offset, r->ee_data, r->size); // before the ack: a new seq means the data is there
+            return r->size;
+        case RS_OP_END:
+            if (rsBuf != NULL)
+                FreeSysMemory(rsBuf);
+            rsBuf = NULL;
+            rsAck.iop_buf = 0;
+            return 0;
+        case RS_OP_HUSH:
+            rsHush();
+            return 0;
+        case RS_OP_WAKE:
+            rsWake();
+            return 0;
+    }
+    return -1;
+}
+
+static void rsThread(void *arg)
+{
+    u32 seen = 0;
+
+    (void)arg;
+    for (;;) {
+        u32 seq = *(volatile u32 *)&rsReq.seq;
+        if (seq != seen) {
+            rs_req_t r = rsReq;
+            seen = seq;
+            rsAck.result = rsDo(&r);
+            rsAck.roll_bytes = DeviceRollBytes();
+            rsAck.seq = seq;
+            rsSendEE(&rsAck, rsEeAck, sizeof(rsAck));
+        }
+        DelayThread(rsBuf != NULL ? 500 : 20000);
+    }
+}
+
+// CDSC_RIPSHOT_INIT: the EE's rs_ack_t address in, our rs_req_t address out (0 when the thread cannot start)
+int rsIopInit(u32 ee_ack)
+{
+    iop_thread_t t;
+
+    if (ee_ack == 0 || (ee_ack & 15))
+        return 0;
+    rsEeAck = ee_ack;
+    if (rsThreadId < 0) {
+        t.attr = TH_C;
+        t.option = 0;
+        t.thread = &rsThread;
+        t.stacksize = 0x800;
+        t.priority = 0x30;
+        rsThreadId = CreateThread(&t);
+        if (rsThreadId < 0)
+            return 0;
+        StartThread(rsThreadId, NULL);
+    }
+    rsAck.roll_bytes = DeviceRollBytes();
+    rsAck.seq = rsReq.seq;
+    rsSendEE(&rsAck, rsEeAck, sizeof(rsAck)); // the roll's size, and no request outstanding
+    return (int)&rsReq;
+}
