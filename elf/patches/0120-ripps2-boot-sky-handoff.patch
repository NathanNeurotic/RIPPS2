 {
+    // build 120: the sky alone in the theme's colours (see BOOT_FADE_S), where this was the swoop's held first pose
     bootPoseShown = 1;
-    bootFreeze = 1;
-    ripps2DrawPillars();
-    bootFreeze = 0;
+    bootSkyShown = 1;
+    wideUpdate();
+    ripps2PaletteSync();
+    drawSky(RGBA(0x01, 0x02, 0x09, 0x80), RGBA(0x0B, 0x19, 0x4C, 0x80), RGBA(0x02, 0x04, 0x10, 0x80));
 }
 
