+// RIPPS2 build 125: text into an RGBA32 picture, for a screen RIPPS2 does not draw (the video player's). The slot's font
+// is opened again on its own at px pixels, so the GUI's glyph caches and sizes are left as they are. The pen starts at
+// x with the baseline at baseline; each glyph goes over what is there at its coverage times alpha (0 to 0x80), in rgb
+// (0xRRGGBB). With rgba NULL it only measures. Returns the pen's x after the text.
+int fntRenderRGBA(int id, int px, const char *string, unsigned char *rgba, int w, int h, int x, int baseline, u32 rgb, int alpha)
+{
+    FT_Face face = NULL;
+    uint32_t st = UTF8_ACCEPT, cp = 0;
+
+    if (string == NULL || id < 0 || id >= FNT_MAX_COUNT || px <= 0)
+        return x;
+    fntLock();
+    font_t *font = &fonts[id];
+    if (!font->isValid || font->buffer == NULL ||
+        FT_New_Memory_Face(font_library, (FT_Byte *)font->buffer, font->bufferSize, 0, &face) != 0) {
+        fntUnlock();
+        return x;
+    }
+    FT_Set_Pixel_Sizes(face, 0, px);
+    for (; *string; ++string) {
+        if (utf8Decode(&st, &cp, *string))
+            continue;
+        if (FT_Load_Char(face, FNT_CAPS(font, cp), FT_LOAD_RENDER) != 0)
+            continue;
+        FT_GlyphSlot g = face->glyph;
+        if (rgba != NULL) {
+            int gx = x + g->bitmap_left, gy = baseline - g->bitmap_top, r, c;
+            for (r = 0; r < (int)g->bitmap.rows; r++) {
+                int yy = gy + r;
+                if (yy < 0 || yy >= h)
+                    continue;
+                for (c = 0; c < (int)g->bitmap.width; c++) {
+                    int xx = gx + c, a = g->bitmap.buffer[r * g->bitmap.pitch + c] * alpha / 255, da, oa;
+                    unsigned char *d;
+                    if (xx < 0 || xx >= w || a <= 0)
+                        continue;
+                    d = rgba + (yy * w + xx) * 4;
+                    da = d[3] * (0x80 - a) / 0x80;
+                    oa = a + da;
+                    d[0] = (((rgb >> 16) & 0xFF) * a + d[0] * da) / oa;
+                    d[1] = (((rgb >> 8) & 0xFF) * a + d[1] * da) / oa;
+                    d[2] = ((rgb & 0xFF) * a + d[2] * da) / oa;
+                    d[3] = oa;
+                }
+            }
+        }
+        x += g->advance.x >> 6;
+    }
+    FT_Done_Face(face);
+    fntUnlock();
+    return x;
+}
