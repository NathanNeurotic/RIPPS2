+static void vpTexel(const GSTEXTURE *t, int u, int v, unsigned char *px) // RGBA, alpha 0 to 0x80
+{
+    const unsigned char *m = (const unsigned char *)t->Mem;
+    int i;
+    switch (t->PSM) {
+        case GS_PSM_CT32:
+            memcpy(px, m + (v * t->Width + u) * 4, 4);
+            break;
+        case GS_PSM_CT24:
+            memcpy(px, m + (v * t->Width + u) * 3, 3);
+            px[3] = 0x80;
+            break;
+        case GS_PSM_T8: // the palette is stored as the GS reads it: entries 8-15 and 16-23 of every 32 swapped
+            i = m[v * t->Width + u];
+            i = (i & ~0x18) | ((i & 0x08) << 1) | ((i & 0x10) >> 1);
+            memcpy(px, (const unsigned char *)t->Clut + i * 4, 4);
+            break;
+        case GS_PSM_T4: // two to a byte, the left one low
+            i = m[(v * t->Width + u) / 2];
+            i = (u & 1) ? i >> 4 : i & 15;
+            memcpy(px, (const unsigned char *)t->Clut + i * 4, 4);
+            break;
+        default:
+            px[0] = px[1] = px[2] = px[3] = 0;
+    }
+}
