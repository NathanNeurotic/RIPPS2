+// the hint row: Play / Pause, 10 s back and on, Volume, Loop, Stop, centred on a band that darkens toward the bottom
+static void vpPaintHints(int paused, int loop)
+{
+    static const struct
+    {
+        int icon, icon2;
+        const char *word;
+    } row[5] = {{-1, -1, NULL}, {L1_ICON, R1_ICON, "10 s"}, {L2_ICON, R2_ICON, "Volume"}, {START_ICON, -1, NULL}, {-2, -1, "Stop"}};
+    unsigned char *b = vpHints;
+    int font = ripps2HintFontId(), pass, i, x = 0, total = 0, cy = VP_HINT_H / 2 + 2, y;
+    char word[64];
+
+    memset(b, 0, VP_HINT_W * VP_HINT_H * 4);
+    for (y = 0; y < VP_HINT_H; y++) { // the band: clear at the top, about a third dark at the bottom
+        int a = 0x30 * y / VP_HINT_H, xx;
+        for (xx = 0; xx < VP_HINT_W; xx++) {
+            unsigned char *d = b + (y * VP_HINT_W + xx) * 4;
+            d[0] = 0x02;
+            d[1] = 0x03;
+            d[2] = 0x0A;
+            d[3] = a;
+        }
+    }
+    for (pass = 0; pass < 2; pass++) { // measure, then paint centred
+        x = pass ? (VP_HINT_W - total) / 2 : 0;
+        for (i = 0; i < 5; i++) {
+            int icon = row[i].icon, gw;
+            const char *w = row[i].word;
+            if (i == 0) {
+                icon = gSelectButton == KEY_CIRCLE ? CIRCLE_ICON : CROSS_ICON;
+                w = paused ? "Play" : "Pause";
+            } else if (i == 3)
+                w = loop ? "Loop on" : "Loop";
+            else if (icon == -2)
+                icon = gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON;
+            gw = vpGlyph(pass ? b : NULL, VP_HINT_W, VP_HINT_H, icon, x, cy, 18, 0x80);
+            x += gw + 2;
+            if (row[i].icon2 >= 0) {
+                gw = vpGlyph(pass ? b : NULL, VP_HINT_W, VP_HINT_H, row[i].icon2, x, cy, 18, 0x80);
+                x += gw + 4;
+            }
+            x += vpText(pass ? b : NULL, VP_HINT_W, VP_HINT_H, font, 15, ripps2HintCaseText(w, word, sizeof(word)), x, cy + 5,
+                        i == 3 && loop ? 0xFFFFFF : 0xD8DEEC);
+            if (i < 4)
+                x += 18;
+        }
+        total = x;
+    }
+}
