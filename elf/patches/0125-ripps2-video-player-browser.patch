+static float vpEaseOutBack(float x) // ripps2ui.c's easeOutBack
+{
+    const float c1 = 1.70158f, c3 = c1 + 1.0f;
+    return 1.0f + c3 * powf(x - 1.0f, 3.0f) + c1 * powf(x - 1.0f, 2.0f);
