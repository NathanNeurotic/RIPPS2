+// a theme glyph h pixels tall at x, its middle on cy, each pixel the average of the texels it covers; its width
+static int vpGlyph(unsigned char *buf, int bw, int bh, int icon, int x, int cy, int h, int alpha)
+{
+    GSTEXTURE *t = thmGetTexture(icon);
+    int w, X, Y;
+    if (t == NULL || t->Mem == NULL || t->Width == 0 || t->Height == 0 || (t->PSM != GS_PSM_CT32 && t->PSM != GS_PSM_CT24 && t->Clut == NULL))
+        return 0;
+    w = h * t->Width / t->Height;
+    if (buf == NULL)
+        return w;
+    for (Y = 0; Y < h; Y++) {
+        int yy = cy - h / 2 + Y, v0 = Y * t->Height / h, v1 = (Y + 1) * t->Height / h;
+        if (yy < 0 || yy >= bh)
+            continue;
+        if (v1 <= v0)
+            v1 = v0 + 1;
+        for (X = 0; X < w; X++) {
+            int xx = x + X, u0 = X * t->Width / w, u1 = (X + 1) * t->Width / w, r = 0, g = 0, b = 0, a = 0, n = 0, u, v;
+            unsigned char px[4];
+            if (xx < 0 || xx >= bw)
+                continue;
+            if (u1 <= u0)
+                u1 = u0 + 1;
+            for (v = v0; v < v1; v++)
+                for (u = u0; u < u1; u++, n++) {
+                    vpTexel(t, u, v, px);
+                    r += px[0] * px[3];
+                    g += px[1] * px[3];
+                    b += px[2] * px[3];
+                    a += px[3];
+                }
+            if (a > 0)
+                vpOver(buf + (yy * bw + xx) * 4, r / a, g / a, b / a, a / n * alpha / 0x80);
+        }
+    }
+    return w;
+}
+
+// text with a soft shadow under it; its width
+static int vpText(unsigned char *buf, int bw, int bh, int font, int px, const char *text, int x, int baseline, u32 rgb)
+{
+    if (buf != NULL)
+        fntRenderRGBA(font, px, text, buf, bw, bh, x + 1, baseline + 1, 0x000000, 0x50);
+    return fntRenderRGBA(font, px, text, buf, bw, bh, x, baseline, rgb, 0x80) - x;
+}
