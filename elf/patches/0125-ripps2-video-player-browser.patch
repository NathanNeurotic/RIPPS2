+static void vpOver(unsigned char *d, int r, int g, int b, int a) // a (0 to 0x80) over what is there
+{
+    int da, oa;
+    if (a <= 0)
+        return;
+    if (a > 0x80)
+        a = 0x80;
+    da = d[3] * (0x80 - a) / 0x80;
+    oa = a + da;
+    d[0] = (r * a + d[0] * da) / oa;
+    d[1] = (g * a + d[1] * da) / oa;
+    d[2] = (b * a + d[2] * da) / oa;
+    d[3] = oa;
