diff --git a/src/menusys.c b/src/menusys.c
index fc99173..a36fc4c 100644
--- a/src/menusys.c
+++ b/src/menusys.c
@@ -1927,10 +1927,49 @@ static void menuGridStep(int dir)
 // Coverflow rotates the nav axis on the MAIN screen only: Left/Right step through the
 // carousel (a vertical list move) while Up/Down switch device menus. Non-coverflow themes
 // behave exactly as before. The info screen is intentionally NOT rotated (menuHandleInputInfo).
+// RIPPS2 build 97: Right on a row's last cover turns to the next page (the same row, its first cover), Left on a
+// row's first cover back to the previous page (the same row, its last cover). At the first or the last page the
+// cursor stays: the grid no longer wraps on to the next row. 1 when the step was the grid's to make.
+static int menuGridEdge(int dir)
+{
+    int cols = thmGridColumns(), rows = gTheme->gridRows > 0 ? gTheme->gridRows : 1, page, cur = 0, count = 0, col, row, pageStart, target, i;
+    submenu_list_t *p;
+
+    if (cols <= 0 || selected_item == NULL || selected_item->item == NULL)
+        return 0;
+    for (p = selected_item->item->submenu; p != NULL; p = p->next, count++)
+        if (p == selected_item->item->current)
+            cur = count;
+    if (count == 0)
+        return 0;
+    page = cols * rows;
+    col = cur % cols;
+    row = (cur % page) / cols;
+    pageStart = cur - cur % page;
+    if (dir > 0 && (col == cols - 1 || cur == count - 1)) {
+        if (pageStart + page >= count)
+            return 1; // the last page: stay
+        target = pageStart + page + row * cols;
+        if (target > count - 1)
+            target = count - 1;
+    } else if (dir < 0 && col == 0) {
+        if (pageStart == 0)
+            return 1; // the first page: stay
+        target = pageStart - page + row * cols + cols - 1;
+    } else
+        return 0;
+    for (i = cur; i < target; i++)
+        menuNextV();
+    for (i = cur; i > target; i--)
+        menuPrevV();
+    return 1;
+}
+
 static void menuNavigateLeft()
 {
     if (thmGridColumns() > 0) {
-        menuPrevV();
+        if (!menuGridEdge(-1))
+            menuPrevV();
         return;
     }
     if (gTheme->coverflow)
@@ -1942,7 +1981,8 @@ static void menuNavigateLeft()
 static void menuNavigateRight()
