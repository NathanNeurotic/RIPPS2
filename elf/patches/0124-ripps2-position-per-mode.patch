+#ifdef RIPPS2_HANG_WATCH
+// RIPPS2 build 124, a test build only: at the top priority, every 2 s, each live thread's priority, state and what it
+// waits on (type and id), so a freeze shows which thread holds the CPU and which waits behind it
+extern void *_gp;
+static u8 hangWatchStack[0x1000] __attribute__((aligned(16)));
+
+static void hangWatch(void *arg)
+{
+    ee_thread_status_t st;
+    int id, tick = 0;
+
+    for (;;) {
+        DelayThread(2000 * 1000);
+        LOG("HANGWATCH %d s:", 2 * ++tick);
+        for (id = 1; id < 64; id++) {
+            if (ReferThreadStatus(id, &st) < 0 || (st.status & THS_DORMANT))
+                continue;
+            LOG(" [%d p%d s%x w%d/%d f%p]", id, st.current_priority, st.status, st.wait_type, st.wait_id, st.func);
+        }
+        LOG("\n");
+    }
+}
+
+static void hangWatchStart(void)
+{
+    ee_thread_t t;
+    int id;
+
+    memset(&t, 0, sizeof(t));
+    t.func = (void *)hangWatch;
+    t.stack = hangWatchStack;
+    t.stack_size = sizeof(hangWatchStack);
+    t.gp_reg = &_gp;
+    t.initial_priority = 1;
+    id = CreateThread(&t);
+    if (id >= 0)
+        StartThread(id, NULL);
+}
+#endif
+
 static void init(void)
 {
+#ifdef RIPPS2_HANG_WATCH
+    hangWatchStart();
+#endif
     // default variable values
     setDefaults();
 
