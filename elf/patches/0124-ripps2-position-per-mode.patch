diff --git a/src/opl.c b/src/opl.c
index 3643974..15c82c3 100644
--- a/src/opl.c
+++ b/src/opl.c
@@ -262,6 +262,31 @@ int gVMode; // 0 - Auto, 1 - PAL, 2 - NTSC
 int gXOff;
 int gYOff;
 int gOverscan;
+// RIPPS2 build 124 (the user, 10/28): the picture's position for each video mode (H-POS, V-POS, Overscan), so 1080i and
+// 480i each keep their own centring. A mode never set takes the shared values (xoff, yoff, overscan), which are still
+// written as the mode in use's, so an older build and BIBLE's early read see what they always did.
+#define RIPPS2_POS_MODES 16
+static int gPosX[RIPPS2_POS_MODES], gPosY[RIPPS2_POS_MODES], gPosOver[RIPPS2_POS_MODES];
+static unsigned char gPosSet[RIPPS2_POS_MODES];
+
+void ripps2PosRecall(int vmode)
+{
+    if (vmode < 0 || vmode >= RIPPS2_POS_MODES || !gPosSet[vmode])
+        return; // never set for this mode: the current values carry over, as before
+    gXOff = gPosX[vmode];
+    gYOff = gPosY[vmode];
+    gOverscan = gPosOver[vmode];
+}
+
+void ripps2PosStore(int vmode)
+{
+    if (vmode < 0 || vmode >= RIPPS2_POS_MODES)
+        return;
+    gPosX[vmode] = gXOff;
+    gPosY[vmode] = gYOff;
+    gPosOver[vmode] = gOverscan;
+    gPosSet[vmode] = 1;
+}
 int gSelectButton;
 int gHDDGameListCache;
 int gEnableSFX;
