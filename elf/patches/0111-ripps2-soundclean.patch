+            found = fromTheme[i] = stat(path, &st) == 0;
+        }
+        for (covered = 0, f = sfxFallback[i]; f >= 0 && f < SFX_COUNT && !covered; f = sfxFallback[f])
+            covered = fromTheme[f];
+        if (!found && audioDir != NULL && !covered) {
+            snprintf(path, sizeof(path), "%s/%s", audioDir, sfx_files[i].name);
+            found = stat(path, &st) == 0;
+        }
+        if (found) {
+            for (s = path; *s; s++)
+                h = (h ^ (unsigned char)*s) * 16777619u;
+            h = (h ^ ((unsigned int)st.st_size ^ ((unsigned int)st.st_mtime * 2654435761u))) * 16777619u;
+        }
+        h = (h ^ 0xffu) * 16777619u;
+    }
