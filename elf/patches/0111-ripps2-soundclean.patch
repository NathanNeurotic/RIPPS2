+/* RIPPS2 build 111 (tester lukeatmynose on build 110: "whenever a memory card is inserted, the system prioritizes saving
+   to it, ignoring the specified save location"). Build 100 loads RIPPS2's own save on a card first unless config.path
+   says otherwise, and config.path sits beside the ELF, where at that moment it can be out of reach (an APA boot before
+   its partition is mounted, a drive still coming up): the card's old settings won, Save Settings To read Memory Card
+   again, and the next save went to the card. A save to another home now leaves the same pointer in each card's RIPPS2
+   folder, which the card check is sure to see; choosing Memory Card again takes every pointer away at its save, so it
+   sticks (config.path was never removed, so a later boot followed it back to the drive). */
+static int ripps2CardRedirectOpen(void)
+{
+    int k, boot = !strncmp(gBootDir, "mc1:", 4) ? 1 : 0, fd;
+    char path[40];
+
+    for (k = 0; k < 2; k++) {
+        snprintf(path, sizeof(path), "mc%d:/RIPPS2/%s", k ? 1 - boot : boot, configPathRedirectFile);
+        if ((fd = open(path, O_RDONLY)) >= 0)
+            return fd;
+    }
+    return -1;
+}
+
+static void ripps2CardRedirectWrite(const char *path)
+{
+    int slot, fd, ok;
+    char dir[16], file[40];
+    DIR *d;
+
+    for (slot = 0; slot < 2; slot++) {
+        snprintf(dir, sizeof(dir), "mc%d:/RIPPS2", slot);
+        if ((d = opendir(dir)) == NULL)
+            continue; // no RIPPS2 save on this card: nothing there to win over the chosen home
+        closedir(d);
+        snprintf(file, sizeof(file), "%s/%s", dir, configPathRedirectFile);
+        ok = 0;
+        if ((fd = open(file, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+            ok = write(fd, path, strlen(path)) == (int)strlen(path) && write(fd, "\n", 1) == 1;
+            close(fd);
+        }
+        LOG("CONFIG %s settings pointer %s -> %s\n", ok ? "left" : "could not leave", file, path);
+    }
+}
