index 0000000..2cf5907
--- /dev/null
+++ b/.github/scripts/test_ra_udpfs_check.py
@@ -0,0 +1,42 @@
+"""RA: check game support runs on UDPFS games instead of refusing.
+
+With ranet.c's mstack: link (test_ra_mstack_link.py) the support check reaches the PC while a
+UDPFS chain owns the NIC, so menuCheckSelectedGameSupport no longer refuses UDPFS_MODE: UDPFS
+Files games take the generic branch (hash through udpfs:/, watch list saved to udpfs:/RA/), like
+UDPFS IMG games on BDM pages already did. The old refusal label stays in the language file
+(append-only rule).
+"""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+menusys = (ROOT / "src/menusys.c").read_text(encoding="utf-8")
+udpfs = (ROOT / "src/udpfssupport.c").read_text(encoding="utf-8")
+base = (ROOT / "lng_tmpl/_base.yml").read_text(encoding="utf-8")
+
+start = menusys.index("void menuCheckSelectedGameSupport(")
+end = menusys.index("\n}\n", start) + 3
+check = menusys[start:end]
+
+assert "UDPFS_MODE" not in check, "UDPFS_MODE still refused by the support check"
+assert "_STR_RA_NA_UDPFS" not in check, "the UDPFS refusal notice is still shown"
+generic = check.index("support->itemGet != NULL && support->itemGetPrefix != NULL")
+assert "sbHashGameDeferred(prefix, g->name, g->extension, g->startup, g->format)" in check[generic:]
+
+# The generic branch is reachable for UDPFS: its item table provides both callbacks.
+assert "&udpfsGetGame," in udpfs and "&udpfsGetPrefix," in udpfs
+assert "- label: RA_NA_UDPFS" in base
+
+print("PASS: the RA support check hashes UDPFS games through the generic branch")
+
+# A watch list that reached memory but could not be saved (read-only share) must not be shown as
+# plain success: the launch reads the file. raAskPC puts the notice's second line in info2.
+ranet = (ROOT / "src/ranet.c").read_text(encoding="utf-8")
+ask = ranet[ranet.index("int raAskPC("):]
+ask = ask[:ask.index("\n}\n")]
+save = ask[ask.index("if (saved == 0)"):]
+assert "_STR_RA_WL_NOT_SAVED" in save[:save.index("}")], "an unsaved watch list is reported as success"
+assert "- label: RA_WL_NOT_SAVED" in base
+assert base.index("- label: RA_WL_NOT_SAVED") > base.index("- label: CAD_PAIR_UDPFS")
+assert base.index("- label: RA_UDPFS_LOAD_FIRST") > base.index("- label: RA_WL_NOT_SAVED")
+assert base.index("- label: CAD_UDPFS_IMG") > base.index("- label: RA_WL_NOT_SAVED")
+print("PASS: an unsaved watch list is reported")
diff --git a/.github/scripts/test_ra_verified_peer.py b/.github/scripts/test_ra_verified_peer.py
new file mode 100644
index 0000000..2a0abd6
--- /dev/null
+++ b/.github/scripts/test_ra_verified_peer.py
@@ -0,0 +1,119 @@
+"""Compile the real verified-peer cache used for in-game passive RA networking.
+
+A random successful UDP read is not proof of a valid RA peer. A previously
+confirmed peer is discarded on mode/host changes or network settings apply.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/ranet.c").read_text()
+start = source.index("static u32 g_raReplyIP;")
+end = source.index("static unsigned char g_wl[RA_MAX_BYTES];", start)
+peer = source[start:end]
+assert "raNetForgetPeer();" in source[source.index("int raAskPC("):source.index("    if (raNetNicBusy())",source.index("int raAskPC("))]
+assert "raNetRememberPeer(g_raReplyIP);" in source
+# The link test remembers the peer ask() accepted; ask() owns the source check on both links.
+def function(signature):
+    fn = source[source.index(signature):]
+    return fn[:fn.index("\n}\n")]
+
+
+testlink = function("int raNetTestLink(")
+assert testlink.count("raNetRememberPeer(g_raReplyIP);") == 1 and "from.sin_addr" not in testlink
+assert "from.sin_addr.s_addr != to->sin_addr.s_addr" in function("static int ask(int sock")
+assert "g_xreply.src_ip != to->sin_addr.s_addr" in function("static int ask_mstack(")
+assert "raNetForgetPeer();" in (root/"src/gui.c").read_text()
+launch = source[source.index("void raLaunchNetworkUp("):source.index("int raNetTestLink(")]
+busy_guard = launch[launch.index("if (raNetNicBusy())"):launch.index("sock = socket(")]
+assert "ClearWatchList();" in busy_guard and "raNetForgetPeer();" in busy_guard, (
+    "UDPBD/UDPFS launches must not retain live telemetry while owning the NIC"
+)
+harness = r"""
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t u32;
+typedef uint8_t u8;
+#define INADDR_BROADCAST 0xffffffffu
+#define htonl(x) (x)
+#define RA_MODE_CADUCEUS 1
+static int gRAMode;
+static int pc_ip[4] = {192, 168, 1, 10};
+static int gRAHostIp[4];
+"""
+harness += peer
+harness += r"""
+int main(void) {
+    gRAMode=RA_MODE_CADUCEUS;
+    assert(!raHostIsExplicit());
+    g_raReplyIP=42;
+    assert(raNetPeerIP()==0); /* Unvalidated datagram is never a launch peer. */
+    raNetRememberPeer(42);
+    assert(raNetPeerIP()==42);
+    gRAMode=0;
+    assert(raNetPeerIP()==0); /* Can't reuse a Caduceus host as Xerabora. */
+    gRAMode=RA_MODE_CADUCEUS;
+    assert(raNetPeerIP()==42);
+    for(int i=0;i<4;i++) {
+        pc_ip[i]++; assert(raNetPeerIP()==0); pc_ip[i]--;
+        assert(raNetPeerIP()==42);
+    } /* Every production int octet participates in cache binding. */
+    gRAHostIp[0]=10;
+    assert(raHostIsExplicit());
+    assert(raNetPeerIP()==0); /* Changing the dedicated companion invalidates it too. */
+    gRAHostIp[0]=0;
+    raNetForgetPeer();
+    assert(raNetPeerIP()==0);
+    raNetRememberPeer(INADDR_BROADCAST);
+    assert(raNetPeerIP()==0);
+    raNetRememberPeer(0);
+    assert(raNetPeerIP()==0);
+    puts("PASS: only verified peers, mode/SMB-host binding, explicit invalidation, no broadcast/zero");
+    return 0;
+}
+"""
+with tempfile.TemporaryDirectory(prefix="ra-verified-peer-") as tmp:
+    path = Path(tmp) / "peer.c"
+    exe = Path(tmp) / "peer"
+    path.write_text(harness)
+    subprocess.run(["cc", "-std=gnu99", "-Wall", "-Werror", str(path), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
+
+# Compile the actual link-reply condition. A malformed RAO1 prefix must not
+# become a trusted destination. (Foreign sources never reach it: ask() drops
+# them on both links, checked above and in test_ra_mstack_link.py.)
+start_reply = source.index('if (got >= 8 && strncmp(rx, "RAO1 OK ", 8) == 0')
+end_reply = source.index("found = 1;", start_reply)
+condition = source[start_reply:end_reply].strip()[3:].strip()
+link_harness = r"""
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t u32;
+#define INADDR_BROADCAST 0xffffffffu
+#define htonl(x) (x)
+static int accepted(const char *rx, int got, u32 target, u32 sender) {
+    (void)target; (void)sender;
+    return @PREDICATE@;
+}
+int main(void) {
+    const char *ok="RAO1 OK test";
+    assert(accepted(ok,strlen(ok),INADDR_BROADCAST,42));
+    assert(accepted(ok,strlen(ok),42,42));
+    assert(!accepted("RAO1 FAIL",9,INADDR_BROADCAST,42));
+    assert(!accepted("RAO1 BAD",8,42,42));
+    assert(!accepted("RAO1",4,INADDR_BROADCAST,42));
+    puts("PASS: only valid RAO1 OK replies establish a link");
+    return 0;
+}
+""".replace("@PREDICATE@", condition)
+with tempfile.TemporaryDirectory(prefix="ra-link-peer-") as tmp:
+    src=Path(tmp)/"link.c"
+    exe=Path(tmp)/"link"
+    src.write_text(link_harness)
+    subprocess.run(["cc","-std=gnu99","-Wall","-Werror",str(src),"-o",str(exe)],check=True)
+    subprocess.run([str(exe)],check=True)
