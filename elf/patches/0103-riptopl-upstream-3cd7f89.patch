diff --git a/.github/scripts/prepare_korium_background_diagnostic.py b/.github/scripts/prepare_korium_background_diagnostic.py
new file mode 100644
index 0000000..c5abb94
--- /dev/null
+++ b/.github/scripts/prepare_korium_background_diagnostic.py
@@ -0,0 +1,75 @@
+"""Prepare a controlled background comparison from the exact Beta 3608 source.
+
+Both variants suppress per-game BG requests without changing saved settings. The
+single-pass variant restores opaque background alpha and disables the duplicate
+main1 plate, retaining the released PNG/palette. This is not a production fix.
+"""
+import argparse
+import hashlib
+from pathlib import Path
+import subprocess
+
+RELEASE = "d41785a6e455637188234d9e3ad9b3a3590a24a2"
+BACKGROUND_SHA = "70398bd373ec92cf97e6991cc8db5f76b1ebfce66381b83f69c8bd5c8c698537"
+
+
+def prepare(root, variant):
+    root = Path(root)
+    head = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
+    if head != RELEASE:
+        raise RuntimeError("Diagnostic requires the exact Beta 3608 Korium source")
+    background = root / "gfx/background.png"
+    if hashlib.sha256(background.read_bytes()).hexdigest() != BACKGROUND_SHA:
+        raise RuntimeError("Unexpected release background; refusing to patch")
+    source = root / "src/themes.c"
+    text = source.read_text()
+    gate = 'cache->suffix != NULL && strcmp(cache->suffix, "BG") == 0 && !gEnableBGArt'
+    if text.count(gate) != 1:
+        raise RuntimeError("Unexpected BG admission gate")
+    configs = [root / "misc" / name for name in ("conf_theme_OPL.cfg", "theme_coverflow.cfg")]
+    blocks = []
+    for config in configs:
+        cfg = config.read_text()
+        block = "main1:\n\ttype=StaticImage\n\tdefault=background\n"
+        if cfg.count(block) != 1:
+            raise RuntimeError("Unexpected background plate in " + str(config))
+        blocks.append((config, cfg, block))
+    # Keep the released compressed PNG, palette ordering and indices identical.
+    # Change only the decoded background alpha, not the general PNG decoder.
+    textures = root / "src/textures.c"
+    texture_text = textures.read_text()
+    clut = "            png_get_tRNS(pngPtr, infoPtr, &pngTexture.trans, &pngTexture.numTrans, NULL);\n"
+    if texture_text.count(clut) != 1:
+        raise RuntimeError("Unexpected palette conversion")
+    # Validate every input before modifying the isolated build checkout.
+    if variant == "single-pass":
+        texture_text = texture_text.replace(clut, clut +
+            "            if (texId == BACKGROUND_PICTURE)\n"
+            "                pngTexture.numTrans = 0; // Diagnostic: opaque built-in fallback only.\n")
+    source.write_text(text.replace(gate, 'cache->suffix != NULL && strcmp(cache->suffix, "BG") == 0'))
+    if variant == "single-pass":
+        textures.write_text(texture_text)
+        for config, cfg, block in blocks:
+            config.write_text(cfg.replace(block, block + "\tenabled=0\n"))
+    manifest = (
+        "KORIUM BACKGROUND DIAGNOSTIC - NOT A RELEASE\n"
+        "Source: " + RELEASE + "\nVariant: " + variant + "\n"
+        "Per-game BG lookup: suppressed in both variants; saved setting untouched.\n"
+        "Use the built-in OPL or Coverflow theme. External themes are not this comparison.\n"
+        "Compare on the same console/display at the same video mode, then repeat in\n"
+        "a 24-bit mode (480p or VGA) and a 16-bit mode (720p or 1080i).\n"
+        "Control: released two translucent passes. Single-pass: opaque background alpha,\n"
+        "duplicate main1 disabled. Grain is retained in both; this isolates composition.\n"
+        "The released PNG bytes and palette are identical in both variants.\n"
+        "No RA changes from PR 894 are included. No hardware result is claimed.\n"
+    )
+    (root / "KORIUM-BACKGROUND-DIAGNOSTIC.txt").write_text(manifest)
+    print(manifest)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path)
+    parser.add_argument("variant", choices=("control", "single-pass"))
+    args = parser.parse_args()
+    prepare(args.root, args.variant)
diff --git a/.github/scripts/publish_ra_release.py b/.github/scripts/publish_ra_release.py
new file mode 100644
index 0000000..20d26f2
--- /dev/null
+++ b/.github/scripts/publish_ra_release.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Publish a validated two-theme RA asset set without changing standard releases."""
+import argparse
+import hashlib
+import json
+import re
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+TAG = "rolling-ra"
+THEMES = ("inceBtion", "Korium")
+# GitHub's release API intermittently answers 5xx (a 500 once cost the standard release its loose ELF
+# mid-publish, #855). Every call below is safe to repeat, so retry before giving up.
+RETRY_DELAYS = (5, 15)
+
+
+def gh(*args):
+    for delay in (*RETRY_DELAYS, None):
+        try:
+            return subprocess.check_output(["gh", *args], text=True).strip()
+        except subprocess.CalledProcessError:
+            if delay is None:
+                raise
+            print(f"gh {args[0]} {args[1] if len(args) > 1 else ''} failed; retrying in {delay}s", file=sys.stderr)
+            time.sleep(delay)
+
+
+def validate(folder):
+    manifest = json.loads((folder / "RA-RELEASE.json").read_text())
+    if manifest.get("preview", True):
+        raise ValueError("preview packages cannot be published")
+    version = manifest["version"]
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", version):
+        raise ValueError("unsafe release version")
+    revision = manifest["revision"]
+    if not re.fullmatch(r"[0-9a-f]{40}", revision) or manifest["themes"] != list(THEMES):
+        raise ValueError("release requires both themes and a full source SHA")
+    required = {f"RIPTOPL-RetroAchievements-{version}-src.zip"}
+    for theme in THEMES:
+        required.update((f"RIPTOPL-RA-{theme}.ELF", f"APP_RIPTOPL-RA-{theme}.psu",
+                         f"RIPTOPL-RetroAchievements-{theme}-{version}.zip"))
+    if set(manifest["assets"]) != required:
+        raise ValueError("incomplete or unexpected RA asset set")
+    if {file.name for file in folder.iterdir()} != required | {"RA-RELEASE.json", "SHA256SUMS.txt"}:
+        raise ValueError("unexpected publication files")
+    for name, expected in manifest["assets"].items():
+        if hashlib.sha256((folder / name).read_bytes()).hexdigest() != expected:
+            raise ValueError(f"release digest mismatch: {name}")
+    sums = "".join(f"{hashlib.sha256(file.read_bytes()).hexdigest()}  {file.name}\n"
+                   for file in sorted(folder.iterdir()) if file.name != "SHA256SUMS.txt")
+    if (folder / "SHA256SUMS.txt").read_text() != sums:
+        raise ValueError("release checksum manifest mismatch")
+    return revision
+
+
+def publish(folder, notes, repository):
+    revision = validate(folder)
+    # A queued older run must never replace a newer standard revision's RA release.
+    current = json.loads(gh("api", f"repos/{repository}/git/ref/tags/rolling"))["object"]["sha"]
+    if current != revision:
+        raise ValueError("standard rolling revision changed; refusing stale RA publication")
+    releases = json.loads(gh("api", "--paginate", "--slurp", f"repos/{repository}/releases?per_page=100"))
+    existing = next((release for page in releases for release in page if release["tag_name"] == TAG), None)
+    assets = sorted(folder.iterdir())
+    title = "RiptOPL RetroAchievements — inceBtion & Korium (experimental)"
+    with tempfile.TemporaryDirectory() as backup:
+        if existing:
+            # Back up every clobbered name before mutation. Restore all of them,
+            # including successfully uploaded earlier files, if any upload fails.
+            previous = {asset["name"] for asset in existing["assets"]}
+            replaced = sorted(previous & {asset.name for asset in assets})
+            for name in replaced:
+                gh("release", "download", TAG, "--repo", repository, "--pattern", name, "--dir", backup)
+            try:
+                for asset in assets:
+                    gh("release", "upload", TAG, str(asset), "--repo", repository, "--clobber")
+                gh("release", "edit", TAG, "--repo", repository, "--title", title,
+                   "--notes-file", str(notes), "--latest=false", "--prerelease", "--draft=false")
+            except subprocess.CalledProcessError:
+                for name in replaced:
+                    gh("release", "upload", TAG, str(Path(backup) / name), "--repo", repository, "--clobber")
+                # Keep the previous full kits and tag; cleanup is only after success.
+                raise
+            for name in sorted(previous - {asset.name for asset in assets}):
+                # The complete new set is already published. A stale extra file left by a failed delete
+                # is harmless and the next publication removes it; it must not skip the tag update.
+                try:
+                    gh("release", "delete-asset", TAG, name, "--repo", repository, "--yes")
+                except subprocess.CalledProcessError:
+                    print(f"warning: could not delete stale asset {name}", file=sys.stderr)
+        else:
+            # Draft first: users cannot see a partial first publication.
+            gh("release", "create", TAG, *map(str, assets), "--repo", repository,
+               "--target", revision, "--title", title, "--notes-file", str(notes),
+               "--draft", "--prerelease", "--latest=false")
+            gh("release", "edit", TAG, "--repo", repository, "--draft=false", "--latest=false")
+        gh("api", "--method", "PATCH", f"repos/{repository}/git/refs/tags/{TAG}",
+           "-f", f"sha={revision}", "-F", "force=true")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--assets", type=Path, required=True)
+    parser.add_argument("--notes", type=Path, required=True)
+    parser.add_argument("--repository", required=True)
+    args = parser.parse_args()
+    publish(args.assets, args.notes, args.repository)
+
+
+if __name__ == "__main__":
+    main()
