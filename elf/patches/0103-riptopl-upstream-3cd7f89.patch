@@ -0,0 +1,148 @@
+"""Compile real EE-core RA resource paths against controlled IOP-heap failures.
+
+The optional achievements module must never trap a game in MODLOAD's -400 loop.
+The snapshot buffer must be proportional to this game's watch list, with
+strict bounds on pointer-chain pairs and full cleanup on module-load failure.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+iop = (root / "ee_core/src/iopmgr.c").read_text()
+mod = (root / "ee_core/src/modmgr.c").read_text()
+
+
+def function(source, signature):
+    begin = source.index(signature)
+    return source[begin:source.index("\n}", begin) + 2]
+
+
+wanted = function(iop, "static int RA_TelemetryWanted(struct EECoreConfig_t *config)")
+hex32 = function(iop, "static void RA_Hex32(unsigned int v, char *out)")
+special_reset = function(iop, "static int ResetIopSpecial(")
+load_begin = special_reset.index("    ra_snap_iop = 0;\n    if (RA_TelemetryWanted(config)")
+load_end = special_reset.rindex("\n#endif")
+load_body = special_reset[load_begin:load_end]
+module_loader = function(mod, "int LoadOPLModule(int id, int mode, int arg_len, const char *args)")
+
+# Runtime opt-in is required before reserving card storage or installing
+# the observational GS tracker. Compile-time availability alone is insufficient.
+for path, guard in [
+    ("src/rawatch.c", "#if RA_EXPERIMENTAL_CARD_DMA\n    if (gRAMode == RA_MODE_CADUCEUS && gRAExperimentalCards == 1)"),
+    ("ee_core/src/main.c", "#if defined(RETROACHIEVEMENTS) && RA_EXPERIMENTAL_CARD_DMA\n    if (!config->EnableGSMOp"),
+    ("ee_core/src/padhook.c", "#if defined(RETROACHIEVEMENTS) && RA_EXPERIMENTAL_CARD_DMA\n        else if (config->raOverlayBuf)"),
+]:
+    assert guard in (root / path).read_text(), f"production GS guard missing in {path}"
+
+harness = r"""
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "modules/network/common/ra_snap.h"
+#define RETROACHIEVEMENTS 1
+#define RA_PROBE 0
+#define IPCONFIG_MAX_LEN 128
+#define ETH_MODE 3
+#define HTTP_MODE 4
+#define OPL_MODULE_ID_RAUDP 111
+#define OPL_MODULE_ID_PCCF 60
+#define MODMGR 0
+#define BGCOLND(...) ((void)0)
+#define DBGCOL(...) ((void)0)
+#define DBGCOL_BLNK(...) ((void)0)
+typedef struct EECoreConfig_t {
+    const unsigned *raWatchList;
+    int raWatchCount, raSnapBytes, raNodeCount;
+    void *raSnapBuf;
+    char GameID[16], raHost[16];
+    int GameMode, raClientMode, raHostPinned;
+} EECoreConfig_t;
+static int moduleStartResult;
+static int EnableDebug, module_result, module_calls, allocations, frees, fail_alloc;
+static unsigned last_size, ra_snap_iop;
+static char last_args[256], g_ipconfig[IPCONFIG_MAX_LEN];
+static int g_ipconfig_len;
+static char buffer[RA_SNAP_TOTAL];
+static char module_data[8];
+static void delay(int n) { (void)n; }
+static void *SifAllocIopHeap(unsigned n) {
+    allocations++;
+    last_size = n;
+    assert(n <= sizeof(buffer));
+    return fail_alloc ? NULL : buffer;
+}
+static void SifFreeIopHeap(void *p) { assert(p == buffer); frees++; }
+static int GetOPLModInfo(int id, void **p, unsigned *size) {
+    assert(id == OPL_MODULE_ID_RAUDP);
+    *p = module_data;
+    *size = sizeof(module_data);
+    return 0;
+}
+static int LoadMemModule(int mode, void *p, unsigned size, int argc, const char *args) {
+    assert(mode == 0 && p == module_data && size == sizeof(module_data));
+    assert(argc < (int)sizeof(last_args));
+    memcpy(last_args, args, argc);
+    last_args[argc] = '\0';
+    module_calls++;
+    return module_result;
+}
+static void *RA_OverlayEventBuffer(void) { return module_data; }
+"""
+harness += wanted + "\n" + hex32 + "\n" + module_loader + "\n"
+harness += "static void load_ra(EECoreConfig_t *config) {\n" + load_body + "\n}\n"
+harness += r"""
+static unsigned watch[10];
+static void reset(void) {
+    EnableDebug=0; module_result=1; module_calls=allocations=frees=fail_alloc=0;
+    last_size=0; ra_snap_iop=0; last_args[0]=0;
+}
+int main(void) {
+    EECoreConfig_t c;
+    memset(&c,0,sizeof(c));
+    c.raWatchList=watch; c.raWatchCount=10; c.raSnapBytes=697;
+    c.raSnapBuf=buffer; c.GameMode=3;
+    c.raClientMode=1;
+    strcpy(c.GameID,"SLUS_212.69");
+    strcpy(c.raHost,"192.168.1.5");
+    reset(); load_ra(&c);
+    assert(allocations==1 && module_calls==1 && !frees);
+    assert(last_size==RA_SNAP_TOTAL_FOR(697) && last_size<RA_SNAP_TOTAL);
+    assert(last_args[RA_ARG_RX]=='2' && ra_snap_iop);
+    puts("PASS: small Caduceus watch list uses only its own rounded snapshot capacity");
+
+    reset(); c.raNodeCount=3; load_ra(&c);
+    assert(last_size==RA_SNAP_TOTAL_FOR(697+3*RA_NODE_PAIR_BYTES));
+    puts("PASS: pointer-chain value pairs are included");
+
+    reset(); c.raSnapBytes=RA_SNAP_MAX_BYTES; load_ra(&c);
+    assert(!allocations && !module_calls && !ra_snap_iop);
+    puts("PASS: oversize snapshot+nodes never enters IOP heap");
+
+    c.raSnapBytes=697; c.raNodeCount=0;
+    reset(); c.raWatchCount=0; load_ra(&c);
+    assert(!allocations && !module_calls);
+    c.raWatchCount=10;
+    reset(); fail_alloc=1; load_ra(&c);
+    assert(allocations==1 && module_calls==0 && ra_snap_iop==0);
+    puts("PASS: untracked or out-of-memory launches remain untracked");
+
+    reset(); module_result=-400; load_ra(&c);
+    assert(allocations==1 && module_calls==1 && frees==1 && ra_snap_iop==0);
+    puts("PASS: optional RAUDP -400 failure does not hang and releases IOP heap");
+
+    reset(); c.GameMode=0; c.raClientMode=0; load_ra(&c);
+    assert(last_args[RA_ARG_RX]=='1');
+    puts("PASS: legacy xeRAbora client flags still select the same RA module");
+
+    return 0;
+}
+"""
+with tempfile.TemporaryDirectory(prefix="ra-launch-resources-") as temp:
+    src = Path(temp) / "ra-launch-resources.c"
+    exe = Path(temp) / "ra-launch-resources"
+    src.write_text(harness)
+    subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wno-pointer-to-int-cast", "-I", str(root),
+                    str(src), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
diff --git a/.github/scripts/test_ra_mstack_link.py b/.github/scripts/test_ra_mstack_link.py
new file mode 100644
index 0000000..c55738e
--- /dev/null
+++ b/.github/scripts/test_ra_mstack_link.py
@@ -0,0 +1,246 @@
+"""RA menu requests go through the ministack's mstack: device while a UDPFS chain owns the NIC.
+
+The menu's lwIP stack cannot run while UDPFS holds the adapter, so src/ranet.c opens a "link"
+instead of a socket: a real socket when the NIC is free, the RA_LINK_MSTACK sentinel when the NIC
+is reserved and udpfs_ministack's mstack: device answers, else RA_LINK_BUSY (-8, "network busy").
+ask() runs each attempt as one devctl on the mstack link, with the same retry count, the same
+reply-source filtering and the same g_raReplyIP as the socket path. ask(), open_pc_link() and
+close_pc_link() are compiled from src/ranet.c against stubs.
+"""
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ranet = (ROOT / "src/ranet.c").read_text(encoding="utf-8")
+
+
+def body(signature):
+    start = ranet.index(signature)
+    end = ranet.index("\n}\n", start) + 3
+    return ranet[start:end]
+
+
+def until(signature, marker):
+    fn = body(signature)
+    return fn[:fn.index(marker)] if marker in fn else fn
+
+
+source = "\n".join(body(sig) for sig in (
+    "static int ask_mstack(",
+    "static int ask(",
+    "static int open_pc_link(",
+    "static void close_pc_link(",
+    "int raCaduceusPage(",
+))
+
+harness = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "modules/network/udpfs_ministack/include/mstack_xchg.h"
+#include "modules/network/common/ra_client.h"
+typedef unsigned int u32;
+typedef unsigned char u8;
+typedef int socklen_t;
+#define RA_TRY 12
+#define RA_POLL_MS 25
+#define RA_RECV_MAX 992
+#define RA_MY_PORT 18196
+#define RA_MSG_DONTWAIT 0x08
+#define INADDR_BROADCAST 0xFFFFFFFFu
+#define RA_LINK_MSTACK 0x10000
+#define RA_LINK_BUSY (-8)
+struct sockaddr { int x; };
+struct sockaddr_in { int sin_family; unsigned short sin_port; struct { u32 s_addr; } sin_addr; };
+static u32 htonl(u32 v) { return v; }
+static unsigned short htons(unsigned short v) { return (unsigned short)((v >> 8) | (v << 8)); }
+static unsigned short ntohs(unsigned short v) { return htons(v); }
+static u32 g_raReplyIP;
+static mstack_xchg_req_t g_xreq;
+static mstack_xchg_reply_t g_xreply;
+static int reserved, sends, recvs, closes, ethinits, probe = 1, get_ip_ok = 1;
+int ps2_ip[4] = {192, 168, 1, 10};
+static int raNetNicReserved(void) { return reserved; }
+static int open_pc_socket(char *myaddr, int sz, u8 ip[4]) { (void)ip; snprintf(myaddr, sz, " 10.0.0.2 18196"); return 5; }
+static int ethLoadInitModules(void) { ethinits++; return 0; }
+static void disconnect(int s) { assert(s == 5); closes++; }
+static int sendto(int s, const char *b, int n, int f, struct sockaddr *a, int l) { (void)s; (void)b; (void)f; (void)a; (void)l; sends++; return n; }
+static int recvfrom(int s, char *b, int n, int f, struct sockaddr *a, socklen_t *l) { (void)s; (void)b; (void)n; (void)f; (void)a; (void)l; recvs++; return -1; }
+static void DelayThread(int us) { (void)us; }
+#define RA_MODE_CADUCEUS 1
+static int gRAMode = RA_MODE_CADUCEUS;
+static char g_rx[2048];
+static int caduceus_target(struct sockaddr_in *to) { memset(to, 0, sizeof(*to)); to->sin_port = htons(RA_CADUCEUS_PORT); to->sin_addr.s_addr = 0x1401a8c0u; return 1; }
+static int ports[16];
+/* Scripted mstack: device. Each UDP_XCHG call takes the next scripted reply (src 0 = timeout). */
+static int xchgs, script_n;
+static u32 script_src[16];
+static const char *script_text[16];
+static int script_len[16];
+static mstack_xchg_req_t last_req;
+static unsigned int last_arglen;
+static int fileXioDevctl(const char *name, int cmd, void *arg, unsigned int arglen, void *buf, unsigned int buflen)
+{
+    assert(!strcmp(name, "mstack:"));
+    if (cmd == MSTACK_DEVCTL_VERSION)
+        return probe;
+    if (cmd == MSTACK_DEVCTL_GET_IP) {
+        static const unsigned char real[4] = {10, 0, 0, 9};
+        assert(buf != NULL && buflen >= 4);
+        if (!get_ip_ok)
+            return -22;
+        memcpy(buf, real, 4);
+        return 4;
+    }
+    assert(cmd == MSTACK_DEVCTL_UDP_XCHG && buflen >= sizeof(mstack_xchg_reply_t));
+    memcpy(&last_req, arg, arglen);
+    last_arglen = arglen;
+    if (xchgs < 16)
+        ports[xchgs] = last_req.dst_port;
+    int i = xchgs++;
+    if (i >= script_n || script_src[i] == 0)
+        return -116; /* -ETIMEDOUT */
+    mstack_xchg_reply_t *r = buf;
+    int len = script_len[i] ? script_len[i] : (int)strlen(script_text[i]);
+    r->src_ip = script_src[i];
+    r->len = (unsigned short)len;
+    if (script_len[i])
+        memset(r->data, 'z', len);
+    else
+        memcpy(r->data, script_text[i], len);
+    return len;
+}
+'''
+
+tests = r'''
+#define IP20 0x1401a8c0u /* 192.168.1.20 as sin_addr.s_addr on little endian */
+#define IP21 0x1501a8c0u
+#define IP77 0x4d01a8c0u
+static struct sockaddr_in target(u32 ip) { struct sockaddr_in t; memset(&t, 0, sizeof(t)); t.sin_port = htons(18194); t.sin_addr.s_addr = ip; return t; }
+static void reset(void) { xchgs = script_n = sends = recvs = 0; g_raReplyIP = 0; }
+int main(void)
+{
+    char myaddr[32], out[1100];
+    u8 ip[4];
+    struct sockaddr_in to;
+    int link;
+
+    /* not_reserved_uses_socket */
+    reset(); reserved = 0;
+    link = open_pc_link(myaddr, sizeof(myaddr), ip);
+    assert(link == 5);
+    to = target(IP20);
+    ask(link, &to, "RAQ1 x", out, sizeof(out));
+    assert(sends > 0 && xchgs == 0);
+    close_pc_link(link);
+    assert(closes == 1);
+
+    /* reserved_with_mstack_uses_devctl */
+    reset(); reserved = 1; probe = 1;
+    link = open_pc_link(myaddr, sizeof(myaddr), ip);
+    assert(link == RA_LINK_MSTACK);
+    /* The PC replies to the address the ministack really owns, not a since-edited setting. */
+    assert(!strcmp(myaddr, " 10.0.0.9 18196"));
+    assert(ip[0] == 10 && ip[1] == 0 && ip[2] == 0 && ip[3] == 9);
+    get_ip_ok = 0;
+    assert(open_pc_link(myaddr, sizeof(myaddr), ip) == RA_LINK_MSTACK);
+    assert(!strcmp(myaddr, " 192.168.1.10 18196")); /* older driver: fall back to ps2_ip */
+    get_ip_ok = 1;
+    script_n = 1; script_src[0] = IP20; script_text[0] = "RAA1 OK 5"; script_len[0] = 0;
+    assert(ask(link, &to, "RAQ1 abc 192.168.1.10 18196", out, sizeof(out)) == 9);
+    assert(!strcmp(out, "RAA1 OK 5") && g_raReplyIP == IP20);
+    assert(sends == 0 && recvs == 0);
+    assert(last_req.dst_ip == IP20 && last_req.dst_port == 18194 && last_req.timeout_ms == 250);
+    assert(last_req.len == 27 && !memcmp(last_req.data, "RAQ1 abc 192.168.1.10 18196", 27));
+    assert(last_arglen == MSTACK_XCHG_REQ_HDR + 27);
+    close_pc_link(link);
+    assert(closes == 1); /* the mstack link is not a socket */
+    assert(ethinits == 0);
+
+    /* reserved_without_mstack_is_busy */
+    reset(); probe = -19;
+    assert(open_pc_link(myaddr, sizeof(myaddr), ip) == RA_LINK_BUSY);
+    assert(ethinits == 0);
+    probe = 1;
+
+    /* retry_count_matches */
+    reset();
+    assert(ask(RA_LINK_MSTACK, &to, "RAQ1 x", out, sizeof(out)) == -1);
+    assert(xchgs == RA_TRY);
+
+    /* source_filter_matches */
+    reset(); script_n = 2;
+    script_src[0] = IP21; script_text[0] = "STRANGER"; script_len[0] = 0;
+    script_src[1] = IP20; script_text[1] = "RAA1 NO"; script_len[1] = 0;
+    assert(ask(RA_LINK_MSTACK, &to, "RAQ1 x", out, sizeof(out)) == 7);
+    assert(!strcmp(out, "RAA1 NO") && g_raReplyIP == IP20 && xchgs == 2);
+
+    /* broadcast_accepts_any */
+    reset(); script_n = 1;
+    script_src[0] = IP77; script_text[0] = "RAO1 OK v"; script_len[0] = 0;
+    to = target(0xFFFFFFFFu);
+    assert(ask(RA_LINK_MSTACK, &to, "RAP1 192.168.1.10 18196", out, sizeof(out)) == 9);
+    assert(g_raReplyIP == IP77);
+
+    /* truncates_to_outmax */
+    reset(); script_n = 1;
+    script_src[0] = IP77; script_text[0] = ""; script_len[0] = MSTACK_XCHG_REPLY_MAX;
+    memset(out, 0x5A, sizeof(out));
+    assert(ask(RA_LINK_MSTACK, &to, "RAG1 x", out, 64) == 63);
+    assert(out[63] == 0 && out[64] == 0x5A);
+
+    /* caduceus_page_over_mstack: probe on 18197, then the paired request on 18198 */
+    reset(); reserved = 1; probe = 1; script_n = 2;
+    script_src[0] = IP20; script_text[0] = "CADR2 " RA_PROBE_HASH " READY UNKNOWN"; script_len[0] = 0;
+    script_src[1] = IP20; script_text[1] = "CADB1 7 OK\tG"; script_len[1] = 0;
+    assert(raCaduceusPage("CADA1 7 G 0 0 0 secret", 7, out, sizeof(out)) == 0);
+    assert(ports[0] == RA_CADUCEUS_PORT && ports[1] == 18198 && xchgs == 2);
+    assert(!memcmp(last_req.data, "CADA1 7 G 0 0 0 secret", 22));
+    assert(!strcmp(out, "OK\tG") && sends == 0 && closes == 1);
+    reserved = 0;
+
+    puts("ok");
+    return 0;
+}
+'''
+
+with tempfile.TemporaryDirectory() as tmp:
+    src = Path(tmp) / "link.c"
+    exe = Path(tmp) / "link.exe"
+    src.write_text(harness + source + tests, encoding="utf-8")
+    subprocess.run(["cc", "-std=gnu99", "-Wall", "-Werror", "-Wno-unused-function", "-I", str(ROOT),
+                    str(src), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, capture_output=True)
+
+# The support check and link test open a link; neither keeps its own NIC refusal or raw socket loop.
+for signature in ("int raAskPC(", "int raNetTestLink("):
+    fn = body(signature)
+    assert "open_pc_link(" in fn and "open_pc_socket(" not in fn, signature
+    assert "disconnect(sock)" not in fn, signature
+assert "sendto(" not in body("int raNetTestLink("), "the RAP1 link test still has its own socket loop"
+assert "raNetNicReserved()" in body("static int open_pc_link(")
+# The Caduceus browser's UDP pages follow the link too (its key comes from the UDPFS share).
+cad = body("int raCaduceusPage(")
+assert "open_pc_link(" in cad and "open_pc_socket(" not in cad and "disconnect(sock)" not in cad
+assert "raNetNicReserved()" not in cad[:cad.index("open_pc_link(")]
+# The browsers' TCP paths need lwIP: they keep refusing while the NIC is reserved.
+assert "raNetNicReserved()" in until("int raNetXeraboraIdentify(", "open_pc_socket(")
+assert "raNetNicReserved()" in until("int raNetHttpGet(", "socket(")
+# ps2sdk's newlib port refuses fileXio headers unless the file opts in first (as every other
+# fileXio user in src/ does); the RA build fails otherwise.
+include = ranet.index("#include <fileXio_rpc.h>")
+assert "#define NEWLIB_PORT_AWARE" in ranet[:include], "fileXio_rpc.h included without NEWLIB_PORT_AWARE"
+# The device registers only once the module stays resident: a second load returns
+# NO_RESIDENT_END and its memory is freed, so "mstack" must not point into it.
+main_c = (ROOT / "modules/network/udpfs_ministack/src/main.c").read_text(encoding="utf-8")
+assert main_c.index("mstack_xchg_init();") > main_c.index("RegisterLibraryEntries(&_exp_mstack)")
+
+# "Network busy" with a UDPFS transport selected but not loaded yet says what to do.
+assert "_STR_RA_UDPFS_LOAD_FIRST" in body("int raNetTestLink(")
+for name in ("src/supportbase.c", "src/discsupport.c"):
+    text = (ROOT / name).read_text(encoding="utf-8")
+    assert "raNetUdpfsNotLoaded() ? _STR_RA_UDPFS_LOAD_FIRST : _STR_RA_NET_BUSY_HASH" in text, name
+helper = body("int raNetUdpfsNotLoaded(void)")
+assert "NET_PROTO_UDPFS" in helper and "NET_PROTO_UDPFSBD" in helper and "!raNetNicBusy()" in helper
+print("PASS: RA requests use mstack: while UDPFS owns the NIC, sockets otherwise, same retries and filtering")
diff --git a/.github/scripts/test_ra_nic_reserved.py b/.github/scripts/test_ra_nic_reserved.py
new file mode 100644
index 0000000..a1c402e
--- /dev/null
+++ b/.github/scripts/test_ra_nic_reserved.py
@@ -0,0 +1,73 @@
+"""RA menu actions must not claim the NIC a selected-but-unloaded UDP transport needs.
+
+raNetNicReserved() is compiled from src/ranet.c against stubs: it is true while UDPBD/UDPFS is
+loaded (raNetNicBusy) OR while the user's selected protocol is a UDP transport that has not loaded
+yet. Menu-side RA actions (Caduceus page, support check, link test, achievements browser) use it;
+the launch path keeps raNetNicBusy, because a game's IOP reset frees the NIC either way.
+"""
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ranet = (ROOT / "src/ranet.c").read_text(encoding="utf-8")
+achievements = (ROOT / "src/achievements.c").read_text(encoding="utf-8")
+
+
+def body(source, signature):
+    start = source.index(signature)
+    end = source.index("\n}\n", start) + 3
+    return source[start:end]
+
+
+reserved = body(ranet, "int raNetNicReserved(void)")
+harness = r'''
+#include <assert.h>
+#include <stdio.h>
+enum { NET_PROTO_OFF, NET_PROTO_SMB, NET_PROTO_UDPFS, NET_PROTO_UDPFSBD, NET_PROTO_UDPBD, NET_PROTO_HTTP };
+static int gNetworkProtocol, loaded;
+static int raNetNicBusy(void) { return loaded; }
+@RESERVED@
+int main(void)
+{
+    static const int udp[] = {NET_PROTO_UDPFS, NET_PROTO_UDPFSBD, NET_PROTO_UDPBD};
+    static const int other[] = {NET_PROTO_OFF, NET_PROTO_SMB, NET_PROTO_HTTP};
+    for (unsigned i = 0; i < 3; i++) {
+        gNetworkProtocol = udp[i];
+        loaded = 0;
+        assert(raNetNicReserved()); /* selected, not loaded yet: still reserved */
+        gNetworkProtocol = other[i];
+        assert(!raNetNicReserved()); /* SMB/HTTP/Off: RA may raise SMB */
+        loaded = 1;
+        assert(raNetNicReserved()); /* a resident UDP chain always owns it */
+    }
+    puts("ok");
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    src = Path(tmp) / "reserved.c"
+    exe = Path(tmp) / "reserved"
+    src.write_text(harness.replace("@RESERVED@", reserved), encoding="utf-8")
+    subprocess.run(["cc", "-std=gnu99", "-Wall", "-Werror", str(src), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, capture_output=True)
+
+# Menu-side actions use the reserved check; the launch path keeps the loaded-only check.
+# The support check, link test and Caduceus pages decide through open_pc_link (socket,
+# mstack: or "busy").
+link = body(ranet, "static int open_pc_link(")
+assert "raNetNicReserved()" in link and "raNetNicBusy()" not in link
+for signature in ("int raCaduceusPage(", "int raAskPC(", "int raNetTestLink("):
+    fn = ranet[ranet.index(signature):]
+    fn = fn[:fn.index("open_pc_link(")]
+    assert "raNetNicBusy()" not in fn, signature
+launch = body(ranet, "void raLaunchNetworkUp(void)")
+assert "raNetNicBusy()" in launch and "raNetNicReserved()" not in launch
+# The Caduceus browser never raises SMB while a UDP transport is selected: UDPFS Files serves
+# the key from its own share, any other reserved NIC means no share.
+share = body(achievements, "static const char *cadSharePrefix(void)")
+assert re.search(r"if \(raNetNicReserved\(\)\)\s*return NULL;", share)
+assert share.index("raNetNicReserved()") < share.index("ethEnsureSMBShareConnected()")
+assert share.index("NET_PROTO_UDPFS") < share.index("raNetNicReserved()")
+print("PASS: RA menu actions leave a selected UDP transport's NIC alone; launches unchanged")
diff --git a/.github/scripts/test_ra_ps1.py b/.github/scripts/test_ra_ps1.py
new file mode 100644
index 0000000..5ab94f1
--- /dev/null
+++ b/.github/scripts/test_ra_ps1.py
@@ -0,0 +1,553 @@
+"""Production PS1 hashing, module ownership and IOP snapshots against host fixtures."""
+from pathlib import Path
+import hashlib
+import os
+import re
+import struct
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+with tempfile.TemporaryDirectory(prefix='ra-ps1-') as directory:
+    tmp = Path(directory)
+
+    def run(name, source, extra=()):
+        path = tmp / (name + '.c')
+        exe = tmp / (name + '.exe')
+        source = '#ifdef _WIN32\n#include <direct.h>\n#define mkdir(path, mode) _mkdir(path)\n#endif\n' + source
+        path.write_text(source, encoding='utf-8')
+        subprocess.run(['gcc', '-std=gnu99', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-pointer-to-int-cast', '-Wno-int-to-pointer-cast',
+                        '-I', str(root), str(path), *map(str, extra), '-o', str(exe)], check=True)
+        if name == 'badge_ps1' and os.name == 'nt':
+            print('SKIP Windows: real-filesystem PS2 colon-path badge fixture requires Linux (covered in CI)')
+        else:
+            subprocess.run([str(exe)], cwd=tmp, check=True)
+
+    payload = bytearray((i % 251 for i in range(2048 * 3 + 17)))
+    payload[:8] = b'PS-X EXE'
+    struct.pack_into('<I', payload, 28, len(payload) - 2048)
+
+    def record(name, lba, size):
+        result = bytearray(34 + len(name))
+        result[0] = len(result)
+        struct.pack_into('<I', result, 2, lba)
+        struct.pack_into('<I', result, 10, size)
+        result[32] = len(name)
+        result[33:33 + len(name)] = name.encode()
+        return result
+
+    def fixture(name, boot='SLUS_012.15', cnf=True, fallback=False, overflow=False):
+        iso = bytearray(40 * 2048)
+        iso[16*2048+1:16*2048+6] = b'CD001'
+        struct.pack_into('<II', iso, 16*2048+158, 20, 0)
+        struct.pack_into('<I', iso, 16*2048+166, 2048)
+        entries = b''
+        if cnf:
+            text = ('BOOT = cdrom:\\' + boot + ';1\r\n').encode()
+            iso[22*2048:22*2048+len(text)] = text
+            entries += record('SYSTEM.CNF;1', 22, len(text))
+        if '\\' in boot:
+            entries += record('D;1', 21, 2048)
+            nested = record('G.EXE;1', 24, len(payload))
+            iso[21*2048:21*2048+len(nested)] = nested
+        else:
+            entries += record(('PSX.EXE' if fallback else boot) + ';1', 24, len(payload))
+        iso[20*2048:20*2048+len(entries)] = entries
+        data = bytearray(payload)
+        if overflow:
+            struct.pack_into('<I', data, 28, 0xfffff800)
+        iso[24*2048:24*2048+len(data)] = data
+        raw = bytearray(0x100000 + 40 * 2352)
+        for lba in range(40):
+            at = 0x100000 + lba * 2352 + 24
+            raw[at:at+2048] = iso[lba*2048:(lba+1)*2048]
+        (tmp / name).write_bytes(raw)
+
+    fixture('retail.vcd')
+    fixture('nested.vcd', 'D\\G.EXE')
+    fixture('fallback.vcd', cnf=False, fallback=True)
+    fixture('overflow.vcd', overflow=True)
+    # Split a synthetic HDL game's logical ISO across two separated ATA
+    # extents. Its real 1024-byte map lives at the APA game start sector.
+    # No partition table or real HDD is opened or modified by this test.
+    raw = (tmp / 'retail.vcd').read_bytes()
+    hdisk = bytearray(1150 * 512)
+    for logical in range(40):
+        physical = (200 + 4 * logical) if logical < 16 else (1024 + 4 * (logical - 16))
+        at = 0x100000 + logical * 2352 + 24
+        hdisk[physical * 512:physical * 512 + 2048] = raw[at:at + 2048]
+    hdisk[100 * 512 + 172:100 * 512 + 172 + len(b'SLUS_012.15')] = b'SLUS_012.15'
+    struct.pack_into('<i', hdisk, 100 * 512 + 240, 2)
+    struct.pack_into('<III', hdisk, 100 * 512 + 244, 0, 200, 16 * 2048)
