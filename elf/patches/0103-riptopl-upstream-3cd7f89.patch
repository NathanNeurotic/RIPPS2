+ RA_OverlayOnVblank(217);assert(resets==1 && ra_ovl_seen==2);
+ RA_OverlayOnVblank(218);assert(resets==2 && ra_ovl_seen==4);
+ event->seq=5;event->commit=5;race_mode=2;
+ RA_OverlayOnVblank(219);assert(resets==2 && ra_ovl_seen==4);
+ RA_OverlayOnVblank(220);assert(resets==3 && ra_ovl_seen==5);
+ event->seq=6;event->commit=6;event->kind=RA_EVENT_RESET;race_mode=3;
+ RA_OverlayOnVblank(221);assert(resets==3 && ra_ovl_seen==5);
+ RA_OverlayOnVblank(222);assert(resets==3 && ra_ovl_seen==7);
+ RA_OverlaySetPacketBuffer(NULL);assert(!draw_card());
+ assert(RA_OverlayEventBuffer()==pulse_buffer);
+ RA_OverlayOnVblank(221);assert(pulses==2);
+ puts("PASS: card bounds, sliced rasterization, GIF state refusal, CT32/CT16 packet lengths, torn events, reset and Xerabora dispatch");
+}
+"""
+fallback_tests=r"""
+struct ra_gs_source_regs GSMSourceGSRegs;
+int main(void) {
+ g_ee_core_config.raClientMode=1;
+ assert(RA_OverlayEventBuffer()==pulse_buffer);
+ RA_OverlayOnVblank(1);
+ assert(pulses==1 && GIF_D2_QWC==0);
+ puts("PASS: Caduceus production fallback uses pulse without GIF DMA");
+}
+"""
+with tempfile.TemporaryDirectory() as tmp:
+ path=Path(tmp)
+ for name, headers, body in [
+  ('experimental',prefix,tests),
+  ('opt_out',prefix,fallback_tests),
+  ('compile_disabled',prefix.replace('#define RA_EXPERIMENTAL_CARD_DMA 1','#define RA_EXPERIMENTAL_CARD_DMA 0'),fallback_tests),
+ ]:
+  (path/'test.c').write_text(headers+source+body)
+  subprocess.run(['cc','-std=gnu99','-Wno-pointer-to-int-cast','-I',str(root),str(path/'test.c'),'-o',str(path/'test.exe')],check=True)
+  subprocess.run([str(path/'test.exe')],check=True)
+
+# Exercise the production pulse itself, including unknown and uncommitted events.
+pulse = (root / 'ee_core/src/ra_pulse.c').read_text()
+pulse = re.sub(r'^#include .*$', '', pulse, flags=re.M)
+pulse = pulse.replace('#define GS_PMODE (*(volatile u64 *)0x12000000)',
+                      'static u64 GS_PMODE;')
+pulse_prefix = r"""
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+#define RETROACHIEVEMENTS 1
+typedef uint64_t u64;
+#include "modules/network/common/ra_snap.h"
+#define UNCACHED_SEG(p) (p)
+#define BGCOLND(c) ((void)(c))
+static int resets;
+static void IGR_RequestReset(void) { resets++; }
+static int race_mode;
+static void mock_after_snapshot(struct ra_event *copy, volatile struct ra_event *live) {
+ if (race_mode==1) { live->seq++; live->commit=live->seq; live->kind=RA_EVENT_RESET; }
+ if (race_mode==2) copy->commit=0;
+ if (race_mode==3) { live->seq++; live->commit=live->seq; live->kind=RA_EVENT_MAKE_UNLOCK(10); copy->seq=live->seq; copy->commit=live->commit; }
+ race_mode=0;
+}
+"""
+pulse=pulse.replace('struct ra_event notice = *e;',
+ 'struct ra_event notice = *e; mock_after_snapshot(&notice, (volatile struct ra_event *)e);')
+pulse_tests = r"""
+int main(void) {
+ struct ra_event *e=RA_PulseEventBuffer();
+ e->magic=RA_EVENT_MAGIC; e->seq=1; e->commit=1; e->kind=0xFE;
+ RA_PulseOnVblank(1); assert(!ra_ovl_running);
+ e->seq=2; e->kind=RA_EVENT_MAKE_UNLOCK(25);
+ RA_PulseOnVblank(2); assert(!ra_ovl_running);
+ e->commit=2; RA_PulseOnVblank(3); assert(ra_ovl_running && ra_ovl_start==3);
+ e->seq=3; e->commit=3; e->kind=0xFE;
+ RA_PulseOnVblank(4); assert(ra_ovl_running && ra_ovl_start==3);
+ e->seq=4; e->commit=4; e->kind=RA_EVENT_MAKE_UNLOCK(50);
+ RA_PulseOnVblank(5); assert(ra_ovl_start==5);
+ RA_PulseOnVblank(65); assert(!ra_ovl_running);
+ e->seq=5; e->commit=5; e->kind=RA_EVENT_RESET;
+ RA_PulseOnVblank(66); RA_PulseOnVblank(67); assert(resets==1 && !ra_ovl_running);
+ e->seq=6; e->commit=6; e->kind=RA_EVENT_MAKE_UNLOCK(10); race_mode=1;
+ RA_PulseOnVblank(68); assert(resets==1 && !ra_ovl_running && ra_ovl_seen==5);
+ RA_PulseOnVblank(69); assert(resets==2 && ra_ovl_seen==7);
+ e->seq=8; e->commit=8; race_mode=2;
+ RA_PulseOnVblank(70); assert(resets==2 && ra_ovl_seen==7);
+ RA_PulseOnVblank(71); assert(resets==3 && ra_ovl_seen==8);
+ e->seq=9;e->commit=9;e->kind=RA_EVENT_RESET;race_mode=3;
+ RA_PulseOnVblank(72);assert(resets==3 && ra_ovl_seen==8);
+ RA_PulseOnVblank(73);assert(resets==3 && ra_ovl_seen==10 && ra_ovl_start==73);
+ puts("PASS: production pulse ignores unknown/torn events, restarts unlocks and preserves reset");
+}
+"""
+with tempfile.TemporaryDirectory() as tmp:
+ path=Path(tmp)
+ (path/'pulse.c').write_text(pulse_prefix+pulse+pulse_tests)
+ subprocess.run(['cc','-std=gnu99','-I',str(root),str(path/'pulse.c'),'-o',str(path/'pulse.exe')],check=True)
+ subprocess.run([str(path/'pulse.exe')],check=True)
diff --git a/.github/scripts/test_cfg_titles.py b/.github/scripts/test_cfg_titles.py
new file mode 100644
index 0000000..308fefe
--- /dev/null
+++ b/.github/scripts/test_cfg_titles.py
@@ -0,0 +1,204 @@
+"""Optional CFG Titles in game lists (#918): display only, off by default, read on the I/O thread.
+
+With "Show CFG Titles in Game Lists" on, every list rebuild reads each game's per-game CFG once
+(itemGetConfig, the same loader the info page uses) and keeps its UTF-8 Title. Rows then show and
+sort by that title; identity (item.text, startup, file name, Favorites, art, rename, launch) is never
+touched. Off (the default) reads nothing. src/cfgtitle.c is compiled against stubs.
+"""
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+source = (ROOT / "src/cfgtitle.c").read_text(encoding="utf-8")
+source = re.sub(r"^#include.*\n", "", source, flags=re.M)
+
+harness = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define MODE_COUNT 8
+enum { BDM_MODE, ETH_MODE, HDD_MODE, APP_MODE, FAV_MODE };
+#define GAME_FORMAT_FOLDER 9
+#define CFG_TITLE_MAX 64
+typedef struct { const char *title; int present; } config_set_t;
+typedef struct { int format; } base_game_info_t;
+typedef struct item_list item_list_t;
+struct item_list {
+    int mode;
+    char *(*itemGetName)(item_list_t *, int);
+    void *(*itemGet)(item_list_t *, int);
+    config_set_t *(*itemGetConfig)(item_list_t *, int);
+};
+static int gCfgTitlesInLists, configReads, configFrees, locks, unlocks, mallocFailAt = -1, mallocs;
+static const char *titles[8];
+static base_game_info_t games[8];
+static char *names[8] = {"Dragon Quest VIII", "SLPM_655.55", "Game C", "Folder", "Game E", "Game F", "Game G", "Game H"};
+static config_set_t configs[8];
+static char *getName(item_list_t *l, int i) { (void)l; return names[i]; }
+static void *getGame(item_list_t *l, int i) { (void)l; return &games[i]; }
+static config_set_t *getConfig(item_list_t *l, int i) { (void)l; configReads++; configs[i].title = titles[i]; return &configs[i]; }
+static int configGetStr(config_set_t *c, const char *key, const char **out) { assert(!strcmp(key, "Title")); *out = c->title; return c->title != NULL; }
+static void configFree(config_set_t *c) { (void)c; configFrees++; }
+static void guiLock(void) { locks++; }
+static void guiUnlock(void) { unlocks++; }
+static int folderModeSupported(int mode) { return mode == BDM_MODE; }
+static const char *vcdDisplayNameForRow(item_list_t *l, int id, const char *text) { (void)l; (void)id; return text; }
+static int favSource[8];
+static int favGetItemSourceMode(int id) { return favSource[id]; }
+#ifdef RETROACHIEVEMENTS
+static const char *badges[8];
+static const char *raBadgeText(item_list_t *l, int id) { (void)l; return badges[id]; }
+#endif
+static void *testMalloc(size_t n) { if (mallocs++ == mallocFailAt) return NULL; return malloc(n); }
+#define malloc testMalloc
+'''
+
+tests = r'''
+int main(void)
+{
+    item_list_t bdm = {BDM_MODE, getName, getGame, getConfig};
+    item_list_t app = {APP_MODE, getName, getGame, getConfig};
+    char clean[CFG_TITLE_MAX];
+
+    /* off_reads_nothing: the default costs no CFG reads and shows names unchanged. */
+    titles[0] = "ドラゴンクエストVIII";
+    cfgTitleRefresh(&bdm, 3);
+    assert(configReads == 0 && cfgTitleForRow(&bdm, 0) == NULL);
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 0, names[0]), "Dragon Quest VIII"));
+
+    /* on_shows_title: one read per game, freed, title shown; identity untouched. */
+    gCfgTitlesInLists = 1;
+    titles[1] = "  Kingdom Hearts  ";
+    titles[2] = "";
+    games[3].format = GAME_FORMAT_FOLDER;
+    titles[3] = "Never read";
+    cfgTitleRefresh(&bdm, 4);
+    assert(configReads == 3 && configFrees == 3); /* the folder row is skipped */
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 0, names[0]), "ドラゴンクエストVIII"));
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 1, names[1]), "Kingdom Hearts")); /* trimmed */
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 2, names[2]), "Game C"));        /* empty: name */
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 3, names[3]), "Folder"));
+    assert(!strcmp(names[0], "Dragon Quest VIII"));
+    assert(locks == unlocks && locks >= 1); /* swapped under the GUI lock */
+    assert(cfgTitleForRow(&bdm, 99) == NULL && cfgTitleForRow(&bdm, -1) == NULL);
+
+    /* apps_skipped: Apps are executables, not library games. */
+    configReads = 0;
+    cfgTitleRefresh(&app, 3);
+    assert(configReads == 0 && cfgTitleForRow(&app, 0) == NULL);
+
+    /* clean: invalid UTF-8 and control characters fall back; long titles cut on a character. */
+    assert(!cfgTitleClean("\xff\xfe broken", clean, sizeof(clean)));
+    assert(!cfgTitleClean("bad\x01ctrl", clean, sizeof(clean)));
+    assert(!cfgTitleClean("\xe3\x83", clean, sizeof(clean))); /* truncated sequence */
+    assert(!cfgTitleClean("   ", clean, sizeof(clean)));
+    assert(cfgTitleClean("ファイナルファンタジーファイナルファンタジーファイナルファンタジー", clean, sizeof(clean)));
+    assert(strlen(clean) < CFG_TITLE_MAX && (strlen(clean) % 3) == 0); /* whole 3-byte characters */
+    assert(cfgTitleClean("Ok", clean, sizeof(clean)) && !strcmp(clean, "Ok"));
+    /* strict UTF-8: overlong, surrogate, beyond U+10FFFF and C1 controls fall back. */
+    assert(!cfgTitleClean("\xe0\x80\x80", clean, sizeof(clean)));
+    assert(!cfgTitleClean("\xed\xa0\x80", clean, sizeof(clean)));
+    assert(!cfgTitleClean("\xf4\x90\x80\x80", clean, sizeof(clean)));
+    assert(!cfgTitleClean("\xf0\x80\x80\x80", clean, sizeof(clean)));
+    assert(!cfgTitleClean("a\xc2\x85" "b", clean, sizeof(clean)));
+    assert(cfgTitleClean("Caf\xc3\xa9", clean, sizeof(clean)));
+
+    /* off_is_immediate: switching off shows file names at once, before any rebuild. */
+    gCfgTitlesInLists = 0;
+    assert(cfgTitleForRow(&bdm, 0) == NULL);
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 0, names[0]), "Dragon Quest VIII"));
+    gCfgTitlesInLists = 1;
+    assert(cfgTitleForRow(&bdm, 0) != NULL);
+
+    /* forget: a rebuild drops the old table before new rows appear (no stale-index titles). */
+    cfgTitleForget(&bdm);
+    assert(cfgTitleForRow(&bdm, 0) == NULL);
+    assert(cfgTitleForRow(NULL, 0) == NULL);
+
+    /* turned_off_clears: switching off drops the titles on the next rebuild. */
+    gCfgTitlesInLists = 0;
+    cfgTitleRefresh(&bdm, 4);
+    assert(cfgTitleForRow(&bdm, 0) == NULL);
+
+    /* fav_apps_skipped: a Favorite whose source is the Apps tab is an app, never titled. */
+    {
+        item_list_t fav = {FAV_MODE, getName, getGame, getConfig};
+        gCfgTitlesInLists = 1;
+        favSource[0] = APP_MODE;
+        favSource[1] = BDM_MODE;
+        configReads = 0;
+        cfgTitleRefresh(&fav, 2);
+        assert(configReads == 1 && cfgTitleForRow(&fav, 0) == NULL && cfgTitleForRow(&fav, 1) != NULL);
+        gCfgTitlesInLists = 0;
+        cfgTitleRefresh(&fav, 2);
+    }
+
+#ifdef RETROACHIEVEMENTS
+    /* ra_badge_prefix: a tracked game keeps its badge in front of the title. */
+    gCfgTitlesInLists = 1;
+    badges[0] = "RA Dragon Quest VIII";
+    badges[1] = "RA something else";
+    titles[1] = "Kingdom Hearts";
+    cfgTitleRefresh(&bdm, 2);
+    assert(!strcmp(cfgTitleForRow(&bdm, 0), "RA ドラゴンクエストVIII"));
+    assert(!strcmp(cfgTitleForRow(&bdm, 1), "Kingdom Hearts")); /* badge does not end with the name */
+    gCfgTitlesInLists = 0;
+    cfgTitleRefresh(&bdm, 2);
+#endif
+
+    /* alloc_failure: no table means names, never a crash. */
+    gCfgTitlesInLists = 1;
+    mallocs = 0;
+    mallocFailAt = 0;
+    cfgTitleRefresh(&bdm, 4);
+    assert(cfgTitleForRow(&bdm, 0) == NULL);
+    assert(!strcmp(cfgTitleDisplayName(&bdm, 0, names[0]), "Dragon Quest VIII"));
+    mallocFailAt = -1;
+
+    puts("ok");
+    return 0;
+}
+'''
+
+with tempfile.TemporaryDirectory() as tmp:
+    src = Path(tmp) / "titles.c"
+    src.write_text(harness + source + tests, encoding="utf-8")
+    for flags in ([], ["-DRETROACHIEVEMENTS"]):  # standard and RA builds (badge prefix)
+        exe = Path(tmp) / ("titles%s.exe" % ("_ra" if flags else ""))
+        subprocess.run(["cc", "-std=gnu99", "-Wall", "-Werror", "-Wno-unused-function", *flags, str(src), "-o", str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+
+# Wiring: refresh after each scan; rows and sorting draw through the display name; off by default.
+opl = (ROOT / "src/opl.c").read_text(encoding="utf-8")
+update = opl[opl.index("static void updateMenuFromGameList("):]
+update = update[:update.index("\n}\n")]
+# Rows appear with file names at once; the CFG pass runs after them and the sort follows it.
+assert update.index("itemUpdate(mdl->support)") < update.index("cfgTitleForget(mdl->support);") < update.index("guiDeferUpdate(gup);")
+assert update.index("guiDeferUpdate(gup);") < update.index("cfgTitleRefresh(mdl->support, count);") < update.index("GUI_OP_SORT")
+assert update.index("libViewFinishPending(") < update.index("cfgTitleRefresh(mdl->support, count);")
+assert "gup->submenu.text = mdl->support->itemGetName(mdl->support, i);" in update  # identity unchanged
+menusys = (ROOT / "src/menusys.c").read_text(encoding="utf-8")
+sort = menusys[menusys.index("static int submenuSortCompare("):]
+sort = sort[:sort.index("\n}\n")]
+assert "cfgTitleDisplayName(support, a->item.id, txt1)" in sort and "vcdDisplayNameForRow" not in sort
+themes = (ROOT / "src/themes.c").read_text(encoding="utf-8")
+assert "cfgTitleDisplayName(list, ps->item.id, submenuItemGetText(&ps->item))" in themes
+assert menusys.count("cfgTitleDisplayName(") >= 3  # sort + both game-menu headers
+assert "gCfgTitlesInLists = 0;" in opl
+assert "CONFIG_OPL_CFG_TITLES, &gCfgTitlesInLists" in opl and "CONFIG_OPL_CFG_TITLES, gCfgTitlesInLists" in opl
+dialogs = (ROOT / "src/dialogs.c").read_text(encoding="utf-8")
+assert "UICFG_CFG_TITLES, 1, 1, _STR_HINT_CFG_TITLES" in dialogs
+gui = (ROOT / "src/gui.c").read_text(encoding="utf-8")
+assert gui.count("diaGetInt(diaUIConfig, UICFG_CFG_TITLES") + gui.count("diaGetInt(ui, UICFG_CFG_TITLES") == 2
+# A flip must rebuild every game list: mark the pages dirty (each NeedsUpdate consumes it) and
+# queue HTTP too, which oplQueueLibraryDeviceUpdates leaves out.
+refresh = gui[gui.index("static void guiRefreshCfgTitles(void)"):]
+refresh = refresh[:refresh.index("\n}\n")]
+assert "libViewMarkAllDirty();" in refresh and "guiRefreshGameViews();" in refresh and "httpGetObject(0)" in refresh
+assert gui.count("guiRefreshCfgTitles();") == 2
+base = (ROOT / "lng_tmpl/_base.yml").read_text(encoding="utf-8")
+assert base.index("- label: CFG_TITLES") > base.index("- label: CAD_UDPFS_IMG")
+print("PASS: CFG titles in game lists are opt-in, display-only and read once per rebuild")
diff --git a/.github/scripts/test_cjk_font_fallback.py b/.github/scripts/test_cjk_font_fallback.py
new file mode 100644
index 0000000..93e1d79
--- /dev/null
+++ b/.github/scripts/test_cjk_font_fallback.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Host regression for optional glyph fallback without a PS2 toolchain.
+
+Compile the actual face-selection block from src/fntsys.c against small stubs.
+This covers the decision made by BOTH text measurement and rendering because
+they share fntCacheGlyph(). It does not simulate PS2 glyph atlas/VRAM behavior.
+"""
+import pathlib
+import re
+import subprocess
+import tempfile
+
+root = pathlib.Path(__file__).resolve().parents[2]
+font = (root / "src/fntsys.c").read_text(encoding="utf-8")
+language = (root / "src/lang.c").read_text(encoding="utf-8")
+opl = (root / "src/opl.c").read_text(encoding="utf-8")
+lang_header = (root / "include/lang.h").read_text(encoding="utf-8")
+header = (root / "include/fntsys.h").read_text(encoding="utf-8")
+start = "    // Select a second face only for characters missing from the active font."
+end = "    // calc page id and in-page index from glyph id"
+assert font.count(start) == 1 and font.count(end) == 1
+selection = font.split(start, 1)[1].split(end, 1)[0]
+assert "FT_Get_Char_Index(font->face, gid) == 0" in selection
+assert "FT_Get_Char_Index(fonts[fallbackFontID].face, gid) != 0" in selection
+assert "int fntLoadFallback(char *path)" in font
+assert "int fntLoadFallback(char *path);" in header
+assert "void lngInitFallbackFont(void);" in lang_header
+assert "    lngInitFallbackFont();" not in language
+normal_init = opl.split("static void init(void)", 1)[1].split("static void deferredInit(void)", 1)[0]
+assert normal_init.index("lngInitFallbackFont();") > normal_init.index("_loadConfig();")
+assert "configGetHomePath()" in language
+assert "fntLoadDefault(NULL);" in language  # Existing UI-language reset retained.
+assert '"font_CJK.ttf"' in language and '"font_Japanese.ttf"' in language
+
+harness = r"""
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#define FNT_DEFAULT 0
+#define FNT_MAX_COUNT 16
+typedef struct { int isValid; void *face; } font_t;
+static font_t fonts[FNT_MAX_COUNT];
+static int fallbackFontID = -1;
+/* Fake font: 1 = Latin + Japanese; 2 = Japanese + Greek; 3 = Latin. */
+static int FT_Get_Char_Index(void *ptr, uint32_t cp)
+{
+    int face = (int)(intptr_t)ptr;
+    if (face == 1) return cp == 0x3042 || cp == 'A';
+    if (face == 2) return cp == 0x3042 || cp == 0x03A9;
+    if (face == 3) return cp == 'A';
+    return 0;
+}
+static font_t *resolve(font_t *font, uint32_t gid)
+{
+""" + start + selection + """
+    return font;
+}
+int main(void)
+{
+    fonts[0] = (font_t){1, (void *)(intptr_t)3}; /* Default Latin UI font. */
+    fonts[1] = (font_t){1, (void *)(intptr_t)2}; /* Optional fallback. */
+    fallbackFontID = 1;
+    assert(resolve(&fonts[0], 0x3042) == &fonts[1]); /* Japanese. */
+    assert(resolve(&fonts[0], 0x03A9) == &fonts[1]); /* Greek. */
+    assert(resolve(&fonts[0], 'A') == &fonts[0]); /* Never steal ASCII. */
+    assert(resolve(&fonts[1], 0x3042) == &fonts[1]); /* No recursion. */
+    fonts[2] = (font_t){1, (void *)(intptr_t)1};
+    assert(resolve(&fonts[2], 0x3042) == &fonts[2]); /* Keep active face. */
+    fonts[1].isValid = 0;
+    assert(resolve(&fonts[0], 0x3042) == &fonts[0]); /* Safe if unavailable. */
+    fallbackFontID = -1;
+    assert(resolve(&fonts[0], 0x3042) == &fonts[0]); /* Safe if absent. */
+    return 0;
+}
+"""
+with tempfile.TemporaryDirectory(prefix="cjk-font-test-") as td:
+    source = pathlib.Path(td) / "fallback.c"
+    binary = pathlib.Path(td) / "fallback"
+    source.write_text(harness, encoding="utf-8")
+    subprocess.run(
+        ["cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-o", str(binary), str(source)],
+        check=True,
+    )
+    subprocess.run([str(binary)], check=True)
+
+    # Exercise the actual fntPrepareGlyphCachePage function with its second
+    # allocation forced to fail. The cache must remain retryable, not crash.
+    cache_function = re.search(
+        r"^static int fntPrepareGlyphCachePage\(font_t \*font, int pageid\)\n\{.*?^\}",
+        font, flags=re.M | re.S,
+    )
+    assert cache_function is not None
+    page_source = cache_function.group().replace(
+        "font->glyphCache[pageid] = malloc(",
+        "font->glyphCache[pageid] = controlled_malloc(",
+    )
+    cache_harness = r"""
+#include <assert.h>
+#include <stdlib.h>
+#include <stddef.h>
+typedef struct {
+    int isValid;
+    void *atlas;
+    void *allocation;
+} fnt_glyph_cache_entry_t;
+typedef struct {
+    fnt_glyph_cache_entry_t **glyphCache;
+    int cacheMaxPageID;
+} font_t;
+#define GLYPH_CACHE_PAGE_SIZE 256
+static int fail_malloc = 1;
+static void *controlled_malloc(size_t size)
+{
+    return fail_malloc ? NULL : malloc(size);
+}
+""" + page_source + r"""
+int main(void)
+{
+    font_t font = {NULL, -1};
+    assert(fntPrepareGlyphCachePage(&font, 0) == 0);
+    assert(font.glyphCache != NULL);
+    assert(font.glyphCache[0] == NULL);
+    fail_malloc = 0;
+    assert(fntPrepareGlyphCachePage(&font, 0) == 1);
+    assert(font.glyphCache[0] != NULL);
+    assert(font.glyphCache[0][0].isValid == 0);
+    assert(fntPrepareGlyphCachePage(&font, 0) == 1);
+    free(font.glyphCache[0]);
+    free(font.glyphCache);
+    return 0;
+}
+"""
+    cache_src = pathlib.Path(td) / "cache-oom.c"
+    cache_bin = pathlib.Path(td) / "cache-oom"
+    cache_src.write_text(cache_harness, encoding="utf-8")
+    subprocess.run(
+        ["cc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-Wno-sign-compare",
+         "-o", str(cache_bin), str(cache_src)],
+        check=True,
+    )
+    subprocess.run([str(cache_bin)], check=True)
+print("PASS: CJK fallback selection and glyph-page allocation failure recovery")
