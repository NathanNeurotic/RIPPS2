+static int sysNeutrinoRAWrite(const char *path, const void *data, int size)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0)
+        return -1;
+    int written = write(fd, data, size);
+    int closed = close(fd);
+    if (written != size || closed < 0) {
+        unlink(path);
+        return -1;
+    }
+    return 0;
+}
