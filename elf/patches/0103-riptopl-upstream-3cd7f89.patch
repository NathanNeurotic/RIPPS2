+    subprocess.run([os.environ.get('CC','gcc'),*flags,str(path),'-o',str(binary)],check=True)
+    subprocess.run([str(binary)],check=True,timeout=10)
+
+config = (root / 'src/config.c').read_text(encoding='utf-8')
+allocation = r"""
+#include <assert.h>
+#include <string.h>
