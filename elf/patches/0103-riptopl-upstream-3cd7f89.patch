+    if (configGetStr(configNet, CONFIG_NET_SMB_IP_ADDR, &temp))
+        sscanf(temp, "%d.%d.%d.%d", &pc_ip[0], &pc_ip[1], &pc_ip[2], &pc_ip[3]);
