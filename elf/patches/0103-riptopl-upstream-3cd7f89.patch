+#!/usr/bin/env python3
+"""Exercise the production probe with early, delayed, and absent iLink roots."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'src/bdmsupport.c').read_text(encoding='utf-8')
+start = source.index('    static int ilinkProbeDone = 0;')
+probe = source[start:source.index('\n}', start)]
+program = r'''
+#include <assert.h>
+#include <stdio.h>
+static int gEnableILK, iLinkModLoaded, delays, refreshes, ready_after;
+#define BDM_TYPE_ILINK 1
+#define LOG(...) ((void)0)
+static int bdmGetDeviceRootByType(int type, char *root, unsigned int size) {
+    assert(type == BDM_TYPE_ILINK && size >= 8);
+    if (ready_after < 0 || delays < ready_after) return 0;
+    snprintf(root, size, "mass0:/");
+    return 1;
+}
+static void DelayThread(int usec) { assert(usec == 250000); delays++; }
+static void bdmForceDeviceRefresh(void) { refreshes++; }
+static void run_probe(void) {
+''' + probe + r'''
+}
+int main(void) {
+    int readiness[] = {0, 2, 11, -1};
+    for (unsigned int i = 0; i < sizeof(readiness)/sizeof(readiness[0]); i++) {
+        gEnableILK = 0; run_probe();
+        delays = refreshes = 0; ready_after = readiness[i];
+        gEnableILK = 1; iLinkModLoaded = 1; run_probe();
+        assert(refreshes == 1);
+        assert(delays == (ready_after < 0 ? 12 : ready_after));
+        run_probe(); assert(refreshes == 1); // one probe per enabled session
+    }
+    gEnableILK = 0; run_probe();
+    refreshes = delays = 0; iLinkModLoaded = 0; gEnableILK = 1;
+    run_probe(); assert(refreshes == 0 && delays == 0);
+    iLinkModLoaded = 1; ready_after = 0;
+    run_probe(); assert(refreshes == 1 && delays == 0);
+    puts("iLink readiness: ready, delayed, absent, one-shot and re-enable passed");
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as temp:
+    cfile = Path(temp) / 'probe.c'
+    exe = Path(temp) / 'probe.exe'
+    cfile.write_text(program, encoding='utf-8')
+    subprocess.run(['gcc', '-std=gnu99', '-Wall', '-Wextra', '-Werror',
+                    str(cfile), '-o', str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
diff --git a/.github/scripts/test_ingame_freeze_diag.py b/.github/scripts/test_ingame_freeze_diag.py
new file mode 100644
index 0000000..ee2af2c
--- /dev/null
+++ b/.github/scripts/test_ingame_freeze_diag.py
@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+"""In-game freeze report (INGAMEDIAG / FREEZEDIAG flavour) structural checks.
+
+The report must not exist in any other build, must not be able to hang IGR on a stuck IOP, and
+must capture the game's threads before IGR changes them. The text formatter itself is covered by
+ee_core/tests/test_freeze_diag_format.c.
+"""
+
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+FAILURES = []
+
+
+def read(rel):
+    return (ROOT / rel).read_text(encoding="utf-8").replace("\r\n", "\n")
+
+
+def check(cond, what):
+    if not cond:
+        FAILURES.append(what)
+
+
+TOKEN = re.compile(r"freeze_diag|FreezeDiag|FREEZE_DIAG|CDSC_GET_FREEZE_DIAG")
+
+
+def positive_diag_guard(line):
+    return re.fullmatch(r"#ifdef\s+INGAMEDIAG|#(?:if|elif)\s+defined\s*(?:\(\s*INGAMEDIAG\s*\)|INGAMEDIAG)", line) is not None
+
+
+assert positive_diag_guard("#ifdef INGAMEDIAG")
+assert positive_diag_guard("#elif defined(INGAMEDIAG)")
+assert not positive_diag_guard("#ifndef INGAMEDIAG")
+assert not positive_diag_guard("#if !defined(INGAMEDIAG)")
+assert not positive_diag_guard("#if defined(INGAMEDIAG) || OTHER")
+
+
+def unguarded_lines(rel):
+    """Lines that mention the report outside any #if/#ifdef naming INGAMEDIAG."""
+    stack = []
+    bad = []
+    for number, line in enumerate(read(rel).split("\n"), 1):
+        s = line.strip()
+        if s.startswith("#if"):
+            stack.append(positive_diag_guard(s))
+            continue
+        if s.startswith("#elif"):
+            if stack:
+                stack[-1] = positive_diag_guard(s)
+            continue
+        if s.startswith("#else"):
+            if stack:
+                stack[-1] = False
+            continue
+        if s.startswith("#endif"):
+            if stack:
+                stack.pop()
+            continue
+        if TOKEN.search(line) and not any(stack):
+            bad.append(f"{rel}:{number}: {s}")
+    return bad
+
+
+# 1. Nothing of the report outside INGAMEDIAG in the shared sources.
+for rel in [
+    "ee_core/src/padhook.c",
+    "ee_core/src/iopmgr.c",
+    "modules/iopcore/cdvdman/cdvdman.c",
+    "modules/iopcore/cdvdman/internal.h",
+    "modules/iopcore/cdvdman/device-bdm.c",
+    "modules/iopcore/cdvdman/device-mmce.c",
+    "modules/iopcore/cdvdfsv/cdvdfsv.c",
+]:
+    for line in unguarded_lines(rel):
+        FAILURES.append("report code outside #ifdef INGAMEDIAG: " + line)
+
+ee_make = read("ee_core/Makefile")
+check(re.search(r"ifeq \(\$\(INGAMEDIAG\),1\)\nEE_OBJS \+= freeze_diag\.o\n", ee_make) is not None,
+      "ee_core builds freeze_diag.o only under INGAMEDIAG (formatting and file I/O live in freezediag.irx)")
+for rel in ["modules/iopcore/cdvdman/Makefile", "modules/iopcore/cdvdfsv/Makefile"]:
+    check(re.search(r"ifeq \(\$\(INGAMEDIAG\),1\)\nIOP_CFLAGS \+= -DINGAMEDIAG\n", read(rel)) is not None,
+          f"{rel} defines INGAMEDIAG only when asked")
+
+top = read("Makefile")
+check("INGAMEDIAG ?= 0" in top, "INGAMEDIAG defaults off")
+check(re.search(r"ifeq \(\$\(INGAMEDIAG\),1\)\n  ifeq \(\$\(RETROACHIEVEMENTS\),1\)\n    \$\(error", top) is not None,
+      "INGAMEDIAG refuses to combine with RETROACHIEVEMENTS (RA runs IGR from VBLANK)")
+cdvdman_rules = re.findall(r"\t\$\(MAKE\) \$\(CDVDMAN_PS2LOGO_FLAGS\)[^\n]*USE_[A-Z_]+=1 -C \$< all", top)
+check(len(cdvdman_rules) == 8, f"eight CDVDMAN variant rules found (got {len(cdvdman_rules)})")
+check(all("$(CDVDMAN_DIAG_FLAGS)" in r for r in cdvdman_rules), "every CDVDMAN variant receives the diag flag")
+check("\t$(MAKE) $(CDVDMAN_DIAG_FLAGS) -C $<" in top, "CDVDFSV receives the diag flag")
+check("EECORE_EXTRA_FLAGS += INGAMEDIAG=1" in top, "ee_core gets the flag")
+check("IOP_OBJS += freezediag.o" in top, "the menu embeds freezediag.irx only in the flavour")
+check("\t$(MAKE) FREEZEDIAG_BUILD=$(OPL_VERSION) -C $<" in top, "the report names the build it came from")
+
+# 2. IGR ordering in padhook.c.
+pad = read("ee_core/src/padhook.c")
+poll = pad[pad.index("static void IGR_PollUntilRequested(void)"):]
+poll = poll[:poll.index("\n}\n")]
+i_prio = poll.index("ChangeThreadPriority(TH_SELF, 0);")
+i_begin = poll.index("FreezeDiag_Begin(")
+i_stop = poll.index("IGR_StopDmaAndGs();")
+i_suspend = poll.index("SuspendThread(i);")
+check(i_prio < i_begin < i_stop < i_suspend,
+      "threads are captured at priority 0 and before DMA/GS stop and thread suspension")
+check("if (Pad_Data.combo_type == IGR_COMBO_START_SELECT) {" in poll[i_prio:i_begin],
+      "only the reset combo arms a report (not IGS or power-off)")
+alarm = pad[pad.index("static void IGR_Poll_Alarm("):pad.index("static void IGR_PollUntilRequested(void)")]
+check("g_freeze_diag_polls++;" in alarm[:alarm.index("IGR_CheckInputs();")], "each alarm input sample is counted")
+
+thread = pad[pad.index("static void IGR_Thread(void *arg)"):]
+gate = re.search(r"#ifdef INGAMEDIAG\n(?:\s*//[^\n]*\n)*\s*FreezeDiag_FetchAndShutdown\(\);\n#else\n#ifdef RETROACHIEVEMENTS\n(?:\s*//[^\n]*\n)*\s*if \(config->GameMode != DISC_MODE\)\n#endif\n\s*oplIGRShutdown\(0\);\n#endif\n", thread)
+check(gate is not None, "the flavour replaces the blocking shutdown RPC; other builds keep theirs unchanged")
+i_lmb = thread.index("sbv_patch_enable_lmb();")
+i_write = thread.index("FreezeDiag_Write();")
+i_spu = thread.index("LoadOPLModule(OPL_MODULE_ID_RESETSPU")
+check(i_lmb < i_write < i_spu, "the report is written after the IGR IOP reboot, before RESETSPU")
+
+# 3. freeze_diag.c: bounded waits, non-blocking bind, the reboot after writing.
+core = read("ee_core/src/freeze_diag.c")
+check("SifBindRpc(&igr_cd, IGR_RPC_SERVER, SIF_RPC_M_NOWAIT)" in core, "the bind does not block on a stuck IOP")
+check(re.search(r"SifCallRpc\([^;]*SIF_RPC_M_NOWAIT", core) is not None, "the call does not block on a stuck IOP")
+for match in re.finditer(r"while \(SifCheckStatRpc\(&(?:igr_cd|shutdown_cd)\)\) \{(.*?)\n    \}", core, re.S):
+    check("budget_spent(start)" in match.group(1), "every RPC wait has a deadline")
+check(len(re.findall(r"while \(SifCheckStatRpc", core)) == 3, "three RPC waits (bind, record, shutdown), all bounded")
+fas = core[core.index("void FreezeDiag_FetchAndShutdown(void)"):]
+fas = fas[:fas.index("\n}\n")]
+check(re.search(r"if \(!report_armed\) \{\n\s*oplIGRShutdown\(0\);\n\s*return;", fas) is not None,
+      "without a report to take (IGS, power-off) the shutdown is exactly oplIGRShutdown(0)")
+check(fas.index("fetch_iop()") < fas.index("shutdown_with_deadline()"), "the record is fetched before the shutdown changes the IOP")
+check("FREEZE_DIAG_SHUTDOWN_SKIPPED" in fas, "bind failure skips shutdown")
+sd = core[core.index("static void shutdown_with_deadline(void)"):]
+sd = sd[:sd.index("\n}\n")]
+check(re.search(r"SifCallRpc\(&shutdown_cd, 1, SIF_RPC_M_NOWAIT", sd) is not None, "the shutdown is RPC function 1, sent without blocking")
+check("= 0; // 0 = shut down, do not power off" in sd, "the shutdown asks for the same thing as oplIGRShutdown(0)")
+check(core.count("budget_spent(start)") >= 3, "the bind retry loop also has a deadline")
+w = core[core.index("void FreezeDiag_Write(void)"):]
+check(w.index("LoadModule(\"rom0:MCMAN\"") < w.index("FlushCache(0)") < w.index("CopyToIop(") < w.index("LoadOPLModule(OPL_MODULE_ID_FREEZEDIAG") < w.index("Reset_Iop(\"\", 0)"),
+      "ROM MCMAN, cache flushed before the DMA, record handed to freezediag.irx, then a clean IOP reboot")
+check("fio" not in core and "freeze_diag_format(" not in core, "ee_core carries no file client or formatter (stack budget)")
+irx = read("modules/iopcore/freezediag/freezediag.c")
+for path in re.findall(r'"(mc[01]:/[^"]+)"', irx):
+    name = path.split(":/", 1)[1]
+    check("/" not in name and len(name) <= 31, f"report path {path} fits a memory card name")
+check("O_WRONLY | O_CREAT | O_TRUNC" in irx, "IOP ioman flags")
+check("freeze_diag_format(" in irx, "the IRX uses the host-tested formatter")
+fmt = read("ee_core/src/freeze_diag_format.c")
+check("long long" not in fmt, "the formatter needs no 64-bit division (IOP has none)")
+mods = read("ee_core/include/modules.h")
+check(re.search(r"#ifdef INGAMEDIAG\n(?:\s*//[^\n]*\n)*\s*OPL_MODULE_ID_FREEZEDIAG,\n#endif\n\n\s*OPL_MODULE_ID_PCCF = 60,\n\s*OPL_MODULE_ID_COUNT", mods) is not None,
+      "the diagnostic ID remains guarded and existing IDs are preserved before CF")
+sysc = read("src/system.c")
+check(re.search(r"#ifdef INGAMEDIAG\n(?:\s*//[^\n]*\n)*\s*irxptr_tab\[modcount\]\.info = size_freezediag_irx", sysc) is not None,
+      "the menu registers freezediag.irx only in the flavour")
+
+# 4. Shared constants.
+opl_h = read("modules/iopcore/common/cdvdman_opl.h")
+codes = re.findall(r"#define (CDSC_\w+)\s+(0x[0-9A-Fa-f]+)", opl_h)
+values = [int(v, 16) for _, v in codes]
+check(len(values) == len(set(values)), "CDSC codes are unique")
+check(("CDSC_GET_FREEZE_DIAG", "0xFFFFFFEF") in codes, "freeze report CDSC code defined")
+shared = read("modules/iopcore/common/freeze_diag.h")
+check(re.search(r"#define FREEZE_DIAG_RPC_FNO\s+2\b", shared) is not None, "RPC function 2 (1 is shutdown)")
+
+# 5. The flavour exists and is built with the flag.
+flav = read(".github/workflows/flavours.yml")
+check(re.search(r"- flavour: OFFICIALROLLING-FREEZEDIAG\n\s+image: ghcr\.io/ps2homebrew/ps2homebrew:main\n(?:\s+\w+: [^\n]*\n)*?\s+ingamediag: \"1\"", flav) is not None,
+      "OFFICIALROLLING-FREEZEDIAG flavour on the toolchain testers run")
+check("INGAMEDIAG=${{ matrix.ingamediag || '0' }}" in flav, "the build step passes INGAMEDIAG")
+
+if FAILURES:
+    for f in FAILURES:
+        print("FAIL:", f)
+    sys.exit(1)
+print("test_ingame_freeze_diag: all checks passed")
diff --git a/.github/scripts/test_io_menu_lifetime.py b/.github/scripts/test_io_menu_lifetime.py
new file mode 100644
index 0000000..ade9659
--- /dev/null
+++ b/.github/scripts/test_io_menu_lifetime.py
@@ -0,0 +1,311 @@
+"""Compile real queue-count and submenu-removal routines; check GUI append OOM guard."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+io = (root / "src/ioman.c").read_text(encoding="utf-8")
+menu = (root / "src/menusys.c").read_text(encoding="utf-8")
+gui = (root / "src/gui.c").read_text(encoding="utf-8")
+
+def body(src, signature):
+    pos = src.index(signature)
+    brace = src.index("{", pos)
+    balance = 0
+    for end in range(brace, len(src)):
+        balance += (src[end] == "{") - (src[end] == "}")
+        if balance == 0:
+            return src[pos:end + 1]
+    raise AssertionError("unterminated function: " + signature)
+
+queue_fn = body(io, "int ioGetPendingRequestCount(void)")
+remove_fn = body(menu, "void submenuRemoveItem(")
+destroy_fn = body(menu, "static void submenuDestroyItem(")
+
+assert queue_fn.index("WaitSema(gProcSemaId)") < queue_fn.index("= gReqList;")
+append_start = gui.index("case GUI_OP_APPEND_MENU:")
+append_end = gui.index("case GUI_OP_SELECT_MENU:", append_start)
+append = gui[append_start:append_end]
+assert "if (result == NULL)\n                break;" in append
+assert append.index("if (result == NULL)") < append.index("->last = result")
+assert append.index("if (result == NULL)") < append.index("->current = result")
+
+program = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+typedef struct io_request_t {
+    int type;
+    void *data;
+    struct io_request_t *next;
+} io_request_t;
+static io_request_t old = {0}, head = {0}, tail = {0};
+static io_request_t *gReqList;
+static int gProcSemaId = 5, lockHeld = 0, mutateOnLock = 0;
+static int WaitSema(int id) {
+    assert(id == gProcSemaId && !lockHeld);
+    if (mutateOnLock) {
+        gReqList = &head;
+        head.next = &tail;
+        tail.next = NULL;
+    }
+    lockHeld = 1;
+    return 0;
+}
+static int SignalSema(int id) {
+    assert(id == gProcSemaId && lockHeld);
+    lockHeld = 0;
+    return 0;
+}
+@QUEUE_FN@
+typedef struct submenu_item {
+    int id;
+    int *cache_id, *cache_uid;
+} submenu_item_t;
+typedef struct submenu_list {
+    struct submenu_list *prev, *next;
+    submenu_item_t item;
+} submenu_list_t;
+@DESTROY_FN@
+@REMOVE_FN@
+static submenu_list_t *node(int id) {
+    submenu_list_t *n = calloc(1, sizeof(*n));
+    assert(n);
+    n->item.id = id;
+    return n;
+}
+int main(void) {
+    gReqList = &old;
+    old.next = NULL;
+    mutateOnLock = 1;
+    assert(ioGetPendingRequestCount() == 2);
+    assert(lockHeld == 0);
+    mutateOnLock = 0;
+    assert(ioGetPendingRequestCount() == 2);
+    gReqList = NULL;
+    assert(ioGetPendingRequestCount() == 0);
+
+    submenu_list_t *first = node(1), *middle = node(2), *last = node(3);
+    first->next = middle; middle->prev = first;
+    middle->next = last; last->prev = middle;
+    submenu_list_t *list = first;
+    submenuRemoveItem(&list, 2);
+    assert(list == first && first->next == last && last->prev == first);
+    submenuRemoveItem(&list, 1);
+    assert(list == last && list->prev == NULL);
+    submenuRemoveItem(&list, 3);
+    assert(list == NULL);
+
+    first = node(2); middle = node(2); last = node(3);
+    first->next = middle; middle->prev = first;
+    middle->next = last; last->prev = middle;
+    list = first;
+    submenuRemoveItem(&list, 2);
+    assert(list == last && list->prev == NULL && list->next == NULL);
+    submenuRemoveItem(&list, 3);
+    assert(list == NULL);
+    puts("PASS: queue snapshot is locked; removals preserve backward and forward links");
+    return 0;
+}
+'''.replace("@QUEUE_FN@", queue_fn).replace("@DESTROY_FN@", destroy_fn).replace("@REMOVE_FN@", remove_fn)
+
+cfg_src = (root / "src/config.c").read_text(encoding="utf-8")
+cfg_fns = "\n".join(body(cfg_src, sig) for sig in (
+    "static int configKeyValidate(",
+    "static struct config_value_t *allocConfigItem(",
+    "static int addConfigValue(",
+    "static struct config_value_t *getConfigItemForName(",
+    "int configSetStr(",
+    "int configGetStr(",
+    "int configGetStrCopy(",
+    "int configSetInt(",
+    "int configGetInt(",
+    "int configRemoveKey(",
+    "void configMerge(",
+))
+
+menu_cfg_fns = "\n".join(body(menu, sig) for sig in (
+    "static void _menuLoadConfig()",
+    "static void _menuLoadConfigAsync()",
+    "static void _menuRequestConfig()",
+    "config_set_t *menuLoadConfig()",
+    "config_set_t *gameMenuLoadConfig(",
+    "static int menuCanRequestItemConfig(",
+))
+
+menu_cfg_program = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define IO_OK 0
+#define IO_CUSTOM_SIMPLEACTION 1
+#define APP_MODE 10
+#define FAV_MODE 11
+#define MMCE_MODE 5
+#define BDM_MODE 2
+#define MENU_APP_CONFIG_IDLE_FRAMES 1
+#define MENU_MMCE_CONFIG_IDLE_FRAMES 3
+#define min(a, b) ((a) < (b) ? (a) : (b))
+
+static void _menuLoadConfig(void);
+
+struct config_value_t {
+    char key[32];
+    char val[256];
+    struct config_value_t *next;
+};
+typedef struct {
+    int uid;
+    int type;
+    struct config_value_t *head;
+    struct config_value_t *tail;
+    char *filename;
+    int modified;
+    int format;
+} config_set_t;
+
+static void configFree(config_set_t *cfg) {
+    if (!cfg) return;
+    struct config_value_t *it = cfg->head;
+    while (it) {
+        struct config_value_t *next = it->next;
+        free(it);
+        it = next;
+    }
+    free(cfg->filename);
+    free(cfg);
+}
+
+@CFG_FNS@
+
+typedef struct item_list item_list_t;
+struct item_list {
+    short mode;
+    int delay;
+    config_set_t *(*itemGetConfig)(item_list_t *list, int id);
+};
+typedef struct { int id; } submenu_item_inner_t;
+typedef struct { submenu_item_inner_t item; } submenu_cur_t;
+typedef struct { submenu_cur_t *current; item_list_t *userdata; } menu_item_t;
+typedef struct { menu_item_t *item; } menu_list_t;
+struct UIItem;
+
+static menu_list_t *selected_item;
+static int menuSemaId = 1, actionStatus, itemConfigId = -1, guiInactiveFrames;
+static config_set_t *itemConfig;
+static item_list_t *itemConfigList;
+static unsigned char itemConfigWorkerPending;
+static unsigned int itemConfigGeneration;
+
+static int WaitSema(int id) { (void)id; return 0; }
+static int SignalSema(int id) { (void)id; return 0; }
+
+static int queuedAsyncCount, queuedSyncCount, mmceAbortCount, pendingCancelCount, rumbleFlushCount;
+static int favSourceMode = BDM_MODE;
+static int favGetItemSourceMode(int id) { (void)id; return favSourceMode; }
+static int cacheAbortMmceImageLoadsTimed(int ms) { (void)ms; mmceAbortCount++; return 0; }
+static int cacheCancelPendingImageLoadsTimed(int ms) { (void)ms; pendingCancelCount++; return 0; }
+static void padRumbleFlush(void) { rumbleFlushCount++; }
+
+static void (*lastQueuedAction)(void);
+static int ioPutRequest(int type, void *data) {
+    assert(type == IO_CUSTOM_SIMPLEACTION);
+    lastQueuedAction = (void (*)(void))data;
+    if (data == (void *)&_menuLoadConfig)
+        queuedSyncCount++;
+    else
+        queuedAsyncCount++;
+    return IO_OK;
+}
+
+@MENU_CFG_FNS@
+
+static int getConfigCalls;
+static config_set_t *fakeGetConfig(item_list_t *list, int id) {
+    (void)list;
+    getConfigCalls++;
+    config_set_t *cfg = calloc(1, sizeof(*cfg));
+    assert(cfg);
+    configSetInt(cfg, "id", id);
+    return cfg;
+}
+
+int main(void) {
+    int val = 123;
+    char buf[16] = "keep";
+    /* NULL config_set_t must never dereference NULL->head */
+    assert(configGetInt(NULL, "k", &val) == 0 && val == 123);
+    assert(configSetInt(NULL, "k", 42) == 0);
+    assert(configGetStrCopy(NULL, "k", buf, sizeof(buf)) == 0 && buf[0] == '\0');
+    assert(configRemoveKey(NULL, "k") == 0);
+    configMerge(NULL, NULL);
+
+    item_list_t favList = {FAV_MODE, 6, fakeGetConfig};
+    submenu_cur_t cur = {{0}};
+    menu_item_t mitem = {&cur, &favList};
+    menu_list_t mlist = {&mitem};
+    selected_item = &mlist;
+
+    /* Active scroll (guiInactiveFrames == 0) must not request browse-time item configs */
+    guiInactiveFrames = 0;
+    favSourceMode = BDM_MODE;
+    assert(menuCanRequestItemConfig(&favList) == 0);
+    guiInactiveFrames = 1;
+    assert(menuCanRequestItemConfig(&favList) == 1);
+
+    /* FAV_MODE backed by MMCE_MODE enforces MENU_MMCE_CONFIG_IDLE_FRAMES (3) */
+    favSourceMode = MMCE_MODE;
+    guiInactiveFrames = 2;
+    assert(menuCanRequestItemConfig(&favList) == 0);
+    guiInactiveFrames = 3;
+    assert(menuCanRequestItemConfig(&favList) == 1);
+
+    /* Deduplicated async worker: multiple settled row changes while worker is pending queue only 1 request */
+    guiInactiveFrames = 10;
+    cur.item.id = 1;
+    _menuRequestConfig();
+    assert(queuedAsyncCount == 1 && itemConfigWorkerPending == 1);
+    cur.item.id = 2;
+    _menuRequestConfig();
+    cur.item.id = 3;
+    _menuRequestConfig();
+    assert(queuedAsyncCount == 1 && itemConfigWorkerPending == 1 && itemConfigId == 3);
+    lastQueuedAction();
+    assert(itemConfigWorkerPending == 0 && itemConfig != NULL);
+    assert(configGetInt(itemConfig, "id", &val) == 1 && val == 3);
+
+    /* Scrolling to a new row (guiInactiveFrames == 0 < list->delay) and immediately pressing Triangle
+       (gameMenuLoadConfig) must load the new row's config directly, abort MMCE + pending art on FAV_MODE,
+       and flush rumble without returning NULL or queuing onto ioman */
+    guiInactiveFrames = 0;
+    cur.item.id = 7;
+    favSourceMode = MMCE_MODE;
+    mmceAbortCount = pendingCancelCount = rumbleFlushCount = 0;
+    int prevQueued = queuedAsyncCount + queuedSyncCount;
+    config_set_t *loaded = gameMenuLoadConfig(NULL);
+    assert(loaded != NULL && loaded == itemConfig);
+    assert(configGetInt(loaded, "id", &val) == 1 && val == 7);
+    assert(rumbleFlushCount == 1 && mmceAbortCount == 1 && pendingCancelCount == 1);
+    assert(queuedAsyncCount + queuedSyncCount == prevQueued);
+
+    configFree(itemConfig);
+    itemConfig = NULL;
+    puts("PASS: NULL-safe config accessors, FAV_MODE scroll/MMCE gates, async config dedupe, and direct Triangle load");
+    return 0;
+}
+'''.replace("@CFG_FNS@", cfg_fns).replace("@MENU_CFG_FNS@", menu_cfg_fns)
+
+with tempfile.TemporaryDirectory() as temp:
+    f = Path(temp) / "regression.c"
+    exe = Path(temp) / "regression"
+    f.write_text(program, encoding="utf-8")
+    subprocess.run(["gcc", "-std=c99", "-Wall", "-Wextra", "-Werror", str(f), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, timeout=10)
+
+    f2 = Path(temp) / "menu_cfg.c"
+    exe2 = Path(temp) / "menu_cfg"
+    f2.write_text(menu_cfg_program, encoding="utf-8")
+    subprocess.run(["gcc", "-std=c99", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function", str(f2), "-o", str(exe2)], check=True)
+    subprocess.run([str(exe2)], check=True, timeout=10)
