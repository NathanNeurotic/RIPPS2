-    req->msg_type = UDPFS_MSG_CLOSE_REQ;
-    req->reserved[0] = 0;
-    req->reserved[1] = 0;
-    req->reserved[2] = 0;
-    req->handle = handle;
-
-    _request(req, sizeof(udpfs_msg_close_req_t),
-             reply, sizeof(udpfs_msg_close_reply_t));
-
-    return 0;
