@@ -721,4 +1094,160 @@ int raNetTestLink(char *line1, int sz1, char *line2, int sz2)
     return 1;
 }
 
+/* ---- xeRAbora achievement browser (Xerabora mode) ------------------------
+   ORBIT parity: ORBIT lists a game's achievements with the player's progress
+   from the xeRAbora PC's own HTTP interface (port 18280: /library, /game?id=N).
+   xeRAbora answers other devices only after OPEN TO THE NETWORK in its
+   settings. RiptOPL has no HTTPS, so where ORBIT asks retroachievements.org
+   for the game ID, the title from RAQ1 is matched against /library instead. */
+
+/* RAQ1 with the WAIT rounds; on "RAA1 OK" the reply stays in g_rx.
+   0 = known, 1 = RAA1 NO, -2 = silent, -7 = still identifying. */
+static int raq_ask(int sock, struct sockaddr_in *to, const char *req)
+{
+    int got = ask(sock, to, req, g_rx, sizeof(g_rx)), w;
+
+    for (w = 0; got > 0 && w < RA_WAIT_ROUNDS && strncmp(g_rx, "RAA1 WAIT", 9) == 0; w++) {
+        DelayThread(RA_WAIT_PAUSE_MS * 1000);
+        got = ask(sock, to, req, g_rx, sizeof(g_rx));
+    }
+    if (got <= 0)
+        return -2;
+    if (strncmp(g_rx, "RAA1 WAIT", 9) == 0)
+        return -7;
+    return strncmp(g_rx, "RAA1 OK ", 8) == 0 ? 0 : 1;
+}
+
+/* The PC that answers xeRAbora requests: the explicit RA companion IP, the
+   verified peer, else a RAP1 broadcast. Network byte order; 0 = none. */
+static u32 xerabora_host(int sock, const char *myaddr)
+{
+    struct sockaddr_in to;
+    char req[48];
+    u32 ip = raNetPeerIP();
+
+    if (raHostIsExplicit())
+        return configured_ra_target(&to, RA_PORT) ? to.sin_addr.s_addr : 0;
+    if (ip != 0)
+        return ip;
+    broadcast_target(&to);
+    snprintf(req, sizeof(req), "RAP1%s", myaddr);
+    if (ask(sock, &to, req, g_rx, sizeof(g_rx)) > 0 && strncmp(g_rx, "RAO1", 4) == 0) {
+        raNetRememberPeer(g_raReplyIP);
+        return g_raReplyIP;
+    }
+    return 0;
+}
+
+int raNetXeraboraIdentify(const char *hash, const char *serial, unsigned int *host,
+                          char *title, int titlesz, int *count)
+{
+    struct sockaddr_in to;
+    char req[96], myaddr[32], *name;
+    u8 ip[4];
+    int sock, result, bytes = 0, chunks = 0, nach = 0, n1, n2, pos = 0, len;
+
+    *host = 0;
+    title[0] = '\0';
+    *count = 0;
+    if (gRAMode != RA_MODE_XERABORA || raNetNicReserved())
+        return -8;
+    sock = open_pc_socket(myaddr, sizeof(myaddr), ip);
+    if (sock < 0)
+        return -1;
+    if (myaddr[0] == '\0' || (*host = xerabora_host(sock, myaddr)) == 0) {
+        disconnect(sock);
+        return -2;
+    }
+    memset(&to, 0, sizeof(to));
+    to.sin_family = AF_INET;
+    to.sin_port = htons(RA_PORT);
+    to.sin_addr.s_addr = *host;
+    if (hash == NULL) { /* host only: the account library needs no image */
+        disconnect(sock);
+        return 0;
+    }
+    snprintf(req, sizeof(req), "RAQ1 %s %s%s", hash, serial, myaddr);
+    result = raq_ask(sock, &to, req);
+    disconnect(sock);
+    if (result != 0)
+        return result;
+    /* Same shapes raAskPC accepts: five numbers (newer clients) or three, then the title. */
+    if (sscanf(g_rx + 8, "%d %d %d %d %d %n", &bytes, &chunks, &nach, &n1, &n2, &pos) != 5) {
+        pos = 0;
+        sscanf(g_rx + 8, "%d %d %d %n", &bytes, &chunks, &nach, &pos);
+    }
+    name = g_rx + 8 + pos;
+    len = (int)strlen(name);
+    while (len > 0 && name[len - 1] == ' ')
+        name[--len] = '\0';
+    snprintf(title, titlesz, "%s", name);
+    *count = nach;
+    return 0;
+}
+
+/* HTTP/1.0 GET of path from host:port into buf. Returns the body offset
+   (status 200) or a negative value. Reads use lwIP's per-call MSG_DONTWAIT
+   in 64-byte-aligned chunks (the rules above); the whole exchange is bounded
+   by RA_HTTP_MS so a stalled PC cannot hold the I/O thread indefinitely. */
+#define RA_HTTP_MS 8000
+int raNetHttpGet(unsigned int host, int port, const char *path, char *buf, int max, int *length)
+{
+    static char chunk[960] __attribute__((aligned(64)));
+    struct sockaddr_in to;
+    char req[160];
+    char *body;
+    clock_t start;
+    int sock, got, len = 0, status, closed = 0;
+
+    *length = 0;
+    if (host == 0 || max < 64 || raNetNicReserved())
+        return -1;
+    sock = socket(AF_INET, SOCK_STREAM, 0);
+    if (sock < 0)
+        return -1;
+    memset(&to, 0, sizeof(to));
+    to.sin_family = AF_INET;
+    to.sin_port = htons(port);
+    to.sin_addr.s_addr = host;
+    if (connect(sock, (struct sockaddr *)&to, sizeof(to)) < 0) {
+        disconnect(sock);
+        return -2;
+    }
+    snprintf(req, sizeof(req), "GET %s HTTP/1.0\r\nHost: %d.%d.%d.%d\r\nConnection: close\r\n\r\n", path,
+             host & 0xff, (host >> 8) & 0xff, (host >> 16) & 0xff, (host >> 24) & 0xff);
+    if (send(sock, req, strlen(req), 0) != (int)strlen(req)) {
+        disconnect(sock);
+        return -3;
+    }
+    /* Elapsed time: clock() is a 32-bit microsecond counter, so an absolute deadline breaks at
+       the wrap and RA_HTTP_MS times a full CLOCKS_PER_SEC overflows. */
+    start = clock();
+    while (len < max - 1 && (clock_t)(clock() - start) < (clock_t)RA_HTTP_MS * (CLOCKS_PER_SEC / 1000)) {
+        int room = max - 1 - len;
+        got = recv(sock, chunk, room < (int)sizeof(chunk) ? room : (int)sizeof(chunk), RA_MSG_DONTWAIT);
+        if (got == 0) {
+            closed = 1; /* the PC closed: complete */
+            break;
+        }
+        if (got < 0) {
+            DelayThread(RA_POLL_MS * 1000);
+            continue;
+        }
+        memcpy(buf + len, chunk, got);
+        len += got;
+    }
+    disconnect(sock);
+    buf[len] = '\0';
+    if (len >= max - 1 || !closed)
+        return -4; /* larger than the buffer, or cut off by the deadline: never parse a partial document */
+    if (sscanf(buf, "HTTP/%*d.%*d %d", &status) != 1 || status != 200)
+        return -5;
+    body = strstr(buf, "\r\n\r\n");
+    if (body == NULL)
+        return -5;
+    *length = len - (int)(body + 4 - buf);
+    return (int)(body + 4 - buf);
+}
+
 #endif /* RETROACHIEVEMENTS */
diff --git a/src/rapopslaunch.c b/src/rapopslaunch.c
new file mode 100644
index 0000000..42218d9
--- /dev/null
+++ b/src/rapopslaunch.c
@@ -0,0 +1,106 @@
+/* POPStarter telemetry adapted from hacan359/Open-PS2-Loader 531aad45.
+   Driver selection and ELF handoff remain owned by RiptOPL's VCD launcher. */
+#ifdef RETROACHIEVEMENTS
+#include "include/opl.h"
+#include "include/ethsupport.h"
+#include "include/extern_irx.h"
+#include "include/supportbase.h"
+#include "include/rahash.h"
+#include "include/rawatch.h"
+#include "include/ranet.h"
+#include "include/rapopslaunch.h"
+#include "modules/network/common/rapops_cfg.h"
+#include <errno.h>
+
+int raPopsPrepare(const char *root, const char *watchRoot, const char *vcdPath, int slotFree)
+{
+    char boot[16], watchKey[16], contentHash[33], path[256];
+    unsigned char ip[4], mask[4], gw[4];
+    unsigned char *irx;
+    struct rapops_cfg *cfg = NULL;
+    unsigned int i;
+    int n, fd, off = 0, result = -1;
+    unsigned int peer;
+
+    if (!gRATelemetry)
+        return 0;
+    if (raVcdWatchKey(vcdPath, watchKey, sizeof(watchKey)) != 0 ||
+        sbLoadWatchList(watchRoot, watchKey) <= 0 || GetWatchCount() <= 0)
+        return 0; /* No support check/list: ordinary POPStarter launch. */
+    /* A VCD replacement at the same path retains the same 15-byte protocol
+       serial, but MUST NOT inherit another image's watch list. Rehash the
+       executable rather than treating a matching path or timestamp as proof. */
+    if (raHashVcd(vcdPath, boot, sizeof(boot), contentHash) != 0 ||
+        !raVcdWatchGuardMatches(watchRoot, watchKey, contentHash))
+        return 0; /* Missing/old guard: game boots normally, untracked. */
+    /* A stale watch list must never make an otherwise playable PS1 game
+       unlaunchable. Share PS2's link, DHCP and Caduceus session preflight. */
+    raLaunchNetworkUp();
+    if (GetWatchCount() <= 0 || ethGetNetConfig(ip, mask, gw) < 0 || !(ip[0] | ip[1] | ip[2] | ip[3]))
+        return 0;
+    if (!slotFree)
+        return -1; /* FAT does not enforce O_EXCL: refuse the user-owned slot explicitly. */
+    if (snprintf(path, sizeof(path), "%sPOPS/MODULE_9.IRX", root) >= (int)sizeof(path))
+        return -1;
+    irx = malloc(size_rapops_irx);
+    if (!irx)
+        return 0; /* Optional telemetry: low memory must not block the game. */
+    memcpy(irx, &rapops_irx, size_rapops_irx);
+    for (i = 0; i + sizeof(*cfg) <= size_rapops_irx; i += 4) {
+        if (memcmp(irx + i, RAPOPS_MAGIC, 8) == 0) {
+            cfg = (struct rapops_cfg *)(irx + i);
+            break;
+        }
+    }
+    if (!cfg) {
+        result = 0; /* No valid embedded config; nothing has been installed. */
+        goto done;
+    }
+    n = snprintf(cfg->ipcfg, sizeof(cfg->ipcfg), "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]) + 1;
+    n += snprintf(cfg->ipcfg + n, sizeof(cfg->ipcfg) - n, "%u.%u.%u.%u", mask[0], mask[1], mask[2], mask[3]) + 1;
+    n += snprintf(cfg->ipcfg + n, sizeof(cfg->ipcfg) - n, "%u.%u.%u.%u", gw[0], gw[1], gw[2], gw[3]) + 1;
+    cfg->ipcfg_len = n;
+    snprintf(cfg->game_id, sizeof(cfg->game_id), "%s", watchKey);
+    cfg->client_mode = gRAMode == RA_MODE_CADUCEUS;
+    cfg->host_pinned = (gRAHostIp[0] | gRAHostIp[1] | gRAHostIp[2] | gRAHostIp[3]) != 0;
+    peer = raNetPeerIP();
+    if (peer) {
+        const unsigned char *host = (const unsigned char *)&peer;
+        snprintf(cfg->host, sizeof(cfg->host), "%u.%u.%u.%u", host[0], host[1], host[2], host[3]);
+    } else if (gRAHostIp[0] | gRAHostIp[1] | gRAHostIp[2] | gRAHostIp[3]) {
+        snprintf(cfg->host, sizeof(cfg->host), "%u.%u.%u.%u",
+                 gRAHostIp[0], gRAHostIp[1], gRAHostIp[2], gRAHostIp[3]);
+    }
+    cfg->count = GetWatchCount();
+    cfg->bytes = GetWatchBytes();
+    cfg->node_count = GetNodeCount();
+    if (!cfg->count || cfg->count > RA_WATCH_MAX || cfg->node_count > RA_NODE_MAX ||
+        cfg->bytes + cfg->node_count * RA_NODE_PAIR_BYTES > RA_SNAP_MAX_BYTES)
+        goto done;
+    memcpy(cfg->list, GetWatchList(), cfg->count * sizeof(unsigned int));
+    if (cfg->node_count)
+        memcpy(cfg->nodes, GetNodeList(), cfg->node_count * sizeof(struct ra_node));
+    /* Ownership/absence was checked before preparation. O_EXCL is only a supplementary
+       guard on backends that implement it; PS2 FAT currently ignores that flag. */
+    fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0644);
+    if (fd < 0) {
+        result = 0; /* Read-only/absent USB path: launch without telemetry. */
+        goto done;
+    }
+    while (off < (int)size_rapops_irx) {
+        n = write(fd, irx + off, size_rapops_irx - off);
+        if (n <= 0)
+            break;
+        off += n;
+    }
+    result = off == (int)size_rapops_irx ? 0 : -1;
+    if (close(fd) < 0)
+        result = -1;
+    if (result < 0 && unlink(path) == 0)
+        result = 0; /* A failed install that was fully removed is safe to skip.
+                       If removal fails, block to avoid booting a corrupt module. */
+done:
+    free(irx);
+    return result;
+}
+#endif
diff --git a/src/ratls.c b/src/ratls.c
new file mode 100644
index 0000000..f51af26
--- /dev/null
+++ b/src/ratls.c
@@ -0,0 +1,274 @@
+/*
+  ratls.c -- the portable half of the RetroAchievements HTTPS lookup.
+
+  ORBIT asks retroachievements.org for a game's ID by hash over HTTPS; the RA
+  edition does the same. This file runs one TLS 1.3 / 1.2 session (vendored
+  mbedTLS, third_party/mbedtls) and one HTTP GET over callbacks the caller
+  supplies, so it builds unchanged on the host for tests. Sockets, DNS, the
+  console clock, entropy and the embedded roots are in ratls_ps2.c.
+
+  Certificates are always verified (VERIFY_REQUIRED, SNI, host name) against
+  the anchors passed in; a clock that is not set fails closed before anything
+  is sent. A body is returned only when it arrived whole: Content-Length met,
+  chunked encoding terminated, or the server closed a body without either.
+*/
+
+#include "include/ratls.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "mbedtls/platform_time.h"
+#include "mbedtls/psa_util.h"
+#include "mbedtls/ssl.h"
+#include "mbedtls/x509_crt.h"
+#include "psa/crypto.h"
+
+#define RATLS_REQUEST_MAX 512
+
+static long long (*g_now)(void);
+static int g_psaReady;
+
+/* The PS2 RTC keeps Japan time (ps2sdk's ps2time() in ee/rpc/cdvd/src/scmd.c converts it with a
+   -9 h offset), so UTC = RTC - 9 h. */
+#define RATLS_RTC_ZONE_SECONDS (9 * 60 * 60)
+
+long long raTlsRtcToUtc(int year, int month, int day, int hour, int minute, int second)
+{
+    /* Days from 1970-01-01 (Howard Hinnant's days_from_civil). */
+    int y = year - (month <= 2);
+    long long era = (y >= 0 ? y : y - 399) / 400;
+    unsigned yoe = (unsigned)(y - era * 400);
+    unsigned doy = (153u * (unsigned)(month + (month > 2 ? -3 : 9)) + 2u) / 5u + (unsigned)day - 1u;
+    unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
+    long long days = era * 146097 + (long long)doe - 719468;
+
+    return days * 86400 + hour * 3600 + minute * 60 + second - RATLS_RTC_ZONE_SECONDS;
+}
+
+int raTlsClockOk(long long (*now_utc)(void))
+{
+    return now_utc != NULL && now_utc() >= 0;
+}
+
+static mbedtls_time_t ratlsTime(mbedtls_time_t *timer)
+{
+    mbedtls_time_t now = (mbedtls_time_t)(g_now != NULL ? g_now() : -1);
+    if (timer != NULL)
+        *timer = now;
+    return now;
+}
+
+/* Header end (index of the body) or -1. */
+static int headerEnd(const char *buf, int len)
+{
+    int i;
+    for (i = 0; i + 3 < len; i++)
+        if (buf[i] == '\r' && buf[i + 1] == '\n' && buf[i + 2] == '\r' && buf[i + 3] == '\n')
+            return i + 4;
+    return -1;
+}
+
+/* Value of a header (case-insensitive name) within the header block, or NULL. */
+static const char *headerValue(const char *buf, int bodyAt, const char *name)
+{
+    size_t n = strlen(name);
+    const char *line = strstr(buf, "\r\n");
+
+    while (line != NULL && line + 2 < buf + bodyAt) {
+        const char *p = line + 2;
+        size_t i;
+        for (i = 0; i < n && p[i] && (p[i] | 0x20) == (name[i] | 0x20); i++)
+            ;
+        if (i == n && p[n] == ':') {
+            p += n + 1;
+            while (*p == ' ' || *p == '\t')
+                p++;
+            return p;
+        }
+        line = strstr(p, "\r\n");
+    }
+    return NULL;
+}
+
+/* De-chunks the body in place. Returns the new body length, or -1 if malformed/incomplete. */
+static int dechunk(char *body, int len)
+{
+    int in = 0, out = 0;
+
+    for (;;) {
+        char *end;
+        long size;
+        int eol;
+
+        for (eol = in; eol + 1 < len && !(body[eol] == '\r' && body[eol + 1] == '\n'); eol++)
+            ;
+        if (eol + 1 >= len)
+            return -1;
+        size = strtol(body + in, &end, 16);
+        if (end == body + in || size < 0)
+            return -1;
+        in = eol + 2;
+        if (size == 0)
+            return out;
+        if (size > len - in - 2 || body[in + size] != '\r' || body[in + size + 1] != '\n')
+            return -1;
+        memmove(body + out, body + in, (size_t)size);
+        out += (int)size;
+        in += (int)size + 2;
+    }
+}
+
+/* Whether everything has arrived: by Content-Length, or the chunked terminator. */
+static int responseComplete(const char *buf, int len)
+{
+    int bodyAt = headerEnd(buf, len);
+    const char *value;
+
+    if (bodyAt < 0)
+        return 0;
+    if ((value = headerValue(buf, bodyAt, "Content-Length")) != NULL)
+        return len - bodyAt >= atoi(value);
+    if ((value = headerValue(buf, bodyAt, "Transfer-Encoding")) != NULL && !strncmp(value, "chunked", 7))
+        return len - bodyAt >= 5 && !memcmp(buf + len - 5, "0\r\n\r\n", 5);
+    return 0; /* delimited by the server closing */
+}
+
+static int finishResponse(char *buf, int len, int *length)
+{
+    int status, bodyAt = headerEnd(buf, len);
+    const char *value;
+
+    if (bodyAt < 0 || sscanf(buf, "HTTP/%*d.%*d %d", &status) != 1 || status != 200)
+        return RATLS_ERR_HTTP;
+    if ((value = headerValue(buf, bodyAt, "Transfer-Encoding")) != NULL && !strncmp(value, "chunked", 7)) {
+        int body = dechunk(buf + bodyAt, len - bodyAt);
+        if (body < 0)
+            return RATLS_ERR_HTTP;
+        len = bodyAt + body;
+    } else if ((value = headerValue(buf, bodyAt, "Content-Length")) != NULL) {
+        int want = atoi(value);
+        if (want < 0 || len - bodyAt < want)
+            return RATLS_ERR_HTTP; /* cut short: never parse a partial document */
+        len = bodyAt + want;
+    }
+    buf[len] = '\0';
+    *length = len;
+    return bodyAt;
+}
+
+static int mapError(int rc, const mbedtls_ssl_context *ssl)
+{
+    uint32_t flags;
+
+    if (rc == MBEDTLS_ERR_SSL_TIMEOUT)
+        return RATLS_ERR_TIMEOUT;
+    if (rc == MBEDTLS_ERR_SSL_ALLOC_FAILED)
+        return RATLS_ERR_MEM;
+    flags = mbedtls_ssl_get_verify_result(ssl);
+    if (rc == MBEDTLS_ERR_X509_CERT_VERIFY_FAILED || (flags != 0 && flags != (uint32_t)-1))
+        return RATLS_ERR_CERT;
+    return RATLS_ERR_TLS;
+}
+
+int raTlsRequest(const ratls_io_t *io, const char *host, const char *path, const char *user_agent,
+                 const ratls_anchor_t *anchors, int anchor_count, char *buf, int max, int *length)
+{
+    mbedtls_ssl_context ssl;
+    mbedtls_ssl_config conf;
+    mbedtls_x509_crt ca;
+    char request[RATLS_REQUEST_MAX];
+    int rc, i, len = 0, result, sent = 0, reqlen;
+
+    if (length != NULL)
+        *length = 0;
+    if (io == NULL || io->send == NULL || io->recv == NULL || host == NULL || path == NULL || user_agent == NULL ||
+        anchors == NULL || anchor_count <= 0 || buf == NULL || max < 64 || length == NULL)
+        return RATLS_ERR_ARG;
+    if (!raTlsClockOk(io->now_utc))
+        return RATLS_ERR_CLOCK;
+    reqlen = snprintf(request, sizeof(request),
+                      "GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: %s\r\nAccept: application/json\r\nConnection: close\r\n\r\n",
+                      path, host, user_agent);
+    if (reqlen <= 0 || reqlen >= (int)sizeof(request))
+        return RATLS_ERR_ARG;
+
+    g_now = io->now_utc;
+    mbedtls_platform_set_time(ratlsTime);
+    if (!g_psaReady) {
+        if (psa_crypto_init() != PSA_SUCCESS)
+            return RATLS_ERR_MEM;
+        g_psaReady = 1;
+    }
+
+    mbedtls_ssl_init(&ssl);
+    mbedtls_ssl_config_init(&conf);
+    mbedtls_x509_crt_init(&ca);
+
+    result = RATLS_ERR_TLS;
+    for (i = 0; i < anchor_count; i++)
+        if (mbedtls_x509_crt_parse_der(&ca, anchors[i].der, anchors[i].len) != 0)
+            goto out; /* a broken anchor is a build defect, never "trust anything" */
+
+    if (mbedtls_ssl_config_defaults(&conf, MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM,
+                                    MBEDTLS_SSL_PRESET_DEFAULT) != 0)
+        goto out;
+    mbedtls_ssl_conf_authmode(&conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+    mbedtls_ssl_conf_ca_chain(&conf, &ca, NULL);
+    mbedtls_ssl_conf_rng(&conf, mbedtls_psa_get_random, MBEDTLS_PSA_RANDOM_STATE);
+    if ((rc = mbedtls_ssl_setup(&ssl, &conf)) != 0 || (rc = mbedtls_ssl_set_hostname(&ssl, host)) != 0) {
+        result = rc == MBEDTLS_ERR_SSL_ALLOC_FAILED ? RATLS_ERR_MEM : RATLS_ERR_TLS;
+        goto out;
+    }
+    mbedtls_ssl_set_bio(&ssl, io->ctx, io->send, io->recv, NULL);
+
+    while ((rc = mbedtls_ssl_handshake(&ssl)) != 0) {
+        if (rc != MBEDTLS_ERR_SSL_WANT_READ && rc != MBEDTLS_ERR_SSL_WANT_WRITE) {
+            result = mapError(rc, &ssl);
+            goto out;
+        }
+    }
+
+    while (sent < reqlen) {
+        rc = mbedtls_ssl_write(&ssl, (const unsigned char *)request + sent, (size_t)(reqlen - sent));
+        if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE)
+            continue;
+        if (rc <= 0) {
+            result = mapError(rc, &ssl);
+            goto out;
+        }
+        sent += rc;
+    }
+
+    for (;;) {
+        if (len >= max - 1) {
+            result = RATLS_ERR_HTTP; /* larger than the buffer */
+            goto out;
+        }
+        rc = mbedtls_ssl_read(&ssl, (unsigned char *)buf + len, (size_t)(max - 1 - len));
+        if (rc > 0) {
+            len += rc;
+            buf[len] = '\0';
+            if (responseComplete(buf, len))
+                break;
+            continue;
+        }
+        if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE ||
+            rc == MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET)
+            continue;
+        if (rc == 0 || rc == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY)
+            break; /* the server closed: whatever arrived is complete or rejected below */
+        result = mapError(rc, &ssl);
+        goto out;
+    }
+    buf[len] = '\0';
+    result = finishResponse(buf, len, length);
+    mbedtls_ssl_close_notify(&ssl);
+
+out:
+    mbedtls_ssl_free(&ssl);
+    mbedtls_ssl_config_free(&conf);
+    mbedtls_x509_crt_free(&ca);
+    return result;
+}
diff --git a/src/ratls_ps2.c b/src/ratls_ps2.c
new file mode 100644
index 0000000..7c99fb9
--- /dev/null
+++ b/src/ratls_ps2.c
@@ -0,0 +1,202 @@
+/*
+  ratls_ps2.c -- the console half of the RetroAchievements HTTPS lookup.
+
+  Supplies what src/ratls.c needs on a PS2: DNS and a TCP connection through
+  the menu's network stack (ps2ips), a BIO that reads with lwIP's per-call
+  non-blocking flag under an overall deadline (fcntl O_NONBLOCK has no effect
+  on this stack, see ranet.c), the console clock as UTC, an entropy source,
+  mbedtls_ms_time(), and the six embedded roots (third_party/ca-roots, turned
+  into ratls_root_<name>.c by the Makefile).
+
+  Runs on the I/O worker. Refuses while a UDP transport owns the NIC.
+*/
+
+#include "include/ratls.h"
+#include "include/ranet.h" /* raNetNicReserved */
+
+#include <ps2ips.h>
+#include <netdb.h>
+#include <kernel.h>
+#include <delaythread.h>
+#include <libcdvd.h>
+#include <string.h>
+#include <time.h>
+
+#include "mbedtls/net_sockets.h" /* MBEDTLS_ERR_NET_SEND_FAILED */
+#include "mbedtls/platform_time.h"
+#include "mbedtls/ssl.h"
+
+#define RATLS_DEADLINE_MS  8000 /* the same budget as the xeRAbora HTTP fetch (RA_HTTP_MS) */
+#define RATLS_MSG_DONTWAIT 0x08 /* lwIP MSG_DONTWAIT, forwarded per call over SIF RPC */
+#define RATLS_POLL_MS      25
+#define RATLS_MIN_YEAR     2025 /* an earlier RTC is unset: fail closed */
+
+extern unsigned char ratls_root_gtsr1[], ratls_root_gtsr2[], ratls_root_gtsr3[], ratls_root_gtsr4[];
+extern unsigned char ratls_root_isrgrootx1[], ratls_root_isrgrootx2[];
+extern unsigned int size_ratls_root_gtsr1, size_ratls_root_gtsr2, size_ratls_root_gtsr3, size_ratls_root_gtsr4;
+extern unsigned int size_ratls_root_isrgrootx1, size_ratls_root_isrgrootx2;
+
+static int bcd(unsigned char v)
+{
+    return (v >> 4) * 10 + (v & 0x0F);
+}
+
+static long long ratlsNow(void)
+{
+    sceCdCLOCK clk;
+    int year;
+
+    if (sceCdReadClock(&clk) == 0)
+        return -1;
+    year = 2000 + bcd(clk.year);
+    if (year < RATLS_MIN_YEAR)
+        return -1;
+    return raTlsRtcToUtc(year, bcd(clk.month & 0x1F), bcd(clk.day), bcd(clk.hour), bcd(clk.minute), bcd(clk.second));
+}
+
+mbedtls_ms_time_t mbedtls_ms_time(void)
+{
+    return (mbedtls_ms_time_t)clock() * 1000 / CLOCKS_PER_SEC;
+}
+
+static inline unsigned int cop0Count(void)
+{
+    unsigned int count;
+    __asm__ volatile("mfc0 %0, $9"
+                     : "=r"(count));
+    return count;
+}
+
+/* The PS2 has no hardware RNG. Each output byte folds 8 samples of the
+   294.912 MHz COP0 count's low bits across a thread switch (interrupt and DMA
+   timing make them jitter), credited at 1 bit per sample; the CDVD clock and
+   clock() are mixed in once per call. mbedTLS's entropy accumulator gathers
+   until the CTR_DRBG seed reaches its threshold (spec: >= 512 samples, about
+   256 bits by this estimate). */
+int mbedtls_hardware_poll(void *data, unsigned char *out, size_t len, size_t *olen)
+{
+    sceCdCLOCK clk;
+    size_t i;
+    int s;
+
+    (void)data;
+    for (i = 0; i < len; i++) {
+        unsigned char byte = 0;
+        for (s = 0; s < 8; s++) {
+            unsigned int before = cop0Count();
+            DelayThread(1);
+            byte = (unsigned char)((byte << 1) | (byte >> 7)) ^ (unsigned char)(cop0Count() - before);
+        }
+        out[i] = byte ^ (unsigned char)clock();
+    }
+    if (len >= sizeof(clk) && sceCdReadClock(&clk) != 0) {
+        const unsigned char *c = (const unsigned char *)&clk;
+        for (i = 0; i < sizeof(clk); i++)
+            out[i] ^= c[i];
+    }
+    *olen = len;
+    return 0;
+}
+
+typedef struct
+{
+    int sock;
+    clock_t start; /* the budget runs from before DNS */
+} ratls_bio_t;
+
+/* clock() is a 32-bit microsecond counter here: compare elapsed time, which survives the wrap,
+   and keep the product small (milliseconds times a full CLOCKS_PER_SEC would overflow). */
+static int ratlsExpired(clock_t start)
+{
+    return (clock_t)(clock() - start) >= (clock_t)RATLS_DEADLINE_MS * (CLOCKS_PER_SEC / 1000);
+}
+
+static int bioSend(void *ctx, const unsigned char *buf, size_t len)
+{
+    ratls_bio_t *bio = ctx;
+    int n = send(bio->sock, (void *)buf, len, 0);
+    return n < 0 ? MBEDTLS_ERR_NET_SEND_FAILED : n;
+}
+
+/* Reads through a 64-byte-aligned bounce buffer, never more than 960 bytes at
+   a time (the same rules as raNetHttpGet), polling until data, close or the
+   deadline. */
+static int bioRecv(void *ctx, unsigned char *buf, size_t len)
+{
+    static unsigned char chunk[960] __attribute__((aligned(64)));
+    ratls_bio_t *bio = ctx;
+
+    for (;;) {
+        int got;
+        if (ratlsExpired(bio->start))
+            return MBEDTLS_ERR_SSL_TIMEOUT;
+        got = recv(bio->sock, chunk, len < sizeof(chunk) ? len : sizeof(chunk), RATLS_MSG_DONTWAIT);
+        if (got == 0)
+            return 0; /* closed */
+        if (got > 0) {
+            memcpy(buf, chunk, got);
+            return got;
+        }
+        DelayThread(RATLS_POLL_MS * 1000);
+    }
+}
+
+int raHttpsGet(const char *host, const char *path, char *buf, int max, int *length)
+{
+    static ratls_anchor_t anchors[6];
+    struct sockaddr_in to;
+    struct hostent *he;
+    ratls_bio_t bio;
+    ratls_io_t io;
+    int rc;
+    clock_t start = clock();
+
+    if (length != NULL)
+        *length = 0;
+    if (!raTlsClockOk(ratlsNow)) /* before any DNS lookup or connection */
+        return RATLS_ERR_CLOCK;
+    if (raNetNicReserved())
+        return RATLS_ERR_NET;
+
+    anchors[0].der = ratls_root_gtsr1;
+    anchors[0].len = size_ratls_root_gtsr1;
+    anchors[1].der = ratls_root_gtsr2;
+    anchors[1].len = size_ratls_root_gtsr2;
+    anchors[2].der = ratls_root_gtsr3;
+    anchors[2].len = size_ratls_root_gtsr3;
+    anchors[3].der = ratls_root_gtsr4;
+    anchors[3].len = size_ratls_root_gtsr4;
+    anchors[4].der = ratls_root_isrgrootx1;
+    anchors[4].len = size_ratls_root_isrgrootx1;
+    anchors[5].der = ratls_root_isrgrootx2;
+    anchors[5].len = size_ratls_root_isrgrootx2;
+
+    he = gethostbyname(host);
+    if (he == NULL || he->h_addr_list == NULL || he->h_addr_list[0] == NULL)
+        return RATLS_ERR_NET;
+    memset(&to, 0, sizeof(to));
+    to.sin_family = AF_INET;
+    to.sin_port = htons(443);
+    memcpy(&to.sin_addr, he->h_addr_list[0], sizeof(to.sin_addr));
+
+    bio.sock = socket(AF_INET, SOCK_STREAM, 0);
+    if (bio.sock < 0)
+        return RATLS_ERR_NET;
+    if (connect(bio.sock, (struct sockaddr *)&to, sizeof(to)) < 0) {
+        disconnect(bio.sock);
+        return RATLS_ERR_NET;
+    }
+    bio.start = start;
+    if (ratlsExpired(start)) { /* DNS and connect already used the budget */
+        disconnect(bio.sock);
+        return RATLS_ERR_TIMEOUT;
+    }
+    io.send = bioSend;
+    io.recv = bioRecv;
+    io.ctx = &bio;
+    io.now_utc = ratlsNow;
+
+    rc = raTlsRequest(&io, host, path, "RiptOPL/" OPL_VERSION, anchors, 6, buf, max, length);
+    disconnect(bio.sock);
+    return rc;
+}
