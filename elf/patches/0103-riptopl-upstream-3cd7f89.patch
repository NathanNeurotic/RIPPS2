+++ b/.github/scripts/test_config_null_allocation.py
@@ -0,0 +1,160 @@
+"""Verify NULL config handling across config routines, autolaunch, and menu handlers (Issue #961)."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+
+# 1. Structural checks
+config_c = (ROOT / "src/config.c").read_text(encoding="utf-8")
+supportbase_c = (ROOT / "src/supportbase.c").read_text(encoding="utf-8")
+opl_c = (ROOT / "src/opl.c").read_text(encoding="utf-8")
+guigame_c = (ROOT / "src/guigame.c").read_text(encoding="utf-8")
+menusys_c = (ROOT / "src/menusys.c").read_text(encoding="utf-8")
+appsupport_c = (ROOT / "src/appsupport.c").read_text(encoding="utf-8")
+
+# Check config.c entry NULL guards
+assert "if (configSet == NULL)\n        return 0;" in config_c[config_c.index("int configRead(config_set_t *configSet)"):]
+assert "if (configSet == NULL)\n        return 0;" in config_c[config_c.index("int configReadBuffer(config_set_t *configSet, const void *buffer, int size)"):]
+assert "if (configSet == NULL)\n        return 0;" in config_c[config_c.index("int configWrite(config_set_t *configSet)"):]
+assert "void configClear(config_set_t *configSet)\n{\n    if (configSet == NULL)\n        return;" in config_c
+assert "int configGetStat(config_set_t *configSet, iox_stat_t *stat)\n{\n    if (configSet == NULL" in config_c
+
+# Check sbPopulateConfig NULL check before configRead
+sb_alloc = supportbase_c.index("config_set_t *config = configAlloc(0, NULL, path);")
+sb_read = supportbase_c.index("int configLoaded = configRead(config);", sb_alloc)
+sb_slice = supportbase_c[sb_alloc:sb_read]
+assert "if (config == NULL)\n        return NULL;" in sb_slice
+
+# Check autoLaunchHDDGame NULL check before configRead
+hdl_idx = opl_c.index("static void autoLaunchHDDGame(")
+hdl_end = opl_c.index("static void autoLaunchBDMGame(")
+hdl_slice = opl_c[hdl_idx:hdl_end]
+assert hdl_slice.index("if (configSet == NULL)") < hdl_slice.index("configRead(configSet);")
+
+# Check itemExecTriangle checks gameMenuLoadConfig before menuInitGameMenu
+tri_idx = opl_c.index("static void itemExecTriangle(")
+tri_end = opl_c.index("static void initMenuForListSupport(", tri_idx)
+tri_slice = opl_c[tri_idx:tri_end]
+assert "config_set_t *configSet = gameMenuLoadConfig(NULL);" in tri_slice
+assert "if (configSet == NULL)\n                    return;" in tri_slice
+assert tri_slice.index("gameMenuLoadConfig(NULL)") < tri_slice.index("menuInitGameMenu(support);")
+
+# Check guiGameSaveConfig and guiGameRemoveSettings NULL guards
+assert "int guiGameSaveConfig(config_set_t *configSet, item_list_t *support)\n{\n    if (configSet == NULL)\n        return -1;" in guigame_c
+assert "void guiGameRemoveSettings(config_set_t *configSet)\n{\n    if (configSet == NULL)\n        return;" in guigame_c
+assert "void guiGameLoadConfig(item_list_t *support, config_set_t *configSet)\n{\n    int i;\n    config_set_t *configGame;\n\n    if (configSet == NULL)\n        return;" in guigame_c
+
+# Check menusys.c NULL guards in _menuSaveConfig and GAME_SAVE_CHANGES
+assert "WaitSema(menuSemaId);\n    if (itemConfig == NULL) {\n        actionStatus = 0;\n        menuSaveResult = 0;\n        SignalSema(menuSemaId);\n        return;\n    }" in menusys_c
+save_branch = menusys_c[menusys_c.index("} else if (menuID == GAME_SAVE_CHANGES)"):menusys_c.index("} else if (menuID == GAME_TEST_CHANGES)")]
+assert "if (itemConfig == NULL) {\n                guiMsgBox(_l(_STR_ERROR_SAVING_SETTINGS), 0, NULL);\n                return;\n            }" in save_branch
+
+# Check appsupport.c NULL checks in appGetConfig
+app_idx = appsupport_c.index("config_set_t *appGetConfig(item_list_t *itemList, int id)")
+app_slice = appsupport_c[app_idx:]
+assert "config = oplGetLegacyAppsInfo(appGetELFName(cur->val));\n        if (config == NULL)\n            return NULL;" in app_slice
+assert "config = configAlloc(0, NULL, path);\n        if (config == NULL)\n            return NULL;" in app_slice
+
+# 2. C compilation harness to verify NULL safety of configRead, configWrite, configClear, configGetStat
+c_harness = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct config_value_t {
+    char key[64];
+    char val[64];
+    struct config_value_t *next;
+} config_value_t;
+
+typedef struct {
+    int type;
+    char *filename;
+    int modified;
+    struct config_value_t *head;
+    struct config_value_t *tail;
+} config_set_t;
+
+typedef struct {
+    int mode;
+} iox_stat_t;
+
+int fileXioGetStat(const char *path, iox_stat_t *stat) {
+    (void)path; (void)stat;
+    return 0;
+}
+
+int configRead(config_set_t *configSet) {
+    if (configSet == NULL || configSet->filename == NULL || configSet->filename[0] == '\0')
+        return 0;
+    return 1;
+}
+
+int configReadBuffer(config_set_t *configSet, const void *buffer, int size) {
+    if (configSet == NULL || buffer == NULL || size <= 0)
+        return 0;
+    return 1;
+}
+
+int configWrite(config_set_t *configSet) {
+    if (configSet == NULL || configSet->filename == NULL || configSet->filename[0] == '\0')
+        return 0;
+    return 1;
+}
+
+void configClear(config_set_t *configSet) {
+    if (configSet == NULL)
+        return;
+    while (configSet->head) {
+        struct config_value_t *cur = configSet->head;
+        configSet->head = cur->next;
+        free(cur);
+    }
+    configSet->head = NULL;
+    configSet->tail = NULL;
+    configSet->modified = 1;
+}
+
+int configGetStat(config_set_t *configSet, iox_stat_t *stat) {
+    if (configSet == NULL || stat == NULL || configSet->filename == NULL || configSet->filename[0] == '\0')
+        return 0;
+    return (fileXioGetStat(configSet->filename, stat) >= 0 ? 1 : 0);
+}
+
+int main(void) {
+    iox_stat_t stat;
+    const char buf[] = "test = 1;\n";
+
+    assert(configRead(NULL) == 0);
+    assert(configReadBuffer(NULL, buf, sizeof(buf)) == 0);
+    assert(configReadBuffer(NULL, NULL, 0) == 0);
+    assert(configWrite(NULL) == 0);
+    configClear(NULL);
+    assert(configGetStat(NULL, &stat) == 0);
+    assert(configGetStat(NULL, NULL) == 0);
+
+    config_set_t empty = {0};
+    assert(configRead(&empty) == 0);
+    assert(configWrite(&empty) == 0);
+    assert(configGetStat(&empty, &stat) == 0);
+
+    puts("PASS: config NULL checks protect against unallocated configSet dereferences");
+    return 0;
+}
+'''
+
+with tempfile.TemporaryDirectory() as directory:
+    path = Path(directory)
+    c_file = path / "test_null_config.c"
+    exe_file = path / ("test_null_config.exe" if os.name == "nt" else "test_null_config")
+    c_file.write_text(c_harness, encoding="utf-8")
+    flags = ["-std=c99", "-Wall", "-Wextra", "-Werror"]
+    if os.name != "nt":
+        flags += ["-fsanitize=address,undefined", "-fno-pie", "-no-pie"]
+    subprocess.run([os.environ.get("CC", "gcc"), *flags, str(c_file), "-o", str(exe_file)], check=True)
+    subprocess.run([str(exe_file)], check=True, timeout=10)
diff --git a/.github/scripts/test_config_save_integrity.py b/.github/scripts/test_config_save_integrity.py
new file mode 100644
index 0000000..8e795a7
--- /dev/null
+++ b/.github/scripts/test_config_save_integrity.py
@@ -0,0 +1,305 @@
+"""Fault-inject production buffered-file I/O to protect RiptOPL configuration saves.
+
+Uses the real openFileBuffer/writeFileBuffer/closeFileBuffer function bodies (not a
+reimplementation). The mocked filesystem applies O_TRUNC immediately on open, just
+like the device drivers do. No PS2 environment is needed to cover these invariants.
+"""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+util = (ROOT / "src/util.c").read_text(encoding="utf-8")
+util_header = (ROOT / "include/util.h").read_text(encoding="utf-8")
+config = (ROOT / "src/config.c").read_text(encoding="utf-8")
+
+
+def function(source, signature):
+    start = source.index(signature)
+    end = source.index("\n}\n", start) + 2
+    return source[start:end]
+
+
+def file_buffer_type(header):
+    match = re.search(r"typedef struct\s*\{\s*int fd;.*?\}\s*file_buffer_t;", header, re.S)
+    assert match, "file_buffer_t production definition not found"
+    return match.group(0)
+
+
+# Keep the existing memory-card single-open rule and failure recovery unmodified.
+save = function(config, "int configWrite(config_set_t *configSet)")
+assert "singleOpenDevice ? -1 : openFile" in save, "MC single-open policy changed"
+assert "if (curLen < originalLen)" in save, "legacy recovery unexpectedly changed"
+assert "memcmp(chunk, original + at, count)" not in save, "extra readback unexpectedly reintroduced"
+assert 'if (!singleOpenDevice && strncmp(configSet->filename, "pfs", 3) != 0 &&' in save, "MC/PFS should not allocate a verification snapshot they never read"
+
+HARNESS = r"""
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define O_RDONLY 0
+#define O_WRONLY 1
+#define O_CREAT 2
+#define O_TRUNC 4
+#define SEEK_SET 0
+#define SEEK_END 2
+
+@STRUCT@
+
+static char disk[256];
+static int length, alloc_calls, alloc_failure, opens, closes, writes;
+static int fail_open, fail_write, fail_close, fail_seek;
+
+static void reset(void)
+{
+    memset(disk, 0, sizeof(disk));
+    memcpy(disk, "OLD", 3);
+    length = 3;
+    alloc_calls = alloc_failure = opens = closes = writes = 0;
+    fail_open = fail_write = fail_close = fail_seek = 0;
+    errno = 0;
+}
+
+static int old_unchanged(void)
+{
+    return length == 3 && memcmp(disk, "OLD", 3) == 0;
+}
+
+static void *limited_malloc(size_t size)
+{
+    alloc_calls++;
+    if (alloc_calls == alloc_failure)
+        return NULL;
+    return malloc(size);
+}
+
+static int fake_open(char *path, int flags)
+{
+    (void)path;
+    opens++;
+    if (fail_open) {
+        errno = ENXIO;
+        return -1;
+    }
+    if (flags & O_TRUNC)
+        length = 0;
+    return 3;
+}
+
+static int fake_read(int fd, void *buf, unsigned int size)
+{
+    (void)fd;
+    if (size > (unsigned int)length)
+        size = (unsigned int)length;
+    memcpy(buf, disk, size);
+    return (int)size;
+}
+
+static int fake_getFileSize(int fd)
+{
+    (void)fd;
+    if (fail_seek) {
+        errno = ENXIO;
+        return -1;
+    }
+    return length;
+}
+
+static void *fake_memalign(size_t alignment, size_t size)
+{
+    (void)alignment;
+    return malloc(size);
+}
+
+static int fake_lseek(int fd, int offset, int whence)
+{
+    (void)fd;
+    (void)offset;
+    (void)whence;
+    return 0;
+}
+
+static int fake_write(int fd, const void *buf, unsigned int size)
+{
+    (void)fd;
+    writes++;
+    if (fail_write == 1) {
+        errno = ENXIO;
+        return -1;
+    }
+    if (fail_write == 2 && size > 0)
+        size--;
+    assert(length + (int)size < (int)sizeof(disk));
+    memcpy(disk + length, buf, size);
+    length += (int)size;
+    return (int)size;
+}
+
+static int fake_close(int fd)
+{
+    (void)fd;
+    closes++;
+    if (fail_close) {
+        errno = ENXIO;
+        return -1;
+    }
+    return 0;
+}
+
+#define LOG(...) ((void)0)
+#define getFileSize fake_getFileSize
+#define memalign fake_memalign
+#define malloc limited_malloc
+#define openFile fake_open
+#define read fake_read
+#define lseek fake_lseek
+#define write fake_write
+#define close fake_close
+@FUNCTIONS@
+#undef close
+#undef write
+#undef lseek
+#undef read
+#undef openFile
+#undef malloc
+#undef memalign
+#undef getFileSize
+#undef LOG
+
+int main(void)
+{
+    file_buffer_t *b;
+    void *contents;
+    int size;
+
+    reset();
+    alloc_failure = 1;
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b == NULL && errno == ENOMEM && opens == 0 && old_unchanged());
+
+    reset();
+    alloc_failure = 2;
+    b = openFileBuffer("mc0:/OPL/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b == NULL && errno == ENOMEM && opens == 0 && old_unchanged());
+
+    reset();
+    fail_open = 1;
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b == NULL && errno == ENXIO && opens == 1 && old_unchanged());
+
+    // Reads and non-truncating opens must fail fast without allocating
+    // when the file cannot be opened (the historical read-path behavior).
+    reset();
+    fail_open = 1;
+    b = openFileBuffer("mass0:/absent.cfg", O_RDONLY, 0, 8);
+    assert(b == NULL && errno == ENXIO && opens == 1 && alloc_calls == 0);
+
+    reset();
+    fail_open = 1;
+    b = openFileBuffer("mass0:/absent.cfg", O_WRONLY | O_CREAT, 0, 8);
+    assert(b == NULL && errno == ENXIO && opens == 1 && alloc_calls == 0);
+
+    reset();
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b && length == 0 && opens == 1);
+    writeFileBuffer(b, "NEW", 3);
+    assert(closeFileBuffer(b) == 0);
+    assert(length == 3 && !memcmp(disk, "NEW", 3));
+
+    reset();
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b);
+    fail_write = 1;
+    writeFileBuffer(b, "NEW", 3);
+    assert(closeFileBuffer(b) == -1 && errno == ENXIO);
+
+    reset();
+    b = openFileBuffer("mc0:/OPL/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b);
+    fail_write = 2;
+    writeFileBuffer(b, "NEW", 3);
+    assert(closeFileBuffer(b) == -1 && errno == EIO);
+
+    reset();
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 8);
+    assert(b);
+    writeFileBuffer(b, "NEW", 3);
+    fail_close = 1;
+    assert(closeFileBuffer(b) == -1 && errno == ENXIO);
+
+    // First buffered flush fails, second write and close succeed; don't lose
+    // the original error just because the final close changed errno.
+    reset();
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 4);
+    assert(b);
+    writeFileBuffer(b, "ABCD", 4);
+    fail_write = 1;
+    writeFileBuffer(b, "EF", 2);
+    fail_write = 0;
+    assert(closeFileBuffer(b) == -1 && errno == ENXIO);
+
+    // Also cover a short POSITIVE write during the intermediate flush.
+    reset();
+    b = openFileBuffer("mass0:/settings.cfg", O_WRONLY | O_CREAT | O_TRUNC, 0, 4);
+    assert(b);
+    writeFileBuffer(b, "ABCD", 4);
+    fail_write = 2;
+    writeFileBuffer(b, "EF", 2);
+    fail_write = 0;
+    assert(closeFileBuffer(b) == -1 && errno == EIO);
+
+    // Real readFile used by custom font loading: failed filesize must never
+    // turn -1 into a huge unsigned allocation, and every opened fd is closed.
+    reset();
+    fail_seek = 1;
+    size = -1;
+    contents = readFile("mass0:/font.ttf", -1, &size);
+    assert(contents == NULL && size == 0 && errno == ENXIO &&
+           opens == 1 && closes == 1 && alloc_calls == 0);
+
+    reset();
+    alloc_failure = 1;
+    size = -1;
+    contents = readFile("mc0:/font.ttf", -1, &size);
+    assert(contents == NULL && size == 0 && errno == ENOMEM &&
+           opens == 1 && closes == 1);
+
+    reset();
+    size = -1;
+    contents = readFile("mass0:/font.ttf", -1, &size);
+    assert(contents != NULL && size == 3 && memcmp(contents, "OLD", 3) == 0);
+    assert(opens == 1 && closes == 1);
+    free(contents);
+
+    reset();
+    fail_open = 1;
+    size = -1;
+    contents = readFile("mass0:/missing.ttf", -1, &size);
+    assert(contents == NULL && opens == 1 && closes == 0 && alloc_calls == 0);
+
+    puts("PASS: config saves preserve files and errno; failed file reads never leak descriptors");
+    return 0;
+}
+"""
+
+c_code = HARNESS.replace("@STRUCT@", file_buffer_type(util_header))
+c_code = c_code.replace("@FUNCTIONS@", "\n\n".join([
+    function(util, "file_buffer_t *openFileBuffer(char *fpath, int mode, short allocResult, unsigned int size)"),
+    function(util, "void writeFileBuffer(file_buffer_t *fileBuffer, char *inBuf, int size)"),
+    function(util, "int closeFileBuffer(file_buffer_t *fileBuffer)"),
+    function(util, "void *readFile(char *path, int align, int *size)"),
+]))
+
+with tempfile.TemporaryDirectory() as folder:
+    source = Path(folder) / "config_save_integrity.c"
+    binary = Path(folder) / ("config_save_integrity.exe" if os.name == "nt" else "config_save_integrity")
+    source.write_text(c_code, encoding="utf-8")
+    cc = os.environ.get("CC", "gcc")
+    subprocess.run([cc, "-std=gnu99", "-Wall", "-Wextra", "-Werror",
+                    str(source), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True, timeout=10)
+
diff --git a/.github/scripts/test_custom_font_load.py b/.github/scripts/test_custom_font_load.py
new file mode 100644
index 0000000..ecab8ca
--- /dev/null
+++ b/.github/scripts/test_custom_font_load.py
@@ -0,0 +1,92 @@
+"""Regression test for #868: custom theme fonts must not pass a garbage expected size to readFile().
+
+The September font-locking refactor split file IO into fntReadData(). Before that change, custom font
+loads initialized bufferSize to -1 before readFile(); after the split the local became uninitialized.
+readFile() interprets any positive incoming size as an exact expected file size, so a random positive
+stack value makes a valid TTF fail to load and the theme silently falls back to FNT_DEFAULT.
+
+Compile the real fntReadData() against a tiny stub and pin both contracts:
+- file-backed font reads enter readFile() with size == -1 and accept the size readFile returns;
+- the built-in font path still uses size_poeveticanew_raw and does not claim ownership.
+"""
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "src/fntsys.c").read_text(encoding="utf-8").replace("\r\n", "\n")
+
+match = re.search(r"^static void \*fntReadData\(.*?^}\n", source, re.M | re.S)
