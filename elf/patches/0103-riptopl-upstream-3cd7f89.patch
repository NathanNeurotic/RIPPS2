diff --git a/modules/network/udpfs_shared/tests/test_ministack_announce.c b/modules/network/udpfs_shared/tests/test_ministack_announce.c
new file mode 100644
index 0000000..f8f1af9
--- /dev/null
+++ b/modules/network/udpfs_shared/tests/test_ministack_announce.c
@@ -0,0 +1,71 @@
+/*
+ * Host test for udpfs_ministack's discovery ARP announcement (ministack_udp.c).
+ *
+ * A UDPRDMA DISCOVERY is a broadcast from a bound socket; the server answers it with a
+ * unicast INFORM, so a gratuitous ARP must go out first. udptty's console broadcasts
+ * (unbound, port 0) and ordinary unicast traffic must not announce.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "../../udpfs_ministack/src/ministack_udp.c"
+
+static int announces, transmits;
+
+void arp_announce(void)
+{
+    announces++;
+}
+
+void ip_packet_init(ip_packet_t *pkt, uint32_t ip_dest)
+{
+    pkt->ip.addr_dst.addr[0] = (ip_dest >> 24) & 0xff;
+    pkt->ip.addr_dst.addr[1] = (ip_dest >> 16) & 0xff;
+    pkt->ip.addr_dst.addr[2] = (ip_dest >> 8) & 0xff;
+    pkt->ip.addr_dst.addr[3] = ip_dest & 0xff;
+}
+
+int ip_packet_send_ll(ip_packet_t *pkt, uint16_t pktdatasize, const void *data, uint16_t datasize)
+{
+    (void)pkt;
+    (void)pktdatasize;
+    (void)data;
+    (void)datasize;
+    transmits++;
+    return 0;
+}
+
+static int failures;
+
+static void check(const char *what, int ok)
+{
+    if (!ok) {
+        fprintf(stderr, "FAIL: %s\n", what);
+        failures++;
+    }
+}
+
+int main(void)
+{
+    static udp_packet_t pkt;
+    udp_socket_t *bound = udp_bind(0xF5F6, NULL, NULL);
+    udp_socket_t tty = {0, NULL, NULL};
+
+    udp_packet_init(&pkt, IP_ADDR(255, 255, 255, 255), 0xF5F6);
+    udp_packet_send(bound, &pkt, 6);
+    check("discovery broadcast announces once", announces == 1 && transmits == 1);
+
+    udp_packet_send(&tty, &pkt, 6);
+    check("udptty broadcast does not announce", announces == 1 && transmits == 2);
+
+    udp_packet_init(&pkt, IP_ADDR(192, 168, 1, 2), 57996);
+    udp_packet_send(bound, &pkt, 6);
+    check("unicast data does not announce", announces == 1 && transmits == 3);
+
+    if (failures) {
+        fprintf(stderr, "%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("ministack announce: all checks passed\n");
+    return 0;
+}
diff --git a/modules/network/udpfs_shared/tests/test_ministack_conflict.c b/modules/network/udpfs_shared/tests/test_ministack_conflict.c
new file mode 100644
index 0000000..4fe0067
--- /dev/null
+++ b/modules/network/udpfs_shared/tests/test_ministack_conflict.c
@@ -0,0 +1,112 @@
+/*
+ * Host test for udpfs_ministack's IP-conflict detection (ministack_arp.c).
+ *
+ * Another device answering ARP for the PS2's own IP -- typically the reply to the gratuitous ARP sent
+ * before each UDPRDMA DISCOVERY -- must be recorded with its MAC so the loader can tell the user.
+ * Our own frames and other addresses must not count, and our own IP is never cached as a neighbour.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "../../udpfs_ministack/src/ministack_arp.c"
+
+static const uint8_t our_mac[6] = {0x00, 0x04, 0x1f, 0x11, 0x22, 0x33};
+static const uint8_t other_mac[6] = {0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff};
+static const uint8_t server_mac[6] = {0x10, 0x20, 0x30, 0x40, 0x50, 0x60};
+#define OUR_IP    IP_ADDR(192, 168, 1, 10)
+#define SERVER_IP IP_ADDR(192, 168, 1, 2)
+
+static int transmits;
+
+int SMAPGetMACAddress(uint8_t *buffer)
+{
+    memcpy(buffer, our_mac, 6);
+    return 0;
+}
+int eth_packet_send_ll(eth_packet_t *pkt, uint16_t pktdatasize, const void *data, uint16_t datasize)
+{
+    (void)pkt;
+    (void)pktdatasize;
+    (void)data;
+    (void)datasize;
+    transmits++;
+    return 0;
+}
+uint32_t ms_ip_get_ip(void)
+{
+    return OUR_IP;
+}
+int DelayThread(int usec)
+{
+    (void)usec;
+    return 0;
+}
+
+static void deliver(int oper, const uint8_t mac[6], uint32_t sender, uint32_t target)
+{
+    static arp_packet_t pkt;
+
+    memset(&pkt, 0, sizeof(pkt));
+    pkt.arp.oper = htons(oper);
+    memcpy(pkt.arp.sender_mac, mac, 6);
+    pkt.arp.sender_ip = htonl(sender);
+    pkt.arp.target_ip = htonl(target);
+    handle_rx_arp((const uint8_t *)&pkt);
+}
+
+static int failures;
+
+static void check(const char *what, int ok)
+{
+    if (!ok) {
+        fprintf(stderr, "FAIL: %s\n", what);
+        failures++;
+    }
+}
+
+int main(void)
+{
+    uint8_t mac[6], seen[6];
+
+    /* Ordinary traffic: the server asks for us. We answer and learn it; no conflict. */
+    deliver(1, server_mac, SERVER_IP, OUR_IP);
+    check("a request for our IP is answered", transmits == 1);
+    check("the asking server is learned", arp_lookup(SERVER_IP, mac) == 0 && !memcmp(mac, server_mac, 6));
+    check("ordinary traffic is not a conflict", arp_ip_conflict(NULL) == 0);
+
+    /* Our own address from our own MAC (a looped-back announce) is not a conflict. */
+    deliver(1, our_mac, OUR_IP, OUR_IP);
+    check("our own announce is not a conflict", arp_ip_conflict(NULL) == 0);
+
+    /* Another device replies for our IP: record it and its MAC; never cache our own IP. */
+    deliver(2, other_mac, OUR_IP, OUR_IP);
+    check("another device claiming our IP is a conflict", arp_ip_conflict(seen) == 1);
+    check("the conflicting MAC is reported", !memcmp(seen, other_mac, 6));
+    check("our own IP is never cached as a neighbour", arp_lookup(OUR_IP, mac) != 0);
+    check("a NULL MAC buffer is allowed", arp_ip_conflict(NULL) == 1);
+
+    /* A full table: LAN chatter does not displace entries, but a host talking to US does (the
+       RA companion answering the PS2's ARP request, or asking for the PS2 itself). */
+    {
+        static const uint8_t chatter_mac[6] = {0x02, 0, 0, 0, 0, 0x01};
+        static const uint8_t companion_mac[6] = {0x02, 0, 0, 0, 0, 0x77};
+        int i;
+
+        for (i = 0; i < 12; i++)
+            deliver(1, chatter_mac, IP_ADDR(192, 168, 1, 100 + i), IP_ADDR(192, 168, 1, 1));
+        check("chatter fills the table but cannot displace", arp_lookup(IP_ADDR(192, 168, 1, 111), mac) != 0);
+        deliver(2, companion_mac, IP_ADDR(192, 168, 1, 77), OUR_IP);
+        check("a reply addressed to us is learned on a full table",
+              arp_lookup(IP_ADDR(192, 168, 1, 77), mac) == 0 && !memcmp(mac, companion_mac, 6));
+        deliver(1, companion_mac, IP_ADDR(192, 168, 1, 78), OUR_IP);
+        check("a host asking for us is learned on a full table", arp_lookup(IP_ADDR(192, 168, 1, 78), mac) == 0);
+        check("the newest entries do not evict each other", arp_lookup(IP_ADDR(192, 168, 1, 77), mac) == 0);
+    }
+
+    if (failures) {
+        fprintf(stderr, "%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("ministack conflict: all checks passed\n");
+    return 0;
+}
diff --git a/modules/network/udpfs_shared/tests/test_ministack_xchg.c b/modules/network/udpfs_shared/tests/test_ministack_xchg.c
new file mode 100644
index 0000000..e9d338a
--- /dev/null
+++ b/modules/network/udpfs_shared/tests/test_ministack_xchg.c
@@ -0,0 +1,304 @@
+/*
+ * Host test for udpfs_ministack's mstack: UDP exchange device (ministack_xchg.c).
+ *
+ * The real exchange code runs against stubbed UDP and SMAP calls. A scripted "network" delivers
+ * replies through the bound port handler while the exchange polls with DelayThread, exactly as
+ * the SMAP receive context would.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "../../udpfs_ministack/src/ministack_xchg.c"
+
+/* --- stubs ------------------------------------------------------------------------------- */
+
+static int binds, bound_port;
+static udp_port_handler bound_handler;
+static udp_socket_t bound_socket;
+
+udp_socket_t *udp_bind(uint16_t port_src, udp_port_handler handler, void *handler_arg)
+{
+    binds++;
+    bound_port = port_src;
+    bound_handler = handler;
+    bound_socket.port_src = port_src;
+    bound_socket.handler = handler;
+    bound_socket.handler_arg = handler_arg;
+    return &bound_socket;
+}
+
+static uint32_t sent_ip;
+static uint16_t sent_port;
+static uint8_t sent_data[512];
+static int sent_len, sends;
+
+void udp_packet_init(udp_packet_t *pkt, uint32_t ip_dst, uint16_t port_dst)
+{
+    (void)pkt;
+    sent_ip = ip_dst;
+    sent_port = port_dst;
+}
+
+/* Models the real transmit path: ip_packet_send_ll hands smap_transmit the 42-byte ETH+IP+UDP
+   header plus pktdatasize bytes as "header", then data. SMAP's CopyToFIFO writes whole 32-bit
+   words, so the header is rounded up to a word in the TX FIFO while the frame length stays exact:
+   whatever the rounding pulled in goes on the wire, and the frame's tail is cut by as much. */
+int udp_packet_send_ll(udp_socket_t *socket, udp_packet_t *pkt, uint16_t pktdatasize, const void *data, uint16_t datasize)
+{
+    static uint8_t fifo[2048];
+    unsigned int header = 42 + pktdatasize, rounded = (header + 3) & ~3u, wire = header + datasize;
+
+    assert(socket == &bound_socket);
+    memcpy(fifo, pkt, rounded);
+    if (datasize)
+        memcpy(fifo + rounded, data, datasize);
+    sent_len = (int)wire - 42;
+    memcpy(sent_data, fifo + 42, sent_len);
+    sends++;
+    return 0;
+}
+
+/* ARP: 192.168.1.99 never answers. Broadcasts must not be resolved at all. */
+static int arp_calls;
+int arp_resolve(uint32_t ip, uint8_t mac[6])
+{
+    assert(ip != 0xFFFFFFFF);
+    arp_calls++;
+    memset(mac, 0x11, 6);
+    return ip == IP_ADDR(192, 168, 1, 99) ? -1 : 0;
+}
+
+/* The frame currently "in the FIFO", as the SMAP RX path would see it. */
+static uint8_t frame[2048];
+
+void smap_fifo_read(uint16_t offset, void *dst, uint32_t bytes)
+{
+    assert(offset % 4 == 0);
+    assert(bytes % 4 == 0);
+    assert(bytes <= sizeof(xchg_rx));
+    memcpy(dst, frame + offset, bytes);
+}
+
+/* Scripted replies: delivered on the Nth DelayThread call of the current exchange. */
+typedef struct
+{
+    int at;
+    uint8_t src[4];
+    const char *text;
+    int udp_payload; /* 0 = strlen(text) */
+    int ip_payload;  /* 0 = consistent with the UDP length */
+} script_t;
+
+static script_t script[4];
+static int script_count, delays;
+
+static int deliver(const script_t *s)
+{
+    udp_packet_t *pkt = (udp_packet_t *)frame;
+    int payload = s->udp_payload ? s->udp_payload : (int)strlen(s->text);
+
+    memset(frame, 0, sizeof(frame));
+    memcpy(pkt->ip.addr_src.addr, s->src, 4);
+    pkt->udp.port_dst = htons(MSTACK_XCHG_PORT);
+    pkt->udp.len = htons((uint16_t)(sizeof(udp_header_t) + payload));
+    pkt->ip.len = htons((uint16_t)(sizeof(ip_header_t) + (s->ip_payload ? s->ip_payload : (int)sizeof(udp_header_t) + payload)));
+    if (s->udp_payload) {
+        for (int i = 0; i < payload && 42 + i < (int)sizeof(frame); i++)
+            frame[42 + i] = (uint8_t)('a' + i % 26);
+    } else
+        memcpy(frame + 42, s->text, payload);
+    return bound_handler(&bound_socket, NULL, frame, sizeof(udp_packet_t));
+}
+
+int DelayThread(int usec)
+{
+    assert(usec == 1000);
+    delays++;
+    for (int i = 0; i < script_count; i++)
+        if (script[i].at == delays)
+            deliver(&script[i]);
+    return 0;
+}
+
+uint32_t ms_ip_get_ip(void)
+{
+    return IP_ADDR(192, 168, 1, 10);
+}
+
+int AddDrv(iomanX_iop_device_t *device)
+{
+    (void)device;
+    return 0;
+}
+
+int DelDrv(const char *name)
+{
+    (void)name;
+    return 0;
+}
+
+/* --- helpers ------------------------------------------------------------------------------ */
+
+static uint32_t nip(int a, int b, int c, int d) /* network-order address as sin_addr.s_addr */
+{
+    uint32_t v;
+    uint8_t bytes[4] = {(uint8_t)a, (uint8_t)b, (uint8_t)c, (uint8_t)d};
+    memcpy(&v, bytes, 4);
+    return v;
+}
+
+static struct
+{
+    mstack_xchg_reply_t reply;
+    uint8_t guard[64];
+} out;
+
+static int exchange(uint32_t dst, uint16_t port, uint16_t timeout, const char *text)
+{
+    static mstack_xchg_req_t req;
+    memset(&req, 0, sizeof(req));
+    req.dst_ip = dst;
+    req.dst_port = port;
+    req.timeout_ms = timeout;
+    req.len = (uint16_t)strlen(text);
+    memcpy(req.data, text, req.len);
+    delays = 0;
+    memset(&out, 0x5A, sizeof(out));
+    return xchg_devctl(NULL, "mstack:", MSTACK_DEVCTL_UDP_XCHG, &req, MSTACK_XCHG_REQ_HDR + req.len, &out.reply, sizeof(out.reply));
+}
+
+static void reply_at(int idx, int at, int a, int b, int c, int d, const char *text, int payload)
+{
+    script[idx].at = at;
+    script[idx].src[0] = (uint8_t)a;
+    script[idx].src[1] = (uint8_t)b;
+    script[idx].src[2] = (uint8_t)c;
+    script[idx].src[3] = (uint8_t)d;
+    script[idx].text = text;
+    script[idx].udp_payload = payload;
+    script[idx].ip_payload = 0;
+}
+
+int main(void)
+{
+    int rc;
+
+    /* version_probe */
+    assert(xchg_devctl(NULL, "mstack:", MSTACK_DEVCTL_VERSION, NULL, 0, NULL, 0) == 1);
+
+    /* unicast_roundtrip */
+    script_count = 1;
+    reply_at(0, 3, 192, 168, 1, 20, "RAA1 OK 5", 0);
+    rc = exchange(nip(192, 168, 1, 20), 18194, 250, "RAQ1 abc 1.2.3.4 18196");
+    assert(rc == 9);
+    assert(out.reply.len == 9 && memcmp(out.reply.data, "RAA1 OK 5", 9) == 0);
+    assert(out.reply.src_ip == nip(192, 168, 1, 20));
+    assert(sent_len == 22 && memcmp(sent_data, "RAQ1 abc 1.2.3.4 18196", 22) == 0);
+    assert(sent_ip == IP_ADDR(192, 168, 1, 20) && sent_port == 18194);
+
+    /* odd lengths go on the wire exactly */
+    for (int n = 1; n <= 8; n++) {
+        static const char text[] = "RAP1 192.168.1.10 18196";
+        char req[16];
+        memcpy(req, text, n);
+        req[n] = 0;
+        script_count = 0;
+        exchange(nip(192, 168, 1, 20), 18194, 1, req);
+        assert(sent_len == n && memcmp(sent_data, req, n) == 0);
+    }
+
+    /* bind_once (with the roundtrip above and two more below) */
+    assert(binds == 1 && bound_port == 18196);
+
+    /* broadcast_any_source */
+    script_count = 1;
+    reply_at(0, 2, 192, 168, 1, 77, "RAO1 OK", 0);
+    rc = exchange(0xFFFFFFFF, 18194, 250, "RAP1 192.168.1.10 18196");
+    assert(rc == 7 && out.reply.src_ip == nip(192, 168, 1, 77));
+    assert(sent_ip == 0xFFFFFFFF);
+
+    /* stray_source_dropped */
+    script_count = 2;
+    reply_at(0, 2, 192, 168, 1, 21, "STRANGER", 0);
+    reply_at(1, 4, 192, 168, 1, 20, "RAA1 NO", 0);
+    rc = exchange(nip(192, 168, 1, 20), 18194, 250, "RAQ1 x");
+    assert(rc == 7 && memcmp(out.reply.data, "RAA1 NO", 7) == 0);
+    assert(out.reply.src_ip == nip(192, 168, 1, 20));
+    assert(binds == 1);
+
+    /* timeout */
+    script_count = 0;
+    rc = exchange(nip(192, 168, 1, 20), 18194, 50, "RAQ1 x");
+    assert(rc == -ETIMEDOUT);
+    assert(delays <= 52);
+
+    /* late_reply_not_reused: a reply with no exchange armed is dropped ... */
+    script[0].at = 0;
+    reply_at(0, 0, 192, 168, 1, 20, "LATE", 0);
+    assert(deliver(&script[0]) == -1);
+    /* ... and does not satisfy the next exchange. */
+    script_count = 0;
+    rc = exchange(nip(192, 168, 1, 20), 18194, 20, "RAQ1 x");
+    assert(rc == -ETIMEDOUT);
+
+    /* oversize_truncated */
+    script_count = 1;
+    reply_at(0, 1, 192, 168, 1, 20, "", 1400);
+    rc = exchange(nip(192, 168, 1, 20), 18194, 250, "RAG1 x");
+    assert(rc == MSTACK_XCHG_REPLY_MAX && out.reply.len == MSTACK_XCHG_REPLY_MAX);
+    assert(out.reply.data[0] == 'a' && out.reply.data[MSTACK_XCHG_REPLY_MAX - 1] == (uint8_t)('a' + (MSTACK_XCHG_REPLY_MAX - 1) % 26));
+    for (unsigned i = 0; i < sizeof(out.guard); i++)
+        assert(out.guard[i] == 0x5A);
+
+    /* unreachable_unicast: ARP fails -> no frame to a stale or zero MAC, no wait */
+    {
+        int before = sends;
+        script_count = 0;
+        rc = exchange(nip(192, 168, 1, 99), 18194, 250, "RAQ1 x");
+        assert(rc == -EHOSTUNREACH && sends == before && delays == 0);
+    }
+
+    /* udp_length_beyond_ip: a datagram claiming more than its IP packet carries is dropped
+       instead of reading past the frame in the FIFO */
+    script_count = 1;
+    reply_at(0, 1, 192, 168, 1, 20, "", 1000);
+    script[0].ip_payload = 8 + 10;
+    rc = exchange(nip(192, 168, 1, 20), 18194, 20, "RAQ1 x");
+    assert(rc == -ETIMEDOUT);
+
+    /* get_ip: the address the ministack was really loaded with, network byte order */
+    {
+        uint8_t ip[8];
+        memset(ip, 0, sizeof(ip));
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_GET_IP, NULL, 0, ip, 4) == 4);
+        assert(ip[0] == 192 && ip[1] == 168 && ip[2] == 1 && ip[3] == 10);
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_GET_IP, NULL, 0, ip, 3) == -EINVAL);
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_GET_IP, NULL, 0, NULL, 4) == -EINVAL);
+    }
+
+    /* bad_args */
+    {
+        static mstack_xchg_req_t req;
+        static mstack_xchg_reply_t reply;
+        memset(&req, 0, sizeof(req));
+        req.dst_ip = nip(192, 168, 1, 20);
+        req.dst_port = 18194;
+        req.timeout_ms = 10;
+        req.len = 0;
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_UDP_XCHG, &req, sizeof(req), &reply, sizeof(reply)) == -EINVAL);
+        req.len = MSTACK_XCHG_REQ_MAX + 1;
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_UDP_XCHG, &req, sizeof(req), &reply, sizeof(reply)) == -EINVAL);
+        req.len = 4;
+        req.dst_port = 0;
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_UDP_XCHG, &req, sizeof(req), &reply, sizeof(reply)) == -EINVAL);
+        req.dst_port = 18194;
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_UDP_XCHG, &req, sizeof(req), &reply, sizeof(reply) - 1) == -EINVAL);
+        assert(xchg_devctl(NULL, "", MSTACK_DEVCTL_UDP_XCHG, &req, MSTACK_XCHG_REQ_HDR + 3, &reply, sizeof(reply)) == -EINVAL);
+        assert(xchg_devctl(NULL, "", 0x1234, &req, sizeof(req), &reply, sizeof(reply)) == -EINVAL);
+    }
+
+    assert(binds == 1);
+    printf("PASS: mstack exchange\n");
+    return 0;
+}
diff --git a/modules/network/udpfs_shared/tests/test_udprdma_session.c b/modules/network/udpfs_shared/tests/test_udprdma_session.c
new file mode 100644
index 0000000..052a28d
--- /dev/null
+++ b/modules/network/udpfs_shared/tests/test_udprdma_session.c
@@ -0,0 +1,314 @@
+/*
+ * Host test for the shared UDPRDMA transport (udpfs_shared/src/udprdma.c).
+ *
+ * The real transport is compiled against stubbed IOP event flags, alarms and a stubbed
+ * ministack. A script feeds it what the network and the alarm would deliver, and every
+ * packet it transmits is recorded. Checks:
+ *   - a stale ACK does not cost a retry: the request is sent once and the covering ACK
+ *     that follows completes it;
+ *   - a reconnect after a dead session starts again from sequence 0 (TX and RX), which
+ *     is what a server that reset its session on DISCOVERY expects.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../src/udprdma.c"
+
+enum {
+    EV_TIMEOUT,
+    EV_INFORM,
+    EV_ACK,
+    EV_DATA_FIN,
+};
+
+typedef struct
+{
+    int kind;
+    int arg;
+} script_ev_t;
+
+static script_ev_t script[32];
+static int script_len, script_pos;
+
+static uint32_t flags;
+static unsigned int (*alarm_cb)(void *);
+static void *alarm_arg;
+
+static udp_socket_t bound_socket;
+static uint8_t frame[64];
+
+typedef struct
+{
+    int type;
+    int seq;
+    int seq_nr_ack;
+    int payload;
+} sent_t;
+
+static sent_t sent[64];
+static int sent_len;
+
+static int failures;
+
+static void check(const char *what, int ok)
+{
+    if (!ok) {
+        fprintf(stderr, "FAIL: %s\n", what);
+        failures++;
+    }
+}
+
+static void run_script(int n, const script_ev_t *evs)
+{
+    memcpy(script, evs, n * sizeof(*evs));
+    script_len = n;
+    script_pos = 0;
+}
+
+/* --- network injection --- */
+
+static void deliver(void)
+{
+    bound_socket.handler(&bound_socket, bound_socket.handler_arg, frame, 44);
+}
+
+static void inject_inform(void)
+{
+    udprdma_pkt_disc_t *p = (udprdma_pkt_disc_t *)frame;
+
+    memset(frame, 0, sizeof(frame));
+    p->ip.addr_src.addr[0] = 192;
+    p->ip.addr_src.addr[1] = 168;
+    p->ip.addr_src.addr[2] = 1;
+    p->ip.addr_src.addr[3] = 2;
+    p->udp.port_src = htons(57996); /* PS2-Servers' separate data port */
+    p->hdr.packet_type = UDPRDMA_PT_INFORM;
+    p->hdr.seq_nr = 1;
+    p->disc.service_id = UDPRDMA_SVC_UDPFS;
+    deliver();
+}
+
+static void inject_data(int seq, int ack, int flags_, int bytes)
+{
+    udprdma_pkt_data_t *p = (udprdma_pkt_data_t *)frame;
+
+    memset(frame, 0, sizeof(frame));
+    p->hdr.packet_type = UDPRDMA_PT_DATA;
+    p->hdr.seq_nr = seq;
+    p->data.seq_nr_ack = ack;
+    p->data.flags = flags_;
+    p->data.data_byte_count = bytes;
+    deliver();
+}
+
+static void step(void)
+{
+    script_ev_t ev;
+
+    if (script_pos >= script_len) {
+        fprintf(stderr, "FAIL: transport waited past the end of the script\n");
+        exit(1);
+    }
+    ev = script[script_pos++];
+    switch (ev.kind) {
+        case EV_TIMEOUT:
+            if (alarm_cb == NULL) {
+                fprintf(stderr, "FAIL: timeout scripted with no alarm armed\n");
+                exit(1);
+            }
+            alarm_cb(alarm_arg);
+            break;
+        case EV_INFORM:
+            inject_inform();
+            break;
+        case EV_ACK:
+            inject_data(0, ev.arg, UDPRDMA_DF_ACK, 0);
+            break;
+        case EV_DATA_FIN:
+            inject_data(ev.arg, 0, UDPRDMA_DF_FIN, 4);
+            break;
+    }
+}
+
+/* --- IOP stubs --- */
+
+int CreateEventFlag(iop_event_t *event)
+{
+    flags = event->bits;
+    return 1;
+}
+int DeleteEventFlag(int ef)
+{
+    (void)ef;
+    return 0;
+}
+int SetEventFlag(int ef, uint32_t bits)
+{
+    (void)ef;
+    flags |= bits;
+    return 0;
+}
+int iSetEventFlag(int ef, uint32_t bits)
+{
+    return SetEventFlag(ef, bits);
+}
+int ClearEventFlag(int ef, uint32_t bits)
+{
+    (void)ef;
+    flags &= bits;
+    return 0;
+}
+int WaitEventFlag(int ef, uint32_t bits, int mode, uint32_t *resbits)
+{
+    (void)ef;
+    while (!(flags & bits))
+        step();
+    *resbits = flags;
+    if (mode & WEF_CLEAR)
+        flags = 0;
+    return 0;
+}
+void USec2SysClock(uint32_t usec, iop_sys_clock_t *clock)
+{
+    clock->lo = usec;
+    clock->hi = 0;
+}
+int SetAlarm(iop_sys_clock_t *clock, unsigned int (*cb)(void *), void *arg)
+{
+    (void)clock;
+    alarm_cb = cb;
+    alarm_arg = arg;
+    return 0;
+}
+int CancelAlarm(unsigned int (*cb)(void *), void *arg)
+{
+    (void)cb;
+    (void)arg;
+    alarm_cb = NULL;
+    return 0;
+}
+int DelayThread(int usec)
+{
+    (void)usec;
+    return 0;
+}
+
+void smap_fifo_read(uint16_t offset, void *dst, uint32_t bytes)
+{
+    memcpy(dst, frame + offset, bytes);
+}
+
+udp_socket_t *udp_bind(uint16_t port_src, udp_port_handler handler, void *handler_arg)
+{
+    bound_socket.port_src = port_src;
+    bound_socket.handler = handler;
+    bound_socket.handler_arg = handler_arg;
+    return &bound_socket;
+}
+void udp_packet_init(udp_packet_t *pkt, uint32_t ip_dst, uint16_t port_dst)
+{
+    (void)ip_dst;
+    pkt->udp.port_dst = htons(port_dst);
+}
+int udp_packet_send_ll(udp_socket_t *socket, udp_packet_t *pkt, uint16_t pktdatasize, const void *data, uint16_t datasize)
+{
+    udprdma_pkt_data_t *p = (udprdma_pkt_data_t *)pkt;
+
+    (void)socket;
+    (void)pktdatasize;
+    (void)data;
+    if (sent_len < (int)(sizeof(sent) / sizeof(sent[0]))) {
+        sent[sent_len].type = p->hdr.packet_type;
+        sent[sent_len].seq = p->hdr.seq_nr;
+        sent[sent_len].seq_nr_ack = p->hdr.packet_type == UDPRDMA_PT_DATA ? (int)p->data.seq_nr_ack : -1;
+        sent[sent_len].payload = datasize;
+        sent_len++;
+    }
+    return 0;
+}
+
+static int count_requests(int from)
+{
+    int i, n = 0;
+    for (i = from; i < sent_len; i++)
+        if (sent[i].type == UDPRDMA_PT_DATA && sent[i].payload > 0)
+            n++;
+    return n;
+}
+
+static int first_request(int from)
+{
+    int i;
+    for (i = from; i < sent_len; i++)
+        if (sent[i].type == UDPRDMA_PT_DATA && sent[i].payload > 0)
+            return i;
+    return -1;
+}
+
+int main(void)
+{
+    static const script_ev_t connect[] = {{EV_INFORM, 0}};
+    static const script_ev_t stale_then_ack1[] = {{EV_ACK, 0}, {EV_ACK, 1}};
+    static const script_ev_t reply_seq0[] = {{EV_DATA_FIN, 0}};
+    static const script_ev_t ack2[] = {{EV_ACK, 2}};
+    static const script_ev_t dead[] = {{EV_TIMEOUT, 0}, {EV_TIMEOUT, 0}, {EV_TIMEOUT, 0}, {EV_TIMEOUT, 0}};
+    static const script_ev_t ack0[] = {{EV_ACK, 0}};
+    static const script_ev_t timeout_then_ack0[] = {{EV_TIMEOUT, 0}, {EV_ACK, 0}};
+    uint8_t req[16] = {0}, reply[16];
+    udprdma_socket_t *s;
+    int mark, idx;
+
+    s = udprdma_create(0, UDPRDMA_SVC_UDPFS);
+    check("socket created", s != NULL);
+
+    /* A fresh socket must not treat the first request as already acknowledged. */
+    run_script(1, connect);
+    check("first discovery connects", udprdma_discover(s, 2000) == UDPRDMA_OK);
+    mark = sent_len;
+    run_script(2, timeout_then_ack0);
+    check("first request survives one timeout", udprdma_send(s, req, sizeof(req)) == UDPRDMA_OK);
+    check("unacknowledged first request is resent once", count_requests(mark) == 2);
+
+    /* Stale ACK: keep waiting for the covering ACK, do not resend. */
+    mark = sent_len;
+    run_script(2, stale_then_ack1); /* ACK 0 is stale for request 1 */
+    check("request with a stale ACK first completes", udprdma_send(s, req, sizeof(req)) == UDPRDMA_OK);
+    check("a stale ACK does not cost a retry", count_requests(mark) == 1);
+    check("stale ACK leaves the script fully consumed", script_pos == script_len);
+
+    /* Receive one reply so RX state is non-zero too. */
+    udprdma_set_rx_buffer(s, reply, sizeof(reply));
+    run_script(1, reply_seq0);
+    check("reply received", udprdma_recv(s, reply, sizeof(reply), 1000) == 4);
+
+    run_script(1, ack2);
+    check("second request completes", udprdma_send(s, req, sizeof(req)) == UDPRDMA_OK);
+
+    /* The session dies: four timeouts disconnect it. */
+    mark = sent_len;
+    run_script(4, dead);
+    check("dead session returns an error", udprdma_send(s, req, sizeof(req)) == UDPRDMA_ERR_NACK);
+    check("dead session sent four tries", count_requests(mark) == 4);
+    check("dead session disconnects", !udprdma_is_connected(s));
+
+    /* Reconnect: the server reset its session on DISCOVERY, so start again from zero. */
+    run_script(1, connect);
+    check("rediscovery connects", udprdma_discover(s, 2000) == UDPRDMA_OK);
+    mark = sent_len;
+    run_script(1, ack0);
+    check("first request after reconnect completes", udprdma_send(s, req, sizeof(req)) == UDPRDMA_OK);
+    idx = first_request(mark);
+    check("a request was sent after reconnect", idx >= 0);
+    if (idx >= 0) {
+        check("reconnect restarts TX at sequence 0", sent[idx].seq == 0);
+        check("reconnect restarts RX expectation at 0", sent[idx].seq_nr_ack == 0xFFF);
+    }
+
+    if (failures) {
+        fprintf(stderr, "%d check(s) failed\n", failures);
+        return 1;
+    }
+    printf("udprdma session: all checks passed\n");
+    return 0;
+}
diff --git a/modules/network/udpfs_smap/Makefile b/modules/network/udpfs_smap/Makefile
