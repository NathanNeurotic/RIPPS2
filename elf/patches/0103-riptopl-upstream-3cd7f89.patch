diff --git a/modules/pccf/pcdiag_ata.h b/modules/pccf/pcdiag_ata.h
new file mode 100644
index 0000000..7cd8c99
--- /dev/null
+++ b/modules/pccf/pcdiag_ata.h
@@ -0,0 +1,22 @@
+#ifndef PCDIAG_ATA_H
+#define PCDIAG_ATA_H
+#include "pcdiag_cf.h"
+
+#define PCDIAG_ATA_POLL_LIMIT_MS 2000U
+#define PCDIAG_ATA_READ_LIMIT    6U
+#define PCDIAG_ATA_LBA28_SECTORS 0x10000000U
+
+/* Command callback accepts only IDENTIFY (EC, lba=0) and one-sector
+   READ SECTORS (20, LBA28). There is no data-write operation. */
+typedef struct
+{
+    const pcdiag_cf_ops_t *memory;
+    int (*issue_read_command)(void *context, unsigned int command, unsigned int lba);
+} pcdiag_ata_ops_t;
+
+/* Called only after a complete qualifying CIS and an index-zero COR.
+   0: IDENTIFY and LBA0 read succeeded; 1: initial register map rejected;
+   negative: command/transfer/IDENTIFY failure. Host owner restores MMIO. */
+int pcdiag_ata_observe(const pcdiag_ata_ops_t *ops, void *context,
+                       pcdiag_cis_trace_t trace);
+#endif
diff --git a/modules/pccf/pcdiag_cf.c b/modules/pccf/pcdiag_cf.c
new file mode 100644
index 0000000..b14484d
--- /dev/null
+++ b/modules/pccf/pcdiag_cf.c
@@ -0,0 +1,72 @@
+/* PC CARD DIAG 4, 2026-10-01.
+   Observe the CF memory register map before any ATA commands are attempted.
+   Wisi's DEV9C_PCMCIA.txt v01 gives conflicting interpretations of selector
+   values 0 and 3. Treat them as candidates, not confirmed Common Memory.
+   Card registers are never written. Data ports 0, 8, 9 and 0x400..0x7ff are
+   excluded, so the diagnostic does not consume a sector/data transfer.
+   Layout: Transcend CF133 manual, memory-mapped registers table (page 46).
+   Bus width bit: PS2SDK ssbusc.h, ATYP bit 12 of the timing register. */
+#include "pcdiag_cf.h"
+
+int pcdiag_cf_probe(const pcdiag_cis_info_t *info, const pcdiag_cf_ops_t *ops,
+                    void *context, pcdiag_cis_trace_t trace)
+{
+    static const unsigned int offsets8[] = {1, 2, 3, 4, 5, 6, 7, 0x0d, 0x0e, 0x0f};
+    static const unsigned int offsets16[] = {2, 4, 6, 0x0c, 0x0e};
+    static const unsigned int spaces[] = {0, 3};
+    unsigned char config[4] = {0, 0, 0, 0}, bytes[10];
+    unsigned short words[5];
+    unsigned int sample, candidate, i, cor;
+
+    if (!pcdiag_cis_cf_candidate(info)) {
+        trace("dev9: CF PROBE SKIP: primary CIS lacks unambiguous fixed-disk / COR@0200 / memory-index-0 profile");
+        return 1;
+    }
+    /* The owner has already selected attribute space with byte-wide timing. */
+    for (i = 0; i < 4; ++i) {
+        if (info->register_mask & (1U << i))
+            config[i] = ops->read8(context, 0x200U + i * 2);
+    }
+    cor = config[0];
+    trace("dev9: CF CONFIG mask=%02x COR@0200=%02x CSR@0202=%02x PRR@0204=%02x SCR@0206=%02x; absent registers shown as 00",
+          info->register_mask, cor, (unsigned int)config[1],
+          (unsigned int)config[2], (unsigned int)config[3]);
+    if ((cor & 0x3f) != 0 || (cor & 0x80) != 0) {
+        trace("dev9: CF PROBE SKIP: COR index=%u soft_reset=%u; no COR write is performed",
+              cor & 0x3f, (cor >> 7) & 1);
+        return 1;
+    }
+
+    trace("dev9: CF PROBE BEGIN: selector candidates=0,3; widths=8,16; samples=3; no card writes, no ATA commands");
+    /* Allow CF to finish its reset after the original driver releases RESET. */
+    ops->wait_ms(context, 500);
+    for (sample = 1; sample <= 3; ++sample) {
+        for (candidate = 0; candidate < 2; ++candidate) {
+            ops->set_access(context, spaces[candidate], 8);
+            for (i = 0; i < 10; ++i)
+                bytes[i] = ops->read8(context, offsets8[i]);
+            trace("dev9: CF READ8 sample=%u SPACE=%u ERR@01=%02x SC@02=%02x SN@03=%02x CL@04=%02x CH@05=%02x DH@06=%02x ST@07=%02x ERR@0d=%02x ALT@0e=%02x DA@0f=%02x",
+                  sample, spaces[candidate], (unsigned int)bytes[0],
+                  (unsigned int)bytes[1], (unsigned int)bytes[2],
+                  (unsigned int)bytes[3], (unsigned int)bytes[4],
+                  (unsigned int)bytes[5], (unsigned int)bytes[6],
+                  (unsigned int)bytes[7], (unsigned int)bytes[8],
+                  (unsigned int)bytes[9]);
+            ops->set_access(context, spaces[candidate], 16);
+            for (i = 0; i < 5; ++i)
+                words[i] = ops->read16(context, offsets16[i]);
+            trace("dev9: CF READ16 sample=%u SPACE=%u PAIR@02=%04x PAIR@04=%04x PAIR@06=%04x PAIR@0c=%04x PAIR@0e=%04x",
+                  sample, spaces[candidate], (unsigned int)words[0],
+                  (unsigned int)words[1], (unsigned int)words[2],
+                  (unsigned int)words[3], (unsigned int)words[4]);
+            trace("dev9: CF STATUS CANDIDATE sample=%u SPACE=%u ST8=%02x ALT8=%02x ST16_hi=%02x ALT16_lo=%02x; interpretation awaits hardware comparison",
+                  sample, spaces[candidate], (unsigned int)bytes[6],
+                  (unsigned int)bytes[8], (unsigned int)(words[2] >> 8),
+                  (unsigned int)(words[4] & 0xff));
+        }
+        if (sample < 3)
+            ops->wait_ms(context, 100);
+    }
+    trace("dev9: CF PROBE END: register reads only; sector access was not attempted");
+    return 0;
+}
diff --git a/modules/pccf/pcdiag_cf.h b/modules/pccf/pcdiag_cf.h
new file mode 100644
index 0000000..1993621
--- /dev/null
+++ b/modules/pccf/pcdiag_cf.h
@@ -0,0 +1,19 @@
+#ifndef PCDIAG_CF_H
+#define PCDIAG_CF_H
+#include "pcdiag_cis.h"
+
+/* This interface deliberately has no card-write or ATA-command operation.
+   set_access changes only the host selector and its bus-width bit.
+   The owner must restore both host registers after this function returns. */
+typedef struct
+{
+    unsigned char (*read8)(void *context, unsigned int offset);
+    unsigned short (*read16)(void *context, unsigned int offset);
+    void (*set_access)(void *context, unsigned int space, unsigned int width);
+    void (*wait_ms)(void *context, unsigned int milliseconds);
+} pcdiag_cf_ops_t;
+
+/* 0: observed; 1: profile or COR does not permit memory-index-zero probe. */
+int pcdiag_cf_probe(const pcdiag_cis_info_t *info, const pcdiag_cf_ops_t *ops,
+                    void *context, pcdiag_cis_trace_t trace);
+#endif
diff --git a/modules/pccf/pcdiag_cis.c b/modules/pccf/pcdiag_cis.c
new file mode 100644
index 0000000..03436b6
--- /dev/null
+++ b/modules/pccf/pcdiag_cis.c
@@ -0,0 +1,203 @@
+/* Diagnostic additions for the SCPH-10000 PC CARD investigation, 2026-09-30.
+   Reads only the primary attribute CIS chain; links are reported, not followed.
+   No register writes, ATA commands, allocation, or unbounded card addresses. */
+#include "pcdiag_cis.h"
+
+static const char *tuple_name(unsigned int code)
+{
+    switch (code) {
+        case 0x01:
+            return "DEVICE";
+        case 0x06:
+            return "LONGLINK_MFC";
+        case 0x11:
+            return "LONGLINK_A";
+        case 0x12:
+            return "LONGLINK_C";
+        case 0x13:
+            return "LINKTARGET";
+        case 0x14:
+            return "NO_LINK";
+        case 0x15:
+            return "VERS_1";
+        case 0x18:
+            return "JEDEC_A";
+        case 0x1a:
+            return "CONFIG";
+        case 0x1b:
+            return "CFTABLE_ENTRY";
+        case 0x1c:
+            return "DEVICE_OC";
+        case 0x20:
+            return "MANFID";
+        case 0x21:
+            return "FUNCID";
+        case 0x22:
+            return "FUNCE";
+        default:
+            return "other";
+    }
+}
+
+static void describe(unsigned int code, const unsigned char *data,
+                     unsigned int length, pcdiag_cis_trace_t trace,
+                     pcdiag_cis_info_t *info)
+{
+    unsigned int i, n, address_bytes, mask_bytes, at;
+    unsigned long base;
+    char text[65];
+    if (code == 0x20 && length >= 4) {
+        trace("dev9: CIS decoded MANFID manufacturer=%04x card=%04x",
+              (unsigned int)data[0] | ((unsigned int)data[1] << 8),
+              (unsigned int)data[2] | ((unsigned int)data[3] << 8));
+    } else if (code == 0x21 && length >= 2) {
+        ++info->function_count;
+        info->function = data[0];
+        trace("dev9: CIS decoded FUNCID function=%02x (%s) sysinit=%02x",
+              (unsigned int)data[0], data[0] == 4 ? "fixed disk" : "other",
+              (unsigned int)data[1]);
+    } else if (code == 0x15 && length >= 2) {
+        trace("dev9: CIS decoded VERS_1 major=%u minor=%u; text uses | for NUL",
+              (unsigned int)data[0], (unsigned int)data[1]);
+        for (i = 2; i < length && data[i] != 0xff;) {
+            n = 0;
+            while (i < length && data[i] != 0xff && n < sizeof(text) - 1) {
+                unsigned char c = data[i++];
+                text[n++] = c == 0 ? '|' : (c >= 32 && c <= 126 ? c : '?');
+            }
+            text[n] = 0;
+            trace("dev9: CIS VERS_1 text=%s", text);
+        }
+    } else if (code == 0x1a && length >= 2) {
+        address_bytes = (data[0] & 3) + 1;
+        mask_bytes = ((data[0] >> 2) & 15) + 1;
+        if (length < 2 + address_bytes + mask_bytes) {
+            info->malformed = 1;
+            trace("dev9: CIS CONFIG malformed length=%u required=%u",
+                  length, 2 + address_bytes + mask_bytes);
+            return;
+        }
+        base = 0;
+        for (i = 0; i < address_bytes; ++i)
+            base |= (unsigned long)data[2 + i] << (i * 8);
+        ++info->config_count;
+        info->config_base = base;
+        info->register_mask = data[2 + address_bytes];
+        trace("dev9: CIS decoded CONFIG base_attribute=%08lx last_index=%u mask_bytes=%u COR_present=%u",
+              base, (unsigned int)(data[1] & 0x3f), mask_bytes,
+              (unsigned int)(data[2 + address_bytes] & 1));
+    } else if (code == 0x1b && length >= 1) {
+        at = 1;
+        trace("dev9: CIS decoded CFTABLE index=%u default=%u interface_present=%u",
+              (unsigned int)(data[0] & 0x3f), (unsigned int)((data[0] >> 6) & 1),
+              (unsigned int)((data[0] >> 7) & 1));
+        if (data[0] & 0x80) {
+            if (at >= length) {
+                info->malformed = 1;
+                trace("dev9: CIS CFTABLE malformed: missing interface byte");
+                return;
+            }
+            trace("dev9: CIS CFTABLE interface=%02x type=%u (%s)",
+                  (unsigned int)data[at], (unsigned int)(data[at] & 15),
+                  (data[at] & 15) == 0 ? "memory" :
+                                         ((data[at] & 15) == 1 ? "IO" : "other"));
+            if ((data[0] & 0x3f) == 0 && (data[at] & 15) == 0 &&
+                length > at + 1)
+                info->memory_index_zero = 1;
+            ++at;
+        }
+        if (at < length)
+            trace("dev9: CIS CFTABLE feature_byte=%02x; see raw payload for resources",
+                  (unsigned int)data[at]);
+        else {
+            info->malformed = 1;
+            trace("dev9: CIS CFTABLE malformed: missing feature byte");
+        }
+    } else if (code == 0x21 || code == 0x1a || code == 0x1b) {
+        info->malformed = 1;
+    }
+}
+
+int pcdiag_cis_dump_info(pcdiag_cis_read_t read_byte, void *context,
+                         pcdiag_cis_trace_t trace, pcdiag_cis_info_t *info)
+{
+    static const char hex[] = "0123456789abcdef";
+    unsigned char data[254];
+    char line[16 * 3 + 1];
+    unsigned int bus = 0, code, length, i, at, count, tuples = 0;
+    pcdiag_cis_info_t empty = {0};
+    *info = empty;
+    trace("dev9: CIS DUMP BEGIN primary attribute chain; stride=2 bus_limit=%08lx tuple_limit=%u",
+          (unsigned long)PCDIAG_CIS_BUS_LIMIT, PCDIAG_CIS_TUPLE_LIMIT);
+    while (bus < PCDIAG_CIS_BUS_LIMIT) {
+        code = read_byte(context, bus);
+        bus += 2;
+        if (code == 0)
+            continue;
+        if (code == 0xff) {
+            info->complete = 1;
+            trace("dev9: CIS DUMP END tuple at bus=%08lx tuples=%u",
+                  (unsigned long)(bus - 2), tuples);
+            return 0;
+        }
+        if (tuples >= PCDIAG_CIS_TUPLE_LIMIT) {
+            trace("dev9: CIS DUMP STOP tuple limit at bus=%08lx", (unsigned long)(bus - 2));
+            return -2;
+        }
+        if (bus >= PCDIAG_CIS_BUS_LIMIT) {
+            trace("dev9: CIS DUMP STOP missing length at bus=%08lx", (unsigned long)(bus - 2));
+            return -1;
+        }
+        length = read_byte(context, bus);
+        bus += 2;
+        if (length == 0xff) {
+            trace("dev9: CIS DUMP END link=ff at bus=%08lx", (unsigned long)(bus - 4));
+            return 0;
+        }
+        if (length > (PCDIAG_CIS_BUS_LIMIT - bus) / 2) {
+            trace("dev9: CIS DUMP STOP payload outside bound at bus=%08lx length=%u",
+                  (unsigned long)(bus - 4), length);
+            return -1;
+        }
+        ++tuples;
+        trace("dev9: CIS DUMP tuple=%u bus=%08lx code=%02x (%s) length=%u",
+              tuples, (unsigned long)(bus - 4), code, tuple_name(code), length);
+        for (i = 0; i < length; ++i)
+            data[i] = read_byte(context, bus + i * 2);
+        for (i = 0; i < length; i += 16) {
+            count = length - i;
+            if (count > 16)
+                count = 16;
+            for (at = 0; at < count; ++at) {
+                line[at * 3] = hex[data[i + at] >> 4];
+                line[at * 3 + 1] = hex[data[i + at] & 15];
+                line[at * 3 + 2] = ' ';
+            }
+            line[count * 3 - 1] = 0;
+            trace("dev9: CIS DATA bus=%08lx bytes=%s", (unsigned long)(bus + i * 2), line);
+        }
+        describe(code, data, length, trace, info);
+        if (code == 0x06 || code == 0x11 || code == 0x12) {
+            info->linked = 1;
+            trace("dev9: CIS link recorded only; linked chain is not followed");
+        }
+        bus += length * 2;
+    }
+    trace("dev9: CIS DUMP STOP byte bound; END tuple was not found");
+    return -2;
+}
+
+int pcdiag_cis_dump(pcdiag_cis_read_t read_byte, void *context,
+                    pcdiag_cis_trace_t trace)
+{
+    pcdiag_cis_info_t info;
+    return pcdiag_cis_dump_info(read_byte, context, trace, &info);
+}
+
+int pcdiag_cis_cf_candidate(const pcdiag_cis_info_t *info)
+{
+    return info->complete && !info->malformed && !info->linked &&
+           info->function_count == 1 && info->function == 4 &&
+           info->config_count == 1 && info->config_base == 0x200UL &&
+           (info->register_mask & 1) && info->memory_index_zero;
+}
diff --git a/modules/pccf/pcdiag_cis.h b/modules/pccf/pcdiag_cis.h
new file mode 100644
index 0000000..78f4ca6
--- /dev/null
+++ b/modules/pccf/pcdiag_cis.h
@@ -0,0 +1,32 @@
+#ifndef PCDIAG_CIS_H
+#define PCDIAG_CIS_H
+
+/* The caller supplies an already mapped attribute-memory read operation.
+   This diagnostic cannot write hardware or follow addresses from a tuple. */
+#define PCDIAG_CIS_BUS_LIMIT   0x1000U
