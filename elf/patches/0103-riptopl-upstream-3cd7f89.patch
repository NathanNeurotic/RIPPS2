+    inp = Path(tmp) / "bdm.c"
+    exe = Path(tmp) / "bdm"
+    inp.write_text(harness, encoding="utf-8")
+    subprocess.run(["gcc", "-std=c99", "-Wall", "-Wextra", "-Wno-unused-parameter",
+                    "-Werror", str(inp), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, timeout=10)
