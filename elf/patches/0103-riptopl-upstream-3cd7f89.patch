+                int candidateState = udpfsArtFolderHasFiles(i);
+                if (candidateState == -2)
+                    return;
+                if (candidateState > 0) {
+                    chosen = i;
+                    foundPopulated = 1;
+                    break;
+                }
+                if (candidateState == 0 && !haveFallback) {
+                    fallback = i;
+                    haveFallback = 1;
+                }
+            }
