+    g_freeze_diag.vmc_busy_start_lo = now.lo;
+    g_freeze_diag.vmc_busy = 1;
+}
+
+static inline void freeze_diag_vmc_end(void)
+{
+    g_freeze_diag.vmc_busy = 0;
