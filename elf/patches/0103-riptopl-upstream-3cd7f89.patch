diff --git a/modules/pccf/main.c b/modules/pccf/main.c
new file mode 100644
index 0000000..4e73a6a
--- /dev/null
+++ b/modules/pccf/main.c
@@ -0,0 +1,154 @@
+/* PCMCIA CF block device for OPL menu and game core.
+   No SPEED, DEV9 interrupt handler or DMA. PS2SDK BDM ABI 1.1. */
+#include <irx.h>
+#include <loadcore.h>
+#include <bdm.h>
+#include <thbase.h>
+#include <thsemap.h>
+#include <sysclib.h>
+#include <errno.h>
+#include "pccf_ata.h"
+#include "pcclog.h"
+#include "pccf_mbr.h"
+
+IRX_ID("pccf_bd", 1, 1);
+static pccf_ata_t ata;
+static int io_lock = -1;
+static struct block_device device;
+/* Preserve the ATA trace callback ABI without collecting or formatting logs. */
+void pccardTrace(const char *format, ...) { (void)format; }
+
+static int cf_read(struct block_device *bd, u64 sector, void *buffer, u16 count)
+{
+    unsigned int remaining = count, take;
+    unsigned char *out = buffer;
+    int rc = count;
+    (void)bd;
+    if (!buffer || !count || sector >= ata.sectors || count > ata.sectors - sector)
+        return -EINVAL;
+    WaitSema(io_lock);
+    if (!ata.ready || !pccf_hw_present()) {
+        ata.ready = 0;
+        rc = -EIO;
+        goto done;
+    }
+    while (remaining) {
+        take = remaining > 64 ? 64 : remaining;
+        if (pccf_ata_read(&ata, (unsigned int)sector, take, out)) {
+            rc = -EIO;
+            break;
+        }
+        sector += take;
+        out += take * 512;
+        remaining -= take;
+    }
+done:
+    SignalSema(io_lock);
+    return rc;
+}
+static int cf_write(struct block_device *bd, u64 sector, const void *buffer, u16 count)
+{
+#ifdef GAME_DRIVER
+    (void)bd;
+    (void)sector;
+    (void)buffer;
+    (void)count;
+    return -EROFS;
+#else
+    unsigned int remaining = count, take;
+    const unsigned char *in = buffer;
+    int rc = count;
+    (void)bd;
+    if (!buffer || !count || sector >= ata.sectors || count > ata.sectors - sector)
+        return -EINVAL;
+    WaitSema(io_lock);
+    if (!ata.ready || !pccf_hw_present()) {
+        ata.ready = 0;
+        rc = -EIO;
+        goto done;
+    }
+    while (remaining) {
+        take = remaining > 64 ? 64 : remaining;
+        if (pccf_ata_write(&ata, (unsigned int)sector, take, in)) {
+            rc = -EIO;
+            break;
+        }
+        sector += take;
+        in += take * 512;
+        remaining -= take;
+    }
+done:
+    SignalSema(io_lock);
+    return rc;
+#endif
+}
+/* Each successful GUI write already flushes and verifies before returning. */
+static void cf_flush(struct block_device *bd) { (void)bd; }
+static int cf_stop(struct block_device *bd)
+{
+    (void)bd;
+    WaitSema(io_lock);
+    ata.ready = 0;
+    pccf_hw_stop();
+    SignalSema(io_lock);
+    return 0;
+}
+
+static int pccf_owned_handoff(int argc, char **argv)
+{
+#ifdef GAME_DRIVER
+    // LOADFILE inserts the module name at argv[0].
+    return argc == 2 && argv && argv[1] && !strcmp(argv[1], "owned");
+#else
+    (void)argc;
+    (void)argv;
+    return 0;
+#endif
+}
+
+int _start(int argc, char **argv)
+{
+    iop_sema_t sema;
+    int rc;
+    (void)argc;
+    (void)argv;
+    memset(&sema, 0, sizeof(sema));
+    sema.initial = 1;
+    sema.max = 1;
+    io_lock = CreateSema(&sema);
+    if (io_lock < 0)
+        return MODULE_NO_RESIDENT_END;
+    /* Only the game loader carries an explicit handoff from our own menu source.
+       The integrated GUI never reclaims a powered PC CARD owned by another driver. */
+    if (pccf_owned_handoff(argc, argv) &&
+        (*(volatile u16 *)0xbf80146e & 0xf0) == 0x20 &&
+        *(volatile u16 *)0xbf801474 == 0 && *(volatile u16 *)0xbf80146c != 0) {
+        *(volatile u16 *)0xbf80147e = 1;
+        *(volatile u16 *)0xbf80146c = 0;
+        DelayThread(100000);
+    }
+    rc = pccf_hw_start(&ata);
+    if (rc) {
+        DeleteSema(io_lock);
+        return MODULE_NO_RESIDENT_END;
+    }
+    unsigned char mbr[512];
+    if (pccf_ata_read(&ata, 0, 1, mbr) || !pccf_mbr_valid(mbr, ata.sectors)) {
+        ata.ready = 0;
+        pccf_hw_stop();
+        DeleteSema(io_lock);
+        return MODULE_NO_RESIDENT_END;
+    }
+    memset(&device, 0, sizeof(device));
+    device.name = "cf";
+    device.devNr = 0;
+    device.parNr = 0;
+    device.sectorSize = 512;
+    device.sectorCount = ata.sectors;
+    device.read = cf_read;
+    device.write = cf_write;
+    device.flush = cf_flush;
+    device.stop = cf_stop;
+    bdm_connect_bd(&device);
+    return MODULE_RESIDENT_END;
+}
diff --git a/modules/pccf/pccf_ata.c b/modules/pccf/pccf_ata.c
new file mode 100644
index 0000000..34f4527
--- /dev/null
+++ b/modules/pccf/pccf_ata.c
@@ -0,0 +1,278 @@
+/* Persistent form of DIAG5's hardware-tested EC/20 PIO data-in protocol.
+   All status waits are bounded. A transfer error latches the session offline,
+   so subsequent requests cannot issue commands into an uncertain state. */
+#include <string.h>
+#include "pccf_ata.h"
+static unsigned char identify[512];
+static unsigned int word(unsigned int i)
+{
+    return (unsigned int)identify[i * 2] | ((unsigned int)identify[i * 2 + 1] << 8);
+}
+static void ata_string(unsigned int first, unsigned int size, char *out)
+{
+    unsigned int i, c;
+    for (i = 0; i < size; ++i) {
+        c = identify[first * 2 + (i ^ 1U)];
+        out[i] = c >= 32 && c <= 126 ? c : '?';
+    }
+    while (size && out[size - 1] == ' ')
+        --size;
+    out[size] = 0;
+}
+static int wait_status(pccf_ata_t *ata, int drq, const char *phase)
+{
+    const pcdiag_cf_ops_t *io = ata->ops->memory;
+    unsigned int ms, spin, s = 0;
+    for (ms = 0; ms < PCDIAG_ATA_POLL_LIMIT_MS; ++ms) {
+        for (spin = 0;; ++spin) {
+            s = io->read8(ata->context, 0x0e);
+            if (!s || s == 0xff)
+                break;
+            if (!(s & 0x80)) {
+                if (s & 0x21)
+                    break;
+                if (drq ? ((s & 8) != 0) : (!(s & 8) && (s & 0x40)))
+                    return 0;
+            }
+            if (!ata->fast_poll || spin == 63)
+                break;
+        }
+        if (!s || s == 0xff || (!(s & 0x80) && (s & 0x21)))
+            break;
+        io->wait_ms(ata->context, 1);
+    }
+    ata->trace("pccf: ATA FAIL phase=%s status=%02x error=%02x waited_ms=%u",
+               phase, s, (unsigned int)io->read8(ata->context, 1), ms);
+    ata->ready = 0;
+    return -1;
+}
+static int transfer(pccf_ata_t *ata, unsigned int command,
+                    unsigned int lba, unsigned int count, unsigned char *buffer)
+{
+    const pcdiag_cf_ops_t *io = ata->ops->memory;
+    unsigned int i, v, sector;
+    io->set_access(ata->context, 0, 8);
+    if (wait_status(ata, 0, "before-command"))
+        return -1;
+    /* Conservative command spacing for CF bridges. No retry after a failed
+       transaction: preserve the offline latch and log the failing address. */
+    /* Preparation/settling is handled by the host, once per command. */
+    if ((ata->issue_command && command != 0xec ?
+             ata->issue_command(ata->context, command, lba, count) :
+         command == 0x20 && ata->issue_read_sectors ?
+             ata->issue_read_sectors(ata->context, lba, count) :
+             ata->ops->issue_read_command(ata->context, command, lba))) {
+        ata->trace("pccf: ATA FAIL host rejected cmd=%02x lba=%08lx", command, (unsigned long)lba);
+        ata->ready = 0;
+        return -1;
+    }
+    ++ata->commands;
+    if (count > 1)
+        ++ata->multi_commands;
+    for (i = 0; i < 4; ++i)
+        io->read8(ata->context, 0x0e);
+    for (sector = 0; sector < count; ++sector) {
+        if (wait_status(ata, 1, "data-request")) {
+            ata->trace("pccf: ATA failed command cmd=%02x lba=%08lx count=%u completed_words=%u",
+                       command, (unsigned long)(lba + sector), count, sector * 256);
+            return -1;
+        }
+        /* READ SECTORS has one DRQ/data phase per sector. Acknowledge status,
+           transfer exactly 256 words, then poll the next phase in byte mode. */
+        (void)io->read8(ata->context, 7);
+        io->set_access(ata->context, 0, 16);
+        if (ata->read_sector)
+            ata->read_sector(buffer + sector * 512);
+        else
+            for (i = 0; i < 256; ++i) {
+                v = io->read16(ata->context, 0);
+                buffer[sector * 512 + i * 2] = v & 0xff;
+                buffer[sector * 512 + i * 2 + 1] = v >> 8;
+            }
+        io->set_access(ata->context, 0, 8);
+        for (i = 0; i < 4; ++i)
+            io->read8(ata->context, 0x0e);
+    }
+    if (wait_status(ata, 0, "transfer-complete")) {
+        ata->trace("pccf: ATA failed command cmd=%02x lba=%08lx completed_words=%u", command, (unsigned long)lba, count * 256);
+        return -1;
+    }
+    v = io->read8(ata->context, 7);
+    if ((v & 0xa9) || !(v & 0x40)) {
+        ata->trace("pccf: ATA FAIL final status=%02x cmd=%02x lba=%08lx", v, command, (unsigned long)lba);
+        ata->ready = 0;
+        return -1;
+    }
+    if (ata->commands <= 8 || (count > 1 && ata->multi_commands <= 4))
+        ata->trace("pccf: ATA OK cmd=%02x lba=%08lx count=%u words=%u status=%02x",
+                   command, (unsigned long)lba, count, count * 256, v);
+    return 0;
+}
+int pccf_ata_attach(pccf_ata_t *ata, const pcdiag_ata_ops_t *ops,
+                    void *context, pcdiag_cis_trace_t trace)
+{
+    const pcdiag_cf_ops_t *io = ops->memory;
+    unsigned int s, alt, sc, sn, cl, ch, dh, pair, conf, cap, sectors, valid106, i, sum = 0;
+    unsigned int reset_signature, zero_signature;
+    memset(ata, 0, sizeof(*ata));
+    ata->ops = ops;
+    ata->context = context;
+    ata->trace = trace;
+    io->set_access(context, 0, 8);
+    /* CIS may be readable while ATA is still completing reset. Wait for BSY
+       to clear before checking the startup signature, at most five seconds. */
+    for (i = 0; i < 5000; ++i) {
+        alt = io->read8(context, 0x0e);
+        if (alt == 0xff || !(alt & 0x80))
+            break;
+        io->wait_ms(context, 1);
+    }
+    trace("pccf: ATA startup wait_ms=%u ALT=%02x", i, alt);
+    if (i == 5000) {
+        trace("pccf: ATA startup timeout; no command sent");
+        return -1;
+    }
+    s = io->read8(context, 7);
+    alt = io->read8(context, 0x0e);
+    sc = io->read8(context, 2);
+    sn = io->read8(context, 3);
+    cl = io->read8(context, 4);
+    ch = io->read8(context, 5);
+    dh = io->read8(context, 6);
+    io->set_access(context, 0, 16);
+    pair = io->read16(context, 6);
+    io->set_access(context, 0, 8);
+    trace("pccf: ATA PRECHECK ST=%02x ALT=%02x SC=%02x SN=%02x CL=%02x CH=%02x DH=%02x PAIR06=%04x", s, alt, sc, sn, cl, ch, dh, pair);
+    reset_signature = sc == 1 && sn == 1 && !cl && !ch && dh == 0xa0;
+    /* The tested SD-CF bridge supplies a valid memory
+       CIS and ST=50/ALT=50/PAIR06=5000, but zeroes its taskfile on startup.
+       Permit this exact observed pattern for a read-only IDENTIFY attempt.
+       Retain byte/word agreement, readiness and all IDENTIFY validation. */
+    zero_signature = s == 0x50 && !sc && !sn && !cl && !ch && !dh;
+    if (s != alt || s != (pair >> 8) || dh != (pair & 0xff) ||
+        !(s & 0x40) || (s & 0xa9) || (!reset_signature && !zero_signature)) {
+        trace("pccf: ATA rejected reset signature or byte/word map; no command sent");
+        return -1;
+    }
+    if (zero_signature)
+        trace("pccf: zero startup signature accepted for IDENTIFY only; response validation required");
+    if (transfer(ata, 0xec, 0, 1, identify))
+        return -1;
+    conf = word(0);
+    cap = word(49);
+    sectors = word(60) | (word(61) << 16);
+    for (i = 0; i < 512; ++i)
+        sum += identify[i];
+    if (!conf || conf == 0xffff || ((conf & 0x8000) && conf != 0x848a) ||
+        !(cap & 0x200) || !sectors || sectors == 0xffffffffU ||
+        (identify[510] == 0xa5 && (sum & 0xff))) {
+        trace("pccf: IDENTIFY rejected word0=%04x word49=%04x sectors=%08lx integrity=%02x checksum=%02x",
+              conf, cap, (unsigned long)sectors, (unsigned int)identify[510], sum & 0xff);
+        return -1;
+    }
+    valid106 = word(106);
+    if ((valid106 & 0xc000) == 0x4000 && (valid106 & 0x1000) && (word(117) != 256 || word(118))) {
+        trace("pccf: IDENTIFY rejected logical sector size; only 512-byte sectors supported");
+        return -1;
+    }
+    ata->lba48 = (word(83) & 0xc400) == 0x4400;
+    ata->flush_command = (word(83) & 0xc000) == 0x4000 ?
+                             ((word(83) & 0x2000) ? 0xea : ((word(83) & 0x1000) ? 0xe7 : 0)) :
+                             0;
+    ata->write_cache = !!(word(85) & 0x20);
+    if (ata->lba48) {
+        unsigned int ext = word(100) | (word(101) << 16);
+        if (word(102) || word(103))
+            ext = 0xffffffffU; /* Bounded to 2 TiB minus one sector. */
+        if (!ext || ext < sectors)
+            return -1;
+        sectors = ext;
+    }
+    ata->sectors = ata->lba48 ? sectors : sectors > PCDIAG_ATA_LBA28_SECTORS ? PCDIAG_ATA_LBA28_SECTORS :
+                                                                               sectors;
+    ata_string(27, 40, ata->model);
+    ata_string(10, 20, ata->serial);
+    ata_string(23, 8, ata->firmware);
+    ata->ready = 1;
+    trace("CF: LBA48=%u sectors=%08lx flush=%02x cache=%u", ata->lba48, (unsigned long)ata->sectors, ata->flush_command, ata->write_cache);
+    trace("pccf: IDENTIFY ACCEPTED model=%s serial=%s firmware=%s sectors=%08lx MiB=%lu",
+          ata->model, ata->serial, ata->firmware, (unsigned long)ata->sectors, (unsigned long)(ata->sectors / 2048));
+    return 0;
+}
+int pccf_ata_read(pccf_ata_t *ata, unsigned int lba, unsigned int count, unsigned char *buffer)
+{
+    unsigned int i;
+    if (!ata->ready || !buffer || !count || count > 64 || lba >= ata->sectors ||
+        count > ata->sectors - lba)
+        return -1;
+    unsigned int extended = lba >= PCDIAG_ATA_LBA28_SECTORS || count > PCDIAG_ATA_LBA28_SECTORS - lba;
+    if (extended && (!ata->lba48 || !ata->issue_command))
+        return -1;
+    if (ata->issue_read_sectors || ata->issue_command) {
+        if (transfer(ata, extended ? 0x24 : 0x20, lba, count, buffer))
+            return -1;
+        ata->sector_reads += count;
+        return 0;
+    }
+    for (i = 0; i < count; ++i) {
+        if (transfer(ata, 0x20, lba + i, 1, buffer + i * 512))
+            return -1;
+        ++ata->sector_reads;
+    }
+    return 0;
+}
+
+#ifndef GAME_DRIVER
+/* Writes use conservative 16-bit stores, flush before reporting success,
+   and read every sector back. Never retry an uncertain write transaction. */
+int pccf_ata_write(pccf_ata_t *ata, unsigned int lba, unsigned int count, const unsigned char *buffer)
+{
+    static unsigned char verify[512];
+    const pcdiag_cf_ops_t *io = ata->ops->memory;
+    unsigned int i, sector, command;
+    if (!ata->ready || !buffer || !count || count > 64 || lba >= ata->sectors ||
+        count > ata->sectors - lba || !ata->issue_command || !ata->write_sector ||
+        (ata->write_cache && !ata->flush_command))
+        return -1;
+    command = lba >= PCDIAG_ATA_LBA28_SECTORS || count > PCDIAG_ATA_LBA28_SECTORS - lba ? 0x34 : 0x30;
+    if (command == 0x34 && !ata->lba48)
+        return -1;
+    io->set_access(ata->context, 0, 8);
+    if (wait_status(ata, 0, "before-write"))
+        return -1;
+    if (ata->issue_command(ata->context, command, lba, count))
+        goto fail;
+    for (i = 0; i < 4; i++)
+        io->read8(ata->context, 0x0e);
+    for (sector = 0; sector < count; sector++) {
+        if (wait_status(ata, 1, "write-drq"))
+            goto fail;
+        (void)io->read8(ata->context, 7);
+        ata->write_sector(buffer + sector * 512);
+        io->set_access(ata->context, 0, 8);
+        for (i = 0; i < 4; i++)
+            io->read8(ata->context, 0x0e);
+    }
+    if (wait_status(ata, 0, "write-complete"))
+        goto fail;
+    if (ata->flush_command) {
+        if (ata->issue_command(ata->context, ata->flush_command, 0, 0))
+            goto fail;
+        for (i = 0; i < 4; i++)
+            io->read8(ata->context, 0x0e);
+        if (wait_status(ata, 0, "write-flush"))
+            goto fail;
+    }
+    for (sector = 0; sector < count; sector++) {
+        if (pccf_ata_read(ata, lba + sector, 1, verify) || memcmp(verify, buffer + sector * 512, 512))
+            goto fail;
+    }
+    if (++ata->write_commands <= 8)
+        ata->trace("CF: WRITE VERIFIED lba=%08lx count=%u", (unsigned long)lba, count);
+    return 0;
+fail:
+    ata->trace("CF: WRITE FAILED lba=%08lx count=%u; session offline", (unsigned long)lba, count);
+    ata->ready = 0;
+    return -1;
+}
+#endif
diff --git a/modules/pccf/pccf_ata.h b/modules/pccf/pccf_ata.h
new file mode 100644
index 0000000..47c8838
--- /dev/null
+++ b/modules/pccf/pccf_ata.h
@@ -0,0 +1,33 @@
+#ifndef PCCF_ATA_H
+#define PCCF_ATA_H
+#include "pcdiag_ata.h"
+
+/* Persistent ATA session. Caller serializes all requests. */
+typedef struct
+{
+    const pcdiag_ata_ops_t *ops;
+    void *context;
+    pcdiag_cis_trace_t trace;
+    unsigned int ready, sectors, commands, sector_reads;
+    unsigned int multi_commands;
+    unsigned int lba48, flush_command, write_cache, write_commands;
+    int (*issue_command)(void *context, unsigned int command, unsigned int lba, unsigned int count);
+    void (*write_sector)(const unsigned char *buffer);
+    int (*issue_read_sectors)(void *context, unsigned int lba, unsigned int count);
+    unsigned int (*time_us)(void);
+    void (*read_sector)(unsigned char *buffer);
+    unsigned int fast_poll;
+    char model[41], serial[21], firmware[9];
+} pccf_ata_t;
+int pccf_ata_attach(pccf_ata_t *ata, const pcdiag_ata_ops_t *ops,
+                    void *context, pcdiag_cis_trace_t trace);
+int pccf_ata_read(pccf_ata_t *ata, unsigned int lba, unsigned int count,
+                  unsigned char *buffer);
+
+int pccf_ata_write(pccf_ata_t *ata, unsigned int lba, unsigned int count, const unsigned char *buffer);
+
+/* Production PC CARD host. No SPEED, DMA or DEV9 exports. */
+int pccf_hw_start(pccf_ata_t *ata);
+int pccf_hw_present(void);
+void pccf_hw_stop(void);
+#endif
diff --git a/modules/pccf/pccf_hw.c b/modules/pccf/pccf_hw.c
new file mode 100644
index 0000000..8e5fe55
--- /dev/null
+++ b/modules/pccf/pccf_hw.c
@@ -0,0 +1,313 @@
+/* PC CARD power/reset sequence adapted from PS2SDK DEV9 (Marcus R. Brown,
+   2003), Academic Free License 2.0; see PS2SDK_LICENSE.txt.
+   CF uses the memory window proven by DIAG4/5 on SCPH-10000. No Sony SPEED
+   register, interrupt handler, DMA or DEV9 library is installed here. */
+#include <types.h>
+#include <string.h>
+#include <thbase.h>
+#include "pcclog.h"
+#include "pccf_ata.h"
+#ifndef PCCF_SETTLE_US
+#define PCCF_SETTLE_US 1000
+#endif
+#ifndef PCCF_HW_TEST
+#define HW_R16(a)    (*(volatile u16 *)(a))
+#define HW_W16(a, v) (*(volatile u16 *)(a) = (v))
+#define HW_R32(a)    (*(volatile u32 *)(a))
+#define HW_W32(a, v) (*(volatile u32 *)(a) = (v))
+#define HW_R8(a)     (*(volatile u8 *)(a))
+#define HW_W8(a, v)  (*(volatile u8 *)(a) = (v))
+#endif
+#define REG(n)  (0xbf800000U + (n))
+#define CARD(n) (0xb0000000U + (n))
+static const unsigned int save16_addr[] = {0x1460, 0x1468, 0x146a, 0x1474, 0x147a, 0x147c, 0x147e};
+static const unsigned int save32_addr[] = {0x1418, 0x141c, 0x1420};
+static u16 saved16[7], selector;
+static u32 saved32[3];
+static int started;
+static unsigned int read_command_logs;
+static unsigned int pio_data_timing = 0x001a10bbU;
+static unsigned int pio_cpu32, pio_settle_us = PCCF_SETTLE_US;
+static unsigned int pio_fallback_restart;
+#include "pccf_pio_bulk.inc"
+static unsigned char card_read8(void *context, unsigned int offset)
+{
+    (void)context;
+    return HW_R8(CARD(offset));
+}
+static unsigned short card_read16(void *context, unsigned int offset)
+{
+    (void)context;
+    return HW_R16(CARD(offset));
+}
+static void access_window(void *context, unsigned int space, unsigned int width)
+{
+    (void)context;
+    HW_W32(REG(0x1418), (space == 0 && width == 16) ? pio_data_timing : (0x001a00bbU | (width == 16 ? 0x1000U : 0)));
+    HW_W16(REG(0x1460), (selector & ~3U) | space);
+}
+static void wait_ms(void *context, unsigned int milliseconds)
+{
+    (void)context;
+    DelayThread(milliseconds * 1000);
+}
+/* Retain bounded CIS/map validation without emitting tuple or register dumps.
+   The separate SD-DIAG branches keep detailed hardware diagnostics. */
+static void quiet_trace(const char *format, ...)
+{
+    (void)format;
+}
+static int read_cf_profile(pcdiag_cis_info_t *info)
+{
+    unsigned int attempt, elapsed = 0;
+    for (attempt = 0; attempt < 3; ++attempt) {
+        int rc = pcdiag_cis_dump_info(card_read8, NULL, quiet_trace, info);
+        if (!rc && pcdiag_cis_cf_candidate(info)) {
+            pccardTrace("pccf: CIS accepted extra_wait_ms=%u fixed-disk memory-index=0 COR=0200", elapsed);
+            return 0;
+        }
+        if (attempt == 2)
+            break;
+        pccardTrace("pccf: CIS not ready/unsupported rc=%d; retry after %u ms", rc, attempt ? 4000U : 1000U);
+        wait_ms(NULL, attempt ? 4000 : 1000);
+        elapsed += attempt ? 4000 : 1000;
+        if (!pccf_hw_present()) {
+            pccardTrace("pccf: CIS stopped: card removed or power lost");
+            return -1;
+        }
+    }
+    pccardTrace("pccf: CIS unsupported after extra_wait_ms=5000; no ATA commands attempted");
+    return -1;
+}
+int pccf_hw_present(void)
+{
+    return started && (HW_R16(REG(0x1462)) & 3) == 0 && (HW_R16(REG(0x146c)) & 1);
+}
+static int issue_read_count(void *context, unsigned int command, unsigned int lba, unsigned int count)
+{
+    unsigned int i, observed[5], expected[5], mismatch = 0;
+    (void)context;
+    if (!((command == 0xec && lba == 0 && count == 1) ||
+          (command == 0x20 && count && count <= 64 && lba < PCDIAG_ATA_LBA28_SECTORS &&
+           count <= PCDIAG_ATA_LBA28_SECTORS - lba)) ||
+        !pccf_hw_present() || (HW_R16(REG(0x1460)) & 3) || (HW_R32(REG(0x1418)) & 0x1000U))
+        return -1;
+    if (command == 0x20) {
+        HW_W8(CARD(6), 0xe0 | ((lba >> 24) & 15));
+        for (i = 0; i < 4; ++i)
+            (void)HW_R8(CARD(0x0e));
+        if (pio_settle_us)
+            DelayThread(pio_settle_us); /* Settle device/head selection. */
+        HW_W8(CARD(2), count);
+        HW_W8(CARD(3), lba & 0xff);
+        HW_W8(CARD(4), (lba >> 8) & 0xff);
+        HW_W8(CARD(5), (lba >> 16) & 0xff);
+        if (pio_settle_us)
+            DelayThread(pio_settle_us); /* Settle parameters before command. */
+        if (!pccf_hw_present())
+            return -1;
+        expected[0] = count;
+        expected[1] = lba & 0xff;
+        expected[2] = (lba >> 8) & 0xff;
+        expected[3] = (lba >> 16) & 0xff;
+        expected[4] = 0xe0 | ((lba >> 24) & 15);
+        for (i = 0; i < 5; ++i) {
+            observed[i] = HW_R8(CARD(i + 2));
+            if (observed[i] != expected[i])
+                mismatch = 1;
+        }
+        if (read_command_logs++ < 8 || mismatch)
+            pccardTrace("pccf: TASKFILE lba=%08lx match=%u SC=%02x SN=%02x CL=%02x CH=%02x DH=%02x",
+                        (unsigned long)lba, !mismatch, observed[0], observed[1], observed[2], observed[3], observed[4]);
+        if (mismatch) {
+            pccardTrace("pccf: TASKFILE mismatch; read command not sent");
+            return -1;
+        }
+    }
+    HW_W8(CARD(7), command);
+    return 0;
+}
+/* Extended taskfile high bytes must be sent first. Device/head keeps
+   only the LBA bit; LBA[27:24] belongs in the high LBA register instead. */
+static int issue_rw(void *context, unsigned int command, unsigned int lba, unsigned int count)
+{
+    unsigned int i, extended = command == 0x24 || command == 0x34;
+    unsigned int writing = command == 0x30 || command == 0x34;
+    if (command == 0x20)
+        return issue_read_count(context, command, lba, count);
+#ifdef GAME_DRIVER
+    if (command != 0x24)
+        return -1;
+#endif
+    if (!(extended || writing || command == 0xe7 || command == 0xea) ||
+        !pccf_hw_present() || (HW_R16(REG(0x1460)) & 3) ||
+        (HW_R32(REG(0x1418)) & 0x1000U))
+        return -1;
+    if (extended || writing) {
+        if (!count || count > 64 || (!extended && (lba >= PCDIAG_ATA_LBA28_SECTORS || count > PCDIAG_ATA_LBA28_SECTORS - lba)))
+            return -1;
+        HW_W8(CARD(6), extended ? 0xe0 : 0xe0 | ((lba >> 24) & 15));
+        for (i = 0; i < 4; i++)
+            (void)HW_R8(CARD(0x0e));
+        if (writing)
+            DelayThread(1000);
+        else if (pio_settle_us)
+            DelayThread(pio_settle_us);
+        if (extended) {
+            HW_W8(CARD(2), 0);
+            HW_W8(CARD(3), (lba >> 24) & 255);
+            HW_W8(CARD(4), 0);
+            HW_W8(CARD(5), 0);
+        }
+        HW_W8(CARD(2), count);
+        HW_W8(CARD(3), lba & 255);
+        HW_W8(CARD(4), (lba >> 8) & 255);
+        HW_W8(CARD(5), (lba >> 16) & 255);
+        if (writing)
+            DelayThread(1000);
+        else if (pio_settle_us)
+            DelayThread(pio_settle_us);
+    }
+    if (!pccf_hw_present())
+        return -1;
+    HW_W8(CARD(7), command);
+    return 0;
+}
+#ifndef GAME_DRIVER
+static void pio_write_sector(const unsigned char *buffer)
+{
+    unsigned int i;
+    HW_W32(REG(0x1418), 0x001a10bbU);
+    HW_W16(REG(0x1460), selector & ~3U);
+    for (i = 0; i < 512; i += 2)
+        HW_W16(CARD(0), (unsigned int)buffer[i] | ((unsigned int)buffer[i + 1] << 8));
+}
+#endif
+static int issue_read(void *context, unsigned int command, unsigned int lba)
+{
+    return issue_read_count(context, command, lba, 1);
+}
+static int issue_sectors(void *context, unsigned int lba, unsigned int count)
+{
+    return issue_read_count(context, 0x20, lba, count);
+}
+static unsigned int time_us(void)
+{
+    iop_sys_clock_t now;
+    u32 seconds, microseconds;
+    GetSystemTime(&now);
+    SysClock2USec(&now, &seconds, &microseconds);
+    return seconds * 1000000U + microseconds;
+}
+#include "pccf_pio_profile.inc"
+void pccf_hw_stop(void)
+{
+    unsigned int i;
+    if (!started)
+        return;
+    HW_W16(REG(0x147e), 1);
+    HW_W16(REG(0x146c), 0);
+    for (i = 0; i < 6; ++i)
+        HW_W16(REG(save16_addr[i]), saved16[i]);
+    for (i = 0; i < 3; ++i)
+        HW_W32(REG(save32_addr[i]), saved32[i]);
+    HW_W16(REG(0x147e), saved16[6]);
+    started = 0;
+    pccardTrace("pccf: PC CARD powered off; saved host settings restored");
+}
+int pccf_hw_start(pccf_ata_t *ata)
+{
+    static const pcdiag_cf_ops_t memory = {card_read8, card_read16, access_window, wait_ms};
+    static const pcdiag_ata_ops_t ops = {&memory, issue_read};
+    pcdiag_cis_info_t info;
+    unsigned int i, voltage, status;
+    int tune_rc;
+    u16 v;
+    ata->ready = 0;
+    if ((HW_R16(REG(0x146e)) & 0xf0) != 0x20)
+        return -1;
+    status = HW_R16(REG(0x1462));
+    pio_data_timing = 0x001a10bbU;
+    pio_cpu32 = 0;
+    pio_settle_us = PCCF_SETTLE_US;
+    read_command_logs = 0;
+    pccardTrace("pccf: START REV=%04x CARDSTAT=%04x POWER=%04x MODE=%04x",
+                HW_R16(REG(0x146e)), status, HW_R16(REG(0x146c)), HW_R16(REG(0x1474)));
+    /* 0x146e is DEV9 REV. Restrict this first driver to retail PC CARD.
+       Never seize an already powered adapter owned by another driver. */
+    if ((HW_R16(REG(0x146e)) & 0xf0) != 0x20 || (status & 3) != 0 ||
+        (status & 0x0c) == 4 || HW_R16(REG(0x146c)) != 0 || HW_R16(REG(0x1474)) != 0) {
+        pccardTrace("pccf: START rejected: no compatible idle 16-bit PC CARD controller/card");
+        return -1;
+    }
+    voltage = (status & 0x0c) == 0x0c ? 2 : 1;
+    for (i = 0; i < 7; ++i)
+        saved16[i] = HW_R16(REG(save16_addr[i]));
+    for (i = 0; i < 3; ++i)
+        saved32[i] = HW_R32(REG(save32_addr[i]));
+    selector = saved16[0];
+    started = 1;
+    HW_W32(REG(0x1420), 0x51011);
+    HW_W32(REG(0x1418), 0x1a00bb);
+    HW_W32(REG(0x141c), 0xef1a3043);
+    HW_W16(REG(0x147e), 1);
+    HW_W16(REG(0x1460), selector & ~3U);
+    HW_W16(REG(0x1474), 0);
+    v = HW_R16(REG(0x1464));
+    HW_W16(REG(0x1464), v);
+    v = HW_R16(REG(0x1466));
+    HW_W16(REG(0x1466), v);
+    HW_W16(REG(0x1468), 0x10);
+    HW_W16(REG(0x146a), 0x90);
+    HW_W16(REG(0x147c), 1);
+    HW_W16(REG(0x147a), HW_R16(REG(0x147c)));
+    v = (voltage == 1 ? 4 : 8) | 0x10;
+    HW_W16(REG(0x146c), v);
+    DelayThread(22000);
+    if (!(HW_R16(REG(0x1462)) & 0x100))
+        goto fail;
+    HW_W16(REG(0x146c), v | 2);
+    DelayThread(500000);
+    HW_W16(REG(0x146c), v | 3);
+    v = HW_R16(REG(0x1464));
+    HW_W16(REG(0x1464), v);
+    v = HW_R16(REG(0x1466));
+    HW_W16(REG(0x1466), v);
+    pccardTrace("pccf: RESET done voltage=%uV CARDSTAT=%04x POWER=%04x", voltage == 1 ? 3U : 5U,
+                HW_R16(REG(0x1462)), HW_R16(REG(0x146c)));
+    access_window(NULL, 2, 8);
+    if (read_cf_profile(&info)) {
+        pccardTrace("pccf: CIS rejected: unsupported/incomplete CF memory profile");
+        goto fail;
+    }
+    if (pcdiag_cf_probe(&info, &memory, NULL, quiet_trace)) {
+        pccardTrace("pccf: CF memory profile/configuration rejected");
+        goto fail;
+    }
+    if (pccf_ata_attach(ata, &ops, NULL, pccardTrace))
+        goto fail;
+    ata->issue_read_sectors = issue_sectors;
+    ata->issue_command = issue_rw;
+#ifndef GAME_DRIVER
+    ata->write_sector = pio_write_sector;
+#endif
+    ata->time_us = time_us;
+    if (!pio_fallback_restart && (tune_rc = pio_profile(ata)) != 0) {
+        pccardTrace("CF: profile verification failed rc=%d; restarting with original PIO", tune_rc);
+        ata->ready = 0;
+        pccf_hw_stop();
+        DelayThread(100000);
+        pio_fallback_restart = 1;
+        tune_rc = pccf_hw_start(ata);
+        pio_fallback_restart = 0;
+        return tune_rc;
+    }
+
+    access_window(NULL, 0, 8);
+    pccardTrace("pccf: PC CARD remains powered; SPACE=0, PIO polling");
+    return 0;
+fail:
+    ata->ready = 0;
+    pccf_hw_stop();
+    return -1;
+}
diff --git a/modules/pccf/pccf_mbr.h b/modules/pccf/pccf_mbr.h
new file mode 100644
index 0000000..c6873bd
--- /dev/null
+++ b/modules/pccf/pccf_mbr.h
@@ -0,0 +1,26 @@
+/* RiptOPL CF partition validation. No filesystem writes. */
+#ifndef PCCF_MBR_H
+#define PCCF_MBR_H
+static unsigned int pccf_le32(const unsigned char *p)
+{
+    return (unsigned int)p[0] | (unsigned int)p[1] << 8 | (unsigned int)p[2] << 16 | (unsigned int)p[3] << 24;
+}
+static int pccf_mbr_valid(const unsigned char *sector, unsigned int sectors)
+{
+    int usable = 0;
+    if (!sector || sector[510] != 0x55 || sector[511] != 0xaa)
+        return 0;
+    for (int i = 0; i < 4; i++) {
+        const unsigned char *part = sector + 446 + i * 16;
+        unsigned int start = pccf_le32(part + 8), count = pccf_le32(part + 12);
+        if (part[4] == 0xee)
+            return 0;
+        if (part[4] != 0x0b && part[4] != 0x0c && part[4] != 0x07)
+            continue;
+        if ((part[0] != 0 && part[0] != 0x80) || !start || !count || start >= sectors || count > sectors - start)
+            return 0;
+        usable = 1;
+    }
+    return usable;
+}
+#endif
diff --git a/modules/pccf/pccf_pio_bulk.inc b/modules/pccf/pccf_pio_bulk.inc
new file mode 100644
index 0000000..641018d
--- /dev/null
+++ b/modules/pccf/pccf_pio_bulk.inc
@@ -0,0 +1,30 @@
+/* CPU loads remain on a 16-bit external bus, AINC=0. Each 32-bit
+   instruction consumes two consecutive ATA words from the same port. */
+static void pio_read_sector(unsigned char *buffer)
+{
+    unsigned int i, v;
+    if (pio_cpu32 && !((unsigned long)buffer & 3)) {
+        u32 *out = (u32 *)buffer;
+        for (i = 0; i < 128; i += 8) {
+            out[i] = HW_R32(CARD(0)); out[i+1] = HW_R32(CARD(0));
+            out[i+2] = HW_R32(CARD(0)); out[i+3] = HW_R32(CARD(0));
+            out[i+4] = HW_R32(CARD(0)); out[i+5] = HW_R32(CARD(0));
+            out[i+6] = HW_R32(CARD(0)); out[i+7] = HW_R32(CARD(0));
+        }
+    } else if (!pio_cpu32 && !((unsigned long)buffer & 1)) {
+        u16 *out = (u16 *)buffer;
+        for (i = 0; i < 256; i += 8) {
+            out[i] = HW_R16(CARD(0)); out[i+1] = HW_R16(CARD(0));
+            out[i+2] = HW_R16(CARD(0)); out[i+3] = HW_R16(CARD(0));
+            out[i+4] = HW_R16(CARD(0)); out[i+5] = HW_R16(CARD(0));
+            out[i+6] = HW_R16(CARD(0)); out[i+7] = HW_R16(CARD(0));
+        }
+    } else {
+        /* Same MMIO width for misaligned destinations; never unaligned lw/sw. */
+        for (i = 0; i < 512; i += pio_cpu32 ? 4 : 2) {
+            v = pio_cpu32 ? HW_R32(CARD(0)) : HW_R16(CARD(0));
+            buffer[i] = v; buffer[i+1] = v >> 8;
+            if (pio_cpu32) { buffer[i+2] = v >> 16; buffer[i+3] = v >> 24; }
+        }
+    }
+}
diff --git a/modules/pccf/pccf_pio_profile.inc b/modules/pccf/pccf_pio_profile.inc
new file mode 100644
index 0000000..9fb7c04
--- /dev/null
+++ b/modules/pccf/pccf_pio_profile.inc
@@ -0,0 +1,28 @@
+/* v30 hardware-validated profiles. Unknown cards retain original PIO.
+   Short validation after every IOP reset; no destructive timing sweep. */
+static union { u32 words[1024]; unsigned char bytes[4096]; } profile_ref, profile_check;
+static int pio_profile(pccf_ata_t *ata)
+{
+    unsigned int timing, sample, lba;
+    if (!strcmp(ata->model, "TS16GCF133")) timing=0x001a101b;
+    else if (!strcmp(ata->model, "INIC-2051 CompactFlash Card")) timing=0x001a102b;
+    else {
+        pccardTrace("CF: unknown model; conservative 16-bit PIO retained"); return 0;
+    }
+    if (ata->sectors<4096) return -1;
+    for (sample=0;sample<3;++sample) {
+        lba=sample==0 ? 0 : (sample==1 ? 2048 : ata->sectors/2);
+        pio_data_timing=0x001a10bb; pio_cpu32=0; pio_settle_us=1000;
+        ata->read_sector=NULL; ata->fast_poll=0;
+        if (pccf_ata_read(ata,lba,8,profile_ref.bytes) ||
+            pccf_ata_read(ata,lba,8,profile_check.bytes) ||
+            memcmp(profile_ref.bytes,profile_check.bytes,4096)) return -1;
+        pio_data_timing=timing; pio_cpu32=1; pio_settle_us=0;
+        ata->read_sector=pio_read_sector; ata->fast_poll=1;
+        if (pccf_ata_read(ata,lba,8,profile_check.bytes) ||
+            memcmp(profile_ref.bytes,profile_check.bytes,4096)) return -1;
+    }
+    pccardTrace("CF: selected timing=%08lx CPU=32 settle=0 validated=3x4096", (unsigned long)timing);
+    ata->commands=ata->multi_commands=ata->sector_reads=0;
+    return 0;
+}
