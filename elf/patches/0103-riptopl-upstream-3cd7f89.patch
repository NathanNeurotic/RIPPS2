diff --git a/.github/scripts/test_media_lsn_count.py b/.github/scripts/test_media_lsn_count.py
new file mode 100644
index 0000000..6fc10cb
--- /dev/null
+++ b/.github/scripts/test_media_lsn_count.py
@@ -0,0 +1,201 @@
+"""The media size handed to CDVDMAN (upstream OPL #1763) is exact or unknown, never a guess.
+
+CDVDMAN refuses reads past settings->common.mediaLsnCount, and 0 tells it to keep the ISO9660 PVD
+bound it used before #1763. So a count that is too small breaks valid reads, while 0 is always safe.
+
+Compiles the real ProbeZISO and sbGetMediaLsnCount from src/supportbase.c against a fake file table:
+a plain ISO, a ZSO (header count, not its compressed size), a ZSO whose header cannot be read, a
+missing file and an unknown total all behave. Then checks the BDM, SMB and MMCE launchers pass 0
+instead of a partial or unchecked total when a part cannot be opened or sized.
+"""
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'src/supportbase.c').read_text(encoding='utf-8').replace('\r\n', '\n')
+failures = []
+
+
+def function(src, signature):
+    match = re.search(signature, src, re.M)
+    if match is None:
+        sys.exit('src/supportbase.c: %s not found' % signature)
+    return src[match.start():src.index('\n}', match.start()) + 3]
+
+
+probe = function(source, r'^static int ProbeZISO\(int fd\)\s*\{')
+count = function(source, r'^u32 sbGetMediaLsnCount\(const char \*path, u64 totalBytes\)\s*\{')
+
+# Every launcher that sums its parts must hand over "unknown" when any part was not measured. BDM
+# aborts the launch on a part it cannot open, so only its seek can fail here; SMB and MMCE measure in
+# a loop of their own, where an unopened part must count as unmeasured -- never be skipped.
+SIZED = r'if \(partBytes > 0\)\n\s+isoTotalBytes \+= \(u64\)partBytes;\n\s+else\n\s+isoSizeKnown = 0;'
+LOOPS = {
+    'bdmsupport.c': r's64 partBytes = lseek64\(fd, 0, SEEK_END\);\n\s+' + SIZED,
+    'ethsupport.c': (r'int fd = open\(partname, O_RDONLY, 0666\);\n\s+s64 partBytes = -1;\n\s+if \(fd >= 0\) \{\n'
+                     r'\s+partBytes = lseek64\(fd, 0, SEEK_END\);\n\s+close\(fd\);\n\s+\}\n\s+' + SIZED),
+}
+LOOPS['mmcesupport.c'] = LOOPS['ethsupport.c']
+for name, loop in LOOPS.items():
+    text = (root / 'src' / name).read_text(encoding='utf-8').replace('\r\n', '\n')
+    if 'sbGetMediaLsnCount(partname, isoSizeKnown ? isoTotalBytes : 0)' not in text:
+        failures.append('%s: pass 0 to sbGetMediaLsnCount when the parts were not all measured' % name)
+    if re.search(r'\+=\s*lseek64\(', text):
+        failures.append('%s: a failed lseek64 (-1) added to the u64 total wraps it into a wrong bound' % name)
+    if re.search(loop, text) is None:
+        failures.append('%s: a part that cannot be opened or sized must mark the total unknown, not be skipped' % name)
+
+HARNESS = r'''
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+typedef unsigned char u8;
+typedef unsigned int u32;
+typedef unsigned long long u64;
+#define O_RDONLY 0
+#define SEEK_SET 0
+#define ZSO_MAGIC 0x4F53495A
+typedef struct {
+    u32 magic;
+    u32 header_size;
+    u64 total_bytes;
+    u32 block_size;
+    u8 ver;
+    u8 align;
+    u8 rsv_06[2];
+} ZISO_header;
+
+static u32 ziso_total_block;
+static int probed_fd;
+static u32 probed_lba;
+static void ziso_init(ZISO_header *header, u32 first_block)
+{
+    (void)first_block;
+    ziso_total_block = (u32)(header->total_bytes >> 11);
+}
+
+/* The fake device: one file at a time, by name. */
+static const char *fileName;
+static unsigned char fileData[64];
+static int fileSize, readFails, pos, openFiles;
+
+static int fake_open(const char *path, int flags, int mode)
+{
+    (void)flags;
+    (void)mode;
+    if (fileName == NULL || strcmp(path, fileName) != 0)
+        return -1;
+    openFiles++;
+    pos = 0;
+    return 3;
+}
+static int fake_lseek(int fd, int offset, int whence)
+{
+    (void)fd;
+    (void)whence;
+    pos = offset;
+    return pos;
+}
+static int fake_read(int fd, void *buf, int size)
+{
+    (void)fd;
+    if (readFails)
+        return -1;
+    int n = (pos + size > fileSize) ? fileSize - pos : size;
+    if (n < 0)
+        n = 0;
+    memcpy(buf, fileData + pos, n);
+    pos += n;
+    return n;
+}
+static int fake_close(int fd)
+{
+    (void)fd;
+    openFiles--;
+    return 0;
+}
+#define open fake_open
+#define lseek fake_lseek
+#define read fake_read
+#define close fake_close
+
+@PROBE@
+
+@COUNT@
+
+static void plainFile(const char *name)
+{
+    fileName = name;
+    memset(fileData, 0, sizeof(fileData));
+    fileSize = sizeof(fileData);
+    readFails = 0;
+}
+
+static void zsoFile(const char *name, u64 imageBytes)
+{
+    ZISO_header header = {ZSO_MAGIC, 24, imageBytes, 2048, 1, 0, {0, 0}};
+    plainFile(name);
+    memcpy(fileData, &header, sizeof(header));
+}
+
+static int fails;
+#define CHECK(cond, what) do { if (!(cond)) { printf("FAIL: %s\n", what); fails++; } } while (0)
+
+int main(void)
+{
+    plainFile("mass0:/DVD/Game.iso");
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Game.iso", 1000ULL * 2048) == 1000, "a plain ISO is its measured size");
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Game.iso", 0) == 0, "an ISO whose parts were not all measured is unknown");
+
+    plainFile("mass0:/ul.0A1B2C3D.SLUS_123.45.00");
+    CHECK(sbGetMediaLsnCount("mass0:/ul.0A1B2C3D.SLUS_123.45.00", 7ULL * 2048) == 7, "split parts sum to the media size");
+
+    zsoFile("mass0:/DVD/Game.zso", 5000ULL * 2048);
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Game.zso", 100ULL * 2048) == 5000,
+          "a ZSO is its header's block count, not its compressed file size");
+
+    zsoFile("mass0:/DVD/Renamed.iso", 4000ULL * 2048);
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Renamed.iso", 90ULL * 2048) == 4000, "a ZSO is found by its magic, whatever its name");
+
+    zsoFile("mass0:/DVD/Game.zso", 5000ULL * 2048);
+    readFails = 1;
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Game.zso", 100ULL * 2048) == 0,
+          "a ZSO whose header cannot be read is unknown, not its compressed size");
+    zsoFile("mass0:/DVD/GAME.ZSO", 5000ULL * 2048);
+    readFails = 1;
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/GAME.ZSO", 100ULL * 2048) == 0, "the .zso test ignores case");
+
+    zsoFile("mass0:/DVD/Empty.zso", 0);
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Empty.zso", 100ULL * 2048) == 0, "a ZSO header that reports 0 blocks stays unknown");
+
+    fileName = NULL;
+    CHECK(sbGetMediaLsnCount("mass0:/DVD/Gone.iso", 1000ULL * 2048) == 0, "a file that cannot be opened is unknown");
+
+    CHECK(openFiles == 0, "every open is closed");
+    return fails ? 1 : 0;
+}
+'''
+
+if not failures:
+    program = HARNESS.replace('@PROBE@', probe).replace('@COUNT@', count)
+    with tempfile.TemporaryDirectory() as tmp:
+        src = Path(tmp) / 'medialsn.c'
+        exe = Path(tmp) / ('medialsn' + ('.exe' if sys.platform == 'win32' else ''))
+        src.write_text(program, encoding='utf-8')
+        build = subprocess.run(['gcc', '-std=gnu99', '-Wall', '-Werror', '-o', str(exe), str(src)],
+                               capture_output=True, text=True, check=False)
+        if build.returncode != 0:
+            failures.append('harness did not compile:\n' + build.stderr)
+        else:
+            run = subprocess.run([str(exe)], capture_output=True, text=True, check=False)
+            if run.returncode != 0:
+                failures.extend(run.stdout.strip().splitlines() or ['harness exited %d' % run.returncode])
+
+if failures:
+    print('\n'.join(failures))
+    sys.exit(1)
+print('media size: exact (ISO, split parts, ZSO by header) or unknown (unread header, missing file, unmeasured part)')
diff --git a/.github/scripts/test_mega_upload_bounded.py b/.github/scripts/test_mega_upload_bounded.py
new file mode 100644
index 0000000..83d2bc6
--- /dev/null
+++ b/.github/scripts/test_mega_upload_bounded.py
@@ -0,0 +1,20 @@
+"""The MEGA archive upload can never hold a release hostage.
+
+The rolling release is published BEFORE the MEGA step, but "Normalize Release Assets" and the
+RetroAchievements release only start when the whole Rolling Release run succeeds. On 2026-10-13 the
+MEGA upload (normally 7 s) hung for 40+ minutes with no timeout, so both rolling releases sat with
+their raw 21-file asset set and rolling-ra fell behind. The step is bounded and optional.
+"""
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+workflow = (ROOT / ".github/workflows/rolling-release.yml").read_text(encoding="utf-8")
+start = workflow.index("      - name: Upload archive and regular ELFs in all 4 flavours to MEGA")
+end = workflow.index("\n      - name:", start + 10) if "\n      - name:" in workflow[start + 10:] else len(workflow)
+step = workflow[start:workflow.index("\n\n", start)]
+
+minutes = re.search(r"^        timeout-minutes: (\d+)$", step, re.M)
+assert minutes and 1 <= int(minutes.group(1)) <= 15, "the MEGA upload needs a short timeout"
+assert re.search(r"^        continue-on-error: true$", step, re.M), "a MEGA failure must not fail the release run"
+print("PASS: MEGA upload is bounded and optional")
diff --git a/.github/scripts/test_menu_allocation.py b/.github/scripts/test_menu_allocation.py
new file mode 100644
index 0000000..ed73401
--- /dev/null
+++ b/.github/scripts/test_menu_allocation.py
@@ -0,0 +1,176 @@
+"""Compile real menu allocation paths and inject failures at every allocation."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+source = (ROOT / "src/menusys.c").read_text(encoding="utf-8")
+
+def function(signature):
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    for i in range(brace, len(source)):
+        depth += (source[i] == "{") - (source[i] == "}")
+        if depth == 0:
+            return source[start:i + 1]
+    raise AssertionError(signature)
+
+functions = "\n\n".join(function(sig) for sig in (
+    "static menu_list_t *AllocMenuItem(",
+    "void menuAppendItem(",
+    "void submenuRebuildCache(",
+    "static submenu_list_t *submenuAllocItem(",
+    "submenu_list_t *submenuAppendItem(",
+    "void menuAddHint(",
+))
+program = r"""
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct menu_hint_item {
+    int text_id, icon_id;
+    struct menu_hint_item *next;
+} menu_hint_item_t;
+typedef struct menu_item {
+    int rank;
+    menu_hint_item_t *hints;
+} menu_item_t;
+typedef struct menu_list {
+    menu_item_t *item;
+    struct menu_list *prev, *next;
+} menu_list_t;
+typedef struct submenu_item {
+    int icon_id;
+    char *text;
+    int text_id, id;
+    int *cache_id, *cache_uid;
+    int favourited, isFolder;
+} submenu_item_t;
+typedef struct submenu_list {
+    struct submenu_list *prev, *next;
+    submenu_item_t item;
+} submenu_list_t;
+typedef struct { int gameCacheCount; } theme_t;
+static theme_t theme;
+static theme_t *gTheme = &theme;
+static menu_list_t *menu, *selected_item;
+static int menuListSemaId = 10, semaphoreDepth;
+static int allocCount, failAt, live;
+static int WaitSema(int id) { assert(id == menuListSemaId); semaphoreDepth++; return 0; }
+static int SignalSema(int id) { assert(id == menuListSemaId && semaphoreDepth == 1); semaphoreDepth--; return 0; }
+static int menuDevicePageRank(const menu_item_t *item) { return item->rank; }
+
+static void *trackedMalloc(size_t n) {
+    ++allocCount;
+    if (failAt && allocCount == failAt) return NULL;
+    void *ptr = malloc(n);
+    if (ptr) live++;
+    return ptr;
+}
+static void trackedFree(void *ptr) {
+    if (ptr) {
+        assert(live > 0);
+        live--;
+        free(ptr);
+    }
+}
+#define malloc trackedMalloc
+#define free trackedFree
+@FUNCTIONS@
+static void startFail(int at) { allocCount = 0; failAt = at; }
+int main(void) {
+    menu_item_t device1 = {1, NULL}, device2 = {0, NULL};
+    submenu_list_t *entries = NULL;
+    theme.gameCacheCount = 3;
+
+    startFail(1);
+    menuAppendItem(&device1);
+    assert(menu == NULL && selected_item == NULL && semaphoreDepth == 0 && live == 0);
+    startFail(0);
+    menuAppendItem(&device1);
+    assert(menu && selected_item == menu && semaphoreDepth == 0 && live == 1);
+    startFail(1);
+    menuAppendItem(&device2);
+    assert(menu && menu->next == NULL && live == 1 && semaphoreDepth == 0);
+    startFail(0);
+    menuAppendItem(&device2);
+    assert(menu->item == &device2 && menu->next->item == &device1);
+    free(menu->next);
+    free(menu);
+    menu = selected_item = NULL;
+    assert(live == 0);
+
+    // Node allocation failure does not mutate an empty submenu.
+    startFail(1);
+    assert(submenuAppendItem(&entries, -1, NULL, 7, 8) == NULL);
+    assert(entries == NULL && live == 0);
+
+    // The index array or UID array may fail independently.
+    for (int n = 2; n <= 3; n++) {
+        startFail(n);
+        entries = submenuAppendItem(&entries, -1, NULL, 7, 8);
+        assert(entries && entries->item.cache_id == NULL && entries->item.cache_uid == NULL);
+        assert(live == 1);
+        free(entries);
+        entries = NULL;
+        assert(live == 0);
+    }
+
+    // Both valid art index arrays are initialized to -1.
+    startFail(0);
+    entries = submenuAppendItem(&entries, -1, NULL, 7, 8);
+    assert(entries && live == 3);
+    for (int i = 0; i < 3; i++) {
+        assert(entries->item.cache_id[i] == -1 && entries->item.cache_uid[i] == -1);
+    }
+    // A theme switch on a half-allocated replacement must drop both old arrays.
+    startFail(2);
+    submenuRebuildCache(entries);
+    assert(entries->item.cache_id == NULL && entries->item.cache_uid == NULL && live == 1);
+    startFail(1);
+    submenuRebuildCache(entries);
+    assert(entries->item.cache_id == NULL && entries->item.cache_uid == NULL && live == 1);
+    startFail(0);
+    submenuRebuildCache(entries);
+    assert(entries->item.cache_id && entries->item.cache_uid && live == 3);
+    theme.gameCacheCount = 0;
+    submenuRebuildCache(entries);
+    assert(entries->item.cache_id == NULL && entries->item.cache_uid == NULL && live == 1);
+    theme.gameCacheCount = 3;
+
+    // Appending to a populated list never links a NULL successor on OOM.
+    startFail(1);
+    assert(submenuAppendItem(&entries, -1, NULL, 9, 10) == NULL);
+    assert(entries->next == NULL && live == 1);
+    startFail(0);
+    submenu_list_t *next = submenuAppendItem(&entries, -1, NULL, 9, 10);
+    assert(next && entries->next == next && next->prev == entries);
+    free(next->item.cache_id);
+    free(next->item.cache_uid);
+    free(next);
+    free(entries);
+    assert(live == 0);
+
+    startFail(1);
+    menuAddHint(&device1, 100, 3);
+    assert(device1.hints == NULL && live == 0);
+    startFail(0);
+    menuAddHint(&device1, 100, 3);
+    assert(device1.hints && device1.hints->text_id == 100 && live == 1);
+    free(device1.hints);
+    assert(live == 0);
+    puts("PASS: menu allocations fail without crashes, leaks or half-initialized art pairs");
+    return 0;
+}
+""".replace("@FUNCTIONS@", functions)
+with tempfile.TemporaryDirectory() as tmp:
+    source_file = Path(tmp) / "test.c"
+    exe = Path(tmp) / "test"
+    source_file.write_text(program, encoding="utf-8")
+    subprocess.run(["gcc", "-std=c99", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", str(source_file), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True, timeout=15)
