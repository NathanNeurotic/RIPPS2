+    assert(((uintptr_t)gBlockList & 63) == 0 && ((uintptr_t)gBlockSnap & 63) == 0);
+    assert((u8 *)gBlockSnap >= (u8 *)(gBlockList + 4096));
+    prepare(); assert(ra_snap_every == 2);
+    unsigned before = transfers;
+    for (int i=0; i<6; i++) RA_OnVblank();
