+    len = strlen(dir);
+    if (len == 0 || len + 1 >= (int)sizeof(dir) || strchr(dir, '\\') != NULL || strchr(dir, '"') != NULL ||
+        (!strncmp(dir, "hdd", 3) && dir[3] >= '0' && dir[3] <= '9' && dir[4] == ':'))
+        goto untracked;
+    if (dir[len - 1] != '/' && dir[len - 1] != ':') {
+        dir[len++] = '/';
