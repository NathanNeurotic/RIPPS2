+// Before a plain paste runs: every clipboard item whose name is already where it goes is asked about (once YES TO ALL,
+// the rest are replaced without asking). Saves, card images and .psu unpacks keep their own rules.
+static void fbPasteAskReplace(void)
+{
+    char src[320], dst[320], destDir[256];
+    int i, all = 0, left = 0;
+    int fromVmc = fbVmcPath(fbClipVmc, fbClipDir, NULL, 0), toVmc = fbVmcPath(fbVmc, fbPath, NULL, 0);
+
+    memset(fbClipReplace, 0, sizeof(fbClipReplace));
+    if (fbPasteMode != FB_PASTE_PLAIN || fromVmc || toVmc)
+        return;
+    int there[FB_CLIP_MAX];
+    for (i = 0; i < fbClipCount; i++) {
+        there[i] = 0;
+        if (!fbClipIsDir[i] && fbHasSuffix(fbClip[i], ".psu") && fbIsMc(fbPath))
+            continue; // unpacked as a save
+        snprintf(src, sizeof(src), "%s%s", fbClipDir, fbClip[i]);
+        snprintf(destDir, sizeof(destDir), "%s", fbPath);
+        if (fbIsMc(fbPath) && fbClipIsDir[i] && fbFolderHasIconSys(src))
+            fbMcRoot(fbPath, destDir, sizeof(destDir));
+        snprintf(dst, sizeof(dst), "%s%s", destDir, fbClip[i]);
+        there[i] = strcmp(src, dst) != 0 && fbExists(dst);
+        left += there[i];
+    }
+    for (i = 0; i < fbClipCount; i++) {
+        if (!there[i])
+            continue;
+        if (!all) {
+            int a = fbAskReplace(fbClip[i], left);
+            if (a == 2)
+                all = 1;
+            fbClipReplace[i] = a != 0;
+        } else
+            fbClipReplace[i] = 1;
+        left--;
+    }
+}
