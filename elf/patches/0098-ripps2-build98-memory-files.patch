+// build 98: what is in a memory card slot: sceMcTypePS2, PS1 or PDA, or 0 for nothing, through mcman's own info
+// call. The first one after a card is detected answers "changed card" (-1, or -2 unformatted), and that call is
+// what clears the state: START DRIVES' MMCE ping left a card in it, its opendir() failed once, and the slot fell
+// off the list. Up to three asks. freeKb (may be NULL): its free space when it is a formatted PS2 card, else -1.
+static int fbCardType(int port, int *freeKb)
+{
+    int tries, type, freeC, format, res;
+
+    for (tries = 0; tries < 3; tries++) {
+        type = freeC = format = 0;
+        res = -10;
+        mcGetInfo(port, 0, &type, &freeC, &format);
+        mcSync(0, NULL, &res);
+        if (res >= -2) {
+            if (freeKb != NULL)
+                *freeKb = res >= -1 && type == sceMcTypePS2 && format == MC_FORMATTED ? freeC : -1;
+            return type;
+        }
+        DelayThread(50 * 1000);
+    }
+    if (freeKb != NULL)
+        *freeKb = -1;
+    return 0;
+}
+
+// A card slot belongs on the drive list while a card is in it. Its root is read a few times (a card can still
+// refuse the first read); a PS2 card stays listed even then, so the slot is never lost, and a PS1 card or a
+// PDA only when its root reads.
+static int fbCardListed(const char *dev)
+{
+    int type = fbCardType(dev[2] - '0', NULL), tries;
+    DIR *d = NULL;
+
+    if (type == 0)
+        return 0;
+    for (tries = 0; tries < 4 && (d = opendir(dev)) == NULL; tries++)
+        DelayThread(50 * 1000);
+    if (d != NULL) {
+        closedir(d);
+        return 1;
+    }
+    return type == sceMcTypePS2;
+}
