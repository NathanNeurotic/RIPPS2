+// RIPPS2 build 98: an entry's details, shown once the cursor has rested on it for 0.42 s: the full name, the exact size,
+// when it was modified and created. The IO worker reads them (fileXioGetStat); the list never waits on the drive.
+#define FB_TIP_REST_S 0.42f
+static int fbTipCursor = -1;
+static clock_t fbTipSince = 0;
+static volatile int fbTipState = 0; // 0 nothing asked, 1 asked, 2 ready
+static char fbTipPath[384], fbTipKey[384];
+static char fbTipLine[3][72];
+
+static void fbTipTime(const unsigned char *t, char *out, int size)
+{
+    int year = t[6] | (t[7] << 8);
+    if (year < 1980 || year > 2100 || t[5] < 1 || t[5] > 12 || t[4] < 1 || t[4] > 31)
+        snprintf(out, size, "UNKNOWN");
+    else
+        snprintf(out, size, "%04d-%02d-%02d  %02d:%02d", year, t[5], t[4], t[3], t[2]);
+}
+
+static void fbTipWork(void)
+{
+    iox_stat_t st;
+    char path[384], when[32];
+    snprintf(path, sizeof(path), "%s", fbTipPath);
+    // a memory card in RiptOPL's own form, "mc0:SAVE/FILE"
+    if (fbIsMc(path) && path[4] == '/')
+        memmove(path + 4, path + 5, strlen(path + 5) + 1);
+    memset(&st, 0, sizeof(st));
+    if (fileXioGetStat(path, &st) < 0) {
+        snprintf(fbTipLine[0], sizeof(fbTipLine[0]), "NO DETAILS: THE DRIVE DID NOT SAY");
+        fbTipLine[1][0] = fbTipLine[2][0] = '\0';
+    } else {
+        unsigned long long size = ((unsigned long long)st.hisize << 32) | st.size;
+        if (FIO_S_ISDIR(st.mode))
+            snprintf(fbTipLine[0], sizeof(fbTipLine[0]), "FOLDER");
+        else {
+            char num[32], grp[40];
+            int n, o = 0, k;
+            snprintf(num, sizeof(num), "%llu", size);
+            n = strlen(num);
+            for (k = 0; k < n; k++) { // 1,528,102,912
+                grp[o++] = num[k];
+                if ((n - k - 1) % 3 == 0 && k < n - 1)
+                    grp[o++] = ',';
+            }
+            grp[o] = '\0';
+            snprintf(fbTipLine[0], sizeof(fbTipLine[0]), "%s BYTES", grp);
+        }
+        fbTipTime(st.mtime, when, sizeof(when));
+        snprintf(fbTipLine[1], sizeof(fbTipLine[1]), "MODIFIED  %s", when);
+        fbTipTime(st.ctime, when, sizeof(when));
+        snprintf(fbTipLine[2], sizeof(fbTipLine[2]), "CREATED   %s", when);
+    }
+    snprintf(fbTipKey, sizeof(fbTipKey), "%s", fbTipPath);
+    fbTipState = 2;
+}
