+        return 0;
+    int ms = 500 - gScrollSpeed * 200;
+    if (ms < 60)
+        ms = 60;
+    if ((u32)(now - last) * 1000u / CLOCKS_PER_SEC >= (u32)ms) {
+        last = now;
+        return 1;
+    }
+    return 0;
+}
