+// RIPPS2 build 98: the file the music streams from ("" when none). A drive refuses to remove an open file
+// (Memory Files showed E16 deleting a track in AUDIO), so the browser asks first and lets the music go.
+static char bgmOpenPath[256];
+
+// Is the music streaming from path, a file, or from inside it, a folder? "pfs0:AUDIO/x" and "pfs0:/AUDIO/x"
+// are the same place, and case is not looked at.
+int bgmHoldsPath(const char *path)
+{
+    const char *a = bgmOpenPath, *b = path;
+
+    if (!bgmOpenPath[0] || path == NULL || !path[0])
+        return 0;
+    while (*a && *a != ':' && *b && tolower((unsigned char)*a) == tolower((unsigned char)*b))
+        a++, b++;
+    if (*a != ':' || *b != ':')
+        return 0;
+    for (a++, b++; *a == '/'; a++)
+        ;
+    while (*b == '/')
+        b++;
+    size_t n = strlen(b);
+    while (n > 0 && b[n - 1] == '/')
+        n--; // a folder given with its slash
+    if (n == 0)
+        return 1; // the drive's root
+    if (strncasecmp(a, b, n) != 0)
+        return 0;
+    return a[n] == '\0' || a[n] == '/';
+}
