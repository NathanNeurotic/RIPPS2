+// ---- build 98: a PS2 save icon (.ico / .icn), in 3D ----
+// The model, its texture and its animation, read by the save-icon reader (saveicon.c) and drawn the way the PS2's
+// browser shows it: lit from the save's icon.sys, over its background, turning. The D-pad (or the right stick)
+// turns it, L2 / R2 zoom, Square stops or starts the spin, Triangle puts it back.
+#define ICON_SPIN_S 6.0f // one turn, as the browser's
+
+typedef struct
+{
+    float *x, *y, *z, *depth, *drawXY, *drawUV;
+    u64 *col, *drawCol;
+    int *order;
+} icon_bufs_t;
+
+static void iconFreeBufs(icon_bufs_t *b)
+{
+    free(b->x);
+    free(b->y);
+    free(b->z);
+    free(b->depth);
+    free(b->drawXY);
+    free(b->drawUV);
+    free(b->col);
+    free(b->drawCol);
+    free(b->order);
+    memset(b, 0, sizeof(*b));
+}
+
+static int iconAllocBufs(icon_bufs_t *b, int verts)
+{
+    memset(b, 0, sizeof(*b));
+    b->x = malloc(sizeof(float) * verts);
+    b->y = malloc(sizeof(float) * verts);
+    b->z = malloc(sizeof(float) * verts);
+    b->depth = malloc(sizeof(float) * (verts / 3));
+    b->drawXY = malloc(sizeof(float) * 2 * verts);
+    b->drawUV = malloc(sizeof(float) * 2 * verts);
+    b->col = malloc(sizeof(u64) * verts);
+    b->drawCol = malloc(sizeof(u64) * verts);
+    b->order = malloc(sizeof(int) * (verts / 3));
+    if (b->x == NULL || b->y == NULL || b->z == NULL || b->depth == NULL || b->drawXY == NULL || b->drawUV == NULL ||
+        b->col == NULL || b->drawCol == NULL || b->order == NULL) {
+        iconFreeBufs(b);
+        return 0;
+    }
+    return 1;
+}
+
+// icon.sys's lights, used only when they hold something (an all-zero or absurd set leaves the vertex colours as
+// they are rather than drawing the icon black); the directions come back normalised
+static int iconLightUsable(saveicon_light_t *l)
+{
+    float total = 0.0f;
+    int i, k;
+
+    if (!l->valid)
+        return 0;
+    for (i = 0; i < 3; i++) {
+        float *d = l->dir[i], len = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+        if (!(len < 1e6f))
+            return 0;
+        if (len > 0.0f)
+            for (k = 0; k < 3; k++)
+                d[k] /= len;
+        for (k = 0; k < 3; k++) {
+            if (!(l->color[i][k] >= 0.0f && l->color[i][k] <= 4.0f))
+                return 0;
+            total += l->color[i][k];
+        }
+    }
+    for (k = 0; k < 3; k++) {
+        if (!(l->ambient[k] >= 0.0f && l->ambient[k] <= 4.0f))
+            return 0;
+        total += l->ambient[k];
+    }
+    return total > 0.05f;
+}
+
+static u64 iconShade(const unsigned char *rgba, const saveicon_light_t *l, int lit, float nx, float ny, float nz)
+{
+    float f[3] = {1.0f, 1.0f, 1.0f};
+    int i, k, c[3];
+
+    if (lit) {
+        for (k = 0; k < 3; k++)
+            f[k] = l->ambient[k];
+        for (i = 0; i < 3; i++) {
+            float d = nx * l->dir[i][0] + ny * l->dir[i][1] + nz * l->dir[i][2];
+            if (d < 0.0f) // two-sided, as the save-icon element: the format's light sign is not a guess worth losing the front to
+                d = -d;
+            for (k = 0; k < 3; k++)
+                f[k] += l->color[i][k] * d;
+        }
+    }
+    for (k = 0; k < 3; k++) {
+        c[k] = (int)(rgba[k] * (f[k] < 1.0f ? f[k] : 1.0f));
+        if (c[k] > 0xFF)
+            c[k] = 0xFF;
+    }
+    return GS_SETREG_RGBAQ(c[0], c[1], c[2], 0x80, 0x00);
+}
+
+void ripps2ViewSaveIcon(const char *path)
+{
+    saveicon_model_t m;
+    saveicon_light_t light;
+    icon_bufs_t b;
+    GSTEXTURE tex;
+    unsigned char *data, *sys = NULL;
+    int len = 0, sysLen = 0, lit = 0, haveBg = 0, v, s, i, k, tris, scrW, scrH;
+    u64 bg[4] = {0, 0, 0, 0};
+    char info[160], dir[256], listName[64];
+    const char *name = strrchr(path, '/');
+
+    guiRenderTextScreen("Opening the icon");
+    data = viewReadAll(path, SAVEICON_MAX_FILE, &len);
+    if (data == NULL || saveIconParseModel(data, len, &m) != 0) {
+        free(data);
+        guiMsgBox("This is not a PS2 save icon, or it is damaged.", 0, NULL);
+        return;
+    }
+    free(data);
+    if (!iconAllocBufs(&b, m.verts)) {
+        saveIconFreeModel(&m);
+        guiMsgBox("Not enough memory to show this icon.", 0, NULL);
+        return;
+    }
+    name = name != NULL ? name + 1 : path;
+
+    // the save's own icon.sys, beside it: its lights and the four corners of its background
+    memset(&light, 0, sizeof(light));
+    snprintf(dir, sizeof(dir), "%.*sicon.sys", (int)(name - path), path);
+    if ((sys = viewReadAll(dir, 2 * SAVEICON_SYS_SIZE, &sysLen)) != NULL) {
+        if (saveIconParseSys(sys, sysLen, listName, sizeof(listName), &light)) {
+            lit = iconLightUsable(&light);
+            for (i = 0; i < 4; i++) { // 0..255 per channel; the GS's full is 0x80
+                const unsigned char *c = sys + 0x10 + 16 * i;
+                bg[i] = GS_SETREG_RGBAQ(c[0] >> 1, c[4] >> 1, c[8] >> 1, 0x80, 0x00);
+            }
+            haveBg = 1;
+        }
+        free(sys);
+    }
+
+    memset(&tex, 0, sizeof(tex));
+    if (m.texels != NULL) {
+        tex.Width = SAVEICON_TEX_SIZE;
+        tex.Height = SAVEICON_TEX_SIZE;
+        tex.PSM = GS_PSM_CT16;
+        tex.Mem = (u32 *)m.texels;
+        tex.Filter = GS_FILTER_LINEAR;
+        tex.ClutStorageMode = GS_CLUT_STORAGE_CSM1;
+        tex.Delayed = 1;
+    }
+
+    // the pivot and the radius over every shape, so no frame of the animation leaves the box at any angle
+    float lo[3] = {1e9f, 1e9f, 1e9f}, hi[3] = {-1e9f, -1e9f, -1e9f}, pivot[3], radius = 1.0f;
+    for (i = 0; i < m.shapes * m.verts; i++)
+        for (k = 0; k < 3; k++) {
+            float c = m.pos[i * 3 + k];
+            lo[k] = c < lo[k] ? c : lo[k];
+            hi[k] = c > hi[k] ? c : hi[k];
+        }
+    for (k = 0; k < 3; k++)
+        pivot[k] = (lo[k] + hi[k]) * 0.5f;
+    for (i = 0; i < m.shapes * m.verts; i++) {
+        float dx = m.pos[i * 3] - pivot[0], dy = m.pos[i * 3 + 1] - pivot[1], dz = m.pos[i * 3 + 2] - pivot[2];
+        float r = sqrtf(dx * dx + dy * dy + dz * dz);
+        radius = r > radius ? r : radius;
+    }
+
+    tris = m.verts / 3;
+    for (i = 0; i < tris; i++)
+        b.order[i] = i;
+    rmGetScreenExtents(&scrW, &scrH);
+    float squeeze = rmWideScale(1000) / 1000.0f, zoom = 1.0f, yaw = 0.0f, pitch = 0.0f, weights[SAVEICON_MAX_SHAPES];
+    int spin = 1;
+    clock_t last = clock(), began = last;
+    snprintf(info, sizeof(info), "%s   %d TRIANGLES   %d %s%s", name, tris, m.shapes, m.shapes == 1 ? "SHAPE" : "SHAPES",
+             m.texels != NULL ? "" : "   NO TEXTURE");
+
+    for (;;) {
+        clock_t now = clock();
+        float dt = (float)(now - last) / (float)CLOCKS_PER_SEC, t = 0.0f;
+        last = now;
+        if (dt > 0.1f)
+            dt = 0.1f;
+        if (spin)
+            yaw += dt * (2.0f * 3.14159265f / ICON_SPIN_S);
+        if (m.frameLength > 1) // 60 frames a second, at the icon's own speed
+            t = fmodf((float)(now - began) / (float)CLOCKS_PER_SEC * 60.0f * m.speed, (float)m.frameLength);
+        float sum = saveIconShapeWeights(&m, t, weights), cy = cosf(yaw), sy = sinf(yaw), cp = cosf(pitch), sp = sinf(pitch);
+        float scale = 170.0f / radius * zoom;
+
+        for (v = 0; v < m.verts; v++) {
+            const short *n = &m.normal[v * 3];
+            float p[3] = {0.0f, 0.0f, 0.0f};
+            for (s = 0; s < m.shapes; s++) {
+                const short *q = &m.pos[(s * m.verts + v) * 3];
+                if (weights[s] <= 0.0f)
+                    continue;
+                for (k = 0; k < 3; k++)
+                    p[k] += weights[s] * q[k];
+            }
+            for (k = 0; k < 3; k++)
+                p[k] = p[k] / sum - pivot[k];
+            // a turn about the vertical axis, then a tip about the horizontal one; icon space has +y down the screen
+            float x1 = p[0] * cy + p[2] * sy, z1 = p[2] * cy - p[0] * sy;
+            float nx1 = (n[0] * cy + n[2] * sy) / 4096.0f, nz1 = (n[2] * cy - n[0] * sy) / 4096.0f, ny = n[1] / 4096.0f;
+            b.x[v] = 320.0f + x1 * scale * squeeze;
+            b.y[v] = 232.0f + (p[1] * cp - z1 * sp) * scale;
+            b.z[v] = p[1] * sp + z1 * cp;
+            b.col[v] = iconShade(&m.rgba[v * 4], &light, lit, nx1, ny * cp - nz1 * sp, ny * sp + nz1 * cp);
+        }
+        // painter's order, far first (+z into the screen); last frame's order is nearly right, so insertion sort
+        for (i = 0; i < tris; i++)
+            b.depth[i] = b.z[i * 3] + b.z[i * 3 + 1] + b.z[i * 3 + 2];
+        for (i = 1; i < tris; i++) {
+            int cur = b.order[i], j = i - 1;
+            float d = b.depth[cur];
+            while (j >= 0 && b.depth[b.order[j]] < d) {
+                b.order[j + 1] = b.order[j];
+                j--;
+            }
+            b.order[j + 1] = cur;
+        }
+        for (i = 0; i < tris; i++) {
+            int a = b.order[i] * 3;
+            for (k = 0; k < 3; k++) {
+                int dst = i * 3 + k, src = a + k;
+                b.drawXY[dst * 2] = b.x[src];
+                b.drawXY[dst * 2 + 1] = b.y[src];
+                b.drawUV[dst * 2] = m.uv[src * 2] / 32.0f; // 4.12 UVs of a 128-texel texture
+                b.drawUV[dst * 2 + 1] = m.uv[src * 2 + 1] / 32.0f;
+                b.drawCol[dst] = b.col[src];
+            }
+        }
+
+        guiStartFrame();
+        if (haveBg)
+            rmDrawQuadGouraud(0, 0, bg[0], scrW, 0, bg[1], 0, scrH, bg[2], scrW, scrH, bg[3]);
+        else
+            rmDrawRect(0, 0, scrW, scrH, GS_SETREG_RGBA(0x02, 0x03, 0x0A, 0x80));
+        rmDrawTriangles(m.texels != NULL ? &tex : NULL, tris, b.drawXY, b.drawUV, b.drawCol);
+        rmDrawRect(0, 6, 640, 32, GS_SETREG_RGBAQ(0x02, 0x03, 0x0A, 0x60, 0x00));
+        fntRenderString(RIPPS2_DIA_FONT, 320, 22, ALIGN_CENTER, 600, 0, info, GS_SETREG_RGBA(0xE0, 0xE8, 0xFF, 0x80));
+        rmDrawRect(0, 442, 640, 32, GS_SETREG_RGBAQ(0x02, 0x03, 0x0A, 0x60, 0x00));
+        int hx = 0;
+        for (i = 0; i < 2; i++) { // measured, then drawn centred
+            int x = i ? 320 - (hx - 16) / 2 : 0;
+            x = viewHint(R2_ICON, "ZOOM", x, 458, 0x80, i);
+            x = viewHint(RIPPS2_DPAD_UP, "TURN", x, 458, 0x80, i);
+            x = viewHint(SQUARE_ICON, spin ? "STOP SPIN" : "SPIN", x, 458, 0x80, i);
+            x = viewHint(TRIANGLE_ICON, "RESET", x, 458, 0x80, i);
+            hx = viewHint(gSelectButton == KEY_CIRCLE ? CROSS_ICON : CIRCLE_ICON, "BACK", x, 458, 0x80, i);
+        }
+        guiEndFrame();
+
+        readPads();
+        if (getKeyOn(guiCancelKey()))
+            break;
+        int rx, ry;
+        padGetRightStick(&rx, &ry);
+        if (getKeyPressed(KEY_LEFT) || rx < -24)
+            yaw -= dt * (rx < -24 ? -rx / 127.0f : 1.0f) * 2.5f;
+        if (getKeyPressed(KEY_RIGHT) || rx > 24)
+            yaw += dt * (rx > 24 ? rx / 127.0f : 1.0f) * 2.5f;
+        if (getKeyPressed(KEY_UP) || ry < -24)
+            pitch -= dt * (ry < -24 ? -ry / 127.0f : 1.0f) * 2.0f;
+        if (getKeyPressed(KEY_DOWN) || ry > 24)
+            pitch += dt * (ry > 24 ? ry / 127.0f : 1.0f) * 2.0f;
+        pitch = pitch > 1.4f ? 1.4f : pitch < -1.4f ? -1.4f : pitch;
+        if (getKeyPressed(KEY_R2))
+            zoom *= 1.0f + dt * 1.2f;
+        if (getKeyPressed(KEY_L2))
+            zoom /= 1.0f + dt * 1.2f;
+        zoom = zoom > 2.4f ? 2.4f : zoom < 0.4f ? 0.4f : zoom;
+        if (getKeyOn(KEY_SQUARE)) {
+            spin = !spin;
+            sfxPlay(SFX_CURSOR);
+        }
+        if (getKeyOn(KEY_TRIANGLE)) {
+            yaw = pitch = 0.0f;
+            zoom = 1.0f;
+            sfxPlay(SFX_CURSOR);
+        }
+    }
+    if (m.texels != NULL)
+        rmUnloadTexture(&tex);
+    iconFreeBufs(&b);
+    saveIconFreeModel(&m);
+}
