+// RIPPS2 build 98: the page buttons on the Grid turn a whole page of covers (columns x rows), the cursor keeping its
+// place on the page; at the last page it moves to the last cover, at the first page it stays. They moved one cover:
+// the Grid's hidden list is one row high, so a list page there was a single item. 1 when it was the Grid's to do.
+static int menuGridPage(int dir)
+{
+    int cols = thmGridColumns(), rows = gTheme->gridRows > 0 ? gTheme->gridRows : 1, page, cur = 0, count = 0, target, i;
+    submenu_list_t *p;
+
+    if (cols <= 0 || selected_item == NULL || selected_item->item == NULL)
+        return 0;
+    for (p = selected_item->item->submenu; p != NULL; p = p->next, count++)
+        if (p == selected_item->item->current)
+            cur = count;
+    if (count == 0)
+        return 1;
+    page = cols * rows;
+    if (dir > 0) {
+        if (cur - cur % page + page >= count)
+            target = count - 1; // the last page: its last cover
+        else
+            target = cur + page < count ? cur + page : count - 1;
+    } else
+        target = cur >= page ? cur - page : cur; // the first page: stay
+    for (i = cur; i < target; i++)
+        menuNextV();
+    for (i = cur; i > target; i--)
+        menuPrevV();
+    return 1;
+}
+
