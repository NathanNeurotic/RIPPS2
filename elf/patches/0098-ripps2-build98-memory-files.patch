+    } else {
+        req->prev = gArtReqList;
+        req->next = gArtReqList->next;
+        if (req->next)
+            req->next->prev = req;
+        else
+            gArtReqEnd = req;
+        gArtReqList->next = req;
+    }
+    EIntr();
